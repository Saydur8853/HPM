# Copy this file to .env.production on the server. Never commit the real file.
# Passwords must not contain a single quote because SQL Server receives the app
# password during its one-time idempotent initialization script.
HPM_DOMAIN=hpm.example.com
MSSQL_PID=Express
MSSQL_SA_PASSWORD=replace-with-a-long-unique-sa-password
HPM_DB_PASSWORD=replace-with-a-long-unique-app-password
