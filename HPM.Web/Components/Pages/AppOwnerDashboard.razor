                    </div>
                </div>

                <!-- Save Action Footer Bar -->
                <div class="owner-sticky-footer">
                    <div class="save-bar-summary">
                        <span class="summary-count">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            <strong>@modules.Count(x => x.Selected)</strong> modules active
                        </span>
                        <span class="summary-sep">·</span>
                        <span class="summary-amount">Monthly Total: <strong>৳ @modules.Where(x => x.Selected).Sum(x => x.MonthlyPrice).ToString("N2")</strong></span>
                        <span class="summary-sep">·</span>
                        <span class="summary-amount">Yearly Total: <strong>৳ @modules.Where(x => x.Selected).Sum(x => x.YearlyPrice).ToString("N2")</strong></span>
