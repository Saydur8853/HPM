                    <button class="owner-btn-save" @onclick="SaveLicenseAsync">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                        <span>Save Package & Prices</span>
                    </button>
                </div>
            </section>

            <!-- STEP 04: SUBSCRIPTION INVOICES -->
            <section id="section-invoices" class="owner-card owner-invoices-card">
                <div class="owner-card-heading">
                    <span class="owner-step-badge">
                        <span class="step-badge-num">04</span>
                    </span>
                    <div>
                        <h2>Subscription Invoices & Billing</h2>
                        <p>Invoices snapshot the saved package rates for the billing period. Include hosting or domain costs when applicable.</p>
                    </div>
                </div>

                <!-- Issue New Invoice Creator -->
                <div class="invoice-creator-box">
                    <div class="creator-title">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                        <span>Issue New Official Invoice</span>
                    </div>

                    <div class="creator-controls">
                        <div class="form-field date-field">
                            <label for="invStart">Period Start Date</label>
                            <input id="invStart" type="date" @bind="invoiceStart" @bind:format="yyyy-MM-dd" />
                        </div>

                        <div class="creator-addons">
                            <label class="custom-addon-check">
                                <input type="checkbox" @bind="includeHosting" />
                                <span class="addon-box">
                                    <span class="addon-name">Include Hosting</span>
                                    <strong class="addon-cost">৳ @license.HostingCost.ToString("N2")</strong>
                                </span>
                            </label>

                            <label class="custom-addon-check">
                                <input type="checkbox" @bind="includeDomain" />
                                <span class="addon-box">
                                    <span class="addon-name">Include Domain</span>
                                    <strong class="addon-cost">৳ @license.DomainCost.ToString("N2")</strong>
                                </span>
                            </label>
                        </div>

                        <div class="creator-preview">
                            <span class="preview-label">Estimated Invoice Total</span>
                            <strong class="preview-value">৳ @EstimatedInvoiceTotal.ToString("N2")</strong>
                            <span class="preview-sub">for 1 @(license.BillingCycle == "Monthly" ? "Month" : "Year") cycle</span>
                        </div>

                        <button class="owner-btn-issue" @onclick="IssueInvoiceAsync">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
                            <span>Issue Invoice</span>
                        </button>
                    </div>
                </div>

                <!-- Invoices List -->
                @if (invoices.Count == 0)
                {
                    <div class="owner-empty-state">
                        <div class="empty-icon-wrap">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>
                        </div>
                        <h3>No Invoices Issued Yet</h3>
                        <p>Configure and save your module package and billing cycle above, then click <strong>Issue Invoice</strong> to generate your first subscription bill.</p>
                    </div>
                }
                else
                {
                    <!-- Invoice Summary Stats -->
                    <div class="invoices-kpi-bar">
                        <div class="kpi-pill">
                            <span>Total Issued:</span>
                            <strong>@invoices.Count</strong>
                        </div>
                        <div class="kpi-pill paid">
                            <span>Paid Invoices:</span>
                            <strong>৳ @invoices.Where(x => x.Status == "Paid").Sum(x => x.Total).ToString("N2") (@invoices.Count(x => x.Status == "Paid"))</strong>
                        </div>
                        <div class="kpi-pill due">
                            <span>Outstanding Due:</span>
                            <strong>৳ @invoices.Where(x => x.Status != "Paid").Sum(x => x.Total).ToString("N2") (@invoices.Count(x => x.Status != "Paid"))</strong>
                        </div>
                    </div>

                    <div class="owner-invoices-list">
                        @foreach (var invoice in invoices)
                        {
                            var isPaid = invoice.Status == "Paid";
                            <article class="owner-invoice-card @(isPaid ? "status-paid" : "status-due")">
                                <div class="invoice-card-top">
                                    <div class="inv-identity">
                                        <div class="inv-number-wrap">
                                            <span class="inv-hash">#</span>
                                            <strong class="inv-id">@invoice.ID</strong>
                                            <span class="inv-cycle-chip">@invoice.BillingCycle</span>
                                        </div>
                                        <div class="inv-dates">
                                            <span class="inv-period">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                                @invoice.PeriodStart.ToString("dd MMM yyyy") – @invoice.PeriodEnd.ToString("dd MMM yyyy")
                                            </span>
                                            <span class="inv-created">Issued: @invoice.IssuedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</span>
                                        </div>
                                    </div>

                                    <div class="inv-financials">
                                        <div class="inv-amount">
                                            <span class="amount-tag">TOTAL INVOICE</span>
                                            <strong class="amount-value">৳ @invoice.Total.ToString("N2")</strong>
                                        </div>
                                        <span class="inv-status-badge @(isPaid ? "paid" : "due")">
                                            @if (isPaid)
                                            {
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                                <span>Paid</span>
                                            }
                                            else
                                            {
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
                                                <span>Issued (Due)</span>
                                            }
                                        </span>
                                    </div>
                                </div>

                                <div class="invoice-card-bottom">
                                    <div class="inv-actions">
                                        <a href="/app-owner/invoice/@invoice.ID" target="_blank" rel="noopener" class="btn-inv-view">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                            <span>View & Print</span>
                                        </a>

                                        @if (!isPaid)
                                        {
                                            <button type="button" class="btn-inv-pay" @onclick="() => MarkPaidAsync(invoice.ID)">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                                <span>Mark as Paid</span>
                                            </button>
                                        }
                                        else if (invoice.PaidAt.HasValue)
                                        {
                                            <span class="inv-paid-time">Paid on @invoice.PaidAt.Value.ToLocalTime().ToString("dd MMM yyyy")</span>
                                        }
                                    </div>

                                    <details class="inv-breakdown-details">
                                        <summary>
                                            <span class="summary-text">Itemized Breakdown (@(invoice.Items.Count + (invoice.HostingCost > 0 ? 1 : 0) + (invoice.DomainCost > 0 ? 1 : 0)) items)</span>
                                            <svg class="summary-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                        </summary>
                                        <div class="inv-breakdown-table">
                                            @foreach (var item in invoice.Items)
                                            {
                                                <div class="breakdown-row">
                                                    <span class="item-name">@item.ModuleName</span>
                                                    <strong class="item-cost">৳ @item.Price.ToString("N2")</strong>
                                                </div>
                                            }
                                            @if (invoice.HostingCost > 0)
                                            {
                                                <div class="breakdown-row infra">
                                                    <span class="item-name">Hosting Infrastructure</span>
                                                    <strong class="item-cost">৳ @invoice.HostingCost.ToString("N2")</strong>
                                                </div>
                                            }
                                            @if (invoice.DomainCost > 0)
                                            {
                                                <div class="breakdown-row infra">
                                                    <span class="item-name">Domain Name Service</span>
                                                    <strong class="item-cost">৳ @invoice.DomainCost.ToString("N2")</strong>
                                                </div>
                                            }
                                            <div class="breakdown-row total-row">
                                                <span>Grand Total</span>
                                                <strong>৳ @invoice.Total.ToString("N2")</strong>
                                            </div>
                                        </div>
                                    </details>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        }
    </div>
</div>

@code {
    private sealed class ModuleRow(LicensedModule definition)
    {
        public LicensedModule Definition { get; } = definition;
        public bool Selected { get; set; }
        public decimal MonthlyPrice { get; set; }
        public decimal YearlyPrice { get; set; }
    }

    private List<ModuleRow> modules = [];
    private List<HospitalSubscriptionInvoice> invoices = [];
    private HospitalLicense license = new() { PurchasedAt = DateTime.Today };
    private string? hospitalOwnerName;
    private string ownerUserName = "", ownerPassword = "", message = "";
    private bool loading = true, isError, includeHosting, includeDomain, showPassword;
    private DateTime invoiceStart = DateTime.Today;
    private string selectedCategory = "all";
    private string searchFilter = "";

    private decimal CurrentCycleRate => license.BillingCycle == "Yearly"
        ? modules.Where(x => x.Selected).Sum(x => x.YearlyPrice)
        : modules.Where(x => x.Selected).Sum(x => x.MonthlyPrice);

    private decimal EstimatedInvoiceTotal
    {
        get
        {
            var activeTotal = license.BillingCycle == "Yearly"
                ? modules.Where(x => x.Selected).Sum(x => x.YearlyPrice)
                : modules.Where(x => x.Selected).Sum(x => x.MonthlyPrice);
            if (includeHosting) activeTotal += license.HostingCost;
            if (includeDomain) activeTotal += license.DomainCost;
            return activeTotal;
        }
    }

    private IEnumerable<ModuleRow> FilteredModules => modules
        .Where(m => selectedCategory == "all" || GetModuleCategory(m.Definition.Code) == selectedCategory)
        .Where(m => string.IsNullOrWhiteSpace(searchFilter) ||
                    m.Definition.Name.Contains(searchFilter, StringComparison.OrdinalIgnoreCase) ||
                    m.Definition.Code.Contains(searchFilter, StringComparison.OrdinalIgnoreCase));

    private bool copiedCredentials;

    private async Task CopyCredentialsAsync()
    {
        if (string.IsNullOrEmpty(ownerPassword)) return;
        var text = $"PrimeHPM Hospital Owner Credentials:\nHospital: {Branding.HospitalName}\nUser ID: {ownerUserName}\nPassword: {ownerPassword}\nLogin: /login";
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            copiedCredentials = true;
            StateHasChanged();
            await Task.Delay(2500);
            copiedCredentials = false;
            StateHasChanged();
        }
        catch
        {
            // Fallback
        }
    }

    private void GeneratePassword()
    {
        var specialChars = "@#$%&*!";
        var lettersUpper = "ABCDEFGHJKLMNPQRSTUVWXYZ";
        var lettersLower = "abcdefghjkmnpqrstuvwxyz";
        var digits = "23456789";
        ownerPassword = $"Hpm{lettersUpper[RandomNumberGenerator.GetInt32(lettersUpper.Length)]}{lettersLower[RandomNumberGenerator.GetInt32(lettersLower.Length)]}{digits[RandomNumberGenerator.GetInt32(digits.Length)]}{specialChars[RandomNumberGenerator.GetInt32(specialChars.Length)]}{RandomNumberGenerator.GetInt32(100, 999)}!";
        showPassword = true;
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var existingLicense = await db.HospitalLicenses.AsNoTracking().SingleOrDefaultAsync(x => x.ID == 1);
        license = existingLicense ?? new HospitalLicense { ID = 1, IsActivated = true, PurchasedAt = DateTime.Today };
        var saved = await db.HospitalModuleLicenses.AsNoTracking().ToDictionaryAsync(x => x.ModuleCode);
        modules = LicensedModules.All.Select(def => new ModuleRow(def)
        {
            Selected = existingLicense is null || def.Code == LicensedModules.Registration || (saved.TryGetValue(def.Code, out var item) && item.IsEnabled),
            MonthlyPrice = saved.TryGetValue(def.Code, out item) ? item.MonthlyPrice : 0,
            YearlyPrice = saved.TryGetValue(def.Code, out item) ? item.YearlyPrice : 0
        }).ToList();
        var ownerRole = await db.Roles.AsNoTracking().Where(x => x.Name == RoleNames.HospitalOwner).Select(x => x.Id).FirstOrDefaultAsync();
        hospitalOwnerName = await (from user in db.Users.AsNoTracking() join userRole in db.UserRoles.AsNoTracking() on user.Id equals userRole.UserId where userRole.RoleId == ownerRole select user.UserName).FirstOrDefaultAsync();
        ownerUserName = hospitalOwnerName ?? "";
        ownerPassword = "";
        showPassword = false;
        invoices = await db.HospitalSubscriptionInvoices.AsNoTracking().Include(x => x.Items).OrderByDescending(x => x.ID).Take(50).ToListAsync();
        loading = false;
    }

    private void Toggle(ModuleRow row, bool selected)
    {
        row.Selected = selected;
        var expanded = LicensedModules.WithDependencies(modules.Where(x => x.Selected).Select(x => x.Definition.Code));
        foreach (var item in modules) item.Selected = expanded.Contains(item.Definition.Code);
    }

    private void SelectAllModules()
    {
        foreach (var m in modules) m.Selected = true;
    }

    private void SelectStandardPack()
    {
        var standardCodes = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        {
            LicensedModules.Registration,
            LicensedModules.Appointments,
            LicensedModules.Diagnostics,
            LicensedModules.Doctor,
            LicensedModules.Pharmacy,
            LicensedModules.Ipd,
            LicensedModules.Emergency,
            LicensedModules.Nursing,
            LicensedModules.Reports
        };
        var expanded = LicensedModules.WithDependencies(standardCodes);
        foreach (var m in modules) m.Selected = expanded.Contains(m.Definition.Code);
    }

    private void ResetToCoreOnly()
    {
        foreach (var m in modules) m.Selected = (m.Definition.Code == LicensedModules.Registration);
    }

    private void AddMonthsToExpiry(int months)
    {
        var baseDate = license.SubscriptionExpiresAt ?? DateTime.Today;
        license.SubscriptionExpiresAt = baseDate.AddMonths(months);
    }

    private void AddYearsToExpiry(int years)
    {
        var baseDate = license.SubscriptionExpiresAt ?? DateTime.Today;
        license.SubscriptionExpiresAt = baseDate.AddYears(years);
    }

    private static string GetModuleCategory(string code) => code switch
    {
        LicensedModules.Registration or LicensedModules.Appointments or LicensedModules.Doctor or LicensedModules.Emergency => "clinical",
        LicensedModules.Ipd or LicensedModules.Ot or LicensedModules.Nursing or LicensedModules.BloodBank => "inpatient",
        LicensedModules.Diagnostics => "diagnostics",
        LicensedModules.Pharmacy or LicensedModules.Canteen or LicensedModules.Store => "pharmacy_store",
        LicensedModules.Accounts or LicensedModules.Hrm => "finance_hr",
        _ => "reports_portal"
    };

    private static string GetModuleEmoji(string code) => code switch
    {
        LicensedModules.Registration => "🏥",
        LicensedModules.Appointments => "📅",
        LicensedModules.Diagnostics => "🔬",
        LicensedModules.Doctor => "🩺",
        LicensedModules.Pharmacy => "💊",
        LicensedModules.Ipd => "🛏️",
        LicensedModules.Emergency => "🚨",
        LicensedModules.Ot => "✂️",
        LicensedModules.Nursing => "👩‍⚕️",
        LicensedModules.BloodBank => "🩸",
        LicensedModules.Canteen => "🍽️",
        LicensedModules.Accounts => "💰",
        LicensedModules.Hrm => "👥",
        LicensedModules.Store => "📦",
        LicensedModules.Reports => "📊",
        LicensedModules.Mis => "📈",
        LicensedModules.PatientPortal => "🌐",
        _ => "📦"
    };

    private async Task SaveLicenseAsync()
    {
        if (modules.Any(x => x.MonthlyPrice < 0 || x.YearlyPrice < 0) || license.HostingCost < 0 || license.DomainCost < 0 || license.BillingCycle is not ("Monthly" or "Yearly"))
        {
            Fail("Enter valid non-negative prices and a valid billing cycle.");
            return;
        }
        if (license.PurchasedAt is null || license.SubscriptionExpiresAt is null || license.SubscriptionExpiresAt <= license.PurchasedAt ||
            license.HostingCost > 0 && license.HostingExpiresAt is null || license.DomainCost > 0 && license.DomainExpiresAt is null)
        {
            Fail("Set a valid purchase date and later subscription expiry. Paid hosting or domain also requires expiry dates.");
            return;
        }

        var selected = LicensedModules.WithDependencies(modules.Where(x => x.Selected).Select(x => x.Definition.Code));
        await using var db = await DbFactory.CreateDbContextAsync();
        var current = await db.HospitalLicenses.SingleOrDefaultAsync(x => x.ID == 1);
        if (current is null)
        {
            current = new HospitalLicense { ID = 1 };
            db.HospitalLicenses.Add(current);
        }
        current.IsActivated = true;
        current.BillingCycle = license.BillingCycle;
        current.PurchasedAt = license.PurchasedAt;
        current.SubscriptionExpiresAt = license.SubscriptionExpiresAt;
        current.HostingCost = license.HostingCost;
        current.HostingExpiresAt = license.HostingExpiresAt;
        current.DomainCost = license.DomainCost;
        current.DomainExpiresAt = license.DomainExpiresAt;
        current.UpdatedAt = DateTime.UtcNow;

        var saved = await db.HospitalModuleLicenses.ToDictionaryAsync(x => x.ModuleCode);
        foreach (var row in modules)
        {
            if (!saved.TryGetValue(row.Definition.Code, out var item))
            {
                item = new HospitalModuleLicense { ModuleCode = row.Definition.Code };
                db.HospitalModuleLicenses.Add(item);
            }
            item.IsEnabled = selected.Contains(row.Definition.Code);
            item.MonthlyPrice = row.MonthlyPrice;
            item.YearlyPrice = row.YearlyPrice;
        }

        await AuditAsync(db, "Update", "HospitalLicense", "1", string.Join(",", selected));
        await db.SaveChangesAsync();
        message = "Hospital package configuration and custom prices successfully saved!";
        isError = false;
        await LoadAsync();
    }

    private async Task SaveHospitalOwnerAsync()
    {
        if (string.IsNullOrWhiteSpace(ownerUserName))
        {
            Fail("Please enter a valid User ID.");
            return;
        }
        if (string.IsNullOrWhiteSpace(ownerPassword))
        {
            Fail("Please enter a password.");
            return;
        }

        var targetUserName = ownerUserName.Trim();

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var ownerRole = await db.Roles.AsNoTracking().Where(x => x.Name == RoleNames.HospitalOwner).Select(x => x.Id).FirstOrDefaultAsync();
            AppUser? ownerUser = null;
            if (!string.IsNullOrEmpty(hospitalOwnerName))
            {
                ownerUser = await Users.FindByNameAsync(hospitalOwnerName);
            }
            if (ownerUser is null && ownerRole != 0)
            {
                var existingOwnerId = await db.UserRoles.AsNoTracking().Where(x => x.RoleId == ownerRole).Select(x => x.UserId).FirstOrDefaultAsync();
                if (existingOwnerId != 0)
                {
                    ownerUser = await Users.FindByIdAsync(existingOwnerId.ToString());
                }
            }

            if (ownerUser is null)
            {
                var existingWithSameName = await Users.FindByNameAsync(targetUserName);
                if (existingWithSameName is not null)
                {
                    Fail($"User ID '{targetUserName}' is already in use by another account.");
                    return;
                }

                var user = new AppUser
                {
                    UserName = targetUserName,
                    DisplayName = "Hospital Owner",
                    IsActive = true,
                    EmailConfirmed = true
                };
                var result = await Users.CreateAsync(user, ownerPassword);
                if (!result.Succeeded)
                {
                    Fail(string.Join(" ", result.Errors.Select(x => x.Description)));
                    return;
                }
                result = await Users.AddToRolesAsync(user, [RoleNames.HospitalOwner, RoleNames.Administrator]);
                if (!result.Succeeded)
                {
                    await Users.DeleteAsync(user);
                    Fail(string.Join(" ", result.Errors.Select(x => x.Description)));
                    return;
                }
                hospitalOwnerName = user.UserName;
            }
            else
            {
                // 1. If username was changed
                if (!string.Equals(ownerUser.UserName, targetUserName, StringComparison.OrdinalIgnoreCase))
                {
                    var existingWithSameName = await Users.FindByNameAsync(targetUserName);
                    if (existingWithSameName is not null && existingWithSameName.Id != ownerUser.Id)
                    {
                        Fail($"User ID '{targetUserName}' is already taken by another user.");
                        return;
                    }
                    ownerUser.UserName = targetUserName;
                    ownerUser.NormalizedUserName = Users.NormalizeName(targetUserName);
                    var nameResult = await Users.UpdateAsync(ownerUser);
                    if (!nameResult.Succeeded)
                    {
                        Fail(string.Join(" ", nameResult.Errors.Select(x => x.Description)));
                        return;
                    }
                    hospitalOwnerName = ownerUser.UserName;
                }

                // 2. Update password
                var token = await Users.GeneratePasswordResetTokenAsync(ownerUser);
                var pwResult = await Users.ResetPasswordAsync(ownerUser, token, ownerPassword);
                if (!pwResult.Succeeded)
                {
                    Fail(string.Join(" ", pwResult.Errors.Select(x => x.Description)));
                    return;
                }
                await Users.UpdateSecurityStampAsync(ownerUser);
            }

            await AuditAsync(db, "Update", "HospitalOwner", hospitalOwnerName ?? targetUserName, $"Credentials updated: UserID={targetUserName}");
            await db.SaveChangesAsync();

            message = $"Hospital Owner credentials saved for '{targetUserName}'. Copy the password now; it cannot be recovered after leaving this page.";
            isError = false;
        }
        catch (Exception ex)
        {
            Fail(ex.GetBaseException().Message);
        }
    }

    private async Task IssueInvoiceAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var config = await db.HospitalLicenses.AsNoTracking().SingleOrDefaultAsync(x => x.ID == 1);
        if (config is null || config.BillingCycle is not ("Monthly" or "Yearly"))
        {
            Fail("Please configure and save the subscription package first.");
            return;
        }
        var end = config.BillingCycle == "Monthly" ? invoiceStart.Date.AddMonths(1) : invoiceStart.Date.AddYears(1);
        if (await db.HospitalSubscriptionInvoices.AnyAsync(x => x.PeriodStart == invoiceStart.Date && x.PeriodEnd == end))
        {
            Fail($"An invoice for the period {invoiceStart:dd MMM yyyy} to {end:dd MMM yyyy} already exists.");
            return;
        }
        var active = await db.HospitalModuleLicenses.AsNoTracking().Where(x => x.IsEnabled).ToListAsync();
        var invoice = new HospitalSubscriptionInvoice
        {
            BillingCycle = config.BillingCycle,
            PeriodStart = invoiceStart.Date,
            PeriodEnd = end,
            HostingCost = includeHosting ? config.HostingCost : 0,
            DomainCost = includeDomain ? config.DomainCost : 0
        };
        invoice.Items = active.Select(x => new HospitalSubscriptionInvoiceItem
        {
            ModuleCode = x.ModuleCode,
            ModuleName = LicensedModules.ByCode.GetValueOrDefault(x.ModuleCode)?.Name ?? x.ModuleCode,
            Price = config.BillingCycle == "Monthly" ? x.MonthlyPrice : x.YearlyPrice
        }).ToList();
        invoice.ModuleTotal = invoice.Items.Sum(x => x.Price);
        invoice.Total = invoice.ModuleTotal + invoice.HostingCost + invoice.DomainCost;
        db.HospitalSubscriptionInvoices.Add(invoice);
        await db.SaveChangesAsync();
        await AuditAsync(db, "Create", "SubscriptionInvoice", invoice.ID.ToString(), $"Total={invoice.Total}");
        await db.SaveChangesAsync();
        message = $"Subscription Invoice #{invoice.ID} has been successfully issued for ৳{invoice.Total:N2}!";
        isError = false;
        await LoadAsync();
    }

    private async Task MarkPaidAsync(long id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var invoice = await db.HospitalSubscriptionInvoices.SingleOrDefaultAsync(x => x.ID == id && x.Status == "Issued");
        if (invoice is null) { Fail("Invoice not found or already marked paid."); return; }
        invoice.Status = "Paid";
        invoice.PaidAt = DateTime.UtcNow;
        await AuditAsync(db, "Pay", "SubscriptionInvoice", id.ToString(), $"Total={invoice.Total}");
        await db.SaveChangesAsync();
        message = $"Invoice #{id} marked as Paid successfully!";
        isError = false;
        await LoadAsync();
    }

    private async Task AuditAsync(HpmDbContext db, string action, string entity, string id, string detail)
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        _ = int.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var actorId);
        db.AuditLogs.Add(new AuditLog
        {
            UserID = actorId,
            UserName = user.Identity?.Name ?? "App Owner",
            Action = action,
            EntityName = entity,
            EntityID = id,
            ChangedFields = detail,
            EventTime = DateTime.UtcNow
        });
    }

    private void Fail(string text) { message = text; isError = true; }
}
