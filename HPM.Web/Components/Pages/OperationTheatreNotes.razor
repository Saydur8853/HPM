    private async Task SelectNote(OperationNote note)
    {
        editor = new OperationNote
        {
            ID = note.ID,
            OperationID = note.OperationID,
            RegNo = note.RegNo,
            PatientID = note.PatientID,
            OperationName = note.OperationName,
            Indication = note.Indication,
            OperationDate = note.OperationDate,
            SurgeonID = note.SurgeonID,
            Assistant1ID = note.Assistant1ID,
            Assistant2ID = note.Assistant2ID,
            Assistant3ID = note.Assistant3ID,
            AnaesthetistID = note.AnaesthetistID,
            AnaesthesiaType = note.AnaesthesiaType,
            PreOpDiagnosis = note.PreOpDiagnosis,
            PostOpDiagnosis = note.PostOpDiagnosis,
            ProcedureAndFindings = note.ProcedureAndFindings,
            Incision = note.Incision,
            SpecimenBiopsy = note.SpecimenBiopsy,
            BloodLossEstimate = note.BloodLossEstimate,
            DrainsPacks = note.DrainsPacks,
            PostOpOrders = note.PostOpOrders,
            EnteredBy = note.EnteredBy,
            TransDate = note.TransDate
        };

        await using var db = await DbFactory.CreateDbContextAsync();
        selectedAdmission = await db.PatientAdmissions.AsNoTracking().FirstOrDefaultAsync(x => x.RegNo == note.RegNo);
        if (!string.IsNullOrWhiteSpace(note.PatientID))
        {
            var p = await db.Registrations.AsNoTracking().FirstOrDefaultAsync(x => x.PatientID == note.PatientID);
            if (p != null)
            {
                patientNames[p.PatientID] = p.Name;
                selectedPatientSex = p.Sex;
            }
            else
            {
                selectedPatientSex = "—";
            }
        }
        else
        {
            selectedPatientSex = "—";
        }
        selectedPatientName = patientNames.GetValueOrDefault(note.PatientID, "—");
    }

    private void ResetForm()
    {
        editor = new OperationNote { OperationDate = DateTime.Now };
        selectedAdmission = null;
        selectedPatientName = "";
        selectedPatientSex = "";
        message = null;
    }

    private async Task HandleGlobalKeyDown(KeyboardEventArgs e)
    {
        if ((e.CtrlKey || e.MetaKey) && (e.Key == "s" || e.Key == "S" || e.Key == "Enter"))
        {
            await SaveAsync();
        }
        else if ((e.CtrlKey || e.MetaKey) && (e.Key == "p" || e.Key == "P"))
        {
            if (editor.ID > 0)
            {
                await PrintNoteAsync();
            }
        }
        else if (e.Key == "Escape" || e.Key == "F2")
        {
            ResetForm();
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(editor.RegNo) || string.IsNullOrWhiteSpace(editor.PatientID))
        {
            message = I18n.IsBangla ? "অনুগ্রহ করে একজন রোগী নির্বাচন করুন।" : "Please select a patient.";
            messageClass = "danger";
            return;
        }

        if (string.IsNullOrWhiteSpace(editor.OperationName))
        {
            message = I18n.IsBangla ? "অপারেশন বা সার্জারির নাম লিখুন।" : "Please enter operation name.";
            messageClass = "danger";
            return;
        }

        if (editor.SurgeonID <= 0)
        {
            message = I18n.IsBangla ? "সার্জন নির্বাচন করুন।" : "Please select a lead surgeon.";
            messageClass = "danger";
            return;
        }

        isSaving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (editor.ID == 0)
            {
                editor.TransDate = DateTime.Now;
                db.OperationNotes.Add(editor);
                await db.SaveChangesAsync();
                message = I18n.IsBangla ? "ওটি ক্লিনিক্যাল নোট সফলভাবে সংরক্ষিত হয়েছে।" : "OT clinical note saved successfully.";
            }
            else
            {
                var existing = await db.OperationNotes.FindAsync(editor.ID);
                if (existing != null)
                {
                    existing.OperationID = editor.OperationID;
                    existing.OperationName = editor.OperationName;
                    existing.Indication = editor.Indication;
                    existing.OperationDate = editor.OperationDate;
                    existing.SurgeonID = editor.SurgeonID;
                    existing.Assistant1ID = editor.Assistant1ID;
                    existing.Assistant2ID = editor.Assistant2ID;
                    existing.Assistant3ID = editor.Assistant3ID;
                    existing.AnaesthetistID = editor.AnaesthetistID;
                    existing.AnaesthesiaType = editor.AnaesthesiaType;
                    existing.PreOpDiagnosis = editor.PreOpDiagnosis;
                    existing.PostOpDiagnosis = editor.PostOpDiagnosis;
                    existing.ProcedureAndFindings = editor.ProcedureAndFindings;
                    existing.Incision = editor.Incision;
                    existing.SpecimenBiopsy = editor.SpecimenBiopsy;
                    existing.BloodLossEstimate = editor.BloodLossEstimate;
                    existing.DrainsPacks = editor.DrainsPacks;
                    existing.PostOpOrders = editor.PostOpOrders;
                    await db.SaveChangesAsync();
                    message = I18n.IsBangla ? "ওটি নোট সফলভাবে আপডেট করা হয়েছে।" : "OT note updated successfully.";
                }
            }

            messageClass = "success";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            message = $"Error saving OT note: {ex.Message}";
            messageClass = "danger";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (editor.ID == 0) return;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var item = await db.OperationNotes.FindAsync(editor.ID);
            if (item != null)
            {
                db.OperationNotes.Remove(item);
                await db.SaveChangesAsync();
                message = I18n.IsBangla ? "ওটি নোট মুছে ফেলা হয়েছে।" : "OT note deleted.";
                messageClass = "success";
                ResetForm();
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            message = $"Error deleting: {ex.Message}";
            messageClass = "danger";
        }
    }

    private async Task PrintNoteAsync() => await JS.InvokeVoidAsync("hpm.printElement", "ot-note-print");

    private async Task PrintSpecificNoteAsync(OperationNote note)
    {
        await SelectNote(note);
        await Task.Delay(100);
        await PrintNoteAsync();
    }

    private string DoctorName(int? id)
    {
        if (!id.HasValue || id.Value <= 0) return "—";
        var doc = doctors.FirstOrDefault(d => d.ID == id.Value);
        return doc != null ? DoctorDisplayName(doc) : "—";
    }

    private static string DoctorDisplayName(DoctorsProfile d)
    {
        var title = d.Title?.Trim();
        var name = d.Name?.Trim() ?? "";
        return string.IsNullOrWhiteSpace(title) ? name : $"{title} {name}".Trim();
    }

    private string BedName(int? id) => id.HasValue && bedNames.TryGetValue(id.Value, out var n) ? n : "—";
    private string DepartmentName(int? id) => id.HasValue && departmentNames.TryGetValue(id.Value, out var n) ? n : "—";

    public void Dispose()
    {
        dotNetRef?.Dispose();
    }
}
