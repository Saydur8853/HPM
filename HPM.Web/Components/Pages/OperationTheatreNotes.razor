@page "/medical/ot-notes"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.Doctor + "," + RoleNames.OTOperator)]
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IBarcodeQrService BarcodeQr
@implements IDisposable
@using System.Security.Claims
@using HPM.Web.Components.Common
@using HPM.Web.Data
@using HPM.Web.Data.Entities
@using HPM.Web.Services
@using Microsoft.EntityFrameworkCore

<PageTitle>@I18n.T("Surgeon's OT Clinical Note") | @Branding.HospitalName</PageTitle>

<style>
.ot-classic-page {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 10px 16px 24px;
    max-width: 1560px;
    margin: 0 auto;
    outline: none;
}
.ot-top-nav-links {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    margin-bottom: 6px;
    flex-wrap: wrap;
}
.ot-top-nav-link {
    color: #0284c7;
    text-decoration: none;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 4px;
    background: #f0f9ff;
    border: 1px solid #bae6fd;
    transition: all 0.15s ease;
}
.ot-top-nav-link:hover {
    background: #0284c7;
    color: #ffffff;
    border-color: #0284c7;
}

/* KPI Summary Metric Cards */
.ipd-kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 12px;
}
.ipd-kpi-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.04);
}
.ipd-kpi-info {
    display: flex;
    flex-direction: column;
}
.ipd-kpi-label {
    font-size: 11px;
    font-weight: 750;
    text-transform: uppercase;
    color: #64748b;
    letter-spacing: 0.5px;
}
.ipd-kpi-val {
    font-size: 22px;
    font-weight: 900;
    line-height: 1.2;
    margin-top: 2px;
}
.ipd-kpi-sub {
    font-size: 11px;
    color: #64748b;
    margin-top: 2px;
}
.ipd-kpi-icon {
    font-size: 26px;
    opacity: 0.85;
}

/* Workspace 2-Column Grid */
.ot-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(360px, 1fr);
    gap: 14px;
    align-items: start;
}
@@media (max-width: 1024px) {
    .ot-grid {
        grid-template-columns: 1fr;
    }
}
.ot-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
    overflow: hidden;
}
.ot-card-header {
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    padding: 10px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.ot-card-header h2 {
    font-size: 13.5px;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 7px;
}
.ot-card-body {
    padding: 14px 16px;
}
.ot-form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px 14px;
}
.ot-form-col-full {
    grid-column: 1 / -1;
}
.ot-field-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
}
.ot-field-label {
    font-size: 11px;
    font-weight: 700;
    color: #334155;
    display: flex;
    justify-content: space-between;
}
.ot-field-label .req {
    color: #dc2626;
    margin-left: 2px;
}

/* Patient Lazy Suggestions List */
.ot-patient-suggestions {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    width: 100%;
    max-height: 280px;
    overflow-y: auto;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.12);
    z-index: 120;
    display: flex;
    flex-direction: column;
}
.ot-patient-clean-option {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 8px 12px;
    background: none;
    border: none;
    border-bottom: 1px solid #f1f5f9;
    text-align: left;
    font-size: 11.5px;
    cursor: pointer;
    transition: background 0.12s;
}
.ot-patient-clean-option:hover {
    background: #f0f9ff;
}
.ot-scroll-hint {
    padding: 6px 10px;
    text-align: center;
    background: #f8fafc;
    border-top: 1px solid #e2e8f0;
    font-size: 10.5px;
    color: #0284c7;
    font-weight: 600;
    cursor: pointer;
}

/* OT Notes List Items */
.ot-item-row {
    padding: 10px 12px;
    border-bottom: 1px solid #f1f5f9;
    cursor: pointer;
    transition: background 0.12s ease;
}
.ot-item-row:hover {
    background: #f8fafc;
}
.ot-item-row.selected {
    background: #f0f9ff;
    border-left: 3px solid #0284c7;
}

/* Print Sheets */
@@media print {
    body * {
        visibility: hidden;
    }
    #ot-note-print, #ot-note-print * {
        visibility: visible;
    }
    #ot-note-print {
        display: block !important;
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        margin: 0;
        padding: 10mm 14mm;
        box-sizing: border-box;
    }
}
</style>

<div class="ot-classic-page" @onkeydown="HandleGlobalKeyDown" tabindex="0">
    <!-- 1. Top Flow Links & Action Bar -->
    <div>
        <div class="ot-top-nav-links">
            <span style="color:#64748b; font-weight:700;">@I18n.T("Medical Services Flow", "মেডিকেল সার্ভিসেস ফ্লো"):</span>
            <a href="/medical/operations" class="ot-top-nav-link">🗓️ @I18n.T("OT Schedule & Register", "ওটি শিডিউল")</a>
            <span>→</span>
            <span class="ot-top-nav-link" style="background:#e0f2fe; color:#0369a1; font-weight:750;">📝 @I18n.T("Surgeon's OT Note (Current)", "সার্জন্স ওটি নোট")</span>
            <span>→</span>
            <a href="/ot-cash-memos" class="ot-top-nav-link">💳 @I18n.T("OT Cash Memo / Billing", "ওটি বিলিং")</a>
            <span>&bull;</span>
            <a href="/medical/nurse-desk" class="ot-top-nav-link">🩺 @I18n.T("Nurse's Desk", "নার্সেস ডেস্ক")</a>
        </div>

        <div class="appt-classic-topbar">
            <div class="appt-top-left">
                <h1 class="appt-page-title">
                    <span>📝</span>
                    <span>@I18n.T("Surgeon's Operation Theatre (OT) Clinical Note", "সার্জনের অপারেশন থিয়েটার ক্লিনিক্যাল নোট")</span>
                </h1>
                <span class="appt-count-pill">
                    @otNotes.Count @I18n.T("Total Notes", "মোট নোট")
                </span>
                <span class="appt-count-pill" style="background:#eff6ff; color:#1d4ed8; border-color:#bfdbfe;">
                    📅 @todayNotesCount @I18n.T("Today's Notes", "আজকের নোট")
                </span>
                @if (!string.IsNullOrWhiteSpace(message))
                {
                    <span class="appt-inline-alert @messageClass">
                        @(messageClass == "success" ? "✓" : "⚠") @message
                    </span>
                }
            </div>

            <div class="appt-top-actions">
                <a href="/medical/operations" class="btn btn-secondary appt-btn" style="text-decoration:none;" title="@I18n.T("Open OT Schedule & Booking Workspace")">
                    📅 @I18n.T("OT Schedule", "ওটি শিডিউল")
                </a>
                <button type="button" class="btn btn-ghost appt-btn" @onclick="ResetForm" title="@I18n.T("New OT Note (F2 / Esc)")">
                    + @I18n.T("New OT Note", "নতুন ওটি নোট")
                </button>
            </div>
        </div>
    </div>

    <!-- 2. Real-time KPI Metric Summary Cards -->
    <div class="ipd-kpi-grid">
        <div class="ipd-kpi-card" style="border-left: 4px solid #0284c7;">
            <div class="ipd-kpi-info">
                <div class="ipd-kpi-label">@I18n.T("Today's OT Notes", "আজকের ওটি নোট")</div>
                <div class="ipd-kpi-val" style="color: #0369a1;">@todayNotesCount</div>
                <div class="ipd-kpi-sub">@I18n.T("Documented in theatre today", "আজ থিয়েটারে লিখিত")</div>
            </div>
            <div class="ipd-kpi-icon">📝</div>
        </div>

        <div class="ipd-kpi-card" style="border-left: 4px solid #10b981;">
            <div class="ipd-kpi-info">
                <div class="ipd-kpi-label">@I18n.T("Total Notes Logged", "মোট নোট রেকর্ড")</div>
                <div class="ipd-kpi-val" style="color: #047857;">@otNotes.Count</div>
                <div class="ipd-kpi-sub">@I18n.T("Permanent surgical archive", "স্থায়ী অপারেশন আর্কাইভ")</div>
            </div>
            <div class="ipd-kpi-icon">📋</div>
        </div>

        <div class="ipd-kpi-card" style="border-left: 4px solid #8b5cf6;">
            <div class="ipd-kpi-info">
                <div class="ipd-kpi-label">@I18n.T("Active Inpatients", "ভর্তি রোগী")</div>
                <div class="ipd-kpi-val" style="color: #6d28d9;">@totalActiveInpatients</div>
                <div class="ipd-kpi-sub">@I18n.T("Eligible for surgical notes", "সার্জারি নোটের জন্য যোগ্য")</div>
            </div>
            <div class="ipd-kpi-icon">🛏️</div>
        </div>

        <div class="ipd-kpi-card" style="border-left: 4px solid #f59e0b;">
            <div class="ipd-kpi-info">
                <div class="ipd-kpi-label">@I18n.T("Available Surgeons", "তালিকাভুক্ত সার্জন")</div>
                <div class="ipd-kpi-val" style="color: #b45309;">@doctors.Count</div>
                <div class="ipd-kpi-sub">@I18n.T("Specialists & Consultants", "বিশেষজ্ঞ ও কনসালট্যান্ট")</div>
            </div>
            <div class="ipd-kpi-icon">🩺</div>
        </div>
    </div>

    <!-- 3. Main Workspace -->
    <div class="ot-grid">
        <!-- Left: OT Note Form -->
        <div class="ot-card">
            <div class="ot-card-header">
                <h2>
                    <span>@(editor.ID == 0 ? "➕ " + I18n.T("Document Post-Operative Note", "নতুন ওটি ক্লিনিক্যাল নোট তৈরি") : $"✏️ {I18n.T("Edit OT Note")} #OTN-{editor.ID:D5}")</span>
                </h2>
                <div style="display:flex; align-items:center; gap:8px;">
                    @if (editor.ID > 0)
                    {
                        <span class="badge" style="background:#ecfdf5; color:#047857; font-weight:800; font-size:11px;">
                            ✓ @I18n.T("SAVED NOTE", "সংরক্ষিত")
                        </span>
                        <button type="button" class="btn btn-secondary appt-btn" style="height:26px; padding:0 10px; font-size:11px;" @onclick="PrintNoteAsync">
                            🖨️ @I18n.T("Print", "প্রিন্ট")
                        </button>
                    }
                </div>
            </div>

            <div class="ot-card-body">
                <!-- Quick Auto-Fill from Scheduled Surgery Booking -->
                @if (activeScheduledOperations.Any() && editor.ID == 0)
                {
                    <div style="background:#f0fdf4; border:1px solid #bbf7d0; border-radius:6px; padding:8px 12px; margin-bottom:12px; display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap;">
                        <div style="display:flex; align-items:center; gap:6px; font-size:11.5px; color:#166534; font-weight:700;">
                            <span>🗓️</span>
                            <span>@I18n.T("Auto-Fill from OT Schedule:", "ওটি শিডিউল থেকে তথ্য আনুন:"):</span>
                        </div>
                        <select class="classic-input" style="height:28px !important; min-height:28px !important; font-size:11px !important; width:auto; max-width:400px; background:#ffffff;"
                                @onchange="OnScheduledOpSelected">
                            <option value="0">-- @I18n.T("Pick a surgery from OT schedule...") (@activeScheduledOperations.Count) --</option>
                            @foreach (var op in activeScheduledOperations)
                            {
                                var pName = patientNames.GetValueOrDefault(op.PatientID ?? "", op.PatientID ?? "");
                                <option value="@op.ID">
                                    @op.OperationDate.ToString("dd MMM, hh:mm tt") &bull; @pName (#@op.RegNo) - @op.ProcedureName
                                </option>
                            }
                        </select>
                    </div>
                }

                <!-- Patient Search & Selection with Infinite Scroll Lazy Loading -->
                <div class="ot-field-group" style="margin-bottom: 12px;">
                    <span class="ot-field-label">
                        <span>@I18n.T("Select Inpatient / Admission", "রোগী / ভর্তি তথ্য নির্বাচন করুন") <span class="req">*</span></span>
                        <span style="color:#64748b; font-weight:600;">@totalActiveInpatients @I18n.T("Active Inpatients", "জন ভর্তি রোগী")</span>
                    </span>

                    @if (selectedAdmission != null)
                    {
                        <div class="appt-patient-verified" style="display:flex; justify-content:space-between; align-items:center; background:#f0f9ff; border:1px solid #bae6fd; padding:8px 12px; border-radius:6px;">
                            <div style="font-size:11.5px; color:#0f172a;">
                                <strong>#@selectedAdmission.PatientID</strong> &bull; <b style="color:#0284c7;">@selectedPatientName</b>
                                &bull; <span>Age: @selectedAdmission.Age</span>
                                &bull; <strong>🛏️ @BedName(selectedAdmission.BedCabinID)</strong>
                                &bull; <span>Reg: <strong>@selectedAdmission.RegNo</strong></span>
                                &bull; <span>Consultant: 👨‍⚕️ @DoctorName(selectedAdmission.Consultant)</span>
                            </div>
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="ClearSelectedPatient" style="font-size:11px; padding:2px 8px; color:#0369a1;">
                                @I18n.T("Change", "পরিবর্তন")
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="appt-patient-search-combo" style="position:relative; width:100%;">
                            <input class="classic-input"
                                   style="height:32px !important; min-height:32px !important;"
                                   value="@patientSearchQuery"
                                   @oninput="HandlePatientSearchInputAsync"
                                   @onfocus="ShowPatientSuggestionsAsync"
                                   autocomplete="off"
                                   placeholder="@I18n.T("Search by Patient ID, Name, Reg # or Bed...", "রোগীর আইডি, নাম, রেজি. বা বেড দিয়ে খুঁজুন...")" />
                            @if (showPatientDropdown)
                            {
                                <div class="tickets-type-dropdown-backdrop" style="position:fixed; inset:0; z-index:110;" @onclick="() => showPatientDropdown = false"></div>
                                <div class="ot-patient-suggestions" id="ot-notes-patient-suggestions-list">
                                    @foreach (var adm in suggestedAdmissions)
                                    {
                                        var pName = patientNames.GetValueOrDefault(adm.PatientID ?? "", "—");
                                        <button type="button" class="ot-patient-clean-option"
                                                @onmousedown:preventDefault
                                                @onclick="() => SelectAdmission(adm)">
                                            <span style="font-weight:800; color:#0284c7; min-width:82px;">#@adm.RegNo</span>
                                            <span class="pill" style="font-size:9.5px; background:#e0f2fe; color:#0369a1; padding:1px 5px; flex-shrink:0; font-weight:750;">ID: @adm.PatientID</span>
                                            <span style="font-weight:700; color:#0f172a; flex:1; min-width:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@pName</span>
                                            <span style="font-size:11px; color:#64748b; flex-shrink:0;">🛏️ @BedName(adm.BedCabinID)</span>
                                            <span style="font-size:10px; color:#64748b; flex-shrink:0;">👨‍⚕️ @DoctorName(adm.Consultant)</span>
                                        </button>
                                    }
                                    @if (suggestedAdmissions.Count == 0)
                                    {
                                        <div style="padding:12px; font-size:11.5px; color:#64748b; text-align:center;">
                                            @I18n.T("No matching admitted patient found", "কোনো রোগী পাওয়া যায়নি")
                                        </div>
                                    }
                                    else if (hasMorePatientSuggestions)
                                    {
                                        <div class="ot-scroll-hint"
                                             @onmousedown:preventDefault
                                             @onclick="LoadMorePatientsFromJs">
                                            @if (isLoadingMorePatients)
                                            {
                                                <span>⏳ @I18n.T("Loading more...", "আরো লোড হচ্ছে...")</span>
                                            }
                                            else
                                            {
                                                <span>@I18n.T("Showing") @suggestedAdmissions.Count &bull; @I18n.T("Scroll for more...", "আরো দেখতে স্ক্রোল করুন...")</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="ot-form-grid">
                    <!-- Operation Name -->
                    <div class="ot-field-group ot-form-col-full">
                        <span class="ot-field-label">
                            <span>@I18n.T("Operation / Procedure Done", "সম্পন্ন অপারেশনের নাম") <span class="req">*</span></span>
                        </span>
                        <input class="classic-input"
                               style="height:32px !important;"
                               @bind="editor.OperationName"
                               list="commonOtProcedures"
                               placeholder="@I18n.T("e.g. Laparoscopic Appendectomy, LSCS, Inguinal Hernioplasty, Cholecystectomy...")" />
                        <datalist id="commonOtProcedures">
                            <option value="Lower Segment Caesarean Section (LSCS)" />
                            <option value="Laparoscopic Cholecystectomy" />
                            <option value="Appendectomy (Laparoscopic / Open)" />
                            <option value="Inguinal Hernioplasty (Lichtenstein Mesh Repair)" />
                            <option value="Exploratory Laparotomy" />
                            <option value="Total Abdominal Hysterectomy (TAH)" />
                            <option value="TURP (Transurethral Resection of Prostate)" />
                            <option value="Open Reduction & Internal Fixation (ORIF)" />
                            <option value="K-Wire Fixation / Fracture Repair" />
                            <option value="Tonsillectomy & Adenoidectomy" />
                            <option value="Cataract Phacoemulsification with IOL" />
                        </datalist>
                    </div>

                    <!-- Indication -->
                    <div class="ot-field-group">
                        <span class="ot-field-label">
                            <span>@I18n.T("Indication for Surgery", "অপারেশনের কারণ / ইন্ডিকেশন")</span>
                        </span>
                        <input class="classic-input"
                               style="height:32px !important;"
                               @bind="editor.Indication"
                               placeholder="@I18n.T("e.g. Acute Appendicitis, Foetal Distress, Obstructed Hernia...")" />
                    </div>

                    <!-- Operation Date & Time -->
                    <div class="ot-field-group">
                        <span class="ot-field-label">
                            <span>@I18n.T("Operation Date & Time", "অপারেশনের তারিখ ও সময়") <span class="req">*</span></span>
                        </span>
                        <input type="datetime-local"
                               class="classic-input"
                               style="height:32px !important;"
                               @bind="editor.OperationDate" />
                    </div>

                    <!-- Lead Surgeon -->
                    <div class="ot-field-group">
                        <span class="ot-field-label">
                            <span>@I18n.T("Lead Surgeon", "প্রধান সার্জন") <span class="req">*</span></span>
                        </span>
                        <DoctorPicker Doctors="doctors" Value="selectedSurgeonId" ValueChanged="OnSurgeonChanged"
                                      CacheKey="ot_lead_surgeon"
                                      Placeholder="@I18n.T("Search lead surgeon...")" />
                    </div>

                    <!-- Anaesthesiologist -->
                    <div class="ot-field-group">
                        <span class="ot-field-label">
                            <span>@I18n.T("Anaesthesiologist", "অ্যানেস্থেসিওলজিস্ট")</span>
                        </span>
                        <DoctorPicker Doctors="doctors" Value="editor.AnaesthetistID" ValueChanged="id => editor.AnaesthetistID = id"
                                      CacheKey="ot_anaesthetist"
                                      Placeholder="@I18n.T("Search anaesthesiologist...")" />
                    </div>

                    <!-- Assistant 1 -->
                    <div class="ot-field-group">
                        <span class="ot-field-label">
                            <span>@I18n.T("Assistant Surgeon 1", "১ম সহকারী সার্জন")</span>
                        </span>
                        <DoctorPicker Doctors="doctors" Value="editor.Assistant1ID" ValueChanged="id => editor.Assistant1ID = id"
                                      CacheKey="ot_assistant_surgeon"
                                      Placeholder="@I18n.T("Search assistant surgeon 1...")" />
                    </div>

                    <!-- Assistant 2 -->
                    <div class="ot-field-group">
                        <span class="ot-field-label">
                            <span>@I18n.T("Assistant Surgeon 2", "২য় সহকারী সার্জন")</span>
                        </span>
                        <DoctorPicker Doctors="doctors" Value="editor.Assistant2ID" ValueChanged="id => editor.Assistant2ID = id"
                                      CacheKey="ot_assistant_surgeon"
                                      Placeholder="@I18n.T("Search assistant surgeon 2...")" />
                    </div>

                    <!-- Assistant 3 -->
                    <div class="ot-field-group">
                        <span class="ot-field-label">
                            <span>@I18n.T("Assistant Surgeon 3 / Trainee", "৩য় সহকারী সার্জন / ট্রেইনি")</span>
                        </span>
                        <DoctorPicker Doctors="doctors" Value="editor.Assistant3ID" ValueChanged="id => editor.Assistant3ID = id"
                                      CacheKey="ot_assistant_surgeon"
                                      Placeholder="@I18n.T("Search assistant surgeon 3...")" />
                    </div>

                    <!-- Anaesthesia Method -->
                    <div class="ot-field-group">
                        <span class="ot-field-label">
                            <span>@I18n.T("Anaesthesia Method", "অ্যানেস্থেসিয়া পদ্ধতি")</span>
                        </span>
                        <select class="classic-input" style="height:32px !important;" @bind="editor.AnaesthesiaType">
                            <option value="General Anaesthesia (GA)">General Anaesthesia (GA)</option>
                            <option value="Spinal Anaesthesia (SAB)">Spinal Anaesthesia (SAB)</option>
                            <option value="Epidural Anaesthesia">Epidural Anaesthesia</option>
                            <option value="Local Anaesthesia (LA)">Local Anaesthesia (LA)</option>
                            <option value="Sedation / Monitored Care (MAC)">Sedation / Monitored Care (MAC)</option>
                            <option value="Nerve Block">Nerve Block</option>
                        </select>
                    </div>

                    <!-- Pre-Op Diagnosis -->
                    <div class="ot-field-group">
                        <span class="ot-field-label">
                            <span>@I18n.T("Pre-Operative Diagnosis", "প্রি-অপারেটিভ ডায়াগনোসিস")</span>
                        </span>
                        <input class="classic-input"
                               style="height:32px !important;"
                               @bind="editor.PreOpDiagnosis"
                               placeholder="@I18n.T("e.g. Subacute Appendicitis, Cholelithiasis...")" />
                    </div>

                    <!-- Post-Op Diagnosis -->
                    <div class="ot-field-group">
                        <span class="ot-field-label">
                            <span>@I18n.T("Post-Operative Diagnosis", "পোস্ট-অপারেটিভ ডায়াগনোসিস")</span>
                        </span>
                        <input class="classic-input"
                               style="height:32px !important;"
                               @bind="editor.PostOpDiagnosis"
                               placeholder="@I18n.T("e.g. Gangrenous Perforated Appendix, Gallbladder Empyema...")" />
                    </div>

                    <!-- Incision & Approach -->
                    <div class="ot-field-group">
                        <span class="ot-field-label">
                            <span>@I18n.T("Incision & Surgical Approach", "ইনসিশন ও সার্জিক্যাল পদ্ধতি")</span>
                        </span>
                        <input class="classic-input"
                               style="height:32px !important;"
                               @bind="editor.Incision"
                               placeholder="@I18n.T("e.g. Right lower grid-iron / McBurney, 3-port laparoscopy, Pfannenstiel...")" />
                    </div>

                    <!-- Specimen Biopsy -->
                    <div class="ot-field-group">
                        <span class="ot-field-label">
                            <span>@I18n.T("Specimen for Histopathology", "হিস্টোপ্যাথলজি বায়োপ্সি স্পেসিমেন")</span>
                        </span>
                        <input class="classic-input"
                               style="height:32px !important;"
                               @bind="editor.SpecimenBiopsy"
                               placeholder="@I18n.T("e.g. Appendix in 10% formalin for biopsy, Gallbladder with stones...")" />
                    </div>

                    <!-- Blood Loss & Drains -->
                    <div class="ot-field-group">
                        <span class="ot-field-label">
                            <span>@I18n.T("Estimated Blood Loss (ml)", "রক্তক্ষরণ (মি.লি.)")</span>
                        </span>
                        <input class="classic-input"
                               style="height:32px !important;"
                               @bind="editor.BloodLossEstimate"
                               placeholder="@I18n.T("e.g. ~50 ml, Minimal, 250 ml")" />
                    </div>

                    <div class="ot-field-group">
                        <span class="ot-field-label">
                            <span>@I18n.T("Drains / Packs Left in Situ", "ড্রেন বা প্যাকের বিবরণ")</span>
                        </span>
                        <input class="classic-input"
                               style="height:32px !important;"
                               @bind="editor.DrainsPacks"
                               placeholder="@I18n.T("e.g. Corrugated rubber drain in Morrison pouch, No drain left, Foley in situ")" />
                    </div>

                    <!-- Detailed Operative Findings & Surgical Steps with Quick Templates -->
                    <div class="ot-field-group ot-form-col-full">
                        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:4px; flex-wrap:wrap; gap:6px;">
                            <span class="ot-field-label" style="margin-bottom:0;">
                                <span>@I18n.T("Detailed Operative Findings & Surgical Steps", "বিস্তারিত অপারেশন বিবরণী ও ফাইন্ডিংস") <span class="req">*</span></span>
                            </span>
                            <div style="display:flex; align-items:center; gap:4px; flex-wrap:wrap;">
                                <span style="font-size:10.5px; font-weight:750; color:#0369a1;">⚡ @I18n.T("Quick Templates:", "কুইক টেমপ্লেট:"):</span>
                                <button type="button" class="btn btn-ghost btn-sm" style="font-size:10px; padding:1px 7px; height:22px; border-radius:11px; background:#f0f9ff; border:1px solid #bae6fd; color:#0284c7; font-weight:700;"
                                        @onclick='() => ApplyPreset("lscs")' title="@I18n.T("Apply Caesarean Section (LSCS) Protocol")">
                                    👶 LSCS
                                </button>
                                <button type="button" class="btn btn-ghost btn-sm" style="font-size:10px; padding:1px 7px; height:22px; border-radius:11px; background:#f0f9ff; border:1px solid #bae6fd; color:#0284c7; font-weight:700;"
                                        @onclick='() => ApplyPreset("lap_chole")' title="@I18n.T("Apply Laparoscopic Cholecystectomy Protocol")">
                                    🔬 Lap Chole
                                </button>
                                <button type="button" class="btn btn-ghost btn-sm" style="font-size:10px; padding:1px 7px; height:22px; border-radius:11px; background:#f0f9ff; border:1px solid #bae6fd; color:#0284c7; font-weight:700;"
                                        @onclick='() => ApplyPreset("appendectomy")' title="@I18n.T("Apply Appendectomy Protocol")">
                                    🩹 Appendectomy
                                </button>
                                <button type="button" class="btn btn-ghost btn-sm" style="font-size:10px; padding:1px 7px; height:22px; border-radius:11px; background:#f0f9ff; border:1px solid #bae6fd; color:#0284c7; font-weight:700;"
                                        @onclick='() => ApplyPreset("hernioplasty")' title="@I18n.T("Apply Inguinal Hernioplasty Protocol")">
                                    🛡️ Hernioplasty
                                </button>
                                <button type="button" class="btn btn-ghost btn-sm" style="font-size:10px; padding:1px 7px; height:22px; border-radius:11px; background:#f0f9ff; border:1px solid #bae6fd; color:#0284c7; font-weight:700;"
                                        @onclick='() => ApplyPreset("general")' title="@I18n.T("Apply Standard Surgical Skeleton")">
                                    📋 Standard
                                </button>
                            </div>
                        </div>

                        <textarea class="classic-input"
                                  rows="6"
                                  style="min-height:130px; resize:vertical; font-family:monospace; font-size:12px; line-height:1.5;"
                                  @bind="editor.ProcedureAndFindings"
                                  placeholder="@I18n.T("Describe anesthesia, patient position, painting, draping, incision, pathological findings, operative steps, ligation, resection/repair, hemostasis, sponge/mop count verification, and abdominal closure in layers...")"></textarea>

                        <!-- WHO Surgical Safety Checklist Standard Verification -->
                        <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:6px; padding:7px 12px; margin-top:6px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px;">
                            <div style="font-size:11px; font-weight:800; color:#334155; display:flex; align-items:center; gap:5px;">
                                <span>🛡️</span>
                                <span>@I18n.T("WHO Surgical Safety Protocol Check:", "হু সার্জিক্যাল সেফটি প্রোটোকল:"):</span>
                            </div>
                            <div style="display:flex; align-items:center; gap:14px; font-size:11px; color:#0f172a; flex-wrap:wrap;">
                                <label style="display:inline-flex; align-items:center; gap:4px; cursor:pointer;">
                                    <input type="checkbox" @bind="spongeCountVerified" />
                                    <span style="font-weight:600;">@I18n.T("Sponges / Mops Count Correct", "মপ / স্পঞ্জ গণনা সঠিক")</span>
                                </label>
                                <label style="display:inline-flex; align-items:center; gap:4px; cursor:pointer;">
                                    <input type="checkbox" @bind="needleCountVerified" />
                                    <span style="font-weight:600;">@I18n.T("Needles & Sutures Correct", "নিডল ও সুই গণনা সঠিক")</span>
                                </label>
                                <label style="display:inline-flex; align-items:center; gap:4px; cursor:pointer;">
                                    <input type="checkbox" @bind="instrumentsCountVerified" />
                                    <span style="font-weight:600;">@I18n.T("Instruments Count Correct", "যন্ত্রপাতি গণনা সঠিক")</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Post-Operative Orders / Immediate Care -->
                    <div class="ot-field-group ot-form-col-full">
                        <span class="ot-field-label">
                            <span>@I18n.T("Immediate Post-Operative Orders", "পোস্ট-অপারেটিভ পরবর্তী পরিচর্যা নির্দেশিকা")</span>
                        </span>
                        <textarea class="classic-input"
                                  rows="3"
                                  style="min-height:70px; resize:vertical; font-size:12px;"
                                  @bind="editor.PostOpOrders"
                                  placeholder="@I18n.T("e.g. Monitor vitals 1/2 hourly for 2 hours, NPO till bowel sounds return, IV Fluids 1000ml D/S at 30 dpm, Inj. Ceftriaxone 1g IV BD, Inj. Ketorolac 30mg IV SOS, check drain output...")"></textarea>
                    </div>
                </div>
            </div>

            <!-- Footer Action Buttons -->
            <div class="appt-form-footer" style="display:flex !important; align-items:center !important; justify-content:space-between !important; padding:9px 16px !important; background:#f8fafc !important; border-top:1px solid #e2e8f0 !important; border-bottom-left-radius:7px; border-bottom-right-radius:7px;">
                <div class="appt-footer-left-info" style="display:flex; align-items:center; gap:8px;">
                    @if (editor.ID > 0)
                    {
                        <button type="button" class="btn btn-ghost appt-btn" style="color:#dc2626;" @onclick="DeleteAsync" title="@I18n.T("Delete OT Note")">
                            🗑️ @I18n.T("Delete", "মুছুন")
                        </button>
                    }
                    <button type="button" class="btn btn-ghost appt-btn" @onclick="ResetForm" title="@I18n.T("Clear Form (Esc)")">
                        @I18n.T("Clear / New", "ক্লিয়ার / নতুন")
                    </button>
                </div>

                <div class="appt-footer-right-actions" style="margin-left:auto !important; display:flex !important; align-items:center !important; gap:8px !important;">
                    @if (editor.ID > 0)
                    {
                        <button type="button" class="btn btn-secondary appt-btn" @onclick="PrintNoteAsync" title="@I18n.T("Print Official A4 Surgical OT Note (Ctrl+P)")">
                            🖨️ @I18n.T("Print A4 Note", "ওটি নোট প্রিন্ট")
                        </button>
                        <a href="/ot-cash-memos?patientId=@editor.PatientID" class="btn btn-secondary appt-btn" style="text-decoration:none;" title="@I18n.T("Proceed to OT Cash Memo Billing")">
                            💳 @I18n.T("OT Bill →", "ওটি বিল →")
                        </a>
                    }

                    <button type="button" class="btn btn-primary appt-btn appt-book-btn" @onclick="SaveAsync" disabled="@isSaving" title="@I18n.T("Save Post-Operative Note (Ctrl+Enter / Ctrl+S)")">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="width:12px; height:12px; margin-right:4px;"></span>
                            <span>@I18n.T("Saving...")</span>
                        }
                        else
                        {
                            <span>@(editor.ID == 0 ? "✓ " + I18n.T("Save OT Note", "ওটি নোট সংরক্ষণ করুন") : "✓ " + I18n.T("Update OT Note", "নোট আপডেট করুন"))</span>
                        }
                    </button>
                </div>
            </div>
        </div>

        <!-- Right: OT Notes Register -->
        <div class="ot-card">
            <div class="ot-card-header">
                <h2>
                    <span>📋 @I18n.T("OT Notes Archive", "ওটি নোট রেজিস্ট্রি")</span>
                </h2>
                <span class="badge" style="background:#e0f2fe; color:#0369a1; font-weight:800; font-size:11px;">
                    @(filteredNotes.Count) @I18n.T("Notes")
                </span>
            </div>

            <div style="padding:10px 12px; background:#f8fafc; border-bottom:1px solid #e2e8f0; display:flex; flex-direction:column; gap:8px;">
                <!-- Search input -->
                <div style="position:relative; width:100%;">
                    <input class="classic-input"
                           style="height:30px !important; padding-left:28px !important;"
                           @bind="listSearchQuery"
                           @bind:event="oninput"
                           placeholder="@I18n.T("Search by Patient, Reg #, Surgeon, Operation...")" />
                    <span style="position:absolute; left:9px; top:50%; transform:translateY(-50%); color:#94a3b8; pointer-events:none; font-size:12px;">🔍</span>
                    @if (!string.IsNullOrWhiteSpace(listSearchQuery))
                    {
                        <button type="button" style="position:absolute; right:8px; top:50%; transform:translateY(-50%); background:none; border:none; color:#94a3b8; cursor:pointer;" @onclick='() => listSearchQuery = ""'>✕</button>
                    }
                </div>

                <!-- Surgeon & Date presets -->
                <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:6px;">
                    <div style="display:flex; gap:4px;">
                        <button type="button" class="btn btn-sm @(dateFilterMode == "today" ? "btn-primary" : "btn-ghost")" style="font-size:10.5px; padding:2px 8px; height:24px;" @onclick='() => dateFilterMode = "today"'>
                            @I18n.T("Today")
                        </button>
                        <button type="button" class="btn btn-sm @(dateFilterMode == "week" ? "btn-primary" : "btn-ghost")" style="font-size:10.5px; padding:2px 8px; height:24px;" @onclick='() => dateFilterMode = "week"'>
                            @I18n.T("7 Days")
                        </button>
                        <button type="button" class="btn btn-sm @(dateFilterMode == "all" ? "btn-primary" : "btn-ghost")" style="font-size:10.5px; padding:2px 8px; height:24px;" @onclick='() => dateFilterMode = "all"'>
                            @I18n.T("All")
                        </button>
                    </div>

                    <select class="classic-input" style="height:24px !important; min-height:24px !important; font-size:10.5px !important; width:auto; padding:0 6px !important;" @bind="surgeonFilter">
                        <option value="0">@I18n.T("All Surgeons")</option>
                        @foreach (var doc in doctors)
                        {
                            <option value="@doc.ID">@DoctorDisplayName(doc)</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Notes List -->
            <div style="max-height: 640px; overflow-y: auto;">
                @if (!filteredNotes.Any())
                {
                    <div style="padding:32px 16px; text-align:center; color:#64748b; font-size:12px;">
                        @I18n.T("No OT clinical notes found.")
                    </div>
                }
                else
                {
                    @foreach (var item in filteredNotes)
                    {
                        var isSel = editor.ID == item.ID;
                        var pName = patientNames.GetValueOrDefault(item.PatientID, "—");
                        <div class="ot-item-row @(isSel ? "selected" : "")" @onclick="() => SelectNote(item)">
                            <div style="display:flex; justify-content:space-between; align-items:center;">
                                <span style="font-size:12px; font-weight:800; color:#0f172a;">
                                    #OTN-@item.ID.ToString("D5") &bull; @item.OperationName
                                </span>
                                <span style="font-size:10px; color:#0284c7; font-weight:700; background:#e0f2fe; padding:1px 6px; border-radius:4px;">
                                    @(item.AnaesthesiaType ?? "GA")
                                </span>
                            </div>

                            <div style="font-size:11px; color:#334155; margin-top:3px; display:flex; justify-content:space-between;">
                                <span>👤 @pName (Reg: @item.RegNo)</span>
                                <span>👨‍⚕️ @DoctorName(item.SurgeonID)</span>
                            </div>

                            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:4px;">
                                <div style="font-size:10.5px; color:#64748b;">
                                    📅 @item.OperationDate.ToString("dd MMM yyyy, hh:mm tt")
                                </div>
                                <div style="display:flex; gap:4px;" @onclick:stopPropagation="true">
                                    <button type="button" class="btn btn-ghost btn-sm" style="font-size:10px; padding:1px 6px;" @onclick="() => SelectNote(item)" title="@I18n.T("Edit Note")">
                                        ✏️ @I18n.T("Edit")
                                    </button>
                                    <button type="button" class="btn btn-ghost btn-sm" style="font-size:10px; padding:1px 6px;" @onclick="() => PrintSpecificNoteAsync(item)" title="@I18n.T("Print A4 Note")">
                                        🖨️
                                    </button>
                                    <a href="/ot-cash-memos?patientId=@item.PatientID" class="btn btn-ghost btn-sm" style="font-size:10px; padding:1px 6px; text-decoration:none; color:#0284c7;" title="@I18n.T("Create OT Cash Memo")">
                                        💳
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Printable A4 Standard Surgeon's OT Clinical Note -->
<div id="ot-note-print" style="display:none;">
    @if (editor.ID > 0)
    {
        <div style="padding:24px 28px; font-family:sans-serif; max-width:850px; margin:0 auto; color:#0f172a; line-height:1.4;">
            <PrintDocumentHeader Title="SURGEON'S OPERATION THEATRE (OT) CLINICAL NOTE"
                                 DocNo="@($"OTN-{editor.ID:D5}")"
                                 DocNoLabel="OT Note No"
                                 BarcodeCode="@($"OTN-{editor.ID:D5}")"
                                 Subtitle="Department of Surgery & Anaesthesia" />

            <!-- Patient Demographics Strip -->
            <div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:8px 12px; background:#f8fafc; border:1px solid #cbd5e1; border-radius:6px; padding:9px 12px; margin-top:10px; font-size:11px;">
                <div><span style="color:#64748b; font-weight:700;">Patient Name:</span> <strong style="font-size:12px;">@selectedPatientName</strong></div>
                <div><span style="color:#64748b; font-weight:700;">Patient ID:</span> <strong>#@editor.PatientID</strong></div>
                <div><span style="color:#64748b; font-weight:700;">Admission Reg #:</span> <strong>@editor.RegNo</strong></div>
                <div><span style="color:#64748b; font-weight:700;">Age / Gender:</span> <strong>@(selectedAdmission?.Age ?? "—") / @(!string.IsNullOrWhiteSpace(selectedPatientSex) ? selectedPatientSex : "—")</strong></div>
                <div><span style="color:#64748b; font-weight:700;">Bed / Cabin:</span> <strong>🛏️ @BedName(selectedAdmission?.BedCabinID)</strong></div>
                <div><span style="color:#64748b; font-weight:700;">Department / Ward:</span> <strong>@DepartmentName(selectedAdmission?.Department)</strong></div>
                <div><span style="color:#64748b; font-weight:700;">Operation Date:</span> <strong>@editor.OperationDate.ToString("dd MMM yyyy, hh:mm tt")</strong></div>
                <div><span style="color:#64748b; font-weight:700;">Anaesthesia Type:</span> <strong>@(editor.AnaesthesiaType ?? "GA")</strong></div>
            </div>

            <!-- Surgical Team & Diagnostic Table -->
            <table style="width:100%; border-collapse:collapse; margin-top:12px; font-size:11.5px; border:1px solid #cbd5e1;">
                <tr style="background:#f8fafc; border-bottom:1px solid #cbd5e1;">
                    <td style="padding:6px 10px; font-weight:700; width:22%;">Operation Performed:</td>
                    <td style="padding:6px 10px; font-weight:800; font-size:13px; color:#0284c7;" colspan="3">@editor.OperationName</td>
                </tr>
                <tr style="border-bottom:1px solid #cbd5e1;">
                    <td style="padding:6px 10px; font-weight:700;">Lead Operating Surgeon:</td>
                    <td style="padding:6px 10px; font-weight:750;">@DoctorName(editor.SurgeonID)</td>
                    <td style="padding:6px 10px; font-weight:700; width:20%;">Anaesthesiologist:</td>
                    <td style="padding:6px 10px;">@DoctorName(editor.AnaesthetistID)</td>
                </tr>
                <tr style="border-bottom:1px solid #cbd5e1;">
                    <td style="padding:6px 10px; font-weight:700;">Assistant Surgeons:</td>
                    <td style="padding:6px 10px;" colspan="3">
                        @{
                            var assts = new[] { DoctorName(editor.Assistant1ID), DoctorName(editor.Assistant2ID), DoctorName(editor.Assistant3ID) }.Where(x => x != "—").ToList();
                        }
                        @(assts.Count > 0 ? string.Join(", ", assts) : "None")
                    </td>
                </tr>
                <tr style="border-bottom:1px solid #cbd5e1;">
                    <td style="padding:6px 10px; font-weight:700;">Pre-Op Diagnosis:</td>
                    <td style="padding:6px 10px;">@(string.IsNullOrWhiteSpace(editor.PreOpDiagnosis) ? "—" : editor.PreOpDiagnosis)</td>
                    <td style="padding:6px 10px; font-weight:700;">Post-Op Diagnosis:</td>
                    <td style="padding:6px 10px; font-weight:750;">@(string.IsNullOrWhiteSpace(editor.PostOpDiagnosis) ? "—" : editor.PostOpDiagnosis)</td>
                </tr>
                <tr style="border-bottom:1px solid #cbd5e1;">
                    <td style="padding:6px 10px; font-weight:700;">Incision & Approach:</td>
                    <td style="padding:6px 10px;">@(string.IsNullOrWhiteSpace(editor.Incision) ? "—" : editor.Incision)</td>
                    <td style="padding:6px 10px; font-weight:700;">Blood Loss / Drains:</td>
                    <td style="padding:6px 10px;">Loss: @(editor.BloodLossEstimate ?? "Minimal") | Drains: @(editor.DrainsPacks ?? "None")</td>
                </tr>
                @if (!string.IsNullOrWhiteSpace(editor.SpecimenBiopsy))
                {
                    <tr style="border-bottom:1px solid #cbd5e1;">
                        <td style="padding:6px 10px; font-weight:700;">Biopsy Specimen:</td>
                        <td style="padding:6px 10px;" colspan="3">@editor.SpecimenBiopsy</td>
                    </tr>
                }
            </table>

            <!-- WHO Surgical Safety Checklist Standard Verification Seal -->
            <div style="margin-top:8px; background:#f0fdf4; border:1px solid #bbf7d0; border-radius:4px; padding:6px 10px; font-size:10.5px; color:#166534; display:flex; align-items:center; gap:8px;">
                <span>🛡️</span>
                <span><strong>WHO Surgical Safety Standards:</strong> Sponge/mop counts, needle counts, and surgical instrument counts verified correct prior to closure. Specimen accurately labeled.</span>
            </div>

            <!-- Operative Steps and Findings -->
            <div style="margin-top:14px;">
                <div style="font-weight:800; font-size:12px; color:#0f172a; text-transform:uppercase; border-bottom:1.5px solid #0f172a; padding-bottom:3px; margin-bottom:6px;">
                    Operative Findings & Surgical Procedure Steps:
                </div>
                <div style="font-size:11.5px; font-family:monospace; line-height:1.6; white-space:pre-wrap; background:#fdfdfd; padding:10px; border:1px solid #e2e8f0; border-radius:4px;">
                    @(string.IsNullOrWhiteSpace(editor.ProcedureAndFindings) ? "Operative findings documented as uneventful." : editor.ProcedureAndFindings)
                </div>
            </div>

            <!-- Post-Op Orders -->
            @if (!string.IsNullOrWhiteSpace(editor.PostOpOrders))
            {
                <div style="margin-top:12px;">
                    <div style="font-weight:800; font-size:12px; color:#0f172a; text-transform:uppercase; border-bottom:1.5px solid #0f172a; padding-bottom:3px; margin-bottom:6px;">
                        Immediate Post-Operative Orders:
                    </div>
                    <div style="font-size:11px; line-height:1.5; white-space:pre-wrap; padding:8px 10px; border:1px solid #e2e8f0; border-radius:4px; background:#f8fafc;">
                        @editor.PostOpOrders
                    </div>
                </div>
            }

            <!-- Official Signatures -->
            <div style="margin-top:45px; display:flex; justify-content:space-between; font-size:11px; text-align:center;">
                <div style="border-top:1px solid #000; width:170px; padding-top:4px;">
                    OT In-Charge Nurse
                </div>
                <div style="border-top:1px solid #000; width:170px; padding-top:4px;">
                    Anaesthesiologist Signature
                </div>
                <div style="border-top:1px solid #000; width:210px; padding-top:4px;">
                    <strong>@DoctorName(editor.SurgeonID)</strong><br />
                    Lead Operating Surgeon
                </div>
            </div>

            <div style="margin-top:20px; font-size:9.5px; color:#94a3b8; text-align:center; border-top:1px dashed #e2e8f0; padding-top:4px;">
                Printed from @Branding.HospitalName EMR &bull; Document ID: OTN-@editor.ID.ToString("D5") &bull; @DateTime.Now.ToString("dd-MMM-yyyy hh:mm tt")
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery] public long? opId { get; set; }
    [SupplyParameterFromQuery] public string? regNo { get; set; }

    private OperationNote editor = new() { OperationDate = DateTime.Now };
    private List<OperationNote> otNotes = [];
    private List<DoctorsProfile> doctors = [];
    private List<PatientOperation> activeScheduledOperations = [];
    private Dictionary<string, string> patientNames = [];
    private Dictionary<int, string> bedNames = [];
    private Dictionary<int, string> departmentNames = [];

    private int? selectedSurgeonId => editor.SurgeonID > 0 ? editor.SurgeonID : null;
    private void OnSurgeonChanged(int? id) => editor.SurgeonID = id ?? 0;

    private PatientAdmission? selectedAdmission;
    private string selectedPatientName = string.Empty;
    private string selectedPatientSex = string.Empty;
    private string patientSearchQuery = string.Empty;
    private bool showPatientDropdown = false;
    private List<PatientAdmission> suggestedAdmissions = [];
    private bool hasMorePatientSuggestions = false;
    private bool isLoadingMorePatients = false;
    private const int PatientBatchSize = 20;
    private int totalActiveInpatients = 0;

    // WHO Surgical Safety Checklist state
    private bool spongeCountVerified = true;
    private bool needleCountVerified = true;
    private bool instrumentsCountVerified = true;

    private DotNetObjectReference<OperationTheatreNotes>? dotNetRef;

    private string listSearchQuery = string.Empty;
    private string dateFilterMode = "all";
    private int surgeonFilter = 0;

    private bool isSaving = false;
    private string? message;
    private string messageClass = "info";

    private int todayNotesCount => otNotes.Count(x => x.OperationDate.Date == DateTime.Today.Date);

    private List<OperationNote> filteredNotes
    {
        get
        {
            var q = otNotes.AsEnumerable();

            if (dateFilterMode == "today")
                q = q.Where(x => x.OperationDate.Date == DateTime.Today.Date);
            else if (dateFilterMode == "week")
                q = q.Where(x => x.OperationDate.Date >= DateTime.Today.AddDays(-7).Date);

            if (surgeonFilter > 0)
                q = q.Where(x => x.SurgeonID == surgeonFilter);

            if (!string.IsNullOrWhiteSpace(listSearchQuery))
            {
                var query = listSearchQuery.Trim().ToLowerInvariant();
                q = q.Where(x => (x.OperationName?.ToLowerInvariant().Contains(query) ?? false) ||
                                 (x.RegNo?.ToLowerInvariant().Contains(query) ?? false) ||
                                 (x.PatientID?.ToLowerInvariant().Contains(query) ?? false) ||
                                 (patientNames.GetValueOrDefault(x.PatientID ?? "", "").ToLowerInvariant().Contains(query)) ||
                                 (DoctorName(x.SurgeonID).ToLowerInvariant().Contains(query)));
            }

            return q.OrderByDescending(x => x.OperationDate).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();

        if (opId.HasValue && opId.Value > 0)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var op = await db.PatientOperations.FindAsync(opId.Value);
            if (op != null)
            {
                ApplyScheduledOperation(op, db);
            }
        }
        else if (!string.IsNullOrWhiteSpace(regNo))
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var adm = await db.PatientAdmissions.AsNoTracking().FirstOrDefaultAsync(x => x.RegNo == regNo);
            if (adm != null)
            {
                await CacheSuggestionPatientsAsync(db, new[] { adm });
                await SelectAdmission(adm);
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        dotNetRef ??= DotNetObjectReference.Create(this);
        if (!showPatientDropdown) return;

        try
        {
            await JS.InvokeVoidAsync("hpm.initPatientIdScroll", "ot-notes-patient-suggestions-list", dotNetRef, nameof(LoadMorePatientsFromJs));
        }
        catch { }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            doctors = await db.Doctors.AsNoTracking().Where(x => x.IsActive).OrderBy(x => x.Name).ToListAsync();
            totalActiveInpatients = await db.PatientAdmissions.AsNoTracking().CountAsync(x => x.IsAdmitted == true);

            var beds = await db.BedCabins.AsNoTracking().ToListAsync();
            bedNames = beds.ToDictionary(x => x.ID, x => x.Name);

            var depts = await db.Departments.AsNoTracking().ToListAsync();
            departmentNames = depts.ToDictionary(x => x.ID, x => x.Name);

            otNotes = await db.OperationNotes.AsNoTracking().OrderByDescending(x => x.OperationDate).ToListAsync();

            // Load recent scheduled operations for quick auto-fill handoff
            activeScheduledOperations = await db.PatientOperations.AsNoTracking()
                .Where(x => x.OperationDate.Date >= DateTime.Today.AddDays(-3).Date)
                .OrderByDescending(x => x.OperationDate)
                .Take(25)
                .ToListAsync();

            var pIds = otNotes.Select(x => x.PatientID)
                .Concat(activeScheduledOperations.Select(x => x.PatientID))
                .Where(x => !string.IsNullOrEmpty(x))
                .Distinct()
                .ToList();

            if (pIds.Count > 0)
            {
                var regs = await db.Registrations.AsNoTracking()
                    .Where(x => pIds.Contains(x.PatientID))
                    .ToDictionaryAsync(x => x.PatientID, x => x.Name);
                foreach (var kvp in regs)
                {
                    patientNames[kvp.Key] = kvp.Value;
                }
            }
        }
        catch (Exception ex)
        {
            message = $"Error loading data: {ex.Message}";
            messageClass = "danger";
        }
    }

    private void OnScheduledOpSelected(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var opIdVal) && opIdVal > 0)
        {
            var op = activeScheduledOperations.FirstOrDefault(x => x.ID == opIdVal);
            if (op != null)
            {
                _ = Task.Run(async () =>
                {
                    await using var db = await DbFactory.CreateDbContextAsync();
                    ApplyScheduledOperation(op, db);
                    await InvokeAsync(StateHasChanged);
                });
            }
        }
    }

    private void ApplyScheduledOperation(PatientOperation op, HpmDbContext db)
    {
        editor.OperationID = op.ID;
        editor.RegNo = op.RegNo;
        editor.PatientID = op.PatientID;
        editor.OperationName = op.ProcedureName;
        editor.OperationDate = op.OperationDate;
        editor.SurgeonID = op.OperatorID;
        editor.AnaesthetistID = op.AnasthetistID;
        editor.AnaesthesiaType = op.AnaesthesiaType ?? "General Anaesthesia (GA)";
        if (!string.IsNullOrWhiteSpace(op.Remarks) && string.IsNullOrWhiteSpace(editor.PreOpDiagnosis))
        {
            editor.PreOpDiagnosis = op.Remarks;
        }

        // Assistant Doctors
        if (!string.IsNullOrWhiteSpace(op.AssistantDoctorIDs))
        {
            var asstIds = op.AssistantDoctorIDs.Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(s => int.TryParse(s.Trim(), out var id) ? id : 0)
                .Where(id => id > 0)
                .ToList();
            if (asstIds.Count > 0) editor.Assistant1ID = asstIds[0];
            if (asstIds.Count > 1) editor.Assistant2ID = asstIds[1];
            if (asstIds.Count > 2) editor.Assistant3ID = asstIds[2];
        }

        selectedAdmission = db.PatientAdmissions.AsNoTracking().FirstOrDefault(x => x.RegNo == op.RegNo);
        if (selectedAdmission != null && !string.IsNullOrWhiteSpace(op.PatientID))
        {
            var p = db.Registrations.AsNoTracking().FirstOrDefault(x => x.PatientID == op.PatientID);
            if (p != null)
            {
                selectedPatientName = p.Name;
                selectedPatientSex = p.Sex;
                patientNames[p.PatientID] = p.Name;
            }
        }

        message = I18n.IsBangla ? "ওটি শিডিউল থেকে তথ্য সফলভাবে পূরণ করা হয়েছে।" : "Loaded details from OT schedule successfully.";
        messageClass = "success";
    }

    private static IQueryable<PatientAdmission> BuildPatientSuggestionQuery(HpmDbContext db, string term)
    {
        var query = db.PatientAdmissions.AsNoTracking().Where(x => x.IsAdmitted == true);
        if (!string.IsNullOrWhiteSpace(term))
        {
            query = query.Where(a => a.RegNo.Contains(term)
                || (a.PatientID != null && a.PatientID.Contains(term))
                || db.Registrations.Any(r => r.PatientID == a.PatientID
                    && (r.Name.Contains(term) || (r.Contact != null && r.Contact.Contains(term))))
                || db.BedCabins.Any(b => b.ID == a.BedCabinID && b.Name.Contains(term)));
        }
        return query.OrderByDescending(x => x.AdmissionDate).ThenByDescending(x => x.ID);
    }

    private async Task CacheSuggestionPatientsAsync(HpmDbContext db, IEnumerable<PatientAdmission> admissions)
    {
        var batch = admissions.ToList();
        var pIds = batch.Where(x => !string.IsNullOrWhiteSpace(x.PatientID) && !patientNames.ContainsKey(x.PatientID!))
                        .Select(x => x.PatientID!)
                        .Distinct()
                        .ToArray();
        if (pIds.Length > 0)
        {
            var newNames = await db.Registrations.AsNoTracking()
                .Where(x => pIds.Contains(x.PatientID))
                .ToDictionaryAsync(x => x.PatientID, x => x.Name, StringComparer.OrdinalIgnoreCase);
            foreach (var kvp in newNames)
            {
                patientNames[kvp.Key] = kvp.Value;
            }
        }
    }

    private async Task LoadPatientSuggestionsAsync(bool reset)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var query = BuildPatientSuggestionQuery(db, patientSearchQuery.Trim());
        var skip = reset ? 0 : suggestedAdmissions.Count;
        var batch = await query.Skip(skip).Take(PatientBatchSize).ToListAsync();
        await CacheSuggestionPatientsAsync(db, batch);

        if (reset)
        {
            suggestedAdmissions = batch;
            try { await JS.InvokeVoidAsync("hpm.resetPatientIdScrollTop", "ot-notes-patient-suggestions-list"); } catch { }
        }
        else
        {
            suggestedAdmissions.AddRange(batch);
        }

        hasMorePatientSuggestions = batch.Count == PatientBatchSize;
        showPatientDropdown = true;
    }

    private async Task HandlePatientSearchInputAsync(ChangeEventArgs e)
    {
        patientSearchQuery = e.Value?.ToString() ?? "";
        await LoadPatientSuggestionsAsync(reset: true);
    }

    private async Task ShowPatientSuggestionsAsync()
    {
        await LoadPatientSuggestionsAsync(reset: true);
    }

    [JSInvokable]
    public async Task LoadMorePatientsFromJs()
    {
        if (isLoadingMorePatients || !hasMorePatientSuggestions || !showPatientDropdown) return;
        isLoadingMorePatients = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            await LoadPatientSuggestionsAsync(reset: false);
        }
        catch
        {
            hasMorePatientSuggestions = false;
        }
        finally
        {
            isLoadingMorePatients = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SelectAdmission(PatientAdmission adm)
    {
        selectedAdmission = adm;
        selectedPatientName = patientNames.GetValueOrDefault(adm.PatientID ?? "", "—");
        editor.RegNo = adm.RegNo ?? "";
        editor.PatientID = adm.PatientID ?? "";
        if (adm.Consultant.HasValue && editor.SurgeonID == 0)
            editor.SurgeonID = adm.Consultant.Value;
        showPatientDropdown = false;
        patientSearchQuery = "";

        if (!string.IsNullOrWhiteSpace(adm.PatientID))
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var reg = await db.Registrations.AsNoTracking().FirstOrDefaultAsync(x => x.PatientID == adm.PatientID);
            selectedPatientSex = reg?.Sex ?? "—";
        }
        else
        {
            selectedPatientSex = "—";
        }
    }

    private void ClearSelectedPatient()
    {
        selectedAdmission = null;
        selectedPatientName = "";
        selectedPatientSex = "";
        editor.RegNo = "";
        editor.PatientID = "";
    }

