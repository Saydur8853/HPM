@page "/hospital-settings"
@page "/admin/hospital-settings"
@attribute [Authorize(Roles = RoleNames.Administrator)]
@implements IDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>@I18n.T("Hospital Settings") | @Branding.HospitalName</PageTitle>

<div class="page-heading">
    <div>
        <span class="eyebrow">@I18n.T("Settings")</span>
        <h1>@I18n.T("Hospital Profile & Branding")</h1>
        <p>@I18n.T("Hospital identity, contact details, official logo, and print document headers.")</p>
    </div>
    <div style="display:flex; align-items:center; gap:8px;">
        <button class="btn btn-secondary" type="button" @onclick="ReloadSettingsAsync">
            @I18n.T("Reset")
        </button>
        <button class="btn btn-primary" type="button" @onclick="SaveSettingsAsync" disabled="@isSaving">
            @(isSaving ? I18n.T("Saving...") : I18n.T("Save Changes"))
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert @(isError ? "alert-danger" : "alert-success")" style="margin-bottom: 20px;">
        <div style="display:flex; align-items:center; gap:8px;">
            <span>@(isError ? "⚠️" : "✅")</span>
            <strong>@statusMessage</strong>
        </div>
    </div>
}

<div class="hospital-settings-layout">
    <!-- Left Column: Settings Form -->
    <div class="settings-form-column">
        <EditForm Model="model" OnSubmit="SaveSettingsAsync">
            
            <!-- 1. General Hospital Info -->
            <div class="panel form-panel" style="margin-bottom: 20px; border-radius: 12px; overflow: hidden;">
                <div class="panel-heading" style="padding: 14px 20px;">
                    <div>
                        <h2 style="font-size: 15px; font-weight: 750;">@I18n.T("General Information")</h2>
                    </div>
                </div>

                <div class="form-grid" style="padding: 18px 20px 20px;">
                    <label class="span-2">
                        <span>@I18n.T("Hospital Name") *</span>
                        <InputText @bind-Value="model.HospitalName" placeholder="e.g. PrimeCare Specialized Hospital" />
                    </label>

                    <label class="span-2">
                        <span>@I18n.T("Tagline / Slogan")</span>
                        <InputText @bind-Value="model.Tagline" placeholder="e.g. Excellence in Clinical Care" />
                    </label>

                    <label>
                        <span>@I18n.T("Govt / DGHS Reg. No.")</span>
                        <InputText @bind-Value="model.LicenseNo" placeholder="e.g. DGHS-REG-2026-0812" />
                    </label>

                    <label>
                        <span>@I18n.T("City / District")</span>
                        <InputText @bind-Value="model.CityDistrict" placeholder="e.g. Dhaka, Bangladesh" />
                    </label>

                    <label class="span-2">
                        <span>@I18n.T("Address")</span>
                        <InputTextArea @bind-Value="model.Address" rows="2" placeholder="e.g. Plot 14, Road 7, Sector 3, Uttara, Dhaka" />
                    </label>
                </div>
            </div>

            <!-- 2. Contact Numbers & Digital Channels -->
            <div class="panel form-panel" style="margin-bottom: 20px; border-radius: 12px; overflow: hidden;">
                <div class="panel-heading" style="padding: 14px 20px;">
                    <div>
                        <h2 style="font-size: 15px; font-weight: 750;">@I18n.T("Contact & Helplines")</h2>
                    </div>
                </div>

                <div class="form-grid" style="padding: 18px 20px 20px;">
                    <label>
                        <span>@I18n.T("Phone / Reception")</span>
                        <InputText @bind-Value="model.Phone" placeholder="01700-000000" />
                    </label>

                    <label>
                        <span>@I18n.T("Emergency Hotline")</span>
                        <InputText @bind-Value="model.Hotline" placeholder="01700-000000" />
                    </label>

                    <label>
                        <span>@I18n.T("Ambulance Shortcode")</span>
                        <InputText @bind-Value="model.EmergencyContact" placeholder="10678" />
                    </label>

                    <label>
                        <span>@I18n.T("Email Address")</span>
                        <InputText @bind-Value="model.Email" placeholder="info@hospital.com" />
                    </label>

                    <label class="span-2">
                        <span>@I18n.T("Website")</span>
                        <InputText @bind-Value="model.Website" placeholder="https://hospital.com" />
                    </label>
                </div>
            </div>

            <!-- 3. Logo & Visual Branding -->
            <div class="panel form-panel" style="margin-bottom: 20px; border-radius: 12px; overflow: hidden;">
                <div class="panel-heading" style="padding: 14px 20px;">
                    <div>
                        <h2 style="font-size: 15px; font-weight: 750;">@I18n.T("Hospital Logo")</h2>
                    </div>
                </div>

                <div style="padding: 18px 20px 20px;">
                    <div class="logo-upload-container" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 14px; gap: 16px;">
                        <div class="logo-preview-box" style="width: 90px; height: 80px; border-radius: 8px;">
                            @if (!string.IsNullOrWhiteSpace(model.LogoData))
                            {
                                <img src="@model.LogoData" alt="Logo" class="settings-logo-img" />
                            }
                            else
                            {
                                <span style="font-size: 32px;">🏥</span>
                            }
                        </div>

                        <div class="logo-upload-controls">
                            <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                                <label class="btn btn-secondary file-upload-btn" style="width: auto; margin: 0; padding: 7px 14px; font-size: 12px; display: inline-flex; align-items: center; gap: 6px; cursor: pointer;">
                                    📁 @I18n.T("Upload Logo Image")
                                    <InputFile OnChange="HandleLogoFileUpload" accept=".png,.jpg,.jpeg,.svg,.webp" style="display:none;" />
                                </label>

                                @if (!string.IsNullOrWhiteSpace(model.LogoData))
                                {
                                    <button type="button" class="btn btn-ghost danger-text" style="width: auto; margin: 0; padding: 7px 12px; font-size: 12px;" @onclick="RemoveLogo">
                                        🗑️ @I18n.T("Remove")
                                    </button>
                                }
                            </div>
                            <small style="color: #64748b; font-size: 11px; display: block; margin-top: 6px;">
                                @I18n.T("PNG, JPG or SVG format (max 2MB)")
                            </small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 4. Clinical Document & Receipt Customization -->
            <div class="panel form-panel" style="margin-bottom: 20px; border-radius: 12px; overflow: hidden;">
                <div class="panel-heading" style="padding: 14px 20px;">
                    <div>
                        <h2 style="font-size: 15px; font-weight: 750;">@I18n.T("Print & Receipt Headers")</h2>
                    </div>
                </div>

                <div class="form-grid" style="padding: 18px 20px 20px;">
                    <label class="span-2">
                        <span>@I18n.T("Lab Department Title")</span>
                        <InputText @bind-Value="model.LabHeaderDept" placeholder="e.g. Department of Pathology & Laboratory Medicine" />
                    </label>

                    <label class="span-2">
                        <span>@I18n.T("Diagnostic Receipt Sample Room Notice / Header Note", "স্যাম্পল কালেকশন রুম / মেমো নোটিস")</span>
                        <InputText @bind-Value="model.ReceiptHeaderNote" placeholder="e.g. BLOOD COLL ROOM: 201 (BLOCK-B), GROUND FLOOR" />
                    </label>

                    <label class="span-2">
                        <span>@I18n.T("Diagnostic Receipt Report Delivery Note / Disclaimer", "রিপোর্ট ডেলিভারি কাউন্টার / মেমো ফুটার নির্দেশিকা")</span>
                        <InputTextArea @bind-Value="model.ReceiptFooterNote" rows="2" placeholder="e.g. REPORT DELIVERY: Central Diagnostic Delivery Counter • Please preserve this receipt for collecting reports" />
                    </label>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="form-actions" style="display: flex; align-items: center; gap: 10px; margin-bottom: 30px;">
                <button class="btn btn-primary" type="submit" disabled="@isSaving">
                    @(isSaving ? I18n.T("Saving...") : I18n.T("Save Hospital Settings"))
                </button>
                <button class="btn btn-secondary" type="button" @onclick="ReloadSettingsAsync">
                    @I18n.T("Cancel")
                </button>
            </div>
        </EditForm>
    </div>

    <!-- Right Column: Live Document Header Preview Card -->
    <div class="settings-preview-column">
        <div class="panel preview-sticky-panel" style="border-radius: 12px; overflow: hidden;">
            <div class="panel-heading" style="padding: 14px 20px;">
                <div>
                    <h2 style="font-size: 15px; font-weight: 750;">@I18n.T("Live Preview")</h2>
                </div>
            </div>

            <div style="padding: 18px 20px 20px; display: flex; flex-direction: column; gap: 16px;">
                <!-- Preview 1: Diagnostic Report Sheet Header -->
                <div class="preview-card-box">
                    <div class="preview-card-label" style="font-size: 11px; font-weight: 700; color: #64748b; margin-bottom: 6px;">
                        @I18n.T("A4 Lab Report Header")
                    </div>
                    <div class="report-sheet-header" style="padding: 12px; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; margin: 0; align-items: center;">
                        <div class="report-sheet-brand" style="align-items: center; gap: 10px;">
                            <div class="report-brand-badge" style="width: 40px; height: 40px; padding: 2px; border-radius: 6px;">
                                @if (!string.IsNullOrWhiteSpace(model.LogoData))
                                {
                                    <img src="@model.LogoData" alt="Logo" style="max-height: 34px; max-width: 34px; object-fit: contain;" />
                                }
                                else
                                {
                                    <span style="font-size: 20px;">🏥</span>
                                }
                            </div>
                            <div style="min-width: 0; flex: 1;">
                                <h2 class="report-hospital-name" style="font-size: 14px; margin: 0 0 2px 0;">@(string.IsNullOrWhiteSpace(model.HospitalName) ? "Hospital Name" : model.HospitalName)</h2>
                                <p class="report-dept-name" style="font-size: 10px; margin: 0 0 2px 0; color: #64748b;">@(string.IsNullOrWhiteSpace(model.LabHeaderDept) ? "Department of Pathology" : model.LabHeaderDept)</p>
                                <div class="report-contact-line" style="font-size: 9px; gap: 8px; color: #475569;">
                                    <span>📍 @(string.IsNullOrWhiteSpace(model.Address) ? "Hospital Address" : model.Address)</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Preview 2: Thermal Slip / OPD Money Receipt Header -->
                <div class="preview-card-box">
                    <div class="preview-card-label" style="font-size: 11px; font-weight: 700; color: #64748b; margin-bottom: 6px;">
                        @I18n.T("Money Receipt Header")
                    </div>
                    <div style="background: #ffffff; border: 1px dashed #94a3b8; border-radius: 8px; padding: 12px; text-align: center;">
                        <div style="font-size: 13.5px; font-weight: 800; color: #0f172a;">
                            @(string.IsNullOrWhiteSpace(model.HospitalName) ? "Hospital Name" : model.HospitalName)
                        </div>
                        @if (!string.IsNullOrWhiteSpace(model.Tagline))
                        {
                            <div style="font-size: 10px; color: #64748b; margin-top: 2px;">@model.Tagline</div>
                        }
                        <div style="font-size: 9.5px; color: #475569; margin-top: 3px;">
                            📍 @(string.IsNullOrWhiteSpace(model.Address) ? "Hospital Address" : model.Address)
                        </div>
                        <div style="font-size: 9.5px; color: #475569;">
                            📞 @(string.IsNullOrWhiteSpace(model.Phone) ? "01700-000000" : model.Phone)
                        </div>
                        <div style="margin: 8px 0; border-top: 1px dashed #cbd5e1;"></div>
                        <div style="font-size: 9.5px; font-weight: 700; color: #0f766e;">*** OFFICIAL RECEIPT ***</div>
                    </div>
                </div>

                <!-- Metadata Info -->
                <div style="padding: 10px 12px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 11px; color: #64748b; display: flex; justify-content: space-between;">
                    <span><b>@I18n.T("Updated"):</b> @(model.UpdatedAt?.ToString("dd MMM yyyy") ?? "-")</span>
                    <span><b>@I18n.T("By"):</b> @(model.UpdatedBy ?? "Admin")</span>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private HospitalProfile model = new();
    private bool isSaving = false;
    private string? statusMessage;
    private bool isError = false;

    protected override async Task OnInitializedAsync()
    {
        await ReloadSettingsAsync();
    }

    private async Task ReloadSettingsAsync()
    {
        model = await Branding.GetProfileAsync();
        statusMessage = null;
    }

    private async Task HandleLogoFileUpload(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            if (file.Size > 2 * 1024 * 1024)
            {
                statusMessage = I18n.T("Logo image file size must not exceed 2MB.");
                isError = true;
                return;
            }

            var buffer = new byte[file.Size];
            await file.OpenReadStream(2 * 1024 * 1024).ReadExactlyAsync(buffer);
            var base64 = Convert.ToBase64String(buffer);
            var contentType = file.ContentType;
            if (string.IsNullOrWhiteSpace(contentType))
            {
                contentType = file.Name.EndsWith(".svg", StringComparison.OrdinalIgnoreCase) ? "image/svg+xml" : "image/png";
            }

            model.LogoData = $"data:{contentType};base64,{base64}";
            statusMessage = I18n.T("Logo loaded. Click 'Save Changes' to apply.");
            isError = false;
        }
        catch (Exception ex)
        {
            statusMessage = $"Error uploading logo: {ex.Message}";
            isError = true;
        }
    }

    private void RemoveLogo()
    {
        model.LogoData = string.Empty;
        statusMessage = I18n.T("Logo cleared. Click 'Save Changes' to apply.");
        isError = false;
    }

    private async Task SaveSettingsAsync()
    {
        if (isSaving) return;
        isSaving = true;
        statusMessage = null;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userName = authState.User.Identity?.Name ?? "Administrator";

            var result = await Branding.UpdateSettingsAsync(model, userName);
            if (result.Succeeded)
            {
                statusMessage = I18n.T("Hospital settings updated successfully!");
                isError = false;
                model = await Branding.GetProfileAsync();
            }
            else
            {
                statusMessage = result.Error;
                isError = true;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Failed to save hospital settings: {ex.GetBaseException().Message}";
            isError = true;
        }
        finally
        {
            isSaving = false;
        }
    }

    public void Dispose()
    {
    }
}
