</div>

@code {
    private string activeGroup = "pathology";
    private string searchQuery = string.Empty;
    private string message = string.Empty;
    private string messageClass = "success";
    private Service editor = new();
    private List<ServiceCategory> categories = [];
    private List<Service> services = [];
    private List<LabTestParameter> allParameters = [];
    private List<LabTestParameter> editorParams = [];
    private string newParamName = string.Empty;
    private string newParamUnit = string.Empty;
    private string newParamRange = string.Empty;
    private int newParamOrder = 1;
    private bool showReportPreview;
    private int previewServiceId;
    private HashSet<int> expandedParamServiceIds = [];
    private bool showCategoryModal;
    private ServiceCategory catEditor = new() { DiagnosticType = DiagnosticTestRouting.Pathology, SubID = 8 };
    private string catMessage = string.Empty;
    private string catMessageClass = "success";
    private string catSearch = string.Empty;
    private string catTypeFilter = "All";

    private IEnumerable<ServiceCategory> DiagnosticCategories => categories.Where(DiagnosticTestRouting.IsDiagnosticCategory);
    private IEnumerable<ServiceCategory> FilteredDiagnosticCategories
    {
        get
        {
            var result = DiagnosticCategories;
            if (catTypeFilter != "All")
                result = result.Where(c => DiagnosticTestRouting.ResolveCategoryType(c) == catTypeFilter);
            if (!string.IsNullOrWhiteSpace(catSearch))
            {
                var term = catSearch.Trim();
                result = result.Where(c => c.Name.Contains(term, StringComparison.OrdinalIgnoreCase));
            }
            return result.OrderBy(c => c.Name);
        }
    }
    private string CategoryTypeDisplay(string type) => type == DiagnosticTestRouting.Procedure ? I18n.T("Special Investigations") : type;
    private IEnumerable<ServiceCategory> ActiveCategories
    {
        get
        {
            var targetType = editor.DiagnosticType ?? GroupToType(activeGroup);
            var matched = DiagnosticCategories.Where(c => DiagnosticTestRouting.ResolveCategoryType(c) == targetType).OrderBy(c => c.Name).ToList();
            return matched.Count > 0 ? matched : DiagnosticCategories.OrderBy(c => c.Name);
        }
    }
    private List<Service> PathologyServices => services.Where(s => DiagnosticTestRouting.IsPathology(s, CategoryById(s.CategoryID))).ToList();
    private List<Service> ImagingServices => services.Where(s => DiagnosticTestRouting.IsImaging(s, CategoryById(s.CategoryID))).ToList();
    private List<Service> ProcedureServices => services.Where(s => DiagnosticTestRouting.IsProcedure(s, CategoryById(s.CategoryID))).ToList();
    private IEnumerable<Service> ActiveServices => activeGroup switch
    {
        "pathology" => PathologyServices,
        "procedure" => ProcedureServices,
        _ => ImagingServices
    };
    private IEnumerable<Service> FilteredServices
    {
        get
        {
            var result = ActiveServices;
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var term = searchQuery.Trim();
                result = result.Where(s => (s.Name?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || s.ID.ToString().Contains(term, StringComparison.OrdinalIgnoreCase)
                    || CategoryName(s.CategoryID).Contains(term, StringComparison.OrdinalIgnoreCase)
                    || allParameters.Any(p => p.ServiceID == s.ID && p.ParameterName.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }
            return result.OrderBy(s => s.Name);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        await LoadAsync();
        ResetEditor();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        categories = await db.ServiceCategories.AsNoTracking().OrderBy(c => c.Name).ToListAsync();
        var diagnosticIds = categories.Where(DiagnosticTestRouting.IsDiagnosticCategory).Select(c => c.ID).ToHashSet();
        services = await db.Services.AsNoTracking().Where(s => s.CategoryID != null && diagnosticIds.Contains(s.CategoryID.Value)).OrderBy(s => s.Name).ToListAsync();
        allParameters = await db.LabTestParameters.AsNoTracking().OrderBy(p => p.ServiceID).ThenBy(p => p.SortOrder).ToListAsync();
    }

    private void SwitchGroup(string group) { activeGroup = group; searchQuery = string.Empty; message = string.Empty; ResetEditor(); }

    private void SelectService(Service service)
    {
        editor = new Service
        {
            ID = service.ID, Name = service.Name, CategoryID = service.CategoryID, SaleRate = service.SaleRate,
            BuyRate = service.BuyRate, ReOrderLevel = service.ReOrderLevel, IsVATApp = service.IsVATApp,
            GenericID = service.GenericID, TypeID = service.TypeID, SupplierID = service.SupplierID,
            InvestigationModuleID = service.InvestigationModuleID,
            DiagnosticType = DiagnosticTestRouting.Resolve(service, CategoryById(service.CategoryID)),
            DeliveryHours = service.DeliveryHours,
            DiscountType = service.DiscountType, DiscountValue = service.DiscountValue,
            DiscountStart = service.DiscountStart, DiscountEnd = service.DiscountEnd
        };
        editorParams = allParameters
            .Where(p => p.ServiceID == service.ID)
            .OrderBy(p => p.SortOrder)
            .Select(p => new LabTestParameter
            {
                ID = p.ID,
                ServiceID = p.ServiceID,
                ParameterName = p.ParameterName,
                Unit = p.Unit,
                ReferenceRange = p.ReferenceRange,
                SortOrder = p.SortOrder
            })
            .ToList();
        newParamName = string.Empty;
        newParamUnit = string.Empty;
        newParamRange = string.Empty;
        newParamOrder = editorParams.Count > 0 ? editorParams.Max(p => p.SortOrder) + 1 : 1;
        message = string.Empty;
    }

    private static DateTime? ParseDateTimeLocal(string? raw) =>
        DateTime.TryParse(raw, out var dt) ? dt : null;

    private async Task SaveAsync()
    {
        editor.Name = editor.Name?.Trim();
        if (string.IsNullOrWhiteSpace(editor.Name) || editor.CategoryID is null || editor.SaleRate is null || editor.SaleRate < 0
            || editor.DiagnosticType is not (DiagnosticTestRouting.Pathology or DiagnosticTestRouting.Imaging or DiagnosticTestRouting.Procedure))
        {
            Fail(I18n.T("Test name, category and a valid rate are required.")); return;
        }
        var selectedCategory = CategoryById(editor.CategoryID);
        if (selectedCategory is null || !DiagnosticCategories.Any(c => c.ID == selectedCategory.ID))
        {
            Fail(I18n.T("Select a valid diagnostic category.")); return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.Services.AnyAsync(s => s.ID != editor.ID && s.CategoryID == editor.CategoryID && s.Name == editor.Name))
        {
            Fail(I18n.T("A test with this name already exists in the selected category.")); return;
        }

        if (string.IsNullOrWhiteSpace(editor.DiscountType))
        {
            editor.DiscountType = null; editor.DiscountValue = null; editor.DiscountStart = null; editor.DiscountEnd = null;
        }
        else if (editor.DiscountStart.HasValue && editor.DiscountEnd.HasValue && editor.DiscountEnd.Value < editor.DiscountStart.Value)
        {
            Fail(I18n.T("Discount end date must be after start date.")); return;
        }

        var isNew = editor.ID == 0;
        if (isNew)
        {
            editor.GenericID = null; editor.TypeID = null; editor.SupplierID = null;
            db.Services.Add(editor);
        }
        else
        {
            var entity = await db.Services.FindAsync(editor.ID);
            if (entity is null) { Fail(I18n.T("Test was not found.")); return; }
            entity.Name = editor.Name; entity.CategoryID = editor.CategoryID; entity.SaleRate = editor.SaleRate; entity.DiagnosticType = editor.DiagnosticType; entity.DeliveryHours = editor.DeliveryHours;
            entity.DiscountType = editor.DiscountType; entity.DiscountValue = editor.DiscountValue; entity.DiscountStart = editor.DiscountStart; entity.DiscountEnd = editor.DiscountEnd;
        }
        await db.SaveChangesAsync();

        // Sync Report Parameters for this investigation
        var existingParams = await db.LabTestParameters.Where(p => p.ServiceID == editor.ID).ToListAsync();
        var keepIds = editorParams.Where(p => p.ID > 0).Select(p => p.ID).ToHashSet();
        foreach (var rem in existingParams.Where(p => !keepIds.Contains(p.ID)))
        {
            db.LabTestParameters.Remove(rem);
        }
        foreach (var p in editorParams.Where(p => !string.IsNullOrWhiteSpace(p.ParameterName)))
        {
            p.ParameterName = p.ParameterName.Trim();
            p.Unit = string.IsNullOrWhiteSpace(p.Unit) ? null : p.Unit.Trim();
            p.ReferenceRange = string.IsNullOrWhiteSpace(p.ReferenceRange) ? null : p.ReferenceRange.Trim();
            p.ServiceID = editor.ID;
            if (p.ID == 0)
            {
                db.LabTestParameters.Add(p);
            }
            else
            {
                var target = existingParams.FirstOrDefault(x => x.ID == p.ID);
                if (target != null)
                {
                    target.ParameterName = p.ParameterName;
                    target.Unit = p.Unit;
                    target.ReferenceRange = p.ReferenceRange;
                    target.SortOrder = p.SortOrder;
                }
            }
        }
        await db.SaveChangesAsync();
        HospitalMasterCacheService.InvalidateGlobalCache();

        Success(I18n.T(isNew ? "Investigation & parameters added successfully." : "Investigation & parameters updated successfully."));
        await LoadAsync();
        ResetEditor(clearMessage: false);
    }

    private async Task DeleteAsync()
    {
        if (editor.ID <= 0 || !await JS.InvokeAsync<bool>("hpm.confirm", I18n.T($"Delete test '{editor.Name}'?"))) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var id = editor.ID;
        var used = await db.EmergencyMemoItems.AnyAsync(x => x.TestID == id)
            || await db.DiagnosticOrderItems.AnyAsync(x => x.ServiceID == id)
            || await db.DiagnosticCashMemoReturnItems.AnyAsync(x => x.ServiceID == id)
            || await db.LabSampleCollections.AnyAsync(x => x.ServiceID == id)
            || await db.LabTestResults.AnyAsync(x => x.ServiceID == id);
        if (used)
        {
            Fail(I18n.T("This test has billing or report records and cannot be deleted. You can rename or change its rate instead.")); return;
        }
        var orphanParams = await db.LabTestParameters.Where(x => x.ServiceID == id).ToListAsync();
        if (orphanParams.Count > 0) db.LabTestParameters.RemoveRange(orphanParams);
        var entity = await db.Services.FindAsync(id);
        if (entity is not null) { db.Services.Remove(entity); await db.SaveChangesAsync(); HospitalMasterCacheService.InvalidateGlobalCache(); }
        Success(I18n.T("Test deleted successfully."));
        await LoadAsync();
        ResetEditor(clearMessage: false);
    }

    private static string GroupToType(string group) => group switch
    {
        "pathology" => DiagnosticTestRouting.Pathology,
        "procedure" => DiagnosticTestRouting.Procedure,
        _ => DiagnosticTestRouting.Imaging
    };

    private void ResetEditor(bool clearMessage = true)
    {
        var t = GroupToType(activeGroup);
        editor = new Service { DiagnosticType = t, SaleRate = 0, DeliveryHours = null };
        editor.CategoryID = ActiveCategories.FirstOrDefault()?.ID;
        editorParams = [];
        newParamName = string.Empty;
        newParamUnit = string.Empty;
        newParamRange = string.Empty;
        newParamOrder = 1;
        if (clearMessage) message = string.Empty;
    }

    private void AddParamToEditor()
    {
        var name = newParamName?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(name)) return;
        editorParams.Add(new LabTestParameter
        {
            ServiceID = editor.ID,
            ParameterName = name,
            Unit = string.IsNullOrWhiteSpace(newParamUnit) ? null : newParamUnit.Trim(),
            ReferenceRange = string.IsNullOrWhiteSpace(newParamRange) ? null : newParamRange.Trim(),
            SortOrder = newParamOrder > 0 ? newParamOrder : editorParams.Count + 1
        });
        newParamName = string.Empty;
        newParamUnit = string.Empty;
        newParamRange = string.Empty;
        newParamOrder = editorParams.Count > 0 ? editorParams.Max(p => p.SortOrder) + 1 : 1;
    }

    private void RemoveParamFromEditor(LabTestParameter p) => editorParams.Remove(p);

    private void OpenReportPreview()
    {
        if (editor.ID > 0)
            previewServiceId = editor.ID;
        else if (!string.IsNullOrWhiteSpace(editor.Name))
            previewServiceId = 0;
        else
            previewServiceId = allParameters.Select(p => p.ServiceID).FirstOrDefault(id => services.Any(s => s.ID == id));

        if (previewServiceId == 0 && string.IsNullOrWhiteSpace(editor.Name) && services.Count > 0)
            previewServiceId = services[0].ID;

        showReportPreview = true;
    }

    private void CloseReportPreview() => showReportPreview = false;

    private void ToggleParamExpand(int serviceId)
    {
        if (!expandedParamServiceIds.Add(serviceId))
            expandedParamServiceIds.Remove(serviceId);
    }

    private void OpenReportPreviewFor(int serviceId)
    {
        previewServiceId = serviceId;
        showReportPreview = true;
    }

    private static string SampleResultForPreview(LabTestParameter p)
    {
        var range = p.ReferenceRange?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(range)) return "Normal";

        var match = System.Text.RegularExpressions.Regex.Match(range, @"(\d+(?:\.\d+)?)\s*[-–]\s*(\d+(?:\.\d+)?)");
        if (match.Success
            && double.TryParse(match.Groups[1].Value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var min)
            && double.TryParse(match.Groups[2].Value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var max))
        {
            var mid = (min + max) / 2.0;
            return mid % 1 == 0 ? mid.ToString("0", System.Globalization.CultureInfo.InvariantCulture) : mid.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
        }

        if (range.StartsWith("<", StringComparison.Ordinal))
        {
            var numMatch = System.Text.RegularExpressions.Regex.Match(range, @"\d+(?:\.\d+)?");
            if (numMatch.Success && double.TryParse(numMatch.Value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var upper))
            {
                var sample = Math.Max(0.1, upper * 0.65);
                return sample % 1 == 0 ? sample.ToString("0", System.Globalization.CultureInfo.InvariantCulture) : sample.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
            }
        }

        return "Normal";
    }

    private void OpenCategoryModal()
    {
        catMessage = string.Empty;
        ResetCategoryEditor();
        showCategoryModal = true;
    }

    private void CloseCategoryModal() => showCategoryModal = false;

    private void ResetCategoryEditor() => catEditor = new ServiceCategory { DiagnosticType = GroupToType(activeGroup), SubID = 8 };

    private void EditCategory(ServiceCategory c)
    {
        catMessage = string.Empty;
        catEditor = new ServiceCategory { ID = c.ID, Name = c.Name, SubID = 8, DiagnosticType = DiagnosticTestRouting.ResolveCategoryType(c) };
    }

    private async Task SaveCategoryAsync()
    {
        catEditor.Name = catEditor.Name?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(catEditor.Name))
        {
            catMessageClass = "danger";
            catMessage = I18n.T("Category name is required.");
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.ServiceCategories.AnyAsync(c => c.ID != catEditor.ID && c.Name == catEditor.Name))
        {
            catMessageClass = "danger";
            catMessage = I18n.T("A category with this name already exists.");
            return;
        }
        if (catEditor.ID == 0)
        {
            catEditor.ID = (await db.ServiceCategories.MaxAsync(x => (int?)x.ID) ?? 0) + 1;
            catEditor.SubID = 8;
            db.ServiceCategories.Add(catEditor);
        }
        else
        {
            var entity = await db.ServiceCategories.FindAsync(catEditor.ID);
            if (entity is null) return;
            entity.Name = catEditor.Name;
            entity.SubID = 8;
            entity.DiagnosticType = catEditor.DiagnosticType;
        }
        await db.SaveChangesAsync();
        HospitalMasterCacheService.InvalidateGlobalCache();
        catMessageClass = "success";
        catMessage = I18n.T("Category saved successfully.");
        ResetCategoryEditor();
        await LoadAsync();
    }

    private async Task DeleteCategoryAsync(ServiceCategory c)
    {
        if (!await JS.InvokeAsync<bool>("hpm.confirm", I18n.T($"Delete category '{c.Name}'?"))) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.Services.AnyAsync(x => x.CategoryID == c.ID))
        {
            catMessageClass = "danger";
            catMessage = I18n.T("This category has tests and cannot be deleted.");
            return;
        }
        var entity = await db.ServiceCategories.FindAsync(c.ID);
        if (entity is not null) { db.ServiceCategories.Remove(entity); await db.SaveChangesAsync(); HospitalMasterCacheService.InvalidateGlobalCache(); }
        catMessageClass = "success";
        catMessage = I18n.T("Category deleted.");
        ResetCategoryEditor();
        await LoadAsync();
    }

    private ServiceCategory? CategoryById(int? id) => id is null ? null : categories.FirstOrDefault(c => c.ID == id.Value);
    private string CategoryName(int? id) => CategoryById(id)?.Name ?? "—";
    private void Success(string text) { messageClass = "success"; message = text; }
    private void Fail(string text) { messageClass = "danger"; message = text; }
    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => I18n.OnLanguageChanged -= HandleLanguageChanged;
}
