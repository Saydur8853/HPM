@page "/diagnostic/investigations"
@attribute [Authorize(Roles = RoleNames.Administrator)]
@implements IDisposable
@using Microsoft.AspNetCore.Identity
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<AppUser> UserManager

<PageTitle>@I18n.T("Investigations Setup") | @Branding.HospitalName</PageTitle>

<div class="diagnostic-test-master-page">
    <div class="diagnostic-classic-topbar">
        <div class="tickets-top-left">
            <h1 class="tickets-page-title"><span>🧪</span><span>@I18n.T("Investigations Setup", "ইনভেস্টিগেশন সেটআপ")</span></h1>
            <span class="tickets-count-pill">@FilteredServices.Count() @I18n.T("Investigations")</span>
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <span class="tickets-inline-alert @messageClass" title="@message">@message</span>
            }
        </div>
        <div style="display:flex; flex-wrap:wrap; align-items:center; gap:8px;">
            <button type="button" class="btn btn-secondary btn-sm" @onclick="OpenCategoryModal">
                📂 @I18n.T("Manage Categories", "ক্যাটাগরি ম্যানেজ")
            </button>
            <BulkUploadWidget TypeKey="@activeGroup" OnImported="LoadAsync" />
        </div>
    </div>

    <div class="dtm-tabs" role="tablist" aria-label="@I18n.T("Diagnostic investigation types")">
        <button type="button" class="dtm-tab @(activeGroup == "pathology" ? "active pathology" : "")" @onclick='() => SwitchGroup("pathology")'>
            <span>🔬</span>
            <span><strong>@I18n.T("Pathology Investigations")</strong><small>@PathologyServices.Count @I18n.T("items")</small></span>
        </button>
        <button type="button" class="dtm-tab @(activeGroup == "imaging" ? "active imaging" : "")" @onclick='() => SwitchGroup("imaging")'>
            <span style="color:#1e3a8a; display:inline-flex; align-items:center;"><RadiologyIcon Size="20" /></span>
            <span><strong>@I18n.T("Imaging Investigations")</strong><small>@ImagingServices.Count @I18n.T("items")</small></span>
        </button>
        <button type="button" class="dtm-tab @(activeGroup == "procedure" ? "active imaging" : "")" @onclick='() => SwitchGroup("procedure")'>
            <span style="color:#0f172a; display:inline-flex; align-items:center;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M2 12h3.5l1.8-2.2 2 4.4 2.2-8.2 2.4 12 2.2-9 1.7 3H22" />
                </svg>
            </span>
            <span><strong>@I18n.T("Special Investigations", "স্পেশাল ইনভেস্টিগেশন")</strong><small>@ProcedureServices.Count @I18n.T("items")</small></span>
        </button>
    </div>

    <div class="dtm-workspace">
        <section class="dtm-form-card">
            <div class="dtm-card-header">
                <h2>@(editor.ID == 0 ? I18n.T("Add New Investigation") : I18n.T("Edit Investigation"))</h2>
                @if (editor.ID > 0) { <span class="diagnostic-badge">@DiagnosticTestRouting.FormatCode(editor, CategoryById(editor.CategoryID))</span> }
            </div>

            <div class="dtm-form-body">
                <label><span>@I18n.T("Investigation Name") *</span><InputText class="classic-input" @bind-Value="editor.Name" placeholder="@I18n.T("Enter investigation name")" /></label>
                <label>
                    <span style="display:flex; justify-content:space-between; align-items:center;">
                        <span>@I18n.T("Category") *</span>
                        <button type="button" class="btn-link" style="border:none; background:none; color:#0369a1; font-size:11.5px; font-weight:700; cursor:pointer; padding:0;" @onclick="OpenCategoryModal">+ @I18n.T("Manage", "ম্যানেজ")</button>
                    </span>
                    <InputSelect class="classic-input tickets-select" @bind-Value="editor.CategoryID">
                        <option value="">@I18n.T("Select category")</option>
                        @foreach (var category in ActiveCategories) { <option value="@category.ID">@category.Name</option> }
                    </InputSelect>
                </label>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                    <label><span>@I18n.T("Sale Rate") (@I18n.CurrencySymbol) *</span><InputNumber class="classic-input" @bind-Value="editor.SaleRate" min="0" /></label>
                    <label>
                        <span>@I18n.T("Delivery Hours (TAT)", "ডেলিভারি সময় (ঘণ্টা)")</span>
                        <InputNumber class="classic-input" @bind-Value="editor.DeliveryHours" min="1" max="720" placeholder="e.g. 6, 24, 48" />
                    </label>
                </div>

                <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:10px 12px; margin-bottom:10px; display:flex; flex-direction:column; gap:8px;">
                    <div style="font-size:12px; font-weight:800; color:#0f172a;">🏷️ @I18n.T("Investigation Discount & Validity", "ইনভেস্টিগেশন ডিসকাউন্ট ও সময়সীমা")</div>
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
                        <label style="margin:0;">
                            <span>@I18n.T("Discount Type", "ডিসকাউন্ট ধরন")</span>
                            <InputSelect class="classic-input tickets-select" @bind-Value="editor.DiscountType">
                                <option value="">@I18n.T("No Discount", "ডিসকাউন্ট নেই")</option>
                                <option value="Percent">@I18n.T("Percentage (%)", "শতাংশ (%)")</option>
                                <option value="Amount">@I18n.T("Fixed Amount", "নির্দিষ্ট টাকা")</option>
                            </InputSelect>
                        </label>
                        <label style="margin:0;">
                            <span>@(editor.DiscountType == "Percent" ? I18n.T("Discount (%)") : $"{I18n.T("Discount")} ({I18n.CurrencySymbol})")</span>
                            <InputNumber class="classic-input" @bind-Value="editor.DiscountValue" min="0" disabled="@string.IsNullOrWhiteSpace(editor.DiscountType)" />
                        </label>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(editor.DiscountType))
                    {
                        <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
                            <label style="margin:0;">
                                <span>@I18n.T("Start Date & Time", "শুরুর তারিখ ও সময়")</span>
                                <input type="datetime-local" class="classic-input"
                                       value="@(editor.DiscountStart?.ToString("yyyy-MM-ddTHH:mm") ?? "")"
                                       @onchange="e => editor.DiscountStart = ParseDateTimeLocal(e.Value?.ToString())" />
                            </label>
                            <label style="margin:0;">
                                <span>@I18n.T("End Date & Time", "শেষের তারিখ ও সময়")</span>
                                <input type="datetime-local" class="classic-input"
                                       value="@(editor.DiscountEnd?.ToString("yyyy-MM-ddTHH:mm") ?? "")"
                                       @onchange="e => editor.DiscountEnd = ParseDateTimeLocal(e.Value?.ToString())" />
                            </label>
                        </div>
                        @if (editor.DiscountEnd.HasValue && DateTime.Now > editor.DiscountEnd.Value)
                        {
                            <div style="color:#dc2626; font-size:12px; font-weight:800;">⚠️ @I18n.T("Discount period end", "ডিসকাউন্টের সময় শেষ হয়ে গেছে")</div>
                        }
                        else
                        {
                            var previewDisc = DiagnosticTestRouting.EvaluateDiscount(editor);
                            if (previewDisc.IsActive)
                            {
                                <div style="color:#059669; font-size:11.5px; font-weight:700;">✓ @I18n.T("Active during billing"): @I18n.FormatCurrency(previewDisc.OriginalRate) → <strong>@I18n.FormatCurrency(previewDisc.EffectiveRate)</strong></div>
                            }
                            else if (previewDisc.IsScheduled && editor.DiscountStart.HasValue)
                            {
                                <div style="color:#0369a1; font-size:11.5px; font-weight:700;">🕒 @I18n.T("Scheduled"): @editor.DiscountStart.Value.ToString("dd MMM yyyy hh:mm tt")</div>
                            }
                        }
                    }
                </div>

                <!-- Report Parameters Inline Setup -->
                <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:10px 12px; margin-bottom:10px; display:flex; flex-direction:column; gap:10px;">
                    <div style="font-size:12px; font-weight:800; color:#0f172a;">
                        📋 @I18n.T("Report Parameters", "রিপোর্ট প্যারামিটার")
                        <span class="pill" style="margin-left:6px; font-size:10.5px;">@editorParams.Count</span>
                    </div>

                    <!-- Spacious Add Parameter Form -->
                    <div style="background:#fff; border:1px solid #e2e8f0; border-radius:8px; padding:8px 10px; display:flex; flex-direction:column; gap:6px;">
                        <input class="classic-input" style="width:100%; min-width:0; height:30px; font-size:11.5px; font-weight:600;" @bind="newParamName" placeholder="@I18n.T("Parameter Name")" />
                        <div style="display:grid; grid-template-columns: minmax(0, 1fr) 62px; gap:6px;">
                            <input class="classic-input" style="width:100%; min-width:0; height:28px; font-size:11.5px;" @bind="newParamUnit" placeholder="@I18n.T("Unit (e.g. g/dL)")" />
                            <input type="number" class="classic-input" style="width:100%; min-width:0; height:28px; font-size:11.5px; text-align:center;" @bind="newParamOrder" title="@I18n.T("Display Order")" placeholder="#" />
                        </div>
                        <div style="display:grid; grid-template-columns: minmax(0, 1fr) auto; gap:6px; align-items:center;">
                            <input class="classic-input" style="width:100%; min-width:0; height:28px; font-size:11.5px;" @bind="newParamRange" placeholder="@I18n.T("Normal Range")" />
                            <button type="button" class="btn btn-secondary btn-sm" style="height:28px; padding:0 12px; font-size:11.5px; white-space:nowrap;" @onclick="AddParamToEditor">+ @I18n.T("Add")</button>
                        </div>
                    </div>

                    @if (editorParams.Count > 0)
                    {
                        <div style="max-height:240px; overflow-y:auto; border:1px solid #e2e8f0; border-radius:8px; background:#fff; display:flex; flex-direction:column;">
                            @foreach (var p in editorParams.OrderBy(x => x.SortOrder))
                            {
                                <div style="padding:8px 10px; border-bottom:1px solid #e2e8f0; display:flex; flex-direction:column; gap:5px;">
                                    <div style="display:grid; grid-template-columns: minmax(0, 1fr) 26px; gap:5px; align-items:center;">
                                        <input class="classic-input" style="width:100%; min-width:0; height:28px; font-size:11.5px; font-weight:700; padding:2px 8px;" @bind="p.ParameterName" placeholder="@I18n.T("Parameter Name")" />
                                        <button type="button" class="btn btn-ghost" style="padding:2px 4px; color:#dc2626; font-size:12px;" @onclick="() => RemoveParamFromEditor(p)" title="@I18n.T("Remove")">✕</button>
                                    </div>
                                    <div style="display:grid; grid-template-columns: minmax(0, 1fr) 56px; gap:5px; align-items:center;">
                                        <input class="classic-input" style="width:100%; min-width:0; height:26px; font-size:11px; padding:2px 8px;" @bind="p.Unit" placeholder="@I18n.T("Unit")" />
                                        <input type="number" class="classic-input" style="width:100%; min-width:0; height:26px; font-size:11px; padding:2px 4px; text-align:center;" @bind="p.SortOrder" title="@I18n.T("Order")" />
                                    </div>
                                    <input class="classic-input" style="width:100%; min-width:0; height:26px; font-size:11px; padding:2px 8px; color:#475569;" @bind="p.ReferenceRange" placeholder="@I18n.T("Normal Range")" />
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="dtm-form-actions">
                    <button type="button" class="btn btn-primary" @onclick="SaveAsync">✓ @(editor.ID == 0 ? I18n.T("Save Investigation") : I18n.T("Update Investigation"))</button>
                    @if (editor.ID > 0) { <button type="button" class="btn btn-danger" @onclick="DeleteAsync">🗑 @I18n.T("Delete")</button> }
                    <button type="button" class="btn btn-ghost" @onclick="() => ResetEditor()">@I18n.T("Clear")</button>
                </div>
            </div>
        </section>

        <section class="dtm-list-card">
            <div class="dtm-card-header dtm-list-header">
                <h2>@(activeGroup == "pathology" ? I18n.T("Pathology Investigation List") : activeGroup == "procedure" ? I18n.T("Special Investigations List", "স্পেশাল ইনভেস্টিগেশন তালিকা") : I18n.T("Imaging Investigation List"))</h2>
                <div class="dtm-search-wrap"><span>⌕</span><input class="classic-input" type="search" @bind="searchQuery" @bind:event="oninput" placeholder="@I18n.T("Search name, ID, category or parameter...")" /></div>
            </div>

            @if (selectedServiceIds.Count > 0)
            {
                <div style="display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:8px; padding:8px 14px; background:#fef2f2; border-bottom:1px solid #fecaca;">
                    <span style="font-size:12px; font-weight:700; color:#991b1b;">
                        ☑ @selectedServiceIds.Count @I18n.T("investigation(s) selected", "টি ইনভেস্টিগেশন সিলেক্ট করা হয়েছে")
                    </span>
                    <div style="display:flex; align-items:center; gap:8px;">
                        <button type="button" class="btn btn-ghost btn-sm" @onclick="ClearSelection">@I18n.T("Clear Selection")</button>
                        <button type="button" class="btn btn-danger btn-sm" @onclick="OpenBulkDeleteModal">
                            🗑️ @I18n.T("Delete Selected") (@selectedServiceIds.Count)
                        </button>
                    </div>
                </div>
            }

            <div class="dtm-table-wrap">
                <table class="classic-table dtm-table">
                    <thead>
                        <tr>
                            <th style="width:36px; text-align:center; padding-left:10px; padding-right:4px;">
                                <input type="checkbox" style="width:15px !important; height:15px !important; min-height:0 !important; margin:0; padding:0; cursor:pointer; accent-color:#0284c7; vertical-align:middle;" checked="@AllFilteredSelected" @onchange="ToggleSelectAllFiltered" title="@I18n.T("Select all visible")" />
                            </th>
                            <th style="width:92px;">@I18n.T("Code")</th>
                            <th>@I18n.T("Investigation Name")</th>
                            <th>@I18n.T("Category")</th>
                            <th class="num">@I18n.T("Rate")</th>
                            <th style="width:75px; text-align:center;">@I18n.T("Delivery")</th>
                            <th style="width:72px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!FilteredServices.Any()) { <tr><td colspan="7" class="dtm-empty">@I18n.T("No investigations found in this list.")</td></tr> }
                        @foreach (var service in FilteredServices)
                        {
                            var disc = DiagnosticTestRouting.EvaluateDiscount(service);
                            var svcParams = allParameters.Where(p => p.ServiceID == service.ID).OrderBy(p => p.SortOrder).ToList();
                            var isExpanded = expandedParamServiceIds.Contains(service.ID);
                            var isChecked = selectedServiceIds.Contains(service.ID);
                            <tr class="@(editor.ID == service.ID ? "selected" : "")">
                                <td style="width:36px; text-align:center; padding-left:10px; padding-right:4px;">
                                    <input type="checkbox" style="width:15px !important; height:15px !important; min-height:0 !important; margin:0; padding:0; cursor:pointer; accent-color:#0284c7; vertical-align:middle;" checked="@isChecked" @onchange="e => ToggleSelectService(service.ID, e.Value is bool b && b)" />
                                </td>
                                <td><span class="pill">@DiagnosticTestRouting.FormatCode(service, CategoryById(service.CategoryID))</span></td>
                                <td>
                                    <div style="display:flex; flex-wrap:wrap; align-items:center; gap:5px;">
                                        <strong>@service.Name</strong>
                                        @if (svcParams.Count > 0)
                                        {
                                            <button type="button"
                                                    class="pill"
                                                    style="border:none; cursor:pointer; background:@(isExpanded ? "#0369a1" : "#e0f2fe"); color:@(isExpanded ? "#fff" : "#0369a1"); font-size:10px; font-weight:700;"
                                                    @onclick="() => ToggleParamExpand(service.ID)"
                                                    title="@I18n.T("Show / hide parameters")">
                                                @(isExpanded ? "▴" : "▾") @svcParams.Count @I18n.T("params")
                                            </button>
                                        }
                                        @if (disc.IsActive)
                                        {
                                            <span class="pill" style="background:#dcfce7; color:#166534; font-size:10.5px;">
                                                -@(service.DiscountType == "Percent" ? $"{service.DiscountValue:0.##}%" : I18n.FormatCurrency(service.DiscountValue ?? 0))
                                            </span>
                                        }
                                        else if (disc.IsExpired)
                                        {
                                            <span class="pill" style="background:#fee2e2; color:#dc2626; font-size:10.5px;">@I18n.T("Discount period end")</span>
                                        }
                                    </div>
                                    @if (svcParams.Count > 0)
                                    {
                                        <div style="font-size:10.5px; color:#64748b; margin-top:2px; line-height:1.3;">
                                            @string.Join(" · ", svcParams.Take(4).Select(p => p.ParameterName))@(svcParams.Count > 4 ? $" +{svcParams.Count - 4} more" : "")
                                        </div>
                                    }
                                </td>
                                <td><span class="dtm-category-pill">@CategoryName(service.CategoryID)</span></td>
                                <td class="num">
                                    @if (disc.IsActive)
                                    {
                                        <del style="color:#94a3b8; font-size:11px; margin-right:4px;">@I18n.FormatCurrency(disc.OriginalRate)</del>
                                        <strong style="color:#059669;">@I18n.FormatCurrency(disc.EffectiveRate)</strong>
                                    }
                                    else
                                    {
                                        <strong>@I18n.FormatCurrency(service.SaleRate ?? 0)</strong>
                                    }
                                </td>
                                <td style="text-align:center;"><span class="pill" style="font-size: 11px;">@(service.DeliveryHours > 0 ? $"{service.DeliveryHours}h" : "Std")</span></td>
                                <td><button type="button" class="btn btn-ghost dtm-edit-btn" @onclick="() => SelectService(service)">✎ @I18n.T("Edit")</button></td>
                            </tr>
                            @if (isExpanded && svcParams.Count > 0)
                            {
                                <tr style="background:#f8fafc;">
                                    <td colspan="7" style="padding:8px 14px 12px 44px; border-bottom:1px solid #cbd5e1;">
                                        <div style="background:#fff; border:1px solid #e2e8f0; border-radius:8px; overflow:hidden;">
                                            <div style="display:flex; justify-content:space-between; align-items:center; padding:6px 10px; background:#f1f5f9; border-bottom:1px solid #e2e8f0; font-size:11px; font-weight:700; color:#334155;">
                                                <span>📋 @service.Name — @I18n.T("Configured Parameters") (@svcParams.Count)</span>
                                            </div>
                                            <table style="width:100%; border-collapse:collapse; font-size:11px;">
                                                <thead>
                                                    <tr style="border-bottom:1px solid #e2e8f0; color:#64748b;">
                                                        <th style="padding:5px 8px; width:36px; text-align:center;">#</th>
                                                        <th style="padding:5px 8px; text-align:left;">@I18n.T("Parameter Name")</th>
                                                        <th style="padding:5px 8px; width:90px; text-align:center;">@I18n.T("Unit")</th>
                                                        <th style="padding:5px 8px; text-align:left;">@I18n.T("Reference Normal Range")</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var p in svcParams)
                                                    {
                                                        <tr style="border-bottom:1px solid #f1f5f9;">
                                                            <td style="padding:5px 8px; text-align:center; color:#64748b;">@p.SortOrder</td>
                                                            <td style="padding:5px 8px; font-weight:600; color:#0f172a;">@p.ParameterName</td>
                                                            <td style="padding:5px 8px; text-align:center;"><span class="pill" style="font-size:10px;">@(string.IsNullOrWhiteSpace(p.Unit) ? "—" : p.Unit)</span></td>
                                                            <td style="padding:5px 8px; color:#475569;">@(string.IsNullOrWhiteSpace(p.ReferenceRange) ? "—" : p.ReferenceRange)</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    @if (showCategoryModal)
    {
        <div style="position:fixed; inset:0; background:rgba(15,23,42,0.55); display:flex; align-items:center; justify-content:center; padding:16px; z-index:1200;" @onclick="CloseCategoryModal">
            <div style="width:100%; max-width:680px; max-height:88vh; background:#fff; border-radius:14px; box-shadow:0 24px 48px rgba(15,23,42,0.22); display:flex; flex-direction:column; overflow:hidden;" @onclick:stopPropagation="true">
                <div style="display:flex; justify-content:space-between; align-items:center; padding:14px 18px; border-bottom:1px solid #e2e8f0; background:#f8fafc;">
                    <h3 style="margin:0; font-size:15px; font-weight:800;">📂 @I18n.T("Manage Diagnostic Categories", "ডায়াগনস্টিক ক্যাটাগরি ম্যানেজ")</h3>
                    <button type="button" style="border:none; background:transparent; font-size:16px; font-weight:700; cursor:pointer;" @onclick="CloseCategoryModal">✕</button>
                </div>
                <div style="padding:16px 18px; overflow-y:auto; display:flex; flex-direction:column; gap:14px;">
                    @if (!string.IsNullOrWhiteSpace(catMessage))
                    {
                        <div class="alert @(catMessageClass == "success" ? "alert-success" : "alert-danger")" style="padding:8px 12px; border-radius:8px; font-size:12.5px;">@catMessage</div>
                    }
                    <div style="display:grid; grid-template-columns:1.5fr 1fr auto; gap:10px; align-items:end; background:#f8fafc; padding:12px; border-radius:10px; border:1px solid #e2e8f0;">
                        <label style="margin:0;">
                            <span style="font-size:11.5px; font-weight:700; display:block; margin-bottom:4px;">@I18n.T("Category Name") *</span>
                            <input class="classic-input" @bind="catEditor.Name" placeholder="e.g. Biochemistry, X-Ray, ECG" />
                        </label>
                        <label style="margin:0;">
                            <span style="font-size:11.5px; font-weight:700; display:block; margin-bottom:4px;">@I18n.T("Diagnostic Type") *</span>
                            <select class="classic-input tickets-select" @bind="catEditor.DiagnosticType">
                                <option value="Pathology">@I18n.T("Pathology")</option>
                                <option value="Imaging">@I18n.T("Imaging")</option>
                                <option value="Procedure">@I18n.T("Special Investigations")</option>
                            </select>
                        </label>
                        <div style="display:flex; gap:6px;">
                            <button type="button" class="btn btn-primary btn-sm" @onclick="SaveCategoryAsync">@(catEditor.ID == 0 ? I18n.T("Add") : I18n.T("Update"))</button>
                            @if (catEditor.ID > 0)
                            {
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="ResetCategoryEditor">@I18n.T("New")</button>
                            }
                        </div>
                    </div>

                    <div style="display:flex; flex-wrap:wrap; gap:8px; align-items:center; justify-content:space-between;">
                        <input class="classic-input" type="search" style="flex:1; min-width:180px;" @bind="catSearch" @bind:event="oninput" placeholder="@I18n.T("Search category...")" />
                        <select class="classic-input tickets-select" style="width:190px;" @bind="catTypeFilter">
                            <option value="All">@I18n.T("All Types") (@DiagnosticCategories.Count())</option>
                            <option value="Pathology">@I18n.T("Pathology")</option>
                            <option value="Imaging">@I18n.T("Imaging")</option>
                            <option value="Procedure">@I18n.T("Special Investigations")</option>
                        </select>
                    </div>

                    <div style="max-height:320px; overflow-y:auto; border:1px solid #e2e8f0; border-radius:10px;">
                        <table class="classic-table dtm-table">
                            <thead><tr><th>@I18n.T("Category")</th><th>@I18n.T("Type")</th><th style="width:70px; text-align:center;">@I18n.T("Items")</th><th style="width:110px; text-align:right;">@I18n.T("Actions")</th></tr></thead>
                            <tbody>
                                @if (!FilteredDiagnosticCategories.Any())
                                {
                                    <tr><td colspan="4" class="dtm-empty">@I18n.T("No matching categories found.")</td></tr>
                                }
                                @foreach (var c in FilteredDiagnosticCategories)
                                {
                                    var resolvedType = DiagnosticTestRouting.ResolveCategoryType(c);
                                    var itemCount = services.Count(s => s.CategoryID == c.ID);
                                    <tr>
                                        <td><strong>@c.Name</strong></td>
                                        <td><span class="pill">@CategoryTypeDisplay(resolvedType)</span></td>
                                        <td style="text-align:center;"><span class="pill">@itemCount</span></td>
                                        <td style="text-align:right;">
                                            <button type="button" class="btn btn-ghost dtm-edit-btn" @onclick="() => EditCategory(c)">✎</button>
                                            <button type="button" class="btn btn-ghost dtm-edit-btn" style="color:#dc2626;" @onclick="() => DeleteCategoryAsync(c)">🗑</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (showBulkDeleteModal)
    {
        var selectedItems = services.Where(s => selectedServiceIds.Contains(s.ID)).OrderBy(s => s.Name).ToList();
        <div style="position:fixed; inset:0; background:rgba(15,23,42,0.6); display:flex; align-items:center; justify-content:center; padding:16px; z-index:1250;" @onclick="CloseBulkDeleteModal">
            <div style="width:100%; max-width:500px; background:#fff; border-radius:14px; box-shadow:0 24px 48px rgba(15,23,42,0.28); overflow:hidden; display:flex; flex-direction:column;" @onclick:stopPropagation="true">
                <div style="display:flex; justify-content:space-between; align-items:center; padding:14px 18px; background:#fef2f2; border-bottom:1px solid #fecaca;">
                    <h3 style="margin:0; font-size:15px; font-weight:800; color:#991b1b;">⚠️ @I18n.T("Confirm Bulk Delete", "একাধিক ইনভেস্টিগেশন ডিলিট নিশ্চিত করুন")</h3>
                    <button type="button" style="border:none; background:transparent; font-size:16px; font-weight:700; cursor:pointer; color:#991b1b;" @onclick="CloseBulkDeleteModal">✕</button>
                </div>

                <div style="padding:16px 18px; display:flex; flex-direction:column; gap:12px;">
                    <div style="background:#fff7ed; border:1px solid #fed7aa; border-radius:8px; padding:10px 12px; font-size:12px; color:#9a3412; line-height:1.45;">
                        <strong>@I18n.T("Warning:")</strong> @I18n.T($"You are about to permanently delete {selectedItems.Count} selected investigation(s) and their report parameters. This action cannot be undone and will be recorded in the audit log.")
                        <div style="margin-top:4px; font-size:11px; color:#c2410c;">
                            @I18n.T("Note: Any investigation that already has billing, order, sample, or result records will be skipped automatically.")
                        </div>
                    </div>

                    <div style="max-height:120px; overflow-y:auto; background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:8px 10px; font-size:11.5px;">
                        @foreach (var item in selectedItems.Take(8))
                        {
                            <div>• <strong>#@item.ID</strong> @item.Name</div>
                        }
                        @if (selectedItems.Count > 8)
                        {
                            <div style="color:#64748b; margin-top:2px;">...and @(selectedItems.Count - 8) more</div>
                        }
                    </div>

                    <div style="display:flex; align-items:center; justify-content:space-between; font-size:12px; background:#f1f5f9; padding:7px 10px; border-radius:8px;">
                        <span style="color:#475569;">@I18n.T("Performing User:")</span>
                        <strong style="color:#0f172a;">@currentPerformerName</strong>
                    </div>

                    <label style="margin:0;">
                        <span style="font-size:12px; font-weight:700; color:#334155; display:block; margin-bottom:4px;">@I18n.T("Enter Your Login Password to Confirm", "নিশ্চিত করতে আপনার লগইন পাসওয়ার্ড দিন") *</span>
                        <input type="password" class="classic-input" @bind="bulkDeletePassword" placeholder="@I18n.T("Enter your password")" autocomplete="current-password" />
                    </label>

                    @if (!string.IsNullOrWhiteSpace(bulkDeleteError))
                    {
                        <div class="alert alert-danger" style="padding:8px 10px; border-radius:8px; font-size:12px; margin:0;">⚠️ @bulkDeleteError</div>
                    }

                    <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:4px;">
                        <button type="button" class="btn btn-ghost" @onclick="CloseBulkDeleteModal" disabled="@bulkDeleteBusy">@I18n.T("Cancel")</button>
                        <button type="button" class="btn btn-danger" @onclick="ConfirmBulkDeleteAsync" disabled="@bulkDeleteBusy">
                            @(bulkDeleteBusy ? I18n.T("Deleting...") : $"🗑️ {I18n.T("Verify & Delete")} ({selectedItems.Count})")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string activeGroup = "pathology";
    private string searchQuery = string.Empty;
    private string message = string.Empty;
    private string messageClass = "success";
    private Service editor = new();
    private List<ServiceCategory> categories = [];
    private List<Service> services = [];
    private List<LabTestParameter> allParameters = [];
    private List<LabTestParameter> editorParams = [];
    private string newParamName = string.Empty;
    private string newParamUnit = string.Empty;
    private string newParamRange = string.Empty;
    private int newParamOrder = 1;
    private HashSet<int> expandedParamServiceIds = [];
    private HashSet<int> selectedServiceIds = [];
    private bool showBulkDeleteModal;
    private string bulkDeletePassword = string.Empty;
    private string bulkDeleteError = string.Empty;
    private bool bulkDeleteBusy;
    private string currentPerformerName = string.Empty;
    private bool showCategoryModal;
    private ServiceCategory catEditor = new() { DiagnosticType = DiagnosticTestRouting.Pathology, SubID = 8 };
    private string catMessage = string.Empty;
    private string catMessageClass = "success";
    private string catSearch = string.Empty;
    private string catTypeFilter = "All";

    private IEnumerable<ServiceCategory> DiagnosticCategories => categories.Where(DiagnosticTestRouting.IsDiagnosticCategory);
    private IEnumerable<ServiceCategory> FilteredDiagnosticCategories
    {
        get
        {
            var result = DiagnosticCategories;
            if (catTypeFilter != "All")
                result = result.Where(c => DiagnosticTestRouting.ResolveCategoryType(c) == catTypeFilter);
            if (!string.IsNullOrWhiteSpace(catSearch))
            {
                var term = catSearch.Trim();
                result = result.Where(c => c.Name.Contains(term, StringComparison.OrdinalIgnoreCase));
            }
            return result.OrderBy(c => c.Name);
        }
    }
    private string CategoryTypeDisplay(string type) => type == DiagnosticTestRouting.Procedure ? I18n.T("Special Investigations") : type;
    private IEnumerable<ServiceCategory> ActiveCategories
    {
        get
        {
            var targetType = editor.DiagnosticType ?? GroupToType(activeGroup);
            var matched = DiagnosticCategories.Where(c => DiagnosticTestRouting.ResolveCategoryType(c) == targetType).OrderBy(c => c.Name).ToList();
            return matched.Count > 0 ? matched : DiagnosticCategories.OrderBy(c => c.Name);
        }
    }
    private List<Service> PathologyServices => services.Where(s => DiagnosticTestRouting.IsPathology(s, CategoryById(s.CategoryID))).ToList();
    private List<Service> ImagingServices => services.Where(s => DiagnosticTestRouting.IsImaging(s, CategoryById(s.CategoryID))).ToList();
    private List<Service> ProcedureServices => services.Where(s => DiagnosticTestRouting.IsProcedure(s, CategoryById(s.CategoryID))).ToList();
    private IEnumerable<Service> ActiveServices => activeGroup switch
    {
        "pathology" => PathologyServices,
        "procedure" => ProcedureServices,
        _ => ImagingServices
    };
    private IEnumerable<Service> FilteredServices
    {
        get
        {
            var result = ActiveServices;
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var term = searchQuery.Trim();
                result = result.Where(s => (s.Name?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || s.ID.ToString().Contains(term, StringComparison.OrdinalIgnoreCase)
                    || DiagnosticTestRouting.FormatCode(s, CategoryById(s.CategoryID)).Contains(term, StringComparison.OrdinalIgnoreCase)
                    || CategoryName(s.CategoryID).Contains(term, StringComparison.OrdinalIgnoreCase)
                    || allParameters.Any(p => p.ServiceID == s.ID && p.ParameterName.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }
            return result.OrderBy(s => s.Name);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        await LoadAsync();
        ResetEditor();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        categories = await db.ServiceCategories.AsNoTracking().OrderBy(c => c.Name).ToListAsync();
        var diagnosticIds = categories.Where(DiagnosticTestRouting.IsDiagnosticCategory).Select(c => c.ID).ToHashSet();
        services = await db.Services.AsNoTracking().Where(s => s.CategoryID != null && diagnosticIds.Contains(s.CategoryID.Value)).OrderBy(s => s.Name).ToListAsync();
        allParameters = await db.LabTestParameters.AsNoTracking().OrderBy(p => p.ServiceID).ThenBy(p => p.SortOrder).ToListAsync();
    }

    private void SwitchGroup(string group) { activeGroup = group; searchQuery = string.Empty; message = string.Empty; ResetEditor(); }

    private void SelectService(Service service)
    {
        editor = new Service
        {
            ID = service.ID, Name = service.Name, CategoryID = service.CategoryID, SaleRate = service.SaleRate,
            BuyRate = service.BuyRate, ReOrderLevel = service.ReOrderLevel, IsVATApp = service.IsVATApp,
            GenericID = service.GenericID, TypeID = service.TypeID, SupplierID = service.SupplierID,
            InvestigationModuleID = service.InvestigationModuleID,
            DiagnosticType = DiagnosticTestRouting.Resolve(service, CategoryById(service.CategoryID)),
            DeliveryHours = service.DeliveryHours,
            DiscountType = service.DiscountType, DiscountValue = service.DiscountValue,
            DiscountStart = service.DiscountStart, DiscountEnd = service.DiscountEnd
        };
        editorParams = allParameters
            .Where(p => p.ServiceID == service.ID)
            .OrderBy(p => p.SortOrder)
            .Select(p => new LabTestParameter
            {
                ID = p.ID,
                ServiceID = p.ServiceID,
                ParameterName = p.ParameterName,
                Unit = p.Unit,
                ReferenceRange = p.ReferenceRange,
                SortOrder = p.SortOrder
            })
            .ToList();
        newParamName = string.Empty;
        newParamUnit = string.Empty;
        newParamRange = string.Empty;
        newParamOrder = editorParams.Count > 0 ? editorParams.Max(p => p.SortOrder) + 1 : 1;
        message = string.Empty;
    }

    private static DateTime? ParseDateTimeLocal(string? raw) =>
        DateTime.TryParse(raw, out var dt) ? dt : null;

    private async Task SaveAsync()
    {
        editor.Name = editor.Name?.Trim();
        if (string.IsNullOrWhiteSpace(editor.Name) || editor.CategoryID is null || editor.SaleRate is null || editor.SaleRate < 0
            || editor.DiagnosticType is not (DiagnosticTestRouting.Pathology or DiagnosticTestRouting.Imaging or DiagnosticTestRouting.Procedure))
        {
            Fail(I18n.T("Test name, category and a valid rate are required.")); return;
        }
        var selectedCategory = CategoryById(editor.CategoryID);
        if (selectedCategory is null || !DiagnosticCategories.Any(c => c.ID == selectedCategory.ID))
        {
            Fail(I18n.T("Select a valid diagnostic category.")); return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.Services.AnyAsync(s => s.ID != editor.ID && s.CategoryID == editor.CategoryID && s.Name == editor.Name))
        {
            Fail(I18n.T("A test with this name already exists in the selected category.")); return;
        }

        if (string.IsNullOrWhiteSpace(editor.DiscountType))
        {
            editor.DiscountType = null; editor.DiscountValue = null; editor.DiscountStart = null; editor.DiscountEnd = null;
        }
        else if (editor.DiscountStart.HasValue && editor.DiscountEnd.HasValue && editor.DiscountEnd.Value < editor.DiscountStart.Value)
        {
            Fail(I18n.T("Discount end date must be after start date.")); return;
        }

        var isNew = editor.ID == 0;
        if (isNew)
        {
            editor.GenericID = null; editor.TypeID = null; editor.SupplierID = null;
            db.Services.Add(editor);
        }
        else
        {
            var entity = await db.Services.FindAsync(editor.ID);
            if (entity is null) { Fail(I18n.T("Test was not found.")); return; }
            entity.Name = editor.Name; entity.CategoryID = editor.CategoryID; entity.SaleRate = editor.SaleRate; entity.DiagnosticType = editor.DiagnosticType; entity.DeliveryHours = editor.DeliveryHours;
            entity.DiscountType = editor.DiscountType; entity.DiscountValue = editor.DiscountValue; entity.DiscountStart = editor.DiscountStart; entity.DiscountEnd = editor.DiscountEnd;
        }
        await db.SaveChangesAsync();

        // Sync Report Parameters for this investigation
        var existingParams = await db.LabTestParameters.Where(p => p.ServiceID == editor.ID).ToListAsync();
        var keepIds = editorParams.Where(p => p.ID > 0).Select(p => p.ID).ToHashSet();
        foreach (var rem in existingParams.Where(p => !keepIds.Contains(p.ID)))
        {
            db.LabTestParameters.Remove(rem);
        }
        foreach (var p in editorParams.Where(p => !string.IsNullOrWhiteSpace(p.ParameterName)))
        {
            p.ParameterName = p.ParameterName.Trim();
            p.Unit = string.IsNullOrWhiteSpace(p.Unit) ? null : p.Unit.Trim();
            p.ReferenceRange = string.IsNullOrWhiteSpace(p.ReferenceRange) ? null : p.ReferenceRange.Trim();
            p.ServiceID = editor.ID;
            if (p.ID == 0)
            {
                db.LabTestParameters.Add(p);
            }
            else
            {
                var target = existingParams.FirstOrDefault(x => x.ID == p.ID);
                if (target != null)
                {
                    target.ParameterName = p.ParameterName;
                    target.Unit = p.Unit;
                    target.ReferenceRange = p.ReferenceRange;
                    target.SortOrder = p.SortOrder;
                }
            }
        }
        await db.SaveChangesAsync();
        HospitalMasterCacheService.InvalidateGlobalCache();

        Success(I18n.T(isNew ? "Investigation & parameters added successfully." : "Investigation & parameters updated successfully."));
        await LoadAsync();
        ResetEditor(clearMessage: false);
    }

    private async Task DeleteAsync()
    {
        if (editor.ID <= 0 || !await JS.InvokeAsync<bool>("hpm.confirm", I18n.T($"Delete test '{editor.Name}'?"))) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var id = editor.ID;
        var used = await db.EmergencyMemoItems.AnyAsync(x => x.TestID == id)
            || await db.DiagnosticOrderItems.AnyAsync(x => x.ServiceID == id)
            || await db.DiagnosticCashMemoReturnItems.AnyAsync(x => x.ServiceID == id)
            || await db.LabSampleCollections.AnyAsync(x => x.ServiceID == id)
            || await db.LabTestResults.AnyAsync(x => x.ServiceID == id);
        if (used)
        {
            Fail(I18n.T("This test has billing or report records and cannot be deleted. You can rename or change its rate instead.")); return;
        }
        var orphanParams = await db.LabTestParameters.Where(x => x.ServiceID == id).ToListAsync();
        if (orphanParams.Count > 0) db.LabTestParameters.RemoveRange(orphanParams);
        var entity = await db.Services.FindAsync(id);
        if (entity is not null) { db.Services.Remove(entity); await db.SaveChangesAsync(); HospitalMasterCacheService.InvalidateGlobalCache(); }
        Success(I18n.T("Test deleted successfully."));
        await LoadAsync();
        ResetEditor(clearMessage: false);
    }

    private static string GroupToType(string group) => group switch
    {
        "pathology" => DiagnosticTestRouting.Pathology,
        "procedure" => DiagnosticTestRouting.Procedure,
        _ => DiagnosticTestRouting.Imaging
    };

    private void ResetEditor(bool clearMessage = true)
    {
        var t = GroupToType(activeGroup);
        editor = new Service { DiagnosticType = t, SaleRate = 0, DeliveryHours = null };
        editor.CategoryID = ActiveCategories.FirstOrDefault()?.ID;
        editorParams = [];
        newParamName = string.Empty;
        newParamUnit = string.Empty;
        newParamRange = string.Empty;
        newParamOrder = 1;
        if (clearMessage) message = string.Empty;
    }

    private void AddParamToEditor()
    {
        var name = newParamName?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(name)) return;
        editorParams.Add(new LabTestParameter
        {
            ServiceID = editor.ID,
            ParameterName = name,
            Unit = string.IsNullOrWhiteSpace(newParamUnit) ? null : newParamUnit.Trim(),
            ReferenceRange = string.IsNullOrWhiteSpace(newParamRange) ? null : newParamRange.Trim(),
            SortOrder = newParamOrder > 0 ? newParamOrder : editorParams.Count + 1
        });
        newParamName = string.Empty;
        newParamUnit = string.Empty;
        newParamRange = string.Empty;
        newParamOrder = editorParams.Count > 0 ? editorParams.Max(p => p.SortOrder) + 1 : 1;
    }

    private void RemoveParamFromEditor(LabTestParameter p) => editorParams.Remove(p);

    private void ToggleParamExpand(int serviceId)
    {
        if (!expandedParamServiceIds.Add(serviceId))
            expandedParamServiceIds.Remove(serviceId);
    }

    private bool AllFilteredSelected
    {
        get
        {
            var visible = FilteredServices.Select(s => s.ID).ToList();
            return visible.Count > 0 && visible.All(id => selectedServiceIds.Contains(id));
        }
    }

    private void ToggleSelectService(int serviceId, bool selected)
    {
        if (selected) selectedServiceIds.Add(serviceId);
        else selectedServiceIds.Remove(serviceId);
    }

    private void ToggleSelectAllFiltered(ChangeEventArgs e)
    {
        var check = e.Value is bool b && b;
        foreach (var s in FilteredServices)
        {
            if (check) selectedServiceIds.Add(s.ID);
            else selectedServiceIds.Remove(s.ID);
        }
    }

    private void ClearSelection() => selectedServiceIds.Clear();

    private async Task OpenBulkDeleteModal()
    {
        if (selectedServiceIds.Count == 0) return;
        bulkDeletePassword = string.Empty;
        bulkDeleteError = string.Empty;
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var appUser = await UserManager.GetUserAsync(auth.User);
        currentPerformerName = appUser?.GetEffectiveName() ?? auth.User.Identity?.Name ?? "Administrator";
        showBulkDeleteModal = true;
    }

    private void CloseBulkDeleteModal()
    {
        if (bulkDeleteBusy) return;
        showBulkDeleteModal = false;
        bulkDeletePassword = string.Empty;
        bulkDeleteError = string.Empty;
    }

    private async Task ConfirmBulkDeleteAsync()
    {
        if (bulkDeleteBusy) return;
        if (string.IsNullOrWhiteSpace(bulkDeletePassword))
        {
            bulkDeleteError = I18n.T("Please enter your login password to continue.");
            return;
        }

        bulkDeleteBusy = true;
        bulkDeleteError = string.Empty;
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var appUser = await UserManager.GetUserAsync(auth.User);
            if (appUser is null)
            {
                bulkDeleteError = I18n.T("Unable to identify logged-in user.");
                return;
            }

            var passwordOk = await UserManager.CheckPasswordAsync(appUser, bulkDeletePassword);
            if (!passwordOk)
            {
                bulkDeleteError = I18n.T("Incorrect password. Bulk delete cancelled.");
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();
            var targetIds = selectedServiceIds.ToList();
            var usedIds = new HashSet<int>();

            foreach (var id in await db.EmergencyMemoItems.Where(x => targetIds.Contains(x.TestID)).Select(x => x.TestID).Distinct().ToListAsync()) usedIds.Add(id);
            foreach (var id in await db.DiagnosticOrderItems.Where(x => targetIds.Contains(x.ServiceID)).Select(x => x.ServiceID).Distinct().ToListAsync()) usedIds.Add(id);
            foreach (var id in await db.DiagnosticCashMemoReturnItems.Where(x => targetIds.Contains(x.ServiceID)).Select(x => x.ServiceID).Distinct().ToListAsync()) usedIds.Add(id);
            foreach (var id in await db.LabSampleCollections.Where(x => targetIds.Contains(x.ServiceID)).Select(x => x.ServiceID).Distinct().ToListAsync()) usedIds.Add(id);
            foreach (var id in await db.LabTestResults.Where(x => targetIds.Contains(x.ServiceID)).Select(x => x.ServiceID).Distinct().ToListAsync()) usedIds.Add(id);

            var deletableIds = targetIds.Where(id => !usedIds.Contains(id)).ToList();
            var skippedCount = targetIds.Count - deletableIds.Count;

            if (deletableIds.Count > 0)
            {
                var orphanParams = await db.LabTestParameters.Where(p => deletableIds.Contains(p.ServiceID)).ToListAsync();
                if (orphanParams.Count > 0) db.LabTestParameters.RemoveRange(orphanParams);

                var entities = await db.Services.Where(s => deletableIds.Contains(s.ID)).ToListAsync();
                var deletedNames = string.Join(", ", entities.Take(10).Select(e => $"#{e.ID} {e.Name}"));
                if (entities.Count > 10) deletedNames += $" (+{entities.Count - 10} more)";

                db.Services.RemoveRange(entities);

                db.AuditLogs.Add(new AuditLog
                {
                    UserID = appUser.Id,
                    UserName = appUser.GetEffectiveName(),
                    Action = "BulkDelete",
                    EntityName = "Service",
                    EntityID = string.Join(",", deletableIds.Take(20)),
                    ChangedFields = $"Bulk deleted {entities.Count} investigation(s): {deletedNames}. Skipped {skippedCount} with billing/report history.",
                    EventTime = DateTime.UtcNow
                });

                await db.SaveChangesAsync();
                HospitalMasterCacheService.InvalidateGlobalCache();
            }

            showBulkDeleteModal = false;
            selectedServiceIds.Clear();
            bulkDeletePassword = string.Empty;

            if (deletableIds.Count > 0 && skippedCount > 0)
                Success(I18n.T($"Deleted {deletableIds.Count} investigation(s). Skipped {skippedCount} with billing/report history."));
            else if (deletableIds.Count > 0)
                Success(I18n.T($"Deleted {deletableIds.Count} investigation(s) successfully."));
            else
                Fail(I18n.T($"All {skippedCount} selected investigation(s) have billing or report records and cannot be deleted."));

            await LoadAsync();
            ResetEditor(clearMessage: false);
        }
        finally
        {
            bulkDeleteBusy = false;
        }
    }

    private void OpenCategoryModal()
    {
        catMessage = string.Empty;
        ResetCategoryEditor();
        showCategoryModal = true;
    }

    private void CloseCategoryModal() => showCategoryModal = false;

    private void ResetCategoryEditor() => catEditor = new ServiceCategory { DiagnosticType = GroupToType(activeGroup), SubID = 8 };

    private void EditCategory(ServiceCategory c)
    {
        catMessage = string.Empty;
        catEditor = new ServiceCategory { ID = c.ID, Name = c.Name, SubID = 8, DiagnosticType = DiagnosticTestRouting.ResolveCategoryType(c) };
    }

    private async Task SaveCategoryAsync()
    {
        catEditor.Name = catEditor.Name?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(catEditor.Name))
        {
            catMessageClass = "danger";
            catMessage = I18n.T("Category name is required.");
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.ServiceCategories.AnyAsync(c => c.ID != catEditor.ID && c.Name == catEditor.Name))
        {
            catMessageClass = "danger";
            catMessage = I18n.T("A category with this name already exists.");
            return;
        }
        if (catEditor.ID == 0)
        {
            catEditor.ID = (await db.ServiceCategories.MaxAsync(x => (int?)x.ID) ?? 0) + 1;
            catEditor.SubID = 8;
            db.ServiceCategories.Add(catEditor);
        }
        else
        {
            var entity = await db.ServiceCategories.FindAsync(catEditor.ID);
            if (entity is null) return;
            entity.Name = catEditor.Name;
            entity.SubID = 8;
            entity.DiagnosticType = catEditor.DiagnosticType;
        }
        await db.SaveChangesAsync();
        HospitalMasterCacheService.InvalidateGlobalCache();
        catMessageClass = "success";
        catMessage = I18n.T("Category saved successfully.");
        ResetCategoryEditor();
        await LoadAsync();
    }

    private async Task DeleteCategoryAsync(ServiceCategory c)
    {
        if (!await JS.InvokeAsync<bool>("hpm.confirm", I18n.T($"Delete category '{c.Name}'?"))) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.Services.AnyAsync(x => x.CategoryID == c.ID))
        {
            catMessageClass = "danger";
            catMessage = I18n.T("This category has tests and cannot be deleted.");
            return;
        }
        var entity = await db.ServiceCategories.FindAsync(c.ID);
        if (entity is not null) { db.ServiceCategories.Remove(entity); await db.SaveChangesAsync(); HospitalMasterCacheService.InvalidateGlobalCache(); }
        catMessageClass = "success";
        catMessage = I18n.T("Category deleted.");
        ResetCategoryEditor();
        await LoadAsync();
    }

    private ServiceCategory? CategoryById(int? id) => id is null ? null : categories.FirstOrDefault(c => c.ID == id.Value);
    private string CategoryName(int? id) => CategoryById(id)?.Name ?? "—";
    private void Success(string text) { messageClass = "success"; message = text; }
    private void Fail(string text) { messageClass = "danger"; message = text; }
    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => I18n.OnLanguageChanged -= HandleLanguageChanged;
}
