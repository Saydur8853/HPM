@page "/diagnostic/investigations"
@attribute [Authorize(Roles = RoleNames.Administrator)]
@implements IDisposable
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject IJSRuntime JS

<PageTitle>@I18n.T("Investigations Setup") | @Branding.HospitalName</PageTitle>

<div class="diagnostic-test-master-page">
    <div class="diagnostic-classic-topbar">
        <div class="tickets-top-left">
            <h1 class="tickets-page-title"><span>🧪</span><span>@I18n.T("Investigations Setup", "ইনভেস্টিগেশন সেটআপ")</span></h1>
            <span class="tickets-count-pill">@FilteredServices.Count() @I18n.T("Investigations")</span>
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <span class="tickets-inline-alert @messageClass" title="@message">@message</span>
            }
        </div>
        <div style="display:flex; flex-wrap:wrap; align-items:center; gap:8px;">
            <button type="button" class="btn btn-secondary btn-sm" @onclick="OpenReportPreview" title="@I18n.T("Preview Sample Diagnostic Report")">
                👁️ @I18n.T("Report Preview", "রিপোর্ট প্রিভিউ")
            </button>
            <button type="button" class="btn btn-secondary btn-sm" @onclick="OpenCategoryModal">
                📂 @I18n.T("Manage Categories", "ক্যাটাগরি ম্যানেজ")
            </button>
            <BulkUploadWidget TypeKey="@activeGroup" OnImported="LoadAsync" />
        </div>
    </div>

    <div class="dtm-tabs" role="tablist" aria-label="@I18n.T("Diagnostic investigation types")">
        <button type="button" class="dtm-tab @(activeGroup == "pathology" ? "active pathology" : "")" @onclick='() => SwitchGroup("pathology")'>
            <span>🔬</span>
            <span><strong>@I18n.T("Pathology Investigations")</strong><small>@PathologyServices.Count @I18n.T("items")</small></span>
        </button>
        <button type="button" class="dtm-tab @(activeGroup == "imaging" ? "active imaging" : "")" @onclick='() => SwitchGroup("imaging")'>
            <span style="color:#1e3a8a; display:inline-flex; align-items:center;"><RadiologyIcon Size="20" /></span>
            <span><strong>@I18n.T("Imaging Investigations")</strong><small>@ImagingServices.Count @I18n.T("items")</small></span>
        </button>
        <button type="button" class="dtm-tab @(activeGroup == "procedure" ? "active imaging" : "")" @onclick='() => SwitchGroup("procedure")'>
            <span style="color:#0f172a; display:inline-flex; align-items:center;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M2 12h3.5l1.8-2.2 2 4.4 2.2-8.2 2.4 12 2.2-9 1.7 3H22" />
                </svg>
            </span>
            <span><strong>@I18n.T("Special Investigations", "স্পেশাল ইনভেস্টিগেশন")</strong><small>@ProcedureServices.Count @I18n.T("items")</small></span>
        </button>
    </div>

    <div class="dtm-workspace">
        <section class="dtm-form-card">
            <div class="dtm-card-header">
                <h2>@(editor.ID == 0 ? I18n.T("Add New Investigation") : I18n.T("Edit Investigation"))</h2>
                @if (editor.ID > 0) { <span class="diagnostic-badge">ID #@editor.ID</span> }
            </div>

            <div class="dtm-form-body">
                <label><span>@I18n.T("Investigation Name") *</span><InputText class="classic-input" @bind-Value="editor.Name" placeholder="@I18n.T("Enter investigation name")" /></label>
                <label>
                    <span style="display:flex; justify-content:space-between; align-items:center;">
                        <span>@I18n.T("Category") *</span>
                        <button type="button" class="btn-link" style="border:none; background:none; color:#0369a1; font-size:11.5px; font-weight:700; cursor:pointer; padding:0;" @onclick="OpenCategoryModal">+ @I18n.T("Manage", "ম্যানেজ")</button>
                    </span>
                    <InputSelect class="classic-input tickets-select" @bind-Value="editor.CategoryID">
                        <option value="">@I18n.T("Select category")</option>
                        @foreach (var category in ActiveCategories) { <option value="@category.ID">@category.Name</option> }
                    </InputSelect>
                </label>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                    <label><span>@I18n.T("Sale Rate") (@I18n.CurrencySymbol) *</span><InputNumber class="classic-input" @bind-Value="editor.SaleRate" min="0" /></label>
                    <label>
                        <span>@I18n.T("Delivery Hours (TAT)", "ডেলিভারি সময় (ঘণ্টা)")</span>
                        <InputNumber class="classic-input" @bind-Value="editor.DeliveryHours" min="1" max="720" placeholder="e.g. 6, 24, 48" />
                    </label>
                </div>

                <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:10px 12px; margin-bottom:10px; display:flex; flex-direction:column; gap:8px;">
                    <div style="font-size:12px; font-weight:800; color:#0f172a;">🏷️ @I18n.T("Investigation Discount & Validity", "ইনভেস্টিগেশন ডিসকাউন্ট ও সময়সীমা")</div>
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
                        <label style="margin:0;">
                            <span>@I18n.T("Discount Type", "ডিসকাউন্ট ধরন")</span>
                            <InputSelect class="classic-input tickets-select" @bind-Value="editor.DiscountType">
                                <option value="">@I18n.T("No Discount", "ডিসকাউন্ট নেই")</option>
                                <option value="Percent">@I18n.T("Percentage (%)", "শতাংশ (%)")</option>
                                <option value="Amount">@I18n.T("Fixed Amount", "নির্দিষ্ট টাকা")</option>
                            </InputSelect>
                        </label>
                        <label style="margin:0;">
                            <span>@(editor.DiscountType == "Percent" ? I18n.T("Discount (%)") : $"{I18n.T("Discount")} ({I18n.CurrencySymbol})")</span>
                            <InputNumber class="classic-input" @bind-Value="editor.DiscountValue" min="0" disabled="@string.IsNullOrWhiteSpace(editor.DiscountType)" />
                        </label>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(editor.DiscountType))
                    {
                        <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
                            <label style="margin:0;">
                                <span>@I18n.T("Start Date & Time", "শুরুর তারিখ ও সময়")</span>
                                <input type="datetime-local" class="classic-input"
                                       value="@(editor.DiscountStart?.ToString("yyyy-MM-ddTHH:mm") ?? "")"
                                       @onchange="e => editor.DiscountStart = ParseDateTimeLocal(e.Value?.ToString())" />
                            </label>
                            <label style="margin:0;">
                                <span>@I18n.T("End Date & Time", "শেষের তারিখ ও সময়")</span>
                                <input type="datetime-local" class="classic-input"
                                       value="@(editor.DiscountEnd?.ToString("yyyy-MM-ddTHH:mm") ?? "")"
                                       @onchange="e => editor.DiscountEnd = ParseDateTimeLocal(e.Value?.ToString())" />
                            </label>
                        </div>
                        @if (editor.DiscountEnd.HasValue && DateTime.Now > editor.DiscountEnd.Value)
                        {
                            <div style="color:#dc2626; font-size:12px; font-weight:800;">⚠️ @I18n.T("Discount period end", "ডিসকাউন্টের সময় শেষ হয়ে গেছে")</div>
                        }
                        else
                        {
                            var previewDisc = DiagnosticTestRouting.EvaluateDiscount(editor);
                            if (previewDisc.IsActive)
                            {
                                <div style="color:#059669; font-size:11.5px; font-weight:700;">✓ @I18n.T("Active during billing"): @I18n.FormatCurrency(previewDisc.OriginalRate) → <strong>@I18n.FormatCurrency(previewDisc.EffectiveRate)</strong></div>
                            }
                            else if (previewDisc.IsScheduled && editor.DiscountStart.HasValue)
                            {
                                <div style="color:#0369a1; font-size:11.5px; font-weight:700;">🕒 @I18n.T("Scheduled"): @editor.DiscountStart.Value.ToString("dd MMM yyyy hh:mm tt")</div>
                            }
                        }
                    }
                </div>

                <!-- Report Parameters Inline Setup -->
                <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:10px 12px; margin-bottom:10px; display:flex; flex-direction:column; gap:10px;">
                    <div style="font-size:12px; font-weight:800; color:#0f172a;">
                        📋 @I18n.T("Report Parameters", "রিপোর্ট প্যারামিটার")
                        <span class="pill" style="margin-left:6px; font-size:10.5px;">@editorParams.Count</span>
                    </div>

                    <!-- 2-Row Clean Add Form -->
                    <div style="background:#fff; border:1px solid #e2e8f0; border-radius:8px; padding:8px 10px; display:flex; flex-direction:column; gap:6px;">
                        <div style="display:grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap:6px;">
                            <input class="classic-input" style="width:100%; min-width:0; height:30px; font-size:11.5px;" @bind="newParamName" placeholder="@I18n.T("Parameter Name")" />
                            <input class="classic-input" style="width:100%; min-width:0; height:30px; font-size:11.5px;" @bind="newParamUnit" placeholder="@I18n.T("Unit")" />
                        </div>
                        <div style="display:grid; grid-template-columns: minmax(0, 1fr) 54px auto; gap:6px; align-items:center;">
                            <input class="classic-input" style="width:100%; min-width:0; height:30px; font-size:11.5px;" @bind="newParamRange" placeholder="@I18n.T("Reference Normal Range")" />
                            <input type="number" class="classic-input" style="width:100%; min-width:0; height:30px; font-size:11.5px; text-align:center;" @bind="newParamOrder" title="@I18n.T("Display Order")" placeholder="#" />
                            <button type="button" class="btn btn-secondary btn-sm" style="height:30px; padding:0 12px; font-size:11.5px; white-space:nowrap;" @onclick="AddParamToEditor">+ @I18n.T("Add")</button>
                        </div>
                    </div>

                    @if (editorParams.Count > 0)
                    {
                        <div style="max-height:210px; overflow-y:auto; border:1px solid #e2e8f0; border-radius:8px; background:#fff; display:flex; flex-direction:column;">
                            @foreach (var p in editorParams.OrderBy(x => x.SortOrder))
                            {
                                <div style="padding:8px 10px; border-bottom:1px solid #f1f5f9; display:flex; flex-direction:column; gap:5px;">
                                    <div style="display:grid; grid-template-columns: minmax(0, 1fr) 72px 46px 26px; gap:5px; align-items:center;">
                                        <input class="classic-input" style="width:100%; min-width:0; height:28px; font-size:11.5px; font-weight:600; padding:2px 8px;" @bind="p.ParameterName" placeholder="@I18n.T("Parameter Name")" />
                                        <input class="classic-input" style="width:100%; min-width:0; height:28px; font-size:11px; padding:2px 6px;" @bind="p.Unit" placeholder="@I18n.T("Unit")" />
                                        <input type="number" class="classic-input" style="width:100%; min-width:0; height:28px; font-size:11px; padding:2px 4px; text-align:center;" @bind="p.SortOrder" title="@I18n.T("Order")" />
                                        <button type="button" class="btn btn-ghost" style="padding:2px 4px; color:#dc2626; font-size:12px;" @onclick="() => RemoveParamFromEditor(p)" title="@I18n.T("Remove")">✕</button>
                                    </div>
                                    <input class="classic-input" style="width:100%; min-width:0; height:26px; font-size:11px; padding:2px 8px; color:#475569;" @bind="p.ReferenceRange" placeholder="@I18n.T("Reference Normal Range")" />
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="dtm-form-actions">
                    <button type="button" class="btn btn-primary" @onclick="SaveAsync">✓ @(editor.ID == 0 ? I18n.T("Save Investigation") : I18n.T("Update Investigation"))</button>
                    @if (editor.ID > 0) { <button type="button" class="btn btn-danger" @onclick="DeleteAsync">🗑 @I18n.T("Delete")</button> }
                    <button type="button" class="btn btn-ghost" @onclick="() => ResetEditor()">@I18n.T("Clear")</button>
                </div>
            </div>
        </section>

        <section class="dtm-list-card">
            <div class="dtm-card-header dtm-list-header">
                <h2>@(activeGroup == "pathology" ? I18n.T("Pathology Investigation List") : activeGroup == "procedure" ? I18n.T("Special Investigations List", "স্পেশাল ইনভেস্টিগেশন তালিকা") : I18n.T("Imaging Investigation List"))</h2>
                <div class="dtm-search-wrap"><span>⌕</span><input class="classic-input" type="search" @bind="searchQuery" @bind:event="oninput" placeholder="@I18n.T("Search name, ID, category or parameter...")" /></div>
            </div>

            <div class="dtm-table-wrap">
                <table class="classic-table dtm-table">
                    <thead><tr><th style="width:65px;">@I18n.T("Code")</th><th>@I18n.T("Investigation Name")</th><th>@I18n.T("Category")</th><th class="num">@I18n.T("Rate")</th><th style="width:75px; text-align:center;">@I18n.T("Delivery")</th><th style="width:72px;"></th></tr></thead>
                    <tbody>
                        @if (!FilteredServices.Any()) { <tr><td colspan="6" class="dtm-empty">@I18n.T("No investigations found in this list.")</td></tr> }
                        @foreach (var service in FilteredServices)
                        {
                            var disc = DiagnosticTestRouting.EvaluateDiscount(service);
                            var svcParams = allParameters.Where(p => p.ServiceID == service.ID).OrderBy(p => p.SortOrder).ToList();
                            var isExpanded = expandedParamServiceIds.Contains(service.ID);
                            <tr class="@(editor.ID == service.ID ? "selected" : "")">
                                <td><span class="pill">#@service.ID</span></td>
                                <td>
                                    <div style="display:flex; flex-wrap:wrap; align-items:center; gap:5px;">
                                        <strong>@service.Name</strong>
                                        @if (svcParams.Count > 0)
                                        {
                                            <button type="button"
                                                    class="pill"
                                                    style="border:none; cursor:pointer; background:@(isExpanded ? "#0369a1" : "#e0f2fe"); color:@(isExpanded ? "#fff" : "#0369a1"); font-size:10px; font-weight:700;"
                                                    @onclick="() => ToggleParamExpand(service.ID)"
                                                    title="@I18n.T("Show / hide parameters")">
                                                @(isExpanded ? "▴" : "▾") @svcParams.Count @I18n.T("params")
                                            </button>
                                        }
                                        @if (disc.IsActive)
                                        {
                                            <span class="pill" style="background:#dcfce7; color:#166534; font-size:10.5px;">
                                                -@(service.DiscountType == "Percent" ? $"{service.DiscountValue:0.##}%" : I18n.FormatCurrency(service.DiscountValue ?? 0))
                                            </span>
                                        }
                                        else if (disc.IsExpired)
                                        {
                                            <span class="pill" style="background:#fee2e2; color:#dc2626; font-size:10.5px;">@I18n.T("Discount period end")</span>
                                        }
                                    </div>
                                    @if (svcParams.Count > 0)
                                    {
                                        <div style="font-size:10.5px; color:#64748b; margin-top:2px; line-height:1.3;">
                                            @string.Join(" · ", svcParams.Take(4).Select(p => p.ParameterName))@(svcParams.Count > 4 ? $" +{svcParams.Count - 4} more" : "")
                                        </div>
                                    }
                                </td>
                                <td><span class="dtm-category-pill">@CategoryName(service.CategoryID)</span></td>
                                <td class="num">
                                    @if (disc.IsActive)
                                    {
                                        <del style="color:#94a3b8; font-size:11px; margin-right:4px;">@I18n.FormatCurrency(disc.OriginalRate)</del>
                                        <strong style="color:#059669;">@I18n.FormatCurrency(disc.EffectiveRate)</strong>
                                    }
                                    else
                                    {
                                        <strong>@I18n.FormatCurrency(service.SaleRate ?? 0)</strong>
                                    }
                                </td>
                                <td style="text-align:center;"><span class="pill" style="font-size: 11px;">@(service.DeliveryHours > 0 ? $"{service.DeliveryHours}h" : "Std")</span></td>
                                <td><button type="button" class="btn btn-ghost dtm-edit-btn" @onclick="() => SelectService(service)">✎ @I18n.T("Edit")</button></td>
                            </tr>
                            @if (isExpanded && svcParams.Count > 0)
                            {
                                <tr style="background:#f8fafc;">
                                    <td colspan="6" style="padding:8px 14px 12px 44px; border-bottom:1px solid #cbd5e1;">
                                        <div style="background:#fff; border:1px solid #e2e8f0; border-radius:8px; overflow:hidden;">
                                            <div style="display:flex; justify-content:space-between; align-items:center; padding:6px 10px; background:#f1f5f9; border-bottom:1px solid #e2e8f0; font-size:11px; font-weight:700; color:#334155;">
                                                <span>📋 @service.Name — @I18n.T("Configured Parameters") (@svcParams.Count)</span>
                                                <button type="button" class="btn btn-ghost btn-sm" style="padding:1px 8px; font-size:10.5px; color:#0369a1;" @onclick="() => OpenReportPreviewFor(service.ID)">
                                                    👁️ @I18n.T("Report Preview")
                                                </button>
                                            </div>
                                            <table style="width:100%; border-collapse:collapse; font-size:11px;">
                                                <thead>
                                                    <tr style="border-bottom:1px solid #e2e8f0; color:#64748b;">
                                                        <th style="padding:5px 8px; width:36px; text-align:center;">#</th>
                                                        <th style="padding:5px 8px; text-align:left;">@I18n.T("Parameter Name")</th>
                                                        <th style="padding:5px 8px; width:90px; text-align:center;">@I18n.T("Unit")</th>
                                                        <th style="padding:5px 8px; text-align:left;">@I18n.T("Reference Normal Range")</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var p in svcParams)
                                                    {
                                                        <tr style="border-bottom:1px solid #f1f5f9;">
                                                            <td style="padding:5px 8px; text-align:center; color:#64748b;">@p.SortOrder</td>
                                                            <td style="padding:5px 8px; font-weight:600; color:#0f172a;">@p.ParameterName</td>
                                                            <td style="padding:5px 8px; text-align:center;"><span class="pill" style="font-size:10px;">@(string.IsNullOrWhiteSpace(p.Unit) ? "—" : p.Unit)</span></td>
                                                            <td style="padding:5px 8px; color:#475569;">@(string.IsNullOrWhiteSpace(p.ReferenceRange) ? "—" : p.ReferenceRange)</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    @if (showCategoryModal)
    {
        <div style="position:fixed; inset:0; background:rgba(15,23,42,0.55); display:flex; align-items:center; justify-content:center; padding:16px; z-index:1200;" @onclick="CloseCategoryModal">
            <div style="width:100%; max-width:680px; max-height:88vh; background:#fff; border-radius:14px; box-shadow:0 24px 48px rgba(15,23,42,0.22); display:flex; flex-direction:column; overflow:hidden;" @onclick:stopPropagation="true">
                <div style="display:flex; justify-content:space-between; align-items:center; padding:14px 18px; border-bottom:1px solid #e2e8f0; background:#f8fafc;">
                    <h3 style="margin:0; font-size:15px; font-weight:800;">📂 @I18n.T("Manage Diagnostic Categories", "ডায়াগনস্টিক ক্যাটাগরি ম্যানেজ")</h3>
                    <button type="button" style="border:none; background:transparent; font-size:16px; font-weight:700; cursor:pointer;" @onclick="CloseCategoryModal">✕</button>
                </div>
                <div style="padding:16px 18px; overflow-y:auto; display:flex; flex-direction:column; gap:14px;">
                    @if (!string.IsNullOrWhiteSpace(catMessage))
                    {
                        <div class="alert @(catMessageClass == "success" ? "alert-success" : "alert-danger")" style="padding:8px 12px; border-radius:8px; font-size:12.5px;">@catMessage</div>
                    }
                    <div style="display:grid; grid-template-columns:1.5fr 1fr auto; gap:10px; align-items:end; background:#f8fafc; padding:12px; border-radius:10px; border:1px solid #e2e8f0;">
                        <label style="margin:0;">
                            <span style="font-size:11.5px; font-weight:700; display:block; margin-bottom:4px;">@I18n.T("Category Name") *</span>
                            <input class="classic-input" @bind="catEditor.Name" placeholder="e.g. Biochemistry, X-Ray, ECG" />
                        </label>
                        <label style="margin:0;">
                            <span style="font-size:11.5px; font-weight:700; display:block; margin-bottom:4px;">@I18n.T("Diagnostic Type") *</span>
                            <select class="classic-input tickets-select" @bind="catEditor.DiagnosticType">
                                <option value="Pathology">@I18n.T("Pathology")</option>
                                <option value="Imaging">@I18n.T("Imaging")</option>
                                <option value="Procedure">@I18n.T("Special Investigations")</option>
                            </select>
                        </label>
                        <div style="display:flex; gap:6px;">
                            <button type="button" class="btn btn-primary btn-sm" @onclick="SaveCategoryAsync">@(catEditor.ID == 0 ? I18n.T("Add") : I18n.T("Update"))</button>
                            @if (catEditor.ID > 0)
                            {
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="ResetCategoryEditor">@I18n.T("New")</button>
                            }
                        </div>
                    </div>

                    <div style="display:flex; flex-wrap:wrap; gap:8px; align-items:center; justify-content:space-between;">
                        <input class="classic-input" type="search" style="flex:1; min-width:180px;" @bind="catSearch" @bind:event="oninput" placeholder="@I18n.T("Search category...")" />
                        <select class="classic-input tickets-select" style="width:190px;" @bind="catTypeFilter">
                            <option value="All">@I18n.T("All Types") (@DiagnosticCategories.Count())</option>
                            <option value="Pathology">@I18n.T("Pathology")</option>
                            <option value="Imaging">@I18n.T("Imaging")</option>
                            <option value="Procedure">@I18n.T("Special Investigations")</option>
                        </select>
                    </div>

                    <div style="max-height:320px; overflow-y:auto; border:1px solid #e2e8f0; border-radius:10px;">
                        <table class="classic-table dtm-table">
                            <thead><tr><th>@I18n.T("Category")</th><th>@I18n.T("Type")</th><th style="width:70px; text-align:center;">@I18n.T("Items")</th><th style="width:110px; text-align:right;">@I18n.T("Actions")</th></tr></thead>
                            <tbody>
                                @if (!FilteredDiagnosticCategories.Any())
                                {
                                    <tr><td colspan="4" class="dtm-empty">@I18n.T("No matching categories found.")</td></tr>
                                }
                                @foreach (var c in FilteredDiagnosticCategories)
                                {
                                    var resolvedType = DiagnosticTestRouting.ResolveCategoryType(c);
                                    var itemCount = services.Count(s => s.CategoryID == c.ID);
                                    <tr>
