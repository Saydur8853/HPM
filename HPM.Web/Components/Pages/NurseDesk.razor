@code {
    private List<PatientAdmission> admittedPatients = [];
    private List<PatientAdmission> filteredAdmissions = [];
    private List<Department> departments = [];
    private List<DoctorsProfile> doctors = [];
    private Dictionary<string, string> patientNames = [];
    private Dictionary<string, Registration> patientRegistrations = [];
    private Dictionary<int, string> bedNames = [];
    private Dictionary<int, string> departmentNames = [];

    private PatientAdmission? selectedAdmission;
    private string selectedPatientName = string.Empty;
    private string searchQuery = string.Empty;
    private int deptFilter = 0;
    private string quickFilter = "all";

    private string activeTab = "stickers";
    private string sampleType = "Blood (EDTA / CBC / HbA1c)";
    private string currentStaffNurse = "Staff Nurse";

    // IV Cannula tag state
    private string cannulaLineType = "Peripheral IV Cannula";
    private string cannulaGauge = "20G (Pink - Standard IV)";

    // Vitals Logger state
    private string newVitalTemp = "98.4";
    private string newVitalPulse = "76";
    private string newVitalResp = "18";
    private string newVitalBp = "120/80";
    private string newVitalSpo2 = "98";
    private string newVitalRbs = "6.2";
    private string newVitalPain = "0";
    private List<VitalEntry> recordedVitals = [];

    // MAR state
    private string drugAllergies = "NIL KNOWN MEDICINE ALLERGIES";

    private int occupiedBedCount => admittedPatients.Count(x => x.BedCabinID.HasValue);
    private int todayAdmittedCount => admittedPatients.Count(x => x.AdmissionDate.HasValue && x.AdmissionDate.Value.Date == DateTime.Today);

    public sealed class VitalEntry
    {
        public DateTime RecordedAt { get; set; } = DateTime.Now;
        public string Temperature { get; set; } = string.Empty;
        public string Pulse { get; set; } = string.Empty;
        public string Respiration { get; set; } = string.Empty;
        public string BloodPressure { get; set; } = string.Empty;
        public string SpO2 { get; set; } = string.Empty;
        public string BloodSugar { get; set; } = string.Empty;
        public string PainScore { get; set; } = string.Empty;
        public string NurseInitial { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task RefreshDataAsync()
    {
        await LoadDataAsync();
        ApplyFilters();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            admittedPatients = await db.PatientAdmissions.AsNoTracking()
                .Where(x => x.IsAdmitted == true)
                .OrderByDescending(x => x.AdmissionDate)
                .ToListAsync();

            filteredAdmissions = admittedPatients;

            var pIds = admittedPatients.Select(x => x.PatientID).Where(x => !string.IsNullOrEmpty(x)).Distinct().ToList();
            if (pIds.Count > 0)
            {
                var regs = await db.Registrations.AsNoTracking().Where(x => pIds.Contains(x.PatientID)).ToListAsync();
                patientNames = regs.ToDictionary(x => x.PatientID, x => x.Name);
                patientRegistrations = regs.ToDictionary(x => x.PatientID, x => x);
            }

            departments = await db.Departments.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
            departmentNames = departments.ToDictionary(x => x.ID, x => x.Name);

            doctors = await db.Doctors.AsNoTracking().Where(x => x.IsActive).OrderBy(x => x.Name).ToListAsync();

            var beds = await db.BedCabins.AsNoTracking().ToListAsync();
            bedNames = beds.ToDictionary(x => x.ID, x => x.Name);

            // Fetch current logged-in user name
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user?.Identity?.IsAuthenticated == true && !string.IsNullOrWhiteSpace(user.Identity.Name))
            {
                currentStaffNurse = user.Identity.Name;
            }
        }
        catch (Exception) { }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        ApplyFilters();
    }

    private void ClearSearch()
    {
        searchQuery = "";
        ApplyFilters();
    }

    private void SetQuickFilter(string filter)
    {
        quickFilter = filter;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var q = admittedPatients.AsEnumerable();

        if (deptFilter > 0)
            q = q.Where(x => x.Department == deptFilter);

        if (quickFilter == "today")
        {
            q = q.Where(x => x.AdmissionDate.HasValue && x.AdmissionDate.Value.Date == DateTime.Today);
        }
        else if (quickFilter == "cabin")
        {
            q = q.Where(x => x.BedCabinID.HasValue && BedName(x.BedCabinID).ToLowerInvariant().Contains("cabin"));
        }
        else if (quickFilter == "ward")
        {
            q = q.Where(x => !x.BedCabinID.HasValue || !BedName(x.BedCabinID).ToLowerInvariant().Contains("cabin"));
        }

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var term = searchQuery.Trim().ToLowerInvariant();
            q = q.Where(x => (x.PatientID?.ToLowerInvariant().Contains(term) ?? false) ||
                             (x.RegNo?.ToLowerInvariant().Contains(term) ?? false) ||
                             (patientNames.GetValueOrDefault(x.PatientID ?? "", "").ToLowerInvariant().Contains(term)) ||
                             (DoctorName(x.Consultant).ToLowerInvariant().Contains(term)) ||
                             (BedName(x.BedCabinID).ToLowerInvariant().Contains(term)));
        }

        filteredAdmissions = q.ToList();
    }

    private void SelectAdmission(PatientAdmission adm)
    {
        selectedAdmission = adm;
        selectedPatientName = patientNames.GetValueOrDefault(adm.PatientID ?? "", "—");
        recordedVitals.Clear();
    }

    private void SwitchTab(string tab)
    {
        activeTab = tab;
    }

    private void AddVitalEntry()
    {
        recordedVitals.Add(new VitalEntry
        {
            RecordedAt = DateTime.Now,
            Temperature = newVitalTemp,
            Pulse = newVitalPulse,
            Respiration = newVitalResp,
            BloodPressure = newVitalBp,
            SpO2 = newVitalSpo2,
            BloodSugar = newVitalRbs,
            PainScore = newVitalPain,
            NurseInitial = currentStaffNurse.Length > 2 ? currentStaffNurse[..2].ToUpperInvariant() : "SN"
        });
    }

    private void ClearRecordedVitals()
    {
        recordedVitals.Clear();
    }

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "PT";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Length >= 2 ? parts[0][..2].ToUpperInvariant() : parts[0].ToUpperInvariant();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private static string GetStayDurationText(DateTime? admissionDate)
    {
        if (!admissionDate.HasValue) return "—";
        var days = (DateTime.Now.Date - admissionDate.Value.Date).Days;
        if (days == 0) return "Today";
        if (days == 1) return "1 day";
        return $"{days} days";
    }

    private async Task HandleGlobalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                ClearSearch();
            }
            else
            {
                selectedAdmission = null;
            }
        }
        else if (e.Key is "1" or "2" or "3" or "4" or "5" or "6" && !e.CtrlKey && !e.AltKey && !e.MetaKey)
        {
            activeTab = e.Key switch
            {
                "1" => "stickers",
                "2" => "vitals",
                "3" => "mar",
                "4" => "fluid",
                "5" => "handover",
                "6" => "transfusion",
                _ => activeTab
            };
        }
        else if ((e.CtrlKey || e.MetaKey) && (e.Key == "p" || e.Key == "P"))
        {
            if (selectedAdmission != null)
            {
                var targetId = activeTab switch
                {
                    "stickers" => "printable-sticker",
                    "vitals" => "printable-vitals",
                    "mar" => "printable-mar",
                    "fluid" => "printable-fluid",
                    "handover" => "printable-handover",
                    "transfusion" => "printable-transfusion",
                    _ => "printable-sticker"
                };
                await PrintElement(targetId);
            }
        }
    }

    private async Task PrintElement(string elementId) => await JS.InvokeVoidAsync("hpm.printElement", elementId);

    private string DoctorName(int? id)
    {
        if (!id.HasValue || id.Value <= 0) return "—";
        var doc = doctors.FirstOrDefault(d => d.ID == id.Value);
        return doc != null ? $"{doc.Title} {doc.Name}".Trim() : "—";
    }

    private string BedName(int? id) => id.HasValue && bedNames.TryGetValue(id.Value, out var n) ? n : "—";
    private string DepartmentName(int? id) => id.HasValue && departmentNames.TryGetValue(id.Value, out var n) ? n : "—";

    public void Dispose() { }
}
