@page "/ipd/admissions"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.Reception + "," + RoleNames.IPDOperator)]
@rendermode InteractiveServer
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject IBarcodeQrService BarcodeQr
@inject PatientSelectionState PatientSelection
@inject NavigationManager Navigation
@implements IDisposable
@using System.Security.Claims
@using HPM.Web.Components.Common
@using HPM.Web.Data
@using HPM.Web.Data.Entities
@using HPM.Web.Services
@using Microsoft.EntityFrameworkCore

<PageTitle>@I18n.T("Patient Admission") | @Branding.HospitalName</PageTitle>

<style>
.appt-patient-clean-option {
    width: 100%;
    display: grid;
    grid-template-columns: 88px minmax(130px, 1fr) 100px 58px;
    gap: 8px;
    align-items: center;
    padding: 6px 10px;
    border: none;
    border-bottom: 1px solid #f1f5f9;
    background: #ffffff;
    text-align: left;
    cursor: pointer;
    box-sizing: border-box;
    transition: background 0.12s ease;
}
.appt-patient-clean-option:hover,
.appt-patient-clean-option:focus {
    background: #eff6ff;
}
.appt-patient-clean-option .patient-id {
    font-size: 11px;
    font-weight: 800;
    color: #0369a1;
    white-space: nowrap;
}
.appt-patient-clean-option .patient-name {
    font-size: 11.5px;
    font-weight: 650;
    color: #0f172a;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.appt-patient-clean-option .patient-phone {
    font-size: 11px;
    font-weight: 600;
    color: #334155;
    white-space: nowrap;
}
.appt-patient-clean-option .meta-tag {
    font-size: 10px;
    padding: 1px 5px;
    border-radius: 4px;
    text-align: center;
    white-space: nowrap;
}
.bed-clean-list {
    display: flex;
    flex-direction: column;
    max-height: 330px;
    overflow-y: auto;
    overflow-x: hidden;
    background: #ffffff;
}
.bed-list-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 12px;
    border: none;
    border-bottom: 1px solid #f1f5f9;
    background: #ffffff;
    cursor: pointer;
    text-align: left;
    width: 100%;
    box-sizing: border-box;
    flex-shrink: 0;
    min-height: 42px;
    transition: background 0.12s ease;
}
.bed-list-row.is-available:hover {
    background: #eff6ff;
}
.bed-list-row.is-selected {
    background: #e0f2fe !important;
    border-bottom-color: #bae6fd;
}
.bed-list-row.is-occupied {
    background: #f8fafc;
    cursor: not-allowed;
    opacity: 0.65;
}
.bed-list-name-col {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    flex: 1 1 auto;
}
.bed-list-icon {
    font-size: 15px;
    line-height: 1;
    flex-shrink: 0;
}
.bed-list-name {
    font-size: 13px;
    font-weight: 800;
    color: #0f172a;
    white-space: nowrap;
}
.bed-list-meta {
    font-size: 11px;
    color: #64748b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.bed-list-status-col {
    flex-shrink: 0;
    display: flex;
    align-items: center;
}
.bed-status-pill {
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 4px;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 4px;
}
.bed-status-pill.available {
    background: #ecfdf5;
    color: #047857;
    border: 1px solid #a7f3d0;
}
.bed-status-pill.occupied {
    background: #fee2e2;
    color: #b91c1c;
    border: 1px solid #fecaca;
}
.bed-status-pill.selected {
    background: #0284c7;
    color: #ffffff;
    border: 1px solid #0284c7;
}
.bed-search-box-wrap {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
}
.bed-search-box-input {
    width: 100% !important;
    height: 32px !important;
    min-height: 32px !important;
    padding-left: 32px !important;
    padding-right: 28px !important;
    font-size: 12px !important;
    border: 1px solid #cbd5e1 !important;
    border-radius: 6px !important;
    background: #ffffff !important;
    color: #0f172a !important;
    box-sizing: border-box !important;
}
.bed-search-box-input:focus {
    border-color: #0284c7 !important;
    outline: none !important;
    box-shadow: 0 0 0 2px rgba(2, 132, 199, 0.2) !important;
    background-color: #f0f9ff !important;
}
.bed-search-box-icon {
    position: absolute;
    left: 10px;
    top: 50%;
    transform: translateY(-50%);
    color: #64748b;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
}
.bed-search-box-clear {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 12px;
    color: #94a3b8;
    cursor: pointer;
    background: #f1f5f9;
    border: none;
    border-radius: 50%;
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
}
.bed-search-box-clear:hover {
    background: #e2e8f0;
    color: #0f172a;
}
</style>

<div class="ipd-classic-fit appointments-classic-fit tickets-classic-fit" tabindex="0" @onkeydown="HandlePageKeyDown">
    <!-- Compact Top Action & Status Bar -->
    <div class="appt-classic-topbar">
        <div class="appt-top-left">
            <h1 class="appt-page-title">
                <span>🏥 @I18n.T("Patient Ward & Cabin Admission")</span>
            </h1>
            <span class="appt-count-pill" title="@I18n.T("Total historical admissions")">
                @totalAdmissionCount @I18n.T("Total")
            </span>
            <span class="appt-count-pill" style="background:#ecfdf5; color:#047857; border-color:#a7f3d0;" title="@I18n.T("Currently admitted patients in ward/cabin")">
                🛏️ @activeAdmissionCount @I18n.T("Admitted")
            </span>
            <span class="appt-count-pill" style="background:#eff6ff; color:#1d4ed8; border-color:#bfdbfe;" title="@I18n.T("Discharged patients")">
                🏁 @dischargedAdmissionCount @I18n.T("Discharged")
            </span>
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <span class="appt-inline-alert @messageClass" title="@message">
                    @(messageClass == "success" ? "✓" : "⚠") @message
                </span>
            }
        </div>

        <div class="appt-top-actions">
            <!-- Print Format Toggle -->
            <div class="tickets-print-mode-group" title="@I18n.T("Select printer slip format")">
                <button type="button" class="tickets-mode-pill @(isThermalMode ? "active" : "")" @onclick="() => isThermalMode = true" title="80mm Thermal POS Slip">
                    🖨️ @I18n.T("80mm POS")
                </button>
                <button type="button" class="tickets-mode-pill @(!isThermalMode ? "active" : "")" @onclick="() => isThermalMode = false" title="Standard A4 Voucher">
                    📄 @I18n.T("A4 Sheet")
                </button>
            </div>

            <!-- Quick Patient Registration Modal Button -->
            <button type="button" class="btn btn-secondary appt-btn" @onclick="OpenNewPatientModal" title="@I18n.T("Quick Patient Registration")">
                + @I18n.T("New Patient")
            </button>

            <!-- Reset / New Admission Button -->
            <button type="button" class="btn btn-secondary appt-btn" @onclick="Reset" title="@I18n.T("New Admission / Reset Form (Esc)")">
                + @I18n.T("New Admission")
            </button>
        </div>
    </div>

    <!-- Main Balanced Workspace Grid: Full Widescreen Two-Column Form Card -->
    <div class="appt-classic-workspace">
        <div class="appt-form-card tickets-wide-card">
            <!-- Card Header with Next Token & Drawer Trigger -->
            <div class="appt-card-header">
                <div class="appt-card-header-title-wrap" style="display: flex; align-items: center; gap: 10px;">
                    <h2>@(editor.ID == 0 ? I18n.T("New IPD Patient Admission") : $"{I18n.T("Edit Admission")} — {editor.RegNo}")</h2>
                    @if (editor.ID > 0)
                    {
                        <span class="appt-serial-badge @(editor.IsAdmitted == true ? "emerald" : "violet")">
                            @(editor.IsAdmitted == true ? I18n.T("ACTIVE ADMISSION") : I18n.T("DISCHARGED / BILLED"))
                        </span>
                    }
                    else
                    {
                        <span class="appt-serial-badge emerald">
                            + @I18n.T("NEW ADMISSION")
                        </span>
                    }
                </div>

                <button type="button"
                        class="appt-schedule-trigger-btn @(showScheduleDrawer ? "active" : "")"
                        @onclick="ToggleScheduleDrawer"
                        title="@I18n.T("View IPD Admissions & Bed Queue (F2 / Ctrl+Q)")">
                    <span>📋</span>
                    <span>@I18n.T("Admissions & Bed Queue")</span>
                    <span class="trigger-pill">@FilteredAdmissionsCount</span>
                    @if (activeAdmissionCount > 0)
                    {
                        <span class="trigger-pill checked" title="@I18n.T("Currently Admitted")">
                            🛏️ @activeAdmissionCount
                        </span>
                    }
                </button>
            </div>

            <!-- Lock Banner (for Discharged or Billed Admissions) -->
            @if (IsAdmissionLocked)
            {
                <div class="tickets-followup-banner" style="background:#fffbeb; border-color:#fde68a; border-left:4px solid #d97706; margin: 8px 14px 0 14px;">
                    <div style="display:flex; align-items:center; gap:8px;">
                        <span style="font-size:16px;">🔒</span>
                        <div>
                            <strong style="color:#92400e; font-size:12px;">@I18n.T("Finalized Admission — Read-Only")</strong>
                            <div style="color:#b45309; font-size:11px;">@I18n.T("Discharged or billed admission details cannot be modified. Reprinting slip and wristband remains available.")</div>
                        </div>
                    </div>
                </div>
            }

            <!-- Duplicate Active Admission Warning Banner -->
            @if (activeAdmissionConflict != null)
            {
                <div class="tickets-followup-banner" style="background:#fef2f2; border-color:#fecaca; border-left:4px solid #dc2626; margin: 8px 14px 0 14px;">
                    <div style="display:flex; align-items:center; gap:8px; min-width:0;">
                        <span style="font-size:18px;">🚫</span>
                        <div style="min-width:0;">
                            <strong style="color:#991b1b; font-size:12px;">@I18n.T("DUPLICATE ACTIVE ADMISSION BLOCKED")</strong>
                            <div style="color:#b91c1c; font-size:11.5px;">
                                <strong>@patientName</strong> (@activeAdmissionConflict.PatientID) @I18n.T("is already admitted in") <strong>@BedName(activeAdmissionConflict.BedCabinID)</strong> @I18n.T("under IPD Reg #")<strong>@activeAdmissionConflict.RegNo</strong> (@activeAdmissionConflict.AdmissionDate?.ToString("dd MMM yyyy")).
                                @I18n.T("A patient cannot be admitted multiple times concurrently. Discharge or transfer the patient before admitting again.")
                            </div>
                        </div>
                    </div>
                    <div style="display:flex; gap:6px; flex-shrink:0;">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => SelectAsync(activeAdmissionConflict)">
                            👁️ @I18n.T("View Admission")
                        </button>
                        <button type="button" class="btn btn-ghost btn-sm" @onclick="ClearSelectedPatient">
                            ✕ @I18n.T("Change Patient")
                        </button>
                    </div>
                </div>
            }

            <!-- Form Content -->
            <EditForm Model="editor" OnValidSubmit="SaveAsync" @onkeydown="HandleFormKeyDown" style="display:flex; flex-direction:column; min-height:0;">
                <DataAnnotationsValidator />

                <div class="appt-form-body appt-form-twocol" style="padding: 12px 16px; gap: 18px;">
                    <!-- =========================================================================
                         Left Column: Patient Intake, Doctors, Diagnosis & Remarks
                         ========================================================================= -->
                    <div class="appt-col-left" style="gap: 10px;">
                        <!-- Patient Intake Header & Verified Card / Search Combo -->
                        <div class="appt-field-group">
                            <div class="appt-patient-header-row">
                                <span class="appt-field-label">
                                    <span>@I18n.T("Patient Information")<span class="req">*</span></span>
                                </span>
                                @if (loadedPatient == null && editor.ID == 0)
                                {
                                    <button type="button" class="btn btn-link btn-sm p-0" style="font-size:11px; text-decoration:none; font-weight:700;" @onclick="OpenNewPatientModal">
                                        + @I18n.T("Register New Patient")
                                    </button>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(editor.PatientID) && loadedPatient != null)
                            {
                                <div class="appt-patient-verified" style="display:flex; align-items:center; justify-content:space-between; background:#f0fdf4; border:1px solid #86efac; border-radius:6px; padding:6px 10px;">
                                    <div class="appt-patient-verified-info" style="font-size:11.5px; color:#1e293b; line-height:1.4;">
                                        <strong style="color:#15803d; font-size:12px;">#@loadedPatient.PatientID</strong> &bull; <b style="color:#0f172a;">@loadedPatient.Name</b>
                                        @if (!string.IsNullOrWhiteSpace(loadedPatient.Sex))
                                        {
                                            <text> &bull; </text>
                                            <span class="meta-tag sex-tag-@loadedPatient.Sex.ToLowerInvariant()">
                                                @(loadedPatient.Sex == "Male" ? "♂ Male" : loadedPatient.Sex == "Female" ? "♀ Female" : loadedPatient.Sex)
                                            </span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(editor.Age))
                                        {
                                            <text> &bull; </text>
                                            <span class="pill pill-info" style="font-size:10px; padding:1px 6px;">@I18n.T("Age"): @editor.Age</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(loadedPatient.BloodGroup))
                                        {
                                            <text> &bull; </text>
                                            <span class="meta-tag" style="background:#fef2f2; color:#b91c1c; border-color:#fca5a5; font-size:10px;">🩸 @loadedPatient.BloodGroup</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(loadedPatient.Contact))
                                        {
                                            <text> &bull; 📞 @loadedPatient.Contact</text>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(loadedPatient.PresentVillage))
                                        {
                                            <div style="font-size:10.5px; color:#64748b; margin-top:2px;">
                                                📍 @loadedPatient.PresentVillage @(!string.IsNullOrWhiteSpace(loadedPatient.FatherName) ? $"• Guardian: {loadedPatient.FatherName}" : "")
                                            </div>
                                        }
                                    </div>
                                    @if (editor.ID == 0)
                                    {
                                        <button type="button" class="appt-clear-link" @onclick="ClearSelectedPatient" title="@I18n.T("Search different patient")" style="font-size:11px; font-weight:700; color:#0284c7; background:none; border:none; cursor:pointer; padding:4px 8px;">
                                            @I18n.T("Change")
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="appt-patient-search-field">
                                    <div class="appt-patient-search-combo" style="position:relative;">
                                        <input class="classic-input"
                                               value="@patientSearchText"
                                               @oninput="HandlePatientSearchInputAsync"
                                               @onfocus="ShowPatientSuggestionsAsync"
                                               @onkeydown="HandlePatientSearchKeyDownAsync"
                                               disabled="@(editor.ID > 0 || IsAdmissionLocked)"
                                               autocomplete="off"
                                               placeholder="@I18n.T("Search Patient ID, mobile or name...")"
                                               title="@I18n.T("Search Patient ID, mobile or name & press Enter")" />
                                        <button type="button" class="btn-find" @onclick="LoadPatientAsync" disabled="@(editor.ID > 0 || IsAdmissionLocked)">
                                            <SearchIcon />
                                            <span>@I18n.T("Load")</span>
                                        </button>

                                        @if (showPatientSuggestions && editor.ID == 0)
                                        {
                                            <div class="appt-dropdown-backdrop" style="position:fixed; inset:0; z-index:110;" @onclick="HidePatientSuggestions"></div>
                                            <div class="appt-patient-suggestions" id="appt-patient-suggestions-list" style="position:absolute; top:calc(100% + 3px); left:0; width:100%; max-width:480px; max-height:280px; overflow-y:auto; z-index:125; background:#ffffff; border:1px solid #cbd5e1; border-radius:6px; box-shadow:0 8px 24px rgba(15,23,42,0.15);">
                                                @foreach (var patient in patientSuggestions)
                                                {
                                                    <button type="button" class="appt-patient-clean-option" @onmousedown:preventDefault @onclick="() => SelectPatientAsync(patient)">
                                                        <span class="patient-id">#@patient.PatientID</span>
                                                        <span class="patient-name" title="@patient.Name">@patient.Name</span>
                                                        <span class="patient-phone">@(string.IsNullOrWhiteSpace(patient.Contact) ? "—" : patient.Contact)</span>
                                                        @if (!string.IsNullOrWhiteSpace(patient.Sex))
                                                        {
                                                            <span class="meta-tag sex-tag-@patient.Sex.ToLowerInvariant()">
                                                                @(patient.Sex == "Male" ? "♂ Male" : patient.Sex == "Female" ? "♀ Female" : patient.Sex)
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span></span>
                                                        }
                                                    </button>
                                                }
                                                @if (patientSuggestions.Count == 0)
                                                {
                                                    <div class="appt-doctor-empty" style="padding:10px; font-size:11.5px; color:#64748b; text-align:center;">
                                                        @I18n.T("No registered patient found")
                                                    </div>
                                                }
                                                else if (hasMorePatientSuggestions)
                                                {
                                                    <div class="appt-doctor-scroll-hint"
                                                         style="padding:6px 10px; text-align:center; background:#f8fafc; border-top:1px solid #e2e8f0; font-size:10.5px; color:#0284c7; font-weight:600; cursor:pointer;"
                                                         @onmousedown:preventDefault
                                                         @onclick="LoadMorePatientSuggestionsAsync">
                                                        @if (isLoadingMorePatients)
                                                        {
                                                            <span>⏳ @I18n.T("Loading more...")</span>
                                                        }
                                                        else
                                                        {
                                                            <span>@I18n.T("Showing") @patientSuggestions.Count &bull; @I18n.T("Scroll for more...")</span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Consultant Doctor Search with Department Filter (Exact match to Appointments.razor & Tickets.razor) -->
                        <div class="appt-field-group">
                            <span class="appt-field-label">
                                <span>@I18n.T("Consultant Doctor")<span class="req">*</span></span>
                            </span>
                            <div class="appt-doctor-search-combo-wrap" id="appt-doctor-search-box" style="position: relative; width: 100%;">
                                <div style="display: flex; gap: 6px; align-items: center;">
                                    <select class="classic-input appt-dept-filter-select"
                                            value="@selectedDoctorDepartmentId"
                                            @onchange="HandleDoctorDepartmentFilterChanged"
                                            disabled="@IsAdmissionLocked"
                                            style="flex: 0 0 145px; max-width: 155px; height: 30px; font-size: 11.5px; font-weight: 650; cursor: pointer; background-color: #f8fafc; border: 1px solid #cbd5e1; border-radius: 6px;"
                                            title="@I18n.T("Filter by Doctor Department")">
                                        <option value="0">📂 @I18n.T("All Depts")</option>
                                        @foreach (var dept in doctorDepartments.OrderBy(d => d.Value))
                                        {
                                            <option value="@dept.Key">@dept.Value</option>
                                        }
                                    </select>
                                    <div class="appt-doctor-search" style="flex: 1; min-width: 0; position: relative;">
                                        <input class="classic-input"
                                               id="appt-doctor-search-input"
                                               value="@consultantSearchText"
                                               @oninput="HandleConsultantSearchInputAsync"
                                               @onfocus="ShowConsultantSuggestions"
                                               @onkeydown="HandleConsultantSearchKeyDown"
                                               disabled="@IsAdmissionLocked"
                                               autocomplete="off"
                                               placeholder="@I18n.T("Search doctor ID, name, or specialty...")"
                                               title="@I18n.T("Search consultant doctor")" />
                                        @if (editor.Consultant.HasValue && !IsAdmissionLocked)
                                        {
                                            <button type="button" class="appt-clear-link" @onclick="ClearConsultantDoctor" title="@I18n.T("Clear consultant")">✕</button>
                                        }
                                    </div>
                                </div>

                                @if (showConsultantSuggestions && !IsAdmissionLocked)
                                {
                                    <div class="appt-dropdown-backdrop" style="position:fixed; inset:0; z-index:110;" @onclick="() => showConsultantSuggestions = false"></div>
                                    <div class="appt-doctor-suggestions" id="appt-doctor-suggestions-list" style="position: absolute; top: calc(100% + 2px); left: 0; right: 0; z-index: 120;">
                                        @if (filteredDoctorItems.Count > 0)
                                        {
                                            @foreach (var item in VisibleDoctorItems)
                                            {
                                                var doc = item.Doctor;
                                                <button type="button"
                                                        @key="doc.ID"
                                                        class="appt-doctor-clean-option @(editor.Consultant == doc.ID ? "selected" : "")"
                                                        style="width: 100%; display: grid; grid-template-columns: 55px minmax(130px, 1fr) auto; gap: 8px; align-items: center; padding: 6px 10px; border: none; border-bottom: 1px solid #f1f5f9; background: @(editor.Consultant == doc.ID ? "#eff6ff" : "#ffffff"); text-align: left; cursor: pointer; box-sizing: border-box; transition: background 0.12s ease;"
                                                        @onmousedown:preventDefault
                                                        @onclick="() => SelectConsultant(doc)">
                                                    <span style="font-size: 10.5px; font-weight: 800; color: #0284c7; background: #e0f2fe; padding: 1px 5px; border-radius: 4px; text-align: center; white-space: nowrap;">
                                                        D@(doc.ID)
                                                    </span>
                                                    <span style="font-size: 11.5px; font-weight: 650; color: #0f172a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: flex; align-items: center; gap: 4px;" title="@item.DisplayName">
                                                        @if (doc.Priority.HasValue && doc.Priority.Value > 0)
                                                        {
                                                            <span style="font-size: 9.5px; padding: 1px 4px; background: #fef3c7; color: #b45309; border-radius: 3px; font-weight: 700; flex-shrink: 0;">⭐ #@doc.Priority</span>
                                                        }
                                                        @item.DisplayName
                                                    </span>
                                                    @{
                                                        var subParts = new List<string>();
                                                        if (!string.IsNullOrWhiteSpace(item.Degree)) subParts.Add(item.Degree);
                                                        if (!string.IsNullOrWhiteSpace(item.DepartmentName)) subParts.Add(item.DepartmentName);
                                                        if (!string.IsNullOrWhiteSpace(item.Room)) subParts.Add($"Room {item.Room}");
                                                        var desigText = string.Join(" • ", subParts);
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(desigText))
                                                    {
                                                        <span style="font-size: 10.5px; color: #64748b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 170px; margin-left: auto;" title="@desigText">
                                                            @desigText
                                                        </span>
                                                    }
                                                </button>
                                            }
                                            @if (VisibleDoctorsCount < filteredDoctorItems.Count)
                                            {
                                                <div class="appt-doctor-scroll-hint"
                                                     @onmousedown:preventDefault
                                                     @onclick="LoadMoreDoctors">
                                                    @I18n.T("Showing") @VisibleDoctorsCount / @filteredDoctorItems.Count &bull; @I18n.T("Scroll for more...")
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="appt-doctor-empty">
                                                @I18n.T("No doctor found")
                                                @if (selectedDoctorDepartmentId > 0)
                                                {
                                                    <button type="button" class="btn btn-link btn-sm p-0 ms-1" style="font-size: 11px; vertical-align: baseline;" @onmousedown:preventDefault @onclick="ResetDoctorDeptFilter">(@I18n.T("Show All"))</button>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Selected Consultant Doctor Badge (Identical to OPD / Doctor Appointment) -->
                        @if (SelectedConsultant != null && editor.Consultant.HasValue)
                        {
                            <div class="selected-doctor-badge" style="background:#f0f9ff; border:1px solid #7dd3fc; padding:5px 10px; border-radius:6px; display:flex; align-items:center; justify-content:space-between; gap:10px;">
                                <div style="display:flex; align-items:center; gap:8px; min-width:0;">
                                    <div class="doctor-caduceus-avatar" style="width:26px; height:26px; border-radius:6px; background:#e0f2fe; border:1px solid #7dd3fc; display:inline-flex; align-items:center; justify-content:center; flex-shrink:0;" title="@I18n.T("Consultant Doctor")">
                                        <img src="images/caduceus.png" alt="Medical Doctor" style="width:14px; height:20px; object-fit:contain; filter: brightness(0) saturate(100%) invert(26%) sepia(88%) saturate(1540%) hue-rotate(182deg) brightness(96%) contrast(97%);" />
                                    </div>
                                    <div style="display:flex; flex-direction:column; min-width:0;">
                                        <strong style="font-size:12px; color:#0369a1; font-weight:800; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                            @DoctorDisplayName(SelectedConsultant)
                                        </strong>
                                        <small style="font-size:10.5px; color:#475569; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                            @CleanDoctorDegree(SelectedConsultant)
                                            @if (SelectedConsultant.Department.HasValue && doctorDepartments.TryGetValue(SelectedConsultant.Department.Value, out var dn))
                                            {
                                                <span> &bull; @dn</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(SelectedConsultant.Room))
                                            {
                                                <span style="font-weight:700; color:#0284c7;"> &bull; Room @SelectedConsultant.Room</span>
                                            }
                                        </small>
                                    </div>
                                </div>
                                <div style="display:flex; align-items:center; gap:6px; flex-shrink:0;">
                                    <span class="pill" style="font-size:10.5px; font-weight:700; background:#e0f2fe; color:#0369a1; border:1px solid #bae6fd;" title="@I18n.T("Currently admitted patients under this consultant")">
                                        🛏️ @ConsultantAdmittedCount @I18n.T("Admitted")
                                    </span>
                                </div>
                            </div>
                        }

                        <!-- Admitted By & Referred By Doctors (Two-column Row) -->
                        <div style="display:flex; gap:8px;">
                            <div class="appt-field-group" style="flex:1; min-width:0;">
                                <span class="appt-field-label">@I18n.T("Admitted By Doctor")</span>
                                <DoctorPicker Doctors="doctors" @bind-Value="editor.AdmittedBy" Placeholder="@I18n.T("Search admitting doctor...")" Disabled="@IsAdmissionLocked" />
                            </div>
                            <div class="appt-field-group" style="flex:1; min-width:0;">
                                <span class="appt-field-label">@I18n.T("Referred By")</span>
                                <DoctorPicker Doctors="doctors" @bind-Value="editor.ReferredBy" Placeholder="@I18n.T("Direct / referring doctor...")" Disabled="@IsAdmissionLocked" />
                            </div>
                        </div>

                        <!-- Category & Primary Diagnosis -->
                        <div style="display:flex; gap:8px;">
                            <div class="appt-field-group" style="flex:1; min-width:0; position:relative;">
                                <span class="appt-field-label">@I18n.T("Patient Category")</span>
                                <div class="tickets-type-dropdown-container">
                                    <button type="button"
                                            class="tickets-type-dropdown-trigger @(isPatientCategoryOpen ? "open" : "")"
                                            @onclick="TogglePatientCategoryDropdown"
                                            disabled="@IsAdmissionLocked"
                                            title="@I18n.T("Select patient admission category")">
                                        <div class="tickets-type-trigger-left">
                                            <span class="tickets-type-trigger-icon">@CurrentCategoryOption.Icon</span>
                                            <span class="tickets-type-trigger-name">@I18n.T(CurrentCategoryOption.Name)</span>
                                        </div>
                                        <div class="tickets-type-trigger-right">
                                            <svg class="tickets-type-trigger-arrow @(isPatientCategoryOpen ? "rotated" : "")" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="6 9 12 15 18 9"></polyline>
                                            </svg>
                                        </div>
                                    </button>

                                    @if (isPatientCategoryOpen && !IsAdmissionLocked)
                                    {
                                        <div class="tickets-type-dropdown-backdrop" @onclick="ClosePatientCategoryDropdown"></div>
                                        <div class="tickets-type-dropdown-menu" style="min-width: 250px; width: 100%;">
                                            <div class="tickets-type-menu-header">
                                                <span style="font-weight: 700; color: #1e293b; font-size: 11px;">@I18n.T("Select Patient Category")</span>
                                                <span style="font-size: 10px; color: #64748b; font-weight: 600;">@PatientCategoryOptions.Length @I18n.T("Categories")</span>
                                            </div>
                                            <div class="tickets-type-menu-list">
                                                @foreach (var opt in PatientCategoryOptions)
                                                {
                                                    var isSelected = string.Equals(editor.PatientCategory ?? "General", opt.Code, StringComparison.OrdinalIgnoreCase);
                                                    <button type="button"
                                                            class="tickets-type-menu-item @(isSelected ? "selected" : "")"
                                                            @onclick="() => SelectPatientCategory(opt.Code)">
                                                        <div class="tickets-type-item-main">
                                                            <span class="tickets-type-item-bullet" style="font-size: 13px; line-height: 1;">@opt.Icon</span>
                                                            <div class="tickets-type-item-info">
                                                                <div class="tickets-type-item-title-row">
                                                                    <span class="tickets-type-item-title">@I18n.T(opt.Name)</span>
                                                                    @if (opt.Code == "General")
                                                                    {
                                                                        <span class="tickets-type-default-badge">@I18n.T("DEFAULT")</span>
                                                                    }
                                                                    else if (opt.Code == "VIP" || opt.Code == "ICU / CCU")
                                                                    {
                                                                        <span style="font-size: 9px; font-weight: 700; color: #b45309; background: #fef3c7; border: 1px solid #fde68a; padding: 0 4px; border-radius: 3px; line-height: 1.2;">@opt.Code</span>
                                                                    }
                                                                </div>
                                                                <span class="tickets-type-item-hint">@I18n.T(opt.Hint)</span>
                                                            </div>
                                                        </div>
                                                        <div class="tickets-type-item-rate-wrap">
                                                            @if (isSelected)
                                                            {
                                                                <span class="tickets-type-item-check">✓</span>
                                                            }
                                                        </div>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="appt-field-group" style="flex:1.8; min-width:0;">
                                <span class="appt-field-label">@I18n.T("Primary Diagnosis / Reason for Admission")</span>
                                <InputText class="classic-input" @bind-Value="editor.Diagnosis" placeholder="@I18n.T("e.g. Acute appendicitis, observation, elective surgery...")" disabled="@IsAdmissionLocked" />
                            </div>
                        </div>

                        <!-- Diagnosis Quick Snippet Chips -->
                        <div class="tickets-complaint-chips" style="margin-top:-2px;">
                            <button type="button" class="complaint-chip" @onclick='() => AddDiagnosisSnippet("Acute Appendicitis")' disabled="@IsAdmissionLocked">+ Acute Appendicitis</button>
                            <button type="button" class="complaint-chip" @onclick='() => AddDiagnosisSnippet("Observation & Monitoring")' disabled="@IsAdmissionLocked">+ Observation</button>
                            <button type="button" class="complaint-chip" @onclick='() => AddDiagnosisSnippet("Normal Delivery (NVD)")' disabled="@IsAdmissionLocked">+ Normal Delivery</button>
                            <button type="button" class="complaint-chip" @onclick='() => AddDiagnosisSnippet("Elective C-Section (LUCS)")' disabled="@IsAdmissionLocked">+ C-Section</button>
                            <button type="button" class="complaint-chip" @onclick='() => AddDiagnosisSnippet("Trauma / Accident Injury")' disabled="@IsAdmissionLocked">+ Trauma/Injury</button>
                            <button type="button" class="complaint-chip" @onclick='() => AddDiagnosisSnippet("High Grade Fever / Sepsis")' disabled="@IsAdmissionLocked">+ High Fever</button>
                            <button type="button" class="complaint-chip" @onclick='() => AddDiagnosisSnippet("Post-Operative Recovery")' disabled="@IsAdmissionLocked">+ Post-Op</button>
                        </div>

                        <!-- Remarks & Special Instructions -->
                        <div class="appt-field-group">
                            <span class="appt-field-label">@I18n.T("Instructions & Remarks")</span>
                            <InputText class="classic-input" @bind-Value="editor.Comments" placeholder="@I18n.T("Guardian contact phone, special diet, allergy, or nursing instructions...")" disabled="@IsAdmissionLocked" />
                        </div>
                    </div>

                    <!-- =========================================================================
                         Right Column: Bed Allocation, Dates, Charges & Financial Summary
                         ========================================================================= -->
                    <div class="appt-col-right" style="gap: 10px;">
                        <!-- Ward / IPD Department & Bed Allocation -->
                        <div class="appt-field-group" style="position:relative;">
                            <div style="display:flex; justify-content:space-between; align-items:center;">
                                <span class="appt-field-label">
                                    <span>@I18n.T("IPD Department / Ward")<span class="req">*</span></span>
                                </span>
                                @if (editor.ID > 0)
                                {
                                    <span class="pill" style="font-size:10px; background:#f1f5f9; color:#475569; border:1px solid #cbd5e1;">🔒 @I18n.T("Reg #"): @editor.RegNo</span>
                                }
                            </div>
                            <div class="tickets-type-dropdown-container">
                                <button type="button"
                                        class="tickets-type-dropdown-trigger @(isDepartmentDropdownOpen ? "open" : "")"
                                        @onclick="ToggleDepartmentDropdown"
                                        disabled="@(IsAdmissionLocked || editor.ID > 0)"
                                        title="@I18n.T("Select IPD Department / Ward")"
                                        style="width: 100%; height: 30px; font-size: 11.5px; border-radius: 6px;">
                                    <div class="tickets-type-trigger-left" style="display:flex; align-items:center; gap:6px; min-width:0;">
                                        <span class="tickets-type-trigger-icon">🏥</span>
                                        <span class="tickets-type-trigger-name" style="@(editor.Department.HasValue ? "font-weight:700; color:#0f172a;" : "font-weight:500; color:#64748b;")">
                                            @(editor.Department.HasValue ? DepartmentName(editor.Department) : $"-- {I18n.T("Select IPD Department / Ward")} --")
                                        </span>
                                    </div>
                                    <div class="tickets-type-trigger-right">
                                        @if (editor.Department.HasValue && !IsAdmissionLocked && editor.ID == 0)
                                        {
                                            <span role="button" class="appt-clear-link" @onclick="ClearDepartment" @onclick:stopPropagation="true" title="@I18n.T("Clear department")" style="font-size:12px; margin-right:2px; color:#94a3b8; cursor:pointer;">✕</span>
                                        }
                                        <svg class="tickets-type-trigger-arrow @(isDepartmentDropdownOpen ? "rotated" : "")" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="6 9 12 15 18 9"></polyline>
                                        </svg>
                                    </div>
                                </button>

                                @if (isDepartmentDropdownOpen && !IsAdmissionLocked && editor.ID == 0)
                                {
                                    <div class="tickets-type-dropdown-backdrop" @onclick="CloseDepartmentDropdown"></div>
                                    <div class="tickets-type-dropdown-menu" style="min-width: 260px; width: 100%;">
                                        <div class="tickets-type-menu-header">
                                            <span style="font-weight: 700; color: #1e293b; font-size: 11px;">@I18n.T("Select IPD Department / Ward")</span>
                                            <span style="font-size: 10px; color: #64748b; font-weight: 600;">@departments.Count @I18n.T("Departments")</span>
                                        </div>
                                        <div class="tickets-type-menu-list" style="max-height: 240px; overflow-y: auto;">
                                            <button type="button"
                                                    class="tickets-type-menu-item @(!editor.Department.HasValue ? "selected" : "")"
                                                    @onclick="() => SelectDepartment(null)">
                                                <div class="tickets-type-item-main">
                                                    <span class="tickets-type-item-bullet">🌐</span>
                                                    <div class="tickets-type-item-info">
                                                        <span class="tickets-type-item-title" style="color: @(!editor.Department.HasValue ? "#0369a1" : "#475569");">
                                                            -- @I18n.T("All / Any Department") --
                                                        </span>
                                                        <span class="tickets-type-item-hint">@I18n.T("Show beds across all wards")</span>
                                                    </div>
                                                </div>
                                                <div class="tickets-type-item-rate-wrap">
                                                    @if (!editor.Department.HasValue)
                                                    {
                                                        <span class="tickets-type-item-check">✓</span>
                                                    }
                                                </div>
                                            </button>

                                            @foreach (var dept in departments)
                                            {
                                                var isSelected = editor.Department == dept.ID;
                                                var deptBedCount = beds.Count(b => categories.Any(c => c.ID == b.CategoryID && c.IpdDepartmentID == dept.ID));
                                                var deptAvailCount = beds.Count(b => IsBedFree(b) && categories.Any(c => c.ID == b.CategoryID && c.IpdDepartmentID == dept.ID));
                                                <button type="button"
                                                        class="tickets-type-menu-item @(isSelected ? "selected" : "")"
                                                        @onclick="() => SelectDepartment(dept.ID)">
                                                    <div class="tickets-type-item-main">
                                                        <span class="tickets-type-item-bullet">🏥</span>
                                                        <div class="tickets-type-item-info">
                                                            <div class="tickets-type-item-title-row">
                                                                <span class="tickets-type-item-title" style="color: @(isSelected ? "#0369a1" : "#1e293b");">@dept.Name</span>
                                                            </div>
                                                            <span class="tickets-type-item-hint">
                                                                @deptAvailCount @I18n.T("Available") &bull; @deptBedCount @I18n.T("Total Beds")
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <div class="tickets-type-item-rate-wrap">
                                                        @if (deptAvailCount > 0)
                                                        {
                                                            <span class="pill" style="font-size: 9.5px; background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; padding: 1px 5px;">
                                                                @deptAvailCount @I18n.T("free")
                                                            </span>
                                                        }
                                                        @if (isSelected)
                                                        {
                                                            <span class="tickets-type-item-check">✓</span>
                                                        }
                                                    </div>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Bed / Cabin Allocation with Protection & Availability Indication -->
                        <div class="appt-field-group" style="position:relative;">
                            <div style="display:flex; justify-content:space-between; align-items:center;">
                                <span class="appt-field-label">
                                    <span>@I18n.T("Bed / Cabin Allocation")<span class="req">*</span></span>
                                </span>
                                <span style="font-size:10.5px; color:#0284c7; font-weight:700;">
                                    @AvailableBedsCount @I18n.T("Available") / @beds.Count @I18n.T("Total Beds")
                                </span>
                            </div>

                            @if (editor.ID > 0)
                            {
                                <div class="classic-input" style="background:#f8fafc; color:#1e293b; display:flex; align-items:center; justify-content:space-between; height:33px; padding:0 10px; border-radius:6px; font-weight:700;">
                                    <span>🛏️ @BedName(editor.BedCabinID) — @CategoryName(beds.FirstOrDefault(b => b.ID == editor.BedCabinID)?.CategoryID ?? 0)</span>
                                    <span class="pill" style="font-size:10px; background:#e2e8f0; color:#475569;">🔒 @I18n.T("Allocated (Locked)")</span>
                                </div>
                                <div style="display:flex; align-items:center; justify-content:space-between; margin-top:3px;">
                                    <small class="ipd-field-help" style="color:#64748b; font-size:11px;">
                                        @I18n.T("Bed changes require dedicated Patient Transfer.")
                                    </small>
                                    <a href="/ipd/bed-occupancy" class="btn btn-link btn-sm p-0" style="font-size:11px; text-decoration:none;" target="_blank">
                                        @I18n.T("Bed Occupancy View") →
                                    </a>
                                </div>
                            }
                            else
                            {
                                <div class="tickets-type-dropdown-container">
                                    <button type="button"
                                            class="tickets-type-dropdown-trigger @(isBedDropdownOpen ? "open" : "")"
                                            @onclick="ToggleBedDropdown"
                                            disabled="@IsAdmissionLocked"
                                            title="@I18n.T("Select Bed or Cabin")"
                                            style="width: 100%; height: 30px; font-size: 11.5px; border-radius: 6px;">
                                        <div class="tickets-type-trigger-left" style="display:flex; align-items:center; gap:6px; min-width:0;">
                                            <span class="tickets-type-trigger-icon">🛏️</span>
                                            @if (SelectedBed != null)
                                            {
                                                <span class="tickets-type-trigger-name" style="font-weight:700; color:#0f172a;">
                                                    @SelectedBed.Name
                                                </span>
                                                <span style="font-size:11px; color:#64748b; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                                    — @CategoryName(SelectedBed.CategoryID)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="tickets-type-trigger-name" style="font-weight:500; color:#64748b;">
                                                    -- @I18n.T("Select Bed / Cabin") --
                                                </span>
                                            }
                                        </div>
                                        <div class="tickets-type-trigger-right" style="display:flex; align-items:center; gap:6px;">
                                            @if (SelectedBed != null)
                                            {
                                                <span class="tickets-type-trigger-rate" style="font-size:10.5px; font-weight:800; color:#047857; background:#ecfdf5; border:1px solid #a7f3d0; padding:1px 6px; border-radius:4px;">
                                                    ৳@I18n.FormatCurrency(selectedBedRate)/day
                                                </span>
                                                @if (!IsAdmissionLocked)
                                                {
                                                    <span role="button" class="appt-clear-link" @onclick="ClearBed" @onclick:stopPropagation="true" title="@I18n.T("Clear bed selection")" style="font-size:12px; margin-right:2px; color:#94a3b8; cursor:pointer;">✕</span>
                                                }
                                            }
                                            <svg class="tickets-type-trigger-arrow @(isBedDropdownOpen ? "rotated" : "")" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="6 9 12 15 18 9"></polyline>
                                            </svg>
                                        </div>
                                    </button>

                                    @if (isBedDropdownOpen && !IsAdmissionLocked)
                                    {
                                        <div class="tickets-type-dropdown-backdrop" @onclick="CloseBedDropdown"></div>
                                        <div class="tickets-type-dropdown-menu" style="min-width: 440px; width: 100%; max-width: 600px; box-shadow: 0 14px 36px rgba(15,23,42,0.18); border: 1px solid #cbd5e1; border-radius: 8px;">
                                            <!-- Dropdown Header -->
                                            <div class="tickets-type-menu-header" style="padding: 8px 12px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: space-between;">
                                                <div style="display: flex; align-items: center; gap: 6px;">
                                                    <span style="font-weight: 800; color: #0f172a; font-size: 12.5px;">@I18n.T("Select Bed / Cabin Allocation")</span>
                                                    <span style="font-size: 10.5px; color: #0284c7; font-weight: 700; background: #e0f2fe; padding: 1px 7px; border-radius: 4px;">
                                                        @AvailableBedsCount @I18n.T("Available") / @beds.Count @I18n.T("Total")
                                                    </span>
                                                </div>
                                                <button type="button"
                                                        style="font-size: 11px; font-weight: 700; padding: 3px 10px; height: 26px; cursor: pointer; border-radius: 5px; border: 1px solid @(bedShowAvailableOnly ? "#0284c7" : "#cbd5e1"); background: @(bedShowAvailableOnly ? "#e0f2fe" : "#ffffff"); color: @(bedShowAvailableOnly ? "#0369a1" : "#475569"); display: inline-flex; align-items: center; gap: 4px;"
                                                        @onclick="() => bedShowAvailableOnly = !bedShowAvailableOnly">
                                                    <span>@(bedShowAvailableOnly ? "✓" : "○")</span>
                                                    <span>@I18n.T("Available Only", "শুধু ফাঁকা বেড")</span>
                                                </button>
                                            </div>

                                            <!-- Search & Department Filter Toolbar -->
                                            <div style="padding: 8px 12px; border-bottom: 1px solid #e2e8f0; background: #ffffff; display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                                                <!-- Search Input -->
                                                <div class="bed-search-box-wrap" style="position: relative; width: 100%; display: flex; align-items: center;">
                                                    <span class="bed-search-box-icon" style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: #64748b; pointer-events: none; display: flex; align-items: center; justify-content: center; line-height: 1; z-index: 2;">
                                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                            <circle cx="11" cy="11" r="8"></circle>
                                                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                                        </svg>
                                                    </span>
                                                    <input class="bed-search-box-input classic-input"
                                                           style="width: 100% !important; height: 32px !important; min-height: 32px !important; padding-left: 32px !important; padding-right: 28px !important; font-size: 12px !important; border: 1px solid #cbd5e1 !important; border-radius: 6px !important; background: #ffffff !important; color: #0f172a !important; box-sizing: border-box !important;"
                                                           type="text"
                                                           placeholder="@I18n.T("Search Bed Name...", "বেডের নাম দিয়ে খুঁজুন...")"
                                                           @bind="bedSearchQuery"
                                                           @bind:event="oninput"
                                                           autocomplete="off" />
                                                    @if (!string.IsNullOrWhiteSpace(bedSearchQuery))
                                                    {
                                                        <button type="button" class="bed-search-box-clear" style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%); z-index: 2;" @onclick='() => bedSearchQuery = ""' title="@I18n.T("Clear search")">✕</button>
                                                    }
                                                </div>

                                                <!-- Ward / Department Select -->
                                                <select class="classic-input"
                                                        style="height: 32px !important; min-height: 32px !important; font-size: 12px !important; font-weight: 600; width: 100%; border-radius: 6px !important; border: 1px solid #cbd5e1 !important;"
                                                        value="@(bedDropdownDeptFilter?.ToString() ?? "")"
                                                        @onchange="OnBedDropdownDeptChanged">
                                                    <option value="">🏢 @I18n.T("All Wards / Departments", "সকল ওয়ার্ড / বিভাগ") (@beds.Count)</option>
                                                    @foreach (var dept in departments)
                                                    {
                                                        var deptAvail = beds.Count(b => IsBedFree(b) && categories.Any(c => c.ID == b.CategoryID && c.IpdDepartmentID == dept.ID));
                                                        var deptTotal = beds.Count(b => categories.Any(c => c.ID == b.CategoryID && c.IpdDepartmentID == dept.ID));
                                                        <option value="@dept.ID">@dept.Name (@deptAvail @I18n.T("free") / @deptTotal)</option>
                                                    }
                                                </select>
                                            </div>

                                            <!-- Bed Clean List: Bed/Cabin Name - Status -->
                                            <div class="bed-clean-list">
                                                @if (!BedOptions.Any())
                                                {
                                                    <div style="padding: 28px 16px; text-align: center; color: #64748b; font-size: 12px;">
                                                        <div style="font-size: 26px; margin-bottom: 6px;">🛏️</div>
                                                        <p style="margin: 0 0 6px; font-weight: 600;">@I18n.T("No beds found matching criteria.", "কোনো বেড পাওয়া যায়নি।")</p>
                                                        <button type="button" class="btn btn-sm btn-outline-primary" style="font-size: 11px; padding: 2px 10px; margin-top: 4px;" @onclick="ResetBedDropdownFilters">
                                                            @I18n.T("Reset Filters", "ফিল্টার রিসেট করুন")
                                                        </button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    @foreach (var item in BedOptions)
                                                    {
                                                        var isFree = IsBedFree(item);
                                                        var isSelected = editor.BedCabinID == item.ID;
                                                        var cat = categories.FirstOrDefault(c => c.ID == item.CategoryID);
                                                        var rate = cat?.Rate ?? 0;
                                                        var dept = DepartmentName(cat?.IpdDepartmentID ?? editor.Department);

                                                        <button type="button"
                                                                class="bed-list-row @(isSelected ? "is-selected" : isFree ? "is-available" : "is-occupied")"
                                                                disabled="@(!isFree)"
                                                                @onclick="() => SelectBed(item.ID)">
                                                            <!-- Bed / Cabin Name & Meta -->
                                                            <div class="bed-list-name-col">
                                                                <span class="bed-list-icon">🛏️</span>
                                                                <span class="bed-list-name">@item.Name</span>
                                                                <span class="bed-list-meta">
                                                                    (@(cat?.Name ?? I18n.T("General")) &bull; @dept &bull; ৳@I18n.FormatCurrency(rate)/d)
                                                                </span>
                                                            </div>

                                                            <!-- Status Column -->
                                                            <div class="bed-list-status-col">
                                                                @if (isSelected)
                                                                {
                                                                    <span class="bed-status-pill selected">✓ @I18n.T("Selected", "বাছাইকৃত")</span>
                                                                }
                                                                else if (isFree)
                                                                {
                                                                    <span class="bed-status-pill available">🟢 @I18n.T("Available", "ফাঁকা")</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="bed-status-pill occupied">🔴 @(string.IsNullOrWhiteSpace(item.Status) ? I18n.T("Occupied", "ভর্তি") : item.Status)</span>
                                                                }
                                                            </div>
                                                        </button>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Selected Bed Information Card -->
                        @if (SelectedBed != null && editor.BedCabinID.HasValue)
                        {
                            var cat = categories.FirstOrDefault(c => c.ID == SelectedBed.CategoryID);
                            <div class="selected-doctor-badge" style="background:#f0fdf4; border:1px solid #86efac; padding:6px 10px; border-radius:6px; display:flex; align-items:center; justify-content:space-between; gap:10px;">
                                <div style="display:flex; align-items:center; gap:8px; min-width:0;">
                                    <span style="font-size:18px;">🛏️</span>
                                    <div style="display:flex; flex-direction:column; min-width:0;">
                                        <strong style="font-size:12px; color:#15803d; font-weight:800; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                            @SelectedBed.Name
                                        </strong>
                                        <small style="font-size:10.5px; color:#475569;">
                                            @(cat?.Name ?? I18n.T("General")) &bull; @DepartmentName(cat?.IpdDepartmentID ?? editor.Department)
                                        </small>
                                    </div>
                                </div>
                                <div style="display:flex; align-items:center; gap:6px; flex-shrink:0;">
                                    <span class="pill" style="font-size:11px; font-weight:800; background:#dcfce7; color:#15803d; border:1px solid #86efac;">
                                        ৳ @I18n.FormatCurrency(selectedBedRate)/day
                                    </span>
                                </div>
                            </div>
                        }

                        <!-- Admission Date & Bed Admission Time -->
                        <div class="appt-field-group">
                            <div class="appt-date-header-row">
                                <span class="appt-field-label">
                                    <span>@I18n.T("Admission Date & Time")<span class="req">*</span></span>
                                </span>
                                <div class="appt-date-chips">
                                    <button type="button" class="appt-chip" @onclick="SetAdmissionDateNow" disabled="@IsAdmissionLocked">@I18n.T("Now")</button>
                                    <button type="button" class="appt-chip" @onclick="SetAdmissionDateMorning" disabled="@IsAdmissionLocked">08:00 AM</button>
                                    <button type="button" class="appt-chip" @onclick="SetAdmissionDateEvening" disabled="@IsAdmissionLocked">06:00 PM</button>
                                </div>
                            </div>
                            <InputDate Type="InputDateType.DateTimeLocal" class="classic-input" @bind-Value="editor.AdmissionDate" disabled="@IsAdmissionLocked" />
                        </div>

                        <!-- Financial Rates & Initial Charges Breakdown (Clean Modern Box) -->
                        <div class="appt-field-group">
                            <span class="appt-field-label">
                                <span>@I18n.T("Admission Fees & Initial Charges (৳)")</span>
                            </span>

                            <div style="display:grid; grid-template-columns: repeat(2, 1fr); gap:8px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:10px 12px;">
                                <div>
                                    <label style="font-size:10.5px; font-weight:700; color:#475569; display:block; margin-bottom:3px;">
                                        @I18n.T("Admission Fee (৳)")
                                    </label>
                                    <InputNumber class="classic-input" @bind-Value="editor.AdmissionFee" min="0" disabled="@IsAdmissionLocked" />
                                </div>

                                <div>
                                    <label style="font-size:10.5px; font-weight:700; color:#475569; display:block; margin-bottom:3px;">
                                        @I18n.T("Bed Rate (৳/day)")
                                    </label>
                                    <input class="classic-input" value="৳ @I18n.FormatCurrency(selectedBedRate)" disabled style="background:#f1f5f9; font-weight:800; color:#0284c7;" />
                                </div>

                                <div>
                                    <label style="font-size:10.5px; font-weight:700; color:#475569; display:block; margin-bottom:3px;" title="@I18n.T("One-time admission administrative & nursing service charge")">
                                        @I18n.T("Admission Service Fee (৳)")
                                    </label>
                                    <InputNumber class="classic-input" @bind-Value="serviceCharge" min="0" disabled="@IsAdmissionLocked" />
                                </div>

                                <div>
                                    <label style="font-size:10.5px; font-weight:700; color:#475569; display:block; margin-bottom:3px;">
                                        @I18n.T("Food Charge (৳)")
                                    </label>
                                    <InputNumber class="classic-input" @bind-Value="foodCharge" min="0" disabled="@IsAdmissionLocked" />
                                </div>

                                <div>
                                    <label style="font-size:10.5px; font-weight:700; color:#475569; display:block; margin-bottom:3px;">
                                        @I18n.T("Ambulance Charge (৳)")
                                    </label>
                                    <InputNumber class="classic-input" @bind-Value="editor.AmbulanceFee" min="0" disabled="@IsAdmissionLocked" />
                                </div>

                                <div style="display:flex; align-items:center; padding-top:16px;">
                                    <label class="inline-check" style="cursor:pointer; user-select:none; display:flex; align-items:center; gap:6px;">
                                        <InputCheckbox @bind-Value="isPackage" disabled="@IsAdmissionLocked" style="width:16px; height:16px; cursor:pointer;" />
                                        <span style="font-size: 11.5px; font-weight: 700; color:#1e293b;">@I18n.T("Package Bundle")</span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Initial Admission Charges Total Summary Card -->
                        <div class="selected-doctor-badge" style="background:#f0fdf4; border:1px solid #86efac; padding:8px 12px; border-radius:6px; display:flex; align-items:center; justify-content:space-between; gap:10px;">
                            <div style="display:flex; flex-direction:column;">
                                <strong style="font-size:11px; color:#166534; text-transform:uppercase; letter-spacing:0.3px;">
                                    @I18n.T("Initial Admission Charges Total")
                                </strong>
                                <small style="font-size:10px; color:#475569;">
                                    @I18n.T("Admission Fee + Service Fee + Food + Ambulance")
                                </small>
                            </div>
                            <div style="text-align:right;">
                                <span style="font-size:16px; font-weight:900; color:#15803d;">
                                    ৳ @TotalInitialCharges.ToString("N0")
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Sticky Footer Actions (Positioned identically to Doctor Appointments & OPD) -->
                <div class="appt-form-footer" style="display: flex !important; align-items: center !important; justify-content: space-between !important; padding: 9px 16px !important; background: #f8fafc !important; border-top: 1px solid #e2e8f0 !important; gap: 10px !important; flex-shrink: 0 !important;">
                    <div class="appt-footer-left-info" style="display: flex !important; align-items: center !important; gap: 8px !important; min-width: 0 !important;">
                        @if (IsAdmissionLocked)
                        {
                            <span class="pill" style="background:#f1f5f9; color:#475569; border:1px solid #cbd5e1; font-weight:700; padding:5px 10px; font-size:11.5px;">
                                🔒 @I18n.T("Read-Only (Discharged / Billed)")
                            </span>
                        }
                        else if (editor.ID > 0 && editor.IsAdmitted == true)
                        {
                            <!-- Safe Delete (Only if not locked and dependency checked) -->
                            <button class="btn btn-ghost appt-btn" type="button" @onclick="DeleteAsync" style="color: #dc2626;" title="@I18n.T("Delete Admission (Requires zero financial/service history)")">
                                🗑️ @I18n.T("Delete")
                            </button>
                        }
                    </div>

                    <div class="appt-footer-right-actions" style="margin-left: auto !important; display: flex !important; align-items: center !important; gap: 8px !important;">
                        <button class="btn btn-ghost appt-btn" type="button" @onclick="Reset" title="@I18n.T("Clear Form")">
                            @I18n.T("Clear / New")
                        </button>

                        @if (editor.ID > 0)
                        {
                            @if (editor.IsAdmitted == true && (editor.BillNo ?? 0) == 0)
                            {
                                <button class="btn btn-secondary appt-btn" type="button" @onclick="OpenMoneyReceipt" title="@I18n.T("Collect Advance Money Receipt")">
                                    💰 @I18n.T("Money Receipt")
                                </button>
                                <button class="btn btn-secondary appt-btn" type="button" @onclick="OpenPatientServices" title="@I18n.T("Add Patient Investigation or Clinical Service")">
                                    🩺 @I18n.T("Add Service")
                                </button>
                            }

                            <!-- Slip Print -->
                            <button class="btn btn-secondary appt-btn" type="button" @onclick="PrintActiveSlipAsync" title="@I18n.T("Print Admission Slip")">
                                🖨️ @(isThermalMode ? I18n.T("POS Slip") : I18n.T("A4 Slip"))
                            </button>

                            <!-- Wristband Print -->
                            <button class="btn btn-secondary appt-btn" type="button" @onclick="PrintActiveWristbandAsync" title="@I18n.T("Print Patient Identification Wristband")">
                                🏷️ @I18n.T("Wristband")
                            </button>
                        }

                        @if (!IsAdmissionLocked)
                        {
                            <button class="btn btn-primary appt-btn appt-book-btn" type="submit" disabled="@(saving || activeAdmissionConflict != null || string.IsNullOrWhiteSpace(editor.PatientID) || editor.BedCabinID is null || editor.Consultant is null)" title="@I18n.T("Admit patient and allocate bed (Ctrl+Enter / F9)")">
                                @if (saving)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="width:12px; height:12px; margin-right:4px;"></span>
                                    <span>@(editor.ID == 0 ? I18n.T("Admitting...") : I18n.T("Saving..."))</span>
                                }
                                else
                                {
                                    <span>@(editor.ID == 0 ? "✓ " + I18n.T("Admit & Allocate Bed") : "✓ " + I18n.T("Update Admission"))</span>
                                }
                            </button>
                        }
                    </div>
                </div>
            </EditForm>
        </div>
    </div>

    <!-- =========================================================================
         Actionable Daily Admissions & Bed Queue Slide-Over Drawer
         ========================================================================= -->
    <div class="appt-drawer-backdrop @(showScheduleDrawer ? "show" : "")" @onclick="CloseScheduleDrawer"></div>
    <aside class="appt-drawer-panel @(showScheduleDrawer ? "show" : "")" aria-label="@I18n.T("Daily Admissions & Bed Queue")">
        <div class="appt-drawer-header">
            <div class="appt-drawer-title-wrap">
                <span style="font-size:16px;">📋</span>
                <h3 class="appt-drawer-title">
                    @I18n.T("IPD Admissions & Bed Occupancy")
                </h3>
            </div>
            <div style="display:flex; align-items:center; gap:8px;">
                <span style="font-size:11.5px; font-weight:700; color:#475569;">
                    📅 @DateTime.Today.ToString("dd MMM yyyy")
                </span>
                <button type="button" class="appt-drawer-close" @onclick="CloseScheduleDrawer" title="@I18n.T("Close Drawer (Esc)")" aria-label="@I18n.T("Close")">✕</button>
            </div>
        </div>

        <div class="appt-drawer-body">
            <div class="appt-queue-card" style="border:none; border-radius:0; box-shadow:none; height:100%;">
                <div class="appt-queue-top">
                    <div class="appt-queue-title-wrap">
                        <h2>@I18n.T("Admissions Queue")</h2>
                        <span class="appt-date-sub">(@FilteredAdmissionsCount @I18n.T("records"))</span>
                    </div>

                    <!-- Department / Ward Filter in Drawer -->
                    <select class="classic-input appt-dept-filter-select"
                            value="@drawerDepartmentFilter"
                            @onchange="HandleDrawerDepartmentFilterChanged"
                            style="width: 145px; height: 28px; font-size: 11px; font-weight: 650; cursor: pointer; background-color: #ffffff; border: 1px solid #cbd5e1; border-radius: 4px;"
                            title="@I18n.T("Filter queue by IPD Ward/Department")">
                        <option value="0">📂 @I18n.T("All Wards / Depts")</option>
                        @foreach (var dept in departments.OrderBy(d => d.Name))
                        {
                            <option value="@dept.ID">@dept.Name</option>
                        }
                    </select>
                </div>

                <!-- Status Filter Strip: Active, Discharged, All -->
                <div class="appt-queue-filter-strip">
                    <div class="appt-status-chips">
                        <button type="button" class="status-chip checkedin @(admissionStatusFilter == "Active" ? "active" : "")" @onclick='() => SetAdmissionStatusFilter("Active")'>
                            🛏️ @I18n.T("Active") (@activeAdmissionCount)
                        </button>
                        <button type="button" class="status-chip booked @(admissionStatusFilter == "Discharged" ? "active" : "")" @onclick='() => SetAdmissionStatusFilter("Discharged")'>
                            🏁 @I18n.T("Discharged") (@dischargedAdmissionCount)
                        </button>
                        <button type="button" class="status-chip @(admissionStatusFilter == "All" ? "active" : "")" @onclick='() => SetAdmissionStatusFilter("All")'>
                            👥 @I18n.T("All") (@totalAdmissionCount)
                        </button>
                    </div>

                    <span style="font-size:11px; font-weight:700; color:#64748b;">
                        @FilteredAdmissionsCount @I18n.T("Listed")
                    </span>
                </div>

                <!-- Barcode & QR Scanner Search Bar -->
                <div class="appt-scanner-bar">
                    <div class="appt-scanner-input-wrap">
                        <span class="appt-scanner-icon">📷</span>
                        <input type="text"
                               class="classic-input appt-scanner-input"
                               placeholder="@I18n.T("Scan barcode / QR or search IPD Reg #, Patient ID, Name, Bed...")"
                               @bind="ipdScanQuery"
                               @bind:event="oninput"
                               @onkeydown="HandleIpdScanKeyDown" />
                        @if (!string.IsNullOrWhiteSpace(ipdScanQuery))
                        {
                            <button type="button" class="appt-scanner-clear" @onclick="ClearIpdScan" title="Clear">✕</button>
                        }
                    </div>
                </div>

                <!-- Scrollable Admissions Queue List -->
                <div class="appt-queue-list">
                    @if (!FilteredAdmissions.Any())
                    {
                        <div class="tickets-queue-empty">
                            <span style="font-size: 2rem;">🏥</span>
                            <span>@I18n.T("No matching admission records found.")</span>
                        </div>
                    }
                    @foreach (var item in FilteredAdmissions)
                    {
                        <div class="tickets-queue-item @(editor.ID == item.ID ? "active" : "")" @onclick="() => SelectAndCloseDrawerAsync(item)">
                            <span class="tickets-queue-serial" style="min-width: 82px; font-size: 11px; font-weight:800; color:#0284c7;">
                                @item.RegNo
                            </span>
                            <div class="tickets-queue-info">
                                <span class="tickets-queue-name">
                                    @PatientName(item.PatientID)
                                    <small class="tickets-queue-reg">(@item.PatientID)</small>
                                </span>
                                <span class="tickets-queue-meta">
                                    <b style="color:#0f172a;">🛏️ @BedName(item.BedCabinID)</b> &bull; @item.AdmissionDate?.ToString("dd MMM yyyy hh:mm tt")
                                </span>
                                <span class="tickets-queue-meta" style="font-size:10.5px; color:#64748b;">
                                    🩺 @DoctorName(item.Consultant)
                                </span>
                            </div>
                            <div class="tickets-queue-badges">
                                <span class="pill @(item.IsAdmitted == true ? "pill-success" : "pill-info")" style="font-size: 10px; padding: 2px 6px;">
                                    @(item.IsAdmitted == true ? I18n.T("Admitted") : I18n.T("Discharged"))
                                </span>
                            </div>
                            <div class="tickets-queue-actions" @onclick:stopPropagation>
                                <button class="icon-btn" @onclick="() => SelectAndCloseDrawerAsync(item)" title="@I18n.T("Select / View Details")">✏️</button>
                                <button class="icon-btn" @onclick="() => SafePrintSlipFromQueueAsync(item)" title="@I18n.T("Print Slip")">🖨️</button>
                                <button class="icon-btn" @onclick="() => SafePrintWristbandFromQueueAsync(item)" title="@I18n.T("Print Wristband")">🏷️</button>
                            </div>
                        </div>
                    }

                    @if (hasMoreAdmissions)
                    {
                        <button type="button" class="ipd-load-more-records" @onclick="LoadMoreAdmissionsAsync" style="width:100%; padding:8px; border:1px dashed #cbd5e1; background:#f8fafc; border-radius:6px; font-size:11.5px; font-weight:700; color:#0284c7; cursor:pointer; margin-top:8px;">
                            @I18n.T("Load more admissions...")
                        </button>
                    }
                </div>
            </div>
        </div>
    </aside>

    <!-- =========================================================================
         Quick Patient Registration Modal (Exact match to Tickets & Appointments)
         ========================================================================= -->
    @if (showNewPatientModal)
    {
        <div class="quick-patient-modal-backdrop" @onclick="CloseNewPatientModal">
            <div class="quick-patient-modal-dialog" @onclick:stopPropagation>
                <div class="quick-patient-modal-header">
                    <h3>👤 @I18n.T("Quick Patient Registration")</h3>
                    <button type="button" class="appt-drawer-close" @onclick="CloseNewPatientModal">✕</button>
                </div>

                <div class="quick-patient-modal-body">
                    @if (!string.IsNullOrWhiteSpace(newPatientError))
                    {
                        <div class="appt-inline-alert danger" style="margin-bottom:8px;">@newPatientError</div>
                    }

                    <!-- Patient Name -->
                    <div class="appt-field-group">
                        <span class="appt-field-label"><span>@I18n.T("Patient Name")<span class="req">*</span></span></span>
                        <input type="text" class="classic-input" @bind="newPatientModel.Name" placeholder="@I18n.T("Full patient name...")" autofocus />
                    </div>

                    <!-- Contact & Age -->
                    <div style="display:flex; gap:8px;">
                        <div class="appt-field-group" style="flex:1.2; min-width:0;">
                            <span class="appt-field-label">@I18n.T("Mobile No")</span>
                            <input type="text" class="classic-input" @bind="newPatientModel.Contact" placeholder="017xxxxxxxx" />
                        </div>
                        <div class="appt-field-group" style="flex:1; min-width:0;">
                            <span class="appt-field-label">@I18n.T("Age (Years)")</span>
                            <div class="appt-unit-input-box">
                                <input type="number" class="classic-input appt-unit-input" @bind="newPatientAge" placeholder="30" />
                                <span class="appt-unit-addon">Yrs</span>
                            </div>
                        </div>
                    </div>

                    <!-- Sex Selection -->
                    <div class="appt-field-group">
                        <span class="appt-field-label">@I18n.T("Sex")</span>
                        <div class="sex-btn-group" role="radiogroup">
                            <button type="button" class="sex-btn sex-btn-male @(newPatientModel.Sex == "Male" ? "is-selected" : "")" @onclick='() => newPatientModel.Sex = "Male"'>
                                <span class="sex-text">♂ @I18n.T("Male")</span>
                            </button>
                            <button type="button" class="sex-btn sex-btn-female @(newPatientModel.Sex == "Female" ? "is-selected" : "")" @onclick='() => newPatientModel.Sex = "Female"'>
                                <span class="sex-text">♀ @I18n.T("Female")</span>
                            </button>
                            <button type="button" class="sex-btn sex-btn-other @(newPatientModel.Sex == "Other" ? "is-selected" : "")" @onclick='() => newPatientModel.Sex = "Other"'>
                                <span class="sex-text">⚥ @I18n.T("Other")</span>
                            </button>
                        </div>
                    </div>

                    <!-- Weight & Blood Group -->
                    <div style="display:flex; gap:8px;">
                        <div class="appt-field-group" style="flex:1; min-width:0;">
                            <span class="appt-field-label">@I18n.T("Weight (kg)")</span>
                            <div class="appt-unit-input-box">
                                <input type="text" class="classic-input appt-unit-input" @bind="newPatientModel.Weight" placeholder="e.g. 65" />
                                <span class="appt-unit-addon">kg</span>
                            </div>
                        </div>
                        <div class="appt-field-group" style="flex:1; min-width:0;">
                            <span class="appt-field-label">@I18n.T("Blood Group")</span>
                            <select class="classic-input appt-select" @bind="newPatientModel.BloodGroup">
                                <option value="">-- @I18n.T("Select") --</option>
                                <option value="A+">A+</option>
                                <option value="A-">A-</option>
                                <option value="B+">B+</option>
                                <option value="B-">B-</option>
                                <option value="O+">O+</option>
                                <option value="O-">O-</option>
                                <option value="AB+">AB+</option>
                                <option value="AB-">AB-</option>
                            </select>
                        </div>
                    </div>

                    <!-- Guardian & Address -->
                    <div style="display:flex; gap:8px;">
                        <div class="appt-field-group" style="flex:1; min-width:0;">
                            <span class="appt-field-label">@I18n.T("Guardian Name")</span>
                            <input type="text" class="classic-input" @bind="newPatientModel.FatherName" placeholder="@I18n.T("Father / Guardian name...")" />
                        </div>
                        <div class="appt-field-group" style="flex:1; min-width:0;">
                            <span class="appt-field-label">@I18n.T("Address")</span>
                            <input type="text" class="classic-input" @bind="newPatientModel.PresentVillage" placeholder="@I18n.T("Village, Area, City...")" />
                        </div>
                    </div>
                </div>

                <div class="quick-patient-modal-footer">
                    <button type="button" class="btn btn-secondary appt-btn" @onclick="CloseNewPatientModal">@I18n.T("Cancel")</button>
                    <button type="button" class="btn btn-primary appt-btn" @onclick="SaveQuickPatientAsync" disabled="@savingNewPatient">
                        @(savingNewPatient ? I18n.T("Registering...") : "✓ " + I18n.T("Register & Select"))
                    </button>
                </div>
            </div>
        </div>
    }
</div>

