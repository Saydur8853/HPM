@page "/ipd/admissions"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.Reception + "," + RoleNames.IPDOperator)]
@rendermode InteractiveServer
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject IBarcodeQrService BarcodeQr
@implements IDisposable
@using HPM.Web.Components.Common

<PageTitle>@I18n.T("Patient Admission") | @Branding.HospitalName</PageTitle>

<div class="page-heading">
    <div>
        <span class="eyebrow">@I18n.T("IPD & Inpatient Care")</span>
        <h1>@I18n.T("Patient Ward & Cabin Admission")</h1>
        <p>@I18n.T("Inpatient admission, bed allocation and printable admission slip.")</p>
    </div>
    <button class="btn btn-secondary" @onclick="Reset">@I18n.T("+ New Admission")</button>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @messageClass">@message</div>
}

<div class="module-layout">
    <div class="panel form-panel">
        <div class="panel-heading">
            <div>
                <h2>@(editor.ID == 0 ? I18n.T("New IPD Patient Admission") : $"{I18n.T("Edit Admission")} — {editor.RegNo}")</h2>
                <p>@I18n.T("Assign bed/cabin, consultant doctor, and admission fees.")</p>
            </div>
            @if (editor.ID > 0)
            {
                <span class="badge @(editor.IsAdmitted == true ? "emerald-badge" : "red-badge")">@(editor.IsAdmitted == true ? I18n.T("ACTIVE ADMISSION") : I18n.T("DISCHARGED"))</span>
            }
            else
            {
                <span class="badge emerald-badge">@I18n.T("+ NEW ADMISSION")</span>
            }
        </div>
        <EditForm Model="editor" OnSubmit="SaveAsync">
            <div class="form-grid">
                <label>
                    <span>@I18n.T("Patient ID *")</span>
                    <span class="input-action">
                        <InputText @bind-Value="editor.PatientID" placeholder="e.g. 202600001" />
                        <button type="button" @onclick="LoadPatientAsync">@I18n.T("Load")</button>
                    </span>
                </label>
                <label>
                    <span>@I18n.T("Admission Date & Time *")</span>
                    <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="editor.AdmissionDate" />
                </label>
                <div class="span-2 patient-summary">
                    <div>
                        <b>@(string.IsNullOrWhiteSpace(patientName) ? I18n.T("No patient loaded", "No patient loaded") : patientName)</b>
                        <small style="display: block; margin-top: 2px;">@(string.IsNullOrWhiteSpace(editor.PatientID) ? I18n.T("Enter registered Patient ID", "Enter registered Patient ID") : $"{I18n.T("Patient ID")}: {editor.PatientID}")</small>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(editor.Age))
                    {
                        <span class="pill pill-info">@I18n.T("Age"): @editor.Age</span>
                    }
                </div>
                <label>
                    <span>@I18n.T("IPD Reg. Number")</span>
                    <input value="@(string.IsNullOrWhiteSpace(editor.RegNo) ? I18n.T("Generated on save (e.g. I260000001)") : editor.RegNo)" disabled />
                </label>
                <label>
                    <span>@I18n.T("IPD Department *")</span>
                    <InputSelect @bind-Value="editor.Department">
                        <option value="">@I18n.T("Select Department")</option>
                        @foreach (var item in departments)
                        {
                            <option value="@item.ID">@item.Name</option>
                        }
                    </InputSelect>
                </label>
                <label class="span-2">
                    <span>@I18n.T("Bed / Cabin Allocation *")</span>
                    <select value="@editor.BedCabinID" @onchange="BedChanged">
                        <option value="">@I18n.T("Select Available Bed / Cabin")</option>
                        @foreach (var item in BedOptions)
                        {
                            <option value="@item.ID">@item.Name — @CategoryName(item.CategoryID) (@I18n.FormatCurrency(CategoryRate(item.CategoryID))/day)</option>
                        }
                    </select>
                </label>
                <label>
                    <span>@I18n.T("Consultant Doctor")</span>
                    <InputSelect @bind-Value="editor.Consultant">
                        <option value="">@I18n.T("Select Doctor")</option>
                        @foreach (var item in doctors)
                        {
                            <option value="@item.ID">@item.Title @item.Name</option>
                        }
                    </InputSelect>
                </label>
                <label>
                    <span>@I18n.T("Admitted By Doctor")</span>
                    <InputSelect @bind-Value="editor.AdmittedBy">
                        <option value="">@I18n.T("Select Doctor")</option>
                        @foreach (var item in doctors)
                        {
                            <option value="@item.ID">@item.Title @item.Name</option>
                        }
                    </InputSelect>
                </label>
                <label>
                    <span>@I18n.T("Referred By")</span>
                    <InputSelect @bind-Value="editor.ReferredBy">
                        <option value="">@I18n.T("Not Specified / Direct")</option>
                        @foreach (var item in doctors)
                        {
                            <option value="@item.ID">@item.Title @item.Name</option>
                        }
                    </InputSelect>
                </label>
                <label>
                    <span>@I18n.T("Patient Category")</span>
                    <InputText @bind-Value="editor.PatientCategory" placeholder="@I18n.T("General / VIP / Corporate")" />
                </label>
                <label class="span-2">
                    <span>@I18n.T("Primary Diagnosis / Reason for Admission")</span>
                    <InputTextArea @bind-Value="editor.Diagnosis" placeholder="@I18n.T("e.g. Acute appendicitis, observation...")" />
                </label>
                <label>
                    <span>@I18n.T("Admission Fee (৳)")</span>
                    <InputNumber @bind-Value="editor.AdmissionFee" />
                </label>
                <label>
                    <span>@I18n.T("Daily Bed Rate (৳)")</span>
                    <input value="@I18n.FormatCurrency(selectedBedRate)" disabled />
                </label>
                <label>
                    <span>@I18n.T("Service Charge (৳)")</span>
                    <InputNumber @bind-Value="serviceCharge" />
                </label>
                <label>
                    <span>@I18n.T("Food Charge (৳)")</span>
                    <InputNumber @bind-Value="foodCharge" />
                </label>
                <label>
                    <span>@I18n.T("Ambulance Fee (৳)")</span>
                    <InputNumber @bind-Value="editor.AmbulanceFee" />
                </label>
                <label class="inline-check">
                    <InputCheckbox @bind-Value="isPackage" />
                    <span>@I18n.T("Package Patient (Fixed pricing bundle)")</span>
                </label>
                <label class="span-2">
                    <span>@I18n.T("Clinical Comments & Instructions")</span>
                    <InputTextArea @bind-Value="editor.Comments" placeholder="@I18n.T("Special care instructions, guardian phone...")" />
                </label>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" type="submit">@(editor.ID == 0 ? I18n.T("Admit Patient & Allocate Bed") : I18n.T("Update Admission Record"))</button>
                @if (editor.ID > 0)
                {
                    <button class="btn btn-secondary" type="button" @onclick="PrintAsync">@I18n.T("🖨️ Print Admission Slip")</button>
                    <button class="btn btn-secondary" type="button" @onclick="PrintWristbandAsync">🏷️ @I18n.T("Print Wristband")</button>
                    <button class="btn btn-ghost" type="button" @onclick="DeleteAsync" style="color: #dc2626;">@I18n.T("Delete")</button>
                }
                <button class="btn btn-ghost" type="button" @onclick="Reset">@I18n.T("Clear")</button>
            </div>
        </EditForm>
    </div>

    <div class="panel">
        <div class="panel-heading">
            <div>
                <h2>@I18n.T("Recent IPD Admissions")</h2>
                <p>@admissions.Count @I18n.T("transaction(s)", "recent record(s)")</p>
            </div>
            <span class="pill pill-success">@admissions.Count(x => x.IsAdmitted == true) @I18n.T("Currently Admitted")</span>
        </div>

        <div class="scanner-search-group" style="margin-bottom: 0.85rem;">
            <span class="scanner-icon" title="Barcode / QR Scanner active">📷</span>
            <input type="text"
                   class="scanner-input"
                   placeholder="@I18n.T("Scan IPD Reg # Barcode / QR or Patient ID...", "Scan IPD Reg # Barcode / QR or Patient ID...")"
                   @bind="ipdScanQuery"
                   @bind:event="oninput"
                   @onkeydown="HandleIpdScanKeyDown" />
            @if (!string.IsNullOrWhiteSpace(ipdScanQuery))
            {
                <button type="button" class="btn btn-ghost" style="padding: 0 8px; font-size: 11px;" @onclick="ClearIpdScan">✕</button>
            }
        </div>

        <div class="data-table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>@I18n.T("IPD Reg. Number", "Reg. No")</th>
                        <th>@I18n.T("Patient Name")</th>
                        <th>@I18n.T("Bed / Cabin Allocation *", "Bed / Cabin")</th>
                        <th>@I18n.T("Admission Date & Time *", "Admission Date")</th>
                        <th>@I18n.T("Status")</th>
                        <th>@I18n.T("Action / Event", "Action")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!FilteredAdmissions.Any())
                    {
                        <tr>
                            <td colspan="6">
                                <div class="empty-state small">@I18n.T("No matching records found.")</div>
                            </td>
                        </tr>
                    }
                    @foreach (var item in FilteredAdmissions)
                    {
                        <tr>
                            <td>
                                <b>@item.RegNo</b>
                                <br />
                                <small style="color: #64748b;">@item.PatientID</small>
                            </td>
                            <td><b>@PatientName(item.PatientID)</b></td>
                            <td><span class="badge teal-badge">@BedName(item.BedCabinID)</span></td>
                            <td>@item.AdmissionDate?.ToString("dd MMM yyyy hh:mm tt")</td>
                            <td>
                                <span class="pill @(item.IsAdmitted == true ? "pill-success" : "pill-info")">
                                    @(item.IsAdmitted == true ? I18n.T("Admitted") : I18n.T("Discharged"))
                                </span>
                            </td>
                            <td>
                                <button class="icon-btn" @onclick="() => SelectAsync(item)" title="@I18n.T("Edit")">@I18n.T("Edit")</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (editor.ID > 0)
{
    <div id="admission-print" class="print-sheet panel print-document">
        <PrintDocumentHeader Title="Official IPD Patient Admission Slip"
                             DocNo="@editor.RegNo"
                             DocNoLabel="IPD Reg. #"
                             BarcodeCode="@editor.RegNo"
                             QrPayload="@BarcodeQr.GenerateIpdQrPayload(editor.ID, editor.RegNo ?? "", patientName, BedName(editor.BedCabinID))" />

        <div class="print-grid">
            <div><span>@I18n.T("Patient ID")</span><b>@editor.PatientID</b></div>
            <div><span>@I18n.T("Patient Name")</span><b>@patientName</b></div>
            <div><span>@I18n.T("Age")</span>@editor.Age</div>
            <div><span>@I18n.T("IPD Department *", "IPD Department")</span><b>@DepartmentName(editor.Department)</b></div>
            <div><span>@I18n.T("Consultant Doctor")</span><b>@DoctorName(editor.Consultant)</b></div>
            <div><span>@I18n.T("Allocated Bed")</span><b style="color: #0284c7;">@BedName(editor.BedCabinID)</b></div>
            <div><span>@I18n.T("Primary Diagnosis")</span>@editor.Diagnosis</div>
            <div><span>@I18n.T("Patient Category")</span>@editor.PatientCategory</div>
        </div>
        <div class="print-total">
            <div class="grand">
                <span>@I18n.T("Admission Fee:")</span>
                <b>@I18n.FormatCurrency(editor.AdmissionFee ?? 0)</b>
            </div>
        </div>

        <PrintDocumentFooter SignTitle1="Patient / Guardian Signature"
                             SignTitle3="Admission Officer"
                             PageNumberText="Page 1 of 1" />
    </div>

    <div id="wristband-print" class="print-document wristband-slip">
        <div class="wristband-content">
            <div class="wristband-text">
                <strong>@patientName</strong>
                <span>@I18n.T("PID"): @editor.PatientID &bull; @I18n.T("IPD"): @editor.RegNo</span>
                <span>@I18n.T("Bed"): @BedName(editor.BedCabinID) &bull; @I18n.T("Age"): @editor.Age / @(loadedPatient?.Sex ?? "—") &bull; @I18n.T("BG"): @(loadedPatient?.BloodGroup ?? "—")</span>
                <span>@I18n.T("Doctor"): @DoctorName(editor.Consultant)</span>
            </div>
            <BarcodeQrView Code="@editor.RegNo" 
                           QrPayload="@BarcodeQr.GenerateWristbandQrPayload(editor.ID, editor.RegNo ?? "", patientName, $"{editor.Age} {loadedPatient?.Sex}", loadedPatient?.BloodGroup ?? "—", BedName(editor.BedCabinID), DoctorName(editor.Consultant))" 
                           Layout="side-by-side" 
                           BarHeight="26" 
                           QrPixelsPerModule="2" 
                           Compact="true" />
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "patientId")]
    public string? QueryPatientId { get; set; }

    [SupplyParameterFromQuery(Name = "bedId")]
    public int? QueryBedId { get; set; }

    private PatientAdmission editor = NewAdmission();
    private List<PatientAdmission> admissions = [];
    private List<IpdDepartment> departments = [];
    private List<DoctorsProfile> doctors = [];
    private List<BedCategory> categories = [];
    private List<BedCabin> beds = [];
    private Dictionary<string, string> patientNames = new(StringComparer.OrdinalIgnoreCase);
    private Registration? loadedPatient;
    private string ipdScanQuery = "";
    private string patientName = "";
    private decimal? serviceCharge;
    private decimal? foodCharge;
    private decimal selectedBedRate;
    private bool isPackage;
    private string message = "";
    private string messageClass = "success";

    private IEnumerable<PatientAdmission> FilteredAdmissions => string.IsNullOrWhiteSpace(ipdScanQuery)
        ? admissions
        : admissions.Where(a => (a.RegNo?.Contains(ipdScanQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)
                             || (a.PatientID?.Contains(ipdScanQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)
                             || (patientNames.TryGetValue(a.PatientID ?? "", out var name) && name.Contains(ipdScanQuery.Trim(), StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<BedCabin> BedOptions => beds.Where(x => (x.Status == BedStatuses.Available && !x.IsAllocated) || x.ID == editor.BedCabinID).OrderBy(x => x.Name);

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        await LoadAsync();
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(QueryPatientId) && editor.ID == 0)
        {
            editor.PatientID = QueryPatientId.Trim();
            await LoadPatientAsync();
        }
        if (QueryBedId.HasValue && QueryBedId.Value > 0 && editor.ID == 0)
        {
            editor.BedCabinID = QueryBedId.Value;
            var bed = beds.FirstOrDefault(x => x.ID == editor.BedCabinID);
            var category = categories.FirstOrDefault(x => x.ID == bed?.CategoryID);
            selectedBedRate = category?.Rate ?? 0;
            editor.AdmissionFee = category?.AdmissionFee ?? 0;
            serviceCharge = category?.ServiceCharge ?? 0;
            foodCharge = category?.Food ?? 0;
            if (category?.IpdDepartmentID.HasValue == true && category.IpdDepartmentID.Value > 0) editor.Department = category.IpdDepartmentID.Value;
        }
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        departments = await db.IpdDepartments.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
        doctors = await db.Doctors.AsNoTracking().Where(x => x.Name != null).OrderBy(x => x.Name).ToListAsync();
        categories = await db.BedCategories.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
        beds = await db.BedCabins.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
        admissions = await db.PatientAdmissions.AsNoTracking().OrderByDescending(x => x.ID).Take(150).ToListAsync();
        var ids = admissions.Where(x => !string.IsNullOrWhiteSpace(x.PatientID)).Select(x => x.PatientID!).Distinct().ToArray();
        patientNames = ids.Length == 0 ? new(StringComparer.OrdinalIgnoreCase) : await db.Registrations.AsNoTracking().Where(x => ids.Contains(x.PatientID)).ToDictionaryAsync(x => x.PatientID, x => x.Name, StringComparer.OrdinalIgnoreCase);
    }

    private async Task LoadPatientAsync()
    {
        if (string.IsNullOrWhiteSpace(editor.PatientID))
        {
            Fail(I18n.IsBangla ? "প্রথমে পেশেন্ট আইডি লিখুন।" : "Enter a Patient ID first.");
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        var patient = await db.Registrations.AsNoTracking().FirstOrDefaultAsync(x => x.PatientID == editor.PatientID.Trim());
        if (patient is null)
        {
            patientName = "";
            loadedPatient = null;
            Fail(I18n.IsBangla ? "নিবন্ধিত রোগী পাওয়া যায়নি।" : "Registered patient was not found.");
            return;
        }
        loadedPatient = patient;
        editor.PatientID = patient.PatientID;
        patientName = patient.Name;
        var today = DateTime.Today;
        var years = today.Year - patient.DateOfBirth.Year;
        if (patient.DateOfBirth.Date > today.AddYears(-years)) years--;
        editor.Age = $"{Math.Max(0, years)}Y";
        Success(I18n.IsBangla ? $"রোগী {patient.Name} ({patient.PatientID}) লোড করা হয়েছে।" : $"Loaded patient {patient.Name} ({patient.PatientID}).");
    }

    private void BedChanged(ChangeEventArgs args)
    {
        editor.BedCabinID = int.TryParse(args.Value?.ToString(), out var id) ? id : null;
        var bed = beds.FirstOrDefault(x => x.ID == editor.BedCabinID);
        var category = categories.FirstOrDefault(x => x.ID == bed?.CategoryID);
        selectedBedRate = category?.Rate ?? 0;
        editor.AdmissionFee = category?.AdmissionFee ?? 0;
        serviceCharge = category?.ServiceCharge ?? 0;
        foodCharge = category?.Food ?? 0;
        if (category?.IpdDepartmentID.HasValue == true && category.IpdDepartmentID.Value > 0) editor.Department = category.IpdDepartmentID.Value;
    }

    private decimal CategoryRate(int catId) => categories.FirstOrDefault(x => x.ID == catId)?.Rate ?? 0;

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(editor.PatientID) || editor.Department is null || editor.BedCabinID is null || editor.AdmissionDate is null)
        {
            Fail(I18n.IsBangla ? "পেশেন্ট আইডি, ভর্তির তারিখ, আইপিডি বিভাগ এবং বেড/কেবিন আবশ্যক।" : "Patient ID, admission date, IPD department and bed/cabin are required.");
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        await using var transaction = await db.Database.BeginTransactionAsync(System.Data.IsolationLevel.Serializable);
        try
        {
            var patient = await db.Registrations.AsNoTracking().FirstOrDefaultAsync(x => x.PatientID == editor.PatientID.Trim());
            if (patient is null) throw new InvalidOperationException(I18n.IsBangla ? "নিবন্ধিত রোগী পাওয়া যায়নি।" : "Registered patient was not found.");

            await SqlServerConcurrency.AcquireTransactionLockAsync(db, $"HPM:Bed:{editor.BedCabinID.Value}");
            var selectedBed = await db.BedCabins.FindAsync(editor.BedCabinID.Value);
            if (selectedBed is null) throw new InvalidOperationException(I18n.IsBangla ? "নির্বাচিত বেড/কেবিন পাওয়া যায়নি।" : "Selected bed/cabin was not found.");

            PatientAdmission entity;
            int? oldBedId = null;
            var isNew = editor.ID == 0;
            if (isNew)
            {
                await SqlServerConcurrency.AcquireTransactionLockAsync(db, "HPM:IPD-RegNo");
                entity = editor;
                var next = (await db.PatientAdmissions.MaxAsync(x => (long?)x.ID) ?? 0) + 1;
                if (next > 9_999_999) throw new InvalidOperationException("IPD registration number capacity has been reached.");
                entity.RegNo = $"I{DateTime.Now:yy}{next:D7}";
                entity.IsAdmitted = true;
                entity.BedAdmissionDate = entity.AdmissionDate;
                entity.TransDate = DateTime.Now;
                entity.EnteredBy = await CurrentUserIdAsync();
                db.PatientAdmissions.Add(entity);
            }
            else
            {
                entity = await db.PatientAdmissions.FirstOrDefaultAsync(x => x.ID == editor.ID)
                    ?? throw new InvalidOperationException(I18n.IsBangla ? "ভর্তি রেকর্ড পাওয়া যায়নি।" : "Admission not found.");
                oldBedId = entity.BedCabinID;
                db.Entry(entity).CurrentValues.SetValues(editor);
            }

            if ((selectedBed.IsAllocated || selectedBed.Status != BedStatuses.Available) && oldBedId != selectedBed.ID)
                throw new InvalidOperationException(I18n.IsBangla ? "নির্বাচিত বেডটি ইতিমধ্যে অন্য রোগীর জন্য বরাদ্দকৃত।" : "Selected bed/cabin is already occupied by another patient.");
            entity.IsPackage = isPackage;

            await db.SaveChangesAsync();
            if (isNew || oldBedId != selectedBed.ID)
            {
                if (oldBedId is not null)
                {
                    var oldBed = await db.BedCabins.FindAsync(oldBedId.Value);
                    if (oldBed is not null)
                    {
                        oldBed.IsAllocated = false;
                        oldBed.Status = BedStatuses.Cleaning;
                        db.BedTurnovers.Add(new BedTurnover
                        {
                            BedCabinID = oldBed.ID,
                            AdmissionID = entity.ID,
                            RegNo = entity.RegNo,
                            Status = "Cleaning",
                            RequestedAt = DateTime.Now
                        });
                    }
                    var open = await db.BedCabinTransactions.Where(x => x.RegNo == entity.RegNo && x.EndDate == null).ToListAsync();
                    foreach (var item in open) item.EndDate = DateTime.Now;
                    await db.SaveChangesAsync();
                }
                selectedBed.IsAllocated = true;
                selectedBed.Status = BedStatuses.Occupied;
                var category = categories.First(x => x.ID == selectedBed.CategoryID);
                db.BedCabinTransactions.Add(new()
                {
                    BedCabinID = selectedBed.ID,
                    RegNo = entity.RegNo,
                    PatientID = entity.PatientID,
                    Rate = category.Rate,
                    PatientTransactionID = entity.ID,
                    StartDate = entity.BedAdmissionDate ?? DateTime.Now
                });
            }
            var extension = await db.AdmissionExtensions.FirstOrDefaultAsync(x => x.RegNo == entity.RegNo);
            if (extension is null)
            {
                db.AdmissionExtensions.Add(new() { RegNo = entity.RegNo, ServiceCharge = serviceCharge, Food = foodCharge });
            }
            else
            {
                extension.ServiceCharge = serviceCharge;
                extension.Food = foodCharge;
            }
            await db.SaveChangesAsync();
            await transaction.CommitAsync();
            Success(isNew ? (I18n.IsBangla ? $"রোগী সফলভাবে ভর্তি হয়েছে। আইপিডি রেজি: {entity.RegNo}" : $"Patient admitted successfully with IPD registration {entity.RegNo}.") : (I18n.IsBangla ? "ভর্তি তথ্য সফলভাবে আপডেট হয়েছে।" : "Admission updated successfully."));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await transaction.RollbackAsync();
            Fail(I18n.IsBangla ? $"ভর্তি সংরক্ষণ করা যায়নি: {ex.GetBaseException().Message}" : $"Admission could not be saved: {ex.GetBaseException().Message}");
        }
    }

    private async Task<int> CurrentUserIdAsync()
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        var value = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (!int.TryParse(value, out var id)) throw new InvalidOperationException("The signed-in user could not be identified.");
        return id;
    }

    private async Task SelectAsync(PatientAdmission item)
    {
        editor = Clone(item);
        isPackage = editor.IsPackage == true;
        patientName = PatientName(editor.PatientID);
        await using var db = await DbFactory.CreateDbContextAsync();
        if (!string.IsNullOrWhiteSpace(editor.PatientID))
        {
            loadedPatient = await db.Registrations.AsNoTracking().FirstOrDefaultAsync(x => x.PatientID == editor.PatientID.Trim());
        }
        var extension = await db.AdmissionExtensions.AsNoTracking().FirstOrDefaultAsync(x => x.RegNo == editor.RegNo);
        serviceCharge = extension?.ServiceCharge;
        foodCharge = extension?.Food;
        var bed = beds.FirstOrDefault(x => x.ID == editor.BedCabinID);
        selectedBedRate = categories.FirstOrDefault(x => x.ID == bed?.CategoryID)?.Rate ?? 0;
        message = "";
    }

    private async Task HandleIpdScanKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(ipdScanQuery))
        {
            await ProcessIpdScanAsync(ipdScanQuery.Trim());
        }
    }

    private async Task ProcessIpdScanAsync(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return;

        // 1. Check if it is an IPD QR payload: HPM:IPD|ADM:123|REG:I260000001... or HPM:WB|ADM:...
        if (raw.StartsWith("HPM:IPD|", StringComparison.OrdinalIgnoreCase) || raw.StartsWith("HPM:WB|", StringComparison.OrdinalIgnoreCase))
        {
            var parts = raw.Split('|');
            var regPart = parts.FirstOrDefault(p => p.StartsWith("REG:", StringComparison.OrdinalIgnoreCase));
            if (regPart != null)
            {
                var regNo = regPart.Substring(4).Trim();
                await LoadAdmissionByRegOrIdAsync(regNo);
                return;
            }
            var admPart = parts.FirstOrDefault(p => p.StartsWith("ADM:", StringComparison.OrdinalIgnoreCase));
            if (admPart != null && long.TryParse(admPart.Substring(4), out var admId))
            {
                await LoadAdmissionByRegOrIdAsync(admId.ToString());
                return;
            }
        }

        // 2. Check if it is a Patient QR payload: HPM:PAT|ID:12|REG:202600001...
        if (raw.StartsWith("HPM:PAT|", StringComparison.OrdinalIgnoreCase))
        {
            var parts = raw.Split('|');
            var regPart = parts.FirstOrDefault(p => p.StartsWith("REG:", StringComparison.OrdinalIgnoreCase));
            if (regPart != null)
            {
                var regNo = regPart.Substring(4).Trim();
                editor.PatientID = regNo;
                await LoadPatientAsync();
                return;
            }
        }

        // 3. Match from current admissions list
        var matched = admissions.FirstOrDefault(a => string.Equals(a.RegNo, raw, StringComparison.OrdinalIgnoreCase)
                                                  || (a.ID.ToString() == raw));
        if (matched != null)
        {
            await SelectAsync(matched);
            Success(I18n.IsBangla ? $"ভর্তি {matched.RegNo} লোড হয়েছে।" : $"Admission {matched.RegNo} loaded from scan.");
            return;
        }

        // 4. Query DB for admission record
        await using var db = await DbFactory.CreateDbContextAsync();
        var dbAdm = await db.PatientAdmissions.AsNoTracking().FirstOrDefaultAsync(a => a.RegNo == raw || a.ID.ToString() == raw);
        if (dbAdm != null)
        {
            await SelectAsync(dbAdm);
            Success(I18n.IsBangla ? $"ভর্তি {dbAdm.RegNo} ডাটাবেজ থেকে লোড হয়েছে।" : $"Admission {dbAdm.RegNo} loaded from database.");
            return;
        }

        // 5. Treat as Patient ID for new admission
        editor.PatientID = raw;
        await LoadPatientAsync();
    }

    private async Task LoadAdmissionByRegOrIdAsync(string regOrId)
    {
        var matched = admissions.FirstOrDefault(a => string.Equals(a.RegNo, regOrId, StringComparison.OrdinalIgnoreCase) || a.ID.ToString() == regOrId);
        if (matched != null)
        {
            await SelectAsync(matched);
            Success(I18n.IsBangla ? $"ভর্তি {matched.RegNo} লোড হয়েছে।" : $"Admission {matched.RegNo} loaded from scan.");
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var dbAdm = await db.PatientAdmissions.AsNoTracking().FirstOrDefaultAsync(a => a.RegNo == regOrId || a.ID.ToString() == regOrId);
        if (dbAdm != null)
        {
            await SelectAsync(dbAdm);
            Success(I18n.IsBangla ? $"ভর্তি {dbAdm.RegNo} ডাটাবেজ থেকে লোড হয়েছে।" : $"Admission {dbAdm.RegNo} loaded from database.");
        }
        else
        {
            Fail(I18n.IsBangla ? $"ভর্তি {regOrId} পাওয়া যায়নি।" : $"Admission {regOrId} not found.");
        }
    }

    private void ClearIpdScan()
    {
        ipdScanQuery = string.Empty;
    }

    private async Task DeleteAsync()
    {
        var confirmMsg = I18n.IsBangla ? $"আপনি কি নিশ্চিত যে ভর্তি {editor.RegNo} মুছে ফেলতে চান?" : $"Delete admission {editor.RegNo}?";
        if (!await JS.InvokeAsync<bool>("hpm.confirm", confirmMsg)) return;
        if ((editor.BillNo ?? 0) > 0 || editor.IsAdmitted != true)
        {
            Fail(I18n.IsBangla ? "বিল জেনারেট হওয়া বা ছাড়পত্রপ্রাপ্ত ভর্তি মুছে ফেলা যাবে না।" : "Billed or released admission cannot be deleted.");
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        await using var transaction = await db.Database.BeginTransactionAsync();
        try
        {
            var entity = await db.PatientAdmissions.FindAsync(editor.ID);
            if (entity is null) return;
            var bed = entity.BedCabinID is null ? null : await db.BedCabins.FindAsync(entity.BedCabinID.Value);
            if (bed is not null)
            {
                bed.IsAllocated = false;
                bed.Status = BedStatuses.Available;
            }
            var extensions = await db.AdmissionExtensions.Where(x => x.RegNo == entity.RegNo).ToListAsync();
            var movements = await db.BedCabinTransactions.Where(x => x.RegNo == entity.RegNo).ToListAsync();
            db.RemoveRange(extensions);
            db.RemoveRange(movements);
            db.Remove(entity);
            await db.SaveChangesAsync();
            await transaction.CommitAsync();
            Success(I18n.IsBangla ? "ভর্তি তথ্য মুছে ফেলা হয়েছে এবং বেড মুক্ত করা হয়েছে।" : "Admission deleted and bed released.");
            ResetEditor();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await transaction.RollbackAsync();
            Fail(I18n.IsBangla ? $"ভর্তি মুছে ফেলা যায়নি: {ex.Message}" : $"Admission could not be deleted: {ex.Message}");
        }
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("hpm.printElement", "admission-print");
    private async Task PrintWristbandAsync() => await JS.InvokeVoidAsync("hpm.printElement", "wristband-print");
    private void Reset() { ResetEditor(); message = ""; }
    private void ResetEditor() { editor = NewAdmission(); patientName = ""; serviceCharge = 0; foodCharge = 0; selectedBedRate = 0; isPackage = false; }
    private static PatientAdmission NewAdmission() => new() { AdmissionDate = DateTime.Now, BedAdmissionDate = DateTime.Now, IsAdmitted = true, PatientCategory = "General", AdmissionFee = 0, AmbulanceFee = 0 };
    private static PatientAdmission Clone(PatientAdmission x) => new() { ID = x.ID, RegNo = x.RegNo, PatientID = x.PatientID, Department = x.Department, Diagnosis = x.Diagnosis, Age = x.Age, ReferredBy = x.ReferredBy, Consultant = x.Consultant, AdmittedBy = x.AdmittedBy, IsReferred = x.IsReferred, BedCabinID = x.BedCabinID, AdmissionFee = x.AdmissionFee, AdmissionDate = x.AdmissionDate, ReleaseDate = x.ReleaseDate, IsAdmitted = x.IsAdmitted, BedAdmissionDate = x.BedAdmissionDate, Comments = x.Comments, BillNo = x.BillNo, BillGeneratedBy = x.BillGeneratedBy, PromotionOfficerID = x.PromotionOfficerID, IsPackage = x.IsPackage, TransDate = x.TransDate, EnteredBy = x.EnteredBy, AmbulanceFee = x.AmbulanceFee, Outcome = x.Outcome, PatientCategory = x.PatientCategory, PatientReceivedBy = x.PatientReceivedBy, PatientReceivedDate = x.PatientReceivedDate };
    private string PatientName(string? id) => id is not null && patientNames.TryGetValue(id, out var name) ? name : (id == editor.PatientID ? patientName : "—");
    private string DepartmentName(int? id) => departments.FirstOrDefault(x => x.ID == id)?.Name ?? "—";
    private string DoctorName(int? id) { var x = doctors.FirstOrDefault(d => d.ID == id); return x is null ? "—" : $"{x.Title} {x.Name}"; }
    private string BedName(int? id) => beds.FirstOrDefault(x => x.ID == id)?.Name ?? "—";
    private string CategoryName(int id) => categories.FirstOrDefault(x => x.ID == id)?.Name ?? "—";
    private void Success(string text) { messageClass = "success"; message = text; }
    private void Fail(string text) { messageClass = "danger"; message = text; }

    public void Dispose()
    {
        I18n.OnLanguageChanged -= HandleLanguageChanged;
    }
