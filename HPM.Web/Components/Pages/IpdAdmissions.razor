    private void OpenNewPatientModal()
    {
        newPatientModel = new() { Sex = "Male" };
        newPatientAge = "30";
        newPatientError = string.Empty;
        showNewPatientModal = true;
    }

    private void CloseNewPatientModal() => showNewPatientModal = false;

    private async Task SaveQuickPatientAsync()
    {
        if (string.IsNullOrWhiteSpace(newPatientModel.Name))
        {
            newPatientError = I18n.T("Patient Name is required.");
            return;
        }

        savingNewPatient = true;
        newPatientError = string.Empty;

        try
        {
            if (int.TryParse(newPatientAge, out var ageYears) && ageYears > 0)
            {
                newPatientModel.DateOfBirth = DateTime.Today.AddYears(-ageYears);
            }

            await using var strategyDb = await DbFactory.CreateDbContextAsync();
            var strategy = strategyDb.Database.CreateExecutionStrategy();
            Registration? created = null;

            await strategy.ExecuteAsync(async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                await using var transaction = await db.Database.BeginTransactionAsync(System.Data.IsolationLevel.ReadCommitted);
                await SqlServerConcurrency.AcquireTransactionLockAsync(db, "HPM:PatientID");

                var todayPrefix = $"P{DateTime.Today:yyMMdd}";
                var maxExistingToday = await db.Registrations
                    .Where(x => x.PatientID.StartsWith(todayPrefix))
                    .OrderByDescending(x => x.PatientID)
                    .Select(x => x.PatientID)
                    .FirstOrDefaultAsync();

                var nextSeq = 1;
                if (!string.IsNullOrWhiteSpace(maxExistingToday) && maxExistingToday.Length >= 11)
                {
                    var seqPart = maxExistingToday.Substring(7);
                    if (int.TryParse(seqPart, out var parsedSeq)) nextSeq = parsedSeq + 1;
                }

                newPatientModel.PatientID = $"{todayPrefix}{nextSeq:D4}";
                newPatientModel.TransDate = DateTime.Now;
                newPatientModel.EnteredBy = await CurrentUserIdAsync();

                db.Registrations.Add(newPatientModel);
                await db.SaveChangesAsync();
                await transaction.CommitAsync();
                created = newPatientModel;
            });

            if (created != null)
            {
                loadedPatient = created;
                editor.PatientID = created.PatientID;
                patientSearchText = created.PatientID;
                patientName = created.Name;
                editor.Age = $"{newPatientAge}Y";
                PatientSelection.Select(created.PatientID);
                showNewPatientModal = false;
                activeAdmissionConflict = null;
                Success(I18n.IsBangla ? $"নতুন রোগী সফলভাবে নিবন্ধিত: {created.Name} (#{created.PatientID})" : $"Patient registered: {created.Name} (#{created.PatientID})");
            }
        }
        catch (Exception ex)
        {
            newPatientError = ex.GetBaseException().Message;
        }
        finally
        {
            savingNewPatient = false;
        }
    }

    // =========================================================================
    // Safe Isolated Printing (Prevents Race Conditions & Form Overwrites)
    // =========================================================================
    private void PreparePrintTarget(PatientAdmission adm, Registration? patient)
    {
        printTargetAdmission = adm;
        printTargetPatient = patient;
        printTargetPatientName = patient?.Name ?? PatientName(adm.PatientID);
    }

    private async Task PrintActiveSlipAsync()
    {
        if (editor.ID <= 0) return;
        PreparePrintTarget(editor, loadedPatient);
        await InvokeAsync(StateHasChanged);
        await Task.Delay(100);
        var printElementId = isThermalMode ? "admission-print-pos" : "admission-print-a4";
        await JS.InvokeVoidAsync("hpm.printElement", printElementId, $"Admission Slip {editor.RegNo}");
    }

