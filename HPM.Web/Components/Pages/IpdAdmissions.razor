                           Layout="side-by-side"
                           BarHeight="26"
                           QrPixelsPerModule="2"
                           Compact="true" />
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "patientId")]
    public string? QueryPatientId { get; set; }

    [SupplyParameterFromQuery(Name = "bedId")]
    public int? QueryBedId { get; set; }

    // Admission form editor & collections
    private PatientAdmission editor = NewAdmission();
    private List<PatientAdmission> admissions = [];
    private List<IpdDepartment> departments = [];
    private Dictionary<int, string> doctorDepartments = [];
    private List<DoctorsProfile> doctors = [];
    private List<BedCategory> categories = [];
    private List<BedCabin> beds = [];
    private Dictionary<string, string> patientNames = new(StringComparer.OrdinalIgnoreCase);
    private Registration? loadedPatient;
    private string patientName = "";
    private string patientSearchText = "";
    private List<Registration> patientSuggestions = [];
    private bool showPatientSuggestions;
    private bool hasMorePatientSuggestions;
    private const int PatientSuggestionBatchSize = 15;
    private DotNetObjectReference<IpdAdmissions>? dotNetRef;
    private bool isLoadingMorePatients;

    // Consultant Doctor search combo state (identical to Appointments & Tickets)
    private sealed record DoctorViewItem(DoctorsProfile Doctor, string DisplayName, string Degree, string DepartmentName, string Room, string SearchHaystack);
    private List<DoctorViewItem> doctorViewItems = [];
    private List<DoctorViewItem> filteredDoctorItems = [];
    private string consultantSearchText = "";
    private bool showConsultantSuggestions;
    private int selectedDoctorDepartmentId = 0;
    private int doctorVisibleCount = 15;
    private const int DoctorBatchSize = 15;
    private IEnumerable<DoctorViewItem> VisibleDoctorItems => filteredDoctorItems.Take(doctorVisibleCount);
    private int VisibleDoctorsCount => Math.Min(doctorVisibleCount, filteredDoctorItems.Count);

    // Patient Category custom dropdown state
    private sealed record CategoryOption(string Code, string Name, string Icon, string Hint);
    private static readonly CategoryOption[] PatientCategoryOptions =
    [
        new("General", "General", "👤", "Standard general ward admission"),
        new("VIP", "VIP", "⭐", "Priority & executive care"),
        new("Cabin", "Cabin", "🛏️", "Private / semi-private cabin"),
        new("Pediatric", "Pediatric", "👶", "Child & infant inpatient care"),
        new("Post-Op", "Post-Op", "🩺", "Post-surgical recovery & monitoring"),
        new("ICU / CCU", "ICU / CCU", "🚨", "Intensive critical care unit"),
        new("Day Care", "Day Care", "☀️", "Short stay / observation"),
        new("Corporate", "Corporate", "🏢", "Corporate / panel admission")
    ];
    private bool isPatientCategoryOpen;
    private void TogglePatientCategoryDropdown()
    {
        if (IsAdmissionLocked) return;
        isPatientCategoryOpen = !isPatientCategoryOpen;
    }
    private void ClosePatientCategoryDropdown() => isPatientCategoryOpen = false;
    private void SelectPatientCategory(string code)
    {
        editor.PatientCategory = code;
        isPatientCategoryOpen = false;
    }
    private CategoryOption CurrentCategoryOption
    {
        get
        {
            var cat = editor.PatientCategory;
            if (string.IsNullOrWhiteSpace(cat)) return PatientCategoryOptions[0];
            var match = PatientCategoryOptions.FirstOrDefault(c => string.Equals(c.Code, cat, StringComparison.OrdinalIgnoreCase));
            return match ?? new(cat, cat, "🏷️", "Custom category");
        }
    }

    // Department & Bed custom dropdown state
    private bool isDepartmentDropdownOpen;
    private bool isBedDropdownOpen;
    private string bedSearchQuery = "";

    private void ToggleDepartmentDropdown()
    {
        if (IsAdmissionLocked || editor.ID > 0) return;
        isDepartmentDropdownOpen = !isDepartmentDropdownOpen;
        if (isDepartmentDropdownOpen)
        {
            isBedDropdownOpen = false;
            isPatientCategoryOpen = false;
        }
    }

    private void CloseDepartmentDropdown() => isDepartmentDropdownOpen = false;

    private void SelectDepartment(int? deptId)
    {
        editor.Department = deptId;
        isDepartmentDropdownOpen = false;
    }

    private void ClearDepartment()
    {
        if (IsAdmissionLocked || editor.ID > 0) return;
        editor.Department = null;
        isDepartmentDropdownOpen = false;
    }

    private int? bedDropdownDeptFilter;
    private bool bedShowAvailableOnly;

    private void ToggleBedDropdown()
    {
        if (IsAdmissionLocked || editor.ID > 0) return;
        isBedDropdownOpen = !isBedDropdownOpen;
        if (isBedDropdownOpen)
        {
            isDepartmentDropdownOpen = false;
            isPatientCategoryOpen = false;
            bedSearchQuery = "";
            bedDropdownDeptFilter = editor.Department;
        }
    }

    private void ResetBedDropdownFilters()
    {
        bedSearchQuery = "";
        bedDropdownDeptFilter = null;
        bedShowAvailableOnly = false;
    }

    private void OnBedDropdownDeptChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (int.TryParse(val, out var deptId) && deptId > 0)
        {
            bedDropdownDeptFilter = deptId;
        }
        else
        {
            bedDropdownDeptFilter = null;
        }
    }

    private void CloseBedDropdown() => isBedDropdownOpen = false;

    private void SelectBed(int? bedId)
    {
        editor.BedCabinID = bedId;
        isBedDropdownOpen = false;
        var bed = beds.FirstOrDefault(x => x.ID == editor.BedCabinID);
        var category = categories.FirstOrDefault(x => x.ID == bed?.CategoryID);
        selectedBedRate = category?.Rate ?? 0;

        if (editor.ID == 0)
        {
            if (editor.AdmissionFee == null || editor.AdmissionFee == 0) editor.AdmissionFee = category?.AdmissionFee ?? 0;
            if (serviceCharge == null || serviceCharge == 0) serviceCharge = category?.ServiceCharge ?? 0;
            if (foodCharge == null || foodCharge == 0) foodCharge = category?.Food ?? 0;
            if (category?.IpdDepartmentID.HasValue == true && category.IpdDepartmentID.Value > 0 && editor.Department == null)
            {
                editor.Department = category.IpdDepartmentID.Value;
            }
        }
    }

    private void ClearBed()
    {
        if (IsAdmissionLocked || editor.ID > 0) return;
        editor.BedCabinID = null;
        selectedBedRate = 0;
        isBedDropdownOpen = false;
    }

    // Bed, rates & charges state
    private decimal? serviceCharge;
    private decimal? foodCharge;
    private decimal selectedBedRate;
    private bool isPackage;
    private decimal TotalInitialCharges => (editor.AdmissionFee ?? 0) + (serviceCharge ?? 0) + (foodCharge ?? 0) + (editor.AmbulanceFee ?? 0);

    // Conflict & Lock guards
    private PatientAdmission? activeAdmissionConflict;
    private bool IsAdmissionLocked => editor.ID > 0 && (editor.IsAdmitted != true || (editor.BillNo ?? 0) > 0);
    private bool saving;
    private string message = "";
    private string messageClass = "success";

    // Drawer & Queue state
    private bool showScheduleDrawer;
    private string admissionStatusFilter = "Active";
    private int drawerDepartmentFilter = 0;
    private string ipdScanQuery = "";
    private int admissionLoadCount = 150;
    private bool hasMoreAdmissions;
    private int totalAdmissionCount;
    private int activeAdmissionCount;
    private int dischargedAdmissionCount;

    // Quick Patient Modal state
    private bool showNewPatientModal;
    private Registration newPatientModel = new() { Sex = "Male" };
    private string newPatientAge = "30";
    private bool savingNewPatient;
    private string newPatientError = "";

    // Print Format & Isolated Print Target State (prevents race condition)
    private bool isThermalMode = true;
    private PatientAdmission? printTargetAdmission;
    private Registration? printTargetPatient;
    private string printTargetPatientName = "";

    // Helpers
    private DoctorsProfile? SelectedConsultant => doctors.FirstOrDefault(d => d.ID == editor.Consultant);
    private int ConsultantAdmittedCount => editor.Consultant.HasValue ? admissions.Count(a => a.Consultant == editor.Consultant && a.IsAdmitted == true) : 0;
    private BedCabin? SelectedBed => beds.FirstOrDefault(b => b.ID == editor.BedCabinID);

    private bool IsBedFree(BedCabin b) =>
        (!b.IsAllocated && (string.IsNullOrWhiteSpace(b.Status) || string.Equals(b.Status, BedStatuses.Available, StringComparison.OrdinalIgnoreCase)))
        || b.ID == editor.BedCabinID;

    private int AvailableBedsCount => beds.Count(x => !x.IsAllocated && (string.IsNullOrWhiteSpace(x.Status) || string.Equals(x.Status, BedStatuses.Available, StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<BedCabin> BedOptions
    {
        get
        {
            IEnumerable<BedCabin> query = beds;
            var targetDept = bedDropdownDeptFilter ?? editor.Department;
            if (targetDept.HasValue && targetDept.Value > 0)
            {
                var catIdsInDept = categories.Where(c => c.IpdDepartmentID == targetDept.Value).Select(c => c.ID).ToHashSet();
                var deptBeds = query.Where(b => catIdsInDept.Contains(b.CategoryID)).ToList();
                if (deptBeds.Count > 0 || (editor.BedCabinID.HasValue && deptBeds.Any(b => b.ID == editor.BedCabinID.Value)))
                    query = deptBeds;
            }

            if (bedShowAvailableOnly)
            {
                query = query.Where(b => IsBedFree(b) || (editor.BedCabinID.HasValue && b.ID == editor.BedCabinID.Value));
            }

            if (!string.IsNullOrWhiteSpace(bedSearchQuery))
            {
                var q = bedSearchQuery.Trim();
                query = query.Where(b =>
                    (b.Name != null && b.Name.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                    CategoryName(b.CategoryID).Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    DepartmentName(categories.FirstOrDefault(c => c.ID == b.CategoryID)?.IpdDepartmentID ?? editor.Department).Contains(q, StringComparison.OrdinalIgnoreCase));
            }

            return query.OrderBy(x => x.Name);
        }
    }

    private record BedGroupModel(BedCategory Category, string DepartmentName, List<BedCabin> Beds, int FreeCount);

    private IEnumerable<BedGroupModel> GroupedBedOptions => BedOptions
        .GroupBy(b => b.CategoryID)
        .Select(g =>
        {
            var cat = categories.FirstOrDefault(c => c.ID == g.Key) ?? new BedCategory { ID = g.Key, Name = "General" };
            var deptName = DepartmentName(cat.IpdDepartmentID ?? editor.Department);
            var bedsList = g.OrderBy(b => b.Name).ToList();
            var freeCount = bedsList.Count(b => IsBedFree(b));
            return new BedGroupModel(cat, deptName, bedsList, freeCount);
        })
        .OrderBy(g => g.DepartmentName)
        .ThenBy(g => g.Category.Name);

    private IEnumerable<PatientAdmission> FilteredAdmissions
    {
        get
        {
            var source = admissionStatusFilter switch
            {
                "Active" => admissions.Where(x => x.IsAdmitted == true),
                "Discharged" => admissions.Where(x => x.IsAdmitted != true),
                _ => admissions.AsEnumerable()
            };

            if (drawerDepartmentFilter > 0)
            {
                source = source.Where(a => a.Department == drawerDepartmentFilter);
            }

            if (string.IsNullOrWhiteSpace(ipdScanQuery)) return source;
            var term = ipdScanQuery.Trim();
            return source.Where(a => (a.RegNo?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                                  || (a.PatientID?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                                  || (patientNames.TryGetValue(a.PatientID ?? "", out var name) && name.Contains(term, StringComparison.OrdinalIgnoreCase))
                                  || (BedName(a.BedCabinID).Contains(term, StringComparison.OrdinalIgnoreCase)));
        }
    }

    private int FilteredAdmissionsCount => FilteredAdmissions.Count();

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        await LoadAsync();
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnParametersSetAsync()
    {
        var patientId = QueryPatientId ?? PatientSelection.PatientId;
        if (!string.IsNullOrWhiteSpace(patientId) && editor.ID == 0)
        {
            editor.PatientID = patientId.Trim();
            patientSearchText = editor.PatientID;
            await LoadPatientAsync();
        }
        if (QueryBedId.HasValue && QueryBedId.Value > 0 && editor.ID == 0)
        {
            editor.BedCabinID = QueryBedId.Value;
            var bed = beds.FirstOrDefault(x => x.ID == editor.BedCabinID);
            var category = categories.FirstOrDefault(x => x.ID == bed?.CategoryID);
            selectedBedRate = category?.Rate ?? 0;
            editor.AdmissionFee = category?.AdmissionFee ?? 0;
            serviceCharge = category?.ServiceCharge ?? 0;
            foodCharge = category?.Food ?? 0;
            if (category?.IpdDepartmentID.HasValue == true && category.IpdDepartmentID.Value > 0) editor.Department = category.IpdDepartmentID.Value;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        dotNetRef ??= DotNetObjectReference.Create(this);

        if (showPatientSuggestions)
        {
            try
            {
                await JS.InvokeVoidAsync("hpm.initPatientIdScroll", "appt-patient-suggestions-list", dotNetRef, nameof(LoadMorePatientsFromJs));
            }
            catch { }
        }

        if (showConsultantSuggestions)
        {
            try
            {
                await JS.InvokeVoidAsync("hpm.initDoctorInfiniteScroll", "appt-doctor-search-box", "appt-doctor-suggestions-list", dotNetRef);
            }
            catch { }
        }
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        departments = await db.IpdDepartments.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
        doctorDepartments = await db.Departments.AsNoTracking().ToDictionaryAsync(x => x.ID, x => x.Name);
        var rawDoctors = await db.Doctors.AsNoTracking().Where(x => x.Name != null && x.IsActive).ToListAsync();
        doctors = rawDoctors
            .OrderByDescending(x => (x.Priority ?? 0) > 0)
            .ThenBy(x => x.Priority ?? int.MaxValue)
            .ThenBy(x => CleanDoctorName(x), StringComparer.OrdinalIgnoreCase)
            .ToList();
        categories = await db.BedCategories.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
        beds = await db.BedCabins.AsNoTracking().OrderBy(x => x.Name).ToListAsync();

        totalAdmissionCount = await db.PatientAdmissions.AsNoTracking().CountAsync();
        activeAdmissionCount = await db.PatientAdmissions.AsNoTracking().CountAsync(x => x.IsAdmitted == true);
        dischargedAdmissionCount = totalAdmissionCount - activeAdmissionCount;

        admissions = await db.PatientAdmissions.AsNoTracking().OrderByDescending(x => x.ID).Take(admissionLoadCount).ToListAsync();
        hasMoreAdmissions = admissions.Count < totalAdmissionCount;

        var ids = admissions.Where(x => !string.IsNullOrWhiteSpace(x.PatientID)).Select(x => x.PatientID!).Distinct().ToArray();
        patientNames = ids.Length == 0 ? new(StringComparer.OrdinalIgnoreCase) : await db.Registrations.AsNoTracking().Where(x => ids.Contains(x.PatientID)).ToDictionaryAsync(x => x.PatientID, x => x.Name, StringComparer.OrdinalIgnoreCase);

        InitializeDoctorSearchList();
    }

    private void InitializeDoctorSearchList()
    {
        doctorViewItems = doctors.Select(d =>
        {
            var displayName = CleanDoctorName(d);
            var deptName = d.Department.HasValue && doctorDepartments.TryGetValue(d.Department.Value, out var dn) ? dn : "";
            var room = CleanDoctorRoom(d.Room);
            var cleanDegree = CleanDoctorDegree(d);
            var haystack = $"D{d.ID} {displayName} {cleanDegree} {deptName} {room}".Trim();
            return new DoctorViewItem(d, displayName, cleanDegree, deptName, room, haystack);
        }).ToList();

        UpdateFilteredDoctors();
    }

    private void UpdateFilteredDoctors()
    {
        var term = consultantSearchText.Trim();
        IEnumerable<DoctorViewItem> query = doctorViewItems;
        if (selectedDoctorDepartmentId > 0)
        {
            query = query.Where(x => x.Doctor.Department == selectedDoctorDepartmentId);
        }
        if (!string.IsNullOrWhiteSpace(term) && (!editor.Consultant.HasValue || !consultantSearchText.StartsWith($"D{editor.Consultant}")))
        {
            query = query.Where(x => x.SearchHaystack.Contains(term, StringComparison.OrdinalIgnoreCase));
        }
        filteredDoctorItems = query.ToList();
    }

    private void HandleDoctorDepartmentFilterChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var deptId))
        {
            selectedDoctorDepartmentId = deptId;
            showConsultantSuggestions = true;
            doctorVisibleCount = DoctorBatchSize;
            UpdateFilteredDoctors();
        }
    }

    private void ResetDoctorDeptFilter()
    {
        selectedDoctorDepartmentId = 0;
        showConsultantSuggestions = true;
        doctorVisibleCount = DoctorBatchSize;
        UpdateFilteredDoctors();
    }

    private void HandleConsultantSearchInputAsync(ChangeEventArgs e)
    {
        consultantSearchText = e.Value?.ToString() ?? string.Empty;
        showConsultantSuggestions = true;
        doctorVisibleCount = DoctorBatchSize;
        UpdateFilteredDoctors();
    }

    private void ShowConsultantSuggestions()
    {
        if (IsAdmissionLocked) return;
        showConsultantSuggestions = true;
        doctorVisibleCount = DoctorBatchSize;
        UpdateFilteredDoctors();
    }

    private void HandleConsultantSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") showConsultantSuggestions = false;
        if (e.Key == "Enter" && filteredDoctorItems.Count == 1)
        {
            SelectConsultant(filteredDoctorItems[0].Doctor);
        }
    }

    private void SelectConsultant(DoctorsProfile doc)
    {
        editor.Consultant = doc.ID;
