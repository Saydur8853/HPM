    public static string CleanDoctorName(DoctorsProfile? d)
    {
        if (d is null) return string.Empty;
        var rawTitle = d.Title?.Trim();
        var rawName = d.Name?.Trim() ?? string.Empty;

        var title = IsDummyTitle(rawTitle) ? string.Empty : CleanDoctorToken(rawTitle);
        var name = CleanDoctorToken(rawName);

        if (string.IsNullOrWhiteSpace(title)) return name;
        if (string.IsNullOrWhiteSpace(name)) return title;
        if (name.StartsWith(title, StringComparison.OrdinalIgnoreCase)) return name;
        return $"{title} {name}".Trim();
    }

    private static bool IsDummyTitle(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return true;
        var t = text.Trim();
        if (t.Length <= 2 && (t.Equals("O", StringComparison.OrdinalIgnoreCase) || t == "0" || t == "00" || t == "-" || t == "--" || t == "." || t == ".."))
            return true;
        if (System.Text.RegularExpressions.Regex.IsMatch(t, @"^[\s.・•,\-_0]+$"))
            return true;
        if (string.Equals(t, "OTHER", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(t, "CLINIC", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(t, "Hospital", StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    }

    public static string CleanDoctorToken(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return string.Empty;
        var cleaned = System.Text.RegularExpressions.Regex.Replace(text, @"\.{2,}", " ");
        cleaned = System.Text.RegularExpressions.Regex.Replace(cleaned, @"^[\s.・•,\-_]+", "");
        cleaned = cleaned.TrimEnd(',', '-', ' ', '_', '.');
        cleaned = System.Text.RegularExpressions.Regex.Replace(cleaned, @"\s+", " ").Trim();
        return cleaned;
    }

    public static string CleanDoctorDegree(DoctorsProfile? d)
    {
        if (d is null || string.IsNullOrWhiteSpace(d.Degree)) return string.Empty;
        var deg = d.Degree.Trim();
        if (deg == "0" || deg == "00" || deg == "-" || deg == "--" || deg == "." || deg == "..")
            return string.Empty;
        if (System.Text.RegularExpressions.Regex.IsMatch(deg, @"^[\s.・•,\-_0]+$"))
            return string.Empty;
        deg = System.Text.RegularExpressions.Regex.Replace(deg, @"\.{2,}", " ");
        deg = deg.Trim(' ', ',', '.', '-');
        deg = System.Text.RegularExpressions.Regex.Replace(deg, @"\s+", " ").Trim();
        return deg;
    }

    public static string CleanDoctorRoom(string? room)
    {
        if (string.IsNullOrWhiteSpace(room)) return string.Empty;
        var r = room.Trim().Trim('.', '-', ' ', '_');
        if (string.IsNullOrEmpty(r) || r == "0" || r == "00") return string.Empty;
        return r;
    }

    private static string DoctorDisplayName(DoctorsProfile? d) => CleanDoctorName(d);

    private void Success(string text) { messageClass = "success"; message = text; }
    private void Fail(string text) { messageClass = "danger"; message = text; }

