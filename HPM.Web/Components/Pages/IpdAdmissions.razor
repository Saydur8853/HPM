    private void HidePatientSuggestions()
    {
        showPatientSuggestions = false;
    }

    private async Task LoadPatientSuggestionsAsync(bool reset)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var query = BuildPatientSuggestionQuery(db, patientSearchText.Trim());
        var skip = reset ? 0 : patientSuggestions.Count;
        var batch = await query.Skip(skip).Take(PatientSuggestionBatchSize).ToListAsync();
        if (reset)
        {
            patientSuggestions = batch;
            try { await JS.InvokeVoidAsync("hpm.resetPatientIdScrollTop", "appt-patient-suggestions-list"); } catch { }
        }
        else
        {
            patientSuggestions.AddRange(batch);
        }
        hasMorePatientSuggestions = batch.Count == PatientSuggestionBatchSize;
        showPatientSuggestions = true;
    }

    private Task LoadMorePatientSuggestionsAsync() => LoadMorePatientsFromJs();

    [JSInvokable]
    public async Task LoadMorePatientsFromJs()
    {
        if (isLoadingMorePatients || !hasMorePatientSuggestions || !showPatientSuggestions) return;
        isLoadingMorePatients = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var query = BuildPatientSuggestionQuery(db, patientSearchText.Trim());
            var nextBatch = await query.Skip(patientSuggestions.Count).Take(PatientSuggestionBatchSize).ToListAsync();
            if (nextBatch.Count > 0)
            {
                patientSuggestions.AddRange(nextBatch);
                hasMorePatientSuggestions = nextBatch.Count >= PatientSuggestionBatchSize;
            }
            else
            {
                hasMorePatientSuggestions = false;
            }
        }
        catch
        {
            hasMorePatientSuggestions = false;
        }
        finally
        {
            isLoadingMorePatients = false;
            await InvokeAsync(StateHasChanged);
        }
    }

