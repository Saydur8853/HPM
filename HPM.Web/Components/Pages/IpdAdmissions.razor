    // =========================================================================
    // Patient Search & Conflict Detection Logic (Audit Item 1)
    // =========================================================================
    private async Task LoadPatientAsync()
    {
        if (editor.ID == 0 && !string.IsNullOrWhiteSpace(patientSearchText)) editor.PatientID = patientSearchText.Trim();
        if (string.IsNullOrWhiteSpace(editor.PatientID))
        {
            Fail(I18n.IsBangla ? "প্রথমে পেশেন্ট আইডি লিখুন।" : "Enter a Patient ID first.");
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var patient = await db.Registrations.AsNoTracking().FirstOrDefaultAsync(x => x.PatientID == editor.PatientID.Trim());
        if (patient is null)
        {
            patientName = "";
            loadedPatient = null;
            activeAdmissionConflict = null;
            Fail(I18n.IsBangla ? "নিবন্ধিত রোগী পাওয়া যায়নি।" : "Registered patient was not found.");
            return;
        }

        loadedPatient = patient;
        editor.PatientID = patient.PatientID;
        patientSearchText = patient.PatientID;
        showPatientSuggestions = false;
        patientName = patient.Name;
        PatientSelection.Select(patient.PatientID);

        if (patient.DateOfBirth.HasValue)
        {
            var today = DateTime.Today;
            var birth = patient.DateOfBirth.Value;
            var years = today.Year - birth.Year;
            if (birth.Date > today.AddYears(-years)) years--;
            editor.Age = $"{Math.Max(0, years)}Y";
        }
        else
        {
            editor.Age = string.Empty;
        }

        // Check for active admission conflict (Audit Item 1)
        await CheckActiveAdmissionConflictAsync(patient.PatientID);

        if (activeAdmissionConflict == null)
        {
            Success(I18n.IsBangla ? $"রোগী {patient.Name} ({patient.PatientID}) লোড করা হয়েছে।" : $"Loaded patient {patient.Name} ({patient.PatientID}).");
        }
    }

    private async Task CheckActiveAdmissionConflictAsync(string patientId)
    {
        if (string.IsNullOrWhiteSpace(patientId))
        {
            activeAdmissionConflict = null;
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        activeAdmissionConflict = await db.PatientAdmissions
            .AsNoTracking()
            .FirstOrDefaultAsync(x => x.PatientID == patientId && x.IsAdmitted == true && (editor.ID == 0 || x.ID != editor.ID));

        if (activeAdmissionConflict != null)
        {
            var bed = beds.FirstOrDefault(b => b.ID == activeAdmissionConflict.BedCabinID);
            var bedName = bed?.Name ?? $"Bed #{activeAdmissionConflict.BedCabinID}";
            Fail(I18n.IsBangla
                ? $"সতর্কতা: রোগী ইতিমধ্যে ভর্তি আছেন! আইপিডি রেজি: {activeAdmissionConflict.RegNo}, বেড: {bedName}। একাধিক সক্রিয় ভর্তি অনুমোদিত নয়।"
                : $"Warning: Patient already has an ACTIVE admission (Reg: {activeAdmissionConflict.RegNo}, Bed: {bedName})! Duplicate active admission blocked.");
        }
    }

    private static IQueryable<Registration> BuildPatientSuggestionQuery(HpmDbContext db, string term)
    {
        return db.Registrations.AsNoTracking()
            .Where(x => string.IsNullOrEmpty(term)
                     || x.PatientID.StartsWith(term)
                     || (x.Contact != null && x.Contact.StartsWith(term))
                     || (x.Name != null && x.Name.Contains(term)))
            .OrderByDescending(x => x.ID);
    }

