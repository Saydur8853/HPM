    // =========================================================================
    // Core Save & Concurrency-Safe Transaction (Audit Items 1, 2, 4, 5)
    // =========================================================================
    private async Task SaveAsync()
    {
        if (saving) return;

        // 1. Audit Item 2: Discharged / billed admission records are strictly read-only
        if (IsAdmissionLocked)
        {
            Fail(I18n.T("Discharged or billed admission records are read-only and cannot be updated."));
            return;
        }

        // 2. Audit Item 4: Form validations
        if (string.IsNullOrWhiteSpace(editor.PatientID) || loadedPatient is null)
        {
            Fail(I18n.IsBangla ? "নিবন্ধিত রোগী নির্বাচন করা আবশ্যক।" : "A valid registered patient is required.");
            return;
        }

        if (editor.Consultant is null || editor.Consultant <= 0)
        {
            Fail(I18n.T("Consultant Doctor is required."));
            return;
        }

        if (editor.Department is null || editor.Department <= 0)
        {
            Fail(I18n.T("IPD Department / Ward is required."));
            return;
        }

        if (editor.BedCabinID is null || editor.BedCabinID <= 0)
        {
            Fail(I18n.T("Bed or Cabin allocation is required."));
            return;
        }

        if (editor.AdmissionDate is null)
        {
            Fail(I18n.T("Admission Date & Time is required."));
            return;
        }

        if (editor.AdmissionDate > DateTime.Now.AddMinutes(5))
        {
            Fail(I18n.T("Admission date and time cannot be in the future."));
            return;
        }

        if ((editor.AdmissionFee ?? 0) < 0 || (serviceCharge ?? 0) < 0 || (foodCharge ?? 0) < 0 || (editor.AmbulanceFee ?? 0) < 0)
        {
            Fail(I18n.T("Admission fee, service charge, food charge, and ambulance fee cannot be negative."));
            return;
        }

        // 3. Audit Item 1: Duplicate active admission check
        if (activeAdmissionConflict != null)
        {
            Fail(I18n.T("This patient already has an active IPD admission. Duplicate active admissions are blocked."));
            return;
        }

        saving = true;
        try
        {
            await using var strategyDb = await DbFactory.CreateDbContextAsync();
            var strategy = strategyDb.Database.CreateExecutionStrategy();
            await strategy.ExecuteAsync(async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                await using var transaction = await db.Database.BeginTransactionAsync(System.Data.IsolationLevel.Serializable);
                try
                {
                    var patient = await db.Registrations.AsNoTracking().FirstOrDefaultAsync(x => x.PatientID == editor.PatientID.Trim());
                    if (patient is null) throw new InvalidOperationException(I18n.IsBangla ? "নিবন্ধিত রোগী পাওয়া যায়নি।" : "Registered patient was not found.");

                    // Audit Item 1: Patient-level transaction lock & active admission uniqueness check
                    await SqlServerConcurrency.AcquireTransactionLockAsync(db, $"HPM:IPD:Patient:{patient.PatientID}");
                    var duplicateActive = await db.PatientAdmissions.FirstOrDefaultAsync(x => x.PatientID == patient.PatientID && x.IsAdmitted == true && (editor.ID == 0 || x.ID != editor.ID));
                    if (duplicateActive != null)
                        throw new InvalidOperationException(I18n.T("This patient already has an active IPD admission. Duplicate active admissions are blocked."));

                    // Bed-level transaction lock
                    await SqlServerConcurrency.AcquireTransactionLockAsync(db, $"HPM:Bed:{editor.BedCabinID.Value}");
                    var selectedBed = await db.BedCabins.FindAsync(editor.BedCabinID.Value);
                    if (selectedBed is null) throw new InvalidOperationException(I18n.IsBangla ? "নির্বাচিত বেড/কেবিন পাওয়া যায়নি।" : "Selected bed/cabin was not found.");

                    PatientAdmission entity;
                    int? oldBedId = null;
                    var isNew = editor.ID == 0;

                    if (isNew)
                    {
                        await SqlServerConcurrency.AcquireTransactionLockAsync(db, "HPM:IPD-RegNo");
                        entity = editor;
                        var next = (await db.PatientAdmissions.MaxAsync(x => (long?)x.ID) ?? 0) + 1;
                        if (next > 9_999_999) throw new InvalidOperationException("IPD registration number capacity has been reached.");
                        entity.RegNo = $"I{DateTime.Now:yy}{next:D7}";
                        entity.IsAdmitted = true;
                        entity.BedAdmissionDate = entity.AdmissionDate;
                        entity.TransDate = DateTime.Now;
                        entity.EnteredBy = await CurrentUserIdAsync();
                        db.PatientAdmissions.Add(entity);
                    }
                    else
                    {
                        entity = await db.PatientAdmissions.FirstOrDefaultAsync(x => x.ID == editor.ID)
                            ?? throw new InvalidOperationException(I18n.IsBangla ? "ভর্তি রেকর্ড পাওয়া যায়নি।" : "Admission not found.");

                        // Audit Item 2: Discharged / billed records read-only enforcement
                        if (entity.IsAdmitted != true || (entity.BillNo ?? 0) > 0)
                            throw new InvalidOperationException(I18n.T("Discharged or billed admission records are read-only."));

                        // Audit Item 5: Prevent silent bed change during edit
                        oldBedId = entity.BedCabinID;
                        if (oldBedId != editor.BedCabinID)
                            throw new InvalidOperationException(I18n.T("Use Patient Transfer to change the allocated bed or cabin."));

                        db.Entry(entity).CurrentValues.SetValues(editor);
                    }

                    if ((selectedBed.IsAllocated || selectedBed.Status != BedStatuses.Available) && oldBedId != selectedBed.ID)
                        throw new InvalidOperationException(I18n.IsBangla ? "নির্বাচিত বেডটি ইতিমধ্যে অন্য রোগীর জন্য বরাদ্দকৃত।" : "Selected bed/cabin is already occupied by another patient.");

                    entity.IsPackage = isPackage;
                    await db.SaveChangesAsync();

                    if (isNew || oldBedId != selectedBed.ID)
                    {
                        if (oldBedId is not null)
                        {
                            var oldBed = await db.BedCabins.FindAsync(oldBedId.Value);
                            if (oldBed is not null)
                            {
                                oldBed.IsAllocated = false;
                                oldBed.Status = BedStatuses.Cleaning;
                                db.BedTurnovers.Add(new BedTurnover
                                {
                                    BedCabinID = oldBed.ID,
                                    AdmissionID = entity.ID,
                                    RegNo = entity.RegNo,
                                    Status = "Cleaning",
                                    RequestedAt = DateTime.Now
                                });
                            }
                            var open = await db.BedCabinTransactions.Where(x => x.RegNo == entity.RegNo && x.EndDate == null).ToListAsync();
                            foreach (var item in open) item.EndDate = DateTime.Now;
                            await db.SaveChangesAsync();
                        }

                        selectedBed.IsAllocated = true;
                        selectedBed.Status = BedStatuses.Occupied;
                        var category = categories.First(x => x.ID == selectedBed.CategoryID);
                        db.BedCabinTransactions.Add(new()
                        {
                            BedCabinID = selectedBed.ID,
                            RegNo = entity.RegNo,
                            PatientID = entity.PatientID,
                            Rate = category.Rate,
                            PatientTransactionID = entity.ID,
                            StartDate = entity.BedAdmissionDate ?? DateTime.Now
                        });
                    }

                    var extension = await db.AdmissionExtensions.FirstOrDefaultAsync(x => x.RegNo == entity.RegNo);
                    if (extension is null)
                    {
                        db.AdmissionExtensions.Add(new() { RegNo = entity.RegNo, ServiceCharge = serviceCharge, Food = foodCharge });
                    }
                    else
                    {
                        extension.ServiceCharge = serviceCharge;
                        extension.Food = foodCharge;
                    }

                    await db.SaveChangesAsync();
                    await transaction.CommitAsync();

                    editor = Clone(entity);
                    PreparePrintTarget(entity, loadedPatient);

                    Success(isNew
                        ? (I18n.IsBangla ? $"রোগী সফলভাবে ভর্তি হয়েছে। আইপিডি রেজি: {entity.RegNo}" : $"Patient admitted successfully with IPD registration {entity.RegNo}.")
                        : (I18n.IsBangla ? "ভর্তি তথ্য সফলভাবে আপডেট হয়েছে।" : "Admission updated successfully."));
                }
                catch
                {
                    await transaction.RollbackAsync();
                    throw;
                }
            });

            await LoadAsync();
        }
        catch (Exception ex)
        {
            Fail(I18n.IsBangla ? $"ভর্তি সংরক্ষণ করা যায়নি: {ex.GetBaseException().Message}" : $"Admission could not be saved: {ex.GetBaseException().Message}");
        }
        finally
        {
            saving = false;
        }
    }

    private async Task<int> CurrentUserIdAsync()
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        var value = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!int.TryParse(value, out var id)) return 1;
        return id;
    }

    // =========================================================================
    // Safe Delete with Dependency Verification (Audit Item 3)
    // =========================================================================
    private async Task DeleteAsync()
    {
        if (editor.ID <= 0 || IsAdmissionLocked)
        {
            Fail(I18n.T("Finalized or unsaved admissions cannot be deleted."));
            return;
        }

        var confirmMsg = I18n.IsBangla
            ? $"আপনি কি নিশ্চিত যে ভর্তি {editor.RegNo} ({patientName}) মুছে ফেলতে চান?"
            : $"Are you sure you want to delete admission {editor.RegNo} ({patientName})?";

        if (!await JS.InvokeAsync<bool>("hpm.confirm", confirmMsg)) return;

        try
        {
            await using var strategyDb = await DbFactory.CreateDbContextAsync();
            var strategy = strategyDb.Database.CreateExecutionStrategy();
            await strategy.ExecuteAsync(async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                await using var transaction = await db.Database.BeginTransactionAsync(System.Data.IsolationLevel.Serializable);
                try
                {
                    var entity = await db.PatientAdmissions.FindAsync(editor.ID);
                    if (entity is null) return;

                    if (entity.IsAdmitted != true || (entity.BillNo ?? 0) > 0)
                        throw new InvalidOperationException(I18n.T("Discharged or billed admission records cannot be deleted."));

                    // Dependency check across financial, services, billing, turnovers and payments
                    var hasReceipts = await db.IpdMoneyReceipts.AnyAsync(x => x.RegNo == entity.RegNo);
                    var hasServices = await db.IpdPatientServiceItems.AnyAsync(x => x.RegNo == entity.RegNo);
                    var hasMedicalDischarge = await db.IpdMedicalDischargeOrders.AnyAsync(x => x.AdmissionID == entity.ID || x.RegNo == entity.RegNo);
                    var hasBilling = await db.IpdFinalBills.AnyAsync(x => x.AdmissionID == entity.ID || x.RegNo == entity.RegNo);
                    var hasTurnovers = await db.BedTurnovers.AnyAsync(x => x.AdmissionID == entity.ID);
                    var hasTransactions = await db.PatientTransactions.AnyAsync(x => x.RegNo == entity.RegNo);
                    var hasPackageTx = await db.PatientPackageTransactions.AnyAsync(x => x.RegNo == entity.RegNo);
                    var hasPayments = await db.PatientPayments.AnyAsync(x => x.RegNo == entity.RegNo);

                    if (hasReceipts || hasServices || hasMedicalDischarge || hasBilling || hasTurnovers || hasTransactions || hasPackageTx || hasPayments)
                    {
                        var reasons = new List<string>();
                        if (hasReceipts) reasons.Add(I18n.T("Money Receipts"));
                        if (hasServices) reasons.Add(I18n.T("Patient Services"));
                        if (hasMedicalDischarge) reasons.Add(I18n.T("Discharge Order"));
                        if (hasBilling) reasons.Add(I18n.T("Final Bill"));
                        if (hasTurnovers) reasons.Add(I18n.T("Bed Turnover"));
                        if (hasTransactions || hasPackageTx || hasPayments) reasons.Add(I18n.T("Billing Transactions"));

                        throw new InvalidOperationException($"{I18n.T("Cannot delete admission. Active dependencies exist:")} {string.Join(", ", reasons)}.");
                    }

                    // Release bed safely
                    if (entity.BedCabinID.HasValue)
                    {
                        var bed = await db.BedCabins.FindAsync(entity.BedCabinID.Value);
                        if (bed is not null)
                        {
                            bed.IsAllocated = false;
                            bed.Status = BedStatuses.Available;
                        }
                    }

                    var extensions = await db.AdmissionExtensions.Where(x => x.RegNo == entity.RegNo).ToListAsync();
                    var movements = await db.BedCabinTransactions.Where(x => x.RegNo == entity.RegNo).ToListAsync();
                    db.RemoveRange(extensions);
                    db.RemoveRange(movements);
                    db.Remove(entity);

                    await db.SaveChangesAsync();
                    await transaction.CommitAsync();
                }
                catch
                {
                    await transaction.RollbackAsync();
                    throw;
                }
            });

            Success(I18n.IsBangla ? "ভর্তি তথ্য মুছে ফেলা হয়েছে এবং বেড মুক্ত করা হয়েছে।" : $"Admission {editor.RegNo} deleted and bed released successfully.");
            ResetEditor();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Fail(I18n.IsBangla ? $"ভর্তি মুছে ফেলা যায়নি: {ex.GetBaseException().Message}" : $"Admission could not be deleted: {ex.GetBaseException().Message}");
        }
    }

