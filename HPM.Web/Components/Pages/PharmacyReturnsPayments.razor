@page "/pharmacy/returns-payments"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.PharmacyOperator + "," + RoleNames.Cashier)]
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject IBarcodeQrService BarcodeQr
@implements IDisposable
@using System.Data
@using System.Security.Claims
@using HPM.Web.Components.Common

<PageTitle>@I18n.T("Supplier Due & Return") | @Branding.HospitalName</PageTitle>

<div class="pharm-subnav-bar">
    <div>
        <h1 style="margin:0; font-size:20px; font-weight:800; color:#0f172a;">@I18n.T("Supplier Due Payment & Stock Return")</h1>
    </div>

    <div class="pharm-tab-pills">
        <button type="button" class="pharm-tab-pill @(activeTab == "payments" ? "active" : "")" @onclick='() => activeTab = "payments"'>
            @I18n.T("Pay Supplier")
        </button>
        <button type="button" class="pharm-tab-pill @(activeTab == "returns" ? "active" : "")" @onclick='() => activeTab = "returns"'>
            @I18n.T("Return to Supplier")
        </button>
        <button type="button" class="pharm-tab-pill @(activeTab == "ledger" ? "active" : "")" @onclick='() => activeTab = "ledger"'>
            @I18n.T("Supplier Ledger")
        </button>
    </div>

    <div style="display:flex; gap:6px; align-items:center;">
        <NavLink class="btn btn-ghost btn-sm" href="/pharmacy/purchases">&larr; @I18n.T("Purchase / Stock In")</NavLink>
        <button class="btn btn-secondary btn-sm" @onclick="ResetAll">@I18n.T("New Entry")</button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @messageClass" style="margin-bottom:12px;">@message</div>
}

@if (activeTab == "payments")
{
    <div class="module-layout">
        <div class="panel form-panel">
            <div class="panel-heading" style="padding:12px 18px;">
                <h2 style="font-size:15px; margin:0;">
                    @(savedPayment is null ? I18n.T("Pay Supplier Due") : $"{I18n.T("Payment Voucher")} #PAY-{savedPayment.ID}")
                </h2>
                @if (savedPayment is not null)
                {
                    <span class="pill pill-success">@I18n.T("POSTED")</span>
                }
            </div>
            <div class="form-grid">
                <label>
                    <span>@I18n.T("Supplier / Company") *</span>
                    <select @bind="paymentSupplierId" @bind:after="PaymentSupplierChanged" disabled="@(savedPayment != null)">
                        <option value="0">@I18n.T("Select Supplier")</option>
                        @foreach (var x in suppliers)
                        {
                            <option value="@x.ID">@x.Name</option>
                        }
                    </select>
                </label>
                <label>
                    <span>@I18n.T("Current Due Balance")</span>
                    <input style="font-weight:800; color:#b91c1c;" value="@I18n.FormatCurrency(paymentPayable)" disabled />
                </label>
                <label>
                    <span>@I18n.T("Payment Amount") *</span>
                    <InputNumber @bind-Value="paymentAmount" disabled="@(savedPayment != null)" />
                </label>
                <label>
                    <span>@I18n.T("Payment Method") *</span>
                    <select @bind="paymentMode" disabled="@(savedPayment != null)">
                        <option value="Cash">@I18n.T("Cash")</option>
                        <option value="Bank">@I18n.T("Bank")</option>
                        <option value="Mobile Banking">@I18n.T("Mobile Banking")</option>
                        <option value="Cheque">@I18n.T("Cheque")</option>
                    </select>
                </label>
            </div>
            <div class="form-actions">
                @if (savedPayment is null)
                {
                    <button class="btn btn-primary" @onclick="() => PostPaymentAsync(false)" disabled="@isSaving">
                        @(isSaving ? I18n.T("Saving…") : I18n.T("Save Payment"))
                    </button>
                    <button class="btn btn-secondary" @onclick="() => PostPaymentAsync(true)" disabled="@isSaving">
                        @I18n.T("Save & Print A4 Voucher")
                    </button>
                }
                else
                {
                    <button class="btn btn-primary" @onclick="PrintPaymentAsync">@I18n.T("Print A4 Payment Voucher")</button>
                    <button class="btn btn-secondary" @onclick="ResetAll">@I18n.T("New Payment")</button>
                }
            </div>
        </div>

        <div class="panel">
            <div class="panel-heading" style="padding:12px 18px;">
                <h2 style="font-size:15px; margin:0;">@I18n.T("Recent Supplier Payments") (@recentPayments.Count)</h2>
            </div>
            <div class="data-table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@I18n.T("Voucher")</th>
                            <th>@I18n.T("Supplier")</th>
                            <th>@I18n.T("Method")</th>
                            <th>@I18n.T("Date")</th>
                            <th class="num">@I18n.T("Amount")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (recentPayments.Count == 0)
                        {
                            <tr><td colspan="6"><div class="empty-state small">@I18n.T("No payments recorded yet.")</div></td></tr>
                        }
                        @foreach (var x in recentPayments)
                        {
                            <tr>
                                <td><b>PAY-@x.ID</b></td>
                                <td>@SupplierName(x.SupplierID)</td>
                                <td>@x.PaymentMode</td>
                                <td>@x.TransDate.ToString("dd MMM yy")</td>
                                <td class="num"><b>@I18n.FormatCurrency(x.Amount)</b></td>
                                <td style="text-align:right;"><button class="icon-btn" @onclick="() => OpenPayment(x)">@I18n.T("View / Print")</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else if (activeTab == "returns")
{
    <div class="module-layout">
        <div class="panel form-panel">
            <div class="panel-heading" style="padding:12px 18px;">
                <h2 style="font-size:15px; margin:0;">
                    @(savedReturn is null ? I18n.T("Return Expired / Damaged Stock to Supplier") : $"{I18n.T("Purchase Return")} #PRET-{savedReturn.ID}")
                </h2>
                @if (savedReturn is not null)
                {
                    <span class="pill pill-success">@I18n.T("POSTED")</span>
                }
            </div>
            <div class="form-grid">
                <label>
                    <span>@I18n.T("Supplier / Company") *</span>
                    <select @bind="returnSupplierId" disabled="@(savedReturn != null)">
                        <option value="0">@I18n.T("Select Supplier")</option>
                        @foreach (var x in suppliers)
                        {
                            <option value="@x.ID">@x.Name</option>
                        }
                    </select>
                </label>
                <label>
                    <span>@I18n.T("From Store") *</span>
                    <select @bind="returnStoreId" disabled="@(savedReturn != null)">
                        @foreach (var x in stores.Where(x => x.IsActive))
                        {
                            <option value="@x.ID">@x.Name</option>
                        }
                    </select>
                </label>
            </div>

            @if (savedReturn is null)
            {
                <div class="form-grid" style="grid-template-columns: 2fr 90px 100px auto; gap:8px; align-items:end;">
                    <div class="pos-typeahead-wrapper">
                        <span style="font-size:12px; font-weight:600; color:#334155; display:block; margin-bottom:4px;">@I18n.T("Search Medicine Batch") *</span>
                        <input type="text"
                               placeholder="@I18n.T("Type medicine or batch #...")"
                               @bind="stockSearchQuery"
                               @bind:event="oninput"
                               @onfocus="() => showStockDropdown = true" />
                        @if (showStockDropdown && FilteredAvailableStocks.Any())
                        {
                            <div class="pos-med-dropdown" style="z-index:130;">
                                @foreach (var b in FilteredAvailableStocks)
                                {
                                    <div class="pos-med-item" @onmousedown:preventDefault @onclick="() => SelectReturnBatch(b)">
                                        <div>
                                            <div class="pos-med-name">@MedicineName(b.ServiceID)</div>
                                            <div class="pos-med-sub">Batch: <b>@(b.BatchNo ?? "—")</b> &bull; Exp: @(b.ExpireDate?.ToString("dd MMM yyyy") ?? "—")</div>
                                        </div>
                                        <span class="pos-stock-badge in-stock">@I18n.T("Qty"): @b.Balance.ToString("N0")</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <label><span>@I18n.T("Qty") *</span><InputNumber @bind-Value="returnQuantity" /></label>
                    <label><span>@I18n.T("Buy Rate") *</span><InputNumber @bind-Value="returnBuyRate" /></label>
                    <div><button class="btn btn-secondary" type="button" @onclick="AddReturnLine">+ @I18n.T("Add")</button></div>
                </div>
            }

            <div class="data-table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@I18n.T("Medicine / Batch")</th>
                            <th class="num">@I18n.T("Qty")</th>
                            <th class="num">@I18n.T("Buy Rate")</th>
                            <th class="num">@I18n.T("Total")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (returnLines.Count == 0)
                        {
                            <tr><td colspan="6"><div class="empty-state small">@I18n.T("No return items added yet.")</div></td></tr>
                        }
                        @for (var i = 0; i < returnLines.Count; i++)
                        {
                            var index = i;
                            var x = returnLines[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td><b>@MedicineName(x.ServiceID)</b><br /><small class="text-muted">@x.BatchNo</small></td>
                                <td class="num">@x.Quantity</td>
                                <td class="num">@I18n.FormatCurrency(x.BuyRate)</td>
                                <td class="num"><b>@I18n.FormatCurrency(x.Total)</b></td>
                                <td style="text-align:right;">
                                    @if (savedReturn is null)
                                    {
                                        <button class="icon-btn" type="button" @onclick="() => returnLines.RemoveAt(index)">✕</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="form-actions">
                <b style="margin-right:auto;">@I18n.T("Return Value"): @I18n.FormatCurrency(ReturnTotal)</b>
                @if (savedReturn is null)
                {
                    <button class="btn btn-primary" @onclick="() => PostReturnAsync(false)" disabled="@isSaving">
                        @(isSaving ? I18n.T("Saving…") : I18n.T("Save Supplier Return"))
                    </button>
                    <button class="btn btn-secondary" @onclick="() => PostReturnAsync(true)" disabled="@isSaving">
                        @I18n.T("Save & Print A4")
                    </button>
                }
                else
                {
                    <button class="btn btn-primary" @onclick="PrintReturnAsync">@I18n.T("Print A4 Return Note")</button>
                    <button class="btn btn-secondary" @onclick="ResetAll">@I18n.T("New Return")</button>
                }
            </div>
        </div>

        <div class="panel">
            <div class="panel-heading" style="padding:12px 18px;">
                <h2 style="font-size:15px; margin:0;">@I18n.T("Recent Supplier Returns") (@recentReturns.Count)</h2>
            </div>
            <div class="data-table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@I18n.T("Return #")</th>
                            <th>@I18n.T("Supplier")</th>
                            <th>@I18n.T("Store")</th>
                            <th>@I18n.T("Date")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (recentReturns.Count == 0)
                        {
                            <tr><td colspan="5"><div class="empty-state small">@I18n.T("No supplier returns recorded yet.")</div></td></tr>
                        }
                        @foreach (var r in recentReturns)
                        {
                            <tr>
                                <td><b>PRET-@r.ID</b></td>
                                <td>@SupplierName(r.SupplierID)</td>
                                <td>@StoreName(r.StoreID)</td>
                                <td>@r.TransDate.ToString("dd MMM yy")</td>
                                <td style="text-align:right;"><button class="icon-btn" @onclick="() => OpenReturnAsync(r.ID)">@I18n.T("View / Print")</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div id="supplier-ledger-print" class="panel print-a4-sheet">
        <div class="panel-heading" style="padding:12px 18px; flex-wrap:wrap; gap:8px;">
            <h2 style="font-size:15px; margin:0;">@I18n.T("Supplier Statement & Due Ledger")</h2>
            <div style="display:flex; gap:8px; flex-wrap:wrap;" class="no-print">
                <select @bind="ledgerSupplierId">
                    <option value="0">@I18n.T("All Suppliers")</option>
                    @foreach (var x in suppliers)
                    {
                        <option value="@x.ID">@x.Name</option>
                    }
                </select>
                <InputDate @bind-Value="fromDate" />
                <InputDate @bind-Value="toDate" />
                <button class="btn btn-secondary btn-sm" @onclick="LoadLedgerAsync">@I18n.T("Filter")</button>
                <button class="btn btn-secondary btn-sm" @onclick="PrintLedgerAsync">@I18n.T("Print A4 Statement")</button>
            </div>
        </div>
        <div class="data-table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>@I18n.T("Date")</th>
                        <th>@I18n.T("Supplier")</th>
                        <th>@I18n.T("Particulars")</th>
                        <th class="num">@I18n.T("Paid / Returned")</th>
                        <th class="num">@I18n.T("Purchased")</th>
                        <th class="num">@I18n.T("Due Balance")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ledger.Count == 0)
                    {
                        <tr><td colspan="6"><div class="empty-state small">@I18n.T("No ledger entries for selected dates.")</div></td></tr>
                    }
                    @foreach (var x in ledger)
                    {
                        <tr>
                            <td>@x.TransDate.ToString("dd MMM yyyy")</td>
                            <td>@SupplierName(x.SupplierID)</td>
                            <td>@LedgerParticulars(x)</td>
                            <td class="num">@I18n.FormatCurrency(x.Debit ?? 0)</td>
                            <td class="num">@I18n.FormatCurrency(x.Credit ?? 0)</td>
                            <td class="num"><b>@I18n.FormatCurrency(x.Balance)</b></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (savedReturn is not null)
{
    <!-- Official A4 Supplier Purchase Return Note -->
    <div id="medicine-return-print" class="print-sheet panel print-document print-a4-sheet pharm-print-only">
        <PrintDocumentHeader Title="@I18n.T("Supplier Purchase Return / Debit Note")"
                             SubTitle="@I18n.T("Hospital Pharmacy")"
                             DocumentNo="@($"PRET-{savedReturn.ID}")"
                             BarcodeCode="@($"PRET-{savedReturn.ID}")" />

        <div class="print-grid">
            <div><span>@I18n.T("Supplier"):</span> <b>@SupplierName(savedReturn.SupplierID)</b></div>
            <div><span>@I18n.T("From Store"):</span> <b>@StoreName(savedReturn.StoreID)</b></div>
            <div><span>@I18n.T("Date & Time"):</span> <b>@savedReturn.TransDate.ToString("dd MMM yyyy hh:mm tt")</b></div>
        </div>

        <table class="data-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>@I18n.T("Medicine")</th>
                    <th>@I18n.T("Batch")</th>
                    <th class="num">@I18n.T("Qty")</th>
                    <th class="num">@I18n.T("Buy Rate")</th>
                    <th class="num">@I18n.T("Amount")</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < returnLines.Count; i++)
                {
                    var x = returnLines[i];
                    <tr>
                        <td>@(i + 1)</td>
                        <td><b>@MedicineName(x.ServiceID)</b></td>
                        <td>@(string.IsNullOrWhiteSpace(x.BatchNo) ? "—" : x.BatchNo)</td>
                        <td class="num">@x.Quantity</td>
                        <td class="num">@I18n.FormatCurrency(x.BuyRate)</td>
                        <td class="num">@I18n.FormatCurrency(x.Total)</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="print-total">
            <div class="grand">
                <span>@I18n.T("Total Return Credit")</span>
                <b>@I18n.FormatCurrency(ReturnTotal)</b>
            </div>
        </div>

        <PrintDocumentFooter Signatures='new string[] { I18n.T("Prepared By"), I18n.T("Supplier Representative"), I18n.T("Authorized By") }' />
    </div>
}

@if (savedPayment is not null)
{
    <!-- Official A4 Supplier Payment Voucher -->
    <div id="supplier-payment-print" class="print-sheet panel print-document print-a4-sheet pharm-print-only">
        <PrintDocumentHeader Title="@I18n.T("Supplier Payment Voucher")"
                             SubTitle="@I18n.T("Hospital Pharmacy & Accounts")"
                             DocumentNo="@($"PAY-{savedPayment.ID}")"
                             BarcodeCode="@($"PAY-{savedPayment.ID}")"
                             QrPayload="@BarcodeQr.GenerateVoucherQrPayload(savedPayment.ID, "SUPPLIER-PAYMENT", savedPayment.Amount, savedPayment.TransDate)" />

        <div class="print-grid">
            <div><span>@I18n.T("Paid To Supplier"):</span> <b>@SupplierName(savedPayment.SupplierID)</b></div>
            <div><span>@I18n.T("Payment Method"):</span> <b>@savedPayment.PaymentMode</b></div>
            <div><span>@I18n.T("Date & Time"):</span> <b>@savedPayment.TransDate.ToString("dd MMM yyyy hh:mm tt")</b></div>
            <div><span>@I18n.T("Remaining Due"):</span> <b>@I18n.FormatCurrency(paymentPayable)</b></div>
        </div>

        <div class="print-total" style="margin-top:16px;">
            <div class="grand">
                <span>@I18n.T("Paid Amount")</span>
                <b>@I18n.FormatCurrency(savedPayment.Amount)</b>
            </div>
        </div>

        <PrintDocumentFooter Signatures='new string[] { I18n.T("Receiver Signature"), I18n.T("Cashier"), I18n.T("Authorized By") }' />
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "view")]
    public string? QueryView { get; set; }

    private List<Service> medicines = [];
    private List<SupplierPharmacy> suppliers = [];
    private List<MedicineStore> stores = [];
    private List<MedicineStoreBalance> stocks = [];
    private List<MedicineReturn> recentReturns = [];
    private List<SupplierPayment> recentPayments = [];
    private List<SupplierLedger> ledger = [];
    private List<ReturnLine> returnLines = [];
    private MedicineReturn? savedReturn;
    private SupplierPayment? savedPayment;

    private string activeTab = "payments";
    private int returnSupplierId, returnStoreId = 1, selectedStockId, paymentSupplierId, ledgerSupplierId;
    private string stockSearchQuery = "";
    private bool showStockDropdown;
    private decimal returnQuantity = 1, returnBuyRate, paymentAmount, paymentPayable;
    private string paymentMode = "Cash", message = "", messageClass = "success";
    private DateTime fromDate = DateTime.Today.AddDays(-30), toDate = DateTime.Today;
    private bool isSaving;

    private IEnumerable<MedicineStoreBalance> FilteredAvailableStocks => stocks
        .Where(x => x.MedicineStoreID == returnStoreId && x.Balance > 0)
        .Where(x => string.IsNullOrWhiteSpace(stockSearchQuery)
            || MedicineName(x.ServiceID).Contains(stockSearchQuery.Trim(), StringComparison.OrdinalIgnoreCase)
            || (x.BatchNo?.Contains(stockSearchQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false))
        .OrderBy(x => MedicineName(x.ServiceID))
        .ThenBy(x => x.ExpireDate)
        .Take(25);

    private decimal ReturnTotal => returnLines.Sum(x => x.Total);

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        await LoadAsync();
    }

    protected override void OnParametersSet()
    {
        if (string.Equals(QueryView, "returns", StringComparison.OrdinalIgnoreCase)) activeTab = "returns";
        else if (string.Equals(QueryView, "ledger", StringComparison.OrdinalIgnoreCase)) activeTab = "ledger";
        else if (string.Equals(QueryView, "payments", StringComparison.OrdinalIgnoreCase)) activeTab = "payments";
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        medicines = await db.Services.AsNoTracking().Where(x => x.CategoryID == 3).OrderBy(x => x.Name).ToListAsync();
        suppliers = await db.PharmacySuppliers.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
        stores = await db.MedicineStores.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
        if (stores.Count > 0 && !stores.Any(x => x.ID == returnStoreId && x.IsActive))
            returnStoreId = stores.FirstOrDefault(x => x.IsActive)?.ID ?? stores[0].ID;
        stocks = await db.MedicineStoreBalances.AsNoTracking().Where(x => x.Balance > 0).ToListAsync();
        recentReturns = await db.MedicineReturns.AsNoTracking().OrderByDescending(x => x.ID).Take(50).ToListAsync();
        recentPayments = await db.SupplierPayments.AsNoTracking().OrderByDescending(x => x.ID).Take(50).ToListAsync();
        await LoadLedgerAsync();
    }

    private void SelectReturnBatch(MedicineStoreBalance b)
    {
        selectedStockId = b.ID;
        stockSearchQuery = $"{MedicineName(b.ServiceID)} ({b.BatchNo})";
        var med = medicines.FirstOrDefault(x => x.ID == b.ServiceID);
        returnBuyRate = med?.BuyRate ?? 0;
        if (returnSupplierId == 0 && med?.SupplierID > 0) returnSupplierId = med.SupplierID.Value;
        showStockDropdown = false;
    }

    private void AddReturnLine()
    {
        var stock = stocks.FirstOrDefault(x => x.ID == selectedStockId);
        if (stock is null || returnQuantity <= 0 || returnBuyRate < 0)
        {
            Fail("Select a batch and enter valid quantity/rate.");
            return;
        }
        if (returnLines.Any(x => x.StockID == stock.ID))
        {
            Fail("This batch is already added.");
            return;
        }
        if (returnQuantity > stock.Balance)
        {
            Fail("Return quantity exceeds available batch stock.");
            return;
        }
        returnLines.Add(new ReturnLine(stock.ID, stock.ServiceID, stock.BatchNo ?? "", returnQuantity, returnBuyRate));
        selectedStockId = 0;
        stockSearchQuery = "";
        returnQuantity = 1;
        returnBuyRate = 0;
        message = "";
    }

    private async Task OpenReturnAsync(long id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        savedReturn = await db.MedicineReturns.AsNoTracking().Include(x => x.Items).FirstOrDefaultAsync(x => x.ID == id);
        if (savedReturn == null) return;
        returnSupplierId = savedReturn.SupplierID;
        returnStoreId = savedReturn.StoreID;
        returnLines = savedReturn.Items.OrderBy(x => x.SLNO).Select(x => new ReturnLine(0, x.ServiceID, "", x.Quantity, x.BuyRate)).ToList();
        activeTab = "returns";
    }

    private async Task OpenPayment(SupplierPayment p)
    {
        savedPayment = p;
        paymentSupplierId = p.SupplierID;
        paymentAmount = p.Amount;
        paymentMode = p.PaymentMode ?? "Cash";
        await PaymentSupplierChanged();
        activeTab = "payments";
    }

    private async Task PostReturnAsync(bool printAfterSave)
    {
        if (returnSupplierId <= 0 || returnStoreId <= 0 || returnLines.Count == 0)
        {
            Fail("Supplier, store and at least one return item are required.");
            return;
        }
        isSaving = true;
        try
        {
            var h = await ResilientTransaction.ExecuteAsync(DbFactory, async db =>
            {
                var uid = await CurrentUserIdAsync();
                var now = DateTime.Now;
                var h = new MedicineReturn { SupplierID = returnSupplierId, StoreID = returnStoreId, IsPosted = true, EnteredBy = uid, TransDate = now };
                db.MedicineReturns.Add(h);
                await db.SaveChangesAsync();
                var sl = 1;
                foreach (var line in returnLines)
                {
                    var stock = await db.MedicineStoreBalances.FirstOrDefaultAsync(x => x.ID == line.StockID && x.MedicineStoreID == returnStoreId);
                    if (stock is null || stock.Balance < line.Quantity) throw new InvalidOperationException($"Insufficient stock for {MedicineName(line.ServiceID)}.");
                    stock.Balance -= line.Quantity;
                    db.MedicineReturnItems.Add(new MedicineReturnItem { MedicineReturnID = h.ID, ServiceID = line.ServiceID, SLNO = sl++, Quantity = line.Quantity, BuyRate = line.BuyRate });
                }
                var previous = await db.SupplierLedgers.Where(x => x.SupplierID == returnSupplierId).OrderByDescending(x => x.ID).Select(x => (decimal?)x.Balance).FirstOrDefaultAsync() ?? 0;
                db.SupplierLedgers.Add(new SupplierLedger { SupplierID = returnSupplierId, ChallanNo = -h.ID, Debit = ReturnTotal, Credit = 0, Balance = previous - ReturnTotal, TransDate = now });
                AccountingPosting.AddPostedVoucher(db, "Purchase Return", now, $"Medicine return to {SupplierName(returnSupplierId)}", $"PHARMACY-RETURN:{h.ID}", uid, (AccountingPosting.SupplierPayable, ReturnTotal, 0), (await AccountingSetup.IdAsync(db, AccountCodes.MedicineInventory), 0, ReturnTotal));
                await db.SaveChangesAsync();
                return h;
            }, IsolationLevel.Serializable);

            savedReturn = h;
            Success($"Supplier return #PRET-{h.ID} saved.");
            await RefreshAfterPostAsync();

            if (printAfterSave)
            {
                StateHasChanged();
                await Task.Yield();
                await PrintReturnAsync();
            }
        }
        catch (Exception ex)
        {
            Fail($"Return failed: {ex.Message}");
        }
        finally { isSaving = false; }
    }

    private async Task PaymentSupplierChanged()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        paymentPayable = paymentSupplierId <= 0 ? 0 : await db.SupplierLedgers.Where(x => x.SupplierID == paymentSupplierId).OrderByDescending(x => x.ID).Select(x => (decimal?)x.Balance).FirstOrDefaultAsync() ?? 0;
        if (savedPayment == null && paymentPayable > 0 && paymentAmount == 0)
            paymentAmount = paymentPayable;
    }

    private async Task PostPaymentAsync(bool printAfterSave)
    {
        if (paymentSupplierId <= 0 || paymentAmount <= 0 || string.IsNullOrWhiteSpace(paymentMode))
        {
            Fail("Supplier, amount and payment method are required.");
            return;
        }
        isSaving = true;
        try
        {
            var result = await ResilientTransaction.ExecuteAsync(DbFactory, async db =>
            {
                var payable = await db.SupplierLedgers.Where(x => x.SupplierID == paymentSupplierId).OrderByDescending(x => x.ID).Select(x => (decimal?)x.Balance).FirstOrDefaultAsync() ?? 0;
                if (paymentAmount > payable) throw new InvalidOperationException($"Payment exceeds current due of ৳{payable:N2}.");
                var uid = await CurrentUserIdAsync();
                var now = DateTime.Now;
                var p = new SupplierPayment { SupplierID = paymentSupplierId, Amount = paymentAmount, PaymentMode = paymentMode, EnteredBy = uid, TransDate = now };
                db.SupplierPayments.Add(p);
                await db.SaveChangesAsync();
                db.SupplierLedgers.Add(new SupplierLedger { SupplierID = paymentSupplierId, SupplierPaymentID = p.ID, Debit = paymentAmount, Credit = 0, Balance = payable - paymentAmount, TransDate = now });
                AccountingPosting.AddPostedVoucher(db, "Payment", now, $"Supplier payment to {SupplierName(paymentSupplierId)}", $"SUPPLIER-PAYMENT:{p.ID}", uid, (AccountingPosting.SupplierPayable, paymentAmount, 0), (AccountingPosting.Cash, 0, paymentAmount));
                await db.SaveChangesAsync();
                return (Payment: p, Remaining: payable - paymentAmount);
            }, IsolationLevel.Serializable);

            savedPayment = result.Payment;
            paymentPayable = result.Remaining;
            Success($"Payment voucher #PAY-{result.Payment.ID} saved.");
            await RefreshAfterPostAsync();

            if (printAfterSave)
            {
                StateHasChanged();
                await Task.Yield();
                await PrintPaymentAsync();
            }
        }
        catch (Exception ex)
        {
            Fail($"Payment failed: {ex.Message}");
        }
        finally { isSaving = false; }
    }

    private async Task RefreshAfterPostAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        stocks = await db.MedicineStoreBalances.AsNoTracking().Where(x => x.Balance > 0).ToListAsync();
        recentReturns = await db.MedicineReturns.AsNoTracking().OrderByDescending(x => x.ID).Take(50).ToListAsync();
        recentPayments = await db.SupplierPayments.AsNoTracking().OrderByDescending(x => x.ID).Take(50).ToListAsync();
        await LoadLedgerAsync();
    }

    private async Task LoadLedgerAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var end = toDate.Date.AddDays(1);
        ledger = await db.SupplierLedgers.AsNoTracking()
            .Where(x => (ledgerSupplierId == 0 || x.SupplierID == ledgerSupplierId) && x.TransDate >= fromDate.Date && x.TransDate < end)
            .OrderBy(x => x.SupplierID).ThenBy(x => x.ID).ToListAsync();
    }

    private string LedgerParticulars(SupplierLedger x) => x.SupplierPaymentID.HasValue ? $"Payment #PAY-{x.SupplierPaymentID}" : x.ChallanNo < 0 ? $"Return #PRET-{-x.ChallanNo}" : x.ChallanNo.HasValue ? $"Purchase #PUR-{x.ChallanNo}" : "Opening Balance";

    private async Task<int> CurrentUserIdAsync()
    {
        var u = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        return int.TryParse(u.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : 1;
    }

    private async Task PrintReturnAsync() => await JS.InvokeVoidAsync("hpm.printElement", "medicine-return-print", $"PRET-{savedReturn?.ID}");
    private async Task PrintPaymentAsync() => await JS.InvokeVoidAsync("hpm.printElement", "supplier-payment-print", $"PAY-{savedPayment?.ID}");
    private async Task PrintLedgerAsync() => await JS.InvokeVoidAsync("hpm.printElement", "supplier-ledger-print", "Supplier Statement");

    private void ResetAll()
    {
        savedReturn = null;
        savedPayment = null;
        returnSupplierId = 0;
        returnStoreId = stores.FirstOrDefault(x => x.IsActive)?.ID ?? 1;
        selectedStockId = 0;
        stockSearchQuery = "";
        returnLines = [];
        paymentSupplierId = 0;
        paymentAmount = 0;
        paymentPayable = 0;
        paymentMode = "Cash";
        message = "";
    }

    private string MedicineName(int id) => medicines.FirstOrDefault(x => x.ID == id)?.Name ?? "—";
    private string SupplierName(int id) => suppliers.FirstOrDefault(x => x.ID == id)?.Name ?? "—";
    private string StoreName(int id) => stores.FirstOrDefault(x => x.ID == id)?.Name ?? "—";
    private void Success(string x) { messageClass = "success"; message = x; }
    private void Fail(string x) { messageClass = "danger"; message = x; }

    public void Dispose() => I18n.OnLanguageChanged -= HandleLanguageChanged;

    private sealed record ReturnLine(int StockID, int ServiceID, string BatchNo, decimal Quantity, decimal BuyRate) { public decimal Total => Quantity * BuyRate; }
}
