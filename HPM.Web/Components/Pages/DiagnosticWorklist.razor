@page "/diagnostic/worklist"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.LabTechnician)]
@rendermode InteractiveServer
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@implements IDisposable
@using System.Security.Claims

<PageTitle>@I18n.T("Lab Worklist") | @Branding.HospitalName</PageTitle>

<div class="worklist-classic-fit">
    <div class="worklist-classic-topbar">
        <div class="tickets-top-left">
            <h1 class="tickets-page-title"><span>🔬</span><span>@I18n.T("Lab Receive & Processing Worklist")</span></h1>
            <span class="tickets-count-pill">@filteredItems.Count @I18n.T("Tests")</span>
            @if (!string.IsNullOrWhiteSpace(message)) { <span class="tickets-inline-alert @messageClass">@message</span> }
        </div>
        
        <div class="tickets-top-actions">
            <select class="classic-input tickets-select" @bind="statusFilter" @bind:after="FilterItems">
                <option value="all">@I18n.T("All Statuses")</option><option value="Collected">@I18n.T("Awaiting Lab Receipt")</option><option value="Received">@I18n.T("Received")</option><option value="InProcess">@I18n.T("In Process")</option><option value="Completed">@I18n.T("Completed")</option>
            </select>
            <input class="classic-input" style="width:220px" @bind="search" @bind:event="oninput" @bind:after="FilterItems" placeholder="@I18n.T("Scan tube, memo or patient...")" />
            <button class="btn btn-secondary tickets-btn" @onclick="LoadAsync">🔄 @I18n.T("Refresh")</button>
        </div>
    </div>

    <div class="worklist-classic-workspace"><div class="worklist-card">
        <div class="worklist-header"><h2>@I18n.T("Collected Pathology Samples")</h2><span class="pill">@items.Count(x => x.Status == "Collected") @I18n.T("Awaiting Receipt")</span></div>
        <div class="worklist-table-scroll data-table-wrap"><table class="data-table">
            <thead><tr><th>@I18n.T("Bill / Tube")</th><th>@I18n.T("Patient Details")</th><th>@I18n.T("Test & Specimen")</th><th>@I18n.T("Collected")</th><th>@I18n.T("Status")</th><th>@I18n.T("Action")</th></tr></thead>
            <tbody>
                @if (filteredItems.Count == 0) { <tr><td colspan="6" class="dtm-empty">@I18n.T("No collected pathology samples are waiting in the lab queue.")</td></tr> }
                @foreach (var item in filteredItems)
                {
                    <tr>
                        <td><strong style="color:#0284c7">#@item.MemoID</strong><br/><code>SMP-@item.MemoID-@item.ServiceID</code></td>
                        <td><strong>@item.PatientName</strong><br/><small>@item.PatientID · @item.Age / @item.Sex</small></td>
                        <td><strong>@item.TestName</strong><br/><small>@item.SpecimenType</small></td>
                        <td><small>@item.CollectedAt?.ToString("dd MMM, hh:mm tt")</small></td>
                        <td><span class="pill @(item.Status == "Completed" ? "pill-success" : "")">@I18n.T(DisplayStatus(item.Status))</span>@if (!string.IsNullOrWhiteSpace(item.Remarks)) { <br/><small style="color:#b45309">@item.Remarks</small> }</td>
                        <td style="text-align:right"><div style="display:inline-flex;gap:5px">
                            @if (item.Status == "Collected")
                            {
                                <button class="btn btn-primary tickets-btn" @onclick='() => AdvanceAsync(item, "Received")'>📥 @I18n.T("Receive in Lab")</button>
                                <button class="btn btn-danger tickets-btn" @onclick="() => RejectAsync(item)">@I18n.T("Reject / Recollect")</button>
                            }
                            else if (item.Status == "Received") { <button class="btn btn-primary tickets-btn" @onclick='() => AdvanceAsync(item, "InProcess")'>⚙ @I18n.T("Start Processing")</button> }
                            else if (item.Status == "InProcess") { <button class="btn btn-primary tickets-btn" @onclick='() => AdvanceAsync(item, "Completed")'>✓ @I18n.T("Complete Test")</button> }
                            else { <NavLink class="btn btn-secondary tickets-btn" href="@($"diagnostic/results?memoId={item.MemoID}")">📋 @I18n.T("Enter Result")</NavLink> }
                        </div></td>
                    </tr>
                }
            </tbody>
        </table></div>
    </div></div>
</div>

@code {
    private List<LabItem> items = [];
    private List<LabItem> filteredItems = [];
    private string statusFilter = "all", search = "", message = "", messageClass = "success";
    protected override void OnInitialized()
    {
        Navigation.NavigateTo("diagnostic/results", replace: true);
    }

    protected override async Task OnInitializedAsync() { I18n.OnLanguageChanged += LanguageChanged; await LoadAsync(); }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var categories = await db.ServiceCategories.AsNoTracking().ToDictionaryAsync(x => x.ID);
        var services = await db.Services.AsNoTracking().ToDictionaryAsync(x => x.ID);
        var memos = await db.EmergencyMemos.Include(x => x.Items).AsNoTracking().Where(x => x.ModuleID == 2).OrderByDescending(x => x.ID).Take(300).ToListAsync();
        var memoIds = memos.Select(x => x.ID).ToArray();
        var tracking = await db.LabSampleCollections.AsNoTracking().Where(x => memoIds.Contains(x.MemoID)).ToDictionaryAsync(x => (x.MemoID, x.ServiceID));
        items = memos.SelectMany(m => m.Items.GroupBy(x => x.TestID).Select(g => (Memo: m, ServiceID: g.Key)))
            .Where(x => services.TryGetValue(x.ServiceID, out var s) && DiagnosticTestRouting.IsPathology(s, s.CategoryID.HasValue ? categories.GetValueOrDefault(s.CategoryID.Value) : null))
            .Select(x => { tracking.TryGetValue((x.Memo.ID, x.ServiceID), out var t); return new LabItem { MemoID = x.Memo.ID, ServiceID = x.ServiceID, PatientID = x.Memo.PatientID, PatientName = x.Memo.PatientName, Age = x.Memo.Age ?? "—", Sex = x.Memo.Sex ?? "—", TestName = services[x.ServiceID].Name ?? $"Test #{x.ServiceID}", SpecimenType = t?.SpecimenType ?? "Blood", Status = t?.Status ?? "Pending", CollectedAt = t?.CollectedAt, Remarks = t?.Remarks }; })
            .Where(x => x.Status is "Collected" or "Received" or "InProcess" or "Completed").ToList();
        FilterItems();
    }

    private void FilterItems() { var q = items.AsEnumerable(); if (statusFilter != "all") q = q.Where(x => x.Status == statusFilter); if (!string.IsNullOrWhiteSpace(search)) { var s = search.Trim(); q = q.Where(x => x.MemoID.ToString().Contains(s, StringComparison.OrdinalIgnoreCase) || x.PatientName.Contains(s, StringComparison.OrdinalIgnoreCase) || (x.PatientID?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) || x.TestName.Contains(s, StringComparison.OrdinalIgnoreCase) || $"SMP-{x.MemoID}-{x.ServiceID}".Contains(s, StringComparison.OrdinalIgnoreCase)); } filteredItems = q.ToList(); }

    private async Task AdvanceAsync(LabItem item, string next)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(); var row = await db.LabSampleCollections.SingleAsync(x => x.MemoID == item.MemoID && x.ServiceID == item.ServiceID);
            if (!DiagnosticWorkflow.CanAdvance(row.Status, next)) throw new InvalidOperationException($"Invalid status transition from {row.Status} to {next}.");
            var principal = (await AuthStateProvider.GetAuthenticationStateAsync()).User; var userId = int.TryParse(principal.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : (int?)null; var now = DateTime.Now;
            row.Status = next; row.Remarks = null;
            if (next == "Received") { row.ReceivedAt = now; row.ReceivedBy = userId; }
            else if (next == "InProcess") { row.ProcessingStartedAt = now; row.ProcessingStartedBy = userId; }
            else if (next == "Completed") { row.CompletedAt = now; row.CompletedBy = userId; }
            await db.SaveChangesAsync(); item.Status = next; item.Remarks = null; Success($"{item.TestName} updated to {DisplayStatus(next)}."); FilterItems();
        }
        catch (Exception ex) { Fail(ex.GetBaseException().Message); await LoadAsync(); }
    }

    private async Task RejectAsync(LabItem item)
    {
        await using var db = await DbFactory.CreateDbContextAsync(); var row = await db.LabSampleCollections.SingleAsync(x => x.MemoID == item.MemoID && x.ServiceID == item.ServiceID);
        row.Status = "Pending"; row.CollectedAt = null; row.CollectedBy = null; row.ReceivedAt = null; row.ReceivedBy = null; row.Remarks = "Rejected by laboratory — recollection required"; await db.SaveChangesAsync();
        Success($"{item.TestName} sent back for recollection."); await LoadAsync();
    }

    private static string DisplayStatus(string status) => status switch { "Collected" => "Awaiting Lab Receipt", "Received" => "Received in Lab", "InProcess" => "In Process", _ => status };
    private void Success(string text) { messageClass = "success"; message = text; } private void Fail(string text) { messageClass = "danger"; message = text; }
    private void LanguageChanged() => InvokeAsync(StateHasChanged); public void Dispose() => I18n.OnLanguageChanged -= LanguageChanged;
    private sealed class LabItem { public long MemoID { get; set; } public int ServiceID { get; set; } public string? PatientID { get; set; } public string PatientName { get; set; } = ""; public string Age { get; set; } = ""; public string Sex { get; set; } = ""; public string TestName { get; set; } = ""; public string SpecimenType { get; set; } = ""; public string Status { get; set; } = ""; public DateTime? CollectedAt { get; set; } public string? Remarks { get; set; } }
}
