                                <option value="@BedStatuses.Cleaning">🟡 @I18n.T("Cleaning", "পরিচ্ছন্নতা চলছে")</option>
                                <option value="@BedStatuses.Maintenance">⚙️ @I18n.T("Maintenance", "রক্ষণাবেক্ষণ / মেরামত")</option>
