@page "/masters/ipd"
@attribute [Authorize(Roles = RoleNames.Administrator)]
@rendermode InteractiveServer
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@I18n.T("IPD & Bed Masters") | @Branding.HospitalName</PageTitle>

<div class="page-heading">
    <div>
        <a class="back-link" href="masters">&larr; @I18n.T("Master setup")</a>
        <h1>@I18n.T("IPD & Bed Masters", "আইপিডি ও বেড ব্যবস্থাপনা")</h1>
        <p>@I18n.T("Configure hospital departments, ward categories, bed matrix and pricing.", "হাসপাতালের বিভাগ, ওয়ার্ড ক্যাটাগরি, বেড বিন্যাস ও চার্জসমূহ পরিচালনা করুন।")</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @messageClass" style="margin-bottom: 16px;">
        @message
    </div>
}

<!-- Top KPI Summary Cards -->
<div class="metric-grid">
    <div class="metric-card accent-blue">
        <span>@I18n.T("Total Beds & Cabins", "মোট বেড ও কেবিন")</span>
        <strong>@beds.Count</strong>
        <small>@categories.Count @I18n.T("Categories") &bull; @departments.Count @I18n.T("Departments")</small>
    </div>
    <div class="metric-card accent-green">
        <span>@I18n.T("Available Beds", "ফাঁকা বেড (উপলব্ধ)")</span>
        <strong>@AvailableBedsCount</strong>
        <small>@I18n.T("Ready for immediate admission", "রোগী ভর্তির জন্য প্রস্তুত")</small>
    </div>
    <div class="metric-card accent-red">
        <span>@I18n.T("Occupied Beds", "ভর্তি রোগী রয়েছে")</span>
        <strong>@OccupiedBedsCount</strong>
        <small>@OccupancyRate% @I18n.T("Occupancy Rate", "অকুপেন্সি রেট")</small>
    </div>
    <div class="metric-card accent-amber">
        <span>@I18n.T("Cleaning & Maintenance", "পরিচ্ছন্নতা ও রক্ষণাবেক্ষণ")</span>
        <strong>@CleaningMaintenanceCount</strong>
        <small>@CleaningBedsCount @I18n.T("Cleaning") &bull; @MaintenanceBedsCount @I18n.T("Maintenance")</small>
    </div>
</div>

<!-- Navigation Tabs -->
<div class="ipd-tabs-nav">
    <button type="button" class="ipd-tab-btn @(activeTab == "beds" ? "active" : "")" @onclick='() => SetTab("beds")'>
        <span>🛏️ @I18n.T("Beds & Cabins", "বেড ও কেবিনসমূহ")</span>
        <span class="ipd-tab-count">@beds.Count</span>
    </button>
    <button type="button" class="ipd-tab-btn @(activeTab == "categories" ? "active" : "")" @onclick='() => SetTab("categories")'>
        <span>🏷️ @I18n.T("Categories & Pricing", "ক্যাটাগরি ও মূল্য তালিকা")</span>
        <span class="ipd-tab-count">@categories.Count</span>
    </button>
    <button type="button" class="ipd-tab-btn @(activeTab == "departments" ? "active" : "")" @onclick='() => SetTab("departments")'>
        <span>🏢 @I18n.T("IPD Departments", "আইপিডি বিভাগসমূহ")</span>
        <span class="ipd-tab-count">@departments.Count</span>
    </button>
    <button type="button" class="ipd-tab-btn @(activeTab == "bulk" ? "active" : "")" @onclick='() => SetTab("bulk")'>
        <span>⚡ @I18n.T("Bulk Bed Generator", "একসাথে বহু বেড তৈরি")</span>
    </button>
</div>

<!-- ==========================================
     TAB 1: BEDS & CABINS (MATRIX & TABLE)
     ========================================== -->
@if (activeTab == "beds")
{
    <!-- Filter Toolbar -->
    <div class="ipd-toolbar">
        <div class="ipd-toolbar-filters">
            <!-- Search -->
            <div class="ipd-search-box">
                <input type="text"
                       class="classic-input"
                       placeholder="@I18n.T("Search bed, category, patient...", "বেড, ক্যাটাগরি বা রোগী খুঁজুন...")"
                       @bind="bedSearchQuery"
                       @bind:event="oninput" />
            </div>

            <!-- Category Filter -->
            <select class="classic-input" style="max-width: 200px;" @bind="selectedCategoryFilter">
                <option value="0">@I18n.T("All Categories", "সকল ক্যাটাগরি") (@beds.Count)</option>
                @foreach (var cat in categories)
                {
                    var catBedCount = beds.Count(b => b.CategoryID == cat.ID);
                    <option value="@cat.ID">@cat.Name (@catBedCount)</option>
                }
            </select>

            <!-- Status Filter Pills -->
            <div class="ipd-status-filters">
                <button type="button" class="ipd-status-chip @(selectedStatusFilter == "All" ? "active" : "")" @onclick='() => selectedStatusFilter = "All"'>
                    @I18n.T("All") (@beds.Count)
                </button>
                <button type="button" class="ipd-status-chip @(selectedStatusFilter == "Available" ? "active" : "")" @onclick='() => selectedStatusFilter = "Available"'>
                    🟢 @I18n.T("Available") (@AvailableBedsCount)
                </button>
                <button type="button" class="ipd-status-chip @(selectedStatusFilter == "Occupied" ? "active" : "")" @onclick='() => selectedStatusFilter = "Occupied"'>
                    🔴 @I18n.T("Occupied") (@OccupiedBedsCount)
                </button>
                <button type="button" class="ipd-status-chip @(selectedStatusFilter == "Cleaning" ? "active" : "")" @onclick='() => selectedStatusFilter = "Cleaning"'>
                    🟡 @I18n.T("Cleaning") (@CleaningBedsCount)
                </button>
                <button type="button" class="ipd-status-chip @(selectedStatusFilter == "Maintenance" ? "active" : "")" @onclick='() => selectedStatusFilter = "Maintenance"'>
                    ⚙️ @I18n.T("Maintenance") (@MaintenanceBedsCount)
                </button>
            </div>
        </div>

        <div style="display: flex; gap: 8px; align-items: center;">
            <!-- View Mode Switch -->
            <div class="ipd-status-filters">
                <button type="button" class="ipd-status-chip @(bedViewMode == "grid" ? "active" : "")" @onclick='() => bedViewMode = "grid"' title="@I18n.T("Grid View")">
                    🪟 @I18n.T("Grid")
                </button>
                <button type="button" class="ipd-status-chip @(bedViewMode == "table" ? "active" : "")" @onclick='() => bedViewMode = "table"' title="@I18n.T("Table View")">
                    📑 @I18n.T("Table")
                </button>
            </div>

            <!-- Add Bed Button -->
            <button type="button" class="btn btn-primary" @onclick="OpenAddBedDrawer">
                + @I18n.T("Add Bed/Cabin", "নতুন বেড যোগ করুন")
            </button>
        </div>
    </div>

    <!-- Bed List / Grid Display -->
    @if (FilteredBeds.Count == 0)
    {
        <div class="panel" style="text-align: center; padding: 40px; color: #64748b;">
            <p style="font-size: 16px; font-weight: 700; margin-bottom: 8px;">@I18n.T("No beds found matching the criteria.", "কোনো বেড বা কেবিন পাওয়া যায়নি।")</p>
            <button type="button" class="btn btn-outline" @onclick="ResetBedFilters">@I18n.T("Clear Filters", "ফিল্টার রিসেট করুন")</button>
        </div>
    }
    else if (bedViewMode == "grid")
    {
        <!-- Grid Matrix View -->
        <div class="bed-matrix-grid">
            @foreach (var item in FilteredBeds)
            {
                var effectiveStatus = GetEffectiveStatus(item);
                var statusClass = effectiveStatus.ToLowerInvariant();
                var hasPatient = activeAdmissions.TryGetValue(item.ID, out var patInfo);
                var cat = categories.FirstOrDefault(c => c.ID == item.CategoryID);
                var deptName = cat != null ? DepartmentName(cat.IpdDepartmentID) : "—";

                <div class="bed-matrix-card status-@statusClass">
                    <div>
                        <!-- Header -->
                        <div class="bed-card-header">
                            <div class="bed-card-title">
                                <span class="bed-card-name">@item.Name</span>
                                <span class="bed-card-cat" title="@I18n.T("Category & Department")">
                                    @(cat?.Name ?? I18n.T("Unassigned")) &bull; @deptName
                                </span>
                            </div>
                            <span class="pill" style="font-size: 11px; font-weight: 800; @GetStatusPillStyle(effectiveStatus)">
                                @GetStatusLabel(effectiveStatus)
                            </span>
                        </div>

                        <!-- Occupant Info / Bed State -->
                        @if (item.IsAllocated && hasPatient && patInfo != null)
                        {
                            <div class="bed-patient-box">
                                <div class="bed-patient-name">
                                    <span>👤 @patInfo.PatientName</span>
                                    @if (!string.IsNullOrEmpty(patInfo.Gender))
                                    {
                                        <span style="font-size: 11px; opacity: 0.85;">(@patInfo.Gender)</span>
                                    }
                                </div>
                                <div class="bed-patient-meta">
                                    <div><b>@I18n.T("Reg No"):</b> @patInfo.RegNo &bull; <b>@I18n.T("PID"):</b> @patInfo.PatientID</div>
                                    @if (patInfo.AdmissionDate.HasValue)
                                    {
                                        <div><b>@I18n.T("Admitted"):</b> @patInfo.AdmissionDate.Value.ToString("dd-MMM-yyyy")</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(patInfo.DoctorName))
                                    {
                                        <div style="margin-top: 2px;"><b>@I18n.T("Consultant"):</b> @patInfo.DoctorName</div>
                                    }
                                </div>
                            </div>
                        }
                        else if (!item.IsAllocated)
                        {
                            <div style="padding: 12px 0 6px; font-size: 12px; color: #64748b;">
                                @if (effectiveStatus == BedStatuses.Available)
                                {
                                    <div style="color: #059669; font-weight: 700;">
                                        ✓ @I18n.T("Ready for patient admission", "ভর্তির জন্য সম্পূর্ণরূপে প্রস্তুত")
                                    </div>
                                    <div style="font-size: 11px; color: #64748b; margin-top: 3px;">
                                        @I18n.T("Rate"): @I18n.FormatCurrency(cat?.Rate ?? 0) / @I18n.T("day")
                                    </div>
                                }
                                else if (effectiveStatus == BedStatuses.Cleaning)
                                {
                                    <div style="color: #d97706; font-weight: 700;">
                                        🧹 @I18n.T("Under housekeeping / sanitization", "হাউজকিপিং ও পরিচ্ছন্নতা চলছে")
                                    </div>
                                }
                                else if (effectiveStatus == BedStatuses.Maintenance)
                                {
                                    <div style="color: #64748b; font-weight: 700;">
                                        ⚙️ @I18n.T("Under maintenance / repair", "মেরামত ও রক্ষণাবেক্ষণ চলছে")
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Footer & Quick Actions -->
                    <div class="bed-card-footer">
                        <div style="display: flex; gap: 4px;">
                            @if (!item.IsAllocated)
                            {
                                @if (effectiveStatus != BedStatuses.Available)
                                {
                                    <button type="button" class="bed-quick-status-btn" style="color: #059669;" @onclick='() => UpdateBedStatusAsync(item, BedStatuses.Available)' title="@I18n.T("Set Available")">
                                        ✓ @I18n.T("Ready")
                                    </button>
                                }
                                @if (effectiveStatus != BedStatuses.Cleaning)
                                {
                                    <button type="button" class="bed-quick-status-btn" style="color: #d97706;" @onclick='() => UpdateBedStatusAsync(item, BedStatuses.Cleaning)' title="@I18n.T("Set Cleaning")">
                                        🧹 @I18n.T("Clean")
                                    </button>
                                }
                                @if (effectiveStatus != BedStatuses.Maintenance)
                                {
                                    <button type="button" class="bed-quick-status-btn" style="color: #64748b;" @onclick='() => UpdateBedStatusAsync(item, BedStatuses.Maintenance)' title="@I18n.T("Set Maintenance")">
                                        ⚙️
                                    </button>
                                }
                            }
                        </div>

                        <div style="display: flex; gap: 6px;">
                            <button type="button" class="icon-btn" @onclick="() => SelectBed(item)" title="@I18n.T("Edit Bed")">
                                ✏️ @I18n.T("Edit")
                            </button>
                            @if (!item.IsAllocated)
                            {
                                <button type="button" class="icon-btn" style="color: #ef4444;" @onclick="() => DeleteBedDirectAsync(item)" title="@I18n.T("Delete Bed")">
                                    🗑️
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Table View -->
        <div class="panel form-panel">
            <div class="data-table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@I18n.T("Bed/Cabin Name", "বেড/কেবিন")</th>
                            <th>@I18n.T("Category", "ক্যাটাগরি")</th>
                            <th>@I18n.T("Department", "বিভাগ")</th>
                            <th>@I18n.T("Daily Rate", "দৈনিক ভাড়া")</th>
                            <th>@I18n.T("Status", "স্ট্যাটাস")</th>
                            <th>@I18n.T("Current Occupant", "বর্তমান রোগী")</th>
                            <th style="text-align: right;">@I18n.T("Actions")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in FilteredBeds)
                        {
                            var effectiveStatus = GetEffectiveStatus(item);
                            var cat = categories.FirstOrDefault(c => c.ID == item.CategoryID);
                            var hasPatient = activeAdmissions.TryGetValue(item.ID, out var patInfo);

                            <tr>
                                <td><b>@item.Name</b></td>
                                <td>@(cat?.Name ?? "—")</td>
                                <td>@(cat != null ? DepartmentName(cat.IpdDepartmentID) : "—")</td>
                                <td>@I18n.FormatCurrency(cat?.Rate ?? 0)</td>
                                <td>
                                    <span class="pill" style="@GetStatusPillStyle(effectiveStatus)">
                                        @GetStatusLabel(effectiveStatus)
                                    </span>
                                </td>
                                <td>
                                    @if (item.IsAllocated && hasPatient && patInfo != null)
                                    {
                                        <div>
                                            <b>@patInfo.PatientName</b>
                                            <span style="font-size: 11px; color: #64748b;">(Reg: @patInfo.RegNo)</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span style="color: #94a3b8;">—</span>
                                    }
                                </td>
                                <td style="text-align: right;">
                                    <button class="icon-btn" @onclick="() => SelectBed(item)">@I18n.T("Edit")</button>
                                    @if (!item.IsAllocated)
                                    {
                                        <button class="icon-btn" style="color: #ef4444;" @onclick="() => DeleteBedDirectAsync(item)">@I18n.T("Delete")</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

<!-- ==========================================
     TAB 2: CATEGORIES & PRICING
     ========================================== -->
@if (activeTab == "categories")
{
    <div class="master-layout">
        <!-- Form Panel -->
        <div class="panel form-panel">
            <div class="panel-heading">
                <div>
                    <h2>@(category.ID == 0 ? I18n.T("Add Bed Category", "নতুন বেড ক্যাটাগরি") : $"{I18n.T("Edit Category")} #{category.ID}")</h2>
                    <p>@I18n.T("Set room rates, service charges and admission fees", "রুম ভাড়া, সার্ভিস চার্জ ও ভর্তি ফি নির্ধারণ করুন")</p>
                </div>
                <button type="button" class="icon-btn" @onclick="ResetCategory">@I18n.T("New")</button>
            </div>
            <EditForm Model="category" OnSubmit="SaveCategoryAsync">
                <div class="form-grid">
                    <label class="span-2">
                        <span>@I18n.T("Category Name *", "ক্যাটাগরির নাম *")</span>
                        <InputText class="classic-input" @bind-Value="category.Name" placeholder="e.g. VIP Cabin, Deluxe AC, General Ward" />
                    </label>
                    <label class="span-2">
                        <span>@I18n.T("IPD Department *", "আইপিডি বিভাগ *")</span>
                        <InputSelect class="classic-input" @bind-Value="category.IpdDepartmentID">
                            <option value="">@I18n.T("Select Department", "বিভাগ নির্বাচন করুন")</option>
                            @foreach (var item in departments)
                            {
                                <option value="@item.ID">@item.Name</option>
                            }
                        </InputSelect>
                    </label>
                    <label>
                        <span>@I18n.T("Daily Bed Rate (Rent)", "দৈনিক বেড ভাড়া")</span>
                        <InputNumber class="classic-input" @bind-Value="category.Rate" />
                    </label>
                    <label>
                        <span>@I18n.T("Daily Service Charge", "দৈনিক সার্ভিস চার্জ")</span>
                        <InputNumber class="classic-input" @bind-Value="category.ServiceCharge" />
                    </label>
                    <label>
                        <span>@I18n.T("Daily Food Charge", "দৈনিক খাবারের চার্জ")</span>
                        <InputNumber class="classic-input" @bind-Value="category.Food" />
                    </label>
                    <label>
                        <span>@I18n.T("Admission Fee (One-time)", "ভর্তি ফি (এককালীন)")</span>
                        <InputNumber class="classic-input" @bind-Value="category.AdmissionFee" />
                    </label>
                    <label class="span-2">
                        <span>@I18n.T("Specification / Facilities", "সুবিধাসমূহ / বিবরণ")</span>
                        <InputTextArea class="classic-input" @bind-Value="category.Specification" placeholder="e.g. AC, Attached Bath, LED TV, Attendant Bed" rows="2" />
                    </label>
                </div>

                <!-- Live Calculated Cost Breakdown -->
                <div class="pricing-calc-card">
                    <div style="font-weight: 800; font-size: 12px; color: #0f172a; margin-bottom: 8px;">
                        💡 @I18n.T("Estimated Daily Cost per Patient", "রোগীর আনুমানিক দৈনিক খরচ:")
                    </div>
                    <div class="pricing-calc-row">
                        <span>@I18n.T("Daily Bed Rent"):</span>
                        <span>@I18n.FormatCurrency(category.Rate ?? 0)</span>
                    </div>
                    <div class="pricing-calc-row">
                        <span>@I18n.T("Daily Service Charge"):</span>
                        <span>+ @I18n.FormatCurrency(category.ServiceCharge ?? 0)</span>
                    </div>
                    <div class="pricing-calc-row">
                        <span>@I18n.T("Daily Food Charge"):</span>
                        <span>+ @I18n.FormatCurrency(category.Food ?? 0)</span>
                    </div>
                    <div class="pricing-calc-total">
                        <span>@I18n.T("Total Daily Charge"):</span>
                        <span>@I18n.FormatCurrency((category.Rate ?? 0) + (category.ServiceCharge ?? 0) + (category.Food ?? 0)) / @I18n.T("day")</span>
                    </div>
                    @if ((category.AdmissionFee ?? 0) > 0)
                    {
                        <div style="margin-top: 6px; font-size: 11px; color: #64748b; text-align: right;">
                            (@I18n.T("One-time Admission Fee"): @I18n.FormatCurrency(category.AdmissionFee ?? 0))
                        </div>
                    }
                </div>

                <div class="form-actions" style="margin-top: 16px;">
                    <button class="btn btn-primary">@I18n.T("Save Category", "ক্যাটাগরি সংরক্ষণ করুন")</button>
                    @if (category.ID > 0)
                    {
                        <button type="button" class="btn btn-ghost" @onclick="DeleteCategoryAsync">@I18n.T("Delete")</button>
                    }
                </div>
            </EditForm>
        </div>

        <!-- Table Panel -->
        <div class="panel form-panel">
            <div class="panel-heading">
                <div>
                    <h2>@I18n.T("Existing Categories", "বিদ্যমান ক্যাটাগরিসমূহ") (@categories.Count)</h2>
                </div>
            </div>
            <div class="data-table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@I18n.T("Category")</th>
                            <th>@I18n.T("Department")</th>
                            <th class="num">@I18n.T("Daily Total")</th>
                            <th class="num">@I18n.T("Beds")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in categories)
                        {
                            var totalDaily = (item.Rate ?? 0) + (item.ServiceCharge ?? 0) + (item.Food ?? 0);
                            var bedCount = beds.Count(b => b.CategoryID == item.ID);
                            <tr>
                                <td>
                                    <b>@item.Name</b>
                                    @if (!string.IsNullOrWhiteSpace(item.Specification))
                                    {
                                        <div style="font-size: 11px; color: #64748b;">@item.Specification</div>
                                    }
                                </td>
                                <td>@DepartmentName(item.IpdDepartmentID)</td>
                                <td class="num">
                                    <b>@I18n.FormatCurrency(totalDaily)</b>
                                    <div style="font-size: 10px; color: #64748b;">
                                        (Rent: @I18n.FormatCurrency(item.Rate ?? 0))
                                    </div>
                                </td>
                                <td class="num"><span class="pill">@bedCount</span></td>
                                <td><button class="icon-btn" @onclick="() => SelectCategory(item)">@I18n.T("Edit")</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- ==========================================
     TAB 3: IPD DEPARTMENTS
     ========================================== -->
@if (activeTab == "departments")
{
    <div class="master-layout">
        <!-- Form Panel -->
        <div class="panel form-panel">
            <div class="panel-heading">
                <div>
                    <h2>@(department.ID == 0 ? I18n.T("Add IPD Department", "নতুন আইপিডি বিভাগ") : $"{I18n.T("Edit Department")} #{department.ID}")</h2>
                    <p>@I18n.T("Define clinical departments for inpatient wards", "ইনপেশেন্ট ওয়ার্ডের ক্লিনিক্যাল বিভাগসমূহ নির্ধারণ করুন")</p>
                </div>
                <button type="button" class="icon-btn" @onclick="ResetDepartment">@I18n.T("New")</button>
            </div>
            <EditForm Model="department" OnSubmit="SaveDepartmentAsync">
                <div class="form-grid">
                    <label class="span-2">
                        <span>@I18n.T("Department Name *", "বিভাগের নাম *")</span>
                        <InputText class="classic-input" @bind-Value="department.Name" placeholder="e.g. Medicine, General Surgery, Gynecology, ICU" />
                    </label>
                </div>
                <div class="form-actions" style="margin-top: 16px;">
                    <button class="btn btn-primary">@I18n.T("Save Department", "বিভাগ সংরক্ষণ করুন")</button>
                    @if (department.ID > 0)
                    {
                        <button type="button" class="btn btn-ghost" @onclick="DeleteDepartmentAsync">@I18n.T("Delete")</button>
                    }
                </div>
            </EditForm>
        </div>

        <!-- Table Panel -->
        <div class="panel form-panel">
            <div class="panel-heading">
                <div>
                    <h2>@I18n.T("Configured Departments", "নিবন্ধিত বিভাগসমূহ") (@departments.Count)</h2>
                </div>
            </div>
            <div class="data-table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@I18n.T("Department")</th>
                            <th class="num">@I18n.T("Categories")</th>
                            <th class="num">@I18n.T("Total Beds")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in departments)
                        {
                            var catCount = categories.Count(c => c.IpdDepartmentID == item.ID);
                            var deptCatIds = categories.Where(c => c.IpdDepartmentID == item.ID).Select(c => c.ID).ToHashSet();
                            var bedCount = beds.Count(b => deptCatIds.Contains(b.CategoryID));
                            <tr>
                                <td><b>@item.Name</b></td>
                                <td class="num"><span class="pill">@catCount</span></td>
                                <td class="num"><span class="pill">@bedCount</span></td>
                                <td><button class="icon-btn" @onclick="() => SelectDepartment(item)">@I18n.T("Edit")</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

