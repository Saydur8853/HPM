            </label>

            <label>
                <span>@I18n.T("Name Prefix", "নামের প্রিফিক্স")</span>
                <input type="text" class="classic-input" @bind="bulkPrefix" placeholder="e.g. Bed-, Cabin-, ICU-" />
            </label>

            <label>
                <span>@I18n.T("Name Suffix (Optional)", "সাফিক্স (ঐচ্ছিক)")</span>
                <input type="text" class="classic-input" @bind="bulkSuffix" placeholder="e.g. -A, -East" />
            </label>

            <label>
                <span>@I18n.T("Start Number", "শুরুর নম্বর")</span>
                <input type="number" class="classic-input" @bind="bulkStart" min="1" max="9999" />
            </label>

            <label>
                <span>@I18n.T("End Number", "শেষ নম্বর")</span>
                <input type="number" class="classic-input" @bind="bulkEnd" min="1" max="9999" />
            </label>

            <label>
                <span>@I18n.T("Zero Padding", "শূন্য প্যাডিং")</span>
                <select class="classic-input" @bind="bulkZeroPad">
                    <option value="0">@I18n.T("No Padding (1, 2, 3...)")</option>
                    <option value="2">@I18n.T("2 Digits (01, 02, 03...)")</option>
                    <option value="3">@I18n.T("3 Digits (001, 002, 003...)")</option>
                    <option value="4">@I18n.T("4 Digits (0001, 0002...)")</option>
                </select>
            </label>

            <label>
                <span>@I18n.T("Initial Status", "প্রাথমিক অবস্থা")</span>
                <select class="classic-input" @bind="bulkStatus">
                    <option value="@BedStatuses.Available">🟢 @I18n.T("Available", "ফাঁকা (প্রস্তুত)")</option>
                    <option value="@BedStatuses.Cleaning">🟡 @I18n.T("Cleaning", "পরিচ্ছন্নতা চলছে")</option>
                    <option value="@BedStatuses.Maintenance">⚙️ @I18n.T("Maintenance", "রক্ষণাবেক্ষণ")</option>
                </select>
            </label>
        </div>

        <!-- Live Preview -->
        @{
            var previewList = GetBulkPreview();
            var newCount = previewList.Count(x => !x.Exists);
            var dupCount = previewList.Count(x => x.Exists);
        }

        <div class="bulk-preview-wrap">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <span style="font-weight: 800; font-size: 13px; color: #0f172a;">
                    🔍 @I18n.T("Live Preview", "প্রিভিউ:") (@previewList.Count @I18n.T("total"))
                </span>
                <div style="font-size: 12px;">
                    <span style="color: #059669; font-weight: 700;">✅ @newCount @I18n.T("Ready to create")</span>
                    @if (dupCount > 0)
                    {
                        <span style="color: #e11d48; font-weight: 700; margin-left: 10px;">⚠️ @dupCount @I18n.T("Already exist (skipped)")</span>
                    }
                </div>
            </div>

            @if (previewList.Count > 0)
            {
                <div class="bulk-chips-container">
                    @foreach (var p in previewList)
                    {
                        <span class="bulk-bed-chip @(p.Exists ? "is-dup" : "is-new")" title="@(p.Exists ? I18n.T("Already exists") : I18n.T("New bed"))">
                            @(p.Exists ? "⚠️" : "✓") @p.Name
                        </span>
                    }
                </div>
            }
            else
            {
                <p style="font-size: 12px; color: #64748b; margin-top: 8px;">
                    @I18n.T("Set valid start and end numbers (maximum 100 at a time) to see preview.", "সঠিক শুরু ও শেষ নম্বর নির্ধারণ করুন (একবারে সর্বোচ্চ ১০০টি)।")
                </p>
            }
        </div>

        <div class="form-actions" style="margin-top: 20px;">
            <button type="button" class="btn btn-primary" disabled="@(newCount == 0 || bulkCategoryId <= 0)" @onclick="GenerateBedsAsync">
                ⚡ @I18n.T("Generate") @newCount @I18n.T("Beds Now", "টি বেড এক ক্লিকে তৈরি করুন")
            </button>
        </div>
    </div>
}

