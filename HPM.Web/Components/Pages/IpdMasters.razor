                <p>@I18n.T("Quickly generate a sequence of beds (e.g. Bed-101 to Bed-120 or Cabin-01 to Cabin-10) with one click.", "এক ক্লিকে ধারাবাহিকভাবে বহু বেড বা কেবিন তৈরি করুন।")</p>
            </div>
        </div>

        <div class="form-grid">
            <label class="span-2">
                <span>@I18n.T("Target Bed Category *", "বেড ক্যাটাগরি *")</span>
                <select class="classic-input" @bind="bulkCategoryId">
                    <option value="0">@I18n.T("Select Category", "ক্যাটাগরি নির্বাচন করুন")</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.ID">@cat.Name (@DepartmentName(cat.IpdDepartmentID))</option>
                    }
