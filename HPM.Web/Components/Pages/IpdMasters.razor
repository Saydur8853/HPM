}

@code {
    private string activeTab = "beds";
    private string bedViewMode = "grid";
    private string bedSearchQuery = string.Empty;
    private int selectedCategoryFilter = 0;
    private string selectedStatusFilter = "All";

    private bool showBedDrawer = false;

    // Entities
    private IpdDepartment department = new();
    private BedCategory category = new();
    private BedCabin bed = new();

    private List<IpdDepartment> departments = [];
    private List<BedCategory> categories = [];
    private List<BedCabin> beds = [];

    // Bulk generator fields
    private int bulkCategoryId;
    private string bulkPrefix = "Bed-";
    private string bulkSuffix = string.Empty;
    private int bulkStart = 1;
    private int bulkEnd = 10;
    private int bulkZeroPad = 2;
    private string bulkStatus = BedStatuses.Available;

    private string message = "";
    private string messageClass = "success";

    private class AdmittedPatientInfo
    {
        public string RegNo { get; set; } = string.Empty;
        public string PatientID { get; set; } = string.Empty;
        public string PatientName { get; set; } = string.Empty;
        public string Gender { get; set; } = string.Empty;
        public DateTime? AdmissionDate { get; set; }
        public string DoctorName { get; set; } = string.Empty;
    }

    private Dictionary<int, AdmittedPatientInfo> activeAdmissions = new();

    // KPI computed properties
    private int OccupiedBedsCount => beds.Count(b => b.IsAllocated);
    private int AvailableBedsCount => beds.Count(b => !b.IsAllocated && (b.Status == BedStatuses.Available || string.IsNullOrEmpty(b.Status)));
    private int CleaningBedsCount => beds.Count(b => !b.IsAllocated && b.Status == BedStatuses.Cleaning);
    private int MaintenanceBedsCount => beds.Count(b => !b.IsAllocated && b.Status == BedStatuses.Maintenance);
    private int CleaningMaintenanceCount => CleaningBedsCount + MaintenanceBedsCount;
    private double OccupancyRate => beds.Count == 0 ? 0 : Math.Round((double)OccupiedBedsCount / beds.Count * 100, 1);

    // Filtered Beds
    private List<BedCabin> FilteredBeds
    {
        get
        {
            var q = beds.AsEnumerable();

            if (selectedCategoryFilter > 0)
            {
                q = q.Where(b => b.CategoryID == selectedCategoryFilter);
            }

            if (selectedStatusFilter == "Available")
            {
                q = q.Where(b => !b.IsAllocated && (b.Status == BedStatuses.Available || string.IsNullOrEmpty(b.Status)));
            }
            else if (selectedStatusFilter == "Occupied")
            {
                q = q.Where(b => b.IsAllocated);
            }
            else if (selectedStatusFilter == "Cleaning")
            {
                q = q.Where(b => !b.IsAllocated && b.Status == BedStatuses.Cleaning);
            }
            else if (selectedStatusFilter == "Maintenance")
            {
                q = q.Where(b => !b.IsAllocated && b.Status == BedStatuses.Maintenance);
            }

            if (!string.IsNullOrWhiteSpace(bedSearchQuery))
            {
                var term = bedSearchQuery.Trim();
                q = q.Where(b =>
                    b.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || (categories.FirstOrDefault(c => c.ID == b.CategoryID)?.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (activeAdmissions.TryGetValue(b.ID, out var pat) && (
                        pat.PatientName.Contains(term, StringComparison.OrdinalIgnoreCase)
                        || pat.PatientID.Contains(term, StringComparison.OrdinalIgnoreCase)
                        || pat.RegNo.Contains(term, StringComparison.OrdinalIgnoreCase)
                    ))
                );
            }

            return q.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        await LoadAsync();
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    private void SetTab(string tab)
    {
        activeTab = tab;
        message = string.Empty;
    }

    private void ResetBedFilters()
    {
        bedSearchQuery = string.Empty;
        selectedCategoryFilter = 0;
        selectedStatusFilter = "All";
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        departments = await db.IpdDepartments.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
        categories = await db.BedCategories.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
        beds = await db.BedCabins.AsNoTracking().OrderBy(x => x.Name).ToListAsync();

        if (bulkCategoryId == 0 && categories.Count > 0)
        {
            bulkCategoryId = categories[0].ID;
        }

        // Load active patient admissions
        activeAdmissions.Clear();
        var rawAdmissions = await db.PatientAdmissions.AsNoTracking()
            .Where(x => x.IsAdmitted == true && x.BedCabinID != null)
            .Select(x => new
            {
                BedCabinId = x.BedCabinID!.Value,
                RegNo = x.RegNo,
                PatientId = x.PatientID,
                AdmissionDate = x.AdmissionDate,
                ConsultantId = x.Consultant
            })
            .ToListAsync();

        if (rawAdmissions.Count > 0)
        {
            var pids = rawAdmissions.Where(a => !string.IsNullOrEmpty(a.PatientId)).Select(a => a.PatientId!).Distinct().ToList();
            var docIds = rawAdmissions.Where(a => a.ConsultantId.HasValue).Select(a => a.ConsultantId!.Value).Distinct().ToList();

            var patientMap = await db.Registrations.AsNoTracking()
                .Where(p => pids.Contains(p.PatientID))
                .Select(p => new { p.PatientID, p.Name, p.Sex })
                .ToDictionaryAsync(p => p.PatientID, p => p);

            var doctorMap = await db.Doctors.AsNoTracking()
                .Where(d => docIds.Contains(d.ID))
                .Select(d => new { d.ID, d.Name })
                .ToDictionaryAsync(d => d.ID, d => d.Name);

            foreach (var adm in rawAdmissions)
            {
                patientMap.TryGetValue(adm.PatientId ?? string.Empty, out var pat);
                doctorMap.TryGetValue(adm.ConsultantId ?? 0, out var docName);

                activeAdmissions[adm.BedCabinId] = new AdmittedPatientInfo
                {
                    RegNo = adm.RegNo,
                    PatientID = adm.PatientId ?? string.Empty,
                    PatientName = pat?.Name ?? I18n.T("Admitted Patient"),
                    Gender = pat?.Sex ?? "",
                    AdmissionDate = adm.AdmissionDate,
                    DoctorName = docName ?? ""
                };
            }
        }
    }

    private string GetEffectiveStatus(BedCabin b)
    {
        if (b.IsAllocated) return BedStatuses.Occupied;
        if (string.Equals(b.Status, BedStatuses.Cleaning, StringComparison.OrdinalIgnoreCase)) return BedStatuses.Cleaning;
        if (string.Equals(b.Status, BedStatuses.Maintenance, StringComparison.OrdinalIgnoreCase)) return BedStatuses.Maintenance;
        return BedStatuses.Available;
    }

    private string GetStatusLabel(string status)
    {
        return status switch
        {
            BedStatuses.Occupied => I18n.IsBangla ? "ভর্তি রোগী" : "OCCUPIED",
            BedStatuses.Cleaning => I18n.IsBangla ? "পরিচ্ছন্নতা" : "CLEANING",
            BedStatuses.Maintenance => I18n.IsBangla ? "রক্ষণাবেক্ষণ" : "MAINTENANCE",
            _ => I18n.IsBangla ? "ফাঁকা (প্রস্তুত)" : "AVAILABLE"
        };
    }

    private string GetStatusPillStyle(string status)
    {
        return status switch
        {
            BedStatuses.Occupied => "background: #ffe4e6; color: #9f1239; border: 1px solid #fecdd3;",
            BedStatuses.Cleaning => "background: #fef3c7; color: #92400e; border: 1px solid #fde68a;",
            BedStatuses.Maintenance => "background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1;",
            _ => "background: #d1fae5; color: #065f46; border: 1px solid #a7f3d0;"
        };
    }

    private async Task UpdateBedStatusAsync(BedCabin item, string newStatus)
    {
        if (item.IsAllocated)
        {
            Fail(I18n.IsBangla ? "রোগী ভর্তি থাকা অবস্থায় বেডের অবস্থা পরিবর্তন করা যাবে না।" : "Cannot change status while patient is admitted.");
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var current = await db.BedCabins.FindAsync(item.ID);
        if (current != null)
        {
            current.Status = newStatus;
            await db.SaveChangesAsync();
            item.Status = newStatus;
            Success(I18n.IsBangla ? $"বেড {item.Name}-এর স্ট্যাটাস আপডেট হয়েছে।" : $"Bed {item.Name} status updated to {newStatus}.");
            StateHasChanged();
        }
    }

    // Single Bed Drawer Management
    private void OpenAddBedDrawer()
    {
        bed = new BedCabin
        {
            CategoryID = categories.Count > 0 ? categories[0].ID : 0,
            Status = BedStatuses.Available
        };
        showBedDrawer = true;
    }

    private void CloseBedDrawer()
    {
        showBedDrawer = false;
        ResetBed();
    }

    private void SelectBed(BedCabin x)
    {
        bed = new BedCabin
        {
            ID = x.ID,
            Name = x.Name,
            CategoryID = x.CategoryID,
            IsAllocated = x.IsAllocated,
            Status = x.Status ?? BedStatuses.Available
        };
        showBedDrawer = true;
    }

    private async Task SaveBedAsync()
    {
        if (string.IsNullOrWhiteSpace(bed.Name) || bed.CategoryID <= 0)
        {
            Fail(I18n.IsBangla ? "বেড/কেবিনের নাম ও ক্যাটাগরি আবশ্যক।" : "Bed/cabin name and category are required.");
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.BedCabins.AnyAsync(x => x.Name == bed.Name.Trim() && x.ID != bed.ID))
        {
            Fail(I18n.IsBangla ? "এই নামের বেড/কেবিন ইতিমধ্যে বিদ্যমান।" : "This bed/cabin name already exists.");
            return;
        }
        if (bed.ID == 0)
        {
            bed.Name = bed.Name.Trim();
            db.BedCabins.Add(bed);
        }
        else
        {
            var current = await db.BedCabins.FindAsync(bed.ID);
            if (current is null)
            {
                Fail(I18n.IsBangla ? "বেড পাওয়া যায়নি।" : "Bed was not found.");
                return;
            }
            current.Name = bed.Name.Trim();
            current.CategoryID = bed.CategoryID;
            if (!current.IsAllocated)
            {
                current.Status = bed.Status;
            }
        }
        await db.SaveChangesAsync();
        Success(I18n.IsBangla ? "বেড/কেবিন সংরক্ষিত হয়েছে।" : "Bed/cabin saved successfully.");
        CloseBedDrawer();
        await LoadAsync();
    }

    private async Task DeleteBedAsync()
    {
        await DeleteBedDirectAsync(bed);
        CloseBedDrawer();
    }

    private async Task DeleteBedDirectAsync(BedCabin item)
    {
        if (!await JS.InvokeAsync<bool>("hpm.confirm", I18n.IsBangla ? $"বেড/কেবিন {item.Name} মুছে ফেলতে চান?" : $"Delete bed/cabin {item.Name}?")) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        if (item.IsAllocated || await db.PatientAdmissions.AnyAsync(x => x.BedCabinID == item.ID) || await db.BedCabinTransactions.AnyAsync(x => x.BedCabinID == item.ID))
        {
            Fail(I18n.IsBangla ? "বেডটিতে রোগী ভর্তি বা ইতিহাস রয়েছে, তাই মুছে ফেলা যাবে না।" : "Bed/cabin is occupied or has transaction history and cannot be deleted.");
            return;
        }
        var current = await db.BedCabins.FindAsync(item.ID);
        if (current is not null)
        {
            db.Remove(current);
            await db.SaveChangesAsync();
        }
        Success(I18n.IsBangla ? "বেড/কেবিন মুছে ফেলা হয়েছে।" : "Bed/cabin deleted.");
        await LoadAsync();
    }

    // Departments Management
    private async Task SaveDepartmentAsync()
    {
        if (string.IsNullOrWhiteSpace(department.Name))
        {
            Fail(I18n.IsBangla ? "বিভাগের নাম আবশ্যক।" : "Department name is required.");
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        if (department.ID == 0) db.IpdDepartments.Add(department);
        else db.IpdDepartments.Update(department);
        await db.SaveChangesAsync();
        Success(I18n.IsBangla ? "আইপিডি বিভাগ সংরক্ষিত হয়েছে।" : "IPD department saved.");
        ResetDepartment();
        await LoadAsync();
    }

    private async Task DeleteDepartmentAsync()
    {
        if (!await JS.InvokeAsync<bool>("hpm.confirm", I18n.IsBangla ? $"বিভাগ {department.Name} মুছে ফেলতে চান?" : $"Delete department {department.Name}?")) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.BedCategories.AnyAsync(x => x.IpdDepartmentID == department.ID) || await db.PatientAdmissions.AnyAsync(x => x.Department == department.ID))
        {
            Fail(I18n.IsBangla ? "এই বিভাগটি অন্যান্য রেকর্ডে ব্যবহৃত হচ্ছে, তাই মুছে ফেলা যাবে না।" : "Department is referenced and cannot be deleted.");
            return;
        }
        var item = await db.IpdDepartments.FindAsync(department.ID);
        if (item is not null)
        {
            db.Remove(item);
            await db.SaveChangesAsync();
        }
        Success(I18n.IsBangla ? "বিভাগ মুছে ফেলা হয়েছে।" : "Department deleted.");
        ResetDepartment();
        await LoadAsync();
    }

    // Categories Management
    private async Task SaveCategoryAsync()
    {
        if (string.IsNullOrWhiteSpace(category.Name) || category.IpdDepartmentID is null)
        {
            Fail(I18n.IsBangla ? "ক্যাটাগরির নাম ও বিভাগ আবশ্যক।" : "Category name and department are required.");
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        if (category.ID == 0)
        {
            category.ID = (await db.BedCategories.MaxAsync(x => (int?)x.ID) ?? 0) + 1;
            db.BedCategories.Add(category);
        }
        else db.BedCategories.Update(category);
        await db.SaveChangesAsync();
        Success(I18n.IsBangla ? "বেড ক্যাটাগরি সংরক্ষিত হয়েছে।" : "Bed category saved.");
        ResetCategory();
        await LoadAsync();
    }

    private async Task DeleteCategoryAsync()
    {
        if (!await JS.InvokeAsync<bool>("hpm.confirm", I18n.IsBangla ? $"ক্যাটাগরি {category.Name} মুছে ফেলতে চান?" : $"Delete category {category.Name}?")) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.BedCabins.AnyAsync(x => x.CategoryID == category.ID))
        {
            Fail(I18n.IsBangla ? "এই ক্যাটাগরিতে বেড/কেবিন বিদ্যমান থাকায় মুছে ফেলা যাবে না।" : "Category contains beds/cabins and cannot be deleted.");
            return;
        }
        var item = await db.BedCategories.FindAsync(category.ID);
        if (item is not null)
        {
            db.Remove(item);
            await db.SaveChangesAsync();
        }
        Success(I18n.IsBangla ? "ক্যাটাগরি মুছে ফেলা হয়েছে।" : "Category deleted.");
        ResetCategory();
        await LoadAsync();
    }

    // Bulk Generator
    private List<(string Name, bool Exists)> GetBulkPreview()
    {
        if (bulkCategoryId <= 0 || bulkEnd < bulkStart || (bulkEnd - bulkStart) > 100) return new();
        var existingNames = new HashSet<string>(beds.Select(b => b.Name), StringComparer.OrdinalIgnoreCase);
        var list = new List<(string Name, bool Exists)>();
        for (int i = bulkStart; i <= bulkEnd; i++)
        {
            var numStr = bulkZeroPad > 0 ? i.ToString(new string('0', bulkZeroPad)) : i.ToString();
            var name = $"{bulkPrefix}{numStr}{bulkSuffix}".Trim();
            list.Add((name, existingNames.Contains(name)));
        }
        return list;
    }

    private async Task GenerateBedsAsync()
    {
        var preview = GetBulkPreview();
        var toCreate = preview.Where(x => !x.Exists).Select(x => x.Name).ToList();

        if (toCreate.Count == 0)
        {
            Fail(I18n.IsBangla ? "তৈরি করার মতো কোনো নতুন বেড নেই। সবগুলো নাম ইতিমধ্যে বিদ্যমান।" : "No new beds to create. All names already exist.");
            return;
        }

        if (bulkCategoryId <= 0)
        {
            Fail(I18n.IsBangla ? "দয়া করে একটি বেড ক্যাটাগরি নির্বাচন করুন।" : "Please select a target category.");
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var newBeds = toCreate.Select(name => new BedCabin
        {
            Name = name,
            CategoryID = bulkCategoryId,
            IsAllocated = false,
            Status = bulkStatus
        }).ToList();

        db.BedCabins.AddRange(newBeds);
        await db.SaveChangesAsync();

        Success(I18n.IsBangla ? $"{newBeds.Count}টি বেড সফলভাবে তৈরি হয়েছে!" : $"Successfully generated {newBeds.Count} beds!");
        await LoadAsync();
        activeTab = "beds";
    }

    private void SelectDepartment(IpdDepartment x) => department = new() { ID = x.ID, Name = x.Name };
    private void SelectCategory(BedCategory x) => category = new() { ID = x.ID, Name = x.Name, Rate = x.Rate, Specification = x.Specification, IpdDepartmentID = x.IpdDepartmentID, AdmissionFee = x.AdmissionFee, ServiceCharge = x.ServiceCharge, Food = x.Food };
    private void ResetDepartment() => department = new();
    private void ResetCategory() => category = new();
    private void ResetBed() => bed = new();
    private string DepartmentName(int? id) => departments.FirstOrDefault(x => x.ID == id)?.Name ?? "—";
    private string CategoryName(int id) => categories.FirstOrDefault(x => x.ID == id)?.Name ?? "—";
    private void Success(string text) { messageClass = "success"; message = text; }
    private void Fail(string text) { messageClass = "danger"; message = text; }

    public void Dispose()
    {
        I18n.OnLanguageChanged -= HandleLanguageChanged;
    }
}
