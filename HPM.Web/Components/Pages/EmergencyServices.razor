@page "/emergency-services"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.Cashier + "," + RoleNames.EmergencyOperator)]
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject IBarcodeQrService BarcodeQr
@inject PatientSelectionState PatientSelection
@inject UserManager<AppUser> UserManager
@implements IDisposable
@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using HPM.Web.Components.Common
@using HPM.Web.Data
@using HPM.Web.Data.Entities
@using HPM.Web.Services
@using Microsoft.EntityFrameworkCore

<PageTitle>@I18n.T("OPD & Emergency Service") | @Branding.HospitalName</PageTitle>

<div class="emergency-classic-fit appointments-classic-fit tickets-classic-fit" tabindex="0" @onkeydown="HandlePageKeyDown">
    <!-- Compact Top Action & Status Bar -->
    <div class="appt-classic-topbar">
        <div class="appt-top-left">
            <h1 class="appt-page-title">
                <span>⚡ @I18n.T("OPD & Emergency Service")</span>
            </h1>
            <span class="appt-count-pill" title="@I18n.T("Total emergency cash memos")">
                @memos.Count @I18n.T("Memos")
            </span>
            <span class="appt-count-pill" style="background:#eff6ff; color:#1d4ed8; border-color:#bfdbfe;" title="@I18n.T("Due memos")">
                ⏳ @DueCount @I18n.T("Due")
            </span>
            <span class="appt-count-pill" style="background:#ecfdf5; color:#047857; border-color:#a7f3d0;" title="@I18n.T("Today's total emergency collection")">
                ৳ @TotalTodayCollection.ToString("N0") @I18n.T("Collection")
            </span>
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <span class="appt-inline-alert @messageClass" title="@message">
                    @(messageClass == "success" ? "✓" : "⚠") @message
                </span>
            }
        </div>

        <div class="appt-top-actions">
            <!-- Print Format Mode Toggle -->
            <div class="tickets-print-mode-group" title="@I18n.T("Select printer slip format")">
                <button type="button" class="tickets-mode-pill @(printLayout == "POS" ? "active" : "")" @onclick='() => printLayout = "POS"' title="80mm Thermal POS Slip">
                    🖨️ @I18n.T("80mm POS")
                </button>
                <button type="button" class="tickets-mode-pill @(printLayout == "A5" ? "active" : "")" @onclick='() => printLayout = "A5"' title="@I18n.T("Delta Hospital style compact Half-A4 / A5 receipt")">
                    📄 @I18n.T("A5 Sheet")
                </button>
                <button type="button" class="tickets-mode-pill @(printLayout == "A4" ? "active" : "")" @onclick='() => printLayout = "A4"' title="Standard A4 Voucher">
                    📑 @I18n.T("A4 Sheet")
                </button>
            </div>

            <!-- Quick Patient Registration Modal -->
            <button type="button" class="btn btn-secondary appt-btn" @onclick="OpenNewPatientModal" title="@I18n.T("Quick Patient Registration")">
                + @I18n.T("New Patient")
            </button>

            <!-- Reset / New Emergency Memo -->
            <button type="button" class="btn btn-secondary appt-btn" @onclick="Reset" title="@I18n.T("New Emergency Memo / Reset Form (Esc)")">
                + @I18n.T("New Emergency Memo")
            </button>
        </div>
    </div>

    <!-- Main Balanced Workspace Grid: Full Widescreen Two-Column Form Card -->
    <div class="appt-classic-workspace">
        <div class="appt-form-card tickets-wide-card">
            <!-- Card Header with Next Memo Badge & Drawer Trigger -->
            <div class="appt-card-header">
                <div class="appt-card-header-title-wrap" style="display: flex; align-items: center; gap: 10px;">
                    <h2>@(editor.ID == 0 ? I18n.T("New Emergency Cash Memo") : $"{I18n.T("Edit Emergency Memo")} #{editor.ID}")</h2>
                    <span class="appt-serial-badge @(editor.ID == 0 ? "emerald" : "violet")">
                        @(editor.ID == 0 ? "⚡ " + I18n.T("EMERGENCY MEMO") : $"MEMO #{editor.ID}")
                    </span>
                </div>

                <button type="button" 
                        class="appt-schedule-trigger-btn @(showScheduleDrawer ? "active" : "")" 
                        @onclick="ToggleScheduleDrawer" 
                        title="@I18n.T("View Today's Emergency Memos (F2 / Ctrl+Q)")">
                    <span>📋</span>
                    <span>@I18n.T("Today's Memos & Queue")</span>
                    <span class="trigger-pill">@memos.Count</span>
                    @if (DueCount > 0)
                    {
                        <span class="trigger-pill checked" title="@I18n.T("Unpaid / Due Memos")">
                            ⏳ @DueCount
                        </span>
                    }
                </button>
            </div>

            <!-- Form Body: Two-Column POS Layout -->
            <EditForm Model="editor" OnValidSubmit="SaveAsync" @onkeydown="HandleFormKeyDown" style="display:flex; flex-direction:column; min-height:0; flex:1 1 auto;">
                <DataAnnotationsValidator />

                <div class="appt-form-body appt-form-twocol">
                    <!-- =========================================================================
                         Left Column: Patient Demographics, Doctor & Clinical Remarks
                         ========================================================================= -->
                    <div class="appt-col-left">
                        <!-- Patient ID Search Combo with suggestions -->
                        <div class="appt-field-group appt-patient-search-field">
                            <span class="appt-field-label">
                                <span>@I18n.T("Patient ID (Optional)")</span>
                            </span>
                            <div class="appt-patient-search-combo">
                                <input class="classic-input"
                                       value="@patientSearchQuery"
                                       @oninput="HandlePatientSearchInputAsync"
                                       @onfocus="ShowPatientIdSuggestionsAsync"
                                       @onblur="HidePatientSuggestionsAsync"
                                       @onkeydown="HandlePatientIdKeyDown"
                                       autocomplete="off"
                                       placeholder="@I18n.T("Search by Patient ID, Mobile or Name...")"
                                       title="@I18n.T("Search by Patient ID, Mobile or Name & press Enter")" />
                                <button type="button" class="btn-find" @onclick="FindPatientAsync" title="@I18n.T("Search Patient")">
                                    <SearchIcon />
                                    <span>@I18n.T("Search")</span>
                                </button>
                            </div>
                            @if (showPatientIdSuggestions)
                            {
                                <div class="appt-patient-suggestions" id="emg-patient-suggestions-list">
                                    @foreach (var patient in patientIdSuggestions)
                                    {
                                        <button type="button" class="appt-patient-option" @onmousedown:preventDefault @onclick="() => SelectPatientFromSuggestion(patient)">
                                            <span class="patient-id">@patient.PatientID</span>
                                            <span class="patient-name">@patient.Name</span>
                                            @if (!string.IsNullOrWhiteSpace(patient.Sex))
                                            {
                                                <span class="meta-tag sex-tag-@patient.Sex.ToLowerInvariant()">
                                                    @(patient.Sex == "Male" ? "♂ Male" : patient.Sex == "Female" ? "♀ Female" : patient.Sex)
                                                </span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(patient.Weight))
                                            {
                                                <span class="patient-weight-pill">⚖️ @patient.Weight kg</span>
                                            }
                                            <span class="patient-contact">@patient.Contact</span>
                                        </button>
                                    }
                                    @if (hasMorePatientSuggestions)
                                    {
                                        <div class="appt-doctor-scroll-hint" @onclick="LoadMorePatientsFromJs" @onmousedown:preventDefault>
                                            @if (isLoadingMorePatients)
                                            {
                                                <span>@I18n.T("Loading more...")</span>
                                            }
                                            else
                                            {
                                                <span>@I18n.T("Showing") @patientIdSuggestions.Count &bull; @I18n.T("Scroll for more...")</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Name & Contact -->
                        <div style="display:flex; gap:8px;">
                            <div class="appt-field-group" style="flex:1.4; min-width:0;">
                                <span class="appt-field-label"><span>@I18n.T("Patient Name")<span class="req">*</span></span></span>
                                <InputText class="classic-input" @bind-Value="editor.PatientName" placeholder="@I18n.T("Full patient name")" data-autocase="title" />
                            </div>
                            <div class="appt-field-group" style="flex:1; min-width:0;">
                                <span class="appt-field-label"><span>@I18n.T("Contact Mobile")</span></span>
                                <InputText class="classic-input" @bind-Value="editor.Contact" placeholder="017xxxxxxxx" />
                            </div>
                        </div>

                        <!-- Attending / Ref. Doctor -->
                        <div class="appt-field-group">
                            <span class="appt-field-label">
                                <span>@I18n.T("Attending / Ref. Doctor")</span>
                            </span>
                            <div class="appt-doctor-search-combo-wrap" id="emg-doctor-search-box" style="position: relative; width: 100%;">
                                <div style="display: flex; gap: 6px; align-items: center;">
                                    <div class="appt-doctor-search" style="flex: 1; min-width: 0; position: relative;">
                                        <input class="classic-input"
                                               value="@doctorSearchText"
                                               @oninput="HandleDoctorSearchInputAsync"
                                               @onfocus="ShowDoctorSuggestions"
                                               @onkeydown="HandleDoctorSearchKeyDown"
                                               autocomplete="off"
                                               placeholder="@(SelectedDoctor != null ? DoctorLabel(SelectedDoctor) : I18n.T("Search doctor by name, degree, room..."))" />
                                        @if (SelectedDoctor != null || !string.IsNullOrWhiteSpace(doctorSearchText))
                                        {
                                            <button type="button" class="diag-doctor-clear" tabindex="-1" @onclick="ClearDoctor" title="@I18n.T("Clear doctor")">✕</button>
                                        }
                                        else
                                        {
                                            <span class="diag-doctor-search-icon">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                    <circle cx="11" cy="11" r="8"></circle>
                                                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                                </svg>
                                            </span>
                                        }
                                    </div>
                                    <button type="button" class="btn btn-secondary appt-btn" style="height:30px; padding:0 10px; flex-shrink:0; display:inline-flex; align-items:center; gap:5px;" @onclick="OpenDoctorModal" title="@I18n.T("Browse doctors catalog")">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="3" y="3" width="7" height="7"></rect>
                                            <rect x="14" y="3" width="7" height="7"></rect>
                                            <rect x="14" y="14" width="7" height="7"></rect>
                                            <rect x="3" y="14" width="7" height="7"></rect>
                                        </svg>
                                        <span>@I18n.T("Browse")</span>
                                    </button>
                                </div>
                                @if (showDoctorSuggestions)
                                {
                                    <div class="appt-doctor-suggestions" id="emg-doctor-suggestions-list" style="position: absolute; top: calc(100% + 2px); left: 0; right: 0; z-index: 120;">
                                        <button type="button" class="appt-doctor-option @(editor.DoctorID == null ? "selected" : "")" @onmousedown:preventDefault @onclick="() => SelectDoctorInline(null)">
                                            <div class="appt-doctor-option-main">
                                                <span class="appt-doctor-option-name">🚶 @I18n.T("Walk-in / None")</span>
                                            </div>
                                        </button>
                                        @foreach (var doc in VisibleDoctorsList)
                                        {
                                            <button type="button" class="appt-doctor-option @(editor.DoctorID == doc.ID ? "selected" : "")" @onmousedown:preventDefault @onclick="() => SelectDoctorInline(doc)">
                                                <div class="appt-doctor-option-main">
                                                    <span class="appt-doctor-option-name">👨‍⚕️ @DoctorNameFormatter.FormatFullName(doc.Title, doc.Name)</span>
                                                    @if (!string.IsNullOrWhiteSpace(doc.Room))
                                                    {
                                                        <span style="font-size:10.5px; background:#e0f2fe; color:#0369a1; padding:1px 5px; border-radius:4px;">Room @doc.Room</span>
                                                    }
                                                </div>
                                                <div class="appt-doctor-option-sub">@doc.Degree</div>
                                            </button>
                                        }
                                        @if (HasMoreDoctorSuggestions)
                                        {
                                            <div class="appt-doctor-scroll-hint" @onmousedown:preventDefault @onclick="LoadMoreDoctorsFromJs">
                                                @I18n.T("Showing") @Math.Min(doctorVisibleCount, FilteredDoctorsList.Count) / @FilteredDoctorsList.Count &bull; @I18n.T("Scroll for more...")
                                            </div>
                                        }
                                        @if (FilteredDoctorsList.Count == 0)
                                        {
                                            <div class="appt-doctor-empty">@I18n.T("No doctor found")</div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Clinical Remarks & Instructions -->
                        <div class="appt-field-group" style="margin-top:2px;">
                            <div style="display:flex; justify-content:space-between; align-items:center;">
                                <span class="appt-field-label"><span>📝 @I18n.T("Clinical Remarks & Instructions")</span></span>
                                <button type="button" class="btn btn-link btn-sm p-0" style="font-size:11px;" @onclick="OpenRemarksModal">
                                    + @I18n.T("Presets / Quick Notes")
                                </button>
                            </div>
                            <input class="classic-input" @bind="editor.Remarks" placeholder="@I18n.T("Clinical findings, procedure notes, or discharge instructions...")" />
                        </div>
                    </div>

                    <!-- =========================================================================
                         Right Column: Services Line Editor, Table & POS Cash Counter
                         ========================================================================= -->
                    <div class="appt-col-right">
                        <!-- Line Editor Section -->
                        <div class="appt-field-group">
                            <span class="appt-field-label">
                                <span>⚡ @I18n.T("Emergency Services & Procedures")</span>
                            </span>
                            <div style="display: flex; gap: 6px; align-items: flex-end; width:100%;">
                                <div style="flex: 1.1; min-width: 100px;">
                                    <span style="font-size:10px; font-weight:700; color:#64748b;">@I18n.T("Category")</span>
                                    <select class="classic-input" value="@selectedCategoryId" @onchange="CategoryChanged">
                                        @foreach (var category in categories)
                                        {
                                            <option value="@category.ID">@category.Name</option>
                                        }
                                    </select>
                                </div>
                                <div style="flex: 1.5; min-width: 120px;">
                                    <span style="font-size:10px; font-weight:700; color:#64748b;">@I18n.T("Service Item")</span>
                                    <select class="classic-input" value="@selectedServiceId" @onchange="ServiceChanged">
                                        @foreach (var service in FilteredServices)
                                        {
                                            <option value="@service.ID">@service.Name</option>
                                        }
                                    </select>
                                </div>
                                <div style="width: 75px;">
                                    <span style="font-size:10px; font-weight:700; color:#64748b;">@I18n.T("Rate")</span>
                                    <InputNumber class="classic-input bold-number" @bind-Value="lineRate" />
                                </div>
                                <div style="width: 48px;">
                                    <span style="font-size:10px; font-weight:700; color:#64748b;">@I18n.T("Qty")</span>
                                    <InputNumber class="classic-input" @bind-Value="lineQuantity" />
                                </div>
                                <div style="display:flex; gap:4px;">
                                    <button class="btn btn-dark tickets-btn" type="button" @onclick="AddLine" style="height:30px; padding:0 10px;" title="@I18n.T("Add service to memo")">+ @I18n.T("Add")</button>
                                    <button class="btn btn-secondary tickets-btn" type="button" @onclick="OpenServiceModal" style="height:30px; padding:0 8px;" title="@I18n.T("Browse full catalog")">
                                        <SearchIcon />
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Right Part: Added Services List & Billing Calculations (Matches /diagnostic/billing) -->
                        <div class="diag-preview-card" style="margin-top: 4px;">
                            <div class="diag-preview-card-header">
                                <div class="diag-preview-title-group">
                                    <span class="diag-preview-title">📋 @I18n.T("Added Emergency Services List:")</span>
                                    <span class="diag-preview-badge">@editor.Items.Count @(editor.Items.Count == 1 ? I18n.T("Service") : I18n.T("Services"))</span>
                                </div>
                                @if (editor.Items.Count > 0)
                                {
                                    <button type="button" class="btn-clear-tests" @onclick="ClearAllItems" title="@I18n.T("Clear All")">
                                        ✕ @I18n.T("Clear All")
                                    </button>
                                }
                            </div>

                            <!-- Table matching /diagnostic/billing columns -->
                            <div class="diag-bill-preview-table-wrap" style="--diag-bill-columns: 34px minmax(180px, 1fr) 80px 48px 95px 30px;">
                                <div class="diag-preview-table-head">
                                    <span class="pcol-sl">SL</span>
                                    <span class="pcol-name">@I18n.T("Emergency Service Description")</span>
                                    <span class="pcol-rate" style="text-align: right;">@I18n.T("Rate")</span>
                                    <span class="pcol-qty" style="text-align: center;">@I18n.T("Qty")</span>
                                    <span class="pcol-amount" style="text-align: right;">@I18n.T("Amount")</span>
                                    <span class="pcol-del" style="text-align: center;">✕</span>
                                </div>
                                <div class="diag-preview-table-rows">
                                    @if (editor.Items.Count == 0)
                                    {
                                        <div class="diag-preview-empty-state">
                                            <div class="empty-icon">⚡</div>
                                            <strong>@I18n.T("No services added yet")</strong>
                                            <span>@I18n.T("Select and add emergency procedures above to calculate bill.")</span>
                                        </div>
                                    }
                                    else
                                    {
                                        @for (var i = 0; i < editor.Items.Count; i++)
                                        {
                                            var idx = i;
                                            var item = editor.Items[idx];
                                            <div class="diag-preview-table-row">
                                                <span class="pcol-sl">@(idx + 1)</span>
                                                <div class="pcol-name">
                                                    <span class="pcol-test-title">@ServiceName(item.TestID)</span>
                                                </div>
                                                <span class="pcol-rate" style="text-align: right;">@I18n.FormatCurrency(item.Rate)</span>
                                                <span class="pcol-qty" style="text-align: center;">@item.Quantity</span>
                                                <strong class="pcol-amount" style="text-align: right; color: #059669;">@I18n.FormatCurrency(item.Rate * item.Quantity)</strong>
                                                <span class="pcol-del" style="text-align: center;">
                                                    <button type="button" class="diag-item-del-btn" title="@I18n.T("Delete")" @onclick="() => RemoveLine(item)">✕</button>
                                                </span>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>

                            <!-- Calculations Block matching /diagnostic/billing -->
                            <div class="diag-totals-summary-box">
                                <div class="diag-totals-row gross-row">
                                    <span class="totals-label">@I18n.T("Total amount"):</span>
                                    <strong class="totals-value gross-val">@I18n.FormatCurrency(editor.Total)</strong>
                                </div>

                                <div class="diag-totals-row input-row">
                                    <div style="display:flex; align-items:center; gap:6px;">
                                        <span class="totals-label">@I18n.T("Disc (% + Amount)"):</span>
                                        <button type="button" class="btn btn-link btn-sm p-0" style="font-size:10.5px; color:#0284c7; text-decoration:none;" @onclick="OpenDiscountModal" title="@I18n.T("Open discount & authorization modal")">
                                            ✏️ @I18n.T("Dialog")
                                        </button>
                                    </div>
                                    <div class="totals-dual-input-wrap">
                                        <div class="percent-input-wrap">
                                            <input type="number" step="0.5" min="0" max="100" class="classic-input diag-tot-input"
                                                   value="@quickDiscountPercent"
                                                   @onchange="HandleInlineDiscountPercentChange"
                                                   aria-label="@I18n.T("Percentage discount")"
                                                   placeholder="%" />
                                            <span class="unit-symbol">%</span>
                                        </div>
                                        <InputNumber class="classic-input diag-tot-input"
                                                     @bind-Value="editor.Discount"
                                                     @bind-Value:after="OnInlineDiscountAmountChanged"
                                                     aria-label="@I18n.T("Discount amount")"
                                                     placeholder="Tk" />
                                    </div>
                                </div>

                                @if (editor.Discount > 0)
                                {
                                    <div class="diag-totals-row discount-total-row">
                                        <span class="totals-label">@I18n.T("Total Discount"):</span>
                                        <strong class="totals-value">- @I18n.FormatCurrency(editor.Discount)</strong>
                                    </div>
                                    <div class="diag-totals-row input-row">
                                        <span class="totals-label">@I18n.T("Authorized By")<span class="req" style="color:#dc2626;">*</span>:</span>
                                        <div class="totals-input-wrap authorizer-input-wrap">
                                            <InputSelect class="classic-input diag-tot-input tickets-select diag-authorizer-select" @bind-Value="editor.DiscountBy">
                                                <option value="">@I18n.T("Select authorizer")</option>
                                                @foreach (var authorizer in authorizers)
                                                {
                                                    <option value="@authorizer.DisplayName">@authorizer.DisplayName</option>
                                                }
                                            </InputSelect>
                                        </div>
                                    </div>
                                }

                                <div class="diag-totals-row net-payable-row">
                                    <span class="totals-label">@I18n.T("Payable"):</span>
                                    <strong class="totals-value net-val">@I18n.FormatCurrency(Math.Max(0, editor.Total - editor.Discount))</strong>
                                </div>

                                <div class="diag-totals-row input-row">
                                    <span class="totals-label">@I18n.T("Received"):</span>
                                    <div class="totals-input-wrap">
                                        <InputNumber class="classic-input diag-tot-input" @bind-Value="editor.Paid" @bind-Value:after="PaidChanged" />
                                    </div>
                                </div>

                                @{
                                    var currentDue = Math.Max(0, editor.Total - editor.Discount - editor.Paid);
                                    var currentChange = Math.Max(0, editor.Paid - (editor.Total - editor.Discount));
                                }
                                @if (currentChange > 0)
                                {
                                    <div class="diag-totals-row" style="background:#f0fdf4; border:1px solid #bbf7d0; border-radius:4px; padding:3px 6px;">
                                        <span class="totals-label" style="color:#166534;">@I18n.T("Change Return"):</span>
                                        <strong class="totals-value" style="color:#16a34a; font-size:12px;">@I18n.FormatCurrency(currentChange)</strong>
                                    </div>
                                }
                                else if (currentDue > 0)
                                {
                                    <div class="diag-due-alert-card">
                                        <div class="diag-due-top-row">
                                            <div class="diag-due-summary">
                                                <span class="diag-due-icon" aria-hidden="true">!</span>
                                                <div>
                                                    <span class="due-warning-text">@I18n.T("Balance Due")</span>
                                                    <strong class="diag-due-amount">@I18n.FormatCurrency(currentDue)</strong>
                                                </div>
                                            </div>
                                            <div class="diag-due-actions">
                                                <button type="button" class="btn-quick-full-pay" @onclick="PayDueInFull" title="@I18n.T("Set Paid Amount to Net Payable")">
                                                    ✓ @(editor.ID > 0 ? I18n.T("Mark Due Paid") : I18n.T("Mark Fully Paid"))
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="diag-totals-row due-row zero-due">
                                        <span class="totals-label">@I18n.T("Due"):</span>
                                        <strong class="totals-value due-val">@I18n.FormatCurrency(0)</strong>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer Action Bar (All Action Buttons Aligned to the Right) -->
                <div class="appt-form-footer">
                    <div class="appt-footer-left-info">
                        @if (editor.ID > 0)
                        {
                            <button class="btn btn-ghost appt-btn" type="button" @onclick="DeleteSelectedAsync" style="color: #dc2626;" title="@I18n.T("Delete Memo")">
                                @I18n.T("Delete")
                            </button>
                        }
                    </div>

                    <div class="appt-footer-right-actions">
                        <button class="btn btn-ghost appt-btn" type="button" @onclick="Reset" title="@I18n.T("Clear Form (Esc)")">
                            @I18n.T("Clear (Esc)")
                        </button>
                        @if (editor.ID > 0)
                        {
                            <button class="btn btn-secondary appt-btn" type="button" @onclick="PrintMemoAsync" title="@I18n.T("Reprint Cash Memo")">
                                🖨️ @I18n.T("Reprint")
                            </button>
                        }
                        <button class="btn btn-primary appt-btn appt-book-btn" type="submit" disabled="@saving" title="@I18n.T("Save and print Emergency Memo (Ctrl+Enter)")">
                            🖨️ @(saving ? I18n.T("Saving...") : editor.ID == 0 ? I18n.T("Save & Print") : I18n.T("Update & Print"))
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>

    <!-- =========================================================================
         Slide-over Emergency Memos History & Queue Drawer
         ========================================================================= -->
    <div class="appt-drawer-backdrop @(showScheduleDrawer ? "show" : "")" @onclick="CloseScheduleDrawer"></div>
    <aside class="appt-drawer-panel @(showScheduleDrawer ? "show" : "")" aria-label="@I18n.T("Today's Emergency Memos")">
        <div class="appt-drawer-header">
            <div class="appt-drawer-title-wrap">
                <span style="font-size:16px;">📋</span>
                <h3 class="appt-drawer-title">
                    @I18n.T("Today's Emergency Memos")
                </h3>
            </div>
            <div style="display:flex; align-items:center; gap:8px;">
                <span style="font-size:11.5px; font-weight:700; color:#475569;">
                    📅 @DateTime.Today.ToString("dd MMM yyyy")
                </span>
                <button type="button" class="appt-drawer-close" @onclick="CloseScheduleDrawer" title="@I18n.T("Close Drawer (Esc)")">
                    ✕
                </button>
            </div>
        </div>

        <div class="appt-drawer-body">
            <div class="appt-queue-card" style="border:none; border-radius:0; box-shadow:none; height:100%;">
                <!-- Scanner Bar -->
                <div class="tickets-scanner-bar" style="margin-bottom:8px;">
                    <div class="tickets-scanner-input-wrap">
                        <span class="tickets-scanner-icon" title="@I18n.T("Barcode / QR Scanner Active")">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                        </span>
                        <input type="text"
                               class="classic-input tickets-scanner-input"
                               placeholder="@I18n.T("Scan Emergency Barcode / QR or Patient ID & Enter...")"
                               @bind="memoScanQuery"
                               @bind:event="oninput"
                               @onkeydown="HandleMemoScanKeyDown" />
                        @if (!string.IsNullOrWhiteSpace(memoScanQuery))
                        {
                            <button type="button" class="tickets-scanner-clear" @onclick="ClearMemoScan" title="Clear">✕</button>
                        }
                    </div>
                </div>

                <!-- Scope Filter Chips -->
                <div class="appt-queue-filter-strip">
                    <div class="appt-status-chips">
                        <button type="button" class="status-chip @(drawerFilter == "All" ? "active" : "")" @onclick='() => drawerFilter = "All"'>
                            @I18n.T("All") (@memos.Count)
                        </button>
                        <button type="button" class="status-chip checkedin @(drawerFilter == "Due" ? "active" : "")" @onclick='() => drawerFilter = "Due"'>
                            @I18n.T("Due") (@DueCount)
                        </button>
                        <button type="button" class="status-chip booked @(drawerFilter == "Paid" ? "active" : "")" @onclick='() => drawerFilter = "Paid"'>
                            @I18n.T("Paid") (@PaidCount)
                        </button>
                    </div>
                </div>

                <!-- Memo List -->
                <div class="appt-queue-list">
                    @if (!DrawerFilteredMemos.Any())
                    {
                        <div class="appt-empty-state">
                            <div class="appt-empty-state-icon">⚡</div>
                            <div class="appt-empty-state-title">@I18n.T("No matching emergency memos")</div>
                            <div class="appt-empty-state-desc">@I18n.T("No emergency cash memos matching current filter.")</div>
                        </div>
                    }
                    @foreach (var memo in DrawerFilteredMemos)
                    {
                        var isDue = memo.Total - memo.Discount - memo.Paid > 0;
                        <div class="appt-queue-item @(editor.ID == memo.ID ? "active" : "")">
                            <div class="appt-serial-col">
                                <span class="appt-queue-serial">#@memo.ID</span>
                                <span class="appt-time-pill">@memo.TransDate.ToString("hh:mm tt")</span>
                            </div>

                            <div class="appt-queue-info">
                                <div class="appt-name-row">
                                    <strong class="appt-queue-name">@memo.PatientName</strong>
                                    <span class="pill @(isDue ? "pill-danger" : "pill-success")" style="font-size:10px; font-weight:700;">
                                        @(isDue ? I18n.T("Due") : I18n.T("Paid"))
                                    </span>
                                </div>

                                <div class="appt-queue-meta">
                                    @if (!string.IsNullOrWhiteSpace(memo.PatientID))
                                    {
                                        <span class="meta-tag id-tag">PID: @memo.PatientID</span>
                                        <span class="meta-sep">&bull;</span>
                                    }
                                    <span>@memo.Items.Count @I18n.T("item(s)")</span>
                                    @if (!string.IsNullOrWhiteSpace(memo.Contact))
                                    {
                                        <span class="meta-sep">&bull;</span>
                                        <span>📞 @memo.Contact</span>
                                    }
                                </div>
                            </div>

                            <div class="appt-queue-actions">
                                <span class="tickets-queue-fee" style="font-size:11.5px; font-weight:800; color:#059669; margin-right:4px;">
                                    @(I18n.FormatCurrency(memo.Total))
                                </span>
                                <button class="appt-tool-btn" @onclick="() => Print(memo)" title="@I18n.T("Print Slip")">🖨️</button>
                                <button class="appt-tool-btn" @onclick="() => SelectAndCloseDrawer(memo)" title="@I18n.T("Edit")">✎</button>
                                <button class="appt-tool-btn" @onclick="() => DeleteAsync(memo)" style="color:#dc2626;" title="@I18n.T("Delete")">×</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </aside>
</div>

<!-- =========================================================================
     Quick Patient Registration Modal
     ========================================================================= -->
@if (showNewPatientModal)
{
    <div class="quick-patient-modal-backdrop" @onclick="CloseNewPatientModal">
        <div class="quick-patient-modal-dialog" @onclick:stopPropagation>
            <div class="quick-patient-modal-header">
                <h3>👤 @I18n.T("Quick Patient Registration")</h3>
                <button type="button" class="appt-drawer-close" @onclick="CloseNewPatientModal">✕</button>
            </div>
            <div class="quick-patient-modal-body">
                @if (!string.IsNullOrWhiteSpace(newPatientError))
                {
                    <div class="appt-inline-alert danger" style="margin-bottom:8px;">@newPatientError</div>
                }
                <!-- Patient Name -->
                <div class="appt-field-group">
                    <span class="appt-field-label"><span>@I18n.T("Patient Name")<span class="req">*</span></span></span>
                    <input type="text" class="classic-input" @bind="newPatientModel.Name" placeholder="@I18n.T("Full patient name...")" autofocus />
                </div>
                <!-- Contact & Age -->
                <div style="display:flex; gap:8px;">
                    <div class="appt-field-group" style="flex:1.2; min-width:0;">
                        <span class="appt-field-label">@I18n.T("Mobile No")</span>
                        <input type="text" class="classic-input" @bind="newPatientModel.Contact" placeholder="017xxxxxxxx" />
                    </div>
                    <div class="appt-field-group" style="flex:1; min-width:0;">
                        <span class="appt-field-label">@I18n.T("Age (Years)")</span>
                        <div class="appt-unit-input-box">
                            <input type="number" class="classic-input appt-unit-input" @bind="newPatientAge" placeholder="30" />
                            <span class="appt-unit-addon">Yrs</span>
                        </div>
                    </div>
                </div>
                <!-- Sex & Blood Group -->
                <div style="display:flex; gap:8px;">
                    <div class="appt-field-group" style="flex:1.2; min-width:0;">
                        <span class="appt-field-label">@I18n.T("Sex")</span>
                        <select class="classic-input" @bind="newPatientModel.Sex">
                            <option value="Male">@I18n.T("Male")</option>
                            <option value="Female">@I18n.T("Female")</option>
                            <option value="Other">@I18n.T("Other")</option>
                        </select>
                    </div>
                    <div class="appt-field-group" style="flex:1; min-width:0;">
                        <span class="appt-field-label">@I18n.T("Blood Group")</span>
                        <select class="classic-input" @bind="newPatientModel.BloodGroup">
                            <option value="">-- @I18n.T("Unknown") --</option>
                            <option value="A+">A+</option>
                            <option value="A-">A-</option>
                            <option value="B+">B+</option>
                            <option value="B-">B-</option>
                            <option value="O+">O+</option>
                            <option value="O-">O-</option>
                            <option value="AB+">AB+</option>
                            <option value="AB-">AB-</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="quick-patient-modal-footer">
                <button type="button" class="btn btn-secondary tickets-btn" @onclick="CloseNewPatientModal">@I18n.T("Cancel")</button>
                <button type="button" class="btn btn-primary tickets-btn" disabled="@savingNewPatient" @onclick="SaveQuickPatientAsync">
                    @(savingNewPatient ? I18n.T("Saving...") : I18n.T("Save & Select Patient"))
                </button>
            </div>
        </div>
    </div>
}

<!-- =========================================================================
     Doctor Selection Modal
     ========================================================================= -->
@if (isDoctorModalOpen)
{
    <div class="doctor-modal-backdrop" @onclick="CloseDoctorModal">
        <div class="doctor-modal-dialog" @onclick:stopPropagation>
            <div class="doctor-modal-header">
                <div class="doctor-modal-header-title">
                    <div class="doctor-modal-icon">🩺</div>
                    <div class="doctor-modal-heading">
                        <h3>@I18n.T("Select Attending / Ref. Doctor")</h3>
                        <small>@I18n.T("Search doctor by name, degree, department, or room")</small>
                    </div>
                </div>
                <button type="button" class="doctor-modal-close" @onclick="CloseDoctorModal" title="@I18n.T("Close")">✕</button>
            </div>
            <div class="doctor-modal-search-wrap">
                <div class="doctor-modal-search-box">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="text"
                           @bind="doctorSearchQuery"
                           @bind:event="oninput"
                           autofocus
                           class="doctor-modal-search-input"
                           placeholder="@I18n.T("Search doctor by name, degree, room...")" />
                    @if (!string.IsNullOrWhiteSpace(doctorSearchQuery))
                    {
                        <button type="button" class="doctor-modal-search-clear" @onclick="() => doctorSearchQuery = string.Empty">×</button>
                    }
                </div>
            </div>
            <div class="doctor-modal-list">
                <div class="doctor-modal-item @(editor.DoctorID == null ? "active-selected" : "")" @onclick="() => SelectDoctor(null)">
                    <div class="doctor-modal-item-left">
                        <div class="doc-modal-avatar" style="background:#e2e8f0; color:#475569;">🚶</div>
                        <div class="doc-modal-info">
                            <span class="doc-modal-name">@I18n.T("Walk-in / None")</span>
                            <span class="doc-modal-meta">
                                <span>@I18n.T("No specific attending doctor assigned")</span>
                            </span>
                        </div>
                    </div>
                    <button type="button" class="btn-modal-choose">
                        @(editor.DoctorID == null ? "✓ " + I18n.T("Selected") : I18n.T("Select"))
                    </button>
                </div>

                @if (!FilteredDoctors.Any())
                {
                    <div class="doc-modal-empty">@I18n.T("No doctor found matching your search.")</div>
                }
                else
                {
                    @foreach (var doc in FilteredDoctors.Take(60))
                    {
                        var fullName = DoctorNameFormatter.FormatFullName(doc.Title, doc.Name);
                        <div class="doctor-modal-item @(editor.DoctorID == doc.ID ? "active-selected" : "")" @onclick="() => SelectDoctor(doc)">
                            <div class="doctor-modal-item-left">
                                <div class="doc-modal-avatar">👨‍⚕️</div>
                                <div class="doc-modal-info">
                                    <span class="doc-modal-name">@fullName</span>
                                    <span class="doc-modal-meta">
                                        <span>@doc.Degree</span>
                                        @if (!string.IsNullOrWhiteSpace(doc.Room))
                                        {
                                            <span class="doc-modal-dept-badge" style="background:#e0f2fe; color:#0369a1; border-color:#bae6fd;">Room @doc.Room</span>
                                        }
                                    </span>
                                </div>
                            </div>
                            <button type="button" class="btn-modal-choose">
                                @(editor.DoctorID == doc.ID ? "✓ " + I18n.T("Selected") : I18n.T("Select"))
                            </button>
                        </div>
                    }
                }
            </div>
            <div class="doctor-modal-footer">
                <span class="doctor-modal-footer-count">@FilteredDoctors.Count() @I18n.T("doctors found")</span>
                <button type="button" class="btn-modal-cancel" @onclick="CloseDoctorModal">@I18n.T("Cancel")</button>
            </div>
        </div>
    </div>
}

<!-- =========================================================================
     Clinical Remarks Modal
     ========================================================================= -->
@if (isRemarksModalOpen)
{
    <div class="doctor-modal-backdrop" @onclick="CloseRemarksModal">
        <div class="doctor-modal-dialog remarks-modal-dialog" @onclick:stopPropagation>
            <div class="doctor-modal-header">
                <div class="doctor-modal-header-title">
                    <div class="doctor-modal-icon" style="background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);">📝</div>
                    <div class="doctor-modal-heading">
                        <h3>@I18n.T("Clinical Remarks & Instructions")</h3>
                        <small>@I18n.T("Add optional clinical findings, instructions, or notes for memo")</small>
                    </div>
                </div>
                <button type="button" class="doctor-modal-close" @onclick="CloseRemarksModal" title="@I18n.T("Close")">✕</button>
            </div>
            <div class="remarks-modal-body">
                <div class="remarks-quick-chips">
                    <span class="quick-chip-title">@I18n.T("Quick Presets"):</span>
                    <button type="button" class="quick-chip" @onclick='() => AppendRemark("Emergency First Aid Given")'>+ First Aid Given</button>
                    <button type="button" class="quick-chip" @onclick='() => AppendRemark("Wound Dressing & Suturing Done")'>+ Wound Dressing</button>
                    <button type="button" class="quick-chip" @onclick='() => AppendRemark("Patient Stabilized & Discharged")'>+ Stabilized & Discharged</button>
                    <button type="button" class="quick-chip" @onclick='() => AppendRemark("Under Observation in Emergency")'>+ Under Observation</button>
                    <button type="button" class="quick-chip" @onclick='() => AppendRemark("Transferred to Ward / ICU")'>+ Transferred to Ward</button>
                    <button type="button" class="quick-chip" @onclick='() => AppendRemark("Advised Rest & Follow-up")'>+ Advised Follow-up</button>
                </div>
                <div class="remarks-textarea-wrap">
                    <textarea class="classic-input remarks-modal-textarea"
                              maxlength="200"
                              rows="4"
                              placeholder="@I18n.T("Enter clinical notes, instructions, procedure details (max 200 chars)...")"
                              @bind="tempRemarks"
                              @bind:event="oninput"></textarea>
                    <div class="remarks-char-counter">
                        <span>@((tempRemarks?.Length ?? 0)) / 200</span>
                    </div>
                </div>
            </div>
            <div class="doctor-modal-footer">
                <button type="button" class="btn btn-ghost tickets-btn" @onclick="ClearRemarks" style="color: #dc2626;">@I18n.T("Clear Remarks")</button>
                <div style="display:flex; gap:8px;">
                    <button type="button" class="btn-modal-cancel" @onclick="CloseRemarksModal">@I18n.T("Cancel")</button>
                    <button type="button" class="btn btn-primary tickets-btn" @onclick="SaveRemarks">@I18n.T("Save Remarks")</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- =========================================================================
     Discount & Authorization Modal
     ========================================================================= -->
@if (isDiscountModalOpen)
{
    <div class="doctor-modal-backdrop" @onclick="CloseDiscountModal">
        <div class="doctor-modal-dialog discount-modal-dialog" @onclick:stopPropagation>
            <div class="doctor-modal-header">
                <div class="doctor-modal-header-title">
                    <div class="doctor-modal-icon" style="background: linear-gradient(135deg, #059669 0%, #047857 100%);">🏷️</div>
                    <div class="doctor-modal-heading">
                        <h3>@I18n.T("Discount & Authorization")</h3>
                        <small>@I18n.T("Apply concession or discount to gross subtotal")</small>
                    </div>
                </div>
                <button type="button" class="doctor-modal-close" @onclick="CloseDiscountModal" title="@I18n.T("Close")">✕</button>
            </div>
            <div class="discount-modal-body">
                <div class="discount-summary-banner">
                    <div class="summary-stat">
                        <span>@I18n.T("Gross Subtotal")</span>
                        <strong>@(I18n.FormatCurrency(editor.Total))</strong>
                    </div>
                    <div class="summary-stat">
                        <span>@I18n.T("Discount")</span>
                        <strong style="color:#059669;">-@(I18n.FormatCurrency(tempDiscount))</strong>
                    </div>
                    <div class="summary-stat">
                        <span>@I18n.T("Net Payable")</span>
                        <strong style="color:#0284c7;">@(I18n.FormatCurrency(Math.Max(0, editor.Total - tempDiscount)))</strong>
                    </div>
                </div>

                <div class="discount-quick-chips">
                    <span class="quick-chip-title">@I18n.T("Quick Percentages"):</span>
                    <button type="button" class="quick-chip @(tempDiscountPercent == 0 && tempDiscount == 0 ? "active" : "")" @onclick="() => SetDiscountPercent(0)">0%</button>
                    <button type="button" class="quick-chip @(tempDiscountPercent == 5 ? "active" : "")" @onclick="() => SetDiscountPercent(5)">5%</button>
                    <button type="button" class="quick-chip @(tempDiscountPercent == 10 ? "active" : "")" @onclick="() => SetDiscountPercent(10)">10%</button>
                    <button type="button" class="quick-chip @(tempDiscountPercent == 15 ? "active" : "")" @onclick="() => SetDiscountPercent(15)">15%</button>
                    <button type="button" class="quick-chip @(tempDiscountPercent == 20 ? "active" : "")" @onclick="() => SetDiscountPercent(20)">20%</button>
                    <button type="button" class="quick-chip @(tempDiscountPercent == 50 ? "active" : "")" @onclick="() => SetDiscountPercent(50)">50%</button>
                    <button type="button" class="quick-chip @(tempDiscountPercent == 100 ? "active" : "")" @onclick="() => SetDiscountPercent(100)">100% (Free)</button>
                </div>

                <div class="discount-form-fields" style="display:grid; grid-template-columns: 1fr 1fr; gap:10px; margin-top:8px;">
                    <label>
                        <span style="display:flex; justify-content:space-between; align-items:center;">
                            <span>@I18n.T("Discount (%)")</span>
                            <small style="font-size:10px; color:#64748b; font-weight:normal;">@I18n.T("Custom %")</small>
                        </span>
                        <div style="position:relative; display:flex; align-items:center;">
                            <input type="number"
                                   step="0.5"
                                   min="0"
                                   max="100"
                                   class="classic-input bold-number"
                                   style="padding-right: 22px; width: 100%; text-align: right;"
                                   value="@tempDiscountPercent"
                                   @oninput="HandleTempDiscountPercentInput"
                                   placeholder="0" />
                            <span style="position:absolute; right:8px; font-weight:800; font-size:11px; color:#64748b; pointer-events:none;">%</span>
                        </div>
                    </label>

                    <label>
                        <span style="display:flex; justify-content:space-between; align-items:center;">
                            <span>@I18n.T("Discount Amount (৳)")</span>
                            <small style="font-size:10px; color:#64748b; font-weight:normal;">@I18n.T("Custom ৳")</small>
                        </span>
                        <input type="number"
                               step="0.01"
                               min="0"
                               max="@editor.Total"
                               class="classic-input bold-number"
                               style="width: 100%; text-align: right;"
                               value="@tempDiscount"
                               @oninput="HandleTempDiscountInput"
                               placeholder="0.00" />
                    </label>
                </div>

                <div class="discount-authorizer-row" style="margin-top:10px;">
                    <label style="display:flex; flex-direction:column; gap:3px;">
                        <span style="font-size:11px; font-weight:700; color:#475569;">
                            @I18n.T("Authorized By")
                            @if (tempDiscount > 0)
                            {
                                <span class="req" style="color:#dc2626; font-weight:700;">*</span>
                            }
                        </span>
                        <select class="classic-input tickets-select diag-authorizer-select"
                                style="width:100%; height:32px;"
                                @bind="tempDiscountBy">
                            <option value="">@I18n.T("Select authorizer")</option>
                            @if (authorizers.Count == 0)
                            {
                                <option value="" disabled>@I18n.T("No active Authorizer user")</option>
                            }
                            @foreach (var authorizer in authorizers)
                            {
                                <option value="@authorizer.DisplayName">@authorizer.DisplayName</option>
                            }
                            @if (!string.IsNullOrWhiteSpace(tempDiscountBy) && !authorizers.Any(x => string.Equals(x.DisplayName, tempDiscountBy, StringComparison.OrdinalIgnoreCase)))
                            {
                                <option value="@tempDiscountBy">@tempDiscountBy</option>
                            }
                        </select>
                    </label>
                </div>

                @if (tempDiscount > 0 && string.IsNullOrWhiteSpace(tempDiscountBy))
                {
                    <div class="discount-warning-note" style="margin-top:8px;">
                        ⚠️ @I18n.T("Authorization name is required when discount is greater than 0.")
                    </div>
                }
            </div>
            <div class="doctor-modal-footer">
                <button type="button" class="btn btn-ghost tickets-btn" @onclick="RemoveDiscount" style="color: #dc2626;">@I18n.T("Remove Discount")</button>
                <div style="display:flex; gap:8px;">
                    <button type="button" class="btn-modal-cancel" @onclick="CloseDiscountModal">@I18n.T("Cancel")</button>
                    <button type="button" class="btn btn-primary tickets-btn" @onclick="ApplyDiscount" disabled="@(tempDiscount > 0 && string.IsNullOrWhiteSpace(tempDiscountBy))">
                        @I18n.T("Apply Discount")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- =========================================================================
     Emergency Services Catalog Modal
     ========================================================================= -->
@if (isServiceModalOpen)
{
    <div class="doctor-modal-backdrop" @onclick="CloseServiceModal">
        <div class="doctor-modal-dialog service-modal-dialog" @onclick:stopPropagation>
            <div class="doctor-modal-header">
                <div class="doctor-modal-header-title">
                    <div class="doctor-modal-icon" style="background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);">⚡</div>
                    <div class="doctor-modal-heading">
                        <h3>@I18n.T("Emergency Services & Procedures Catalog")</h3>
                        <small>@I18n.T("Quick search and add services to cash memo")</small>
                    </div>
                </div>
                <button type="button" class="doctor-modal-close" @onclick="CloseServiceModal" title="@I18n.T("Close")">✕</button>
            </div>
            <div class="doctor-modal-search-wrap">
                <div class="doctor-modal-search-box">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="text"
                           @bind="serviceSearchQuery"
                           @bind:event="oninput"
                           autofocus
                           class="doctor-modal-search-input"
                           placeholder="@I18n.T("Search service name, procedure, or test...")" />
                    @if (!string.IsNullOrWhiteSpace(serviceSearchQuery))
                    {
                        <button type="button" class="doctor-modal-search-clear" @onclick="() => serviceSearchQuery = string.Empty">×</button>
                    }
                </div>
            </div>
            <div class="service-category-chips">
                <button type="button" class="service-cat-chip @(catalogCategoryId == 0 ? "active" : "")" @onclick="() => catalogCategoryId = 0">
                    @I18n.T("All Categories")
                </button>
                @foreach (var cat in categories)
                {
                    <button type="button" class="service-cat-chip @(catalogCategoryId == cat.ID ? "active" : "")" @onclick="() => catalogCategoryId = cat.ID">
                        @cat.Name
                    </button>
                }
            </div>
            <div class="doctor-modal-list service-modal-list">
                @if (!CatalogFilteredServices.Any())
                {
                    <div class="doc-modal-empty">@I18n.T("No emergency service matches your search.")</div>
                }
                else
                {
                    @foreach (var s in CatalogFilteredServices.Take(100))
                    {
                        var catName = categories.FirstOrDefault(c => c.ID == s.CategoryID)?.Name ?? "Emergency";
                        <div class="service-catalog-item">
                            <div class="service-catalog-info">
                                <span class="service-catalog-name">@s.Name</span>
                                <div class="service-catalog-meta">
                                    <span class="service-cat-badge">@catName</span>
                                    <span class="service-rate-badge">@(I18n.FormatCurrency(s.SaleRate ?? 0))</span>
                                </div>
                            </div>
                            <div class="service-catalog-action">
                                <button type="button" class="btn btn-secondary tickets-btn" @onclick="() => SelectServiceFromCatalog(s)">
                                    + @I18n.T("Add to Memo")
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>
            <div class="doctor-modal-footer">
                <span class="doctor-modal-footer-count">@CatalogFilteredServices.Count() @I18n.T("services available")</span>
                <button type="button" class="btn-modal-cancel" @onclick="CloseServiceModal">@I18n.T("Close")</button>
            </div>
        </div>
    </div>
}

<!-- =========================================================================
