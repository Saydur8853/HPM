    private static IQueryable<Registration> BuildPatientQuery(HpmDbContext db, string term)
    {
        return db.Registrations.AsNoTracking()
            .Where(x => string.IsNullOrEmpty(term)
                     || x.PatientID.StartsWith(term)
                     || (x.Contact != null && x.Contact.StartsWith(term))
                     || (x.Name != null && x.Name.Contains(term)))
            .OrderByDescending(x => x.ID);
    }

    private async Task LoadPatientIdSuggestionsAsync()
    {
        var term = patientSearchQuery.Trim();
        hasMorePatientSuggestions = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var q = BuildPatientQuery(db, term);
            patientIdSuggestions = await q.Take(PatientBatchSize).ToListAsync();
            hasMorePatientSuggestions = patientIdSuggestions.Count >= PatientBatchSize;
            showPatientIdSuggestions = patientIdSuggestions.Count > 0;
            try
            {
                await JS.InvokeVoidAsync("hpm.resetPatientIdScrollTop", "emg-patient-suggestions-list");
            }
            catch { }
        }
        catch
        {
            patientIdSuggestions.Clear();
            showPatientIdSuggestions = false;
            hasMorePatientSuggestions = false;
        }
    }

    [JSInvokable]
    public async Task LoadMorePatientsFromJs()
    {
        if (isLoadingMorePatients || !hasMorePatientSuggestions || !showPatientIdSuggestions) return;
        isLoadingMorePatients = true;
        await InvokeAsync(StateHasChanged);

        var term = patientSearchQuery.Trim();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var q = BuildPatientQuery(db, term);
            var nextBatch = await q.Skip(patientIdSuggestions.Count).Take(PatientBatchSize).ToListAsync();
            if (nextBatch.Count > 0)
            {
                patientIdSuggestions.AddRange(nextBatch);
                hasMorePatientSuggestions = nextBatch.Count >= PatientBatchSize;
            }
            else
            {
                hasMorePatientSuggestions = false;
            }
        }
        catch
        {
            hasMorePatientSuggestions = false;
        }
        finally
        {
            isLoadingMorePatients = false;
            await InvokeAsync(StateHasChanged);
        }
    }

