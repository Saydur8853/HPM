        (string.IsNullOrWhiteSpace(serviceSearchQuery) || (s.Name?.Contains(serviceSearchQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)));

    private decimal TotalTodayCollection => memos.Where(m => m.TransDate.Date == DateTime.Today).Sum(m => m.Paid);
    private int DueCount => memos.Count(m => m.Total - m.Discount - m.Paid > 0);
    private int PaidCount => memos.Count(m => m.Total - m.Discount - m.Paid <= 0);

    private IEnumerable<CashMemoDInvestigation> DrawerFilteredMemos
    {
        get
        {
            var result = memos.AsEnumerable();
            if (drawerFilter == "Due")
            {
                result = result.Where(m => m.Total - m.Discount - m.Paid > 0);
            }
            else if (drawerFilter == "Paid")
            {
                result = result.Where(m => m.Total - m.Discount - m.Paid <= 0);
            }

            if (!string.IsNullOrWhiteSpace(memoScanQuery))
            {
                var q = memoScanQuery.Trim();
                result = result.Where(m => m.ID.ToString().Contains(q, StringComparison.OrdinalIgnoreCase)
                                        || (m.PatientName?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                                        || (m.PatientID?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                                        || (m.Contact?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
            }
            return result;
        }
    }

