                {
                    <div class="a5-stamp a5-stamp-paid">PAID</div>
                }
                else
                {
                    <div class="a5-stamp a5-stamp-due">DUE: @I18n.FormatCurrency(Math.Max(0, editor.Total - editor.Discount - editor.Paid))</div>
                }
            </div>

            <div class="a5-in-word">
                In Word: @CurrencyWordsHelper.ToTakaWords(editor.Paid > 0 ? editor.Paid : Math.Max(0, editor.Total - editor.Discount))
            </div>

            <table class="a5-mini-pay-table">
                <thead>
                    <tr>
                        <th>Payment Type</th>
                        <th>Coll. By</th>
                        <th>Auth. By</th>
                        <th>Date</th>
                        <th>Mode</th>
                        <th style="text-align: right;">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @if (editor.Discount > 0)
                    {
                        <tr>
                            <td>Discount</td>
                            <td>@currentUserName</td>
                            <td>@(string.IsNullOrWhiteSpace(editor.DiscountBy) ? "—" : editor.DiscountBy)</td>
                            <td>@editor.TransDate.ToString("dd/MM/yy")</td>
                            <td>Discount</td>
                            <td style="text-align: right;">@editor.Discount.ToString("N2")</td>
                        </tr>
                    }
                    <tr>
                        <td>Collection</td>
                        <td>@currentUserName</td>
                        <td>—</td>
                        <td>@editor.TransDate.ToString("dd/MM/yy")</td>
                        <td>Cash</td>
                        <td style="text-align: right;">@editor.Paid.ToString("N2")</td>
                    </tr>
                </tbody>
            </table>

            <div class="a5-prepared-by">
                Prepared By : <strong>@currentUserName</strong>
            </div>
        </div>

        <!-- Right: Financial Totals Box -->
        <div class="a5-fin-right">
            <div class="a5-financial-summary">
                <div class="a5-fin-row">
                    <span>Gross Total Tk.</span>
                    <span class="a5-colon">:</span>
                    <span class="a5-fin-val">@editor.Total.ToString("N2")</span>
                </div>
                @if (editor.Discount > 0)
                {
                    <div class="a5-fin-row">
                        <span>(-)Discount Tk.</span>
                        <span class="a5-colon">:</span>
                        <span class="a5-fin-val">@editor.Discount.ToString("N2")</span>
                    </div>
                }
                <div class="a5-fin-row a5-fin-net">
                    <span>Net Payable Tk.</span>
                    <span class="a5-colon">:</span>
                    <span class="a5-fin-val">@Math.Max(0, editor.Total - editor.Discount).ToString("N2")</span>
                </div>
                <div class="a5-fin-row">
                    <span>Paid Amount Tk.</span>
                    <span class="a5-colon">:</span>
                    <span class="a5-fin-val">@editor.Paid.ToString("N2")</span>
                </div>
                <div class="a5-fin-row a5-fin-due">
                    <span>Due Tk.</span>
                    <span class="a5-colon">:</span>
                    <span class="a5-fin-val @(editor.Total - editor.Discount - editor.Paid > 0 ? "a5-due-text" : "")">
                        @Math.Max(0, editor.Total - editor.Discount - editor.Paid).ToString("N2")
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

