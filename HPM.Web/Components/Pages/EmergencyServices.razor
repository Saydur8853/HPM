    private async Task FindPatientAsync()
    {
        var lookup = (string.IsNullOrWhiteSpace(patientSearchQuery) ? editor.PatientID : patientSearchQuery)?.Trim();
        if (string.IsNullOrWhiteSpace(lookup)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var patient = await db.Registrations.AsNoTracking().FirstOrDefaultAsync(x => x.PatientID == lookup || x.Contact == lookup);
        if (patient is null && lookup.StartsWith("0") && lookup.Length >= 10)
        {
            var withoutLeadingZero = lookup[1..];
            patient = await db.Registrations.AsNoTracking()
                .Where(x => x.Contact != null && x.Contact.EndsWith(withoutLeadingZero))
                .OrderByDescending(x => x.ID)
                .FirstOrDefaultAsync();
        }
        if (patient is null)
        {
            patient = await db.Registrations.AsNoTracking()
                .Where(x => x.Name != null && x.Name.Contains(lookup))
                .OrderByDescending(x => x.ID)
                .FirstOrDefaultAsync();
        }
        if (patient is null)
        {
            messageClass = "danger";
            message = "Patient ID not found. You can enter details as walk-in.";
            return;
        }
        SelectPatient(patient);
    }

