    private async Task SaveQuickPatientAsync()
    {
        if (string.IsNullOrWhiteSpace(newPatientModel.Name))
        {
            newPatientError = "Patient Name is required.";
            return;
        }

        savingNewPatient = true;
        newPatientError = string.Empty;
        try
        {
            DateTime? dob = null;
            if (int.TryParse(newPatientAge, out var ageYears) && ageYears > 0)
            {
                dob = DateTime.Today.AddYears(-ageYears);
            }

            await using var db = await DbFactory.CreateDbContextAsync();
            var strategy = db.Database.CreateExecutionStrategy();
            Registration? created = null;

            await strategy.ExecuteAsync(async () =>
            {
                await using var transaction = await db.Database.BeginTransactionAsync(System.Data.IsolationLevel.ReadCommitted);
                try
                {
                    await SqlServerConcurrency.AcquireTransactionLockAsync(db, "HPM:PatientID");
                }
                catch
                {
                    // Proceed if application lock is unsupported
                }

                var todayPrefix = $"P{DateTime.Today:yyMMdd}";
                var maxExistingToday = await db.Registrations
                    .Where(x => x.PatientID.StartsWith(todayPrefix))
                    .OrderByDescending(x => x.PatientID)
                    .Select(x => x.PatientID)
                    .FirstOrDefaultAsync();

                var nextSeq = 1;
                if (!string.IsNullOrWhiteSpace(maxExistingToday) && maxExistingToday.Length >= 11)
                {
                    var seqPart = maxExistingToday.Substring(7);
                    if (int.TryParse(seqPart, out var parsedSeq))
                    {
                        nextSeq = parsedSeq + 1;
                    }
                }

                var generatedPatientId = $"{todayPrefix}{nextSeq:0000}";
                var userId = await CurrentUserIdAsync();

                var entity = new Registration
                {
                    PatientID = generatedPatientId,
                    Name = newPatientModel.Name.Trim(),
                    DateOfBirth = dob,
                    Sex = string.IsNullOrWhiteSpace(newPatientModel.Sex) ? "Male" : newPatientModel.Sex,
                    BloodGroup = string.IsNullOrWhiteSpace(newPatientModel.BloodGroup) ? null : newPatientModel.BloodGroup,
                    Contact = string.IsNullOrWhiteSpace(newPatientModel.Contact) ? null : newPatientModel.Contact.Trim(),
                    EnteredBy = userId > 0 ? userId : 1,
                    TransDate = DateTime.Now
                };

                db.Registrations.Add(entity);
                await db.SaveChangesAsync();
                await transaction.CommitAsync();

                created = entity;
            });

            if (created != null)
            {
                SelectPatient(created);
                showNewPatientModal = false;
                message = $"Registered: {created.Name} (#{created.PatientID})";
                messageClass = "success";
            }
        }
        catch (Exception ex)
        {
            newPatientError = ex.GetBaseException().Message;
        }
        finally
        {
            savingNewPatient = false;
            await InvokeAsync(StateHasChanged);
        }
    }

