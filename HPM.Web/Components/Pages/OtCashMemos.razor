        else
        {
            tempDiscount = 0;
            tempDiscountPercent = 0;
        }
    }

    private void ApplyDiscount()
    {
        if (tempDiscount > 0 && string.IsNullOrWhiteSpace(tempDiscountBy)) return;
        editor.Discount = Math.Clamp(tempDiscount, 0, editor.Total);
        editor.DiscountBy = editor.Discount > 0 ? tempDiscountBy?.Trim() : null;
        if (editor.Total > 0 && editor.Discount > 0)
        {
            quickDiscountPercent = Math.Round((editor.Discount / editor.Total) * 100m, 1);
        }
        else
        {
            quickDiscountPercent = 0;
        }
        CloseDiscountModal();
    }

    private void RemoveDiscount()
    {
        tempDiscount = 0;
        tempDiscountPercent = 0;
        tempDiscountBy = null;
        editor.Discount = 0;
        editor.DiscountBy = null;
        quickDiscountPercent = 0;
        CloseDiscountModal();
    }

