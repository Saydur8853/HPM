@page "/ot-cash-memos"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.Cashier + "," + RoleNames.OTOperator)]
@rendermode InteractiveServer
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject IBarcodeQrService BarcodeQr
@inject PatientSelectionState PatientSelection
@implements IDisposable
@using System.Security.Claims
@using HPM.Web.Components.Common
@using HPM.Web.Services

<PageTitle>@I18n.T("OT Cash Memo") | @Branding.HospitalName</PageTitle>

<div class="ot-classic-fit">
    <!-- Compact Top Action & Status Bar -->
    <div class="ot-classic-topbar">
        <div class="tickets-top-left">
            <h1 class="tickets-page-title">
                <span>🏥</span>
                <span>@I18n.T("OT Cash Memo")</span>
            </h1>
            <span class="tickets-count-pill">
                @memos.Count @I18n.T("Memos")
            </span>
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <span class="tickets-inline-alert @messageClass" title="@message">
                    @(messageClass == "success" ? "✓" : "⚠") @message
                </span>
            }
        </div>

        <div class="tickets-top-actions">
            <button type="button" class="btn btn-secondary tickets-btn" @onclick="Reset" title="@I18n.T("New OT memo / Reset Form")">
                + @I18n.T("New OT memo")
            </button>
        </div>
    </div>

    <!-- Main Balanced Workspace Grid: Left Billing Form, Right Recent Memos -->
    <div class="ot-classic-workspace">
        <!-- Left Panel: Form Card -->
        <div class="ot-form-card">
            <div class="ot-card-header">
                <h2>@(editor.ID == 0 ? I18n.T("Operation theatre billing") : $"{I18n.T("Edit OT memo")} #{editor.ID}")</h2>
                <span class="ot-badge">
                    @(editor.ID == 0 ? "🏥 " + I18n.T("OPERATION THEATRE") : $"MEMO #{editor.ID}")
                </span>
            </div>

            <EditForm Model="editor" OnValidSubmit="SaveAsync" class="ot-form-wrapper">
                <DataAnnotationsValidator />

                <div class="ot-form-body">
                    <!-- Demographic Section -->
                    <div class="billing-demographics-grid ot">
                        <label>
                            <span>@I18n.T("Patient ID (Optional)")</span>
                            <div class="tickets-patient-search-combo">
                                <input class="classic-input"
                                       value="@editor.PatientID"
                                       @oninput="HandlePatientIdInputAsync"
                                       @onfocus="ShowPatientIdSuggestionsAsync"
                                       @onblur="HidePatientSuggestionsAsync"
                                       @onkeydown="HandlePatientIdKeyDown"
                                       autocomplete="off"
                                       placeholder="@I18n.T("Patient ID or mobile")"
                                       title="@I18n.T("Type Patient ID or mobile & press Enter to find")" />
                                <button type="button" class="btn-find" @onclick="FindPatientAsync" title="@I18n.T("Find Patient (Enter)")">
                                    <SearchIcon /> @I18n.T("Find")
                                </button>
                            </div>
                            @if (showPatientIdSuggestions && patientIdSuggestions.Count > 0)
                            {
                                <div class="appt-patient-suggestions">
                                    @foreach (var patient in patientIdSuggestions)
                                    {
                                        <button type="button" class="appt-patient-option" @onmousedown:preventDefault @onclick="() => SelectPatientFromSuggestion(patient)">
                                            <span class="patient-id">@patient.PatientID</span>
                                            <span class="patient-name">@patient.Name</span>
                                            <span class="patient-contact">@patient.Contact</span>
                                        </button>
                                    }
                                </div>
                            }
                        </label>
                        <label>
                            <span>@I18n.T("Patient name")<span class="req">*</span></span>
                            <InputText class="classic-input" @bind-Value="editor.PatientName" placeholder="@I18n.T("Full name")" />
                        </label>
                        <label>
                            <span>@I18n.T("Contact Mobile")</span>
                            <InputText class="classic-input" @bind-Value="editor.Contact" placeholder="017xxxxxxxx" />
                        </label>
                        <label>
                            <span>@I18n.T("Age / Sex")</span>
                            <div style="display: flex; gap: 4px;">
                                <InputText class="classic-input" style="width: 50px; flex-shrink: 0;" @bind-Value="editor.Age" placeholder="40Y" />
                                <InputSelect class="classic-input tickets-select" @bind-Value="editor.Sex">
                                    <option value="">@I18n.T("Sex")</option>
                                    <option value="Male">@I18n.T("Male")</option>
                                    <option value="Female">@I18n.T("Female")</option>
                                    <option value="Other">@I18n.T("Other")</option>
                                </InputSelect>
                            </div>
                        </label>
                        <label>
                            <span>@I18n.T("OT room")</span>
                            <InputSelect class="classic-input tickets-select" @bind-Value="editor.OT">
                                <option value="1">@I18n.T("Main OT")</option>
                                <option value="2">@I18n.T("Emergency OT")</option>
                                <option value="3">@I18n.T("Day-care OT")</option>
                            </InputSelect>
                        </label>
                        <div class="billing-doc-col" style="grid-column: span 3;">
                            <span class="classic-field-title">@I18n.T("Referred by")</span>
                            @if (SelectedReferredDoctor != null)
                            {
                                <div class="emergency-selected-doctor-badge">
                                    <span class="doc-icon">👨‍⚕️</span>
                                    <div class="doc-meta" title="@DoctorLabel(SelectedReferredDoctor)">
                                        <strong>@DoctorNameFormatter.FormatFullName(SelectedReferredDoctor.Title, SelectedReferredDoctor.Name)</strong>
                                        <small>@SelectedReferredDoctor.Degree</small>
                                    </div>
                                    <div class="doc-actions">
                                        <button type="button" class="btn-doc-edit" @onclick="() => OpenDoctorModal(false)" title="@I18n.T("Change Doctor")">✏️</button>
                                        <button type="button" class="btn-doc-clear" @onclick="() => ClearDoctor(false)" title="@I18n.T("Remove Doctor")">✕</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button type="button" class="btn-emergency-doc-trigger" @onclick="() => OpenDoctorModal(false)">
                                    <span class="doc-trigger-text">🩺 @I18n.T("Select Doctor / Walk-in")</span>
                                    <span class="btn-pill-action"><SearchIcon /> @I18n.T("Browse")</span>
                                </button>
                            }
                        </div>
                    </div>

                    <!-- OT Services Line Editor -->
                    <h3 class="billing-section-heading">🏥 @I18n.T("OT Services & Procedures")</h3>
                    <div class="billing-line-editor ot">
                        <label style="flex: 1.4; min-width: 140px;">
                            <span>@I18n.T("Service Item", "Service")</span>
                            <select class="classic-input tickets-select" value="@selectedServiceId" @onchange="ServiceChanged">
                                @foreach (var service in services)
                                {
                                    <option value="@service.ID">@service.Name</option>
                                }
                            </select>
                        </label>
                        <div class="billing-line-doc-col" style="flex: 1.2; min-width: 130px;">
                            <span>@I18n.T("Assigned doctor")</span>
                            @if (SelectedLineDoctor != null)
                            {
                                <div class="emergency-selected-doctor-badge" title="@DoctorLabel(SelectedLineDoctor)">
                                    <span class="doc-icon">👨‍⚕️</span>
                                    <div class="doc-meta">
                                        <strong>@DoctorNameFormatter.FormatFullName(SelectedLineDoctor.Title, SelectedLineDoctor.Name)</strong>
                                        <small>@SelectedLineDoctor.Degree</small>
                                    </div>
                                    <div class="doc-actions">
                                        <button type="button" class="btn-doc-edit" @onclick="() => OpenDoctorModal(true)" title="@I18n.T("Change")">✏️</button>
                                        <button type="button" class="btn-doc-clear" @onclick="() => ClearDoctor(true)" title="@I18n.T("Remove")">✕</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button type="button" class="btn-emergency-doc-trigger" @onclick="() => OpenDoctorModal(true)">
                                    <span class="doc-trigger-text">👨‍⚕️ @I18n.T("Assign Doctor")</span>
                                    <span class="btn-pill-action"><SearchIcon /></span>
                                </button>
                            }
                        </div>
                        <label style="width: 80px;">
                            <span>@I18n.T("Rate")</span>
                            <InputNumber class="classic-input bold-number" @bind-Value="lineRate" />
                        </label>
                        <label style="width: 52px;">
                            <span>@I18n.T("Qty")</span>
                            <InputNumber class="classic-input" @bind-Value="lineQuantity" />
                        </label>
                        <div class="billing-line-btn-group">
                            <button class="btn btn-dark tickets-btn btn-add-line" type="button" @onclick="AddLine">+ @I18n.T("Add")</button>
                            <button class="btn btn-secondary tickets-btn btn-browse-catalog" type="button" @onclick="OpenCatalogModal" title="@I18n.T("Browse full OT catalog in popup modal")">
                                <SearchIcon /> @I18n.T("Catalog")
                            </button>
                        </div>
                    </div>

                    <!-- Line Table -->
                    <div class="billing-line-table-wrap">
                        <div class="billing-line-head ot">
                            <span>#</span>
                            <span>@I18n.T("Service Item", "Service")</span>
                            <span>@I18n.T("Doctor")</span>
                            <span style="text-align: right;">@I18n.T("Rate × Qty")</span>
                            <span style="text-align: right;">@I18n.T("Amount")</span>
                            <span></span>
                        </div>
                        <div class="billing-line-rows">
                            @if (editor.Items.Count == 0)
                            {
                                <div class="tickets-queue-empty" style="padding: 1rem;">
                                    <span>@I18n.T("Add at least one OT service.")</span>
                                </div>
                            }
                            @foreach (var item in editor.Items)
                            {
                                <div class="billing-line-row ot">
                                    <span>@item.SLNO</span>
                                    <span>@ServiceName(item.ServiceID)</span>
                                    <span>@DoctorName(item.DoctorID)</span>
                                    <span style="text-align: right;">@(I18n.FormatCurrency(item.Rate)) × @item.Quantity</span>
                                    <strong>@(I18n.FormatCurrency(item.Rate * item.Quantity))</strong>
                                    <button type="button" title="@I18n.T("Delete")" @onclick="() => RemoveLine(item)">×</button>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Remarks & Totals Summary Panel (Permanently Anchored Above Footer) -->
                <div class="ot-bottom-panel">
                    <!-- Left: OT Room Badge / Info -->
                    <div class="ot-bottom-info">
                        <span class="ot-room-pill">
                            🏛️ @(editor.OT == 2 ? I18n.T("Emergency OT") : editor.OT == 3 ? I18n.T("Day-care OT") : I18n.T("Main OT"))
                        </span>
                        @if (!string.IsNullOrWhiteSpace(editor.DiscountBy))
                        {
                            <span class="ot-auth-pill" title="Discount Authorized By">
                                ✓ Auth: @editor.DiscountBy
                            </span>
                        }
                    </div>

                    <!-- Right: Streamlined Totals Strip -->
                    <div class="emg-totals-strip">
                        <div class="emg-stat">
                            <span class="stat-lbl">@I18n.T("Gross")</span>
                            <span class="stat-val gross-val">@(I18n.FormatCurrency(editor.Total))</span>
                        </div>
                        <div class="emg-stat discount-stat" @onclick="OpenDiscountModal" title="@I18n.T("Click to set or modify discount in modal")">
                            <div class="stat-lbl-row">
                                <span class="stat-lbl">@I18n.T("Discount")</span>
                                <span class="stat-edit-icon">✏️</span>
                            </div>
                            <span class="stat-val @(editor.Discount > 0 ? "has-discount" : "")">
                                @(editor.Discount > 0 ? $"-{I18n.FormatCurrency(editor.Discount)}" : "৳ 0")
                            </span>
                        </div>
                        <div class="emg-stat due-stat">
                            <span class="stat-lbl">@I18n.T("Net Payable")</span>
                            <span class="stat-val due-amount">@(I18n.FormatCurrency(Math.Max(0, editor.Total - editor.Discount)))</span>
                        </div>
                    </div>
                </div>

                <!-- Footer Actions -->
                <div class="ot-form-footer">
                    <button class="btn btn-primary tickets-btn" type="submit" disabled="@saving">
                        @(saving ? I18n.T("Saving…") : editor.ID == 0 ? I18n.T("Save OT memo") : I18n.T("Update OT memo"))
                    </button>
                    <div style="display:flex; align-items:center; gap:6px;">
                        @if (editor.ID > 0)
                        {
                            <button class="btn btn-secondary tickets-btn" type="button" @onclick="PrintMemoAsync" title="@I18n.T("Print memo")">
                                🖨️ @I18n.T("Print memo")
                            </button>
                            <button class="btn btn-ghost tickets-btn" type="button" @onclick="DeleteSelectedAsync" style="color: #dc2626;" title="@I18n.T("Delete")">
                                @I18n.T("Delete")
                            </button>
                        }
                        <button class="btn btn-ghost tickets-btn" type="button" @onclick="Reset">
                            @I18n.T("Clear")
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>

        <!-- Right Panel: Recent OT Memos Queue Card -->
        <div class="ot-queue-card">
            <div class="ot-queue-top">
                <div style="display:flex; align-items:center; gap:8px;">
                    <h2>@I18n.T("Recent OT memos")</h2>
                    <span style="font-size:11.5px; color:#64748b; font-weight:600;">
                        (@DateTime.Today.ToString("dd MMMM yyyy"))
                    </span>
                </div>
                <span class="pill" style="font-size:11px; font-weight:700;">
                    @FilteredMemos.Count() @I18n.T("Listed")
                </span>
            </div>

            <!-- Barcode & QR Scanner Bar -->
            <div class="tickets-scanner-bar">
                <div class="tickets-scanner-input-wrap">
                    <span class="tickets-scanner-icon" title="Barcode / QR Scanner Active">📷</span>
                    <input type="text"
                           class="classic-input tickets-scanner-input"
                           placeholder="@I18n.T("Scan OT Memo Barcode / QR or Patient ID & press Enter...")"
                           @bind="memoScanQuery"
                           @bind:event="oninput"
                           @onkeydown="HandleMemoScanKeyDown" />
                    @if (!string.IsNullOrWhiteSpace(memoScanQuery))
                    {
                        <button type="button" class="tickets-scanner-clear" @onclick="ClearMemoScan" title="Clear">✕</button>
                    }
                </div>
            </div>

            <!-- Queue List with Internal Vertical Scroll -->
            <div class="billing-queue-list">
                @if (!FilteredMemos.Any())
                {
                    <div class="tickets-queue-empty">
                        <span style="font-size: 2rem;">🏥</span>
                        <span>@I18n.T("No matching OT cash memos found.")</span>
                    </div>
                }
                @foreach (var memo in FilteredMemos)
                {
                    <div class="billing-queue-item @(editor.ID == memo.ID ? "active" : "")" @onclick="() => Select(memo)">
                        <span class="billing-queue-serial">#@memo.ID</span>
                        <div class="billing-queue-info">
                            <span class="billing-queue-name">
                                @memo.PatientName
                                @if (!string.IsNullOrWhiteSpace(memo.PatientID))
                                {
                                    <small class="tickets-queue-reg">(@memo.PatientID)</small>
                                }
                            </span>
                            <span class="billing-queue-meta">
                                @memo.TransDate.ToString("dd MMM · hh:mm tt") &bull; @memo.Items.Count @I18n.T("item(s)") &bull; @memo.Contact
                            </span>
                        </div>
                        <div class="tickets-queue-badges">
                            <span class="billing-queue-amount">@(I18n.FormatCurrency(memo.Total))</span>
                        </div>
                        <div class="tickets-queue-actions" @onclick:stopPropagation="true">
                            <button type="button" class="tickets-icon-action" title="@I18n.T("Edit")" @onclick="() => Select(memo)">✏️</button>
                            <button type="button" class="tickets-icon-action" title="@I18n.T("Print")" @onclick="() => Print(memo)">🖨️</button>
                            <button type="button" class="tickets-icon-action danger" title="@I18n.T("Delete")" @onclick="() => DeleteAsync(memo)">✕</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- 1. Doctor Selection Modal (Referred By or Assigned Surgeon) -->
@if (isDoctorModalOpen)
{
    <div class="doctor-modal-backdrop" @onclick="CloseDoctorModal">
        <div class="doctor-modal-dialog" @onclick:stopPropagation>
            <div class="doctor-modal-header">
                <div class="doctor-modal-header-title">
                    <div class="doctor-modal-icon">🩺</div>
                    <div class="doctor-modal-heading">
                        <h3>@(isDoctorModalForLine ? I18n.T("Select Assigned Surgeon / Doctor") : I18n.T("Select Referred by Doctor"))</h3>
                        <small>@I18n.T("Search doctor by name, degree, department, or room")</small>
                    </div>
                </div>
                <button type="button" class="doctor-modal-close" @onclick="CloseDoctorModal" title="@I18n.T("Close")">✕</button>
            </div>
            <div class="doctor-modal-search-wrap">
                <div class="doctor-modal-search-box">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="text"
                           @bind="doctorSearchQuery"
                           @bind:event="oninput"
                           autofocus
                           class="doctor-modal-search-input"
                           placeholder="@I18n.T("Search doctor by name, degree, room...")" />
                    @if (!string.IsNullOrWhiteSpace(doctorSearchQuery))
                    {
                        <button type="button" class="doctor-modal-search-clear" @onclick="() => doctorSearchQuery = string.Empty">×</button>
                    }
                </div>
            </div>
            <div class="doctor-modal-list">
                <!-- Option for None / Not Assigned -->
                <div class="doctor-modal-item @((isDoctorModalForLine ? lineDoctorId == 0 : editor.DoctorID == null) ? "active-selected" : "")"
                     @onclick="() => SelectDoctor(null)">
                    <div class="doctor-modal-item-left">
                        <div class="doc-modal-avatar" style="background:#e2e8f0; color:#475569;">@(isDoctorModalForLine ? "👨‍⚕️" : "🚶")</div>
                        <div class="doc-modal-info">
                            <span class="doc-modal-name">@(isDoctorModalForLine ? I18n.T("Not assigned / None") : I18n.T("Walk-in / None"))</span>
                            <span class="doc-modal-meta">
                                <span>@(isDoctorModalForLine ? I18n.T("No specific surgeon assigned to this line") : I18n.T("No specific referral doctor assigned"))</span>
                            </span>
                        </div>
                    </div>
                    <button type="button" class="btn-modal-choose">
                        @((isDoctorModalForLine ? lineDoctorId == 0 : editor.DoctorID == null) ? "✓ " + I18n.T("Selected") : I18n.T("Select"))
                    </button>
                </div>

                @if (!FilteredDoctors.Any())
                {
                    <div class="doc-modal-empty">@I18n.T("No doctor found matching your search.")</div>
                }
                else
                {
                    @foreach (var doc in FilteredDoctors.Take(60))
                    {
                        var fullName = DoctorNameFormatter.FormatFullName(doc.Title, doc.Name);
                        var isCurrent = isDoctorModalForLine ? lineDoctorId == doc.ID : editor.DoctorID == doc.ID;
                        <div class="doctor-modal-item @(isCurrent ? "active-selected" : "")"
                             @onclick="() => SelectDoctor(doc)">
                            <div class="doctor-modal-item-left">
                                <div class="doc-modal-avatar">👨‍⚕️</div>
                                <div class="doc-modal-info">
                                    <span class="doc-modal-name">@fullName</span>
                                    <span class="doc-modal-meta">
                                        <span>@doc.Degree</span>
                                        @if (!string.IsNullOrWhiteSpace(doc.Room))
                                        {
                                            <span class="doc-modal-dept-badge" style="background:#e0f2fe; color:#0369a1; border-color:#bae6fd;">Room @doc.Room</span>
                                        }
                                    </span>
                                </div>
                            </div>
                            <button type="button" class="btn-modal-choose">
                                @(isCurrent ? "✓ " + I18n.T("Selected") : I18n.T("Select"))
                            </button>
                        </div>
                    }
                }
            </div>
            <div class="doctor-modal-footer">
                <span class="doctor-modal-footer-count">@FilteredDoctors.Count() @I18n.T("doctors found")</span>
                <button type="button" class="btn-modal-cancel" @onclick="CloseDoctorModal">@I18n.T("Cancel")</button>
            </div>
        </div>
    </div>
}

<!-- 2. Discount & Authorization Modal -->
@if (isDiscountModalOpen)
{
    <div class="doctor-modal-backdrop" @onclick="CloseDiscountModal">
        <div class="doctor-modal-dialog discount-modal-dialog" @onclick:stopPropagation>
            <div class="doctor-modal-header">
                <div class="doctor-modal-header-title">
                    <div class="doctor-modal-icon" style="background: linear-gradient(135deg, #059669 0%, #047857 100%);">🏷️</div>
                    <div class="doctor-modal-heading">
                        <h3>@I18n.T("Discount & Authorization")</h3>
                        <small>@I18n.T("Apply concession or discount to gross subtotal")</small>
                    </div>
                </div>
                <button type="button" class="doctor-modal-close" @onclick="CloseDiscountModal" title="@I18n.T("Close")">✕</button>
            </div>
            <div class="discount-modal-body">
                <div class="discount-summary-banner">
                    <div class="summary-stat">
                        <span>@I18n.T("Gross Subtotal")</span>
                        <strong>@(I18n.FormatCurrency(editor.Total))</strong>
                    </div>
                    <div class="summary-stat">
                        <span>@I18n.T("Discount")</span>
                        <strong style="color:#059669;">-@(I18n.FormatCurrency(tempDiscount))</strong>
                    </div>
                    <div class="summary-stat">
                        <span>@I18n.T("Net Payable")</span>
                        <strong style="color:#0284c7;">@(I18n.FormatCurrency(Math.Max(0, editor.Total - tempDiscount)))</strong>
                    </div>
                </div>

                <div class="discount-quick-chips">
                    <span class="quick-chip-title">@I18n.T("Quick Percentages"):</span>
                    <button type="button" class="quick-chip" @onclick="() => SetDiscountPercent(0)">0%</button>
                    <button type="button" class="quick-chip" @onclick="() => SetDiscountPercent(5)">5%</button>
                    <button type="button" class="quick-chip" @onclick="() => SetDiscountPercent(10)">10%</button>
                    <button type="button" class="quick-chip" @onclick="() => SetDiscountPercent(15)">15%</button>
                    <button type="button" class="quick-chip" @onclick="() => SetDiscountPercent(20)">20%</button>
                    <button type="button" class="quick-chip" @onclick="() => SetDiscountPercent(50)">50%</button>
                    <button type="button" class="quick-chip" @onclick="() => SetDiscountPercent(100)">100% (Free)</button>
                </div>

                <div class="discount-form-fields">
                    <label>
                        <span>@I18n.T("Discount Amount (৳)")</span>
                        <input type="number"
                               step="0.01"
                               min="0"
                               max="@editor.Total"
                               class="classic-input bold-number"
                               value="@tempDiscount"
                               @oninput="HandleTempDiscountInput" />
                    </label>

                    <label>
                        <span>
                            @I18n.T("Authorized By")
                            @if (tempDiscount > 0)
                            {
                                <span class="req">*</span>
                            }
                        </span>
                        <input type="text"
                               class="classic-input"
                               maxlength="50"
                               placeholder="@I18n.T("Name / Title of authorizing authority")"
                               @bind="tempDiscountBy"
                               @bind:event="oninput" />
                    </label>
                </div>

                @if (tempDiscount > 0)
                {
                    <div class="authorizer-quick-chips">
                        <span class="quick-chip-title">@I18n.T("Quick Authorizer"):</span>
                        <button type="button" class="quick-chip" @onclick='() => tempDiscountBy = "Duty Doctor"'>Duty Doctor</button>
                        <button type="button" class="quick-chip" @onclick='() => tempDiscountBy = "RMO"'>RMO</button>
                        <button type="button" class="quick-chip" @onclick='() => tempDiscountBy = "Hospital Director"'>Director</button>
                        <button type="button" class="quick-chip" @onclick='() => tempDiscountBy = "Admin Office"'>Admin Office</button>
                    </div>
                }

                @if (tempDiscount > 0 && string.IsNullOrWhiteSpace(tempDiscountBy))
                {
                    <div class="discount-warning-note">
                        ⚠️ @I18n.T("Authorization name is required when discount is greater than 0.")
                    </div>
                }
            </div>
            <div class="doctor-modal-footer">
                <button type="button" class="btn btn-ghost tickets-btn" @onclick="RemoveDiscount" style="color: #dc2626;">@I18n.T("Remove Discount")</button>
                <div style="display:flex; gap:8px;">
                    <button type="button" class="btn-modal-cancel" @onclick="CloseDiscountModal">@I18n.T("Cancel")</button>
                    <button type="button" class="btn-primary tickets-btn" @onclick="ApplyDiscount" disabled="@(tempDiscount > 0 && string.IsNullOrWhiteSpace(tempDiscountBy))">
                        @I18n.T("Apply Discount")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- 3. OT Services & Procedures Catalog Modal -->
@if (isCatalogModalOpen)
{
    <div class="doctor-modal-backdrop" @onclick="CloseCatalogModal">
        <div class="doctor-modal-dialog service-modal-dialog" @onclick:stopPropagation>
            <div class="doctor-modal-header">
                <div class="doctor-modal-header-title">
                    <div class="doctor-modal-icon" style="background: linear-gradient(135deg, #0d9488 0%, #0f766e 100%);">🏥</div>
                    <div class="doctor-modal-heading">
                        <h3>@I18n.T("OT Services & Procedures Catalog")</h3>
                        <small>@I18n.T("Quick search and add operation theatre procedures")</small>
                    </div>
                </div>
                <button type="button" class="doctor-modal-close" @onclick="CloseCatalogModal" title="@I18n.T("Close")">✕</button>
