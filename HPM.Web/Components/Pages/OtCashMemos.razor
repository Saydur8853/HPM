</div>

@code {
    [SupplyParameterFromQuery(Name = "patientId")]
    public string? QueryPatientId { get; set; }

    private CashMemoOT editor = NewMemo();
    private List<DoctorsProfile> doctors = [];
    private List<Service> services = [];
    private List<ServiceCategory> categories = [];
    private List<CashMemoOT> memos = [];
    private string memoScanQuery = string.Empty;
    private int selectedServiceId;
    private int lineDoctorId;
    private decimal lineRate;
    private int lineQuantity = 1;
    private string message = string.Empty;
    private string messageClass = "success";
    private bool saving;
    private bool showPatientIdSuggestions;
    private List<Registration> patientIdSuggestions = [];

    // Modals state
    private bool isDoctorModalOpen;
    private bool isDoctorModalForLine;
    private string doctorSearchQuery = string.Empty;

    private bool isDiscountModalOpen;
    private decimal tempDiscount;
    private string? tempDiscountBy;

    private bool isCatalogModalOpen;
    private string catalogSearchQuery = string.Empty;
    private int catalogCategoryId = 0;

    private DoctorsProfile? SelectedReferredDoctor =>
        editor.DoctorID.HasValue ? doctors.FirstOrDefault(d => d.ID == editor.DoctorID.Value) : null;

    private DoctorsProfile? SelectedLineDoctor =>
        lineDoctorId > 0 ? doctors.FirstOrDefault(d => d.ID == lineDoctorId) : null;

    private IEnumerable<DoctorsProfile> FilteredDoctors => string.IsNullOrWhiteSpace(doctorSearchQuery)
        ? doctors
        : doctors.Where(d => (d.Name?.Contains(doctorSearchQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)
                          || (d.Degree?.Contains(doctorSearchQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)
                          || (d.Room?.Contains(doctorSearchQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false));

    private IEnumerable<Service> CatalogFilteredServices
    {
        get
        {
            var result = services.AsEnumerable();
            if (catalogCategoryId > 0)
            {
                result = result.Where(s => s.CategoryID == catalogCategoryId);
            }
            if (!string.IsNullOrWhiteSpace(catalogSearchQuery))
            {
                var q = catalogSearchQuery.Trim();
                result = result.Where(s => s.Name != null && s.Name.Contains(q, StringComparison.OrdinalIgnoreCase));
            }
            return result;
        }
    }

    private IEnumerable<CashMemoOT> FilteredMemos => string.IsNullOrWhiteSpace(memoScanQuery)
        ? memos
        : memos.Where(m => m.ID.ToString().Contains(memoScanQuery.Trim(), StringComparison.OrdinalIgnoreCase)
                        || (m.PatientName?.Contains(memoScanQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)
                        || (m.PatientID?.Contains(memoScanQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)
                        || (m.Contact?.Contains(memoScanQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        await using var db = await DbFactory.CreateDbContextAsync();
        doctors = await db.Doctors.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
        foreach (var d in doctors)
        {
            d.Name = DoctorNameFormatter.Sanitize(d.Name);
            d.Title = DoctorNameFormatter.Sanitize(d.Title);
        }
        var categoryIds = await db.ServiceCategories.AsNoTracking().Where(x => x.ID == 1 || x.SubID == 1).Select(x => x.ID).ToListAsync();
        categories = await db.ServiceCategories.AsNoTracking().Where(x => categoryIds.Contains(x.ID)).OrderBy(x => x.Name).ToListAsync();
        services = await db.Services.AsNoTracking().Where(x => x.CategoryID != null && categoryIds.Contains(x.CategoryID.Value)).OrderBy(x => x.Name).ToListAsync();
        SelectFirstService();
        await LoadMemosAsync();
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnParametersSetAsync()
    {
        var patientId = QueryPatientId ?? PatientSelection.PatientId;
        if (!string.IsNullOrWhiteSpace(patientId) && editor.ID == 0)
        {
            editor.PatientID = patientId.Trim();
            await FindPatientAsync();
        }
    }

    private async Task LoadMemosAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        memos = await db.OTCashMemos.AsNoTracking().Include(x => x.Items).OrderByDescending(x => x.ID).Take(30).ToListAsync();
    }

    private async Task HandlePatientIdInputAsync(ChangeEventArgs e)
    {
        editor.PatientID = e.Value?.ToString();
        await FilterPatientIdSuggestionsAsync();
    }

    private async Task ShowPatientIdSuggestionsAsync()
    {
        await FilterPatientIdSuggestionsAsync();
    }

    private async Task HidePatientSuggestionsAsync()
    {
        await Task.Delay(200);
        showPatientIdSuggestions = false;
    }

    private async Task FilterPatientIdSuggestionsAsync()
    {
        if (string.IsNullOrWhiteSpace(editor.PatientID) || editor.PatientID.Trim().Length < 2)
        {
            patientIdSuggestions.Clear();
            showPatientIdSuggestions = false;
            return;
        }

        var term = editor.PatientID.Trim();
        await using var db = await DbFactory.CreateDbContextAsync();
        patientIdSuggestions = await db.Registrations.AsNoTracking()
            .Where(x => (x.PatientID != null && x.PatientID.Contains(term)) || (x.Contact != null && x.Contact.Contains(term)) || (x.Name != null && x.Name.Contains(term)))
            .OrderByDescending(x => x.ID)
            .Take(8)
            .ToListAsync();

        showPatientIdSuggestions = patientIdSuggestions.Count > 0;
    }

    private void SelectPatient(Registration patient)
    {
        editor.PatientID = patient.PatientID;
        editor.PatientName = patient.Name;
        editor.Age = Age(patient.DateOfBirth);
        editor.Sex = patient.Sex;
        editor.Contact = patient.Contact;
        editor.RegNo = patient.PatientID;
        editor.PatientType = "2";
        PatientSelection.Select(patient.PatientID);
        showPatientIdSuggestions = false;
        messageClass = "success";
        message = I18n.IsBangla ? $"রোগী {patient.Name} ({patient.PatientID}) লোড করা হয়েছে।" : $"Loaded profile for patient {patient.Name} ({patient.PatientID}).";
    }

    private void SelectPatientFromSuggestion(Registration patient)
    {
        SelectPatient(patient);
    }

    private async Task HandlePatientIdKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            showPatientIdSuggestions = false;
            await FindPatientAsync();
        }
        else if (e.Key == "Escape")
        {
            showPatientIdSuggestions = false;
        }
    }

    private async Task FindPatientAsync()
    {
        if (string.IsNullOrWhiteSpace(editor.PatientID)) return;
        var lookup = editor.PatientID.Trim();
        await using var db = await DbFactory.CreateDbContextAsync();
        var patient = await db.Registrations.AsNoTracking().FirstOrDefaultAsync(x => x.PatientID == lookup || x.Contact == lookup);
        if (patient is null && lookup.StartsWith("0") && lookup.Length >= 10)
        {
            var withoutLeadingZero = lookup[1..];
            patient = await db.Registrations.AsNoTracking()
                .Where(x => x.Contact != null && x.Contact.EndsWith(withoutLeadingZero))
                .OrderByDescending(x => x.ID)
                .FirstOrDefaultAsync();
        }
        if (patient is null)
        {
            messageClass = "danger";
            message = I18n.IsBangla ? "পেশেন্ট আইডি পাওয়া যায়নি। আপনি ম্যানুয়ালি রোগীর নাম লিখে কাজ করতে পারেন।" : "Patient ID was not found. You can still enter a walk-in patient.";
            return;
        }
        SelectPatient(patient);
    }

    private void ServiceChanged(ChangeEventArgs e)
    {
        int.TryParse(e.Value?.ToString(), out selectedServiceId);
        lineRate = services.FirstOrDefault(x => x.ID == selectedServiceId)?.SaleRate ?? 0;
    }

    private void SelectFirstService()
    {
        selectedServiceId = services.FirstOrDefault()?.ID ?? 0;
        lineRate = services.FirstOrDefault(x => x.ID == selectedServiceId)?.SaleRate ?? 0;
        lineQuantity = 1;
        lineDoctorId = 0;
    }

    private void AddLine()
    {
        if (selectedServiceId == 0 || lineQuantity < 1 || lineRate < 0)
        {
            messageClass = "danger";
            message = I18n.IsBangla ? "একটি সেবা নির্বাচন করুন এবং সঠিক রেট ও পরিমাণ লিখুন।" : "Select a service and enter a valid rate and quantity.";
            return;
        }
        editor.Items.Add(new CashMemoSubOT
        {
            SLNO = editor.Items.Count + 1,
            ServiceID = selectedServiceId,
            DoctorID = lineDoctorId == 0 ? null : lineDoctorId,
            Rate = lineRate,
            Quantity = lineQuantity
        });
        Recalculate();
        message = string.Empty;
    }

    private void RemoveLine(CashMemoSubOT item)
    {
        editor.Items.Remove(item);
        for (var i = 0; i < editor.Items.Count; i++) editor.Items[i].SLNO = i + 1;
        Recalculate();
    }

    private void Recalculate() => editor.Total = editor.Items.Sum(x => x.Rate * x.Quantity);

    private async Task SaveAsync()
    {
        if (editor.Items.Count == 0)
        {
            messageClass = "danger";
            message = I18n.IsBangla ? "সংরক্ষণ করার আগে অন্তত একটি ওটি সেবা যোগ করুন।" : "Add at least one OT service before saving.";
            return;
        }
        var calculatedTotal = editor.Items.Sum(x => x.Rate * x.Quantity);
        if (editor.Items.Any(x => x.Rate < 0 || x.Quantity <= 0))
        {
            messageClass = "danger";
            message = I18n.IsBangla ? "সেবার দর ঋণাত্মক হতে পারে না এবং পরিমাণ ১ বা তার বেশি হতে হবে।" : "Service rate cannot be negative and quantity must be greater than zero.";
            return;
        }
        if (editor.Discount < 0 || editor.Discount > calculatedTotal)
        {
            messageClass = "danger";
            message = I18n.IsBangla ? "ছাড় ০ থেকে মোট টাকার মধ্যে হতে হবে।" : "Discount must be between zero and the gross total.";
            return;
        }
        if (editor.Discount > 0 && string.IsNullOrWhiteSpace(editor.DiscountBy))
        {
            messageClass = "danger";
            message = I18n.IsBangla ? "ছাড়ের জন্য অনুমোদনকারী ব্যক্তির নাম আবশ্যক।" : "Discount authorization is required.";
            return;
        }
        if ((editor.DiscountBy?.Trim().Length ?? 0) > 50)
        {
            messageClass = "danger";
            message = I18n.IsBangla ? "অনুমোদনকারীর নাম ৫০ অক্ষরের বেশি হতে পারবে না।" : "Discount authorization cannot exceed 50 characters.";
            return;
        }

        saving = true;
        try
        {
            var userId = await CurrentUserIdAsync();
            editor.Total = calculatedTotal;
            editor.DiscountBy = string.IsNullOrWhiteSpace(editor.DiscountBy) ? null : editor.DiscountBy.Trim();
            var isNew = editor.ID == 0;
            if (isNew)
            {
                editor.TransDate = DateTime.Now;
                editor.EnteredBy = userId;
            }

            long memoId = 0;
            await using var strategyDb = await DbFactory.CreateDbContextAsync();
            var strategy = strategyDb.Database.CreateExecutionStrategy();
            await strategy.ExecuteAsync(async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                await using var tx = await db.Database.BeginTransactionAsync();

                if (isNew)
                {
                    db.OTCashMemos.Add(editor);
                }
                else
                {
                    var existing = await db.OTCashMemos.Include(x => x.Items).SingleAsync(x => x.ID == editor.ID);
                    db.OTCashMemoItems.RemoveRange(existing.Items);
                    db.Entry(existing).CurrentValues.SetValues(editor);
                    existing.Items = editor.Items.Select(x => new CashMemoSubOT
                    {
                        SLNO = x.SLNO,
                        ServiceID = x.ServiceID,
                        DoctorID = x.DoctorID,
                        Rate = x.Rate,
                        Quantity = x.Quantity
                    }).ToList();
                }
                await db.SaveChangesAsync();

                var net = Math.Max(0, editor.Total - editor.Discount);
                var debitAccount = editor.PatientType == "1" ? AccountingPosting.Cash : AccountingPosting.PatientReceivable;
                await OperationalAccounting.SyncRevenueAsync(db, $"OT-MEMO:{editor.ID}", editor.ID,
                    net, editor.TransDate, userId, $"OT cash memo #{editor.ID}",
                    debitAccount, editor.PatientType == "1" ? 13 : null);

                await db.SaveChangesAsync();
                await tx.CommitAsync();

                memoId = editor.ID;
            });

            messageClass = "success";
            message = I18n.IsBangla ? $"ওটি ক্যাশ মেমো #{memoId} সফলভাবে সংরক্ষিত হয়েছে।" : $"OT cash memo #{memoId} saved successfully.";
            ResetEditor();
            await LoadMemosAsync();
        }
        catch (Exception ex)
        {
            messageClass = "danger";
            message = I18n.IsBangla ? $"ওটি মেমো সংরক্ষণ করা যায়নি: {ex.GetBaseException().Message}" : $"Could not save OT memo: {ex.GetBaseException().Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private void Reset()
    {
        showPatientIdSuggestions = false;
        PatientSelection.Clear();
        ResetEditor();
        message = string.Empty;
    }

    private void ResetEditor()
    {
        editor = NewMemo();
        tempDiscount = 0;
        tempDiscountBy = null;
        lineDoctorId = 0;
        SelectFirstService();
    }

    private void Select(CashMemoOT m)
    {
        editor = new CashMemoOT
        {
            ID = m.ID,
            PatientName = m.PatientName,
            PatientType = m.PatientType,
            Bed = m.Bed,
            Age = m.Age,
            Sex = m.Sex,
            Contact = m.Contact,
            PatientID = m.PatientID,
            RegNo = m.RegNo,
            DoctorID = m.DoctorID,
            OT = m.OT,
            Total = m.Total,
            Discount = m.Discount,
            DiscountBy = m.DiscountBy,
            EnteredBy = m.EnteredBy,
            TransDate = m.TransDate,
            Items = m.Items.OrderBy(x => x.SLNO).Select(x => new CashMemoSubOT
            {
                ID = x.ID,
                MemoID = x.MemoID,
                SLNO = x.SLNO,
                ServiceID = x.ServiceID,
                Rate = x.Rate,
                Quantity = x.Quantity,
                DoctorID = x.DoctorID
            }).ToList()
        };
        tempDiscount = m.Discount;
        tempDiscountBy = m.DiscountBy;
        message = string.Empty;
    }

    // Modal Handlers
    private void OpenDoctorModal(bool forLine)
    {
        isDoctorModalForLine = forLine;
        doctorSearchQuery = string.Empty;
        isDoctorModalOpen = true;
    }

    private void CloseDoctorModal()
    {
        isDoctorModalOpen = false;
        doctorSearchQuery = string.Empty;
    }

    private void SelectDoctor(DoctorsProfile? doctor)
    {
        if (isDoctorModalForLine)
        {
            lineDoctorId = doctor?.ID ?? 0;
        }
        else
        {
            editor.DoctorID = doctor?.ID;
        }
        CloseDoctorModal();
    }

    private void ClearDoctor(bool forLine)
    {
        if (forLine)
        {
            lineDoctorId = 0;
        }
        else
        {
            editor.DoctorID = null;
        }
    }

    private void OpenDiscountModal()
    {
        tempDiscount = editor.Discount;
        tempDiscountBy = editor.DiscountBy;
        isDiscountModalOpen = true;
    }

    private void CloseDiscountModal()
    {
        isDiscountModalOpen = false;
    }

    private void HandleTempDiscountInput(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var val))
        {
            tempDiscount = Math.Clamp(val, 0, editor.Total);
        }
        else
        {
            tempDiscount = 0;
        }
    }

    private void SetDiscountPercent(decimal percent)
    {
        tempDiscount = Math.Round((editor.Total * percent) / 100m, 2);
        if (tempDiscount > 0 && string.IsNullOrWhiteSpace(tempDiscountBy))
        {
            tempDiscountBy = "Duty Doctor";
        }
    }

    private void ApplyDiscount()
    {
        editor.Discount = Math.Clamp(tempDiscount, 0, editor.Total);
        editor.DiscountBy = editor.Discount > 0 ? tempDiscountBy : null;
        CloseDiscountModal();
