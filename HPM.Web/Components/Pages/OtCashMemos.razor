                <div class="a5-fin-row a5-fin-net">
                    <span>Net Payable Tk.</span>
                    <span class="a5-colon">:</span>
                    <span class="a5-fin-val">@Math.Max(0, editor.Total - editor.Discount).ToString("N2")</span>
                </div>
                @if (editor.PatientType == "1")
                {
                    <div class="a5-fin-row">
                        <span>Paid Cash Tk.</span>
                        <span class="a5-colon">:</span>
                        <span class="a5-fin-val">@Math.Max(0, editor.Total - editor.Discount).ToString("N2")</span>
                    </div>
                    <div class="a5-fin-row a5-fin-due">
                        <span>Due Tk.</span>
                        <span class="a5-colon">:</span>
                        <span class="a5-fin-val">0.00</span>
                    </div>
                }
                else
                {
                    <div class="a5-fin-row a5-fin-due">
                        <span>Charged to Due Tk.</span>
                        <span class="a5-colon">:</span>
                        <span class="a5-fin-val a5-due-text">@Math.Max(0, editor.Total - editor.Discount).ToString("N2")</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "patientId")]
    public string? QueryPatientId { get; set; }

    private CashMemoOT editor = NewMemo();
    private List<DoctorsProfile> doctors = [];
    private List<Service> services = [];
    private List<ServiceCategory> categories = [];
    private List<CashMemoOT> memos = [];
    private string memoScanQuery = string.Empty;
    private int selectedServiceId;
    private int lineDoctorId;
    private decimal lineRate;
    private int lineQuantity = 1;
    private string message = string.Empty;
    private string messageClass = "success";
    private bool saving;
    private bool showPatientIdSuggestions;
    private List<Registration> patientIdSuggestions = [];
    private DotNetObjectReference<OtCashMemos>? dotNetRef;
    private const int PatientBatchSize = 15;
    private bool hasMorePatientSuggestions = true;
    private bool isLoadingMorePatients = false;
    private string patientSearchQuery = string.Empty;

    // Drawer & Filter state
    private bool showScheduleDrawer = false;
    private string drawerFilter = "All";

    // Format & Auto-print state
    private string printLayout = "A5";
    private string currentUserName = "Cashier";
    private decimal quickDiscountPercent = 0;

    // Referral Doctor inline autocomplete
    private string refDoctorSearchText = string.Empty;
    private bool showRefDoctorSuggestions = false;
    private const int DoctorBatchSize = 15;
    private int refDoctorVisibleCount = DoctorBatchSize;

    // Quick Patient Modal State
    private bool showNewPatientModal = false;
    private Registration newPatientModel = new() { Sex = "Male" };
    private string newPatientAge = "30";
    private bool savingNewPatient = false;
    private string newPatientError = string.Empty;

    // Modals state
    private bool isDoctorModalOpen;
    private bool isDoctorModalForLine;
    private string doctorSearchQuery = string.Empty;

    private bool isDiscountModalOpen;
    private decimal tempDiscount;
    private decimal tempDiscountPercent;
    private string? tempDiscountBy;
    private List<AppUser> authorizers = [];

    private bool isCatalogModalOpen;
    private string catalogSearchQuery = string.Empty;
    private int catalogCategoryId = 0;

    private DoctorsProfile? SelectedReferredDoctor =>
        editor.DoctorID.HasValue ? doctors.FirstOrDefault(d => d.ID == editor.DoctorID.Value) : null;

    private List<DoctorsProfile> FilteredRefDoctorsList => string.IsNullOrWhiteSpace(refDoctorSearchText)
        ? doctors
        : doctors.Where(d => (d.Name?.Contains(refDoctorSearchText.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)
                          || (d.Degree?.Contains(refDoctorSearchText.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)
                          || (d.Room?.Contains(refDoctorSearchText.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)).ToList();

    private IEnumerable<DoctorsProfile> VisibleRefDoctorsList => FilteredRefDoctorsList.Take(refDoctorVisibleCount);
    private bool HasMoreRefDoctorSuggestions => refDoctorVisibleCount < FilteredRefDoctorsList.Count;

    private IEnumerable<DoctorsProfile> FilteredDoctors => string.IsNullOrWhiteSpace(doctorSearchQuery)
        ? doctors
        : doctors.Where(d => (d.Name?.Contains(doctorSearchQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)
                          || (d.Degree?.Contains(doctorSearchQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)
                          || (d.Room?.Contains(doctorSearchQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false));

    private IEnumerable<Service> CatalogFilteredServices
    {
        get
        {
            var result = services.AsEnumerable();
            if (catalogCategoryId > 0)
            {
                result = result.Where(s => s.CategoryID == catalogCategoryId);
            }
            if (!string.IsNullOrWhiteSpace(catalogSearchQuery))
            {
                var q = catalogSearchQuery.Trim();
                result = result.Where(s => s.Name != null && s.Name.Contains(q, StringComparison.OrdinalIgnoreCase));
            }
            return result;
        }
    }

    private decimal TotalTodayCollection => memos.Where(m => m.TransDate.Date == DateTime.Today).Sum(m => Math.Max(0, m.Total - m.Discount));

    private IEnumerable<CashMemoOT> DrawerFilteredMemos
    {
        get
        {
            var result = memos.AsEnumerable();
            if (drawerFilter == "MainOT")
            {
                result = result.Where(m => m.OT == 1);
            }
            else if (drawerFilter == "EmergencyOT")
            {
                result = result.Where(m => m.OT == 2);
            }
            else if (drawerFilter == "DayCareOT")
            {
                result = result.Where(m => m.OT == 3);
            }

            if (!string.IsNullOrWhiteSpace(memoScanQuery))
            {
                var q = memoScanQuery.Trim();
                result = result.Where(m => m.ID.ToString().Contains(q, StringComparison.OrdinalIgnoreCase)
                                        || (m.PatientName?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                                        || (m.PatientID?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                                        || (m.Contact?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
            }
            return result;
        }
    }

