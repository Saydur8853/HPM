    private async Task FindPatientAsync()
    {
        var lookup = (string.IsNullOrWhiteSpace(patientSearchQuery) ? editor.PatientID : patientSearchQuery)?.Trim();
        if (string.IsNullOrWhiteSpace(lookup)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var patient = await db.Registrations.AsNoTracking().Where(x => x.PatientID == lookup || x.Contact == lookup).SelectWithoutPhoto().FirstOrDefaultAsync();
        if (patient is null && lookup.StartsWith("0") && lookup.Length >= 10)
        {
            var withoutLeadingZero = lookup[1..];
            patient = await db.Registrations.AsNoTracking()
                .Where(x => x.Contact != null && x.Contact.EndsWith(withoutLeadingZero)).SelectWithoutPhoto()
                .OrderByDescending(x => x.ID)
                .FirstOrDefaultAsync();
        }
        if (patient is null)
        {
            patient = await db.Registrations.AsNoTracking()
                .Where(x => x.Name != null && x.Name.Contains(lookup)).SelectWithoutPhoto()
                .OrderByDescending(x => x.ID)
                .FirstOrDefaultAsync();
        }
        if (patient is null)
        {
            messageClass = "danger";
            message = I18n.IsBangla ? "রোগী পাওয়া যায়নি।" : "Patient not found. You can enter details directly.";
            return;
        }
        SelectPatient(patient);
    }

