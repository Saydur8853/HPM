@code {
    private DateTime fromDate = DateTime.Today;
    private DateTime toDate = DateTime.Today;
    private string currentPreset = "today";
    private string activeTab = "summary";
    private string message = "";
    private string searchQuery = "";

    // Aggregated KPI Totals
    private decimal grandGross;
    private decimal grandDiscount;
    private decimal grandNet;
    private decimal grandPaid;
    private decimal grandDue;
    private int totalTransactionsCount;

    private decimal totalRefunds;
    private int refundsCount;

    // Structured Reporting Models
    private sealed record DeptRevenueRow(string Icon, string Name, int Count, decimal Gross, decimal Discount, decimal Net, decimal Paid, decimal Due);
    private List<DeptRevenueRow> departmentRows = [];

    private sealed record CashierRow(int UserId, string UserName, int Count, decimal Amount);
    private List<CashierRow> cashierRows = [];

    private sealed record RefundLogRow(DateTime Date, string Category, string Reference, string Reason, decimal Amount);
    private List<RefundLogRow> refundLogRows = [];

    private IEnumerable<DeptRevenueRow> FilteredDepartmentRows =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? departmentRows
            : departmentRows.Where(x => x.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<CashierRow> FilteredCashierRows =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? cashierRows
            : cashierRows.Where(x => x.UserName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) || x.UserId.ToString().Contains(searchQuery));

    private IEnumerable<RefundLogRow> FilteredRefundRows =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? refundLogRows
            : refundLogRows.Where(x => x.Category.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
                                    || x.Reference.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
                                    || (x.Reason ?? "").Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        await LoadAsync();
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    private void SetToday()
    {
        currentPreset = "today";
        fromDate = DateTime.Today;
        toDate = DateTime.Today;
        _ = LoadAsync();
    }

    private void SetYesterday()
    {
        currentPreset = "yesterday";
        fromDate = DateTime.Today.AddDays(-1);
        toDate = DateTime.Today.AddDays(-1);
        _ = LoadAsync();
    }

    private void SetLast7Days()
    {
        currentPreset = "7days";
        fromDate = DateTime.Today.AddDays(-6);
        toDate = DateTime.Today;
        _ = LoadAsync();
    }

    private void SetThisMonth()
    {
        currentPreset = "month";
        fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        toDate = DateTime.Today;
        _ = LoadAsync();
    }

    private void SetThisYear()
    {
        currentPreset = "year";
        fromDate = new DateTime(DateTime.Today.Year, 1, 1);
        toDate = DateTime.Today;
        _ = LoadAsync();
    }

    private void OnFromDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            fromDate = dt;
            currentPreset = "custom";
        }
    }

    private void OnToDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            toDate = dt;
            currentPreset = "custom";
        }
    }

    private async Task LoadAsync()
    {
        if (toDate.Date < fromDate.Date)
        {
            message = I18n.IsBangla ? "শেষের তারিখ শুরুর তারিখের আগের হতে পারে না।" : "To date cannot be earlier than From date.";
            return;
        }

        message = "";
        var start = fromDate.Date;
        var end = toDate.Date.AddDays(1);

        await using var db = await DbFactory.CreateDbContextAsync();

        // 1. OPD Tickets
        var opdTickets = await db.OPDTickets.AsNoTracking()
            .Where(x => x.TransDate >= start && x.TransDate < end)
            .ToListAsync();

        // 2. Emergency Memos (ModuleID == 11)
        var emergencyMemos = await db.EmergencyMemos.AsNoTracking()
            .Where(x => x.TransDate >= start && x.TransDate < end && x.ModuleID == 11)
            .ToListAsync();

        // 3. Diagnostic & Lab Memos (ModuleID != 11)
        var diagMemos = await db.EmergencyMemos.AsNoTracking()
            .Where(x => x.TransDate >= start && x.TransDate < end && x.ModuleID != 11)
            .ToListAsync();

        // 4. OT Cash Memos
        var otMemos = await db.OTCashMemos.AsNoTracking()
            .Where(x => x.TransDate >= start && x.TransDate < end)
            .ToListAsync();

        // 5. IPD Advance Receipts
        var ipdReceipts = await db.IpdMoneyReceipts.AsNoTracking()
            .Where(x => x.TransDate >= start && x.TransDate < end)
            .ToListAsync();

        // 6. IPD Final Settlement Bills
        var ipdBills = await db.IpdFinalBills.AsNoTracking()
            .Where(x => x.DischargeDate >= start && x.DischargeDate < end)
            .ToListAsync();

        // 7. Pharmacy Sales Memos
        var pharmacyMemos = await db.PharmacyCashMemos.AsNoTracking()
            .Where(x => x.TransDate >= start && x.TransDate < end)
            .ToListAsync();

        // 8. Returns & Reversals
        var diagReturns = await db.DiagnosticCashMemoReturns.AsNoTracking()
            .Where(x => x.TransDate >= start && x.TransDate < end && x.Status == "Posted")
            .ToListAsync();

        var pharmReturns = await db.PharmacySalesReturns.AsNoTracking()
            .Where(x => x.TransDate >= start && x.TransDate < end && x.IsPosted)
            .ToListAsync();

        var reversals = await db.FinancialReversals.AsNoTracking()
            .Where(x => x.ReversedAt >= start && x.ReversedAt < end)
            .ToListAsync();

        // Departmental Breakdown Rows
        departmentRows =
        [
            new("🎫", I18n.T("OPD Consultation Tickets", "ওপিডি কনসালটেশন টিকিট"),
                opdTickets.Count,
                opdTickets.Sum(x => x.Total),
                0,
                opdTickets.Sum(x => x.Total),
                opdTickets.Sum(x => x.Total),
                0),

            new("🚨", I18n.T("Emergency Services", "জরুরি সেবা"),
                emergencyMemos.Count,
                emergencyMemos.Sum(x => x.Total),
                emergencyMemos.Sum(x => x.Discount),
                emergencyMemos.Sum(x => x.Total - x.Discount),
                emergencyMemos.Sum(x => x.Paid),
                emergencyMemos.Sum(x => Math.Max(0, (x.Total - x.Discount) - x.Paid))),

            new("🔬", I18n.T("Diagnostic & Pathology", "প্যাথলজি ও ডায়াগনস্টিক"),
                diagMemos.Count,
                diagMemos.Sum(x => x.Total),
                diagMemos.Sum(x => x.Discount),
                diagMemos.Sum(x => x.Total - x.Discount),
                diagMemos.Sum(x => x.Paid),
                diagMemos.Sum(x => Math.Max(0, (x.Total - x.Discount) - x.Paid))),

            new("🔪", I18n.T("Operation Theater (OT)", "অপারেশন থিয়েটার (ওটি)"),
                otMemos.Count,
                otMemos.Sum(x => x.Total),
                otMemos.Sum(x => x.Discount),
                otMemos.Sum(x => x.Total - x.Discount),
                otMemos.Sum(x => x.Total - x.Discount),
                0),

            new("💰", I18n.T("IPD Inpatient Advance Receipts", "আইপিডি ভর্তি রোগীর অগ্রিম জমা"),
                ipdReceipts.Count,
                ipdReceipts.Sum(x => x.Amount),
                0,
                ipdReceipts.Sum(x => x.Amount),
                ipdReceipts.Sum(x => x.Amount),
                0),

            new("🧾", I18n.T("IPD Final Discharge Bills", "আইপিডি চূড়ান্ত ডিসচার্জ বিল"),
                ipdBills.Count,
                ipdBills.Sum(x => x.GrossAmount),
                ipdBills.Sum(x => x.DiscountAmount),
                ipdBills.Sum(x => x.NetAmount),
                ipdBills.Sum(x => x.ReceiptAmount),
                ipdBills.Sum(x => x.BalanceDue)),

            new("💊", I18n.T("Pharmacy Medicine Sales", "ফার্মেসি ওষুধ বিক্রয়"),
                pharmacyMemos.Count,
                pharmacyMemos.Sum(x => x.Total ?? 0),
                pharmacyMemos.Sum(x => x.Discount ?? 0),
                pharmacyMemos.Sum(x => (x.Total ?? 0) - (x.Discount ?? 0)),
                pharmacyMemos.Sum(x => (x.Total ?? 0) - (x.Discount ?? 0)),
                0)
        ];

        // Overall Totals
        grandGross = departmentRows.Sum(x => x.Gross);
        grandDiscount = departmentRows.Sum(x => x.Discount);
        grandNet = departmentRows.Sum(x => x.Net);
        grandPaid = departmentRows.Sum(x => x.Paid);
        grandDue = departmentRows.Sum(x => x.Due);
        totalTransactionsCount = departmentRows.Sum(x => x.Count);

        totalRefunds = diagReturns.Sum(x => x.RefundAmount) + pharmReturns.Sum(x => x.RefundAmount) + reversals.Sum(x => x.Amount);
        refundsCount = diagReturns.Count + pharmReturns.Count + reversals.Count;

        // Cashier Summary
        var cashierMap = new Dictionary<int, (int count, decimal amount)>();

        void AccumulateCashier(int userId, decimal amt)
        {
            if (userId <= 0) userId = 1;
            if (cashierMap.TryGetValue(userId, out var val))
                cashierMap[userId] = (val.count + 1, val.amount + amt);
            else
                cashierMap[userId] = (1, amt);
        }

        foreach (var t in opdTickets) AccumulateCashier(t.EnteredBy, t.Total);
        foreach (var m in emergencyMemos) AccumulateCashier(m.EnteredBy, m.Paid);
        foreach (var d in diagMemos) AccumulateCashier(d.EnteredBy, d.Paid);
        foreach (var o in otMemos) AccumulateCashier(o.EnteredBy, o.Total - o.Discount);
        foreach (var r in ipdReceipts) AccumulateCashier(r.EnteredBy, r.Amount);
        foreach (var p in pharmacyMemos) AccumulateCashier(p.EnteredBy, (p.Total ?? 0) - (p.Discount ?? 0));

        var userNames = await db.Users
            .AsNoTracking()
            .Select(x => new { x.Id, x.UserName })
            .ToDictionaryAsync(x => x.Id, x => x.UserName);

        cashierRows = cashierMap.Select(kv =>
        {
            var uName = userNames.TryGetValue(kv.Key, out var n) && !string.IsNullOrWhiteSpace(n)
                ? n
                : $"Cashier #{kv.Key}";
            return new CashierRow(kv.Key, uName, kv.Value.count, kv.Value.amount);
        }).OrderByDescending(x => x.Amount).ToList();

        // Refunds Log Rows
        refundLogRows = [];
        foreach (var dr in diagReturns)
            refundLogRows.Add(new RefundLogRow(dr.TransDate, "Diagnostic Return", $"Return #{dr.ID} (Memo #{dr.MemoID})", dr.Reason, dr.RefundAmount));
        foreach (var pr in pharmReturns)
            refundLogRows.Add(new RefundLogRow(pr.TransDate, "Pharmacy Return", $"Return #{pr.ID} (Memo #{pr.CashMemoID})", pr.Reason, pr.RefundAmount));
        foreach (var rev in reversals)
            refundLogRows.Add(new RefundLogRow(rev.ReversedAt, rev.EntityType, $"Reversal #{rev.ID} ({rev.EntityType} #{rev.EntityID})", rev.Reason, rev.Amount));

        refundLogRows = refundLogRows.OrderByDescending(x => x.Date).Take(100).ToList();
    }

    private async Task PrintReportFormatAsync(string format)
    {
        var elementId = format switch
        {
            "A5" => "financial-report-print-a5",
            "80mm" => "financial-report-print-80mm",
            _ => "financial-report-print"
        };
        await JS.InvokeVoidAsync("hpm.printElement", elementId, $"Hospital Financial Report ({format}) - {fromDate:yyyy-MM-dd} to {toDate:yyyy-MM-dd}");
    }

    public void Dispose()
    {
        I18n.OnLanguageChanged -= HandleLanguageChanged;
    }

}
