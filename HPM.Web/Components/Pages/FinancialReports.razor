@page "/reports/financial"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.Accountant)]
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@implements IDisposable
@using HPM.Web.Components.Common
@using HPM.Web.Data
@using HPM.Web.Data.Entities
@using Microsoft.EntityFrameworkCore

<PageTitle>@I18n.T("Financial Reports & Revenue Analytics") | @Branding.HospitalName</PageTitle>

<style>
.fin-rep-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 12px 18px 48px;
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    color: #1e293b;
}

/* 1. Header */
.rep-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    flex-wrap: wrap;
    gap: 12px;
}
.rep-nav-links {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11.5px;
    font-weight: 600;
}
.rep-nav-link {
    color: #0369a1;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 6px;
    border-radius: 4px;
    transition: background 0.15s;
}
.rep-nav-link:hover {
    background: #e0f2fe;
}
.rep-title-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 2px;
}
.rep-title {
    font-size: 20px;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
}
.rep-sub {
    font-size: 11.5px;
    color: #64748b;
    margin: 2px 0 0;
}

/* Filter Card */
.rep-filter-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 12px 16px;
    margin-bottom: 14px;
    box-shadow: 0 1px 3px rgba(15,23,42,0.04);
}
.rep-presets-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 10px;
    flex-wrap: wrap;
}
.preset-btn {
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 700;
    border: 1px solid #cbd5e1;
    background: #f8fafc;
    color: #475569;
    border-radius: 5px;
    cursor: pointer;
    transition: all 0.12s;
}
.preset-btn:hover {
    background: #e2e8f0;
    color: #0f172a;
}
.preset-btn.active {
    background: #0284c7;
    border-color: #0284c7;
    color: #ffffff;
}

.rep-filter-inputs {
    display: flex;
    align-items: flex-end;
    gap: 12px;
    flex-wrap: wrap;
}
.rep-filter-group {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 140px;
}
.rep-filter-label {
    font-size: 11px;
    font-weight: 700;
    color: #475569;
}

/* KPI Banner */
.rep-kpi-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 10px;
    margin-bottom: 16px;
}
@@media (max-width: 1100px) {
    .rep-kpi-grid {
        grid-template-columns: repeat(3, 1fr);
    }
}
@@media (max-width: 640px) {
    .rep-kpi-grid {
        grid-template-columns: 1fr;
    }
}
.rep-kpi-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 10px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 1px 3px rgba(15,23,42,0.04);
}
.rep-kpi-label {
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    color: #64748b;
    margin-bottom: 2px;
}
.rep-kpi-val {
    font-size: 18px;
    font-weight: 900;
    line-height: 1.15;
}
.rep-kpi-sub {
    font-size: 10.5px;
    color: #94a3b8;
    margin-top: 2px;
}

/* Table Card */
.rep-content-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(15,23,42,0.06);
    margin-bottom: 16px;
}
.rep-card-header {
    padding: 10px 16px;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
}
.rep-card-title {
    font-size: 13.5px;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 6px;
}
.rep-table-wrap {
    overflow-x: auto;
    width: 100%;
}
.rep-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
}
.rep-table th {
    background: #f1f5f9;
    color: #475569;
    font-weight: 800;
    text-align: left;
    padding: 8px 12px;
    border-bottom: 2px solid #cbd5e1;
    white-space: nowrap;
}
.rep-table th.num, .rep-table td.num {
    text-align: right;
}
.rep-table td {
    padding: 8px 12px;
    border-bottom: 1px solid #e2e8f0;
    vertical-align: middle;
}
.rep-table tr:hover td {
    background: #f8fafc;
}
.rep-table tr.total-row td {
    background: #f1f5f9;
    font-weight: 900;
    border-top: 2px solid #cbd5e1;
    border-bottom: none;
    color: #0f172a;
}
.rep-table tr.deduct-row td {
    background: #fff5f5;
    color: #991b1b;
}

/* Tab Navigation */
.rep-tabs {
    display: flex;
    gap: 4px;
    margin-bottom: 12px;
    border-bottom: 2px solid #e2e8f0;
    padding-bottom: 2px;
}
.rep-tab-btn {
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 700;
    color: #64748b;
    background: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    cursor: pointer;
    transition: all 0.12s;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}
.rep-tab-btn:hover {
    color: #0284c7;
}
.rep-tab-btn.active {
    color: #0284c7;
    border-bottom-color: #0284c7;
    background: #f0f9ff;
    border-radius: 4px 4px 0 0;
}

/* Print Sheet */
@@media print {
    body * {
        visibility: hidden;
    }
    #financial-report-print, #financial-report-print * {
        visibility: visible;
    }
    #financial-report-print {
        display: block !important;
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        margin: 0;
        padding: 12mm 16mm;
        box-sizing: border-box;
    }
}
</style>

<div class="fin-rep-container">
    <div class="hpm-tb">
        <h1>@I18n.T("Financial Reports", "আর্থিক রিপোর্ট")</h1>
        <div class="hpm-tb-right">
            <div class="hpm-tb-seg">
                <button type="button" class="@(currentPreset == "today" ? "on" : "")" @onclick="SetToday">@I18n.T("Today", "আজ")</button>
                <button type="button" class="@(currentPreset == "yesterday" ? "on" : "")" @onclick="SetYesterday">@I18n.T("Yesterday", "গতকাল")</button>
                <button type="button" class="@(currentPreset == "7days" ? "on" : "")" @onclick="SetLast7Days">@I18n.T("7 Days", "৭ দিন")</button>
                <button type="button" class="@(currentPreset == "month" ? "on" : "")" @onclick="SetThisMonth">@I18n.T("This Month", "চলতি মাস")</button>
                <button type="button" class="@(currentPreset == "year" ? "on" : "")" @onclick="SetThisYear">@I18n.T("This Year", "চলতি বছর")</button>
            </div>
            <div class="hpm-tb-range">
                <input type="date" value="@fromDate.ToString("yyyy-MM-dd")" @onchange="OnFromDateChanged" />
                <span>→</span>
                <input type="date" value="@toDate.ToString("yyyy-MM-dd")" @onchange="OnToDateChanged" />
            </div>
            <button type="button" class="hpm-tb-btn primary" @onclick="LoadAsync">@I18n.T("Apply", "লোড করুন")</button>
            <button type="button" class="hpm-tb-btn" @onclick='() => PrintReportFormatAsync("A4")'>@I18n.T("Print", "প্রিন্ট")</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert danger" style="padding: 7px 14px; font-size: 12px; font-weight: 600; margin-bottom: 12px; border-radius: 6px;">
            @message
        </div>
    }

    <!-- 3. Executive Financial KPI Cards -->
    <div class="rep-kpi-grid">
        <div class="rep-kpi-card" style="border-left: 4px solid #0284c7;">
            <div>
                <div class="rep-kpi-label">@I18n.T("Gross", "মোট বিল")</div>
                <div class="rep-kpi-val" style="color: #0369a1;">৳ @grandGross.ToString("N0")</div>
            </div>
        </div>

        <div class="rep-kpi-card" style="border-left: 4px solid #f59e0b;">
            <div>
                <div class="rep-kpi-label">@I18n.T("Discount", "ছাড়")</div>
                <div class="rep-kpi-val" style="color: #b45309;">৳ @grandDiscount.ToString("N0")</div>
            </div>
        </div>

        <div class="rep-kpi-card" style="border-left: 4px solid #8b5cf6;">
            <div>
                <div class="rep-kpi-label">@I18n.T("Net Revenue", "নিট আয়")</div>
                <div class="rep-kpi-val" style="color: #6d28d9;">৳ @grandNet.ToString("N0")</div>
            </div>
        </div>

        <div class="rep-kpi-card" style="border-left: 4px solid #10b981;">
            <div>
                <div class="rep-kpi-label">@I18n.T("Collected", "আদায়")</div>
                <div class="rep-kpi-val" style="color: #047857;">৳ @grandPaid.ToString("N0")</div>
            </div>
        </div>

        <div class="rep-kpi-card" style="border-left: 4px solid #ef4444;">
            <div>
                <div class="rep-kpi-label">@I18n.T("Due", "বকেয়া")</div>
                <div class="rep-kpi-val" style="color: #dc2626;">৳ @grandDue.ToString("N0")</div>
            </div>
        </div>
    </div>

    <!-- 4. Interactive Tabs & Search -->
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
        <div class="rep-tabs">
            <button type="button" class="rep-tab-btn @(activeTab == "summary" ? "active" : "")" @onclick='() => activeTab = "summary"'>
                <span>@I18n.T("By Department", "বিভাগভিত্তিক")</span>
            </button>
            <button type="button" class="rep-tab-btn @(activeTab == "cashier" ? "active" : "")" @onclick='() => activeTab = "cashier"'>
                <span>@I18n.T("By Cashier", "ক্যাশিয়ারভিত্তিক")</span>
            </button>
            <button type="button" class="rep-tab-btn @(activeTab == "refunds" ? "active" : "")" @onclick='() => activeTab = "refunds"'>
                <span>@I18n.T("Refunds", "রিফান্ড")</span>
            </button>
        </div>

        <div style="position: relative; width: 260px;">
            <span style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); font-size: 12px; color: #94a3b8;">🔍</span>
            <input type="text" class="classic-input" style="padding-left: 30px !important; height: 32px !important; font-size: 12px !important; width: 100%;" placeholder="@I18n.T("Search...", "খুঁজুন...")" @bind="searchQuery" @bind:event="oninput" />
        </div>
    </div>

    @if (activeTab == "summary")
    {
        <!-- Departmental Revenue Stream Summary -->
        <div class="rep-content-card">
            <div class="rep-card-header">
                <h3 class="rep-card-title">
                    <span>@I18n.T("Revenue by Department", "বিভাগভিত্তিক আয়")</span>
                </h3>
                <span class="pill" style="font-size: 11px; background: #e0f2fe; color: #0369a1; font-weight: 700;">
                    @I18n.T("Total Modules"): @departmentRows.Count
                </span>
            </div>

            <div class="rep-table-wrap">
                <table class="rep-table">
                    <thead>
                        <tr>
                            <th style="width: 40px;">#SL</th>
                            <th>@I18n.T("Department", "বিভাগ")</th>
                            <th class="num" style="width: 100px;">@I18n.T("Transactions", "রিসিট সংখ্যা")</th>
                            <th class="num" style="width: 130px;">@I18n.T("Gross Bill (৳)", "গ্রস বিল")</th>
                            <th class="num" style="width: 120px;">@I18n.T("Discount (৳)", "ছাড়")</th>
                            <th class="num" style="width: 130px;">@I18n.T("Net Revenue (৳)", "প্রকৃত আয়")</th>
                            <th class="num" style="width: 130px;">@I18n.T("Collected (৳)", "আদায়")</th>
                            <th class="num" style="width: 120px;">@I18n.T("Due (৳)", "বকেয়া")</th>
                            <th class="num" style="width: 80px;">@I18n.T("Share", "অংশ")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var sl = 1; }
                        @foreach (var row in FilteredDepartmentRows)
                        {
                            <tr>
                                <td style="font-weight: 700; color: #64748b;">@(sl++)</td>
                                <td>
                                    <strong style="color: #0f172a;">@row.Name</strong>
                                </td>
                                <td class="num" style="font-weight: 600;">@row.Count.ToString("N0")</td>
                                <td class="num" style="font-weight: 700; color: #334155;">৳ @row.Gross.ToString("N0")</td>
                                <td class="num" style="color: #b45309; font-weight: 600;">@(row.Discount > 0 ? $"৳ {row.Discount:N0}" : "—")</td>
                                <td class="num" style="font-weight: 800; color: #0f172a;">৳ @row.Net.ToString("N0")</td>
                                <td class="num" style="font-weight: 800; color: #047857;">৳ @row.Paid.ToString("N0")</td>
                                <td class="num" style="font-weight: 700; color: @(row.Due > 0 ? "#dc2626" : "#64748b");">
                                    @(row.Due > 0 ? $"৳ {row.Due:N0}" : "—")
                                </td>
                                <td class="num" style="font-size: 11px; font-weight: 700; color: #0284c7;">
                                    @(grandGross > 0 ? (row.Gross / grandGross * 100).ToString("F1") : "0")%
                                </td>
                            </tr>
                        }

                        @if (totalRefunds > 0)
                        {
                            <tr class="deduct-row">
                                <td style="font-weight: 700;">—</td>
                                <td>
                                    <strong>@I18n.T("Less: Refunds & Reversals", "বাদ: রিফান্ড ও রিভার্সাল")</strong>
                                </td>
                                <td class="num">@refundsCount</td>
                                <td class="num">—</td>
                                <td class="num">—</td>
                                <td class="num" style="font-weight: 800;">- ৳ @totalRefunds.ToString("N0")</td>
                                <td class="num" style="font-weight: 800;">- ৳ @totalRefunds.ToString("N0")</td>
                                <td class="num">—</td>
                                <td class="num">—</td>
                            </tr>
                        }

                        <tr class="total-row">
                            <td colspan="2" style="text-align: right; text-transform: uppercase;">
                                @I18n.T("Net Total", "সর্বমোট"):
                            </td>
                            <td class="num">@totalTransactionsCount</td>
                            <td class="num">৳ @grandGross.ToString("N0")</td>
                            <td class="num" style="color: #b45309;">৳ @grandDiscount.ToString("N0")</td>
                            <td class="num" style="color: #0369a1;">৳ @(grandNet - totalRefunds).ToString("N0")</td>
                            <td class="num" style="color: #047857;">৳ @(grandPaid - totalRefunds).ToString("N0")</td>
                            <td class="num" style="color: #dc2626;">৳ @grandDue.ToString("N0")</td>
                            <td class="num">100%</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (activeTab == "cashier")
    {
        <!-- Cashier & Staff Collection Breakdown -->
        <div class="rep-content-card">
            <div class="rep-card-header">
                <h3 class="rep-card-title">
                    <span>@I18n.T("Collection by Cashier", "ক্যাশিয়ারভিত্তিক আদায়")</span>
                </h3>
            </div>
            <div class="rep-table-wrap">
                <table class="rep-table">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#ID</th>
                            <th>@I18n.T("Cashier", "ক্যাশিয়ার")</th>
                            <th class="num" style="width: 140px;">@I18n.T("Transactions", "রিসিট সংখ্যা")</th>
                            <th class="num" style="width: 160px;">@I18n.T("Collected (৳)", "আদায়")</th>
                            <th class="num" style="width: 140px;">@I18n.T("Share", "অংশ")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!FilteredCashierRows.Any())
                        {
                            <tr>
                                <td colspan="5" style="text-align: center; padding: 24px; color: #64748b;">
                                    @I18n.T("No cashier collection records in this period.")
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var c in FilteredCashierRows)
                            {
                                <tr>
                                    <td style="font-weight: 700; color: #64748b;">#@c.UserId</td>
                                    <td>
                                        <b style="color: #0f172a;">@c.UserName</b>
                                    </td>
                                    <td class="num" style="font-weight: 700;">@c.Count</td>
                                    <td class="num" style="font-weight: 800; color: #047857;">৳ @c.Amount.ToString("N0")</td>
                                    <td class="num" style="font-weight: 700; color: #0284c7;">
                                        @(grandPaid > 0 ? (c.Amount / grandPaid * 100).ToString("F1") : "0")%
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (activeTab == "refunds")
    {
        <!-- Refunds & Reversals Audit -->
        <div class="rep-content-card">
            <div class="rep-card-header">
                <h3 class="rep-card-title">
                    <span>@I18n.T("Returns & Reversals", "রিটার্ন ও রিভার্সাল")</span>
                </h3>
                <span class="pill pill-danger" style="font-size: 11px; padding: 3px 8px;">
                    @I18n.T("Total Deductions"): ৳ @totalRefunds.ToString("N0")
                </span>
            </div>
            <div class="rep-table-wrap">
                <table class="rep-table">
                    <thead>
                        <tr>
                            <th style="width: 130px;">@I18n.T("Date & Time", "তারিখ ও সময়")</th>
                            <th style="width: 120px;">@I18n.T("Type", "ধরন")</th>
                            <th>@I18n.T("Reference / Reason", "রেফারেন্স ও কারণ")</th>
                            <th class="num" style="width: 130px;">@I18n.T("Refund Amount (৳)", "রিফান্ড টাকা")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!FilteredRefundRows.Any())
                        {
                            <tr>
                                <td colspan="4" style="text-align: center; padding: 24px; color: #64748b;">
                                    @I18n.T("No refunds or cancellations logged in this period.")
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var r in FilteredRefundRows)
                            {
                                <tr>
                                    <td style="font-size: 11.5px; color: #475569;">@r.Date.ToString("dd MMM yyyy hh:mm tt")</td>
                                    <td>
                                        <span class="pill" style="font-size: 10px; background: #fee2e2; color: #b91c1c; font-weight: 700;">
                                            @r.Category
                                        </span>
                                    </td>
                                    <td>
                                        <b style="color: #0f172a;">@r.Reference</b>
                                        <small style="display: block; color: #64748b;">@r.Reason</small>
                                    </td>
                                    <td class="num" style="font-weight: 800; color: #dc2626;">
                                        - ৳ @r.Amount.ToString("N0")
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- =========================================================================
     5. Printable A4 Financial Statement Sheet
     ========================================================================= -->
<div id="financial-report-print" style="display: none;">
    <PrintDocumentHeader Title="@I18n.T("HOSPITAL REVENUE & FINANCIAL COLLECTION STATEMENT", "হাসপাতাল রাজস্ব ও অর্থ আদায় স্টেটমেন্ট")"
                         Subtitle="@($"{fromDate:dd MMM yyyy} - {toDate:dd MMM yyyy}")"
                         DocNo="@($"FIN-{fromDate:yyyyMMdd}-{toDate:yyyyMMdd}")" />

    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin: 14px 0;">
        <div style="border: 1px solid #cbd5e1; padding: 8px; border-radius: 4px; text-align: center;">
            <div style="font-size: 10px; font-weight: 800; color: #64748b;">GROSS BILLING</div>
            <div style="font-size: 16px; font-weight: 900; color: #0f172a;">৳ @grandGross.ToString("N0")</div>
        </div>
        <div style="border: 1px solid #cbd5e1; padding: 8px; border-radius: 4px; text-align: center;">
            <div style="font-size: 10px; font-weight: 800; color: #64748b;">DISCOUNTS</div>
            <div style="font-size: 16px; font-weight: 900; color: #b45309;">৳ @grandDiscount.ToString("N0")</div>
        </div>
        <div style="border: 1px solid #cbd5e1; padding: 8px; border-radius: 4px; text-align: center;">
            <div style="font-size: 10px; font-weight: 800; color: #64748b;">COLLECTED CASH</div>
            <div style="font-size: 16px; font-weight: 900; color: #047857;">৳ @(grandPaid - totalRefunds).ToString("N0")</div>
        </div>
        <div style="border: 1px solid #cbd5e1; padding: 8px; border-radius: 4px; text-align: center;">
            <div style="font-size: 10px; font-weight: 800; color: #64748b;">TOTAL DUE</div>
            <div style="font-size: 16px; font-weight: 900; color: #dc2626;">৳ @grandDue.ToString("N0")</div>
        </div>
    </div>

    <table style="width: 100%; border-collapse: collapse; font-size: 11px; margin-top: 10px;" border="1" cellpadding="6">
        <thead>
            <tr style="background: #f1f5f9;">
                <th>#</th>
                <th>Revenue Stream / Department</th>
                <th style="text-align: right;">Transactions</th>
                <th style="text-align: right;">Gross (৳)</th>
                <th style="text-align: right;">Discount (৳)</th>
                <th style="text-align: right;">Net Revenue (৳)</th>
                <th style="text-align: right;">Collected (৳)</th>
                <th style="text-align: right;">Due (৳)</th>
            </tr>
        </thead>
        <tbody>
            @{ var printSl = 1; }
            @foreach (var row in departmentRows)
            {
                <tr>
                    <td>@(printSl++)</td>
                    <td><b>@row.Name</b></td>
                    <td style="text-align: right;">@row.Count.ToString("N0")</td>
                    <td style="text-align: right;">@row.Gross.ToString("N0")</td>
                    <td style="text-align: right;">@row.Discount.ToString("N0")</td>
                    <td style="text-align: right;">@row.Net.ToString("N0")</td>
                    <td style="text-align: right;">@row.Paid.ToString("N0")</td>
                    <td style="text-align: right;">@row.Due.ToString("N0")</td>
                </tr>
            }
            @if (totalRefunds > 0)
            {
                <tr style="background: #fff5f5; color: #991b1b;">
                    <td>—</td>
                    <td><b>Less: Approved Refunds & Reversals</b></td>
                    <td style="text-align: right;">@refundsCount</td>
                    <td style="text-align: right;">—</td>
                    <td style="text-align: right;">—</td>
                    <td style="text-align: right;">- @totalRefunds.ToString("N0")</td>
                    <td style="text-align: right;">- @totalRefunds.ToString("N0")</td>
                    <td style="text-align: right;">—</td>
                </tr>
            }
            <tr style="background: #f1f5f9; font-weight: 900;">
                <td colspan="2" style="text-align: right;">NET HOSPITAL TOTAL:</td>
                <td style="text-align: right;">@totalTransactionsCount</td>
                <td style="text-align: right;">৳ @grandGross.ToString("N0")</td>
                <td style="text-align: right;">৳ @grandDiscount.ToString("N0")</td>
                <td style="text-align: right;">৳ @(grandNet - totalRefunds).ToString("N0")</td>
                <td style="text-align: right;">৳ @(grandPaid - totalRefunds).ToString("N0")</td>
                <td style="text-align: right;">৳ @grandDue.ToString("N0")</td>
            </tr>
        </tbody>
    </table>

    <div style="display: flex; justify-content: space-between; margin-top: 48px; font-size: 11px;">
        <div style="border-top: 1px solid #94a3b8; width: 140px; text-align: center; padding-top: 4px;">Prepared By: <strong>@currentUserName</strong></div>
        <div style="border-top: 1px solid #94a3b8; width: 140px; text-align: center; padding-top: 4px;">Accounts Officer</div>
        <div style="border-top: 1px solid #94a3b8; width: 140px; text-align: center; padding-top: 4px;">Audited By</div>
        <div style="border-top: 1px solid #94a3b8; width: 140px; text-align: center; padding-top: 4px;">Managing Director</div>
    </div>
</div>

@code {
    private DateTime fromDate = DateTime.Today;
    private DateTime toDate = DateTime.Today;
    private string currentPreset = "today";
    private string activeTab = "summary";
    private string message = "";
    private string searchQuery = "";

    // Aggregated KPI Totals
    private decimal grandGross;
    private decimal grandDiscount;
    private decimal grandNet;
    private decimal grandPaid;
    private decimal grandDue;
    private int totalTransactionsCount;

    private decimal totalRefunds;
    private int refundsCount;

    // Structured Reporting Models
    private sealed record DeptRevenueRow(string Icon, string Name, int Count, decimal Gross, decimal Discount, decimal Net, decimal Paid, decimal Due);
    private List<DeptRevenueRow> departmentRows = [];

    private sealed record CashierRow(int UserId, string UserName, int Count, decimal Amount);
    private List<CashierRow> cashierRows = [];

    private sealed record RefundLogRow(DateTime Date, string Category, string Reference, string Reason, decimal Amount);
    private List<RefundLogRow> refundLogRows = [];

    private IEnumerable<DeptRevenueRow> FilteredDepartmentRows =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? departmentRows
            : departmentRows.Where(x => x.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<CashierRow> FilteredCashierRows =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? cashierRows
            : cashierRows.Where(x => x.UserName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) || x.UserId.ToString().Contains(searchQuery));

    private IEnumerable<RefundLogRow> FilteredRefundRows =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? refundLogRows
            : refundLogRows.Where(x => x.Category.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
                                    || x.Reference.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
                                    || (x.Reason ?? "").Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

    private string currentUserName = "User";

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = int.TryParse(auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var uid) ? uid : 0;
        await using var db = await DbFactory.CreateDbContextAsync();
        var dbUser = userId > 0 ? await db.Users.AsNoTracking().FirstOrDefaultAsync(x => x.Id == userId) : null;
        currentUserName = dbUser?.GetEffectiveName() ?? HPM.Web.Security.AppUser.GetEffectiveName(auth.User, "User");
        await LoadAsync();
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    private void SetToday()
    {
        currentPreset = "today";
        fromDate = DateTime.Today;
        toDate = DateTime.Today;
        _ = LoadAsync();
    }

    private void SetYesterday()
    {
        currentPreset = "yesterday";
        fromDate = DateTime.Today.AddDays(-1);
        toDate = DateTime.Today.AddDays(-1);
        _ = LoadAsync();
    }

    private void SetLast7Days()
    {
        currentPreset = "7days";
        fromDate = DateTime.Today.AddDays(-6);
        toDate = DateTime.Today;
        _ = LoadAsync();
    }

    private void SetThisMonth()
    {
        currentPreset = "month";
        fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        toDate = DateTime.Today;
        _ = LoadAsync();
    }

    private void SetThisYear()
    {
        currentPreset = "year";
        fromDate = new DateTime(DateTime.Today.Year, 1, 1);
        toDate = DateTime.Today;
        _ = LoadAsync();
    }

    private void OnFromDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            fromDate = dt;
            currentPreset = "custom";
        }
    }

    private void OnToDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            toDate = dt;
            currentPreset = "custom";
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            await LoadCoreAsync();
        }
        catch (Exception)
        {
            message = I18n.T("Could not load report, please try again.", "রিপোর্ট লোড করা যায়নি, আবার চেষ্টা করুন।");
        }
    }

    private async Task LoadCoreAsync()
    {
        if (toDate.Date < fromDate.Date)
        {
            message = I18n.IsBangla ? "শেষের তারিখ শুরুর তারিখের আগের হতে পারে না।" : "To date cannot be earlier than From date.";
            return;
        }

        message = "";
        var start = fromDate.Date;
        var end = toDate.Date.AddDays(1);

        await using var db = await DbFactory.CreateDbContextAsync();
        db.Database.SetCommandTimeout(120);

        // 1. OPD Tickets
        var opdTickets = await db.OPDTickets.AsNoTracking()
            .Where(x => x.TransDate >= start && x.TransDate < end)
            .ToListAsync();

        // 2. Emergency Memos (ModuleID == 11)
        var emergencyMemos = await db.EmergencyMemos.AsNoTracking()
            .Where(x => x.TransDate >= start && x.TransDate < end && x.ModuleID == 11)
            .ToListAsync();

        // 3. Diagnostic & Lab Memos (ModuleID != 11)
        var diagMemos = await db.EmergencyMemos.AsNoTracking()
            .Where(x => x.TransDate >= start && x.TransDate < end && x.ModuleID != 11)
            .ToListAsync();

        // 4. OT Cash Memos
        var otMemos = await db.OTCashMemos.AsNoTracking()
            .Where(x => x.TransDate >= start && x.TransDate < end)
            .ToListAsync();

        // 5. IPD Advance Receipts
        var ipdReceipts = await db.IpdMoneyReceipts.AsNoTracking()
            .Where(x => x.TransDate >= start && x.TransDate < end)
            .ToListAsync();

        // 6. IPD Final Settlement Bills
        var ipdBills = await db.IpdFinalBills.AsNoTracking()
            .Where(x => x.DischargeDate >= start && x.DischargeDate < end)
            .ToListAsync();

        // 7. Pharmacy Sales Memos
        var pharmacyMemos = await db.PharmacyCashMemos.AsNoTracking()
            .Where(x => x.TransDate >= start && x.TransDate < end)
            .ToListAsync();

        // 7b. Canteen sales and blood bag charges
        var canteenSales = await db.CanteenSales.AsNoTracking()
            .Where(x => x.TransDate >= start && x.TransDate < end)
            .ToListAsync();
        var bloodIssues = await db.BloodIssues.AsNoTracking()
            .Where(x => x.IssuedAt >= start && x.IssuedAt < end && x.ChargeAmount > 0)
            .ToListAsync();
        static decimal CanteenNet(CanteenSale x) => Math.Max(0, (x.Total ?? 0) - (x.Discount ?? 0));

        // 8. Returns & Reversals
        var diagReturns = await db.DiagnosticCashMemoReturns.AsNoTracking()
            .Where(x => x.TransDate >= start && x.TransDate < end && x.Status == "Posted")
            .ToListAsync();

        var pharmReturns = await db.PharmacySalesReturns.AsNoTracking()
            .Where(x => x.TransDate >= start && x.TransDate < end && x.IsPosted)
            .ToListAsync();

        var reversals = await db.FinancialReversals.AsNoTracking()
            .Where(x => x.ReversedAt >= start && x.ReversedAt < end)
            .ToListAsync();

        // Departmental Breakdown Rows
        departmentRows =
        [
            new("🎫", I18n.T("OPD Consultation Tickets", "ওপিডি কনসালটেশন টিকিট"),
                opdTickets.Count,
                opdTickets.Sum(x => x.Total),
                0,
                opdTickets.Sum(x => x.Total),
                opdTickets.Sum(x => x.Total),
                0),

            new("🚨", I18n.T("Emergency Services", "জরুরি সেবা"),
                emergencyMemos.Count,
                emergencyMemos.Sum(x => x.Total),
                emergencyMemos.Sum(x => x.Discount),
                emergencyMemos.Sum(x => x.Total - x.Discount),
                emergencyMemos.Sum(x => x.Paid),
                emergencyMemos.Sum(x => Math.Max(0, (x.Total - x.Discount) - x.Paid))),

            new("🔬", I18n.T("Diagnostic & Pathology", "প্যাথলজি ও ডায়াগনস্টিক"),
                diagMemos.Count,
                diagMemos.Sum(x => x.Total),
                diagMemos.Sum(x => x.Discount),
                diagMemos.Sum(x => x.Total - x.Discount),
                diagMemos.Sum(x => x.Paid),
                diagMemos.Sum(x => Math.Max(0, (x.Total - x.Discount) - x.Paid))),

            new("🔪", I18n.T("Operation Theater (OT)", "অপারেশন থিয়েটার (ওটি)"),
                otMemos.Count,
                otMemos.Sum(x => x.Total),
                otMemos.Sum(x => x.Discount),
                otMemos.Sum(x => x.Total - x.Discount),
                otMemos.Sum(x => x.Total - x.Discount),
                0),

            new("💰", I18n.T("IPD Inpatient Advance Receipts", "আইপিডি ভর্তি রোগীর অগ্রিম জমা"),
                ipdReceipts.Count,
                ipdReceipts.Sum(x => x.Amount),
                0,
                ipdReceipts.Sum(x => x.Amount),
                ipdReceipts.Sum(x => x.Amount),
                0),

            new("🧾", I18n.T("IPD Final Discharge Bills", "আইপিডি চূড়ান্ত ডিসচার্জ বিল"),
                ipdBills.Count,
                ipdBills.Sum(x => x.GrossAmount),
                ipdBills.Sum(x => x.DiscountAmount),
                ipdBills.Sum(x => x.NetAmount),
                ipdBills.Sum(x => x.ReceiptAmount),
                ipdBills.Sum(x => x.BalanceDue)),

            new("💊", I18n.T("Pharmacy Medicine Sales", "ফার্মেসি ওষুধ বিক্রয়"),
                pharmacyMemos.Count,
                pharmacyMemos.Sum(x => x.Total ?? 0),
                pharmacyMemos.Sum(x => x.Discount ?? 0),
                pharmacyMemos.Sum(x => (x.Total ?? 0) - (x.Discount ?? 0)),
                pharmacyMemos.Sum(x => (x.Total ?? 0) - (x.Discount ?? 0)),
                0),

            new("🍽️", I18n.T("Canteen Sales", "ক্যান্টিন বিক্রয়"),
                canteenSales.Count,
                canteenSales.Sum(x => x.Total ?? 0),
                canteenSales.Sum(x => x.Discount ?? 0),
                canteenSales.Sum(CanteenNet),
                canteenSales.Where(x => x.CustomerType != "Credit").Sum(CanteenNet),
                canteenSales.Where(x => x.CustomerType == "Credit").Sum(CanteenNet)),

            new("🩸", I18n.T("Blood Bank (blood bags)", "ব্লাড ব্যাংক (রক্তের ব্যাগ)"),
                bloodIssues.Count,
                bloodIssues.Sum(x => x.ChargeAmount),
                0,
                bloodIssues.Sum(x => x.ChargeAmount),
                bloodIssues.Sum(x => x.ChargeAmount),
                0)
        ];

        // Overall Totals
        grandGross = departmentRows.Sum(x => x.Gross);
        grandDiscount = departmentRows.Sum(x => x.Discount);
        grandNet = departmentRows.Sum(x => x.Net);
        grandPaid = departmentRows.Sum(x => x.Paid);
        grandDue = departmentRows.Sum(x => x.Due);
        totalTransactionsCount = departmentRows.Sum(x => x.Count);

        totalRefunds = diagReturns.Sum(x => x.RefundAmount) + pharmReturns.Sum(x => x.RefundAmount) + reversals.Sum(x => x.Amount);
        refundsCount = diagReturns.Count + pharmReturns.Count + reversals.Count;

        // Cashier Summary
        var cashierMap = new Dictionary<int, (int count, decimal amount)>();

        void AccumulateCashier(int userId, decimal amt)
        {
            if (userId <= 0) userId = 1;
            if (cashierMap.TryGetValue(userId, out var val))
                cashierMap[userId] = (val.count + 1, val.amount + amt);
            else
                cashierMap[userId] = (1, amt);
        }

        foreach (var t in opdTickets) AccumulateCashier(t.EnteredBy, t.Total);
        foreach (var m in emergencyMemos) AccumulateCashier(m.EnteredBy, m.Paid);
        foreach (var d in diagMemos) AccumulateCashier(d.EnteredBy, d.Paid);
        foreach (var o in otMemos) AccumulateCashier(o.EnteredBy, o.Total - o.Discount);
        foreach (var r in ipdReceipts) AccumulateCashier(r.EnteredBy, r.Amount);
        foreach (var c in canteenSales.Where(x => x.CustomerType != "Credit")) AccumulateCashier(c.EnteredBy, CanteenNet(c));
        foreach (var b in bloodIssues) AccumulateCashier(b.IssuedBy, b.ChargeAmount);
        foreach (var p in pharmacyMemos) AccumulateCashier(p.EnteredBy, (p.Total ?? 0) - (p.Discount ?? 0));

        var userNames = await db.Users
            .AsNoTracking()
            .Select(x => new { x.Id, x.UserName })
            .ToDictionaryAsync(x => x.Id, x => x.UserName);

        cashierRows = cashierMap.Select(kv =>
        {
            var uName = userNames.TryGetValue(kv.Key, out var n) && !string.IsNullOrWhiteSpace(n)
                ? n
                : $"Cashier #{kv.Key}";
            return new CashierRow(kv.Key, uName, kv.Value.count, kv.Value.amount);
        }).OrderByDescending(x => x.Amount).ToList();

        // Refunds Log Rows
        refundLogRows = [];
        foreach (var dr in diagReturns)
            refundLogRows.Add(new RefundLogRow(dr.TransDate, "Diagnostic Return", $"Return #{dr.ID} (Memo #{dr.MemoID})", dr.Reason, dr.RefundAmount));
        foreach (var pr in pharmReturns)
            refundLogRows.Add(new RefundLogRow(pr.TransDate, "Pharmacy Return", $"Return #{pr.ID} (Memo #{pr.CashMemoID})", pr.Reason, pr.RefundAmount));
        foreach (var rev in reversals)
            refundLogRows.Add(new RefundLogRow(rev.ReversedAt, rev.EntityType, $"Reversal #{rev.ID} ({rev.EntityType} #{rev.EntityID})", rev.Reason, rev.Amount));

        refundLogRows = refundLogRows.OrderByDescending(x => x.Date).Take(100).ToList();
    }

    private async Task PrintReportFormatAsync(string format)
    {
        await JS.InvokeVoidAsync("hpm.printElement", "financial-report-print", $"Hospital Financial Report - {fromDate:yyyy-MM-dd} to {toDate:yyyy-MM-dd}");
    }

    public void Dispose()
    {
        I18n.OnLanguageChanged -= HandleLanguageChanged;
    }

}
