@page "/reports/financial"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.Reception + "," + RoleNames.Cashier)]
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject IJSRuntime JS
@implements IDisposable
@using HPM.Web.Components.Common
@using HPM.Web.Data
@using HPM.Web.Data.Entities
@using Microsoft.EntityFrameworkCore

<PageTitle>@I18n.T("Financial Reports & Revenue Analytics") | @Branding.HospitalName</PageTitle>

<style>
.fin-rep-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 12px 18px 48px;
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    color: #1e293b;
}

/* 1. Header */
.rep-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    flex-wrap: wrap;
    gap: 12px;
}
.rep-nav-links {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11.5px;
    font-weight: 600;
}
.rep-nav-link {
    color: #0369a1;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 6px;
    border-radius: 4px;
    transition: background 0.15s;
}
.rep-nav-link:hover {
    background: #e0f2fe;
}
.rep-title-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 2px;
}
.rep-title {
    font-size: 20px;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
}
.rep-sub {
    font-size: 11.5px;
    color: #64748b;
    margin: 2px 0 0;
}

/* Filter Card */
.rep-filter-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 12px 16px;
    margin-bottom: 14px;
    box-shadow: 0 1px 3px rgba(15,23,42,0.04);
}
.rep-presets-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 10px;
    flex-wrap: wrap;
}
.preset-btn {
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 700;
    border: 1px solid #cbd5e1;
    background: #f8fafc;
    color: #475569;
    border-radius: 5px;
    cursor: pointer;
    transition: all 0.12s;
}
.preset-btn:hover {
    background: #e2e8f0;
    color: #0f172a;
}
.preset-btn.active {
    background: #0284c7;
    border-color: #0284c7;
    color: #ffffff;
}

.rep-filter-inputs {
    display: flex;
    align-items: flex-end;
    gap: 12px;
    flex-wrap: wrap;
}
.rep-filter-group {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 140px;
}
.rep-filter-label {
    font-size: 11px;
    font-weight: 700;
    color: #475569;
}

/* KPI Banner */
.rep-kpi-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 10px;
    margin-bottom: 16px;
}
@@media (max-width: 1100px) {
    .rep-kpi-grid {
        grid-template-columns: repeat(3, 1fr);
    }
}
@@media (max-width: 640px) {
    .rep-kpi-grid {
        grid-template-columns: 1fr;
    }
}
.rep-kpi-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 10px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 1px 3px rgba(15,23,42,0.04);
}
.rep-kpi-label {
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    color: #64748b;
    margin-bottom: 2px;
}
.rep-kpi-val {
    font-size: 18px;
    font-weight: 900;
    line-height: 1.15;
}
.rep-kpi-sub {
    font-size: 10.5px;
    color: #94a3b8;
    margin-top: 2px;
}

/* Table Card */
.rep-content-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(15,23,42,0.06);
    margin-bottom: 16px;
}
.rep-card-header {
    padding: 10px 16px;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
}
.rep-card-title {
    font-size: 13.5px;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 6px;
}
.rep-table-wrap {
    overflow-x: auto;
    width: 100%;
}
.rep-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
}
.rep-table th {
    background: #f1f5f9;
    color: #475569;
    font-weight: 800;
    text-align: left;
    padding: 8px 12px;
    border-bottom: 2px solid #cbd5e1;
    white-space: nowrap;
}
.rep-table th.num, .rep-table td.num {
    text-align: right;
}
.rep-table td {
    padding: 8px 12px;
    border-bottom: 1px solid #e2e8f0;
    vertical-align: middle;
}
.rep-table tr:hover td {
    background: #f8fafc;
}
.rep-table tr.total-row td {
    background: #f1f5f9;
    font-weight: 900;
    border-top: 2px solid #cbd5e1;
    border-bottom: none;
    color: #0f172a;
}
.rep-table tr.deduct-row td {
    background: #fff5f5;
    color: #991b1b;
}

/* Tab Navigation */
.rep-tabs {
    display: flex;
    gap: 4px;
    margin-bottom: 12px;
    border-bottom: 2px solid #e2e8f0;
    padding-bottom: 2px;
}
.rep-tab-btn {
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 700;
    color: #64748b;
    background: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    cursor: pointer;
    transition: all 0.12s;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}
.rep-tab-btn:hover {
    color: #0284c7;
}
.rep-tab-btn.active {
    color: #0284c7;
    border-bottom-color: #0284c7;
    background: #f0f9ff;
    border-radius: 4px 4px 0 0;
}

/* Print Sheet */
@@media print {
    body * {
        visibility: hidden;
    }
    #financial-report-print, #financial-report-print * {
        visibility: visible;
    }
    #financial-report-print {
        display: block !important;
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        margin: 0;
        padding: 12mm 16mm;
        box-sizing: border-box;
    }
}
</style>

<div class="fin-rep-container">
    <!-- 1. Top Header -->
    <div class="rep-header">
        <div>
            <div class="rep-nav-links">
                <a href="/reports" class="rep-nav-link">← @I18n.T("Reports Hub", "রিপোর্টস হাব")</a>
                <span>&bull;</span>
                <a href="/reports/mis" class="rep-nav-link">📊 @I18n.T("MIS Reports", "এমআইএস রিপোর্ট")</a>
                <span>&bull;</span>
                <a href="/accounts" class="rep-nav-link">💳 @I18n.T("Accounts & Ledger", "অ্যাকাউন্টস ও লেজার")</a>
            </div>
            <div class="rep-title-row">
                <h1 class="rep-title">
                    <span>💰</span>
                    <span>@I18n.T("Hospital Financial & Revenue Reports", "হাসপাতাল আয় ও অর্থ ব্যবস্থাপনা রিপোর্ট")</span>
                </h1>
                <span class="pill" style="font-size: 11px; background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; font-weight: 700;">
                    @fromDate.ToString("dd MMM yyyy") — @toDate.ToString("dd MMM yyyy")
                </span>
            </div>
            <p class="rep-sub">
                @I18n.T("Comprehensive collection, gross billings, discount audits, and net cash flows across all departments.", "সকল বিভাগ ও সার্ভিসের মোট আয়, ছাড়, আদায় এবং রিয়েল-টাইম ক্যাশ ফ্লো বিবরণী।")
            </p>
        </div>

        <div style="display: flex; gap: 6px; align-items: center; flex-wrap: wrap;">
            <a href="/accounts?view=report" class="btn btn-ghost" style="font-size: 11.5px; height: 32px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; border: 1px solid #cbd5e1;">
                📒 @I18n.T("General Ledger & Closing", "জেনারেল লেজার ও ক্লোজিং")
            </a>
            <button class="btn btn-secondary" style="font-size: 11.5px; height: 32px; font-weight: 700;" @onclick='() => PrintReportFormatAsync("A4")'>
                🖨️ @I18n.T("Print A4", "A4 প্রিন্ট")
            </button>
            <button class="btn btn-secondary" style="font-size: 11.5px; height: 32px; font-weight: 700;" @onclick='() => PrintReportFormatAsync("A5")'>
                📄 @I18n.T("Print A5", "A5 প্রিন্ট")
            </button>
            <button class="btn btn-secondary" style="font-size: 11.5px; height: 32px; font-weight: 700;" @onclick='() => PrintReportFormatAsync("80mm")'>
                🧾 @I18n.T("80mm Thermal", "৮০মিমি থার্মাল")
            </button>
            <button class="btn btn-ghost" style="font-size: 12px; height: 32px;" @onclick="LoadAsync">
                ↻ @I18n.T("Refresh", "রিফ্রেশ")
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert danger" style="padding: 7px 14px; font-size: 12px; font-weight: 600; margin-bottom: 12px; border-radius: 6px;">
            ⚠ @message
        </div>
    }

    <!-- 2. Date Range Filter Card -->
    <div class="rep-filter-card">
        <div class="rep-presets-bar">
            <span style="font-size: 11px; font-weight: 800; color: #475569; margin-right: 4px;">@I18n.T("Quick Period", "কুইক পিরিয়ড"):</span>
            <button type="button" class="preset-btn @(currentPreset == "today" ? "active" : "")" @onclick="SetToday">@I18n.T("Today", "আজ")</button>
            <button type="button" class="preset-btn @(currentPreset == "yesterday" ? "active" : "")" @onclick="SetYesterday">@I18n.T("Yesterday", "গতকাল")</button>
            <button type="button" class="preset-btn @(currentPreset == "7days" ? "active" : "")" @onclick="SetLast7Days">@I18n.T("Last 7 Days", "বিগত ৭ দিন")</button>
            <button type="button" class="preset-btn @(currentPreset == "month" ? "active" : "")" @onclick="SetThisMonth">@I18n.T("This Month", "চলতি মাস")</button>
            <button type="button" class="preset-btn @(currentPreset == "year" ? "active" : "")" @onclick="SetThisYear">@I18n.T("This Year", "চলতি বছর")</button>
        </div>

        <div class="rep-filter-inputs">
            <div class="rep-filter-group">
                <span class="rep-filter-label">@I18n.T("From Date", "শুরুর তারিখ")</span>
                <input type="date" class="classic-input" value="@fromDate.ToString("yyyy-MM-dd")" @onchange="OnFromDateChanged" style="height: 30px !important; font-size: 12px !important;" />
            </div>
            <div class="rep-filter-group">
                <span class="rep-filter-label">@I18n.T("To Date", "শেষের তারিখ")</span>
                <input type="date" class="classic-input" value="@toDate.ToString("yyyy-MM-dd")" @onchange="OnToDateChanged" style="height: 30px !important; font-size: 12px !important;" />
            </div>
            <button type="button" class="btn btn-primary" style="height: 30px; font-size: 12px; font-weight: 700; padding: 0 16px;" @onclick="LoadAsync">
                @I18n.T("Generate Report", "রিপোর্ট তৈরি করুন")
            </button>
        </div>
    </div>

    <!-- 3. Executive Financial KPI Cards -->
    <div class="rep-kpi-grid">
        <div class="rep-kpi-card" style="border-left: 4px solid #0284c7;">
            <div>
                <div class="rep-kpi-label">@I18n.T("Gross Invoiced", "মোট বিল / গ্রস")</div>
                <div class="rep-kpi-val" style="color: #0369a1;">৳ @grandGross.ToString("N0")</div>
                <div class="rep-kpi-sub">@totalTransactionsCount @I18n.T("Invoices / Memos", "টি ট্রানজ্যাকশন")</div>
            </div>
            <div style="font-size: 24px; opacity: 0.85;">📈</div>
        </div>

        <div class="rep-kpi-card" style="border-left: 4px solid #f59e0b;">
            <div>
                <div class="rep-kpi-label">@I18n.T("Total Discount", "মোট বিশেষ ছাড়")</div>
                <div class="rep-kpi-val" style="color: #b45309;">৳ @grandDiscount.ToString("N0")</div>
                <div class="rep-kpi-sub">@(grandGross > 0 ? (grandDiscount / grandGross * 100).ToString("F1") : "0.0")% @I18n.T("of gross", "ছাড়ের হার")</div>
            </div>
            <div style="font-size: 24px; opacity: 0.85;">🏷️</div>
        </div>

        <div class="rep-kpi-card" style="border-left: 4px solid #8b5cf6;">
            <div>
                <div class="rep-kpi-label">@I18n.T("Net Revenue", "প্রকৃত রাজস্ব আয়")</div>
                <div class="rep-kpi-val" style="color: #6d28d9;">৳ @grandNet.ToString("N0")</div>
                <div class="rep-kpi-sub">@I18n.T("Gross less discounts", "ছাড় বাদ দিয়ে")</div>
            </div>
            <div style="font-size: 24px; opacity: 0.85;">💵</div>
        </div>

        <div class="rep-kpi-card" style="border-left: 4px solid #10b981;">
            <div>
                <div class="rep-kpi-label">@I18n.T("Paid Collection", "আদায়কৃত নগদ / ডিজিটাল")</div>
                <div class="rep-kpi-val" style="color: #047857;">৳ @grandPaid.ToString("N0")</div>
                <div class="rep-kpi-sub">@I18n.T("Net cash in hand & bank", "নগদ ও ব্যাংকে আদায়")</div>
            </div>
            <div style="font-size: 24px; opacity: 0.85;">💰</div>
        </div>

        <div class="rep-kpi-card" style="border-left: 4px solid #ef4444;">
            <div>
                <div class="rep-kpi-label">@I18n.T("Outstanding Due", "মোট বকেয়া / প্রাপ্য")</div>
                <div class="rep-kpi-val" style="color: #dc2626;">৳ @grandDue.ToString("N0")</div>
                <div class="rep-kpi-sub">@I18n.T("Receivable balance", "রোগীদের বকেয়া")</div>
            </div>
            <div style="font-size: 24px; opacity: 0.85;">⏳</div>
        </div>
    </div>

    <!-- 4. Interactive Tabs & Search -->
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
        <div class="rep-tabs">
            <button type="button" class="rep-tab-btn @(activeTab == "summary" ? "active" : "")" @onclick='() => activeTab = "summary"'>
                <span>📊</span>
                <span>@I18n.T("Departmental Summary", "বিভাগভিত্তিক আয়ের সারাংশ")</span>
            </button>
            <button type="button" class="rep-tab-btn @(activeTab == "cashier" ? "active" : "")" @onclick='() => activeTab = "cashier"'>
                <span>👤</span>
                <span>@I18n.T("Cashier & Staff Collection", "ক্যাশিয়ার ও স্টাফভিত্তিক আদায়")</span>
            </button>
            <button type="button" class="rep-tab-btn @(activeTab == "refunds" ? "active" : "")" @onclick='() => activeTab = "refunds"'>
                <span>↩️</span>
                <span>@I18n.T("Refunds & Reversals", "রিফান্ড ও রিভার্সাল অডিট")</span>
            </button>
        </div>

        <div style="position: relative; width: 260px;">
            <span style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); font-size: 12px; color: #94a3b8;">🔍</span>
            <input type="text" class="classic-input" style="padding-left: 30px !important; height: 32px !important; font-size: 12px !important; width: 100%;" placeholder="@I18n.T("Search department, cashier, refund...", "বিভাগ, ক্যাশিয়ার বা রিফান্ড খুঁজুন...")" @bind="searchQuery" @bind:event="oninput" />
        </div>
    </div>

    @if (activeTab == "summary")
    {
        <!-- Departmental Revenue Stream Summary -->
        <div class="rep-content-card">
            <div class="rep-card-header">
                <h3 class="rep-card-title">
                    <span>🏢</span>
                    <span>@I18n.T("Revenue Stream Breakdown by Clinical & Service Modules", "বিভাগভিত্তিক রাজস্ব ও আদায় বিবরণী")</span>
                </h3>
                <span class="pill" style="font-size: 11px; background: #e0f2fe; color: #0369a1; font-weight: 700;">
                    @I18n.T("Total Modules"): @departmentRows.Count
                </span>
            </div>

            <div class="rep-table-wrap">
                <table class="rep-table">
                    <thead>
                        <tr>
                            <th style="width: 40px;">#SL</th>
                            <th>@I18n.T("Revenue Source / Department", "খাত / বিভাগ")</th>
                            <th class="num" style="width: 100px;">@I18n.T("Transactions", "রিসিট সংখ্যা")</th>
                            <th class="num" style="width: 130px;">@I18n.T("Gross Bill (৳)", "গ্রস বিল")</th>
                            <th class="num" style="width: 120px;">@I18n.T("Discount (৳)", "ছাড়")</th>
                            <th class="num" style="width: 130px;">@I18n.T("Net Revenue (৳)", "প্রকৃত আয়")</th>
                            <th class="num" style="width: 130px;">@I18n.T("Collected (৳)", "আদায়")</th>
                            <th class="num" style="width: 120px;">@I18n.T("Due (৳)", "বকেয়া")</th>
                            <th class="num" style="width: 80px;">@I18n.T("Share", "অংশ")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var sl = 1; }
                        @foreach (var row in FilteredDepartmentRows)
                        {
                            <tr>
                                <td style="font-weight: 700; color: #64748b;">@(sl++)</td>
                                <td>
                                    <span style="font-size: 15px; margin-right: 6px;">@row.Icon</span>
                                    <strong style="color: #0f172a;">@row.Name</strong>
                                </td>
                                <td class="num" style="font-weight: 600;">@row.Count.ToString("N0")</td>
                                <td class="num" style="font-weight: 700; color: #334155;">৳ @row.Gross.ToString("N0")</td>
                                <td class="num" style="color: #b45309; font-weight: 600;">@(row.Discount > 0 ? $"৳ {row.Discount:N0}" : "—")</td>
                                <td class="num" style="font-weight: 800; color: #0f172a;">৳ @row.Net.ToString("N0")</td>
                                <td class="num" style="font-weight: 800; color: #047857;">৳ @row.Paid.ToString("N0")</td>
                                <td class="num" style="font-weight: 700; color: @(row.Due > 0 ? "#dc2626" : "#64748b");">
                                    @(row.Due > 0 ? $"৳ {row.Due:N0}" : "—")
                                </td>
                                <td class="num" style="font-size: 11px; font-weight: 700; color: #0284c7;">
                                    @(grandGross > 0 ? (row.Gross / grandGross * 100).ToString("F1") : "0")%
                                </td>
                            </tr>
                        }

                        @if (totalRefunds > 0)
                        {
                            <tr class="deduct-row">
                                <td style="font-weight: 700;">—</td>
                                <td>
                                    <span style="font-size: 15px; margin-right: 6px;">↩️</span>
                                    <strong>@I18n.T("Less: Approved Refunds & Financial Reversals", "বাদ: অনুমোদিত রিফান্ড ও রিভার্সাল")</strong>
                                </td>
                                <td class="num">@refundsCount</td>
                                <td class="num">—</td>
                                <td class="num">—</td>
                                <td class="num" style="font-weight: 800;">- ৳ @totalRefunds.ToString("N0")</td>
                                <td class="num" style="font-weight: 800;">- ৳ @totalRefunds.ToString("N0")</td>
                                <td class="num">—</td>
                                <td class="num">—</td>
                            </tr>
                        }

                        <tr class="total-row">
                            <td colspan="2" style="text-align: right; text-transform: uppercase;">
                                @I18n.T("Net Hospital Total", "হাসপাতালের সর্বমোট প্রকৃত আদায়"):
                            </td>
                            <td class="num">@totalTransactionsCount</td>
                            <td class="num">৳ @grandGross.ToString("N0")</td>
                            <td class="num" style="color: #b45309;">৳ @grandDiscount.ToString("N0")</td>
                            <td class="num" style="color: #0369a1;">৳ @(grandNet - totalRefunds).ToString("N0")</td>
                            <td class="num" style="color: #047857;">৳ @(grandPaid - totalRefunds).ToString("N0")</td>
