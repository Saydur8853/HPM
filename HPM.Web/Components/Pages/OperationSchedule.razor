    private string DoctorName(int? id)
    {
        if (!id.HasValue || id.Value <= 0) return "—";
        var doc = doctors.FirstOrDefault(d => d.ID == id.Value);
        return doc != null ? DoctorDisplayName(doc) : "—";
    }

    private static string DoctorDisplayName(DoctorsProfile d)
    {
        var title = d.Title?.Trim();
        var name = d.Name?.Trim() ?? "";
        return string.IsNullOrWhiteSpace(title) ? name : $"{title} {name}".Trim();
    }

    private string BedName(int? id) => id.HasValue && bedNames.TryGetValue(id.Value, out var n) ? n : "—";
    private string DepartmentName(int? id) => id.HasValue && departmentNames.TryGetValue(id.Value, out var n) ? n : "—";

    private static string GetStatusClass(string? status) => status?.ToLowerInvariant() switch
    {
        "scheduled" => "ot-status-scheduled",
        "in-progress" => "ot-status-inprogress",
        "completed" => "ot-status-completed",
        "cancelled" => "ot-status-cancelled",
        "postponed" => "ot-status-postponed",
        _ => "ot-status-scheduled"
    };

