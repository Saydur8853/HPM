    </table>

    <div style="display:flex; justify-content:space-between; margin-top:45px; font-size:11px;">
        <div style="border-top:1px solid #000; width:150px; text-align:center; padding-top:4px;">OT Supervisor</div>
        <div style="border-top:1px solid #000; width:150px; text-align:center; padding-top:4px;">Head of Anaesthesia</div>
        <div style="border-top:1px solid #000; width:150px; text-align:center; padding-top:4px;">OT In-Charge / Director</div>
    </div>
</div>

@code {
    private PatientOperation editor = new()
    {
        OperationDate = DateTime.Now.Date.AddHours(10),
        Status = "Scheduled",
        TheatreRoom = "Main OT Suite 1 (General & Lap)",
        AnaesthesiaType = "General Anaesthesia (GA)"
    };

    private PatientOperation? printTarget;
    private PatientAdmission? selectedAdmission;
    private string selectedPatientName = string.Empty;
    private string patientSearchQuery = string.Empty;
    private bool showPatientDropdown = false;
    private bool isLoadingMorePatients = false;
    private bool hasMorePatientSuggestions = false;
    private const int PatientBatchSize = 15;
    private DotNetObjectReference<OperationSchedule>? dotNetRef;

    private List<PatientAdmission> suggestedAdmissions = [];
    private List<DoctorsProfile> doctors = [];
    private List<PatientOperation> allOperations = [];
    private Dictionary<string, string> patientNames = [];
    private Dictionary<int, string> bedNames = [];
    private Dictionary<int, string> departmentNames = [];

    private int? selectedOperatorId => editor.OperatorID > 0 ? editor.OperatorID : null;
    private void OnOperatorChanged(int? id) => editor.OperatorID = id ?? 0;

    private void OnAnasthetistChanged(int? id) => editor.AnasthetistID = id;

    private int? selectedAssistantToAdd;
    private void OnAssistantPickerChanged(int? id)
    {
        if (id.HasValue && id.Value > 0)
        {
            if (!selectedAssistantIds.Contains(id.Value))
            {
                selectedAssistantIds.Add(id.Value);
            }
            selectedAssistantToAdd = null;
        }
    }
    private List<int> selectedAssistantIds = [];

    private string listSearchQuery = string.Empty;
    private string dateFilterMode = "today";
    private string statusFilter = string.Empty;
    private bool isSaving = false;
    private string message = string.Empty;
    private string messageClass = "success";
    private int totalActiveInpatients = 0;

    // KPI Counts
    private int totalCount => allOperations.Count;
    private int todayScheduledCount => allOperations.Count(x => x.OperationDate.Date == DateTime.Today.Date);
    private int todayCompletedCount => allOperations.Count(x => x.OperationDate.Date == DateTime.Today.Date && x.Status == "Completed");
    private int inProgressCount => allOperations.Count(x => x.Status == "In-Progress");
    private int completedCount => allOperations.Count(x => x.Status == "Completed");

    private List<PatientOperation> filteredOperations
    {
        get
        {
            var q = allOperations.AsEnumerable();

            if (dateFilterMode == "today")
                q = q.Where(x => x.OperationDate.Date == DateTime.Today.Date);
            else if (dateFilterMode == "week")
                q = q.Where(x => x.OperationDate.Date >= DateTime.Today.AddDays(-7).Date);
            else if (dateFilterMode == "month")
                q = q.Where(x => x.OperationDate.Date >= DateTime.Today.AddDays(-30).Date);

            if (!string.IsNullOrWhiteSpace(statusFilter))
                q = q.Where(x => string.Equals(x.Status, statusFilter, StringComparison.OrdinalIgnoreCase));

            if (!string.IsNullOrWhiteSpace(listSearchQuery))
            {
                var query = listSearchQuery.Trim().ToLowerInvariant();
                q = q.Where(x => (x.ProcedureName?.ToLowerInvariant().Contains(query) ?? false) ||
                                 (x.RegNo?.ToLowerInvariant().Contains(query) ?? false) ||
                                 (x.PatientID?.ToLowerInvariant().Contains(query) ?? false) ||
                                 (patientNames.GetValueOrDefault(x.PatientID ?? "", "").ToLowerInvariant().Contains(query)) ||
                                 (DoctorName(x.OperatorID).ToLowerInvariant().Contains(query)));
            }

            return q.OrderByDescending(x => x.OperationDate).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        dotNetRef ??= DotNetObjectReference.Create(this);
        if (!showPatientDropdown) return;

        try
        {
            await JS.InvokeVoidAsync("hpm.initPatientIdScroll", "ot-schedule-patient-suggestions-list", dotNetRef, nameof(LoadMorePatientsFromJs));
        }
        catch { }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            doctors = await db.Doctors.AsNoTracking().Where(x => x.IsActive).OrderBy(x => x.Name).ToListAsync();
            totalActiveInpatients = await db.PatientAdmissions.AsNoTracking().CountAsync(x => x.IsAdmitted == true);

            var beds = await db.BedCabins.AsNoTracking().ToListAsync();
            bedNames = beds.ToDictionary(x => x.ID, x => x.Name);

            var depts = await db.Departments.AsNoTracking().ToListAsync();
            departmentNames = depts.ToDictionary(x => x.ID, x => x.Name);

            allOperations = await db.PatientOperations.AsNoTracking().OrderByDescending(x => x.OperationDate).ToListAsync();

            var pIds = allOperations.Select(x => x.PatientID).Where(x => !string.IsNullOrEmpty(x)).Distinct().ToList();
            if (pIds.Count > 0)
            {
                var regs = await db.Registrations.AsNoTracking().Where(x => pIds.Contains(x.PatientID)).ToListAsync();
                foreach (var r in regs) patientNames[r.PatientID] = r.Name;
            }


        }
        catch (Exception ex)
        {
            message = $"Error loading data: {ex.Message}";
            messageClass = "danger";
        }
    }

    private static IQueryable<PatientAdmission> BuildPatientSuggestionQuery(HpmDbContext db, string term)
    {
        var query = db.PatientAdmissions.AsNoTracking().Where(x => x.IsAdmitted == true);
        if (!string.IsNullOrWhiteSpace(term))
        {
            query = query.Where(a => a.RegNo.Contains(term)
                || (a.PatientID != null && a.PatientID.Contains(term))
                || db.Registrations.Any(r => r.PatientID == a.PatientID
                    && (r.Name.Contains(term) || (r.Contact != null && r.Contact.Contains(term))))
                || db.BedCabins.Any(b => b.ID == a.BedCabinID && b.Name.Contains(term)));
        }
        return query.OrderByDescending(x => x.AdmissionDate).ThenByDescending(x => x.ID);
    }

    private async Task CacheSuggestionPatientsAsync(HpmDbContext db, IEnumerable<PatientAdmission> admissions)
    {
        var batch = admissions.ToList();
        var pIds = batch.Where(x => !string.IsNullOrWhiteSpace(x.PatientID) && !patientNames.ContainsKey(x.PatientID!))
                        .Select(x => x.PatientID!)
                        .Distinct()
                        .ToArray();
        if (pIds.Length > 0)
        {
            var newNames = await db.Registrations.AsNoTracking()
                .Where(x => pIds.Contains(x.PatientID))
                .ToDictionaryAsync(x => x.PatientID, x => x.Name, StringComparer.OrdinalIgnoreCase);
            foreach (var kvp in newNames)
            {
                patientNames[kvp.Key] = kvp.Value;
            }
        }
    }

    private async Task LoadPatientSuggestionsAsync(bool reset)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var query = BuildPatientSuggestionQuery(db, patientSearchQuery.Trim());
        var skip = reset ? 0 : suggestedAdmissions.Count;
        var batch = await query.Skip(skip).Take(PatientBatchSize).ToListAsync();
        await CacheSuggestionPatientsAsync(db, batch);

        if (reset)
        {
            suggestedAdmissions = batch;
            try { await JS.InvokeVoidAsync("hpm.resetPatientIdScrollTop", "ot-schedule-patient-suggestions-list"); } catch { }
        }
        else
        {
            suggestedAdmissions.AddRange(batch);
        }

        hasMorePatientSuggestions = batch.Count == PatientBatchSize;
        showPatientDropdown = true;
    }

    private async Task HandlePatientSearchInputAsync(ChangeEventArgs e)
    {
        patientSearchQuery = e.Value?.ToString() ?? "";
        await LoadPatientSuggestionsAsync(reset: true);
    }

    private async Task ShowPatientSuggestionsAsync()
    {
        await LoadPatientSuggestionsAsync(reset: true);
    }

    [JSInvokable]
    public async Task LoadMorePatientsFromJs()
    {
        if (isLoadingMorePatients || !hasMorePatientSuggestions || !showPatientDropdown) return;
        isLoadingMorePatients = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            await LoadPatientSuggestionsAsync(reset: false);
        }
        catch
        {
            hasMorePatientSuggestions = false;
        }
        finally
        {
            isLoadingMorePatients = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void SelectAdmission(PatientAdmission adm)
    {
        selectedAdmission = adm;
        selectedPatientName = patientNames.GetValueOrDefault(adm.PatientID ?? "", "—");
        editor.RegNo = adm.RegNo ?? "";
        editor.PatientID = adm.PatientID ?? "";
        if (adm.Consultant.HasValue && editor.OperatorID == 0)
            editor.OperatorID = adm.Consultant.Value;
        showPatientDropdown = false;
        patientSearchQuery = "";
    }

    private void ClearSelectedPatient()
    {
        selectedAdmission = null;
        selectedPatientName = "";
        editor.RegNo = "";
        editor.PatientID = "";
    }

    private void AddAssistant()
    {
        if (selectedAssistantToAdd.HasValue && selectedAssistantToAdd.Value > 0 && !selectedAssistantIds.Contains(selectedAssistantToAdd.Value))
        {
            selectedAssistantIds.Add(selectedAssistantToAdd.Value);
            selectedAssistantToAdd = null;
        }
    }

    private void RemoveAssistant(int id)
    {
        selectedAssistantIds.Remove(id);
    }

    private void SetDateFilter(string mode)
    {
        dateFilterMode = mode;
    }

    private void SelectOperation(PatientOperation op)
    {
        editor = new PatientOperation
        {
            ID = op.ID,
            PatientID = op.PatientID,
            RegNo = op.RegNo,
            ProcedureName = op.ProcedureName,
            OperationDate = op.OperationDate,
            TheatreRoom = op.TheatreRoom,
            OperatorID = op.OperatorID,
            AnasthetistID = op.AnasthetistID,
            AssistantDoctorIDs = op.AssistantDoctorIDs,
            AnaesthesiaType = op.AnaesthesiaType,
            Drug = op.Drug,
            Remarks = op.Remarks,
            Status = op.Status
        };

        selectedPatientName = patientNames.GetValueOrDefault(op.PatientID, "—");
        selectedAssistantIds = !string.IsNullOrWhiteSpace(op.AssistantDoctorIDs)
            ? op.AssistantDoctorIDs.Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(x => int.TryParse(x.Trim(), out var id) ? id : 0)
                .Where(x => x > 0)
                .ToList()
            : [];

        message = "";
    }

    private void ResetForm()
    {
        editor = new PatientOperation
        {
            OperationDate = DateTime.Now.Date.AddHours(10),
            Status = "Scheduled",
            TheatreRoom = "Main OT Suite 1 (General & Lap)",
            AnaesthesiaType = "General Anaesthesia (GA)"
        };
        ClearSelectedPatient();
        selectedAssistantIds.Clear();
        selectedAssistantToAdd = null;
        message = "";
    }

    private async Task HandleGlobalKeyDown(KeyboardEventArgs e)
    {
        if ((e.CtrlKey || e.MetaKey) && (e.Key == "s" || e.Key == "S" || e.Key == "Enter"))
        {
            await SaveAsync();
        }
        else if (e.Key == "Escape")
        {
            ResetForm();
        }
        else if (e.Key == "F2")
        {
            ResetForm();
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(editor.ProcedureName))
        {
            message = I18n.IsBangla ? "অপারেশনের নাম দিন।" : "Please enter the Procedure / Operation name.";
            messageClass = "danger";
            return;
        }

        if (string.IsNullOrWhiteSpace(editor.PatientID))
        {
            message = I18n.IsBangla ? "রোগী নির্বাচন করুন।" : "Please select an admitted patient.";
            messageClass = "danger";
            return;
        }

        if (editor.OperatorID <= 0)
        {
            message = I18n.IsBangla ? "প্রধান সার্জন নির্বাচন করুন।" : "Please select the Lead Surgeon / Operator.";
            messageClass = "danger";
            return;
        }

        isSaving = true;
        message = "";

        try
        {
            editor.AssistantDoctorIDs = selectedAssistantIds.Any() ? string.Join(",", selectedAssistantIds) : null;
            await using var db = await DbFactory.CreateDbContextAsync();

            if (editor.ID == 0)
            {
                editor.TransDate = DateTime.Now;
                editor.EnteredBy = 1;
                db.PatientOperations.Add(editor);
                await db.SaveChangesAsync();
                message = I18n.IsBangla ? "অপারেশন সফলভাবে শিডিউল করা হয়েছে!" : "Operation scheduled successfully!";
            }
            else
            {
                var existing = await db.PatientOperations.FindAsync(editor.ID);
                if (existing != null)
                {
                    existing.ProcedureName = editor.ProcedureName;
                    existing.OperationDate = editor.OperationDate;
                    existing.TheatreRoom = editor.TheatreRoom;
                    existing.OperatorID = editor.OperatorID;
                    existing.AnasthetistID = editor.AnasthetistID;
                    existing.AssistantDoctorIDs = editor.AssistantDoctorIDs;
                    existing.AnaesthesiaType = editor.AnaesthesiaType;
                    existing.Drug = editor.Drug;
                    existing.Remarks = editor.Remarks;
                    existing.Status = editor.Status;
                    await db.SaveChangesAsync();
                    message = I18n.IsBangla ? "শিডিউল সফলভাবে আপডেট করা হয়েছে!" : "Schedule updated successfully!";
                }
            }

            messageClass = "success";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            message = $"Error saving schedule: {ex.Message}";
            messageClass = "danger";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (editor.ID <= 0) return;
        var confirmed = await JS.InvokeAsync<bool>("confirm", I18n.IsBangla ? "আপনি কি নিশ্চিতভাবে এই ওটি শিডিউলটি বাতিল/ডিলিট করতে চান?" : "Are you sure you want to delete this OT booking?");
        if (!confirmed) return;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var existing = await db.PatientOperations.FindAsync(editor.ID);
            if (existing != null)
            {
                db.PatientOperations.Remove(existing);
                await db.SaveChangesAsync();
                message = I18n.IsBangla ? "শিডিউল মুছে ফেলা হয়েছে।" : "Schedule deleted successfully.";
                messageClass = "success";
                ResetForm();
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            message = $"Delete failed: {ex.Message}";
            messageClass = "danger";
        }
    }

