@page "/medical/operations"
@page "/medical/operation-list"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.Doctor + "," + RoleNames.OTOperator + "," + RoleNames.Nurse)]
@rendermode InteractiveServer
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject IBarcodeQrService BarcodeQr
@inject NavigationManager Navigation
@implements IDisposable
@using System.Security.Claims
@using HPM.Web.Components.Common
@using HPM.Web.Data
@using HPM.Web.Data.Entities
@using HPM.Web.Services
@using Microsoft.EntityFrameworkCore

<PageTitle>@I18n.T("Operation Theatre (OT) Scheduling") | @Branding.HospitalName</PageTitle>

<style>
.ot-classic-page {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 10px 16px 20px;
    max-width: 1560px;
    margin: 0 auto;
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    color: #1e293b;
}

/* 1. Header & Navigation Links */
.ot-top-nav-links {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11.5px;
    font-weight: 600;
    margin-bottom: 4px;
}
.ot-top-nav-link {
    color: #0369a1;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 6px;
    border-radius: 4px;
    transition: background 0.15s;
}
.ot-top-nav-link:hover {
    background: #e0f2fe;
    text-decoration: none;
}

/* Real-time KPI Metric Summary Cards */
.ipd-kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 12px;
}
.ipd-kpi-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.04);
}
.ipd-kpi-info {
    display: flex;
    flex-direction: column;
}
.ipd-kpi-label {
    font-size: 11px;
    font-weight: 750;
    text-transform: uppercase;
    color: #64748b;
    letter-spacing: 0.5px;
}
.ipd-kpi-val {
    font-size: 22px;
    font-weight: 900;
    line-height: 1.2;
    margin-top: 2px;
}
.ipd-kpi-sub {
    font-size: 11px;
    color: #64748b;
    margin-top: 2px;
}
.ipd-kpi-icon {
    font-size: 26px;
    opacity: 0.85;
}

.ot-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(380px, 1fr);
    gap: 14px;
    align-items: start;
}
@@media (max-width: 1060px) {
    .ot-grid {
        grid-template-columns: 1fr;
    }
}
.ot-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
    overflow: visible;
}
.ot-card-header {
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    padding: 10px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.ot-card-header h2 {
    font-size: 13.5px;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 7px;
}
.ot-card-body {
    padding: 14px 16px;
}
.ot-form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px 14px;
}
.ot-form-col-full {
    grid-column: 1 / -1;
}
.ot-field-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
}
.ot-field-label {
    font-size: 11px;
    font-weight: 700;
    color: #334155;
    display: flex;
    justify-content: space-between;
}
.ot-field-label .req {
    color: #dc2626;
    margin-left: 2px;
}
.ot-status-badge {
    font-size: 10px;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    text-transform: uppercase;
}
.ot-status-scheduled { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; }
.ot-status-inprogress { background: #fef3c7; color: #b45309; border: 1px solid #fde68a; }
.ot-status-completed { background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; }
.ot-status-cancelled { background: #fee2e2; color: #b91c1c; border: 1px solid #fecaca; }
.ot-status-postponed { background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; }

.ot-asst-chip {
    background: #f1f5f9;
    color: #1e293b;
    border: 1px solid #cbd5e1;
    font-size: 11px;
    font-weight: 650;
    padding: 2px 7px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
}
.ot-asst-chip button {
    background: none;
    border: none;
    color: #64748b;
    cursor: pointer;
    padding: 0;
    font-size: 11px;
    line-height: 1;
}
.ot-asst-chip button:hover {
    color: #dc2626;
}
.ot-item-row {
    padding: 10px 12px;
    border-bottom: 1px solid #f1f5f9;
    cursor: pointer;
    transition: background 0.12s ease;
}
.ot-item-row:hover {
    background: #f8fafc;
}
.ot-item-row.selected {
    background: #f0f9ff;
    border-left: 3px solid #0284c7;
}

/* Patient Auto-suggest Dropdown */
.ot-patient-suggestions {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    width: 100%;
    max-height: 270px;
    overflow-y: auto;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.14);
    z-index: 125;
}
.ot-patient-clean-option {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 7px 10px;
    border: none;
    border-bottom: 1px solid #f1f5f9;
    background: transparent;
    cursor: pointer;
    text-align: left;
    font-size: 11.5px;
    transition: background 0.12s;
}
.ot-patient-clean-option:hover {
    background: #f0f9ff;
}
.ot-scroll-hint {
    padding: 6px 10px;
    text-align: center;
    background: #f8fafc;
    border-top: 1px solid #e2e8f0;
    font-size: 10.5px;
    color: #0284c7;
    font-weight: 600;
    cursor: pointer;
}

/* Print Sheets */
@@media print {
    body * {
        visibility: hidden;
    }
    #ot-slip-print, #ot-slip-print *,
    #ot-register-print, #ot-register-print * {
        visibility: visible;
    }
    #ot-slip-print, #ot-register-print {
        display: block !important;
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        margin: 0;
        padding: 10mm 14mm;
        box-sizing: border-box;
    }
}
</style>

<div class="ot-classic-page" @onkeydown="HandleGlobalKeyDown" tabindex="0">
    <!-- 1. Top Header & Flow Links -->
    <div>
        <div class="ot-top-nav-links">
            <span style="color:#64748b; font-weight:700;">@I18n.T("Medical Services Flow", "মেডিকেল সার্ভিসেস ফ্লো"):</span>
            <span class="ot-top-nav-link" style="background:#e0f2fe; color:#0369a1; font-weight:750;">🗓️ @I18n.T("OT Schedule & Register")</span>
            <span>→</span>
            <a href="/medical/ot-notes" class="ot-top-nav-link">📝 @I18n.T("Surgeon's OT Note", "সার্জন্স ওটি নোট")</a>
            <span>→</span>
            <a href="/ot-cash-memos" class="ot-top-nav-link">💳 @I18n.T("OT Cash Memo / Billing", "ওটি বিলিং")</a>
            <span>&bull;</span>
            <a href="/medical/nurse-desk" class="ot-top-nav-link">🩺 @I18n.T("Nurse's Desk", "নার্সেস ডেস্ক")</a>
        </div>

        <div class="appt-classic-topbar">
            <div class="appt-top-left">
                <h1 class="appt-page-title">
                    <span>🏥</span>
                    <span>@I18n.T("Operation Theatre (OT) Scheduling & Register", "অপারেশন থিয়েটার (ওটি) শিডিউলিং ও রেজিস্টার")</span>
                </h1>
                <span class="appt-count-pill">
                    @totalCount @I18n.T("Total Operations", "মোট অপারেশন")
                </span>
                <span class="appt-count-pill" style="background:#eff6ff; color:#1d4ed8; border-color:#bfdbfe;">
                    📅 @todayScheduledCount @I18n.T("Today Scheduled", "আজকের শিডিউল")
                </span>
                <span class="appt-count-pill" style="background:#ecfdf5; color:#047857; border-color:#a7f3d0;">
                    ✓ @completedCount @I18n.T("Completed", "সম্পন্ন")
                </span>
                @if (!string.IsNullOrWhiteSpace(message))
                {
                    <span class="appt-inline-alert @messageClass">
                        @(messageClass == "success" ? "✓" : "⚠") @message
                    </span>
                }
            </div>

            <div class="appt-top-actions">
                <button type="button" class="btn btn-secondary appt-btn" @onclick="PrintRegisterAsync" title="@I18n.T("Print Filtered OT Schedule List")">
                    🖨️ @I18n.T("Print OT Schedule", "ওটি শিডিউল প্রিন্ট")
                </button>
                <button type="button" class="btn btn-ghost appt-btn" @onclick="ResetForm" title="@I18n.T("New Operation Schedule (F2)")">
                    + @I18n.T("New Booking", "নতুন ওটি বুকিং")
                </button>
            </div>
        </div>
    </div>

    <!-- 2. Real-time KPI Metric Summary Cards -->
    <div class="ipd-kpi-grid">
        <div class="ipd-kpi-card" style="border-left: 4px solid #0284c7;">
            <div class="ipd-kpi-info">
                <div class="ipd-kpi-label">@I18n.T("Scheduled Today", "আজকের ওটি শিডিউল")</div>
                <div class="ipd-kpi-val" style="color: #0369a1;">@todayScheduledCount</div>
                <div class="ipd-kpi-sub">@todayCompletedCount @I18n.T("completed today", "আজ সম্পন্ন হয়েছে")</div>
            </div>
            <div class="ipd-kpi-icon">📅</div>
        </div>
        <div class="ipd-kpi-card" style="border-left: 4px solid #eab308;">
            <div class="ipd-kpi-info">
                <div class="ipd-kpi-label">@I18n.T("In-Progress / Upcoming", "চলমান / আসন্ন কেস")</div>
                <div class="ipd-kpi-val" style="color: #b45309;">@inProgressCount</div>
                <div class="ipd-kpi-sub">@I18n.T("Under active theatre / anaesthesia", "থিয়েটারে চলমান বা প্রস্তুত")</div>
            </div>
            <div class="ipd-kpi-icon">⏱️</div>
        </div>
        <div class="ipd-kpi-card" style="border-left: 4px solid #10b981;">
            <div class="ipd-kpi-info">
                <div class="ipd-kpi-label">@I18n.T("Total Completed", "সম্পন্ন অপারেশন")</div>
                <div class="ipd-kpi-val" style="color: #15803d;">@completedCount</div>
                <div class="ipd-kpi-sub">@I18n.T("With post-op clearance", "সার্জিক্যাল কেস সম্পন্ন")</div>
            </div>
            <div class="ipd-kpi-icon">✅</div>
        </div>
        <div class="ipd-kpi-card" style="border-left: 4px solid #8b5cf6;">
            <div class="ipd-kpi-info">
                <div class="ipd-kpi-label">@I18n.T("Surgeons Available", "ডিউটিরত সার্জন")</div>
                <div class="ipd-kpi-val" style="color: #6d28d9;">@doctors.Count</div>
                <div class="ipd-kpi-sub">@I18n.T("Consultants & Specialists", "কনসালটেন্ট ও সার্জন তালিকা")</div>
            </div>
            <div class="ipd-kpi-icon">🩺</div>
        </div>
    </div>

    <!-- 3. Main Workspace Grid -->
    <div class="ot-grid">
        <!-- Left Column: Booking & Scheduling Form -->
        <div class="ot-card">
            <div class="ot-card-header">
                <h2>
                    <span>@(editor.ID == 0 ? "➕ " + I18n.T("New Operation Theatre Booking", "নতুন ওটি বুকিং ও শিডিউলিং") : $"✏️ {I18n.T("Edit OT Booking")} #{editor.ID}")</span>
                </h2>
                <div>
                    @if (editor.ID > 0)
                    {
                        <span class="ot-status-badge @GetStatusClass(editor.Status)">
                            @editor.Status
                        </span>
                    }
                </div>
            </div>

            <div class="ot-card-body">
                <!-- Patient Search & Selection with Infinite Scroll Lazy Load -->
                <div class="ot-field-group" style="margin-bottom: 12px;">
                    <span class="ot-field-label">
                        <span>@I18n.T("Select Admitted Patient", "ভর্তি রোগী নির্বাচন করুন") <span class="req">*</span></span>
                        <span style="color:#64748b; font-weight:600;">@totalActiveInpatients @I18n.T("Active Inpatients", "জন রোগী ভর্তি আছেন")</span>
                    </span>

                    @if (selectedAdmission != null)
                    {
                        <div class="appt-patient-verified" style="display:flex; justify-content:space-between; align-items:center; background:#f0f9ff; border:1px solid #bae6fd; padding:8px 12px; border-radius:6px;">
                            <div style="font-size:11.5px; color:#0f172a;">
                                <strong>#@selectedAdmission.PatientID</strong> &bull; <b style="color:#0284c7;">@selectedPatientName</b>
                                &bull; <span>Age: @selectedAdmission.Age</span>
                                &bull; <strong>🛏️ @BedName(selectedAdmission.BedCabinID)</strong>
                                &bull; <span>Reg: <strong>@selectedAdmission.RegNo</strong></span>
                            </div>
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="ClearSelectedPatient" style="font-size:11px; padding:2px 8px; color:#0369a1;">
                                @I18n.T("Change", "পরিবর্তন")
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="appt-patient-search-combo" style="position:relative; width:100%;">
                            <input class="classic-input"
                                   style="height:32px !important; min-height:32px !important;"
                                   value="@patientSearchQuery"
                                   @oninput="HandlePatientSearchInputAsync"
                                   @onfocus="ShowPatientSuggestionsAsync"
                                   autocomplete="off"
                                   placeholder="@I18n.T("Search by Patient ID, Name, Reg # or Bed...", "রোগীর আইডি, নাম, রেজি. বা বেড দিয়ে খুঁজুন...")" />
                            @if (showPatientDropdown)
                            {
                                <div class="tickets-type-dropdown-backdrop" style="position:fixed; inset:0; z-index:110;" @onclick="() => showPatientDropdown = false"></div>
                                <div class="ot-patient-suggestions" id="ot-schedule-patient-suggestions-list">
                                    @foreach (var adm in suggestedAdmissions)
                                    {
                                        var pName = patientNames.GetValueOrDefault(adm.PatientID ?? "", "—");
                                        <button type="button" class="ot-patient-clean-option"
                                                @onmousedown:preventDefault
                                                @onclick="() => SelectAdmission(adm)">
                                            <span style="font-weight:800; color:#0284c7; min-width:82px;">#@adm.RegNo</span>
                                            <span class="pill" style="font-size:9.5px; background:#e0f2fe; color:#0369a1; padding:1px 5px; flex-shrink:0; font-weight:750;">ID: @adm.PatientID</span>
                                            <span style="font-weight:700; color:#0f172a; flex:1; min-width:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@pName</span>
                                            <span style="font-size:11px; color:#64748b; flex-shrink:0;">🛏️ @BedName(adm.BedCabinID)</span>
                                            <span style="font-size:10px; color:#64748b; flex-shrink:0;">👨‍⚕️ @DoctorName(adm.Consultant)</span>
                                        </button>
                                    }
                                    @if (suggestedAdmissions.Count == 0)
                                    {
                                        <div style="padding:12px; font-size:11.5px; color:#64748b; text-align:center;">
                                            @I18n.T("No matching admitted patient found", "কোনো রোগী পাওয়া যায়নি")
                                        </div>
                                    }
                                    else if (hasMorePatientSuggestions)
                                    {
                                        <div class="ot-scroll-hint"
                                             @onmousedown:preventDefault
                                             @onclick="LoadMorePatientsFromJs">
                                            @if (isLoadingMorePatients)
                                            {
                                                <span>⏳ @I18n.T("Loading more...", "আরো লোড হচ্ছে...")</span>
                                            }
                                            else
                                            {
                                                <span>@I18n.T("Showing") @suggestedAdmissions.Count &bull; @I18n.T("Scroll for more...", "আরো দেখতে স্ক্রোল করুন...")</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="ot-form-grid">
                    <!-- Procedure Name -->
                    <div class="ot-field-group ot-form-col-full">
                        <span class="ot-field-label">
                            <span>@I18n.T("Procedure / Operation Name", "অপারেশন / সার্জারির নাম") <span class="req">*</span></span>
                        </span>
                        <input class="classic-input"
                               style="height:32px !important;"
                               @bind="editor.ProcedureName"
                               list="commonProcedures"
                               placeholder="@I18n.T("e.g. Appendectomy, Caesarean Section (LSCS), Cholecystectomy, Hernioplasty...")" />
                        <datalist id="commonProcedures">
                            <option value="Appendectomy (Laparoscopic / Open)" />
                            <option value="Caesarean Section (LSCS)" />
                            <option value="Laparoscopic Cholecystectomy" />
                            <option value="Inguinal Hernioplasty / Herniorrhaphy" />
                            <option value="Exploratory Laparotomy" />
                            <option value="Total Abdominal Hysterectomy (TAH)" />
                            <option value="TURP (Transurethral Resection of Prostate)" />
                            <option value="Open Reduction & Internal Fixation (ORIF)" />
                            <option value="K-Wire Fixation / Fracture Repair" />
                            <option value="Tonsillectomy & Adenoidectomy" />
                            <option value="Cataract Phacoemulsification with IOL" />
                            <option value="Fistulotomy / Fissurectomy" />
                            <option value="Haemorrhoidectomy" />
                            <option value="Diagnostic Laparoscopy / Hysteroscopy" />
                        </datalist>
                    </div>

                    <!-- Operation Date & Time -->
                    <div class="ot-field-group">
                        <span class="ot-field-label">
                            <span>@I18n.T("Operation Date & Time", "অপারেশনের তারিখ ও সময়") <span class="req">*</span></span>
                        </span>
                        <input type="datetime-local"
                               class="classic-input"
                               style="height:32px !important;"
                               @bind="editor.OperationDate" />
                    </div>

                    <!-- Theatre Room -->
                    <div class="ot-field-group">
                        <span class="ot-field-label">
                            <span>@I18n.T("Theatre Room / OT Suite", "অপারেশন থিয়েটার কক্ষ") <span class="req">*</span></span>
                        </span>
                        <select class="classic-input" style="height:32px !important;" @bind="editor.TheatreRoom">
                            <option value="Main OT Suite 1 (General & Lap)">Main OT Suite 1 (General & Lap)</option>
                            <option value="Main OT Suite 2 (Gynae & Obs / LSCS)">Main OT Suite 2 (Gynae & Obs / LSCS)</option>
                            <option value="OT Suite 3 (Orthopaedic & Trauma)">OT Suite 3 (Orthopaedic & Trauma)</option>
                            <option value="OT Suite 4 (ENT & Ophthalmology)">OT Suite 4 (ENT & Ophthalmology)</option>
                            <option value="Emergency Minor OT">Emergency Minor OT</option>
                            <option value="Endoscopy / Day Care OT">Endoscopy / Day Care OT</option>
                        </select>
                    </div>

                    <!-- Operator / Lead Surgeon -->
                    <div class="ot-field-group">
                        <span class="ot-field-label">
                            <span>@I18n.T("Lead Surgeon / Operator", "প্রধান সার্জন / অপারেটর") <span class="req">*</span></span>
                        </span>
                        <DoctorPicker Doctors="doctors" Value="selectedOperatorId" ValueChanged="OnOperatorChanged"
                                      CacheKey="ot_lead_surgeon"
                                      Placeholder="@I18n.T("Search lead surgeon by name, ID or degree...")" />
                    </div>

                    <!-- Anaesthetist -->
                    <div class="ot-field-group">
                        <span class="ot-field-label">
                            <span>@I18n.T("Anaesthetist", "অ্যানেস্থেটিস্ট")</span>
                        </span>
                        <DoctorPicker Doctors="doctors" Value="editor.AnasthetistID" ValueChanged="OnAnasthetistChanged"
                                      CacheKey="ot_anaesthetist"
                                      Placeholder="@I18n.T("Search anaesthetist...")" />
                    </div>

                    <!-- Assistant Doctors Multi-select -->
                    <div class="ot-field-group ot-form-col-full">
                        <span class="ot-field-label">
                            <span>@I18n.T("Assistant Surgeons", "সহকারী সার্জনবৃন্দ")</span>
                        </span>
                        <div style="display:flex; gap:8px; align-items:center;">
                            <div style="flex:1;">
                                <DoctorPicker Doctors="doctors" Value="selectedAssistantToAdd" ValueChanged="OnAssistantPickerChanged"
                                              CacheKey="ot_assistant_surgeon"
                                              Placeholder="@I18n.T("Search assistant surgeon to add...")" />
                            </div>
                            <button type="button" class="btn btn-secondary appt-btn" style="height:30px; padding:0 12px; white-space:nowrap;" @onclick="AddAssistant">
                                + @I18n.T("Add")
                            </button>
                        </div>

                        @if (selectedAssistantIds.Any())
                        {
                            <div style="display:flex; flex-wrap:wrap; gap:6px; margin-top:6px;">
                                @foreach (var asstId in selectedAssistantIds)
                                {
                                    <span class="ot-asst-chip">
                                        <span>🩺 @DoctorName(asstId)</span>
                                        <button type="button" @onclick="() => RemoveAssistant(asstId)">✕</button>
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    <!-- Anaesthesia Type -->
                    <div class="ot-field-group">
                        <span class="ot-field-label">
                            <span>@I18n.T("Anaesthesia Type", "অ্যানেস্থেশিয়ার ধরন")</span>
                        </span>
                        <select class="classic-input" style="height:32px !important;" @bind="editor.AnaesthesiaType">
                            <option value="General Anaesthesia (GA)">General Anaesthesia (GA)</option>
                            <option value="Spinal Anaesthesia (SA)">Spinal Anaesthesia (SA)</option>
                            <option value="Epidural Anaesthesia">Epidural Anaesthesia</option>
                            <option value="Combined Spinal-Epidural (CSE)">Combined Spinal-Epidural (CSE)</option>
                            <option value="Local Anaesthesia (LA)">Local Anaesthesia (LA)</option>
                            <option value="SAB + Sedation">SAB + Sedation</option>
                            <option value="Nerve Block / Regional">Nerve Block / Regional</option>
                        </select>
                    </div>

                    <!-- Booking Status -->
                    <div class="ot-field-group">
                        <span class="ot-field-label">
                            <span>@I18n.T("Schedule Status", "শিডিউলের অবস্থা")</span>
                        </span>
                        <select class="classic-input" style="height:32px !important;" @bind="editor.Status">
                            <option value="Scheduled">Scheduled</option>
                            <option value="In-Progress">In-Progress</option>
                            <option value="Completed">Completed</option>
                            <option value="Postponed">Postponed</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>

                    <!-- Pre-Op Drug / Pre-Medication -->
                    <div class="ot-field-group ot-form-col-full">
                        <span class="ot-field-label">
                            <span>@I18n.T("Pre-Medication & Anaesthetic Drug Orders", "প্রাক-অপারেশন ওষুধ ও প্রিপারেশন")</span>
                        </span>
                        <input class="classic-input"
                               style="height:32px !important;"
                               @bind="editor.Drug"
                               placeholder="@I18n.T("e.g. Inj. Cefuroxime 1.5g IV stat, NPO after midnight, Consent form signed, 2 units Blood arranged...")" />
                    </div>

                    <!-- Remarks / Pre-op Diagnosis -->
                    <div class="ot-field-group ot-form-col-full">
                        <span class="ot-field-label">
                            <span>@I18n.T("Clinical Notes & Pre-Op Diagnosis", "ক্লিনিক্যাল নোট ও প্রাক-অপারেশন রোগনির্ণয়")</span>
                        </span>
                        <textarea class="classic-input"
                                  rows="2"
                                  style="min-height:50px;"
                                  @bind="editor.Remarks"
                                  placeholder="@I18n.T("e.g. Acute Appendicitis. Patient prepared for emergency laparoscopy. Medical clearance completed.")"></textarea>
                    </div>
                </div>
            </div>

            <!-- Footer Action Buttons -->
            <div class="appt-form-footer" style="display:flex !important; align-items:center !important; justify-content:space-between !important; padding:9px 16px !important; background:#f8fafc !important; border-top:1px solid #e2e8f0 !important; border-bottom-left-radius:7px; border-bottom-right-radius:7px;">
                <div class="appt-footer-left-info" style="display:flex; align-items:center; gap:8px;">
                    @if (editor.ID > 0)
                    {
                        <button type="button" class="btn btn-ghost appt-btn" style="color:#dc2626;" @onclick="DeleteAsync" title="@I18n.T("Cancel/Delete this OT Schedule")">
                            🗑️ @I18n.T("Delete")
                        </button>
                    }
                    <button type="button" class="btn btn-ghost appt-btn" @onclick="ResetForm" title="@I18n.T("Clear Form (Esc)")">
                        @I18n.T("Clear / Reset")
                    </button>
                </div>

                <div style="display:flex; gap:8px; align-items:center;">
                    @if (editor.ID > 0)
                    {
                        <button type="button" class="btn btn-secondary appt-btn" @onclick="PrintActiveSlipAsync" title="@I18n.T("Print OT Schedule Slip")">
                            🖨️ @I18n.T("Print Slip", "স্লিপ প্রিন্ট")
                        </button>
                        <a href="/medical/ot-notes?opId=@editor.ID" class="btn btn-secondary appt-btn" style="text-decoration:none;" title="@I18n.T("Write Surgeon's Post-Op Note")">
                            📝 @I18n.T("Write OT Note →")
                        </a>
                    }

                    <button type="button" class="btn btn-primary appt-btn appt-book-btn" @onclick="SaveAsync" disabled="@isSaving" title="@I18n.T("Save and Schedule Operation (Ctrl+S / Ctrl+Enter)")">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="width:12px; height:12px; margin-right:4px;"></span>
                            <span>@I18n.T("Saving...")</span>
                        }
                        else
                        {
                            <span>@(editor.ID == 0 ? "✓ " + I18n.T("Book Operation", "অপারেশন শিডিউল করুন") : "✓ " + I18n.T("Update Schedule", "শিডিউল আপডেট করুন"))</span>
                        }
                    </button>
                </div>
            </div>
        </div>

        <!-- Right Column: OT Queue & Historical Register -->
        <div class="ot-card">
            <div class="ot-card-header">
                <h2>
                    <span>📋 @I18n.T("OT Schedule Register", "ওটি শিডিউল রেজিস্টার")</span>
                </h2>
                <span class="badge" style="background:#e0f2fe; color:#0369a1; font-weight:800; font-size:11px;">
                    @(filteredOperations.Count) @I18n.T("Cases")
                </span>
            </div>

            <div style="padding:10px 12px; background:#f8fafc; border-bottom:1px solid #e2e8f0; display:flex; flex-direction:column; gap:8px;">
                <!-- Search input -->
                <div style="position:relative; width:100%;">
                    <input class="classic-input"
                           style="height:30px !important; padding-left:28px !important;"
                           @bind="listSearchQuery"
                           @bind:event="oninput"
                           placeholder="@I18n.T("Search by Patient, Reg #, Surgeon, Procedure...")" />
                    <span style="position:absolute; left:9px; top:50%; transform:translateY(-50%); color:#94a3b8; pointer-events:none; font-size:12px;">🔍</span>
                    @if (!string.IsNullOrWhiteSpace(listSearchQuery))
                    {
                        <button type="button" style="position:absolute; right:8px; top:50%; transform:translateY(-50%); background:none; border:none; color:#94a3b8; cursor:pointer;" @onclick='() => listSearchQuery = ""'>✕</button>
                    }
                </div>

                <!-- Date & Status Filter Buttons -->
                <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:6px;">
                    <div style="display:flex; gap:4px;">
                        <button type="button" class="btn btn-sm @(dateFilterMode == "today" ? "btn-primary" : "btn-ghost")" style="font-size:10.5px; padding:2px 8px; height:24px;" @onclick='() => SetDateFilter("today")'>
                            @I18n.T("Today")
                        </button>
                        <button type="button" class="btn btn-sm @(dateFilterMode == "week" ? "btn-primary" : "btn-ghost")" style="font-size:10.5px; padding:2px 8px; height:24px;" @onclick='() => SetDateFilter("week")'>
                            @I18n.T("7 Days")
                        </button>
                        <button type="button" class="btn btn-sm @(dateFilterMode == "month" ? "btn-primary" : "btn-ghost")" style="font-size:10.5px; padding:2px 8px; height:24px;" @onclick='() => SetDateFilter("month")'>
                            @I18n.T("Month")
                        </button>
                        <button type="button" class="btn btn-sm @(dateFilterMode == "all" ? "btn-primary" : "btn-ghost")" style="font-size:10.5px; padding:2px 8px; height:24px;" @onclick='() => SetDateFilter("all")'>
                            @I18n.T("All")
                        </button>
                    </div>

                    <select class="classic-input" style="height:24px !important; min-height:24px !important; font-size:10.5px !important; width:auto; padding:0 6px !important;" @bind="statusFilter">
                        <option value="">@I18n.T("All Statuses")</option>
                        <option value="Scheduled">Scheduled</option>
                        <option value="In-Progress">In-Progress</option>
                        <option value="Completed">Completed</option>
                        <option value="Postponed">Postponed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
            </div>

            <!-- List of Operations with Instant Workflow Actions -->
            <div style="max-height: 540px; overflow-y: auto;">
                @if (!filteredOperations.Any())
                {
                    <div style="padding:32px 16px; text-align:center; color:#64748b; font-size:12px;">
                        @I18n.T("No operation bookings found matching the selected filter.")
                    </div>
                }
                else
                {
                    @foreach (var item in filteredOperations)
                    {
                        var isSel = editor.ID == item.ID;
                        var pName = patientNames.GetValueOrDefault(item.PatientID, "—");
                        <div class="ot-item-row @(isSel ? "selected" : "")" @onclick="() => SelectOperation(item)">
                            <div style="display:flex; justify-content:space-between; align-items:center;">
                                <div style="font-size:12px; font-weight:800; color:#0f172a;">
                                    <span>#@item.ID &bull; @item.ProcedureName</span>
                                </div>
                                <span class="ot-status-badge @GetStatusClass(item.Status)">
                                    @item.Status
                                </span>
                            </div>

                            <div style="font-size:11px; color:#334155; margin-top:3px; display:flex; justify-content:space-between;">
                                <span>👤 @pName (Reg: #@item.RegNo &bull; PID: @item.PatientID)</span>
                                <span style="font-weight:700; color:#0284c7;">🏛️ @(string.IsNullOrWhiteSpace(item.TheatreRoom) ? "Main OT" : item.TheatreRoom)</span>
                            </div>

                            <div style="font-size:10.5px; color:#64748b; margin-top:2px; display:flex; justify-content:space-between; align-items:center;">
                                <span>👨‍⚕️ @DoctorName(item.OperatorID)</span>
                                <span>📅 @item.OperationDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                            </div>

                            <!-- Flow Action Buttons -->
                            <div style="margin-top:6px; display:flex; justify-content:flex-end; gap:6px;" @onclick:stopPropagation>
                                <a href="/medical/ot-notes?opId=@item.ID" class="btn btn-secondary btn-sm" style="font-size:10.5px; padding:1px 7px; height:22px; text-decoration:none;" title="@I18n.T("Write Surgeon's Post-Op Note")">
                                    📝 @I18n.T("OT Note →")
                                </a>
                                <a href="/ot-cash-memos?patientId=@item.PatientID" class="btn btn-secondary btn-sm" style="font-size:10.5px; padding:1px 7px; height:22px; text-decoration:none;" title="@I18n.T("Issue OT Cash Memo / Billing")">
                                    💳 @I18n.T("OT Bill →")
                                </a>
                                <button type="button" class="btn btn-ghost btn-sm" style="font-size:10.5px; padding:1px 7px; height:22px;" @onclick="() => PrintSpecificSlipAsync(item)" title="@I18n.T("Print OT Slip")">
                                    🖨️
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

