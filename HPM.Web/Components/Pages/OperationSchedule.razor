     5. Printable Daily OT Register Sheet (A4)
     ========================================================================= -->
<div id="ot-register-print" style="display:none;">
    <PrintDocumentHeader Title="DAILY OPERATION THEATRE (OT) REGISTER"
                         Subtitle="@($"Theatre Schedule & Roster on {DateTime.Today:dd MMMM yyyy}")"
                         DocNo="@($"OT-REG-{DateTime.Today:yyyyMMdd}")" />

    <table style="width:100%; border-collapse:collapse; margin-top:12px; font-size:11px;" border="1" cellpadding="5">
        <thead>
            <tr style="background:#f1f5f9;">
                <th style="width:30px;">#</th>
                <th>Patient Name & ID</th>
                <th>Procedure Name</th>
                <th>Time & Suite</th>
                <th>Surgeon</th>
                <th>Anaesthesia</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @{ var rSl = 1; }
            @foreach (var op in filteredOperations)
            {
                var pName = patientNames.GetValueOrDefault(op.PatientID, "—");
                <tr>
                    <td>@(rSl++)</td>
                    <td><b>@pName</b><br /><small>PID: #@op.PatientID &bull; Reg: #@op.RegNo</small></td>
                    <td><b>@op.ProcedureName</b></td>
                    <td>@op.OperationDate.ToString("hh:mm tt")<br /><small>@op.TheatreRoom</small></td>
                    <td>@DoctorName(op.OperatorID)</td>
