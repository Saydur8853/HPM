<div class="doctor-skeleton" aria-label="Loading clinical workspace" aria-busy="true">
    <section class="doctor-skeleton-kpis">
        @for (var index = 0; index < 5; index++)
        {
            <article><i></i><div><span></span><b></b><small></small></div></article>
        }
    </section>
    <section class="doctor-skeleton-grid">
        @for (var panel = 0; panel < 4; panel++)
        {
            <article>
                <header><div><span></span><b></b></div><i></i></header>
                @for (var row = 0; row < 4; row++)
                {
                    <div class="doctor-skeleton-row"><i></i><span><b></b><small></small></span><em></em></div>
                }
            </article>
        }
    </section>
</div>
