    <table style="width: 100%; border-collapse: collapse; font-size: 9px; margin-top: 6px;" border="1" cellpadding="3">
        <thead>
            <tr style="background: #f1f5f9;">
                <th>Ward / Bed Category</th>
                <th style="text-align: right;">Beds</th>
                <th style="text-align: right;">Occ.</th>
                <th style="text-align: right;">Avail.</th>
                <th style="text-align: right;">Rate</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var w in wardOccupancyRows)
