    <div style="margin-top: 8px; padding: 5px 8px; background: #f8fafc; border: 1px solid #cbd5e1; display: flex; justify-content: space-between; font-size: 10px; font-weight: 800;">
        <span>Diagnostics Tests: @diagnosticTestsCount | New Reg: @newRegistrationsCount</span>
        <span>Total MIS Turnover: ৳@totalMisRevenue.ToString("N0")</span>
    </div>

    <div style="display: flex; justify-content: space-between; margin-top: 24px; font-size: 9px;">
        <div style="border-top: 1px solid #94a3b8; width: 100px; text-align: center; padding-top: 3px;">MIS Officer</div>
        <div style="border-top: 1px solid #94a3b8; width: 110px; text-align: center; padding-top: 3px;">Medical Supt.</div>
        <div style="border-top: 1px solid #94a3b8; width: 100px; text-align: center; padding-top: 3px;">Director</div>
