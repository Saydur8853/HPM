    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 5px; margin: 8px 0;">
        <div style="border: 1px solid #cbd5e1; padding: 4px; border-radius: 3px; text-align: center;">
            <div style="font-size: 8px; font-weight: 800; color: #64748b;">OUTPATIENTS</div>
            <div style="font-size: 12px; font-weight: 900;">@(opdTicketsCount + appointmentsCount)</div>
