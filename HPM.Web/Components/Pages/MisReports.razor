<!-- =========================================================================
     6C. Printable 80mm Thermal POS MIS Summary Slip
     ========================================================================= -->
<div id="mis-report-print-80mm" class="pos-receipt-80mm" style="display: none;">
    <div style="text-align: center; border-bottom: 1px dashed #000; padding-bottom: 4px; margin-bottom: 6px;">
        <div style="font-size: 13px; font-weight: 900;">HOSPITAL MIS SUMMARY</div>
        <div style="font-size: 10px;">@fromDate.ToString("dd/MM/yyyy") - @toDate.ToString("dd/MM/yyyy")</div>
    </div>

    <div style="font-size: 10.5px; line-height: 1.5;">
        <div style="display: flex; justify-content: space-between;"><span>OPD Consultations:</span><b>@(opdTicketsCount + appointmentsCount)</b></div>
        <div style="display: flex; justify-content: space-between;"><span>Emergency Cases:</span><b>@emergencyCasesCount</b></div>
        <div style="display: flex; justify-content: space-between;"><span>IPD Admissions:</span><b>@ipdAdmissionsCount</b></div>
        <div style="display: flex; justify-content: space-between;"><span>IPD Discharges:</span><b>@ipdDischargesCount</b></div>
        <div style="display: flex; justify-content: space-between;"><span>Active Inpatients:</span><b>@currentlyAdmittedCount</b></div>
        <div style="display: flex; justify-content: space-between;"><span>Bed Occupancy:</span><b>@occupiedBedsCount / @totalHospitalBeds (@currentBedOccupancyRate.ToString("F0")%)</b></div>
        <div style="display: flex; justify-content: space-between;"><span>Diagnostic Tests:</span><b>@diagnosticTestsCount</b></div>
        <div style="display: flex; justify-content: space-between;"><span>OT Surgeries:</span><b>@otSurgeriesCount</b></div>
        <div style="display: flex; justify-content: space-between;"><span>New Registrations:</span><b>@newRegistrationsCount (M:@malePatientsCount F:@femalePatientsCount)</b></div>
    </div>

    <div style="border-top: 1px dashed #000; margin-top: 6px; padding-top: 4px; font-size: 11px; font-weight: 900; display: flex; justify-content: space-between;">
        <span>MIS TURNOVER:</span>
        <span>৳@totalMisRevenue.ToString("N0")</span>
    </div>

    <div style="text-align: center; font-size: 9px; margin-top: 10px; border-top: 1px dashed #000; padding-top: 4px;">
        Printed: @DateTime.Now.ToString("dd MMM yyyy hh:mm tt")
    </div>
</div>

@code {
    private DateTime fromDate = DateTime.Today;
    private DateTime toDate = DateTime.Today;
    private string currentPreset = "today";
    private string activeViewTab = "All";
    private string opdSubTab = "dept";
    private bool isLoading = false;

    // Filter search strings
    private string wardFilter = "";
    private string opdFilter = "";
    private string districtFilter = "";
    private string testFilter = "";

    // Executive Metrics
    private int opdTicketsCount;
    private int appointmentsCount;
    private int emergencyCasesCount;
    private int ipdAdmissionsCount;
    private int ipdDischargesCount;
    private int currentlyAdmittedCount;
    private int totalHospitalBeds;
    private int occupiedBedsCount;
    private double currentBedOccupancyRate;
    private double averageLengthOfStayDays;
    private int diagnosticTestsCount;
    private int otSurgeriesCount;

    // Financial Throughput
    private decimal opdRevenue;
    private decimal diagnosticRevenue;
    private decimal emergencyRevenue;
    private decimal ipdRevenue;
    private decimal otRevenue;
    private decimal totalMisRevenue;

    // Demographics
    private int newRegistrationsCount;
    private int malePatientsCount;
    private int femalePatientsCount;
    private int otherPatientsCount;

    // Structured Tables
    private sealed record WardOccupancyRow(string CategoryName, int TotalBeds, int OccupiedBeds, int AvailableBeds, double OccupancyRate);
    private List<WardOccupancyRow> wardOccupancyRows = [];

    private sealed record DeptConsultationRow(string DepartmentName, int TicketsCount, int ApptsCount, int TotalVisits);
    private List<DeptConsultationRow> departmentConsultationRows = [];

    private sealed record DoctorConsultationRow(int DoctorID, string DoctorName, string? Title, string DepartmentName, int TicketsCount, int ApptsCount, int TotalConsultations);
    private List<DoctorConsultationRow> doctorConsultationRows = [];

    private sealed record DistrictRow(string District, int Count);
    private List<DistrictRow> districtRows = [];

    private sealed record TopTestRow(string TestName, int Count);
    private List<TopTestRow> topTestRows = [];

    // Filtered lists
    private IEnumerable<WardOccupancyRow> FilteredWardOccupancy =>
        string.IsNullOrWhiteSpace(wardFilter)
            ? wardOccupancyRows
            : wardOccupancyRows.Where(x => x.CategoryName.Contains(wardFilter, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<DeptConsultationRow> FilteredDepartmentRows =>
        string.IsNullOrWhiteSpace(opdFilter)
            ? departmentConsultationRows
            : departmentConsultationRows.Where(x => x.DepartmentName.Contains(opdFilter, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<DoctorConsultationRow> FilteredDoctorRows =>
        string.IsNullOrWhiteSpace(opdFilter)
            ? doctorConsultationRows
            : doctorConsultationRows.Where(x => x.DoctorName.Contains(opdFilter, StringComparison.OrdinalIgnoreCase) || x.DepartmentName.Contains(opdFilter, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<DistrictRow> FilteredDistrictRows =>
        string.IsNullOrWhiteSpace(districtFilter)
            ? districtRows
            : districtRows.Where(x => x.District.Contains(districtFilter, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<TopTestRow> FilteredTopTests =>
        string.IsNullOrWhiteSpace(testFilter)
            ? topTestRows
            : topTestRows.Where(x => x.TestName.Contains(testFilter, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        await LoadAsync();
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    private void SetToday()
    {
        currentPreset = "today";
        fromDate = DateTime.Today;
        toDate = DateTime.Today;
        _ = LoadAsync();
    }

    private void SetYesterday()
    {
        currentPreset = "yesterday";
        fromDate = DateTime.Today.AddDays(-1);
        toDate = DateTime.Today.AddDays(-1);
        _ = LoadAsync();
    }

    private void SetLast7Days()
    {
        currentPreset = "7days";
        fromDate = DateTime.Today.AddDays(-6);
        toDate = DateTime.Today;
        _ = LoadAsync();
    }

    private void SetThisMonth()
    {
        currentPreset = "month";
        fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        toDate = DateTime.Today;
        _ = LoadAsync();
    }

    private void SetThisYear()
    {
        currentPreset = "year";
        fromDate = new DateTime(DateTime.Today.Year, 1, 1);
        toDate = DateTime.Today;
        _ = LoadAsync();
    }

    private void OnFromDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            fromDate = dt;
            currentPreset = "custom";
        }
    }

    private void OnToDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            toDate = dt;
            currentPreset = "custom";
        }
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);

        var start = fromDate.Date;
        var end = toDate.Date.AddDays(1);

        await using var db = await DbFactory.CreateDbContextAsync();

        // 1. OPD & Appointments
        var ticketsInPeriod = await db.OPDTickets.AsNoTracking()
            .Where(x => x.TransDate >= start && x.TransDate < end)
            .ToListAsync();
        opdTicketsCount = ticketsInPeriod.Count;
        opdRevenue = ticketsInPeriod.Sum(x => x.Total);

        var apptsInPeriod = await db.DoctorAppointments.AsNoTracking()
            .Where(x => x.ApptDate >= start && x.ApptDate < end)
            .ToListAsync();
        appointmentsCount = apptsInPeriod.Count;

        emergencyCasesCount = await db.EmergencyMemos.AsNoTracking()
            .CountAsync(x => x.TransDate >= start && x.TransDate < end && x.ModuleID == 11);

        emergencyRevenue = await db.EmergencyMemos.AsNoTracking()
            .Where(x => x.TransDate >= start && x.TransDate < end && x.ModuleID == 11)
            .SumAsync(x => (decimal?)x.Paid) ?? 0;

        otSurgeriesCount = await db.OTCashMemos.AsNoTracking()
            .CountAsync(x => x.TransDate >= start && x.TransDate < end);

        otRevenue = await db.OTCashMemos.AsNoTracking()
            .Where(x => x.TransDate >= start && x.TransDate < end)
            .SumAsync(x => (decimal?)(x.Total - x.Discount)) ?? 0;

        // 2. IPD Metrics
        ipdAdmissionsCount = await db.PatientAdmissions.AsNoTracking()
            .CountAsync(x => x.AdmissionDate >= start && x.AdmissionDate < end);

        var discharges = await db.PatientAdmissions.AsNoTracking()
            .Where(x => x.ReleaseDate >= start && x.ReleaseDate < end)
            .ToListAsync();

        ipdDischargesCount = discharges.Count;

        currentlyAdmittedCount = await db.PatientAdmissions.AsNoTracking()
            .CountAsync(x => x.IsAdmitted == true);

        ipdRevenue = await db.IpdMoneyReceipts.AsNoTracking()
            .Where(x => x.TransDate >= start && x.TransDate < end)
            .SumAsync(x => (decimal?)x.Amount) ?? 0;

        // Average Length of Stay (ALOS)
        if (discharges.Count > 0)
        {
            var stays = discharges.Select(d => Math.Max(1.0, (d.ReleaseDate!.Value - (d.AdmissionDate ?? d.TransDate ?? d.ReleaseDate.Value)).TotalDays));
            averageLengthOfStayDays = stays.Average();
        }
        else
        {
            averageLengthOfStayDays = 1.0;
        }

        // Bed Occupancy
        var allBeds = await db.BedCabins.AsNoTracking().ToListAsync();
        var bedCategories = await db.BedCategories.AsNoTracking().ToListAsync();
        totalHospitalBeds = allBeds.Count;
        occupiedBedsCount = allBeds.Count(x => x.Status == "Occupied");
        currentBedOccupancyRate = totalHospitalBeds > 0 ? (occupiedBedsCount * 100.0 / totalHospitalBeds) : 0;

        wardOccupancyRows = bedCategories.Select(cat =>
        {
            var bedsInCat = allBeds.Where(b => b.CategoryID == cat.ID).ToList();
            var total = bedsInCat.Count;
            var occ = bedsInCat.Count(b => b.Status == "Occupied");
            var avail = bedsInCat.Count(b => b.Status == "Available");
            var rate = total > 0 ? (occ * 100.0 / total) : 0;
            return new WardOccupancyRow(cat.Name, total, occ, avail, rate);
        }).OrderByDescending(x => x.TotalBeds).ToList();

        // 3. Department & Doctor Consultations
        var departments = await db.Departments.AsNoTracking().ToListAsync();
        var doctors = await db.Doctors.AsNoTracking().ToListAsync();
        var docDeptIdMap = doctors.ToDictionary(x => x.ID, x => x.Department ?? 0);
        var deptNameMap = departments.ToDictionary(x => x.ID, x => x.Name ?? "Clinical");

        departmentConsultationRows = departments.Select(dept =>
        {
            var tCount = ticketsInPeriod.Count(t => t.DeptID == dept.ID);
            var aCount = apptsInPeriod.Count(a => docDeptIdMap.TryGetValue(a.DoctorID, out var dId) && dId == dept.ID);
            return new DeptConsultationRow(dept.Name ?? "Clinical", tCount, aCount, tCount + aCount);
        }).Where(x => x.TotalVisits > 0).OrderByDescending(x => x.TotalVisits).ToList();

        doctorConsultationRows = doctors.Select(doc =>
        {
            var tCount = ticketsInPeriod.Count(t => t.DoctorID == doc.ID);
            var aCount = apptsInPeriod.Count(a => a.DoctorID == doc.ID);
            var dName = doc.Department.HasValue && deptNameMap.TryGetValue(doc.Department.Value, out var dn) ? dn : "Clinical";
            return new DoctorConsultationRow(doc.ID, doc.Name ?? $"Doctor #{doc.ID}", doc.Title, dName, tCount, aCount, tCount + aCount);
        }).Where(x => x.TotalConsultations > 0).OrderByDescending(x => x.TotalConsultations).ToList();

        // 4. Patient Demographics & Registrations
        var registrations = await db.Registrations.AsNoTracking()
            .Where(x => x.TransDate >= start && x.TransDate < end)
            .ToListAsync();

        newRegistrationsCount = registrations.Count;
        malePatientsCount = registrations.Count(x => string.Equals(x.Sex, "Male", StringComparison.OrdinalIgnoreCase));
        femalePatientsCount = registrations.Count(x => string.Equals(x.Sex, "Female", StringComparison.OrdinalIgnoreCase));
        otherPatientsCount = newRegistrationsCount - (malePatientsCount + femalePatientsCount);

        districtRows = registrations
            .Where(x => !string.IsNullOrWhiteSpace(x.PresentDistrict) || !string.IsNullOrWhiteSpace(x.PermanentDistrict))
            .GroupBy(x => !string.IsNullOrWhiteSpace(x.PresentDistrict) ? x.PresentDistrict! : x.PermanentDistrict!)
            .Select(g => new DistrictRow(g.Key, g.Count()))
            .OrderByDescending(x => x.Count)
            .Take(12)
            .ToList();

        // 5. Diagnostic Tests & Investigations
        var memoItems = await db.EmergencyMemoItems.AsNoTracking()
            .Where(x => x.Memo != null && x.Memo.TransDate >= start && x.Memo.TransDate < end && x.Memo.ModuleID != 11)
            .ToListAsync();

        diagnosticTestsCount = memoItems.Sum(x => x.Quantity);

        diagnosticRevenue = await db.EmergencyMemos.AsNoTracking()
            .Where(x => x.TransDate >= start && x.TransDate < end && x.ModuleID != 11)
            .SumAsync(x => (decimal?)x.Paid) ?? 0;

        totalMisRevenue = opdRevenue + diagnosticRevenue + emergencyRevenue + ipdRevenue + otRevenue;

        var services = await db.Services.AsNoTracking().ToListAsync();
        var serviceMap = services.ToDictionary(x => x.ID, x => x.Name ?? $"Test #{x.ID}");

        topTestRows = memoItems
            .GroupBy(x => x.TestID)
            .Select(g => new TopTestRow(serviceMap.TryGetValue(g.Key, out var name) ? name : $"Test #{g.Key}", g.Sum(x => x.Quantity)))
            .OrderByDescending(x => x.Count)
            .Take(15)
            .ToList();

        isLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task PrintReportFormatAsync(string format)
    {
        var elementId = format switch
        {
            "A5" => "mis-report-print-a5",
            "80mm" => "mis-report-print-80mm",
            _ => "mis-report-print"
        };
        await JS.InvokeVoidAsync("hpm.printElement", elementId, $"Hospital MIS Report ({format}) - {fromDate:yyyy-MM-dd} to {toDate:yyyy-MM-dd}");
    }

    private async Task ExportCsvAsync()
    {
        try
        {
            var sb = new StringBuilder();
            sb.AppendLine($"Hospital Management Information System (MIS) Report");
            sb.AppendLine($"Period,{fromDate:yyyy-MM-dd} to {toDate:yyyy-MM-dd}");
            sb.AppendLine($"Generated,{DateTime.Now:yyyy-MM-dd HH:mm:ss}");
            sb.AppendLine();

            sb.AppendLine("1. EXECUTIVE METRICS SUMMARY");
            sb.AppendLine($"Total Outpatients,{opdTicketsCount + appointmentsCount}");
            sb.AppendLine($"OPD Tickets,{opdTicketsCount}");
            sb.AppendLine($"Doctor Appointments,{appointmentsCount}");
            sb.AppendLine($"Emergency Cases,{emergencyCasesCount}");
            sb.AppendLine($"IPD Admissions,{ipdAdmissionsCount}");
            sb.AppendLine($"IPD Discharges,{ipdDischargesCount}");
            sb.AppendLine($"Active Inpatients,{currentlyAdmittedCount}");
            sb.AppendLine($"Total Beds,{totalHospitalBeds}");
            sb.AppendLine($"Occupied Beds,{occupiedBedsCount}");
            sb.AppendLine($"Bed Occupancy Rate,{currentBedOccupancyRate:F1}%");
            sb.AppendLine($"Average Length of Stay (ALOS),{averageLengthOfStayDays:F1} Days");
            sb.AppendLine($"Diagnostic Tests Conducted,{diagnosticTestsCount}");
            sb.AppendLine($"OT Surgeries,{otSurgeriesCount}");
            sb.AppendLine($"New Registrations,{newRegistrationsCount}");
            sb.AppendLine($"Male Patients,{malePatientsCount}");
            sb.AppendLine($"Female Patients,{femalePatientsCount}");
            sb.AppendLine($"Total Period Revenue,{totalMisRevenue:F2}");
            sb.AppendLine();

            sb.AppendLine("2. WARD OCCUPANCY BREAKDOWN");
            sb.AppendLine("Ward / Category,Total Beds,Occupied,Available,Occupancy %");
            foreach (var w in wardOccupancyRows)
            {
                sb.AppendLine($"\"{EscapeCsv(w.CategoryName)}\",{w.TotalBeds},{w.OccupiedBeds},{w.AvailableBeds},{w.OccupancyRate:F1}%");
            }
            sb.AppendLine();

            sb.AppendLine("3. OUTPATIENT CONSULTATIONS BY DEPARTMENT");
            sb.AppendLine("Department,Tickets,Appointments,Total Visits");
            foreach (var d in departmentConsultationRows)
            {
                sb.AppendLine($"\"{EscapeCsv(d.DepartmentName)}\",{d.TicketsCount},{d.ApptsCount},{d.TotalVisits}");
            }
            sb.AppendLine();

            sb.AppendLine("4. DOCTOR CONSULTATION PERFORMANCE");
            sb.AppendLine("Doctor Name,Department,Tickets,Appointments,Total Consultations");
            foreach (var doc in doctorConsultationRows)
            {
                sb.AppendLine($"\"{EscapeCsv(doc.DoctorName)}\",\"{EscapeCsv(doc.DepartmentName)}\",{doc.TicketsCount},{doc.ApptsCount},{doc.TotalConsultations}");
            }
            sb.AppendLine();

            sb.AppendLine("5. TOP DIAGNOSTIC INVESTIGATIONS");
            sb.AppendLine("Rank,Test Name,Tests Conducted");
            var sl = 1;
            foreach (var t in topTestRows)
            {
                sb.AppendLine($"{sl++},\"{EscapeCsv(t.TestName)}\",{t.Count}");
            }
            sb.AppendLine();

            sb.AppendLine("6. PATIENT DEMOGRAPHICS BY DISTRICT");
            sb.AppendLine("District,Patient Count");
            foreach (var dst in districtRows)
            {
                sb.AppendLine($"\"{EscapeCsv(dst.District)}\",{dst.Count}");
            }

            var bytes = Encoding.UTF8.GetBytes(sb.ToString());
            var base64 = Convert.ToBase64String(bytes);
            var filename = $"Hospital_MIS_Report_{fromDate:yyyyMMdd}_{toDate:yyyyMMdd}.csv";
            await JS.InvokeVoidAsync("hpm.downloadFile", filename, "text/csv;charset=utf-8", base64);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Export failed: {ex.Message}");
        }
    }

    private static string EscapeCsv(string? val) => (val ?? string.Empty).Replace("\"", "\"\"");

    public void Dispose()
    {
        I18n.OnLanguageChanged -= HandleLanguageChanged;
    }
}
