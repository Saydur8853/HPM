    private void AddItem()
    {
        if (selectedTestId <= 0 && !string.IsNullOrWhiteSpace(testSearchQuery))
        {
            var match = availableServices.FirstOrDefault(s => string.Equals(s.Name, testSearchQuery.Trim(), StringComparison.OrdinalIgnoreCase))
                     ?? FilteredTests.FirstOrDefault();
            if (match != null)
            {
                selectedTestId = match.ID;
                if (itemRate <= 0) itemRate = match.SaleRate ?? 0;
            }
        }

        if (selectedTestId <= 0 || itemRate < 0 || itemQty <= 0) return;
        var s = availableServices.FirstOrDefault(x => x.ID == selectedTestId);
        if (s == null) return;

        editor.Items.Add(new CashMemoSubDInvestigation
        {
            SLNo = editor.Items.Count + 1,
            TestID = s.ID,
            Rate = itemRate,
            Quantity = itemQty
        });

        selectedTestId = 0;
        testSearchQuery = string.Empty;
        showTestSuggestions = false;
        highlightedTestIndex = 0;
        itemRate = 0;
        itemQty = 1;
        RecalculateTotals();
    }

    private void RemoveItem(int index)
    {
        if (index >= 0 && index < editor.Items.Count)
        {
            editor.Items.RemoveAt(index);
            for (var i = 0; i < editor.Items.Count; i++) editor.Items[i].SLNo = i + 1;
            RecalculateTotals();
        }
    }

    private void ClearAllItems()
    {
        editor.Items.Clear();
        RecalculateTotals();
    }

    private void RecalculateTotals()
    {
        grossTotal = editor.Items.Sum(x => x.Rate * x.Quantity);
        editor.Total = grossTotal;
        if (isIpdMode)
        {
            editor.Discount = 0;
            editor.DiscountBy = null;
            editor.Paid = 0;
            discountPercent = 0;
            fixedDiscountAmount = 0;
        }
        else
        {
            var percentageDiscount = Math.Round(grossTotal * (discountPercent / 100m), 2, MidpointRounding.AwayFromZero);
            editor.Discount = Math.Round(percentageDiscount + fixedDiscountAmount, 2, MidpointRounding.AwayFromZero);
            if (editor.Discount <= 0) editor.DiscountBy = null;
        }
        netPayable = Math.Max(0, grossTotal - editor.Discount);
        if (!isIpdMode)
            editor.Paid = paidManuallyEdited ? Math.Min(Math.Max(0, editor.Paid), netPayable) : netPayable;
    }

    private void HandleDiscountPercentChange(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var p))
        {
            discountPercent = Math.Clamp(p, 0, 100);
        }
        else
        {
            discountPercent = 0;
        }
        RecalculateTotals();
    }

    private void OnFixedDiscountAmountChanged()
    {
        fixedDiscountAmount = Math.Max(0, fixedDiscountAmount);
        RecalculateTotals();
    }

    private void PaidChanged() => paidManuallyEdited = true;

    private async Task<bool> SaveBillAsync(bool printAfterSave)
    {
        var saved = await ExecuteSaveAsync();
        if (saved && printAfterSave && editor.ID > 0)
        {
            await InvokeAsync(StateHasChanged);
            await Task.Delay(100);
            await PrintAsync();
        }
        return saved;
    }

    private async Task SaveAsync() => await SaveBillAsync(false);

    private async Task<bool> ExecuteSaveAsync()
    {
        if (string.IsNullOrWhiteSpace(editor.PatientName) || editor.Items.Count == 0)
        {
            Fail(I18n.IsBangla ? "রোগীর নাম এবং অন্তত একটি টেস্ট যোগ করুন।" : "Patient name and at least one test are required.");
            return false;
        }
        if (isIpdMode && string.IsNullOrWhiteSpace(editor.RegNo))
        {
            Fail(I18n.IsBangla ? "একটি সক্রিয় আইপিডি ভর্তি লোড করুন।" : "Load an active IPD admission first.");
            return false;
        }
        RecalculateTotals();
        var calculatedTotal = grossTotal;
        editor.PatientType = currentPatientType;
        if (isIpdMode)
        {
            editor.Discount = 0;
            editor.DiscountBy = null;
            editor.Paid = 0;
        }
        if (editor.Items.Any(x => x.Rate < 0 || x.Quantity <= 0)) { Fail(I18n.IsBangla ? "দর বা পরিমাণ সঠিক নয়।" : "Test rate cannot be negative and quantity must be greater than zero."); return false; }
        if (editor.Discount < 0 || editor.Discount > calculatedTotal) { Fail(I18n.IsBangla ? "ছাড় মোট বিলের মধ্যে হতে হবে।" : "Discount must be between zero and the gross total."); return false; }
        if (editor.Discount > 0 && !authorizers.Any(x => string.Equals(x.DisplayName, editor.DiscountBy, StringComparison.OrdinalIgnoreCase)))
        {
            Fail(I18n.IsBangla ? "ছাড়ের জন্য একজন সক্রিয় Authorizer নির্বাচন করুন।" : "Select an active Authorizer user for the discount.");
            return false;
        }
        if ((editor.DiscountBy?.Trim().Length ?? 0) > 50) { Fail(I18n.IsBangla ? "অনুমোদনকারীর নাম ৫০ অক্ষরের বেশি হতে পারবে না।" : "Discount authorization cannot exceed 50 characters."); return false; }
        var revenueAmount = calculatedTotal - editor.Discount;
        if (editor.Paid < 0 || editor.Paid > revenueAmount) { Fail(I18n.IsBangla ? "পরিশোধিত টাকা সর্বমোট বিলের মধ্যে হতে হবে।" : "Paid amount must be between zero and the net bill amount."); return false; }

        saving = true;
        try
        {
            var userId = await CurrentUserIdAsync();
            editor.Total = calculatedTotal;
            grossTotal = calculatedTotal;
            netPayable = revenueAmount;
            editor.DiscountBy = string.IsNullOrWhiteSpace(editor.DiscountBy) ? null : editor.DiscountBy.Trim();
            editor.ModuleID = 2; // Diagnostic Module

            long savedMemoId = 0;
            await using var strategyDb = await DbFactory.CreateDbContextAsync();
            var strategy = strategyDb.Database.CreateExecutionStrategy();
            await strategy.ExecuteAsync(async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                await using var tx = await db.Database.BeginTransactionAsync();

                PatientAdmission? ipdAdmission = null;
                if (isIpdMode)
                {
                    ipdAdmission = await db.PatientAdmissions.SingleOrDefaultAsync(x => x.RegNo == editor.RegNo);
                    if (ipdAdmission?.IsAdmitted != true)
                        throw new InvalidOperationException("The selected IPD admission is no longer active.");
                }

                DiagnosticOrder? diagnosticOrder = null;
                if (activeOrderId.HasValue)
                {
                    diagnosticOrder = await db.DiagnosticOrders.Include(x => x.Items).SingleAsync(x => x.ID == activeOrderId.Value);
                    var updatingItsBill = diagnosticOrder.Status == "Billed" && diagnosticOrder.BilledMemoID == editor.ID && editor.ID > 0;
                    if (diagnosticOrder.Status != "Pending" && !updatingItsBill) throw new InvalidOperationException("This diagnostic order has already been billed or cancelled.");
                    var ordered = diagnosticOrder.Items.Select(x => x.ServiceID).OrderBy(x => x).ToArray();
                    var billed = editor.Items.Select(x => x.TestID).Distinct().OrderBy(x => x).ToArray();
                    if (!ordered.SequenceEqual(billed)) throw new InvalidOperationException("Doctor-ordered tests cannot be added or removed at the billing counter.");
                    editor.EncounterID = diagnosticOrder.EncounterID;
                }

                if (editor.ID == 0)
                {
                    editor.EnteredBy = userId;
                    db.EmergencyMemos.Add(editor);
                    await db.SaveChangesAsync();

                    foreach (var item in editor.Items.GroupBy(x => x.TestID).Select(x => x.First()))
                    {
                        db.LabSampleCollections.Add(new LabSampleCollection
                        {
                            MemoID = editor.ID,
                            ServiceID = item.TestID,
                            SpecimenType = "Blood / Specimen",
                            Status = "Pending"
                        });
                    }
                    await db.SaveChangesAsync();
                }
                else
                {
                    var existing = await db.EmergencyMemos.Include(x => x.Items).FirstOrDefaultAsync(x => x.ID == editor.ID);
                    if (existing == null) throw new InvalidOperationException("Memo not found.");
                    if (await db.DiagnosticCashMemoReturns.AnyAsync(x => x.MemoID == existing.ID))
                        throw new InvalidOperationException("A memo with posted returns cannot be edited.");
                    db.Entry(existing).CurrentValues.SetValues(editor);
                    db.EmergencyMemoItems.RemoveRange(existing.Items);
                    foreach (var item in editor.Items)
                    {
                        item.MemoID = existing.ID;
                        db.EmergencyMemoItems.Add(item);
                    }

                    var orderedServiceIds = editor.Items.Select(x => x.TestID).Distinct().ToHashSet();
                    var samples = await db.LabSampleCollections.Where(x => x.MemoID == existing.ID).ToListAsync();
                    db.LabSampleCollections.RemoveRange(samples.Where(x => !orderedServiceIds.Contains(x.ServiceID)));
                    foreach (var serviceId in orderedServiceIds.Where(serviceId => samples.All(x => x.ServiceID != serviceId)))
                        db.LabSampleCollections.Add(new LabSampleCollection { MemoID = existing.ID, ServiceID = serviceId, SpecimenType = "Blood / Specimen", Status = "Pending" });

                    var removedResults = await db.LabTestResults.Where(x => x.MemoID == existing.ID && !orderedServiceIds.Contains(x.ServiceID)).ToListAsync();
                    db.LabTestResults.RemoveRange(removedResults);
                    await db.SaveChangesAsync();
                }

                if (ipdAdmission is not null)
                {
                    var marker = $"[DIAGNOSTIC:{editor.ID}:";
                    var oldIpdLines = await db.IpdPatientServiceItems
                        .Where(x => x.RegNo == editor.RegNo && x.Remarks != null && x.Remarks.StartsWith(marker))
                        .ToListAsync();
                    db.IpdPatientServiceItems.RemoveRange(oldIpdLines);
                    foreach (var item in editor.Items)
                    {
                        db.IpdPatientServiceItems.Add(new IpdPatientServiceItem
                        {
                            RegNo = editor.RegNo!,
                            PatientID = editor.PatientID,
                            ServiceID = item.TestID,
                            ServiceName = ServiceName(item.TestID),
                            Rate = item.Rate,
                            Quantity = item.Quantity,
                            Total = item.Rate * item.Quantity,
                            DoctorID = editor.DoctorID,
                            ServiceDate = editor.TransDate,
                            EnteredBy = userId,
                            Remarks = $"{marker}{item.ID}]"
                        });
                    }
                }

                await OperationalAccounting.SyncSplitRevenueAsync(db, $"DIAGNOSTIC:{editor.ID}", editor.ID,
                    revenueAmount, editor.Paid, editor.TransDate, userId, $"Diagnostic memo #{editor.ID}", isIpdMode ? null : 12);
                await db.SaveChangesAsync();

                if (diagnosticOrder is not null && diagnosticOrder.Status == "Pending")
                {
                    diagnosticOrder.Status = "Billed";
                    diagnosticOrder.BilledMemoID = editor.ID;
                    await db.SaveChangesAsync();
                }

                await tx.CommitAsync();
                savedMemoId = editor.ID;
            });

            Success(I18n.IsBangla ? $"ডায়াগনস্টিক মেমো #{savedMemoId} সফলভাবে সংরক্ষিত হয়েছে।" : $"Diagnostic memo #{savedMemoId} saved successfully.");
            var enteredDiscountPercent = discountPercent;
            var enteredFixedDiscountAmount = fixedDiscountAmount;
            await LoadAsync();
            var saved = recentMemos.FirstOrDefault(m => m.ID == savedMemoId) ?? editor;
            await SelectAsync(saved);
            discountPercent = enteredDiscountPercent;
            fixedDiscountAmount = enteredFixedDiscountAmount;
            RecalculateTotals();
            return true;
        }
        catch (Exception ex)
        {
            Fail(I18n.IsBangla ? $"মেমো সংরক্ষণ করা যায়নি: {ex.GetBaseException().Message}" : $"Could not save memo: {ex.GetBaseException().Message}");
            return false;
        }
        finally
        {
            saving = false;
        }
    }

    private void PayDueInFull()
    {
        editor.Paid = netPayable;
        paidManuallyEdited = true;
        authorizeReleaseWithDue = false;
        if (!string.IsNullOrWhiteSpace(editor.Remarks))
        {
            editor.Remarks = editor.Remarks.Replace("[AUTH_RELEASE]", "").Trim();
        }
    }

    private void OnAuthorizeReleaseChanged()
    {
        if (authorizeReleaseWithDue)
        {
            if (string.IsNullOrWhiteSpace(editor.Remarks) || !editor.Remarks.Contains("[AUTH_RELEASE]"))
            {
                editor.Remarks = string.IsNullOrWhiteSpace(editor.Remarks) ? "[AUTH_RELEASE]" : $"{editor.Remarks.Trim()} [AUTH_RELEASE]";
            }
        }
        else
        {
            if (!string.IsNullOrWhiteSpace(editor.Remarks))
            {
                editor.Remarks = editor.Remarks.Replace("[AUTH_RELEASE]", "").Trim();
            }
        }
    }

    private async Task SelectAsync(CashMemoDInvestigation m)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var full = await db.EmergencyMemos.Include(x => x.Items).AsNoTracking().FirstOrDefaultAsync(x => x.ID == m.ID);
        if (full != null)
        {
            editor = full;
            activeOrderId = await db.DiagnosticOrders.AsNoTracking().Where(x => x.BilledMemoID == full.ID).Select(x => (long?)x.ID).SingleOrDefaultAsync();
            paidManuallyEdited = true;
            authorizeReleaseWithDue = !string.IsNullOrWhiteSpace(editor.Remarks) && editor.Remarks.Contains("[AUTH_RELEASE]");
            SyncDoctorSearchFromSelection();
            selectedTestId = 0;
            testSearchQuery = string.Empty;
            showTestSuggestions = false;
            highlightedTestIndex = 0;
            discountPercent = 0;
            fixedDiscountAmount = Math.Max(0, full.Discount);
            RecalculateTotals();
            message = "";
        }
    }

    private async Task DeleteMemoAsync(CashMemoDInvestigation m)
    {
        await SelectAsync(m);
        await DeleteAsync();
    }

    private async Task DeleteAsync()
    {
        var confirmMsg = I18n.IsBangla ? $"ডায়াগনস্টিক মেমো #{editor.ID} মুছে ফেলতে চান?" : $"Delete diagnostic memo #{editor.ID}?";
        if (!await JS.InvokeAsync<bool>("hpm.confirm", confirmMsg)) return;
        var reason = await JS.InvokeAsync<string?>("hpm.prompt", I18n.IsBangla ? "এই মেমোটি বাতিলের কারণ:" : "Reason for reversing this diagnostic memo:");
        if (string.IsNullOrWhiteSpace(reason)) return;

        try
        {
            await using var strategyDb = await DbFactory.CreateDbContextAsync();
            var strategy = strategyDb.Database.CreateExecutionStrategy();
            await strategy.ExecuteAsync(async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                await using var tx = await db.Database.BeginTransactionAsync();
                var entity = await db.EmergencyMemos.Include(x => x.Items).FirstOrDefaultAsync(x => x.ID == editor.ID);
                if (entity != null)
                {
                    if (await db.DiagnosticCashMemoReturns.AnyAsync(x => x.MemoID == entity.ID))
                        throw new InvalidOperationException("A memo with posted returns cannot be deleted.");
                    var userId = await CurrentUserIdAsync();
                    await OperationalAccounting.ReverseRevenueAsync(db, "Diagnostic Memo", $"DIAGNOSTIC:{entity.ID}", entity.ID,
                        Math.Max(0, entity.Total - entity.Discount), entity.TransDate, userId, reason,
                        entity.PatientType == "2" ? AccountingPosting.PatientReceivable : AccountingPosting.Cash,
                        entity.PatientType == "2" ? null : 12);
                    if (entity.PatientType == "2" && !string.IsNullOrWhiteSpace(entity.RegNo))
                    {
                        var marker = $"[DIAGNOSTIC:{entity.ID}:";
                        var ipdLines = await db.IpdPatientServiceItems
                            .Where(x => x.RegNo == entity.RegNo && x.Remarks != null && x.Remarks.StartsWith(marker))
                            .ToListAsync();
                        db.IpdPatientServiceItems.RemoveRange(ipdLines);
                    }
                    var samples = await db.LabSampleCollections.Where(x => x.MemoID == entity.ID).ToListAsync();
                    var results = await db.LabTestResults.Where(x => x.MemoID == entity.ID).ToListAsync();
                    var diagnosticOrder = await db.DiagnosticOrders.SingleOrDefaultAsync(x => x.BilledMemoID == entity.ID);
                    if (diagnosticOrder is not null) { diagnosticOrder.BilledMemoID = null; diagnosticOrder.Status = "Pending"; }
                    db.LabSampleCollections.RemoveRange(samples);
                    db.LabTestResults.RemoveRange(results);
                    db.EmergencyMemos.Remove(entity);
                    await db.SaveChangesAsync();
                    await tx.CommitAsync();
                }
            });

            Success(I18n.IsBangla ? "ডায়াগনস্টিক মেমো মুছে ফেলা হয়েছে।" : "Diagnostic memo deleted.");
            Reset();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Fail(ex.GetBaseException().Message);
        }
    }

