@page "/diagnostic/billing"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.Cashier + "," + RoleNames.Reception)]
@rendermode InteractiveServer
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<AppUser> UserManager
@inject IBarcodeQrService BarcodeQr
@inject NavigationManager NavigationManager
@inject PatientSelectionState PatientSelection
@inject ILogger<DiagnosticBilling> Logger
@implements IDisposable
@using System.Security.Claims
@using HPM.Web.Components.Common

<PageTitle>@(isIpdMode ? I18n.T("IPD Cash Memo") : I18n.T("OPD Cash Memo")) | @Branding.HospitalName</PageTitle>

<div class="diagnostic-classic-fit">
    <!-- Unified Top Action & Status Bar -->
    <div class="diagnostic-classic-topbar">
        <div class="tickets-top-left">
            <h1 class="tickets-page-title">
                <span>🔬</span>
                <span>@(editor.ID == 0 ? (isIpdMode ? I18n.T("IPD Investigation Cash Memo") : I18n.T("OPD Investigation Cash Memo")) : $"{I18n.T("Edit Diagnostic Bill")} #B{editor.ID}")</span>
            </h1>
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <span class="tickets-inline-alert @messageClass" @onclick="ShowInlineAlertModal" style="cursor: pointer;" title="@message (Click to view full message)">
                    @(messageClass.Contains("danger") ? "⚠" : "✓") @message
                </span>
            }
        </div>

        <div class="diagnostic-topbar-center">
            <div class="diagnostic-billing-type-picker">
                <span class="diagnostic-billing-type-label">@I18n.T("BILLING TYPE")</span>
                <div class="diagnostic-mode-toggle" role="group" aria-label="@I18n.T("Billing Type")">
                    <button type="button"
                            class="mode-toggle-btn @(!isIpdMode ? "active opd-active" : "")"
                            aria-pressed="@(!isIpdMode)"
                            @onclick='() => SetPatientTypeAsync("1")'
                            title="@I18n.T("Collect payment now as an OPD bill")">
                        <span class="mode-toggle-icon">🏥</span>
                        <span class="mode-toggle-text">
                            <strong>@I18n.T("OPD Billing")</strong>
                            <small>@I18n.T("Pay now")</small>
                        </span>
                    </button>
                    <button type="button"
                            class="mode-toggle-btn @(isIpdMode ? "active ipd-active" : "") @(!canAccessIpd ? "disabled-ipd-mode" : "")"
                            aria-pressed="@(isIpdMode)"
                            disabled="@(!canAccessIpd)"
                            @onclick='async () => { if (canAccessIpd) await SetPatientTypeAsync("2"); }'
                            title="@(canAccessIpd ? I18n.T("Add the charge to the patient's IPD final bill") : (I18n.IsBangla ? "আইপিডি সার্ভিস মডিউল অ্যাক্সেস নিষ্ক্রিয় / নেই" : "IPD Service Module access is disabled"))">
                        <span class="mode-toggle-icon">🛏️</span>
                        <span class="mode-toggle-text">
                            <strong>@I18n.T("IPD Billing")</strong>
                            <small>@(canAccessIpd ? I18n.T("Pay by Final bill") : (I18n.IsBangla ? "নিষ্ক্রিয়" : "Disabled"))</small>
                        </span>
                    </button>
                </div>
            </div>
        </div>

        <div class="tickets-top-actions">
            <button type="button" class="btn btn-secondary tickets-btn btn-recent-bills-modal-btn" @onclick="OpenRecentBillsModal" title="@I18n.T("Open Diagnostic Bills & Doctor Orders Modal")">
                📋 @I18n.T("Diagnostic Bills")
                <span class="tickets-count-badge">@totalModalMemosCount</span>
            </button>
            @if (pendingOrders.Count > 0)
            {
                <button type="button" class="btn btn-secondary tickets-btn doctor-orders-pill-btn" @onclick="OpenDoctorOrdersModal" title="@I18n.T("View Pending Doctor Orders")">
                    ⚡ @pendingOrders.Count @I18n.T("Doctor Order(s)")
                </button>
            }
            <button type="button" class="btn btn-primary tickets-btn" @onclick="Reset" title="@I18n.T("New Diagnostic Bill")">
                + @I18n.T("New Diagnostic Bill")
            </button>
        </div>
    </div>

    <!-- Main Full-Width Workspace (Non-scrollable Viewpoint) -->
    <div class="diagnostic-classic-workspace diagnostic-full-workspace">
        <div class="diagnostic-form-card">

            <EditForm Model="editor" OnSubmit="SaveAsync" class="diagnostic-form-wrapper">
                <DataAnnotationsValidator />

                <div class="diagnostic-form-body diag-billing-two-col">
                    <!-- Left Part: Data Entry & Test Selection (Matches Hand Sketch) -->
                    <div class="diag-entry-col">
                        <!-- Demographics Card -->
                        <div class="diag-section-card">
                            <div class="diag-section-header">
                                <span class="diag-section-title">👤 @I18n.T("Patient Demographics")</span>
                                @if (isIpdMode && !string.IsNullOrWhiteSpace(editor.RegNo))
                                {
                                    <span class="diag-section-sub" style="background:#0f766e; color:#fff; padding:2px 8px; border-radius:10px; font-weight:700;">
                                        🛏️ IPD Reg: @editor.RegNo @(!string.IsNullOrWhiteSpace(editor.Bed) ? $"• Bed: {editor.Bed}" : "")
                                    </span>
                                }
                                else if (!string.IsNullOrWhiteSpace(editor.PatientID))
                                {
                                    <span class="diag-section-sub">PID: @editor.PatientID</span>
                                }
                            </div>
                            <div class="diag-demographics-grid">
                                @if (isIpdMode && !string.IsNullOrWhiteSpace(editor.Bed))
                                {
                                    <div style="grid-column: 1 / -1; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 6px; padding: 4px 10px; display: flex; align-items: center; justify-content: space-between; font-size: 11px; color: #166534; margin-bottom: 2px;">
                                        <span>🛏️ <strong>@I18n.T("Admitted In-Patient (IPD)")</strong> — Reg: <strong>@editor.RegNo</strong> • Bed/Cabin: <strong>@editor.Bed</strong></span>
                                        <span style="font-weight: 700; color: #047857; text-transform: uppercase;">@I18n.T("Charged to IPD Bill")</span>
                                    </div>
                                }

                                <label class="diag-field-pid">
                                    <span>
                                        @I18n.T("PATIENT ID / REG NO", "পেশেন্ট আইডি / রেজি নং")
                                        @if (isIpdMode && !string.IsNullOrWhiteSpace(editor.RegNo))
                                        {
                                            <span style="color:#0f766e; font-size:10px; font-weight:bold; margin-left:4px;">(IPD Reg: @editor.RegNo)</span>
                                        }
                                    </span>
                                    <div class="tickets-patient-search-combo">
                                        <input class="classic-input"
                                               value="@(!string.IsNullOrWhiteSpace(editor.PatientID) ? editor.PatientID : editor.RegNo)"
                                               @oninput="HandlePatientIdInputAsync"
                                               @onfocus="ShowPatientIdSuggestionsAsync"
                                               @onblur="HidePatientSuggestionsAsync"
                                               @onkeydown="HandlePatientIdKeyDown"
                                               autocomplete="off"
                                               placeholder="@I18n.T("Patient ID, IPD Reg No or mobile", "পেশেন্ট আইডি, আইপিডি রেজি বা মোবাইল...")"
                                               title="@I18n.T("Type Patient ID, IPD Reg or Mobile & press Enter to auto-detect OPD/IPD", "পেশেন্ট আইডি, আইপিডি রেজি বা মোবাইল লিখে এন্টার দিন")" />
                                        <button type="button" class="btn-find icon-only" @onclick="LoadPatientAsync" title="@I18n.T("Search & Auto-Detect (Enter)")" aria-label="@I18n.T("Load Patient")"><SearchIcon /></button>
                                    </div>
                                    @if (showPatientIdSuggestions && patientIdSuggestions.Count > 0)
                                    {
                                        <div class="appt-patient-suggestions" id="diag-patient-suggestions-list">
                                            @foreach (var patient in patientIdSuggestions)
                                            {
                                                <button type="button" class="appt-patient-option" @onmousedown:preventDefault @onclick="() => SelectPatientFromSuggestionAsync(patient)">
                                                    <span class="patient-id">@patient.PatientID</span>
                                                    <span class="patient-name">@patient.Name</span>
                                                    <span class="patient-contact">@patient.Contact</span>
                                                </button>
                                            }
                                            @if (hasMorePatientSuggestions)
                                            {
                                                <div class="appt-doctor-scroll-hint" @onclick="LoadMorePatientsFromJs" @onmousedown:preventDefault>
                                                    <span>@I18n.T("Showing") @patientIdSuggestions.Count &bull; @I18n.T("Scroll for more...")</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </label>

                                <label class="diag-field-contact">
                                    <span>@I18n.T("Contact No")</span>
                                    <div class="tickets-patient-search-combo">
                                        <input class="classic-input"
                                               value="@editor.Contact"
                                               @oninput="HandleContactInputAsync"
                                               @onfocus="ShowContactSuggestionsAsync"
                                               @onblur="HideContactSuggestionsAsync"
                                               @onkeydown="HandleContactKeyDown"
                                               autocomplete="off"
                                               placeholder="017xxxxxxxx"
                                               title="@I18n.T("Type mobile & press Enter or click search", "মোবাইল নম্বর লিখে এন্টার বা সার্চ দিন")" />
                                        <button type="button" class="btn-find icon-only" @onclick="LoadPatientByContactAsync" title="@I18n.T("Search by Contact (Enter)")" aria-label="@I18n.T("Search by Contact")"><SearchIcon /></button>
                                    </div>
                                    @if (showContactSuggestions && contactSuggestions.Count > 0)
                                    {
                                        <div class="appt-patient-suggestions" id="diag-contact-suggestions-list">
                                            @foreach (var patient in contactSuggestions)
                                            {
                                                <button type="button" class="appt-patient-option" @onmousedown:preventDefault @onclick="() => SelectPatientFromSuggestionAsync(patient)">
                                                    <span class="patient-id">@patient.PatientID</span>
                                                    <span class="patient-name">@patient.Name</span>
                                                    <span class="patient-contact">@patient.Contact</span>
                                                </button>
                                            }
                                            @if (hasMoreContactSuggestions)
                                            {
                                                <div class="appt-doctor-scroll-hint" @onclick="LoadMoreContactPatientsFromJs" @onmousedown:preventDefault>
                                                    <span>@I18n.T("Showing") @contactSuggestions.Count &bull; @I18n.T("Scroll for more...")</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </label>

                                <label class="diag-field-name">
                                    <span>@I18n.T("Patient Name")<span class="req">*</span></span>
                                    <InputText class="classic-input" @bind-Value="editor.PatientName" placeholder="@I18n.T("Patient Name")" />
                                </label>

                                <label class="diag-field-ref">
                                    <span>@I18n.T("Referred by")</span>
                                    <div class="diag-doctor-combo" role="combobox" aria-expanded="@showDoctorSuggestions" aria-haspopup="listbox">
                                        <input class="classic-input @(editor.DoctorID.HasValue ? "doctor-selected-input" : "")"
                                               value="@doctorSearchQuery"
                                               @oninput="HandleDoctorSearchInput"
                                               @onfocus="ShowDoctorSuggestions"
                                               @onblur="HideDoctorSuggestionsAsync"
                                               placeholder="@I18n.T("Search doctor by name, degree or mobile...")"
                                               autocomplete="off"
                                               aria-autocomplete="list" />
                                        @if (editor.DoctorID.HasValue || !string.IsNullOrWhiteSpace(doctorSearchQuery))
                                        {
                                            <button type="button" class="diag-doctor-clear" tabindex="-1" @onmousedown:preventDefault @onclick="ClearSelectedDoctor" title="@I18n.T("Clear referred doctor")">✕</button>
                                        }
                                        else
                                        {
                                            <span class="diag-doctor-search-icon"><SearchIcon /></span>
                                        }
                                    </div>
                                    @if (showDoctorSuggestions)
                                    {
                                        <div class="diag-doctor-suggestions" id="diag-doctor-suggestions-list" role="listbox">
                                            <button type="button" class="diag-doctor-option walk-in" @onmousedown:preventDefault @onclick="ClearSelectedDoctor">
                                                <span class="doctor-option-main">@I18n.T("Walk-in / None")</span>
                                            </button>
                                            @foreach (var doctor in FilteredDoctors)
                                            {
                                                <button type="button" class="diag-doctor-option @(editor.DoctorID == doctor.ID ? "selected" : "")"
                                                        role="option"
                                                        aria-selected="@(editor.DoctorID == doctor.ID)"
                                                        @onmousedown:preventDefault
                                                        @onclick="() => SelectDoctor(doctor)">
                                                    <span class="doctor-option-main">@DoctorDisplayName(doctor)</span>
                                                    @if (!string.IsNullOrWhiteSpace(doctor.Degree) || !string.IsNullOrWhiteSpace(doctor.Contact))
                                                    {
                                                        <span class="doctor-option-meta">@string.Join(" • ", new[] { doctor.Degree, doctor.Contact }.Where(x => !string.IsNullOrWhiteSpace(x)))</span>
                                                    }
                                                </button>
                                            }
                                            @if (hasMoreDoctorSuggestions)
                                            {
                                                <div class="appt-doctor-scroll-hint" @onclick="LoadMoreDoctorsFromJs" @onmousedown:preventDefault>
                                                    <span>@I18n.T("Showing") @FilteredDoctors.Count &bull; @I18n.T("Scroll for more...")</span>
                                                </div>
                                            }
                                            @if (!FilteredDoctors.Any())
                                            {
                                                <div class="diag-doctor-empty">@I18n.T("No matching doctor found")</div>
                                            }
                                        </div>
                                    }
                                </label>
                            </div>
                        </div>

                        <!-- Test Selection Section (Matches Hand Sketch: Search | Rate | Qty | Add) -->
                        <div class="diag-section-card">
                            <div class="diag-section-header">
                                <span class="diag-section-title">🔬 @I18n.T("SELECT test & investigations")</span>
                            </div>
                            <div class="diag-line-editor">
                                <div class="diagnostic-test-search-field">
                                    <label>
                                        <span>@I18n.T("Search Test by Name or Code")<span class="req">*</span></span>
                                        <div class="diagnostic-test-combo">
                                            <input class="classic-input @(selectedTestId > 0 ? "test-selected-input" : "")"
                                                   value="@testSearchQuery"
                                                   @oninput="HandleTestSearchInput"
                                                   @onfocus="ShowTestSuggestions"
                                                   @onblur="HideTestSuggestions"
                                                   @onkeydown="HandleTestSearchKeyDown"
                                                   placeholder="@I18n.T("Search test by name or ID (e.g. CBC, Creatinine)...")"
                                                   autocomplete="off" />
                                            @if (selectedTestId > 0 || !string.IsNullOrWhiteSpace(testSearchQuery))
                                            {
                                                <button type="button" class="diagnostic-test-clear" tabindex="-1" @onclick="ClearSelectedTest" title="@I18n.T("Clear Test")">✕</button>
                                            }
                                            else
                                            {
                                                <span class="diagnostic-test-search-icon"><SearchIcon /></span>
                                            }
                                        </div>
                                    </label>
                                    @if (showTestSuggestions && FilteredTests.Any())
                                    {
                                        <div class="diagnostic-test-suggestions-dropdown">
                                            <div class="diag-test-sugg-header">
                                                <span>@I18n.T("Matching Tests") (@FilteredTests.Count())</span>
                                                <span class="diag-test-sugg-hint">↑↓ @I18n.T("Navigate") &bull; ↵ @I18n.T("Select")</span>
                                            </div>
                                            <div class="diag-test-sugg-list">
                                                @{
                                                    var list = FilteredTests.ToList();
                                                    for (var i = 0; i < list.Count; i++)
                                                    {
                                                        var s = list[i];
                                                        var isHighlighted = i == highlightedTestIndex;
                                                        var isSelected = s.ID == selectedTestId;
                                                        <div class="diag-test-option @(isHighlighted ? "active" : "") @(isSelected ? "selected" : "")"
                                                             @onmousedown:preventDefault
                                                             @onclick="() => SelectTest(s)">
                                                            <div class="diag-test-main">
                                                                <span class="diag-test-code">#@s.ID</span>
                                                                <span class="diag-test-name">@s.Name</span>
                                                                @if (s.CategoryID.HasValue && serviceCategoryNames.TryGetValue(s.CategoryID.Value, out var catName) && !string.IsNullOrWhiteSpace(catName))
                                                                {
                                                                    <span class="diag-test-cat-badge">@catName</span>
                                                                }
                                                            </div>
                                                            <span class="diag-test-rate">@I18n.FormatCurrency(s.SaleRate ?? 0)</span>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                                <label class="diag-input-rate">
                                    <span>@I18n.T("Rate")</span>
                                    <InputNumber class="classic-input bold-number" @bind-Value="itemRate" @onkeydown="HandleRateQtyKeyDown" />
                                </label>
                                <label class="diag-input-qty">
                                    <span>@I18n.T("Qty")</span>
                                    <InputNumber class="classic-input" @bind-Value="itemQty" @onkeydown="HandleRateQtyKeyDown" />
                                </label>
                                <button class="btn btn-secondary tickets-btn diag-add-test-btn" type="button" @onclick="AddItem" title="@I18n.T("Add Test to Bill")">
                                    + @I18n.T("Add")
                                </button>
                            </div>
                        </div>

                        <!-- Clinical Remarks & Instructions -->
                        <div class="diag-section-card diag-remarks-card">
                            <div class="diag-section-header">
                                <span class="diag-section-title">📝 @I18n.T("Clinical Remarks / Instructions")</span>
                            </div>
                            <label class="diag-remarks-field">
                                <InputTextArea class="classic-input diag-remarks-textarea" @bind-Value="editor.Remarks" placeholder="@I18n.T("Remarks / Clinical notes / Doctor's instructions...")" />
                            </label>
                            @if (isIpdMode)
                            {
                                <div class="alert success" style="margin:4px 0 0; padding:6px 10px; font-size:11px;">@I18n.T("This amount will be posted to the patient's IPD bill.")</div>
                            }
                        </div>
                    </div>

                    <!-- Right Part: Added Test And Investigations List & Billing Calculations (Matches Hand Sketch) -->
                    <div class="diag-preview-col">
                        <div class="diag-preview-card">
                            <!-- Header matching sketch: Added Test And Investigations List: -->
                            <div class="diag-preview-card-header">
                                <div class="diag-preview-title-group">
                                    <span class="diag-preview-title">📋 @I18n.T("Added Test And Investigations List:")</span>
                                    <span class="diag-preview-badge">@editor.Items.Count @(editor.Items.Count == 1 ? I18n.T("Test") : I18n.T("Tests"))</span>
                                </div>
                                @if (editor.Items.Count > 0)
                                {
                                    <button type="button" class="btn-clear-tests" @onclick="ClearAllItems" title="@I18n.T("Clear All Tests")">
                                        ✕ @I18n.T("Clear All")
                                    </button>
                                }
                            </div>

                            <!-- Table matching sketch columns: SL | Test | Rate | Qty | Amount | Disc % | Date/Time | ✕ -->
                            <div class="diag-bill-preview-table-wrap">
                                <div class="diag-preview-table-head">
                                    <span class="pcol-sl">SL</span>
                                    <span class="pcol-name">@I18n.T("Test")</span>
                                    <span class="pcol-rate">@I18n.T("Rate")</span>
                                    <span class="pcol-qty">@I18n.T("Qty")</span>
                                    <span class="pcol-amount">@I18n.T("Amount")</span>
                                    <span class="pcol-del">✕</span>
                                </div>
                                <div class="diag-preview-table-rows">
                                    @if (editor.Items.Count == 0)
                                    {
                                        <div class="diag-preview-empty-state">
                                            <div class="empty-icon">🧪</div>
                                            <strong>@I18n.T("No tests selected yet")</strong>
                                            <span>@I18n.T("Search and add investigations from the left side to calculate bill.")</span>
                                        </div>
                                    }
                                    else
                                    {
                                        @for (var i = 0; i < editor.Items.Count; i++)
                                        {
                                            var idx = i;
                                            var item = editor.Items[idx];
                                            var service = availableServices.FirstOrDefault(s => s.ID == item.TestID);
                                            <div class="diag-preview-table-row">
                                                <span class="pcol-sl">@(idx + 1)</span>
                                                <div class="pcol-name">
                                                    <span class="pcol-test-title">@ServiceName(item.TestID)</span>
                                                    @if (service?.CategoryID is int catId && serviceCategoryNames.TryGetValue(catId, out var catName) && !string.IsNullOrWhiteSpace(catName))
                                                    {
                                                        <span class="diag-test-cat-pill">@catName</span>
                                                    }
                                                </div>
                                                <span class="pcol-rate">@I18n.FormatCurrency(item.Rate)</span>
                                                <span class="pcol-qty">@item.Quantity</span>
                                                <strong class="pcol-amount">@I18n.FormatCurrency(item.Rate * item.Quantity)</strong>
                                                <span class="pcol-del">
                                                    <button type="button" class="diag-item-del-btn" title="@I18n.T("Delete")" @onclick="() => RemoveItem(idx)">✕</button>
                                                </span>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>

                            <!-- Calculations Block matching sketch: Total amount, Disc, Payable, Received, Due -->
                            <div class="diag-totals-summary-box">
                                <div class="diag-totals-row gross-row">
                                    <span class="totals-label">@I18n.T("Total amount"):</span>
                                    <strong class="totals-value gross-val">@I18n.FormatCurrency(grossTotal)</strong>
                                </div>

                                @if (!isIpdMode)
                                {
                                    <div class="diag-totals-row input-row">
                                        <span class="totals-label">@I18n.T("Disc (% + Amount)"):</span>
                                        <div class="totals-dual-input-wrap">
                                            <div class="percent-input-wrap">
                                                <input type="number" step="0.5" min="0" max="100" class="classic-input diag-tot-input"
                                                       value="@discountPercent"
                                                       @onchange="HandleDiscountPercentChange"
                                                       aria-label="@I18n.T("Percentage discount")"
                                                       placeholder="%" />
                                                <span class="unit-symbol">%</span>
                                            </div>
                                            <InputNumber class="classic-input diag-tot-input"
                                                         @bind-Value="fixedDiscountAmount"
                                                         @bind-Value:after="OnFixedDiscountAmountChanged"
                                                         aria-label="@I18n.T("Additional fixed discount amount")"
                                                         placeholder="Tk" />
                                        </div>
                                    </div>

                                    @if (editor.Discount > 0)
                                    {
                                        <div class="diag-totals-row discount-total-row">
                                            <span class="totals-label">@I18n.T("Total Discount"):</span>
                                            <strong class="totals-value">- @I18n.FormatCurrency(editor.Discount)</strong>
                                        </div>
                                        <div class="diag-totals-row input-row">
                                            <span class="totals-label">@I18n.T("Authorized By"):</span>
                                            <div class="totals-input-wrap authorizer-input-wrap">
                                                <InputSelect class="classic-input diag-tot-input tickets-select diag-authorizer-select" @bind-Value="editor.DiscountBy">
                                                    <option value="">@I18n.T("Select authorizer")</option>
                                                    @if (authorizers.Count == 0)
                                                    {
                                                        <option value="" disabled>@I18n.T("No active Authorizer user")</option>
                                                    }
                                                    @foreach (var authorizer in authorizers)
                                                    {
                                                        <option value="@authorizer.DisplayName">@authorizer.DisplayName</option>
                                                    }
                                                </InputSelect>
                                            </div>
                                        </div>
                                    }

                                    <div class="diag-totals-row net-payable-row">
                                        <span class="totals-label">@I18n.T("Payable"):</span>
                                        <strong class="totals-value net-val">@I18n.FormatCurrency(netPayable)</strong>
                                    </div>

                                    <div class="diag-totals-row input-row">
                                        <span class="totals-label">@I18n.T("Received"):</span>
                                        <div class="totals-input-wrap">
                                            <InputNumber class="classic-input diag-tot-input" @bind-Value="editor.Paid" @bind-Value:after="PaidChanged" />
                                        </div>
                                    </div>

                                    @if (netPayable - editor.Paid > 0)
                                    {
                                        <div class="diag-due-alert-card">
                                            <div class="diag-due-top-row">
                                                <div class="diag-due-summary">
                                                    <span class="diag-due-icon" aria-hidden="true">!</span>
                                                    <div>
                                                        <span class="due-warning-text">@I18n.T("Balance Due")</span>
                                                        <strong class="diag-due-amount">@I18n.FormatCurrency(netPayable - editor.Paid)</strong>
                                                    </div>
                                                </div>
                                                <div class="diag-due-actions">
                                                    <label class="diag-due-release-chk" title="@I18n.T("Special authorization only; this is not required to save a due invoice.")">
                                                        <InputCheckbox @bind-Value="authorizeReleaseWithDue" @bind-Value:after="OnAuthorizeReleaseChanged" />
                                                        <span>@I18n.T("Release report with due")</span>
                                                    </label>
                                                    <button type="button" class="btn-quick-full-pay" @onclick="PayDueInFull" title="@I18n.T("Set Paid Amount to Net Payable")">
                                                        ✓ @(editor.ID > 0 ? I18n.T("Mark Due Paid") : I18n.T("Mark Fully Paid"))
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="diag-totals-row due-row zero-due">
                                            <span class="totals-label">@I18n.T("Due"):</span>
                                            <strong class="totals-value due-val">@I18n.FormatCurrency(0)</strong>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="diag-totals-row">
                                        <span class="totals-label">@I18n.T("Charge To IPD"):</span>
                                        <strong>@editor.RegNo</strong>
                                    </div>
                                    <div class="diag-totals-row net-payable-row">
                                        <span class="totals-label">@I18n.T("Total Charged"):</span>
                                        <strong class="totals-value net-val">@I18n.FormatCurrency(netPayable)</strong>
                                    </div>
                                }
                            </div>

                            <!-- Footer Actions within the preview card -->
                            <div class="diag-preview-footer-actions">
                                <button class="btn btn-primary diag-submit-btn diag-btn-print" type="button" @onclick="() => SaveBillAsync(true)" disabled="@saving" title="@I18n.T("Save bill and immediately print invoice")">
                                    🖨 @(saving
                                        ? I18n.T("Saving & Printing…")
                                        : isIpdMode ? (editor.ID == 0 ? I18n.T("Post & Print Memo") : I18n.T("Update & Print Memo")) : (editor.ID == 0 ? I18n.T("Save & Print Receipt") : I18n.T("Update & Print Receipt")))
                                </button>

                                <div class="diag-sub-actions">
                                    @if (editor.ID > 0)
                                    {
                                        <button class="btn btn-ghost tickets-btn" type="button" @onclick="DeleteAsync" style="color: #dc2626;" title="@I18n.T("Delete Bill")">
                                            🗑 @I18n.T("Delete")
                                        </button>
                                    }
                                    <button class="btn btn-ghost tickets-btn diag-btn-clear" type="button" @onclick="Reset" title="@I18n.T("Clear Form")">
                                        ✕ @I18n.T("Clear")
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
</div>

<!-- ==========================================================================
     Alert & Error Popup Message Box Dialog
     ========================================================================== -->
@if (showAlertModal)
{
    <div class="diag-modal-backdrop" @onclick="CloseAlertModal" style="z-index: 2000;">
        <div class="diag-alert-modal-dialog" @onclick:stopPropagation="true">
            <div class="diag-alert-modal-header @(alertModalType == "danger" ? "header-danger" : alertModalType == "warning" ? "header-warning" : "header-success")">
                <div class="diag-alert-title-wrap">
                    <span class="diag-alert-icon">
                        @(alertModalType == "danger" ? "🚨" : alertModalType == "warning" ? "⚠️" : "✅")
                    </span>
                    <h3 class="diag-alert-title">@alertModalTitle</h3>
                </div>
                <button type="button" class="diag-alert-close-btn" @onclick="CloseAlertModal" title="Close">✕</button>
            </div>
            <div class="diag-alert-modal-body">
                <p class="diag-alert-message">@alertModalMessage</p>
                @if (!string.IsNullOrWhiteSpace(alertModalDetails))
                {
                    <div class="diag-alert-technical-details">
                        <div class="diag-alert-tech-head">@I18n.T("Technical Info / ত্রুটির বিবরণ"):</div>
                        <code>@alertModalDetails</code>
                    </div>
                }
            </div>
            <div class="diag-alert-modal-footer">
                <button type="button" class="btn btn-primary diag-alert-action-btn" @onclick="CloseAlertModal">
                    @(I18n.IsBangla ? "ঠিক আছে" : "OK")
                </button>
            </div>
        </div>
    </div>
}

<!-- ==========================================================================
     Diagnostic Bills & Doctor Orders Pop-up Modal Dialog
     ========================================================================== -->
@if (showRecentBillsModal)
{
    <div class="diag-modal-backdrop" @onclick="CloseRecentBillsModal">
        <div class="diag-modal-dialog" @onclick:stopPropagation="true">
            <div class="diag-modal-header">
                <div class="diag-modal-title-group">
                    <span class="diag-modal-icon">📋</span>
                    <div>
                        <h3 class="diag-modal-title">@I18n.T("Diagnostic Bills & Doctor Orders")</h3>
                        <span class="diag-modal-subtitle">@I18n.T("Search, filter previous and recent bills by Bill ID, Patient ID, Date range, or Status")</span>
                    </div>
                </div>
                <button type="button" class="diag-modal-close-btn" @onclick="CloseRecentBillsModal" title="@I18n.T("Close")">✕</button>
            </div>

            <div class="diag-modal-toolbar">
                <div class="diag-modal-search-box">
                    <span class="search-icon"><SearchIcon /></span>
                    <input type="text"
                           class="classic-input diag-modal-search-input"
                           placeholder="@I18n.T("Search by Bill #, Patient Name, Patient ID, Mobile or Reg #...")"
                           value="@modalSearchQuery"
                           @oninput="HandleModalSearchInput"
                           @onkeydown="HandleModalScanKeyDown"
                           autofocus />
                    @if (!string.IsNullOrWhiteSpace(modalSearchQuery))
                    {
                        <button type="button" class="search-clear-btn" @onclick="ClearModalSearchAsync">✕</button>
                    }
                </div>

                <div class="diag-modal-tabs">
                    <button type="button" class="diag-modal-tab @(modalTab == "all" ? "active" : "")" @onclick='() => OnModalTabChanged("all")'>
                        🔬 @I18n.T("All Bills")
                    </button>
                    <button type="button" class="diag-modal-tab @(modalTab == "due" ? "active" : "")" @onclick='() => OnModalTabChanged("due")'>
                        ⚠️ @I18n.T("With Due")
                    </button>
                    <button type="button" class="diag-modal-tab @(modalTab == "paid" ? "active" : "")" @onclick='() => OnModalTabChanged("paid")'>
                        ✓ @I18n.T("Paid")
                    </button>
                    @if (pendingOrders.Count > 0)
                    {
                        <button type="button" class="diag-modal-tab doctor-orders-tab @(modalTab == "orders" ? "active" : "")" @onclick='() => OnModalTabChanged("orders")'>
                            ⚡ @I18n.T("Doctor Orders") (@pendingOrders.Count)
                        </button>
                    }
                </div>
            </div>

            <div class="diag-modal-filter-bar">
                <div class="diag-modal-date-group">
                    <span>📅 @I18n.T("From"):</span>
                    <input type="date" class="classic-input diag-modal-date-input" value="@modalDateFrom?.ToString("yyyy-MM-dd")" @onchange="OnModalDateFromChanged" />
                    <span>@I18n.T("To"):</span>
                    <input type="date" class="classic-input diag-modal-date-input" value="@modalDateTo?.ToString("yyyy-MM-dd")" @onchange="OnModalDateToChanged" />
                </div>

                <div class="diag-modal-presets">
                    <button type="button" class="diag-date-chip @(IsPresetActive("all") ? "active" : "")" @onclick='() => SetDatePreset("all")'>@I18n.T("All Time")</button>
                    <button type="button" class="diag-date-chip @(IsPresetActive("today") ? "active" : "")" @onclick='() => SetDatePreset("today")'>@I18n.T("Today")</button>
                    <button type="button" class="diag-date-chip @(IsPresetActive("last7") ? "active" : "")" @onclick='() => SetDatePreset("last7")'>@I18n.T("Last 7 Days")</button>
                    <button type="button" class="diag-date-chip @(IsPresetActive("month") ? "active" : "")" @onclick='() => SetDatePreset("month")'>@I18n.T("This Month")</button>
                </div>

                <div class="diag-modal-type-group">
                    <select class="classic-select diag-modal-select" value="@modalPatientType" @onchange="OnModalPatientTypeChanged">
                        <option value="all">@I18n.T("All Types (OPD & IPD)")</option>
                        <option value="1">@I18n.T("OPD Bills Only")</option>
                        <option value="2">@I18n.T("IPD Bills Only")</option>
                    </select>
                </div>

                <button type="button" class="btn btn-secondary tickets-btn diag-modal-reset-btn" @onclick="ResetModalFiltersAsync" title="@I18n.T("Reset filters")">
                    🔄 @I18n.T("Reset")
                </button>
            </div>

            <div class="diag-modal-body">
                @if (modalTab == "orders")
                {
                    var orders = FilteredModalOrders.ToList();
                    @if (orders.Count == 0)
                    {
                        <div class="diag-modal-empty">
                            <span class="empty-icon">⚡</span>
                            <h4>@I18n.T("No pending doctor orders.")</h4>
                        </div>
                    }
                    else
                    {
                        <div class="diag-modal-orders-grid">
                            @foreach (var order in orders)
                            {
                                <div class="diag-modal-order-card @(activeOrderId == order.ID ? "active" : "")" @onclick="() => LoadOrderFromModalAsync(order.ID)">
                                    <div class="order-card-header">
                                        <span class="badge" style="background:#fef3c7; color:#b45309; font-weight:800;">#@order.ID</span>
                                        <strong>@order.PatientName</strong>
                                        @if (!string.IsNullOrWhiteSpace(order.PatientID))
                                        {
                                            <span class="pid-badge">@order.PatientID</span>
                                        }
                                    </div>
                                    <div class="order-card-meta">
                                        <span>👨‍⚕️ @DoctorName(order.DoctorID)</span>
                                        <span>🧪 @order.Items.Count @I18n.T("test(s)")</span>
                                        <span>🕒 @order.OrderedAt.ToString("dd MMM hh:mm tt")</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(order.ClinicalNotes))
                                    {
                                        <div class="order-card-notes">@order.ClinicalNotes</div>
                                    }
                                    <div class="order-card-footer">
                                        <button type="button" class="btn btn-primary tickets-btn" style="width:100%; font-size:11.5px; padding:4px 10px;">
                                            ⚡ @I18n.T("Create Bill from Order")
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    @if (isModalLoading && modalMemos.Count == 0)
                    {
                        <div class="diag-modal-loading">
                            <span>⏳</span>
                            <span>@I18n.T("Loading diagnostic bills...")</span>
                        </div>
                    }
                    else if (modalMemos.Count == 0)
                    {
                        <div class="diag-modal-empty">
                            <span class="empty-icon">🔬</span>
                            <h4>@I18n.T("No matching diagnostic bills found.")</h4>
                            <p>@I18n.T("Try a different search term, date range or clear the filters.")</p>
                        </div>
                    }
                    else
                    {
                        <div class="diag-modal-table-wrap">
                            <table class="diag-modal-table">
                                <thead>
                                    <tr>
                                        <th style="width:75px;">@I18n.T("Memo #")</th>
                                        <th>@I18n.T("Patient Name & ID")</th>
                                        <th>@I18n.T("Contact")</th>
                                        <th>@I18n.T("Date & Time")</th>
                                        <th>@I18n.T("Doctor")</th>
                                        <th class="text-right">@I18n.T("Total Bill")</th>
                                        <th class="text-center">@I18n.T("Payment Status")</th>
                                        <th class="text-center" style="width:130px;">@I18n.T("Actions")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var m in modalMemos)
                                    {
                                        var isSelected = editor.ID == m.ID;
                                        var net = Math.Max(0, m.Total - m.Discount);
                                        var due = Math.Max(0, net - m.Paid);
                                        <tr class="@(isSelected ? "selected-row" : "")">
                                            <td>
                                                <button type="button" class="btn-memo-link" @onclick="() => SelectFromModalAsync(m)">
                                                    #B@(m.ID)
                                                </button>
                                            </td>
                                            <td>
                                                <div class="modal-patient-info" @onclick="() => SelectFromModalAsync(m)">
                                                    <strong class="patient-name">@m.PatientName</strong>
                                                    @if (!string.IsNullOrWhiteSpace(m.PatientID))
                                                    {
                                                        <span class="patient-id-sub">(@m.PatientID)</span>
                                                    }
                                                    <span class="patient-meta-sub">@m.Age / @m.Sex</span>
                                                </div>
                                            </td>
                                            <td>@(string.IsNullOrWhiteSpace(m.Contact) ? "—" : m.Contact)</td>
                                            <td>
                                                <span class="modal-date-text">@m.TransDate.ToString("dd MMM yyyy")</span>
                                                <span class="modal-time-text">@m.TransDate.ToString("hh:mm tt")</span>
                                            </td>
                                            <td>@DoctorName(m.DoctorID)</td>
                                            <td class="text-right font-bold">
                                                @I18n.FormatCurrency(net)
                                                @if (m.Discount > 0)
                                                {
                                                    <div class="disc-sub-badge">Disc: @I18n.FormatCurrency(m.Discount)</div>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (m.PatientType == "2")
                                                {
                                                    <span class="badge" style="background:#e0e7ff; color:#3730a3;">IPD: @m.RegNo</span>
                                                }
                                                else if (due <= 0)
                                                {
                                                    <span class="badge" style="background:#dcfce7; color:#15803d; font-weight:800;">✓ @I18n.T("Paid")</span>
                                                }
                                                else
                                                {
                                                    <span class="badge" style="background:#fee2e2; color:#b91c1c; font-weight:800;">Due: @I18n.FormatCurrency(due)</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="diag-modal-row-actions">
                                                    <button type="button" class="btn-action-sm select" title="@I18n.T("Load Bill")" @onclick="() => SelectFromModalAsync(m)">
                                                        ✏️ @I18n.T("Load")
                                                    </button>
                                                    <button type="button" class="btn-action-sm print" title="@I18n.T("Print Invoice")" @onclick="() => PrintSelectedMemo(m)">
                                                        🖨️
                                                    </button>
                                                    <button type="button" class="btn-action-sm delete" title="@I18n.T("Delete Bill")" @onclick="() => DeleteMemoFromModalAsync(m)">
                                                        ✕
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>

            <div class="diag-modal-footer">
                <span class="diag-modal-footer-count">
                    @if (modalTab == "orders")
                    {
                        <span>@I18n.T("Total Orders"): <strong>@FilteredModalOrders.Count()</strong></span>
                    }
                    else
                    {
                        <span>@I18n.T("Showing"): <strong>@modalMemos.Count</strong> @I18n.T("of") <strong>@totalModalMemosCount</strong> @I18n.T("diagnostic bills")</span>
                    }
                </span>

                <div style="display:flex; align-items:center; gap:10px;">
                    @if (modalTab != "orders" && totalModalMemosCount > modalMemos.Count)
                    {
                        <button type="button" class="btn btn-primary tickets-btn" style="height:32px; font-size:12px; padding:3px 14px;" @onclick="LoadMoreModalMemosAsync" disabled="@isModalLoading">
                            @if (isModalLoading)
                            {
                                <span>⏳ @I18n.T("Loading...")</span>
                            }
                            else
                            {
                                <span>⏬ @I18n.T("Load More Previous Bills") (@Math.Min(30, totalModalMemosCount - modalMemos.Count))</span>
                            }
                        </button>
                    }
                    <button type="button" class="btn btn-secondary tickets-btn" @onclick="CloseRecentBillsModal">
                        @I18n.T("Close")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (editor.ID > 0)
{
    <!-- Print Layout Switcher & Action Toolbar -->
    <div class="diag-print-toolbar no-print">
        <div class="diag-print-layout-toggle">
            <span class="toggle-lbl">🖨️ @I18n.T("Print Size"):</span>
            <button type="button" class="btn btn-sm @(printLayout == "A5" ? "btn-primary active" : "btn-secondary")" @onclick='() => printLayout = "A5"' title="@I18n.T("Delta Hospital style compact Half-A4 / A5 receipt")">
                📄 A5 Half Page (Delta Style)
            </button>
            <button type="button" class="btn btn-sm @(printLayout == "A4" ? "btn-primary active" : "btn-secondary")" @onclick='() => printLayout = "A4"' title="@I18n.T("Full page A4 invoice")">
                📑 A4 Full Page
            </button>
        </div>
        <div class="diag-print-actions">
            <button type="button" class="btn btn-primary" @onclick="PrintAsync" title="@I18n.T("Print or Download PDF")">
                🖨️ @I18n.T("Print / Download Bill")
            </button>
        </div>
    </div>

    @if (printLayout == "A5")
    {
        <!-- Delta Hospital Style Compact A5 (Half-A4) Cash Memo -->
        <div id="diagnostic-print" class="a5-memo-sheet panel print-document">
            <!-- Header -->
            <div class="a5-header">
                <div class="a5-brand-block">
                    @if (!string.IsNullOrWhiteSpace(Branding.LogoData))
                    {
                        <img src="@Branding.LogoData" alt="Logo" class="a5-brand-logo" />
                    }
                    else
                    {
                        <div class="a5-logo-placeholder">🏥</div>
                    }
                    <div class="a5-brand-text">
                        <h2 class="a5-hosp-name">@Branding.HospitalName</h2>
                        <div class="a5-hosp-address">
                            @Branding.Address@(string.IsNullOrWhiteSpace(Branding.CityDistrict) ? "" : $", {Branding.CityDistrict}")
                            @if (!string.IsNullOrWhiteSpace(Branding.Hotline) || !string.IsNullOrWhiteSpace(Branding.Phone))
                            {
                                <span> Hotline: @(string.IsNullOrWhiteSpace(Branding.Hotline) ? Branding.Phone : Branding.Hotline)</span>
                            }
                        </div>
                    </div>
                </div>
                
            </div>

            <!-- Bill No & Barcode Row -->
            <div class="a5-bill-meta-row">
                <div class="a5-bill-no-date">
                    <span class="a5-meta-label">Bill No. :</span>
                    <strong class="a5-meta-val">B@(editor.ID.ToString("D8"))</strong>
                    <span class="a5-meta-sep">&nbsp;&bull;&nbsp;</span>
                    <span class="a5-meta-label">Date :</span>
                    <span class="a5-meta-val">@editor.TransDate.ToString("dd/MM/yy hh:mm tt")</span>
                </div>
                <div class="a5-bill-barcode">
                    <BarcodeQrView Code="@(!string.IsNullOrWhiteSpace(editor.PatientID) ? editor.PatientID : $"P{editor.ID}")" ShowBarcode="true" ShowQr="false" Layout="barcode-only" BarHeight="26" IncludeBarcodeText="false" />
                </div>
            </div>

            <!-- Patient Information Grid -->
            <div class="a5-patient-info-box">
                <div class="a5-patient-info-left">
                    <div class="a5-pinfo-row">
                        <div class="a5-pinfo-col a5-col-full">
                            <span class="a5-lbl">Name</span>
                            <span class="a5-colon">:</span>
                            <strong class="a5-val a5-patient-name">@editor.PatientName.ToUpper()</strong>
                        </div>
                    </div>
                    <div class="a5-pinfo-row">
                        <div class="a5-pinfo-col" style="flex: 1.2;">
                            <span class="a5-lbl">Age</span>
                            <span class="a5-colon">:</span>
                            <span class="a5-val">@(string.IsNullOrWhiteSpace(editor.Age) ? "—" : editor.Age)</span>
                        </div>
                        <div class="a5-pinfo-col" style="flex: 1.2;">
                            <span class="a5-lbl">Gender</span>
                            <span class="a5-colon">:</span>
                            <span class="a5-val">@(string.IsNullOrWhiteSpace(editor.Sex) ? "—" : editor.Sex)</span>
                        </div>
                        <div class="a5-pinfo-col" style="flex: 1.8;">
                            <span class="a5-lbl">Contact No</span>
                            <span class="a5-colon">:</span>
                            <span class="a5-val">@(string.IsNullOrWhiteSpace(editor.Contact) ? "—" : editor.Contact)</span>
                        </div>
                    </div>
                    <div class="a5-pinfo-row">
                        <div class="a5-pinfo-col a5-col-full">
                            <span class="a5-lbl">Ref By</span>
                            <span class="a5-colon">:</span>
                            <span class="a5-val">@DoctorFormatted(editor.DoctorID)</span>
                        </div>
                    </div>
                    <div class="a5-pinfo-row">
                        <div class="a5-pinfo-col a5-col-full">
                            <span class="a5-lbl">Hos/Clinic</span>
                            <span class="a5-colon">:</span>
                            <span class="a5-val">@(editor.PatientType == "2" ? $"In-Patient (IPD) • Reg: {editor.RegNo} • Bed: {editor.Bed}" : "Out-Patient (OPD) / Self")</span>
                        </div>
                    </div>
                    <div class="a5-pinfo-row">
                        <div class="a5-pinfo-col a5-col-full">
                            <span class="a5-lbl">Patient ID</span>
                            <span class="a5-colon">:</span>
                            <strong class="a5-val">@(string.IsNullOrWhiteSpace(editor.PatientID) ? "Walk-in" : editor.PatientID)</strong>
                        </div>
                    </div>
                </div>
                <div class="a5-patient-info-right-qr">
                    <BarcodeQrView Code="@($"LAB-{editor.ID}")"
                                   QrPayload="@BarcodeQr.GenerateLabQrPayload(editor.ID, editor.PatientID ?? "", editor.PatientName, $"SMP-{editor.ID}", NavigationManager.BaseUri)"
                                   ShowBarcode="false"
                                   ShowQr="true"
                                   Layout="qr-only"
                                   QrPixelsPerModule="3" />
                </div>
            </div>

            <!-- Investigation Items Table -->
            <table class="a5-items-table">
                <thead>
                    <tr>
                        <th style="width: 12%;">Code</th>
                        <th style="width: 44%;">Test Name</th>
                        <th style="width: 26%;">Expected Delivery Date</th>
                        <th style="width: 6%; text-align: center;">Qty</th>
                        <th style="width: 12%; text-align: right;">Price (Tk.)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in editor.Items)
                    {
                        <tr>
                            <td class="a5-cell-code">H@(item.TestID.ToString("D4"))</td>
                            <td class="a5-cell-name">@ServiceName(item.TestID)</td>
                            <td class="a5-cell-delivery">@GetExpectedDelivery(editor.TransDate, item.TestID)</td>
                            <td class="a5-cell-qty" style="text-align: center;">@item.Quantity</td>
                            <td class="a5-cell-price" style="text-align: right;">@((item.Rate * item.Quantity).ToString("N2"))</td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Remarks & Test ID Row -->
            <div class="a5-remarks-test-id-row">
                <div class="a5-remarks-line">
                    <span class="a5-lbl">Remarks :</span>
                    <span class="a5-val">@(string.IsNullOrWhiteSpace(editor.Remarks) ? "N/A" : editor.Remarks)</span>
                </div>
                <div class="a5-testid-line">
                    <span class="a5-lbl">Test ID :</span>
                    <span class="a5-val a5-test-codes">
                        @string.Join(" ", editor.Items.Select(x => $"{editor.TransDate:yy}-{editor.ID:D4}-{x.SLNo}"))
                    </span>
                </div>
            </div>

            <!-- Financial Summary & Payment Breakdown Split -->
            <div class="a5-financial-split">
                <!-- Left: Stamp, In Words, Mini Payment Table, Prepared By -->
                <div class="a5-fin-left">
                    <div class="a5-stamp-box">
                        @if (netPayable - editor.Paid <= 0)
                        {
                            <div class="a5-stamp a5-stamp-paid">PAID</div>
                        }
                        else
                        {
                            <div class="a5-stamp a5-stamp-due">DUE: @I18n.FormatCurrency(netPayable - editor.Paid)</div>
                        }
                    </div>

                    <div class="a5-in-word">
                        In Word: @CurrencyWordsHelper.ToTakaWords(editor.Paid > 0 ? editor.Paid : netPayable)
                    </div>

                    <table class="a5-mini-pay-table">
                        <thead>
                            <tr>
                                <th>Payment Type</th>
                                <th>Coll. By</th>
                                <th>Auth. By</th>
                                <th>Date</th>
                                <th>Mode</th>
                                <th style="text-align: right;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (editor.Discount > 0)
                            {
                                <tr>
                                    <td>Initial Discount</td>
                                    <td>@GetCashierName()</td>
                                    <td>@(string.IsNullOrWhiteSpace(editor.DiscountBy) ? "—" : editor.DiscountBy)</td>
                                    <td>@editor.TransDate.ToString("dd/MM/yy")</td>
                                    <td>Discount</td>
                                    <td style="text-align: right;">@editor.Discount.ToString("N2")</td>
                                </tr>
                            }
                            <tr>
                                <td>Initial Collection</td>
                                <td>@GetCashierName()</td>
                                <td>—</td>
                                <td>@editor.TransDate.ToString("dd/MM/yy")</td>
                                <td>Cash</td>
                                <td style="text-align: right;">@editor.Paid.ToString("N2")</td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="a5-prepared-by">
                        Prepared By : <strong>@GetCashierName()</strong>
                    </div>
                </div>

                <!-- Right: Financial Totals Box -->
                <div class="a5-fin-right">
                    <div class="a5-financial-summary">
                        <div class="a5-fin-row">
                            <span>Item Total Tk.</span>
                            <span class="a5-colon">:</span>
                            <span class="a5-fin-val">@grossTotal.ToString("N2")</span>
                        </div>
                        @if (editor.Discount > 0)
                        {
                            <div class="a5-fin-row">
                                <span>(-)Discount Tk.</span>
                                <span class="a5-colon">:</span>
                                <span class="a5-fin-val">@editor.Discount.ToString("N2")</span>
                            </div>
                        }
                        <div class="a5-fin-row a5-fin-net">
                            <span>Net Payable Tk.</span>
                            <span class="a5-colon">:</span>
                            <span class="a5-fin-val">@netPayable.ToString("N2")</span>
                        </div>
                        <div class="a5-fin-row">
                            <span>Collected Tk.</span>
                            <span class="a5-colon">:</span>
                            <span class="a5-fin-val">@editor.Paid.ToString("N2")</span>
                        </div>
                        <div class="a5-fin-row a5-fin-due">
                            <span>Due Tk.</span>
                            <span class="a5-colon">:</span>
                            <span class="a5-fin-val @(netPayable - editor.Paid > 0 ? "a5-due-text" : "")">
                                @Math.Max(0, netPayable - editor.Paid).ToString("N2")
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer Location Instruction -->
            @if (!string.IsNullOrWhiteSpace(Branding.ReceiptHeaderNote) || (!string.IsNullOrWhiteSpace(Branding.ReceiptFooterNote) && !Branding.ReceiptFooterNote.Contains("Valid without physical signature", StringComparison.OrdinalIgnoreCase)))
            {
                <div class="a5-footer-instruction">
                    @if (!string.IsNullOrWhiteSpace(Branding.ReceiptHeaderNote))
                    {
                        <strong>@Branding.ReceiptHeaderNote</strong>
                    }
                    @if (!string.IsNullOrWhiteSpace(Branding.ReceiptFooterNote) && !Branding.ReceiptFooterNote.Contains("Valid without physical signature", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="a5-footer-sub">@Branding.ReceiptFooterNote</div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <!-- Standard Full A4 Page Invoice -->
        <div id="diagnostic-print" class="print-sheet panel print-document print-a4-sheet">
            <PrintDocumentHeader Title="Official Diagnostic Invoice & Receipt"
                                 Subtitle="@Branding.LabHeaderDept"
                                 DocNo="@($"B{editor.ID}")"
                                 DocNoLabel="Bill No"
                                 BarcodeCode="@(!string.IsNullOrWhiteSpace(editor.PatientID) ? editor.PatientID : $"P{editor.ID}")"
                                 QrPayload="@BarcodeQr.GenerateLabQrPayload(editor.ID, editor.PatientID ?? "", editor.PatientName, $"SMP-{editor.ID}", NavigationManager.BaseUri)" />

            <div class="print-grid">
                <div><span>@I18n.T("Patient Name")</span><b>@editor.PatientName</b></div>
                <div><span>@I18n.T("Patient ID (PID)")</span>@(string.IsNullOrWhiteSpace(editor.PatientID) ? I18n.T("Walk-in") : editor.PatientID)</div>
                <div><span>@I18n.T("Age / Sex")</span>@editor.Age / @editor.Sex</div>
                <div><span>@I18n.T("Contact No")</span>@(editor.Contact ?? "—")</div>
                <div><span>@I18n.T("Referred by")</span>@DoctorFormatted(editor.DoctorID)</div>
                <div><span>@I18n.T("Invoice Date")</span>@editor.TransDate.ToString("dd MMM yyyy hh:mm tt")</div>
                <div><span>@I18n.T("Specimen Tube ID")</span><b>SMP-@editor.ID</b></div>
                <div><span>@I18n.T("Patient Type")</span>@(editor.PatientType == "2" ? I18n.T("In-Patient (IPD)") : I18n.T("Out-Patient (OPD)"))</div>
                @if (editor.PatientType == "2")
                {
                    <div><span>@I18n.T("IPD Reg No")</span><b>@editor.RegNo</b></div>
                    <div><span>@I18n.T("Bed")</span><b>@editor.Bed</b></div>
                }
            </div>

            <table class="data-table" style="margin-top: 14px;">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@I18n.T("Investigation / Test Description")</th>
                        <th class="num">@I18n.T("Rate")</th>
                        <th class="num">@I18n.T("Qty")</th>
                        <th class="num">@I18n.T("Amount")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in editor.Items)
                    {
                        <tr>
                            <td>@item.SLNo</td>
                            <td><b>@ServiceName(item.TestID)</b></td>
                            <td class="num">@I18n.FormatCurrency(item.Rate)</td>
                            <td class="num">@item.Quantity</td>
                            <td class="num">@I18n.FormatCurrency(item.Rate * item.Quantity)</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="print-total">
                <div><span>@I18n.T("Gross Subtotal"):</span> <strong>@I18n.FormatCurrency(grossTotal)</strong></div>
                @if (editor.Discount > 0)
                {
                    <div><span>@I18n.T("Discount"):</span> <b>- @I18n.FormatCurrency(editor.Discount)</b></div>
                }
                @if (editor.PatientType == "2")
                {
                    <div class="grand"><span>@I18n.T("Charged to IPD Account"):</span> <b>@I18n.FormatCurrency(netPayable)</b></div>
                }
                else
                {
                    <div class="grand"><span>@I18n.T("Paid Amount"):</span> <b>@I18n.FormatCurrency(editor.Paid)</b></div>
                    @if (netPayable - editor.Paid > 0)
                    {
                        <div style="color:#dc2626;"><span>@I18n.T("Due Amount"):</span> <b>@I18n.FormatCurrency(netPayable - editor.Paid)</b></div>
                        @if (authorizeReleaseWithDue || (editor.Remarks != null && editor.Remarks.Contains("[AUTH_RELEASE]")))
                        {
                            <div style="color:#15803d; font-size:11px; font-weight:800; margin-top:2px;">🛡️ @I18n.T("REPORT RELEASE AUTHORIZED BY MANAGEMENT", "REPORT RELEASE AUTHORIZED")</div>
                        }
                    }
                }
            </div>

            <PrintDocumentFooter SignTitle1="Patient / Attendant"
                                 SignTitle2="Medical Technologist / Lab"
                                 SignTitle3="Cashier"
                                 PageNumberText="Page 1 of 1" />
        </div>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "patientId")]
    public string? QueryPatientId { get; set; }
    [SupplyParameterFromQuery(Name = "orderId")]
    public long? QueryOrderId { get; set; }
    [SupplyParameterFromQuery(Name = "patientType")]
    public string? QueryPatientType { get; set; }
    [SupplyParameterFromQuery(Name = "hasIpd")]
    public bool? QueryHasIpd { get; set; }

    private bool canAccessIpd = true;
    private string currentPatientType = "1";
    private bool isIpdMode => currentPatientType == "2";
    private CashMemoDInvestigation editor = new() { TransDate = DateTime.Now, ModuleID = 2, PatientType = "1" };
    private List<CashMemoDInvestigation> recentMemos = [];
    private List<Service> availableServices = [];
    private Dictionary<int, string> serviceCategoryNames = [];
    private List<DoctorsProfile> doctors = [];
    private List<AppUser> authorizers = [];
    private List<DiagnosticOrder> pendingOrders = [];
    private long? activeOrderId;
    private bool showPendingOnly;
    private bool saving;

    private string diagScanQuery = "";
    private IEnumerable<CashMemoDInvestigation> FilteredMemos => string.IsNullOrWhiteSpace(diagScanQuery)
        ? recentMemos
        : recentMemos.Where(m => m.ID.ToString().Contains(diagScanQuery.Trim(), StringComparison.OrdinalIgnoreCase)
                              || (m.PatientName?.Contains(diagScanQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)
                              || (m.PatientID?.Contains(diagScanQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)
                              || (m.Contact?.Contains(diagScanQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false));

    private bool showRecentBillsModal = false;
    private string modalSearchQuery = "";
    private string modalTab = "all";
    private DateTime? modalDateFrom;
    private DateTime? modalDateTo;
    private string modalPatientType = "all";
    private int modalPageSize = 30;
    private int totalModalMemosCount = 0;
    private bool isModalLoading = false;
    private List<CashMemoDInvestigation> modalMemos = [];
    private decimal discountPercent = 0;
    private decimal fixedDiscountAmount = 0;

    private IEnumerable<DiagnosticOrder> FilteredModalOrders
    {
        get
        {
            if (string.IsNullOrWhiteSpace(modalSearchQuery)) return pendingOrders;
            var term = modalSearchQuery.Trim();
            return pendingOrders.Where(o => o.ID.ToString().Contains(term, StringComparison.OrdinalIgnoreCase)
                                         || (o.PatientName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                                         || (o.PatientID?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
        }
    }

    private const int DoctorBatchSize = 15;
    private int visibleDoctorCount = DoctorBatchSize;

    private IEnumerable<DoctorsProfile> GetFilteredDoctorsQuery()
    {
        var query = doctors.AsEnumerable();
        var term = doctorSearchQuery.Trim();
        if (!string.IsNullOrWhiteSpace(term) && !IsCurrentDoctorDisplayText(term))
        {
            query = query.Where(d => d.ID.ToString().Contains(term, StringComparison.OrdinalIgnoreCase)
                                  || (d.Name?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                                  || (d.Title?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                                  || (d.Degree?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                                  || (d.Contact?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        return query
            .OrderBy(d => editor.DoctorID == d.ID ? 0 : 1)
            .ThenBy(d => d.Priority ?? int.MaxValue)
            .ThenBy(d => d.Name);
    }

    private List<DoctorsProfile> FilteredDoctors => GetFilteredDoctorsQuery().Take(visibleDoctorCount).ToList();
    private bool hasMoreDoctorSuggestions => GetFilteredDoctorsQuery().Count() > visibleDoctorCount;

    private static readonly (string Key, string Label, string Icon)[] sexOptions = [("Male", "Male", "♂"), ("Female", "Female", "♀"), ("Other", "Other", "⚥")];
    private int selectedTestId = 0;
    private string testSearchQuery = string.Empty;
    private bool showTestSuggestions = false;
    private int highlightedTestIndex = 0;
    private string doctorSearchQuery = string.Empty;
    private bool showDoctorSuggestions = false;
    private decimal itemRate = 0;
    private int itemQty = 1;
    private decimal grossTotal = 0;
    private decimal netPayable = 0;
    private bool paidManuallyEdited;
    private bool authorizeReleaseWithDue = false;

    private string message = "";
    private string messageClass = "success";

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var userPrincipal = auth.User;
            if (userPrincipal.Identity?.IsAuthenticated == true)
            {
                var appUser = await UserManager.GetUserAsync(userPrincipal);
                currentUserDisplayName = !string.IsNullOrWhiteSpace(appUser?.DisplayName)
                    ? appUser.DisplayName
                    : (!string.IsNullOrWhiteSpace(userPrincipal.Identity.Name) ? userPrincipal.Identity.Name : "User");
            }
            var hasIpdRole = userPrincipal.IsInRole(RoleNames.Administrator) || userPrincipal.IsInRole(RoleNames.IPDOperator);
            canAccessIpd = QueryHasIpd ?? hasIpdRole;
        }
        catch { }
        currentPatientType = canAccessIpd ? NormalizePatientType(QueryPatientType) : "1";
        editor.PatientType = currentPatientType;
        await LoadAsync();
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnParametersSetAsync()
    {
        var requestedType = canAccessIpd ? NormalizePatientType(QueryPatientType) : "1";
        if (requestedType != currentPatientType)
        {
            currentPatientType = requestedType;
            Reset();
            await LoadAsync();
        }
        if (QueryOrderId is > 0 && editor.ID == 0)
        {
            await LoadOrderAsync(QueryOrderId.Value);
            return;
        }
        var patientId = QueryPatientId ?? PatientSelection.PatientId;
        if (!string.IsNullOrWhiteSpace(patientId) && editor.ID == 0)
        {
            if (isIpdMode)
            {
                editor.RegNo = patientId.Trim();
                await LoadAdmissionAsync();
            }
            else
            {
                editor.PatientID = patientId.Trim();
                await LoadPatientAsync();
            }
        }
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = auth.User;
            var hasIpdRole = user.IsInRole(RoleNames.Administrator) || user.IsInRole(RoleNames.IPDOperator);
            canAccessIpd = QueryHasIpd ?? hasIpdRole;
            if (!canAccessIpd && currentPatientType == "2")
            {
                currentPatientType = "1";
                editor.PatientType = "1";
            }
        }
        catch { }

        doctors = await db.Doctors.AsNoTracking().Where(x => x.Name != null).ToListAsync();
        var roleAuthorizers = await UserManager.GetUsersInRoleAsync(RoleNames.Authorizer);
        authorizers = roleAuthorizers
            .Where(x => x.IsActive && !string.IsNullOrWhiteSpace(x.DisplayName))
            .OrderBy(x => x.DisplayName)
            .ToList();
        var allCats = await db.ServiceCategories.AsNoTracking().ToListAsync();
        serviceCategoryNames = allCats.ToDictionary(c => c.ID, c => c.Name);
        var diagCategoryIds = allCats
            .Where(c => c.SubID == 8 
                     || c.ID == 66 
                     || c.ID == 91 
                     || (!string.IsNullOrEmpty(c.Name) && (c.Name.Contains("Investigation") || c.Name.Contains("Pathology"))))
            .Select(c => c.ID)
            .ToHashSet();

        availableServices = await db.Services.AsNoTracking()
            .Where(s => s.CategoryID != null 
                     && diagCategoryIds.Contains(s.CategoryID.Value)
                     && s.CategoryID != 3 
                     && s.CategoryID != 48 
                     && s.CategoryID != 71 
                     && s.CategoryID != 7
                     && (s.GenericID == null || s.GenericID == 0)
                     && (s.TypeID == null || s.TypeID == 0)
                     && (s.SupplierID == null || s.SupplierID == 0))
            .OrderBy(x => x.Name)
            .ToListAsync();

        recentMemos = await db.EmergencyMemos.AsNoTracking()
            .Where(x => x.ModuleID == 2 && x.PatientType == currentPatientType)
            .OrderByDescending(x => x.ID)
            .Take(30)
            .ToListAsync();
        totalModalMemosCount = await db.EmergencyMemos.AsNoTracking().CountAsync(x => x.ModuleID == 2);
        pendingOrders = isIpdMode
            ? []
            : await db.DiagnosticOrders.AsNoTracking().Include(x => x.Items)
                .Where(x => x.Status == "Pending").OrderBy(x => x.OrderedAt).Take(50).ToListAsync();
        SyncDoctorSearchFromSelection();
    }

    private async Task LoadModalMemosAsync()
    {
        isModalLoading = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var q = db.EmergencyMemos.AsNoTracking().Where(x => x.ModuleID == 2);

            if (modalPatientType == "1") q = q.Where(x => x.PatientType == "1");
            else if (modalPatientType == "2") q = q.Where(x => x.PatientType == "2");

            if (modalDateFrom.HasValue)
            {
                var f = modalDateFrom.Value.Date;
                q = q.Where(x => x.TransDate >= f);
            }
            if (modalDateTo.HasValue)
            {
                var t = modalDateTo.Value.Date.AddDays(1);
                q = q.Where(x => x.TransDate < t);
            }

            if (!string.IsNullOrWhiteSpace(modalSearchQuery))
            {
                var term = modalSearchQuery.Trim();
                var clean = term.TrimStart('#').TrimStart('B', 'b').TrimStart('0');
                if (long.TryParse(clean, out var numId) && numId > 0)
                {
                    q = q.Where(x => x.ID == numId 
                                  || (x.PatientID != null && x.PatientID.Contains(term)) 
                                  || (x.PatientName != null && x.PatientName.Contains(term)) 
                                  || (x.Contact != null && x.Contact.Contains(term)));
                }
                else
                {
                    q = q.Where(x => (x.PatientID != null && x.PatientID.Contains(term))
                                  || (x.PatientName != null && x.PatientName.Contains(term))
                                  || (x.Contact != null && x.Contact.Contains(term))
                                  || (x.RegNo != null && x.RegNo.Contains(term)));
                }
            }

            if (modalTab == "due")
            {
                q = q.Where(x => (x.Total - x.Discount) > x.Paid);
            }
            else if (modalTab == "paid")
            {
                q = q.Where(x => (x.Total - x.Discount) <= x.Paid);
            }

            totalModalMemosCount = await q.CountAsync();
            modalMemos = await q.OrderByDescending(x => x.ID).Take(modalPageSize).ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load diagnostic modal bills.");
        }
        finally
        {
            isModalLoading = false;
        }
    }

    private async Task OpenRecentBillsModal()
    {
        showRecentBillsModal = true;
        modalTab = "all";
        modalSearchQuery = "";
        modalPageSize = 30;
        await LoadModalMemosAsync();
    }

    private async Task OpenDoctorOrdersModal()
    {
        showRecentBillsModal = true;
        modalTab = "orders";
        modalSearchQuery = "";
        await LoadModalMemosAsync();
    }

    private void CloseRecentBillsModal()
    {
        showRecentBillsModal = false;
    }

    private async Task OnModalTabChanged(string tab)
    {
        modalTab = tab;
        modalPageSize = 30;
        if (modalTab != "orders")
        {
            await LoadModalMemosAsync();
        }
    }

    private async Task HandleModalSearchInput(ChangeEventArgs e)
    {
        modalSearchQuery = e.Value?.ToString() ?? string.Empty;
        modalPageSize = 30;
        await LoadModalMemosAsync();
    }

    private async Task ClearModalSearchAsync()
    {
        modalSearchQuery = string.Empty;
        modalPageSize = 30;
        await LoadModalMemosAsync();
    }

    private async Task OnModalDateFromChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d)) modalDateFrom = d;
        else modalDateFrom = null;
        modalPageSize = 30;
        await LoadModalMemosAsync();
    }

    private async Task OnModalDateToChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d)) modalDateTo = d;
        else modalDateTo = null;
        modalPageSize = 30;
        await LoadModalMemosAsync();
    }

    private async Task OnModalPatientTypeChanged(ChangeEventArgs e)
    {
        modalPatientType = e.Value?.ToString() ?? "all";
        modalPageSize = 30;
        await LoadModalMemosAsync();
    }

    private async Task SetDatePreset(string preset)
    {
        if (preset == "today")
        {
            modalDateFrom = DateTime.Today;
            modalDateTo = DateTime.Today;
        }
        else if (preset == "last7")
        {
            modalDateFrom = DateTime.Today.AddDays(-6);
            modalDateTo = DateTime.Today;
        }
        else if (preset == "month")
        {
            modalDateFrom = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
            modalDateTo = DateTime.Today;
        }
        else if (preset == "all")
        {
            modalDateFrom = null;
            modalDateTo = null;
        }
        modalPageSize = 30;
        await LoadModalMemosAsync();
    }

    private bool IsPresetActive(string preset)
    {
        if (preset == "all") return !modalDateFrom.HasValue && !modalDateTo.HasValue;
        if (preset == "today") return modalDateFrom.HasValue && modalDateTo.HasValue && modalDateFrom.Value.Date == DateTime.Today && modalDateTo.Value.Date == DateTime.Today;
        if (preset == "last7") return modalDateFrom.HasValue && modalDateTo.HasValue && modalDateFrom.Value.Date == DateTime.Today.AddDays(-6) && modalDateTo.Value.Date == DateTime.Today;
        if (preset == "month") return modalDateFrom.HasValue && modalDateTo.HasValue && modalDateFrom.Value.Date == new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1) && modalDateTo.Value.Date == DateTime.Today;
        return false;
    }

    private async Task ResetModalFiltersAsync()
    {
        modalSearchQuery = "";
        modalDateFrom = null;
        modalDateTo = null;
        modalPatientType = "all";
        modalTab = "all";
        modalPageSize = 30;
        await LoadModalMemosAsync();
    }

    private async Task LoadMoreModalMemosAsync()
    {
        modalPageSize += 30;
        await LoadModalMemosAsync();
    }

    private async Task SelectFromModalAsync(CashMemoDInvestigation m)
    {
        await SelectAsync(m);
        showRecentBillsModal = false;
    }

    private async Task LoadOrderFromModalAsync(long orderId)
    {
        await LoadOrderAsync(orderId);
        showRecentBillsModal = false;
    }

    private async Task DeleteMemoFromModalAsync(CashMemoDInvestigation m)
    {
        await SelectAsync(m);
        await DeleteAsync();
        await LoadModalMemosAsync();
    }

    private async Task HandleModalScanKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            diagScanQuery = modalSearchQuery;
            await ProcessDiagScanAsync();
            if (editor.ID > 0)
            {
                showRecentBillsModal = false;
            }
        }
    }

    private void TogglePendingOrders()
    {
        showPendingOnly = !showPendingOnly;
    }

    private async Task LoadOrderAsync(long orderId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var order = await db.DiagnosticOrders.AsNoTracking().Include(x => x.Items).SingleOrDefaultAsync(x => x.ID == orderId);
        if (order is null || order.Status != "Pending") { Fail(I18n.T("Pending diagnostic order was not found.")); return; }
        var encounter = await db.PatientEncounters.AsNoTracking().SingleAsync(x => x.ID == order.EncounterID);
        var patient = string.IsNullOrWhiteSpace(order.PatientID) ? null : await db.Registrations.AsNoTracking().SingleOrDefaultAsync(x => x.PatientID == order.PatientID);
        editor = NewMemo();
        discountPercent = 0;
        fixedDiscountAmount = 0;
