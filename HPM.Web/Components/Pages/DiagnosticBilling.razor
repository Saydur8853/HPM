                                            ⚡ @I18n.T("Create Bill from Order")
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    var filtered = FilteredModalMemos.ToList();
                    @if (filtered.Count == 0)
                    {
                        <div class="diag-modal-empty">
                            <span class="empty-icon">🔬</span>
                            <h4>@I18n.T("No matching diagnostic bills found.")</h4>
                            <p>@I18n.T("Try a different search term or clear the filter.")</p>
