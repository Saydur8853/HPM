@code {
    [SupplyParameterFromQuery(Name = "patientId")]
    public string? QueryPatientId { get; set; }
    [SupplyParameterFromQuery(Name = "orderId")]
    public long? QueryOrderId { get; set; }
    [SupplyParameterFromQuery(Name = "patientType")]
    public string? QueryPatientType { get; set; }

    private string currentPatientType = "1";
    private bool isIpdMode => currentPatientType == "2";
    private CashMemoDInvestigation editor = new() { TransDate = DateTime.Now, ModuleID = 2, PatientType = "1" };
    private List<CashMemoDInvestigation> recentMemos = [];
    private List<Service> availableServices = [];
    private Dictionary<int, string> serviceCategoryNames = [];
    private List<DoctorsProfile> doctors = [];
    private List<AppUser> authorizers = [];
    private List<DiagnosticOrder> pendingOrders = [];
    private long? activeOrderId;
    private bool showPendingOnly;
    private bool saving;

    private string diagScanQuery = "";
    private IEnumerable<CashMemoDInvestigation> FilteredMemos => string.IsNullOrWhiteSpace(diagScanQuery)
        ? recentMemos
        : recentMemos.Where(m => m.ID.ToString().Contains(diagScanQuery.Trim(), StringComparison.OrdinalIgnoreCase)
                              || (m.PatientName?.Contains(diagScanQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)
                              || (m.PatientID?.Contains(diagScanQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)
                              || (m.Contact?.Contains(diagScanQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false));

    private bool showRecentBillsModal = false;
    private string modalSearchQuery = "";
    private string modalTab = "all";
    private decimal discountPercent = 0;
    private decimal fixedDiscountAmount = 0;

    private IEnumerable<CashMemoDInvestigation> FilteredModalMemos
    {
        get
        {
            var q = recentMemos.AsEnumerable();
            if (modalTab == "due")
            {
                q = q.Where(m => (m.Total - m.Discount) > m.Paid);
            }
            if (!string.IsNullOrWhiteSpace(modalSearchQuery))
            {
                var term = modalSearchQuery.Trim();
                q = q.Where(m => m.ID.ToString().Contains(term, StringComparison.OrdinalIgnoreCase)
                              || (m.PatientName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                              || (m.PatientID?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                              || (m.Contact?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
            }
            return q;
        }
    }

    private IEnumerable<DiagnosticOrder> FilteredModalOrders
    {
        get
        {
            if (string.IsNullOrWhiteSpace(modalSearchQuery)) return pendingOrders;
            var term = modalSearchQuery.Trim();
            return pendingOrders.Where(o => o.ID.ToString().Contains(term, StringComparison.OrdinalIgnoreCase)
                                         || (o.PatientName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                                         || (o.PatientID?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
        }
    }

    private IEnumerable<DoctorsProfile> FilteredDoctors
    {
        get
        {
            var query = doctors.AsEnumerable();
            var term = doctorSearchQuery.Trim();
            if (!string.IsNullOrWhiteSpace(term) && !IsCurrentDoctorDisplayText(term))
            {
                query = query.Where(d => d.ID.ToString().Contains(term, StringComparison.OrdinalIgnoreCase)
                                      || (d.Name?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                                      || (d.Title?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                                      || (d.Degree?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                                      || (d.Contact?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return query
                .OrderBy(d => editor.DoctorID == d.ID ? 0 : 1)
                .ThenBy(d => d.Priority ?? int.MaxValue)
                .ThenBy(d => d.Name)
                .Take(10);
        }
    }

    private static readonly (string Key, string Label, string Icon)[] sexOptions = [("Male", "Male", "♂"), ("Female", "Female", "♀"), ("Other", "Other", "⚥")];
    private int selectedTestId = 0;
    private string testSearchQuery = string.Empty;
    private bool showTestSuggestions = false;
    private int highlightedTestIndex = 0;
    private string doctorSearchQuery = string.Empty;
    private bool showDoctorSuggestions = false;
    private decimal itemRate = 0;
    private int itemQty = 1;
    private decimal grossTotal = 0;
    private decimal netPayable = 0;
    private bool paidManuallyEdited;
    private bool authorizeReleaseWithDue = false;

    private bool showPatientIdSuggestions;
    private List<Registration> patientIdSuggestions = [];

    private string message = "";
    private string messageClass = "success";

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        currentPatientType = NormalizePatientType(QueryPatientType);
        editor.PatientType = currentPatientType;
        await LoadAsync();
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnParametersSetAsync()
    {
        var requestedType = NormalizePatientType(QueryPatientType);
        if (requestedType != currentPatientType)
        {
            currentPatientType = requestedType;
            Reset();
            await LoadAsync();
        }
        if (QueryOrderId is > 0 && editor.ID == 0)
        {
            await LoadOrderAsync(QueryOrderId.Value);
            return;
        }
        var patientId = QueryPatientId ?? PatientSelection.PatientId;
        if (!string.IsNullOrWhiteSpace(patientId) && editor.ID == 0)
        {
            if (isIpdMode)
            {
                editor.RegNo = patientId.Trim();
                await LoadAdmissionAsync();
            }
            else
            {
                editor.PatientID = patientId.Trim();
                await LoadPatientAsync();
            }
        }
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        doctors = await db.Doctors.AsNoTracking().Where(x => x.Name != null).ToListAsync();
        var roleAuthorizers = await UserManager.GetUsersInRoleAsync(RoleNames.Authorizer);
        authorizers = roleAuthorizers
            .Where(x => x.IsActive && !string.IsNullOrWhiteSpace(x.DisplayName))
            .OrderBy(x => x.DisplayName)
            .ToList();
        var allCats = await db.ServiceCategories.AsNoTracking().ToListAsync();
        serviceCategoryNames = allCats.ToDictionary(c => c.ID, c => c.Name);
        var diagCategoryIds = allCats
            .Where(c => c.SubID == 8 
                     || c.ID == 66 
                     || c.ID == 91 
                     || (!string.IsNullOrEmpty(c.Name) && (c.Name.Contains("Investigation") || c.Name.Contains("Pathology"))))
            .Select(c => c.ID)
            .ToHashSet();

        availableServices = await db.Services.AsNoTracking()
            .Where(s => s.CategoryID != null 
                     && diagCategoryIds.Contains(s.CategoryID.Value)
                     && s.CategoryID != 3 
                     && s.CategoryID != 48 
                     && s.CategoryID != 71 
                     && s.CategoryID != 7
                     && (s.GenericID == null || s.GenericID == 0)
                     && (s.TypeID == null || s.TypeID == 0)
                     && (s.SupplierID == null || s.SupplierID == 0))
            .OrderBy(x => x.Name)
            .ToListAsync();

        recentMemos = await db.EmergencyMemos.AsNoTracking()
            .Where(x => x.ModuleID == 2 && x.PatientType == currentPatientType)
            .OrderByDescending(x => x.ID)
            .Take(30)
            .ToListAsync();
        pendingOrders = isIpdMode
            ? []
            : await db.DiagnosticOrders.AsNoTracking().Include(x => x.Items)
                .Where(x => x.Status == "Pending").OrderBy(x => x.OrderedAt).Take(50).ToListAsync();
        SyncDoctorSearchFromSelection();
    }

