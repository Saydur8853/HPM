    private async Task LoadPatientIdSuggestionsAsync()
    {
        var term = (editor.PatientID ?? editor.RegNo ?? "").Trim();
        await using var db = await DbFactory.CreateDbContextAsync();
        IQueryable<Registration> q = db.Registrations.AsNoTracking();
        if (!string.IsNullOrEmpty(term))
        {
            q = q.Where(x => (x.PatientID != null && x.PatientID.Contains(term))
                          || (x.Contact != null && x.Contact.Contains(term))
                          || (x.Name != null && x.Name.Contains(term)));
        }
        patientIdSuggestions = await q.OrderByDescending(x => x.ID).Take(PatientBatchSize).ToListAsync();

        if (!string.IsNullOrEmpty(term))
        {
            var admissions = await db.PatientAdmissions.AsNoTracking()
                .Where(x => (x.RegNo.Contains(term) || (x.PatientID != null && x.PatientID.Contains(term))) && x.IsAdmitted == true)
                .OrderByDescending(x => x.AdmissionDate)
                .Take(5)
                .ToListAsync();

            if (admissions.Count > 0)
            {
                var pids = admissions.Where(a => !string.IsNullOrWhiteSpace(a.PatientID)).Select(a => a.PatientID!).ToHashSet();
                var regs = await db.Registrations.AsNoTracking()
                    .Where(x => x.PatientID != null && pids.Contains(x.PatientID))
                    .ToListAsync();

                foreach (var adm in admissions)
                {
                    if (patientIdSuggestions.All(s => s.PatientID != (adm.PatientID ?? adm.RegNo)))
                    {
                        var r = regs.FirstOrDefault(x => x.PatientID == adm.PatientID);
                        patientIdSuggestions.Insert(0, new Registration
                        {
                            PatientID = adm.PatientID ?? adm.RegNo,
                            Name = r?.Name ?? $"IPD Patient ({adm.RegNo})",
                            Contact = r?.Contact ?? adm.RegNo,
                            Sex = r?.Sex ?? "Male"
                        });
                    }
                }
            }
        }

        hasMorePatientSuggestions = patientIdSuggestions.Count >= PatientBatchSize;
        showPatientIdSuggestions = patientIdSuggestions.Count > 0;
    }

    [JSInvokable]
    public async Task LoadMorePatientsFromJs()
    {
        if (!hasMorePatientSuggestions) return;
        var term = (editor.PatientID ?? editor.RegNo ?? "").Trim();
        await using var db = await DbFactory.CreateDbContextAsync();
        IQueryable<Registration> q = db.Registrations.AsNoTracking();
        if (!string.IsNullOrEmpty(term))
        {
            q = q.Where(x => (x.PatientID != null && x.PatientID.Contains(term))
                          || (x.Contact != null && x.Contact.Contains(term))
                          || (x.Name != null && x.Name.Contains(term)));
        }
        List<Registration> more = await q.OrderByDescending(x => x.ID)
            .Skip(patientIdSuggestions.Count)
            .Take(PatientBatchSize)
            .ToListAsync();

        if (more.Count > 0)
        {
            patientIdSuggestions.AddRange(more);
            hasMorePatientSuggestions = more.Count >= PatientBatchSize;
            await InvokeAsync(StateHasChanged);
        }
        else
        {
            hasMorePatientSuggestions = false;
            await InvokeAsync(StateHasChanged);
        }
    }

