    private async Task HandleDiagScanKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ProcessDiagScanAsync();
        }
    }

    private async Task ProcessDiagScanAsync()
    {
        if (string.IsNullOrWhiteSpace(diagScanQuery)) return;
        var raw = diagScanQuery.Trim();

        if (raw.StartsWith("HPM:PAT|", StringComparison.OrdinalIgnoreCase))
        {
            var parts = raw.Split('|');
            foreach (var p in parts)
            {
                if (p.StartsWith("REG:", StringComparison.OrdinalIgnoreCase))
                {
                    editor.PatientID = p.Substring(4).Trim();
                    await LoadPatientAsync();
                    diagScanQuery = "";
                    return;
                }
                if (p.StartsWith("NAME:", StringComparison.OrdinalIgnoreCase) && string.IsNullOrWhiteSpace(editor.PatientName))
                {
                    editor.PatientName = p.Substring(5).Trim();
                }
            }
        }

        long parsedId = 0;
        if (raw.StartsWith("HPM:LAB|", StringComparison.OrdinalIgnoreCase) || raw.StartsWith("HPM:TUBE|", StringComparison.OrdinalIgnoreCase))
        {
            var parts = raw.Split('|');
            foreach (var p in parts)
            {
                if (p.StartsWith("INV:", StringComparison.OrdinalIgnoreCase) && long.TryParse(p.Substring(4), out var invId))
                {
                    parsedId = invId;
                    break;
                }
            }
        }
        else if (raw.StartsWith("LAB-", StringComparison.OrdinalIgnoreCase) && long.TryParse(raw.Substring(4), out var labId))
        {
            parsedId = labId;
        }
        else if (raw.StartsWith("SMP-", StringComparison.OrdinalIgnoreCase))
        {
            var segs = raw.Substring(4).Split('-');
            if (segs.Length > 0 && long.TryParse(segs[0], out var smpMemoId))
            {
                parsedId = smpMemoId;
            }
        }
        else if (raw.StartsWith("B-", StringComparison.OrdinalIgnoreCase) && long.TryParse(raw[2..], out var bDashId)) { parsedId = bDashId; }
        else if (raw.StartsWith("B", StringComparison.OrdinalIgnoreCase) && long.TryParse(raw[1..], out var bId)) { parsedId = bId; }
        else if (long.TryParse(raw, out var numId))
        {
            parsedId = numId;
        }

        if (parsedId > 0)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var found = await db.EmergencyMemos.Include(x => x.Items).AsNoTracking().FirstOrDefaultAsync(x => x.ID == parsedId && x.ModuleID == 2 && x.PatientType == currentPatientType);
            if (found != null)
            {
                await SelectAsync(found);
                diagScanQuery = "";
                Success(I18n.IsBangla ? $"ডায়াগনস্টিক মেমো #{parsedId} লোড করা হয়েছে।" : $"Diagnostic memo #{parsedId} loaded.");
                return;
            }
        }

        if (editor.ID == 0)
        {
            if (isIpdMode)
            {
                editor.RegNo = raw;
                await LoadAdmissionAsync();
            }
            else
            {
                editor.PatientID = raw;
                await LoadPatientAsync();
            }
        }
    }

    private void ClearDiagScan() => diagScanQuery = "";

    private async Task<int> CurrentUserIdAsync()
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        return int.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : 1;
    }

    private void Reset()
    {
        showPatientIdSuggestions = false;
        PatientSelection.Clear();
        editor = NewMemo();
        paidManuallyEdited = false;
        authorizeReleaseWithDue = false;
        selectedTestId = 0;
        testSearchQuery = string.Empty;
        showTestSuggestions = false;
        highlightedTestIndex = 0;
        doctorSearchQuery = string.Empty;
        showDoctorSuggestions = false;
        visibleDoctorCount = DoctorBatchSize;
        itemRate = 0;
        itemQty = 1;
        discountPercent = 0;
        fixedDiscountAmount = 0;
        grossTotal = 0;
        netPayable = 0;
        activeOrderId = null;
        message = "";
    }

    private CashMemoDInvestigation NewMemo() => new()
    {
        TransDate = DateTime.Now,
        ModuleID = 2,
        PatientType = currentPatientType
    };

    private static string NormalizePatientType(string? value) =>
        string.Equals(value, "IPD", StringComparison.OrdinalIgnoreCase) || value == "2" ? "2" : "1";

    private async Task SetPatientTypeAsync(string type)
    {
        if (type == "2" && !canAccessIpd)
        {
            Fail(I18n.IsBangla ? "আইপিডি সার্ভিস মডিউলের অ্যাক্সেস নেই।" : "IPD service module access is not granted.");
            return;
        }
        if (currentPatientType == type) return;
        currentPatientType = type;
        editor.PatientType = type;
        RecalculateTotals();
        StateHasChanged();
    }

    private bool HasModeSwitchData() =>
        editor.ID > 0
        || activeOrderId.HasValue
        || editor.Items.Count > 0
        || !string.IsNullOrWhiteSpace(editor.PatientID)
        || !string.IsNullOrWhiteSpace(editor.RegNo)
        || !string.IsNullOrWhiteSpace(editor.PatientName)
        || !string.IsNullOrWhiteSpace(editor.Contact)
        || !string.IsNullOrWhiteSpace(editor.Remarks);

    private string ServiceName(int id)
    {
        var s = availableServices.FirstOrDefault(x => x.ID == id);
        return !string.IsNullOrWhiteSpace(s?.Name) ? s.Name : $"Test #{id}";
    }
    private string printLayout = "A5";

    private string DoctorFormatted(int? id)
    {
        var d = doctors.FirstOrDefault(x => x.ID == id);
        if (d == null) return I18n.IsBangla ? "সেলফ / সাধারণ ডাক্তার" : "Self / OPD Doctor";
        var code = $"(D{d.ID:D4})";
        var degree = !string.IsNullOrWhiteSpace(d.Degree) ? $", {d.Degree}" : "";
        var titleName = string.Join(" ", new[] { d.Title, d.Name }.Where(s => !string.IsNullOrWhiteSpace(s)));
        return $"{code} {titleName}{degree}";
    }

    private string currentUserDisplayName = "";

    private string GetCashierName()
    {
        if (editor.ID > 0 && editor.EnteredBy > 0)
        {
            var u = authorizers.FirstOrDefault(x => x.Id == editor.EnteredBy);
            if (u != null && !string.IsNullOrWhiteSpace(u.DisplayName)) return u.DisplayName;
            if (u != null && !string.IsNullOrWhiteSpace(u.UserName)) return u.UserName;
        }
        return !string.IsNullOrWhiteSpace(currentUserDisplayName) ? currentUserDisplayName : "System User";
    }

    private string GetExpectedDelivery(DateTime transDate, int testId = 0)
    {
        var s = availableServices.FirstOrDefault(x => x.ID == testId);
        if (s?.DeliveryHours is > 0)
        {
            var target = transDate.AddHours(s.DeliveryHours.Value);
            return target.ToString("dd/MM/yy hh:mm tt");
        }

        var defaultDelivery = transDate.Hour < 14
            ? transDate.Date.AddHours(19)
            : transDate.Date.AddDays(1).AddHours(19);
        return defaultDelivery.ToString("dd/MM/yy hh:mm tt");
    }

    private string DoctorName(int? id)
    {
        var d = doctors.FirstOrDefault(x => x.ID == id);
        return d == null ? (I18n.IsBangla ? "সাধারণ / ডিউটি ডাক্তার" : "Self / OPD Doctor") : $"{d.Title} {d.Name}";
    }

    private void Success(string text)
    {
        messageClass = "success";
        message = text;
        alertModalMessage = text;
        alertModalType = "success";
        alertModalTitle = I18n.IsBangla ? "বিজ্ঞপ্তি / সফল বার্তা" : "Notice / Success";
    }

    private bool showAlertModal;
    private string alertModalTitle = "বিজ্ঞপ্তি / সফল বার্তা";
    private string alertModalMessage = "";
    private string? alertModalDetails;
    private string alertModalType = "success";

    private void ShowInlineAlertModal()
    {
        if (string.IsNullOrWhiteSpace(message)) return;
        alertModalMessage = message;
        if (messageClass.Contains("danger"))
        {
            alertModalType = "danger";
            alertModalTitle = I18n.IsBangla ? "সতর্কতা / ত্রুটি" : "System Alert / Error";
        }
        else if (messageClass.Contains("warning"))
        {
            alertModalType = "warning";
            alertModalTitle = I18n.IsBangla ? "সতর্কবার্তা" : "Warning";
        }
        else
        {
            alertModalType = "success";
            alertModalTitle = I18n.IsBangla ? "বিজ্ঞপ্তি / সফল বার্তা" : "Notice / Success";
        }
        showAlertModal = true;
    }

    private void Fail(string text, string? details = null, string? title = null)
    {
        messageClass = "danger";
        message = text;
        alertModalTitle = title ?? (I18n.IsBangla ? "সতর্কতা / ত্রুটি" : "System Alert / Error");
        alertModalMessage = text;
        alertModalDetails = details;
        alertModalType = "danger";
        showAlertModal = true;
    }

    private void CloseAlertModal()
    {
        showAlertModal = false;
        alertModalDetails = null;
    }

    public void Dispose()
    {
        dotNetRef?.Dispose();
        I18n.OnLanguageChanged -= HandleLanguageChanged;
    }
