    private void HandleSexKeyDown(KeyboardEventArgs e, string currentSex)
    {
        var keys = sexOptions.Select(x => x.Key).ToArray();
        int currentIndex = Array.IndexOf(keys, currentSex);
        if (e.Key == "ArrowRight" || e.Key == "ArrowDown")
        {
            int nextIndex = (currentIndex >= 0) ? (currentIndex + 1) % keys.Length : 0;
            editor.Sex = keys[nextIndex];
        }
        else if (e.Key == "ArrowLeft" || e.Key == "ArrowUp")
        {
            int prevIndex = (currentIndex >= 0) ? (currentIndex - 1 + keys.Length) % keys.Length : keys.Length - 1;
            editor.Sex = keys[prevIndex];
        }
    }

    private IEnumerable<Service> FilteredTests
    {
        get
        {
            if (string.IsNullOrWhiteSpace(testSearchQuery))
            {
                return availableServices.Take(30);
            }
            var query = testSearchQuery.Trim();
            if (selectedTestId > 0)
            {
                var current = availableServices.FirstOrDefault(x => x.ID == selectedTestId);
                if (current != null && string.Equals(current.Name, query, StringComparison.OrdinalIgnoreCase))
                {
                    return availableServices.Take(30);
                }
            }

            return availableServices
                .Where(s => (s.Name != null && s.Name.Contains(query, StringComparison.OrdinalIgnoreCase))
                         || s.ID.ToString().Contains(query))
                .Take(40);
        }
    }

