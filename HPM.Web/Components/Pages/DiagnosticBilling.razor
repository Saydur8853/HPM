@page "/diagnostic/billing"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.Cashier + "," + RoleNames.Reception)]
@rendermode InteractiveServer
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<AppUser> UserManager
@inject IBarcodeQrService BarcodeQr
@inject NavigationManager NavigationManager
@inject PatientSelectionState PatientSelection
@implements IDisposable
@using System.Security.Claims
@using HPM.Web.Components.Common

<PageTitle>@(isIpdMode ? I18n.T("IPD Cash Memo") : I18n.T("OPD Cash Memo")) | @Branding.HospitalName</PageTitle>

<div class="diagnostic-classic-fit">
    <!-- Compact Top Action & Status Bar -->
    <div class="diagnostic-classic-topbar">
        <div class="tickets-top-left">
            <h1 class="tickets-page-title">
                <span>🔬</span>
                <span>@(isIpdMode ? I18n.T("IPD Investigation Cash Memo") : I18n.T("OPD Investigation Cash Memo"))</span>
            </h1>
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <span class="tickets-inline-alert @messageClass" title="@message">
                    @(messageClass.Contains("danger") ? "⚠" : "✓") @message
                </span>
            }
        </div>

        <DiagnosticNavTabs />

        <div class="tickets-top-actions">
            <button type="button" class="btn btn-secondary tickets-btn btn-recent-bills-modal-btn" @onclick="OpenRecentBillsModal" title="@I18n.T("Open Recent Diagnostic Bills & Doctor Orders Modal")">
                📋 @I18n.T("Recent Diagnostic Bills")
                <span class="tickets-count-badge">@recentMemos.Count</span>
            </button>
            @if (pendingOrders.Count > 0)
            {
                <button type="button" class="btn btn-secondary tickets-btn doctor-orders-pill-btn" @onclick="OpenDoctorOrdersModal" title="@I18n.T("View Pending Doctor Orders")">
                    ⚡ @pendingOrders.Count @I18n.T("Doctor Order(s)")
                </button>
            }
            <button type="button" class="btn btn-primary tickets-btn" @onclick="Reset" title="@I18n.T("New Diagnostic Bill")">
                + @I18n.T("New Diagnostic Bill")
            </button>
        </div>
    </div>

    <!-- Main Full-Width Workspace (Non-scrollable Viewpoint) -->
    <div class="diagnostic-classic-workspace diagnostic-full-workspace">
        <div class="diagnostic-form-card">
            <div class="diagnostic-card-header">
                <div class="diagnostic-card-title-wrap">
                    <h2>@(editor.ID == 0 ? (isIpdMode ? I18n.T("New IPD Investigation Bill") : I18n.T("New OPD Investigation Bill")) : $"{I18n.T("Edit Diagnostic Bill")} #{editor.ID}")</h2>
                    <span class="diagnostic-badge">
                        @(editor.ID == 0 ? "🔬 " + I18n.T("DIAGNOSTIC") : $"MEMO #{editor.ID}")
                    </span>
                </div>
                <div class="diagnostic-card-header-actions">
                    <div class="diagnostic-billing-type-picker">
                        <span class="diagnostic-billing-type-label">@I18n.T("Billing Type")</span>
                        <div class="diagnostic-mode-toggle" role="group" aria-label="@I18n.T("Billing Type")">
                            <button type="button"
                                    class="mode-toggle-btn @(!isIpdMode ? "active opd-active" : "")"
                                    aria-pressed="@(!isIpdMode)"
                                    @onclick='() => SetPatientTypeAsync("1")'
                                    title="@I18n.T("Collect payment now as an OPD bill")">
                                <span class="mode-toggle-icon">🏥</span>
                                <span><strong>@I18n.T("OPD Billing")</strong><small>@I18n.T("Pay now")</small></span>
                            </button>
                            <button type="button"
                                    class="mode-toggle-btn @(isIpdMode ? "active ipd-active" : "")"
                                    aria-pressed="@(isIpdMode)"
                                    @onclick='() => SetPatientTypeAsync("2")'
                                    title="@I18n.T("Add the charge to the patient's IPD final bill")">
                                <span class="mode-toggle-icon">🛏️</span>
                                <span><strong>@I18n.T("Charge to IPD")</strong><small>@I18n.T("Final bill")</small></span>
                            </button>
                        </div>
                    </div>
                    <button type="button" class="btn btn-outline tickets-btn btn-header-modal-trigger" @onclick="OpenRecentBillsModal" title="@I18n.T("Search & view past diagnostic cash memos")">
                        📋 @I18n.T("Recent Bills & Orders") (@recentMemos.Count)
                    </button>
                </div>
            </div>
            <div class="diagnostic-mode-explainer @(isIpdMode ? "ipd" : "opd")" role="status">
                <div class="diagnostic-mode-explainer-copy">
                    <span class="diagnostic-mode-explainer-icon">@(isIpdMode ? "🛏️" : "💳")</span>
                    <div>
                        <strong>@(isIpdMode ? I18n.T("Charge to the patient's IPD account") : I18n.T("Collect payment at the diagnostic counter"))</strong>
                        <span>@(isIpdMode
                            ? I18n.T("No payment is collected here. The full diagnostic charge will be added to the patient's IPD final bill.")
                            : I18n.T("Receive payment now and issue an OPD diagnostic cash memo. Any unpaid amount remains due on this bill."))</span>
                    </div>
                </div>
            </div>

            <EditForm Model="editor" OnSubmit="SaveAsync" class="diagnostic-form-wrapper">
                <DataAnnotationsValidator />

                <div class="diagnostic-form-body diag-billing-two-col">
                    <!-- Left Part: Data Entry & Test Selection (Matches Hand Sketch) -->
                    <div class="diag-entry-col">
                        <!-- Demographics Card -->
                        <div class="diag-section-card">
                            <div class="diag-section-header">
                                <span class="diag-section-title">👤 @I18n.T("Patient Demographics")</span>
                                @if (!string.IsNullOrWhiteSpace(editor.PatientID))
                                {
                                    <span class="diag-section-sub">PID: @editor.PatientID</span>
                                }
                            </div>
                            <div class="diag-demographics-grid">
                                @if (isIpdMode)
                                {
                                    <label class="diag-field-ipd">
                                        <span>@I18n.T("IPD Reg No")<span class="req">*</span></span>
                                        <div class="tickets-patient-search-combo">
                                            <input class="classic-input" @bind="editor.RegNo" @bind:event="oninput" @onkeydown="HandleIpdRegKeyDown" autocomplete="off" placeholder="@I18n.T("IPD Reg No or Patient ID")" />
                                            <button type="button" class="btn-find icon-only" @onclick="LoadAdmissionAsync" title="@I18n.T("Load Admission (Enter)")" aria-label="@I18n.T("Load Admission")"><SearchIcon /></button>
                                        </div>
                                    </label>
                                }
                                else
                                {
                                    <label class="diag-field-pid">
                                        <span>@I18n.T("PATIENT ID")</span>
                                        <div class="tickets-patient-search-combo">
                                            <input class="classic-input"
                                                   value="@editor.PatientID"
                                                   @oninput="HandlePatientIdInputAsync"
                                                   @onfocus="ShowPatientIdSuggestionsAsync"
                                                   @onblur="HidePatientSuggestionsAsync"
                                                   @onkeydown="HandlePatientIdKeyDown"
                                                   autocomplete="off"
                                                   placeholder="@I18n.T("Patient ID or mobile")"
                                                   title="@I18n.T("Type Patient ID & press Enter or click the search button to load")" />
                                            <button type="button" class="btn-find icon-only" @onclick="LoadPatientAsync" title="@I18n.T("Load Patient (Enter)")" aria-label="@I18n.T("Load Patient")"><SearchIcon /></button>
                                        </div>
                                        @if (showPatientIdSuggestions && patientIdSuggestions.Count > 0)
                                        {
                                            <div class="appt-patient-suggestions">
                                                @foreach (var patient in patientIdSuggestions)
                                                {
                                                    <button type="button" class="appt-patient-option" @onmousedown:preventDefault @onclick="() => SelectPatientFromSuggestion(patient)">
                                                        <span class="patient-id">@patient.PatientID</span>
                                                        <span class="patient-name">@patient.Name</span>
                                                        <span class="patient-contact">@patient.Contact</span>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </label>
                                }

                                <label class="diag-field-contact">
                                    <span>@I18n.T("Contact No")</span>
                                    <div class="tickets-patient-search-combo">
                                        <input class="classic-input"
                                               @bind="editor.Contact"
                                               @bind:event="oninput"
                                               @onkeydown="HandleContactKeyDown"
                                               autocomplete="off"
                                               placeholder="017xxxxxxxx"
                                               title="@I18n.T("Type mobile & press Enter or click the search button to load patient")" />
                                        <button type="button" class="btn-find icon-only" @onclick="LoadPatientByContactAsync" title="@I18n.T("Search by Contact (Enter)")" aria-label="@I18n.T("Search by Contact")"><SearchIcon /></button>
                                    </div>
                                </label>

                                <label class="diag-field-name">
                                    <span>@I18n.T("Patient Name")<span class="req">*</span></span>
                                    <InputText class="classic-input" @bind-Value="editor.PatientName" placeholder="@I18n.T("Patient Name")" />
                                </label>

                                <label class="diag-field-sex">
                                    <span>@I18n.T("SEX")<span class="req">*</span></span>
                                    <div class="sex-btn-group" role="radiogroup" aria-label="@I18n.T("Sex")">
                                        @foreach (var sex in sexOptions)
                                        {
                                            var isSelected = string.Equals(editor.Sex, sex.Key, StringComparison.OrdinalIgnoreCase);
                                            var sexClass = sex.Key.ToLowerInvariant();
                                            <button type="button"
                                                    class="sex-btn sex-btn-@sexClass @(isSelected ? "is-selected" : "")"
                                                    tabindex="@(isSelected ? 0 : -1)"
                                                    @onclick="() => SelectSex(sex.Key)"
                                                    @onkeydown="e => HandleSexKeyDown(e, sex.Key)"
                                                    title="@I18n.T(sex.Label)">
                                                <span class="sex-icon">
                                                    @if (sex.Key == "Male")
                                                    {
                                                        <svg class="sex-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                            <circle cx="10" cy="14" r="5"></circle>
                                                            <line x1="19" y1="5" x2="13.6" y2="10.4"></line>
                                                            <polyline points="15 5 19 5 19 9"></polyline>
                                                        </svg>
                                                    }
                                                    else if (sex.Key == "Female")
                                                    {
                                                        <svg class="sex-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                            <circle cx="12" cy="9" r="5"></circle>
                                                            <line x1="12" y1="14" x2="12" y2="21"></line>
                                                            <line x1="9" y1="18" x2="15" y2="18"></line>
                                                        </svg>
                                                    }
                                                    else
                                                    {
                                                        <svg class="sex-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                            <circle cx="12" cy="12" r="4"></circle>
                                                            <line x1="12" y1="4" x2="12" y2="8"></line>
                                                            <line x1="10" y1="5" x2="14" y2="5"></line>
                                                            <line x1="12" y1="16" x2="12" y2="20"></line>
                                                            <line x1="10" y1="19" x2="14" y2="19"></line>
                                                        </svg>
                                                    }
                                                </span>
                                                <span class="sex-text">@I18n.T(sex.Label)</span>
                                            </button>
                                        }
                                    </div>
                                </label>

                                <label class="diag-field-age">
                                    <span>@I18n.T("Age")<span class="req">*</span></span>
                                    <InputText class="classic-input" @bind-Value="editor.Age" placeholder="e.g. 35Y" />
                                </label>

                                <label class="diag-field-ref">
                                    <span>@I18n.T("Referred by")</span>
                                    <div class="diag-doctor-combo" role="combobox" aria-expanded="@showDoctorSuggestions" aria-haspopup="listbox">
                                        <input class="classic-input @(editor.DoctorID.HasValue ? "doctor-selected-input" : "")"
                                               value="@doctorSearchQuery"
                                               @oninput="HandleDoctorSearchInput"
                                               @onfocus="ShowDoctorSuggestions"
                                               @onblur="HideDoctorSuggestionsAsync"
                                               placeholder="@I18n.T("Search doctor by name, degree or mobile...")"
                                               autocomplete="off"
                                               aria-autocomplete="list" />
                                        @if (editor.DoctorID.HasValue || !string.IsNullOrWhiteSpace(doctorSearchQuery))
                                        {
                                            <button type="button" class="diag-doctor-clear" tabindex="-1" @onmousedown:preventDefault @onclick="ClearSelectedDoctor" title="@I18n.T("Clear referred doctor")">✕</button>
                                        }
                                        else
                                        {
                                            <span class="diag-doctor-search-icon"><SearchIcon /></span>
                                        }
                                    </div>
                                    @if (showDoctorSuggestions)
                                    {
                                        <div class="diag-doctor-suggestions" role="listbox">
                                            <button type="button" class="diag-doctor-option walk-in" @onmousedown:preventDefault @onclick="ClearSelectedDoctor">
                                                <span class="doctor-option-main">@I18n.T("Walk-in / None")</span>
                                            </button>
                                            @foreach (var doctor in FilteredDoctors)
                                            {
                                                <button type="button" class="diag-doctor-option @(editor.DoctorID == doctor.ID ? "selected" : "")"
                                                        role="option"
                                                        aria-selected="@(editor.DoctorID == doctor.ID)"
                                                        @onmousedown:preventDefault
                                                        @onclick="() => SelectDoctor(doctor)">
                                                    <span class="doctor-option-main">@DoctorDisplayName(doctor)</span>
                                                    @if (!string.IsNullOrWhiteSpace(doctor.Degree) || !string.IsNullOrWhiteSpace(doctor.Contact))
                                                    {
                                                        <span class="doctor-option-meta">@string.Join(" • ", new[] { doctor.Degree, doctor.Contact }.Where(x => !string.IsNullOrWhiteSpace(x)))</span>
                                                    }
                                                </button>
                                            }
                                            @if (!FilteredDoctors.Any())
                                            {
                                                <div class="diag-doctor-empty">@I18n.T("No matching doctor found")</div>
                                            }
                                        </div>
                                    }
                                </label>
                            </div>
                        </div>

                        <!-- Test Selection Section (Matches Hand Sketch: Search | Rate | Qty | Add) -->
                        <div class="diag-section-card">
                            <div class="diag-section-header">
                                <span class="diag-section-title">🔬 @I18n.T("SELECT test & investigations")</span>
                            </div>
                            <div class="diag-line-editor">
                                <div class="diagnostic-test-search-field">
                                    <label>
                                        <span>@I18n.T("Search Test by Name or Code")<span class="req">*</span></span>
                                        <div class="diagnostic-test-combo">
                                            <input class="classic-input @(selectedTestId > 0 ? "test-selected-input" : "")"
                                                   value="@testSearchQuery"
                                                   @oninput="HandleTestSearchInput"
                                                   @onfocus="ShowTestSuggestions"
                                                   @onblur="HideTestSuggestions"
                                                   @onkeydown="HandleTestSearchKeyDown"
                                                   placeholder="@I18n.T("Search test by name or ID (e.g. CBC, Creatinine)...")"
                                                   autocomplete="off" />
                                            @if (selectedTestId > 0 || !string.IsNullOrWhiteSpace(testSearchQuery))
                                            {
                                                <button type="button" class="diagnostic-test-clear" tabindex="-1" @onclick="ClearSelectedTest" title="@I18n.T("Clear Test")">✕</button>
                                            }
                                            else
                                            {
                                                <span class="diagnostic-test-search-icon"><SearchIcon /></span>
                                            }
                                        </div>
                                    </label>
                                    @if (showTestSuggestions && FilteredTests.Any())
                                    {
                                        <div class="diagnostic-test-suggestions-dropdown">
                                            <div class="diag-test-sugg-header">
                                                <span>@I18n.T("Matching Tests") (@FilteredTests.Count())</span>
                                                <span class="diag-test-sugg-hint">↑↓ @I18n.T("Navigate") &bull; ↵ @I18n.T("Select")</span>
                                            </div>
                                            <div class="diag-test-sugg-list">
                                                @{
                                                    var list = FilteredTests.ToList();
                                                    for (var i = 0; i < list.Count; i++)
                                                    {
                                                        var s = list[i];
                                                        var isHighlighted = i == highlightedTestIndex;
                                                        var isSelected = s.ID == selectedTestId;
                                                        <div class="diag-test-option @(isHighlighted ? "active" : "") @(isSelected ? "selected" : "")"
                                                             @onmousedown:preventDefault
                                                             @onclick="() => SelectTest(s)">
                                                            <div class="diag-test-main">
                                                                <span class="diag-test-code">#@s.ID</span>
                                                                <span class="diag-test-name">@s.Name</span>
                                                                @if (s.CategoryID.HasValue && serviceCategoryNames.TryGetValue(s.CategoryID.Value, out var catName) && !string.IsNullOrWhiteSpace(catName))
                                                                {
                                                                    <span class="diag-test-cat-badge">@catName</span>
                                                                }
                                                            </div>
                                                            <span class="diag-test-rate">@I18n.FormatCurrency(s.SaleRate ?? 0)</span>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                                <label class="diag-input-rate">
                                    <span>@I18n.T("Rate")</span>
                                    <InputNumber class="classic-input bold-number" @bind-Value="itemRate" @onkeydown="HandleRateQtyKeyDown" />
                                </label>
                                <label class="diag-input-qty">
                                    <span>@I18n.T("Qty")</span>
                                    <InputNumber class="classic-input" @bind-Value="itemQty" @onkeydown="HandleRateQtyKeyDown" />
                                </label>
                                <button class="btn btn-secondary tickets-btn diag-add-test-btn" type="button" @onclick="AddItem" title="@I18n.T("Add Test to Bill")">
                                    + @I18n.T("Add")
                                </button>
                            </div>
                        </div>

                        <!-- Clinical Remarks & Instructions -->
                        <div class="diag-section-card diag-remarks-card">
                            <div class="diag-section-header">
                                <span class="diag-section-title">📝 @I18n.T("Clinical Remarks / Instructions")</span>
                            </div>
                            <label class="diag-remarks-field">
                                <InputTextArea class="classic-input diag-remarks-textarea" @bind-Value="editor.Remarks" placeholder="@I18n.T("Remarks / Clinical notes / Doctor's instructions...")" />
                            </label>
                            @if (isIpdMode)
                            {
                                <div class="alert success" style="margin:4px 0 0; padding:6px 10px; font-size:11px;">@I18n.T("This amount will be posted to the patient's IPD bill.")</div>
                            }
                        </div>
                    </div>

                    <!-- Right Part: Added Test And Investigations List & Billing Calculations (Matches Hand Sketch) -->
                    <div class="diag-preview-col">
                        <div class="diag-preview-card">
                            <!-- Header matching sketch: Added Test And Investigations List: -->
                            <div class="diag-preview-card-header">
                                <div class="diag-preview-title-group">
                                    <span class="diag-preview-title">📋 @I18n.T("Added Test And Investigations List:")</span>
                                    <span class="diag-preview-badge">@editor.Items.Count @(editor.Items.Count == 1 ? I18n.T("Test") : I18n.T("Tests"))</span>
                                </div>
                                @if (editor.Items.Count > 0)
                                {
                                    <button type="button" class="btn-clear-tests" @onclick="ClearAllItems" title="@I18n.T("Clear All Tests")">
                                        ✕ @I18n.T("Clear All")
                                    </button>
                                }
                            </div>

                            <!-- Table matching sketch columns: SL | Test | Rate | Qty | Amount | Disc % | Date/Time | ✕ -->
                            <div class="diag-bill-preview-table-wrap">
                                <div class="diag-preview-table-head">
                                    <span class="pcol-sl">SL</span>
                                    <span class="pcol-name">@I18n.T("Test")</span>
                                    <span class="pcol-rate">@I18n.T("Rate")</span>
                                    <span class="pcol-qty">@I18n.T("Qty")</span>
                                    <span class="pcol-amount">@I18n.T("Amount")</span>
                                    <span class="pcol-del">✕</span>
                                </div>
                                <div class="diag-preview-table-rows">
                                    @if (editor.Items.Count == 0)
                                    {
                                        <div class="diag-preview-empty-state">
                                            <div class="empty-icon">🧪</div>
                                            <strong>@I18n.T("No tests selected yet")</strong>
                                            <span>@I18n.T("Search and add investigations from the left side to calculate bill.")</span>
                                        </div>
                                    }
                                    else
                                    {
                                        @for (var i = 0; i < editor.Items.Count; i++)
                                        {
                                            var idx = i;
                                            var item = editor.Items[idx];
                                            var service = availableServices.FirstOrDefault(s => s.ID == item.TestID);
                                            <div class="diag-preview-table-row">
                                                <span class="pcol-sl">@(idx + 1)</span>
                                                <div class="pcol-name">
                                                    <span class="pcol-test-title">@ServiceName(item.TestID)</span>
                                                    @if (service?.CategoryID is int catId && serviceCategoryNames.TryGetValue(catId, out var catName) && !string.IsNullOrWhiteSpace(catName))
                                                    {
                                                        <span class="diag-test-cat-pill">@catName</span>
                                                    }
                                                </div>
                                                <span class="pcol-rate">@I18n.FormatCurrency(item.Rate)</span>
                                                <span class="pcol-qty">@item.Quantity</span>
                                                <strong class="pcol-amount">@I18n.FormatCurrency(item.Rate * item.Quantity)</strong>
                                                <span class="pcol-del">
                                                    <button type="button" class="diag-item-del-btn" title="@I18n.T("Delete")" @onclick="() => RemoveItem(idx)">✕</button>
                                                </span>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>

                            <!-- Calculations Block matching sketch: Total amount, Disc, Payable, Received, Due -->
                            <div class="diag-totals-summary-box">
                                <div class="diag-totals-row gross-row">
                                    <span class="totals-label">@I18n.T("Total amount"):</span>
                                    <strong class="totals-value gross-val">@I18n.FormatCurrency(grossTotal)</strong>
                                </div>

                                @if (!isIpdMode)
                                {
                                    <div class="diag-totals-row input-row">
                                        <span class="totals-label">@I18n.T("Disc (% + Amount)"):</span>
                                        <div class="totals-dual-input-wrap">
                                            <div class="percent-input-wrap">
                                                <input type="number" step="0.5" min="0" max="100" class="classic-input diag-tot-input"
                                                       value="@discountPercent"
                                                       @onchange="HandleDiscountPercentChange"
                                                       aria-label="@I18n.T("Percentage discount")"
                                                       placeholder="%" />
                                                <span class="unit-symbol">%</span>
                                            </div>
                                            <InputNumber class="classic-input diag-tot-input"
                                                         @bind-Value="fixedDiscountAmount"
                                                         @bind-Value:after="OnFixedDiscountAmountChanged"
                                                         aria-label="@I18n.T("Additional fixed discount amount")"
                                                         placeholder="Tk" />
                                        </div>
                                    </div>

                                    @if (editor.Discount > 0)
                                    {
                                        <div class="diag-totals-row discount-total-row">
                                            <span class="totals-label">@I18n.T("Total Discount"):</span>
                                            <strong class="totals-value">- @I18n.FormatCurrency(editor.Discount)</strong>
                                        </div>
                                        <div class="diag-totals-row input-row">
                                            <span class="totals-label">@I18n.T("Authorized By"):</span>
                                            <div class="totals-input-wrap authorizer-input-wrap">
                                                <InputSelect class="classic-input diag-tot-input tickets-select diag-authorizer-select" @bind-Value="editor.DiscountBy">
                                                    <option value="">@I18n.T("Select authorizer")</option>
                                                    @if (authorizers.Count == 0)
                                                    {
                                                        <option value="" disabled>@I18n.T("No active Authorizer user")</option>
                                                    }
                                                    @foreach (var authorizer in authorizers)
                                                    {
                                                        <option value="@authorizer.DisplayName">@authorizer.DisplayName</option>
                                                    }
                                                </InputSelect>
                                            </div>
                                        </div>
                                    }

                                    <div class="diag-totals-row net-payable-row">
                                        <span class="totals-label">@I18n.T("Payable"):</span>
                                        <strong class="totals-value net-val">@I18n.FormatCurrency(netPayable)</strong>
                                    </div>

                                    <div class="diag-totals-row input-row">
                                        <span class="totals-label">@I18n.T("Received"):</span>
                                        <div class="totals-input-wrap">
                                            <InputNumber class="classic-input diag-tot-input" @bind-Value="editor.Paid" @bind-Value:after="PaidChanged" />
                                        </div>
                                    </div>

                                    @if (netPayable - editor.Paid > 0)
                                    {
                                        <div class="diag-due-alert-card">
                                            <div class="diag-due-top-row">
                                                <div class="diag-due-summary">
                                                    <span class="diag-due-icon" aria-hidden="true">!</span>
                                                    <div>
                                                        <span class="due-warning-text">@I18n.T("Balance Due")</span>
                                                        <strong class="diag-due-amount">@I18n.FormatCurrency(netPayable - editor.Paid)</strong>
                                                    </div>
                                                </div>
                                                <div class="diag-due-actions">
                                                    <label class="diag-due-release-chk" title="@I18n.T("Special authorization only; this is not required to save a due invoice.")">
                                                        <InputCheckbox @bind-Value="authorizeReleaseWithDue" @bind-Value:after="OnAuthorizeReleaseChanged" />
                                                        <span>@I18n.T("Release report with due")</span>
                                                    </label>
                                                    <button type="button" class="btn-quick-full-pay" @onclick="PayDueInFull" title="@I18n.T("Set Paid Amount to Net Payable")">
                                                        ✓ @(editor.ID > 0 ? I18n.T("Mark Due Paid") : I18n.T("Mark Fully Paid"))
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="diag-totals-row due-row zero-due">
                                            <span class="totals-label">@I18n.T("Due"):</span>
                                            <strong class="totals-value due-val">@I18n.FormatCurrency(0)</strong>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="diag-totals-row">
                                        <span class="totals-label">@I18n.T("Charge To IPD"):</span>
                                        <strong>@editor.RegNo</strong>
                                    </div>
                                    <div class="diag-totals-row net-payable-row">
                                        <span class="totals-label">@I18n.T("Total Charged"):</span>
                                        <strong class="totals-value net-val">@I18n.FormatCurrency(netPayable)</strong>
                                    </div>
                                }
                            </div>

                            <!-- Footer Actions within the preview card -->
                            <div class="diag-preview-footer-actions">
                                <button class="btn btn-secondary diag-submit-btn diag-btn-save" type="button" @onclick="() => SaveBillAsync(false)" disabled="@saving" title="@I18n.T("Save bill into database without printing")">
                                    💾 @(saving
                                        ? I18n.T("Saving…")
                                        : isIpdMode
                                            ? (editor.ID == 0 ? I18n.T("Post to IPD Bill") : I18n.T("Update IPD Charge"))
                                            : (editor.ID == 0 ? I18n.T("Save OPD Bill") : I18n.T("Update OPD Bill")))
                                </button>

                                <button class="btn btn-primary diag-submit-btn diag-btn-print" type="button" @onclick="() => SaveBillAsync(true)" disabled="@saving" title="@I18n.T("Save bill and immediately print invoice")">
                                    🖨 @(saving
                                        ? I18n.T("Saving & Printing…")
                                        : isIpdMode ? I18n.T("Post & Print Memo") : I18n.T("Save & Print Receipt"))
                                </button>

                                <div class="diag-sub-actions">
                                    @if (editor.ID > 0)
                                    {
                                        <button class="btn btn-secondary tickets-btn" type="button" @onclick="PrintTubeLabelsAsync" style="background:#0f766e; border-color:#0f766e; color:#fff;" title="@I18n.T("Print Specimen Labels")">
                                            🏷 @I18n.T("Stickers")
                                        </button>
                                        <button class="btn btn-ghost tickets-btn" type="button" @onclick="DeleteAsync" style="color: #dc2626;" title="@I18n.T("Delete Bill")">
                                            🗑 @I18n.T("Delete")
                                        </button>
                                    }
                                    <button class="btn btn-ghost tickets-btn diag-btn-clear" type="button" @onclick="Reset" title="@I18n.T("Clear Form")">
                                        ✕ @I18n.T("Clear")
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
</div>

<!-- ==========================================================================
     Recent Diagnostic Bills & Doctor Orders Pop-up Modal Dialog
     ========================================================================== -->
@if (showRecentBillsModal)
{
    <div class="diag-modal-backdrop" @onclick="CloseRecentBillsModal">
        <div class="diag-modal-dialog" @onclick:stopPropagation="true">
            <div class="diag-modal-header">
                <div class="diag-modal-title-group">
                    <span class="diag-modal-icon">📋</span>
                    <div>
                        <h3 class="diag-modal-title">@I18n.T("Recent Diagnostic Bills & Doctor Orders")</h3>
                        <span class="diag-modal-subtitle">@I18n.T("Search, filter, reprint or load diagnostic cash memos") &bull; @DateTime.Today.ToString("dd MMMM yyyy")</span>
                    </div>
                </div>
                <button type="button" class="diag-modal-close-btn" @onclick="CloseRecentBillsModal" title="@I18n.T("Close")">✕</button>
            </div>

            <div class="diag-modal-toolbar">
                <div class="diag-modal-search-box">
                    <span class="search-icon"><SearchIcon /></span>
                    <input type="text"
                           class="classic-input diag-modal-search-input"
                           placeholder="@I18n.T("Search by Memo #, Patient Name, Patient ID, Mobile or Barcode...")"
                           @bind="modalSearchQuery"
                           @bind:event="oninput"
                           @onkeydown="HandleModalScanKeyDown"
                           autofocus />
                    @if (!string.IsNullOrWhiteSpace(modalSearchQuery))
                    {
                        <button type="button" class="search-clear-btn" @onclick="() => modalSearchQuery = string.Empty">✕</button>
                    }
                </div>

                <div class="diag-modal-tabs">
                    <button type="button" class="diag-modal-tab @(modalTab == "all" ? "active" : "")" @onclick='() => modalTab = "all"'>
                        🔬 @I18n.T("All Bills") (@recentMemos.Count)
                    </button>
                    <button type="button" class="diag-modal-tab @(modalTab == "due" ? "active" : "")" @onclick='() => modalTab = "due"'>
                        ⚠️ @I18n.T("With Due") (@recentMemos.Count(m => (m.Total - m.Discount) > m.Paid))
                    </button>
                    @if (pendingOrders.Count > 0)
                    {
                        <button type="button" class="diag-modal-tab doctor-orders-tab @(modalTab == "orders" ? "active" : "")" @onclick='() => modalTab = "orders"'>
                            ⚡ @I18n.T("Doctor Orders") (@pendingOrders.Count)
                        </button>
                    }
                </div>
            </div>

            <div class="diag-modal-body">
                @if (modalTab == "orders")
                {
                    var orders = FilteredModalOrders.ToList();
                    @if (orders.Count == 0)
                    {
                        <div class="diag-modal-empty">
                            <span class="empty-icon">⚡</span>
                            <h4>@I18n.T("No pending doctor orders.")</h4>
                        </div>
                    }
                    else
                    {
                        <div class="diag-modal-orders-grid">
                            @foreach (var order in orders)
                            {
                                <div class="diag-modal-order-card @(activeOrderId == order.ID ? "active" : "")" @onclick="() => LoadOrderFromModalAsync(order.ID)">
                                    <div class="order-card-header">
                                        <span class="badge" style="background:#fef3c7; color:#b45309; font-weight:800;">#@order.ID</span>
                                        <strong>@order.PatientName</strong>
                                        @if (!string.IsNullOrWhiteSpace(order.PatientID))
                                        {
                                            <span class="pid-badge">@order.PatientID</span>
                                        }
                                    </div>
                                    <div class="order-card-meta">
                                        <span>👨‍⚕️ @DoctorName(order.DoctorID)</span>
                                        <span>🧪 @order.Items.Count @I18n.T("test(s)")</span>
                                        <span>🕒 @order.OrderedAt.ToString("dd MMM hh:mm tt")</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(order.ClinicalNotes))
                                    {
                                        <div class="order-card-notes">@order.ClinicalNotes</div>
                                    }
