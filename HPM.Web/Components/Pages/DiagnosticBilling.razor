    private async Task SmartSearchPatientAsync(string lookup)
    {
        if (string.IsNullOrWhiteSpace(lookup)) return;
        lookup = lookup.Trim();

        await using var db = await DbFactory.CreateDbContextAsync();

        // 1. First check if there is an ACTIVE IPD admission by PatientID or RegNo
        var activeAdmission = await db.PatientAdmissions.AsNoTracking()
            .OrderByDescending(x => x.AdmissionDate)
            .FirstOrDefaultAsync(x => x.PatientID == lookup && x.IsAdmitted == true);

        if (activeAdmission == null)
        {
            activeAdmission = await db.PatientAdmissions.AsNoTracking()
                .OrderByDescending(x => x.AdmissionDate)
                .FirstOrDefaultAsync(x => x.RegNo == lookup && x.IsAdmitted == true);
        }

        Registration? p = null;

        if (activeAdmission != null)
        {
            if (!string.IsNullOrWhiteSpace(activeAdmission.PatientID))
            {
                p = await db.Registrations.AsNoTracking().FirstOrDefaultAsync(x => x.PatientID == activeAdmission.PatientID);
            }
        }
        else
        {
            // Search Registration by PatientID first (direct seek), then by Contact
            p = await db.Registrations.AsNoTracking().FirstOrDefaultAsync(x => x.PatientID == lookup);
            if (p == null)
            {
                p = await db.Registrations.AsNoTracking().FirstOrDefaultAsync(x => x.Contact == lookup);
            }

            if (p is null && lookup.StartsWith("0") && lookup.Length >= 10)
            {
                var withoutZero = lookup[1..];
                p = await db.Registrations.AsNoTracking()
                    .Where(x => x.Contact != null && x.Contact.EndsWith(withoutZero))
                    .OrderByDescending(x => x.ID)
                    .FirstOrDefaultAsync();
            }

            // If patient was found, check if this patient has an active admission in IPD!
            if (p != null && !string.IsNullOrWhiteSpace(p.PatientID))
            {
                activeAdmission = await db.PatientAdmissions.AsNoTracking()
                    .OrderByDescending(x => x.AdmissionDate)
                    .FirstOrDefaultAsync(x => x.PatientID == p.PatientID && x.IsAdmitted == true);
            }
        }

        // === CASE A: PATIENT IS CURRENTLY ADMITTED IN IPD! ===
        if (activeAdmission != null)
        {
            if (canAccessIpd)
            {
                currentPatientType = "2";
                editor.PatientType = "2";
                editor.RegNo = activeAdmission.RegNo;
                editor.PatientID = activeAdmission.PatientID ?? p?.PatientID ?? lookup;
                editor.PatientName = p?.Name ?? editor.PatientName;
                editor.Sex = p?.Sex ?? editor.Sex;
                editor.Contact = p?.Contact ?? editor.Contact;

                if (p?.DateOfBirth.HasValue == true)
                {
                    var years = DateTime.Today.Year - p.DateOfBirth.Value.Year;
                    editor.Age = $"{Math.Max(0, years)}Y";
                }
                else if (!string.IsNullOrWhiteSpace(activeAdmission.Age))
                {
                    editor.Age = activeAdmission.Age;
                }

                var bed = activeAdmission.BedCabinID.HasValue
                    ? await db.BedCabins.AsNoTracking().FirstOrDefaultAsync(x => x.ID == activeAdmission.BedCabinID.Value)
                    : null;
                editor.Bed = bed?.Name;
                editor.DoctorID = activeAdmission.Consultant ?? activeAdmission.ReferredBy ?? editor.DoctorID;
                SyncDoctorSearchFromSelection();

                PatientSelection.Select(editor.PatientID);
                RecalculateTotals();
                showPatientIdSuggestions = false;

                Success(I18n.IsBangla
                    ? $"🛏️ রোগী বর্তমানে আইপিডি-তে ভর্তি রয়েছেন (রেজি: {activeAdmission.RegNo}, কেবিন/বেড: {editor.Bed ?? "N/A"})"
                    : $"🛏️ Patient is currently admitted in IPD (Reg: {activeAdmission.RegNo}, Bed: {editor.Bed ?? "N/A"})");
                return;
            }
            else
            {
                // Patient has admission record, but current user / counter has NO IPD access -> Stay in OPD mode!
                currentPatientType = "1";
                editor.PatientType = "1";
                editor.RegNo = null;
                editor.Bed = null;
                editor.PatientID = activeAdmission.PatientID ?? p?.PatientID ?? lookup;
                editor.PatientName = p?.Name ?? editor.PatientName;
                editor.Sex = p?.Sex ?? editor.Sex;
                editor.Contact = p?.Contact ?? editor.Contact;

                if (p?.DateOfBirth.HasValue == true)
                {
                    var years = DateTime.Today.Year - p.DateOfBirth.Value.Year;
                    editor.Age = $"{Math.Max(0, years)}Y";
                }
                else if (!string.IsNullOrWhiteSpace(activeAdmission.Age))
                {
                    editor.Age = activeAdmission.Age;
                }

                editor.DoctorID = activeAdmission.Consultant ?? activeAdmission.ReferredBy ?? editor.DoctorID;
                SyncDoctorSearchFromSelection();

                PatientSelection.Select(editor.PatientID);
                RecalculateTotals();
                showPatientIdSuggestions = false;

                Success(I18n.IsBangla
                    ? $"ℹ️ রোগী আইপিডি-তে ভর্তি (রেজি: {activeAdmission.RegNo}), তবে আইপিডি মডিউল অ্যাক্সেস না থাকায় ওপিডি মোডে লোড হয়েছে।"
                    : $"ℹ️ Patient is in IPD (Reg: {activeAdmission.RegNo}), loaded as OPD since IPD module access is disabled.");
                return;
            }
        }

        // === CASE B: PATIENT IS OPD (NOT ADMITTED) ===
        if (p != null)
        {
            currentPatientType = "1";
            editor.PatientType = "1";
            editor.RegNo = null;
            editor.Bed = null;

            editor.PatientID = p.PatientID;
            editor.PatientName = p.Name;
            editor.Sex = p.Sex;
            editor.Contact = p.Contact;

            if (p.DateOfBirth.HasValue)
            {
                var years = DateTime.Today.Year - p.DateOfBirth.Value.Year;
                editor.Age = $"{Math.Max(0, years)}Y";
            }
            else
            {
                editor.Age = string.Empty;
            }

            PatientSelection.Select(p.PatientID);
            RecalculateTotals();
            showPatientIdSuggestions = false;

            Success(I18n.IsBangla
                ? $"🏥 বহির্বিভাগ (OPD) রোগী {p.Name} লোড হয়েছে — ওপিডি বিলিং সক্রিয়।"
                : $"🏥 OPD Patient {p.Name} loaded — OPD billing active.");
            return;
        }

        // === CASE C: NOT FOUND ===
        Fail(I18n.IsBangla
            ? "কোনো নিবন্ধিত রোগী বা সক্রিয় আইপিডি ভর্তি রেকর্ড পাওয়া যায়নি।"
            : "No registered patient or active IPD admission record found.");
    }

