    private void HandleTestSearchKeyDown(KeyboardEventArgs e)
    {
        var list = FilteredTests.ToList();
        if (e.Key == "ArrowDown")
        {
            showTestSuggestions = true;
            if (list.Count > 0)
            {
                highlightedTestIndex = (highlightedTestIndex + 1) % list.Count;
            }
        }
        else if (e.Key == "ArrowUp")
        {
            showTestSuggestions = true;
            if (list.Count > 0)
            {
                highlightedTestIndex = (highlightedTestIndex - 1 + list.Count) % list.Count;
            }
        }
        else if (e.Key == "Enter")
        {
            if (showTestSuggestions && list.Count > 0 && highlightedTestIndex >= 0 && highlightedTestIndex < list.Count)
            {
                SelectTest(list[highlightedTestIndex]);
            }
            else if (selectedTestId > 0)
            {
                AddItem();
            }
        }
        else if (e.Key == "Escape")
        {
            showTestSuggestions = false;
        }
    }

