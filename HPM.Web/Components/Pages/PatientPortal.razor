@page "/patient"
@attribute [Authorize(Roles = RoleNames.Patient)]
@layout Layout.LoginLayout
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<AppUser> Users
@inject IJSRuntime JS
@inject HospitalLicenseService Licenses
@using System.Security.Claims
@using HPM.Web.Data
@using HPM.Web.Data.Entities
@using HPM.Web.Security
@using Microsoft.EntityFrameworkCore

<PageTitle>My Patient Portal | @Branding.HospitalName</PageTitle>

<div class="patient-portal">
    <header class="patient-portal-header">
        <div><h1>@Branding.HospitalName</h1></div>
        <form method="post" action="/patient/logout"><AntiforgeryToken /><button type="submit">Sign out</button></form>
    </header>

    @if (!string.IsNullOrWhiteSpace(message)) { <div class="patient-portal-message @(isError ? "error" : "success")" role="status">@message</div> }

    @if (loading)
    {
        <div class="portal-skeleton-wrap" role="status" aria-label="Loading your records">
            <div class="patient-portal-welcome portal-skeleton-welcome">
                <div style="display:grid;gap:8px;flex:1">
                    <div class="portal-skeleton-line lg"></div>
                    <div class="portal-skeleton-line md"></div>
                </div>
                <div class="patient-portal-stats">
                    <div class="portal-skeleton-pill"></div>
                    <div class="portal-skeleton-pill"></div>
                    <div class="portal-skeleton-pill"></div>
                </div>
            </div>
            <div class="portal-skeleton-tabs">
                <div class="portal-skeleton-tab"></div>
                <div class="portal-skeleton-tab"></div>
                <div class="portal-skeleton-tab"></div>
                <div class="portal-skeleton-tab"></div>
            </div>
            <div class="patient-portal-grid">
                <section class="patient-portal-card">
                    <div class="portal-skeleton-line title"></div>
                    <div class="portal-skeleton-row"></div>
                    <div class="portal-skeleton-row"></div>
                    <div class="portal-skeleton-row"></div>
                </section>
                <section class="patient-portal-card">
                    <div class="portal-skeleton-line title"></div>
                    <div class="portal-skeleton-row"></div>
                    <div class="portal-skeleton-row"></div>
                    <div class="portal-skeleton-row"></div>
                </section>
            </div>
        </div>
    }
    else if (patient is null) { <div class="patient-portal-card">Your patient account could not be verified. Please sign in again or contact reception.</div> }
    else
    {
        <section class="patient-portal-welcome">
            <div>
                <h2>@patient.Name</h2>
                <span>Patient ID: @patient.PatientID</span>
            </div>
            <div class="patient-portal-stats">
                <span><b>@diagnosticBills.Count</b> Bills</span>
                <span><b>@diagnosticBills.Count(x => x.IsPublished)</b> Reports</span>
                <span><b>@appointments.Count</b> Appointments</span>
                <span><b>@prescriptions.Count</b> Prescriptions</span>
            </div>
        </section>
        <nav class="patient-portal-tabs" aria-label="Patient portal sections">
            @foreach (var tab in PortalTabs)
            { <button class="@(activeTab == tab.Item1 ? "active" : null)" @onclick="() => activeTab = tab.Item1">@tab.Item2</button> }
        </nav>

        @if (activeTab == "reports")
        {
            <section class="patient-portal-card">
                <div class="portal-card-head">
                    <h3>🧪 Diagnostic Tests & Report Roadmap</h3>
                </div>

                @if (diagnosticBills.Count == 0)
                {
                    <div class="portal-empty-box">No diagnostic tests billed yet.</div>
                }
                else
                {
                    <div class="roadmap-list">
                        @foreach (var bill in diagnosticBills)
                        {
                            <div class="roadmap-row @(bill.IsPublished ? "is-published" : "")">
                                <div class="roadmap-row-head">
                                    <div class="roadmap-bill-meta">
                                        <div class="roadmap-bill-title">
                                            <strong>Bill #@bill.Memo.ID</strong>
                                            <span class="roadmap-type-pill @(bill.IsImaging ? "imaging" : "pathology")">
                                                @if (bill.IsImaging)
                                                {
                                                    <span style="display:inline-flex; align-items:center; gap:4px;"><RadiologyIcon Size="13" /> Imaging</span>
                                                }
                                                else
                                                {
                                                    <span>🔬 Pathology</span>
                                                }
                                            </span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(bill.TestSummary))
                                        {
                                            <div class="report-test-tags">@bill.TestSummary</div>
                                        }
                                        <span class="roadmap-bill-date">Billed: @bill.Memo.TransDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                                    </div>

                                    <div class="roadmap-action-col">
                                        @if (bill.IsPublished)
                                        {
                                            <a class="report-open-btn" href="/portal/report/@bill.Memo.ID" target="_blank">
                                                👁️ View / PDF
                                            </a>
                                        }
                                        else
                                        {
                                            <button type="button" class="report-open-btn disabled" disabled title="@bill.ResultStatusText">
                                                🔒 @bill.ResultStatusText
                                            </button>
                                        }
                                    </div>
                                </div>

                                <div class="roadmap-stepper" aria-label="Test progress roadmap">
                                    <div class="roadmap-step @(bill.SampleDone ? "done" : "current")">
                                        <span class="step-dot">@(bill.SampleDone ? "✓" : "1")</span>
                                        <div class="step-copy">
                                            <strong>@(bill.IsImaging ? "Study Intake" : "Sample Collect")</strong>
                                            <small>@(bill.SampleCollectedAt.HasValue ? bill.SampleCollectedAt.Value.ToString("dd MMM, hh:mm tt") : bill.SampleLabel)</small>
                                        </div>
                                    </div>

                                    <div class="roadmap-connector @(bill.SampleDone ? "done" : "")"></div>

                                    <div class="roadmap-step @(bill.IsPublished ? "done" : bill.SampleDone ? "current" : "")">
                                        <span class="step-dot">@(bill.IsPublished ? "✓" : "2")</span>
                                        <div class="step-copy">
                                            <strong>Est. Result Time</strong>
                                            <small>@bill.EstimatedResultAt.ToString("dd MMM, hh:mm tt")</small>
                                        </div>
                                    </div>

                                    <div class="roadmap-connector @(bill.IsPublished ? "done" : "")"></div>

                                    <div class="roadmap-step @(bill.IsPublished ? "done" : "")">
                                        <span class="step-dot">@(bill.IsPublished ? "✓" : "3")</span>
                                        <div class="step-copy">
                                            <strong>Result</strong>
                                            <small class="@(bill.IsPublished ? "status-ready" : "status-pending")">@bill.ResultStatusText</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
        }
        else if (activeTab == "doctors")
        {
            <section class="patient-portal-card">
                <div class="portal-card-head">
                    <h3>🩺 Book Doctor Appointment</h3>
                </div>

                @if (selectedDoctorId > 0)
                {
                    <div class="booking-box" style="margin-top:0; margin-bottom:14px; border:1.5px solid #0f766e;">
                        <div style="display:flex; justify-content:space-between; align-items:center; gap:8px; margin-bottom:8px;">
                            <h4 style="margin:0;">📅 @DoctorName(selectedDoctorId)</h4>
                            <button type="button" class="text-button" style="padding:0;" @onclick="() => selectedDoctorId = 0">Change</button>
                        </div>
                        <label>Appointment Date <InputDate @bind-Value="bookingDate" /></label>
                        <button type="button" class="primary" disabled="@bookingSaving" @onclick="BookAppointmentAsync">
                            @(bookingSaving ? "Booking..." : "Confirm Appointment")
                        </button>
                    </div>
                }

                <input class="portal-search" @bind="doctorSearch" @bind:event="oninput" placeholder="Search doctor name, degree or department..." />
                <div class="doctor-results">
                    @foreach (var doctor in FilteredDoctors.Take(30))
                    {
                        <article class="@(selectedDoctorId == doctor.ID ? "selected-doc" : "")">
                            <div>
                                <b>@DoctorName(doctor.ID)</b>
                                <span>@DepartmentName(doctor.Department)@(!string.IsNullOrWhiteSpace(doctor.Degree) ? $" · {doctor.Degree}" : "")</span>
                                <small>
                                    🕒 @(doctor.ConsultationTime ?? "Contact reception")
                                    @if (doctor.ConsultationFee.HasValue && doctor.ConsultationFee.Value > 0)
                                    {
                                        <text> &bull; Fee: ৳@doctor.ConsultationFee.Value.ToString("N0")</text>
                                    }
                                </small>
                            </div>
                            <button type="button" @onclick="() => SelectDoctor(doctor.ID)">@(selectedDoctorId == doctor.ID ? "Selected" : "Book")</button>
                        </article>
                    }
                    @if (!FilteredDoctors.Any())
                    {
                        <div class="portal-empty-box">No doctors found matching your search.</div>
                    }
                </div>
            </section>
        }
        else if (activeTab == "appointments")
        {
            <section class="patient-portal-card">
                <div class="portal-card-head">
                    <h3>📅 My Appointments</h3>
                    <button type="button" class="report-open-btn" @onclick='() => activeTab = "doctors"'>+ Book Appointment</button>
                </div>
                @foreach (var a in appointments)
                {
                    <div class="record">
                        <b>@DoctorName(a.DoctorID) · Serial #@a.ApptSLNO</b>
                        <span>@a.ApptDate.ToString("dd MMM yyyy") · @a.Status</span>
                    </div>
                }
                @if (appointments.Count == 0) { <p>No appointments yet.</p> }
            </section>
        }
        else if (activeTab == "documents")
        {
            <div class="patient-portal-grid">
                <section class="patient-portal-card"><h3>Signed prescriptions</h3>@foreach (var rx in prescriptions) { <div class="record"><b>Prescription #@rx.ID</b><span>@(rx.SignedAt ?? rx.VisitDate)?.ToString("dd MMM yyyy")</span><a href="/patient/document/prescription/@rx.ID" target="_blank">View / print prescription</a></div> }@if (prescriptions.Count == 0) { <p>No signed prescriptions available.</p> }</section>
                <section class="patient-portal-card"><h3>Discharge documents</h3>@foreach (var d in discharges) { <div class="record"><b>Discharge #@d.BillNo</b><span>@d.DischargeDate.ToString("dd MMM yyyy")</span><a href="/patient/document/discharge/@d.BillNo" target="_blank">View / print discharge document</a></div> }@if (discharges.Count == 0) { <p>No completed discharge documents available.</p> }</section>
            </div>
        }
    }
</div>

@code {
    private sealed record PortalDiagnosticBillItem(
        CashMemoDInvestigation Memo,
        string TestSummary,
        bool IsImaging,
        bool SampleDone,
        DateTime? SampleCollectedAt,
        string SampleLabel,
        DateTime EstimatedResultAt,
        bool IsPublished,
        string ResultStatusText);

    private Registration? patient;
    private bool loading = true, bookingSaving, isError;
    private string activeTab = "reports", message = "", doctorSearch = "";
    private int selectedDoctorId, userId;
    private DateTime bookingDate = DateTime.Today.AddDays(1);
    private List<DoctorsProfile> doctors = [];
    private Dictionary<int, string> departments = [];
    private List<DoctorAppointment> appointments = [];
    private List<Prescription> prescriptions = [];
    private List<PortalDiagnosticBillItem> diagnosticBills = [];
    private List<IpdFinalBill> discharges = [];
    private IEnumerable<(string, string)> PortalTabs
    {
        get
        {
            yield return ("reports", "Test Roadmap & Reports");
            yield return ("doctors", "Book Appointment");
            yield return ("appointments", "My Appointments");
            yield return ("documents", "Prescriptions & Discharge");
        }
    }
    private IEnumerable<DoctorsProfile> FilteredDoctors => doctors.Where(x => string.IsNullOrWhiteSpace(doctorSearch) || (x.Name?.Contains(doctorSearch, StringComparison.OrdinalIgnoreCase) ?? false) || (x.Degree?.Contains(doctorSearch, StringComparison.OrdinalIgnoreCase) ?? false) || DepartmentName(x.Department).Contains(doctorSearch, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        var principal = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        int.TryParse(principal.FindFirstValue(ClaimTypes.NameIdentifier), out userId);
        await using var db = await DbFactory.CreateDbContextAsync();
        var patientId = await PatientPortalAccess.CurrentPatientIdAsync(principal, Users, db);
        if (patientId is null) { patient = null; loading = false; return; }
        patient = await db.Registrations.AsNoTracking().Where(x => x.PatientID == patientId).SelectWithoutPhoto().SingleOrDefaultAsync();
        if (patient is null) { loading = false; return; }

        doctors = await db.Doctors.AsNoTracking().Where(x => x.IsActive).OrderBy(x => x.Name).ToListAsync();
        departments = await db.Departments.AsNoTracking().ToDictionaryAsync(x => x.ID, x => x.Name);
        appointments = await db.DoctorAppointments.AsNoTracking().Where(x => x.PatientID == patientId).OrderByDescending(x => x.ApptDate).Take(100).ToListAsync();
        prescriptions = await db.Prescriptions.AsNoTracking().Include(x => x.Medicines).Where(x => x.PatientID == patientId && x.Status == "Signed").OrderByDescending(x => x.SignedAt).Take(50).ToListAsync();

        var memos = await db.EmergencyMemos.AsNoTracking()
            .Include(x => x.Items)
            .Where(x => x.PatientID == patientId && (x.ModuleID == 2 || x.ModuleID == 11))
            .OrderByDescending(x => x.TransDate)
            .Take(100)
            .ToListAsync();
        var memoIds = memos.Select(x => x.ID).ToList();
        var results = memoIds.Count > 0
            ? await db.LabTestResults.AsNoTracking().Where(x => memoIds.Contains(x.MemoID) && x.Status == "Active").ToListAsync()
            : [];
        var samples = memoIds.Count > 0
            ? await db.LabSampleCollections.AsNoTracking().Where(x => memoIds.Contains(x.MemoID)).ToListAsync()
            : [];
        var serviceIds = memos.SelectMany(m => m.Items.Select(i => i.TestID))
            .Concat(results.Select(r => r.ServiceID))
            .Concat(samples.Select(s => s.ServiceID))
            .Distinct()
            .ToList();
        var servicesById = serviceIds.Count > 0
            ? await db.Services.AsNoTracking().Where(x => serviceIds.Contains(x.ID)).ToDictionaryAsync(x => x.ID)
            : [];
        var categoriesById = await db.ServiceCategories.AsNoTracking().ToDictionaryAsync(x => x.ID);

        diagnosticBills = [];
        foreach (var memo in memos)
        {
            var ownResults = results.Where(r => r.MemoID == memo.ID).ToList();
            var ownSamples = samples.Where(s => s.MemoID == memo.ID).ToList();
            var memoServiceIds = memo.Items.Select(i => i.TestID)
                .Concat(ownResults.Select(r => r.ServiceID))
                .Concat(ownSamples.Select(s => s.ServiceID))
                .Distinct()
                .ToList();
            var ownServices = memoServiceIds
                .Select(sid => servicesById.TryGetValue(sid, out var svc) ? svc : null)
                .Where(s => s is not null)
                .ToList();

            var testNames = string.Join(", ", ownServices.Select(s => s!.Name).Where(n => !string.IsNullOrWhiteSpace(n)).Distinct());
            var isImaging = ownServices.Any(s =>
            {
                var cat = s!.CategoryID.HasValue ? categoriesById.GetValueOrDefault(s.CategoryID.Value) : null;
                return DiagnosticTestRouting.IsImaging(s, cat);
            });

            var collectedDates = ownSamples.Where(s => s.CollectedAt.HasValue).Select(s => s.CollectedAt!.Value).ToList();
            DateTime? sampleCollectedAt = collectedDates.Count > 0 ? collectedDates.Max() : null;
            var sampleDone = sampleCollectedAt.HasValue || ownResults.Count > 0 || isImaging;
            var sampleLabel = sampleCollectedAt.HasValue
                ? sampleCollectedAt.Value.ToString("dd MMM, hh:mm tt")
                : (isImaging ? memo.TransDate.ToString("dd MMM, hh:mm tt") : "Pending Collect");

            var maxDeliveryHours = ownServices.Select(s => s!.DeliveryHours ?? 0).DefaultIfEmpty(0).Max();
            var estHours = maxDeliveryHours > 0 ? maxDeliveryHours : (isImaging ? 2 : 4);
            var baseTime = sampleCollectedAt ?? memo.TransDate;
            var estimatedResultAt = baseTime.AddHours(estHours);

            var released = memo.Paid >= memo.Total - memo.Discount - 0.01m || (!string.IsNullOrWhiteSpace(memo.Remarks) && (memo.Remarks.Contains("[AUTH_RELEASE]", StringComparison.OrdinalIgnoreCase) || memo.Remarks.Contains("Authorized Release", StringComparison.OrdinalIgnoreCase)));
            var isVerified = ownResults.Count > 0 && ownResults.All(r => r.IsVerified && !string.IsNullOrWhiteSpace(r.ResultValue));
            var isPublished = released && isVerified;

            var statusText = isPublished
                ? "Published"
                : isVerified && !released
                    ? "Payment Due"
                    : ownResults.Count > 0
                        ? "Verifying"
                        : sampleCollectedAt.HasValue
                            ? "Processing"
                            : isImaging ? "In Queue" : "Pending";

            diagnosticBills.Add(new PortalDiagnosticBillItem(
                memo,
                testNames,
                isImaging,
                sampleDone,
                sampleCollectedAt,
                sampleLabel,
                estimatedResultAt,
                isPublished,
                statusText));
        }

        var admissionIds = await db.PatientAdmissions.AsNoTracking().Where(x => x.PatientID == patientId).Select(x => x.ID).ToListAsync();
        var completedOrders = admissionIds.Count > 0 ? await db.IpdMedicalDischargeOrders.AsNoTracking().Where(x => admissionIds.Contains(x.AdmissionID) && x.Status == "Completed").OrderByDescending(x => x.OrderedAt).ToListAsync() : [];
        var completedOrderIds = completedOrders.Select(x => (long?)x.ID).ToList();
        discharges = completedOrderIds.Count > 0 ? await db.IpdFinalBills.AsNoTracking().Where(x => admissionIds.Contains(x.AdmissionID) && completedOrderIds.Contains(x.MedicalDischargeOrderID)).OrderByDescending(x => x.DischargeDate).Take(50).ToListAsync() : [];
        loading = false;
    }

    private void SelectDoctor(int id) { selectedDoctorId = id; activeTab = "doctors"; }
    private async Task BookAppointmentAsync()
    {
        if (bookingSaving) return;
        if (patient is null || selectedDoctorId <= 0 || bookingDate.Date < DateTime.Today || bookingDate.Date > DateTime.Today.AddDays(90))
        {
            Fail("Choose an appointment date within the next 90 days.");
            return;
        }
        bookingSaving = true;
        var patientId = patient.PatientID;
        try
        {
            await using var strategyDb = await DbFactory.CreateDbContextAsync();
            await strategyDb.Database.CreateExecutionStrategy().ExecuteAsync(async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                var principal = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
                if (await PatientPortalAccess.CurrentPatientIdAsync(principal, Users, db) != patientId)
                    throw new InvalidOperationException("Your patient session is no longer valid.");
                var doctor = await db.Doctors.AsNoTracking().SingleOrDefaultAsync(x => x.ID == selectedDoctorId && x.IsActive);
                if (doctor is null)
                    throw new InvalidOperationException("Selected doctor is not available.");
                await using var transaction = await db.Database.BeginTransactionAsync(System.Data.IsolationLevel.ReadCommitted);
                await SqlServerConcurrency.AcquireTransactionLockAsync(db, $"HPM:Appointment:{selectedDoctorId}:{bookingDate:yyyyMMdd}");
                var dayEnd = bookingDate.Date.AddDays(1);
                if (await db.DoctorAppointments.AnyAsync(x => x.PatientID == patientId && x.DoctorID == selectedDoctorId && x.ApptDate >= bookingDate.Date && x.ApptDate < dayEnd && x.Status != "Cancelled"))
                    throw new InvalidOperationException("You already have an appointment with this doctor on this date.");
                var serial = (await db.DoctorAppointments.Where(x => x.DoctorID == selectedDoctorId && x.ApptDate >= bookingDate.Date && x.ApptDate < dayEnd).MaxAsync(x => (int?)x.ApptSLNO) ?? 0) + 1;
                var contact = patient.Contact?.Trim();
                if (!string.IsNullOrEmpty(contact) && contact.Length > 20) contact = contact[..20];
                string? ageText = null;
                if (patient.DateOfBirth.HasValue)
                {
                    var yrs = Math.Max(0, (int)((DateTime.Today - patient.DateOfBirth.Value.Date).TotalDays / 365.25));
                    ageText = $"{yrs} Y";
                }
                var entity = new DoctorAppointment
                {
                    PatientID = patientId,
                    Name = patient.Name,
                    Age = ageText,
                    Sex = patient.Sex,
                    Weight = patient.Weight,
                    ContactNo = contact,
                    DoctorID = selectedDoctorId,
                    ApptDate = bookingDate.Date,
                    ApptSLNO = serial,
                    Status = "Booked",
                    EnteredBy = userId,
                    TransDate = DateTime.Now
                };
                db.DoctorAppointments.Add(entity);
                await db.SaveChangesAsync();
                db.AuditLogs.Add(new AuditLog { UserID = userId, UserName = patientId, Action = "Create", EntityName = "PatientPortalAppointment", EntityID = entity.ID.ToString(), EventTime = DateTime.UtcNow });
                await db.SaveChangesAsync();
                await transaction.CommitAsync();
            });
            selectedDoctorId = 0;
            message = "Appointment booked successfully.";
            isError = false;
            activeTab = "appointments";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Fail(ex is InvalidOperationException ? ex.Message : ex.GetBaseException().Message);
        }
        finally
        {
            bookingSaving = false;
        }
    }

    private string DoctorName(int id) { var doctor = doctors.FirstOrDefault(x => x.ID == id); return doctor is null ? $"Doctor #{id}" : $"{doctor.Title} {doctor.Name}".Trim(); }
    private string DepartmentName(int? id) => id.HasValue && departments.TryGetValue(id.Value, out var name) ? name : "General";
    private void Fail(string text) { message = text; isError = true; }
}
