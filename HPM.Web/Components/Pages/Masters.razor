@page "/masters"
@attribute [Authorize(Roles = RoleNames.Administrator)]
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>@I18n.T("Master Setups", "Master Setup") | @Branding.HospitalName</PageTitle>

<div class="page-heading">
    <div>
        <span class="eyebrow">@I18n.T("System Admin", "Administration")</span>
        <h1>@I18n.T("Master setup", "Master setup")</h1>
        <p>@I18n.T("Maintain OPD, Emergency, Diagnostic and IPD reference data.", "Maintain OPD, Emergency and IPD reference data.")</p>
    </div>
</div>

<div class="master-grid">
    <a class="master-card" href="masters/doctors"><span class="module-icon blue">DR</span><b>@I18n.T("Doctors Profile Directory", "Doctors Profile")</b><p>@I18n.T("Consultant name, degree, department, room and contact information.", "Consultant name, degree, department, room and contact information.")</p></a>
    <a class="master-card" href="masters/clinical"><span class="module-icon violet">CL</span><b>@I18n.T("Clinical Masters", "Clinical Masters")</b><p>@I18n.T("Departments and consultation ticket types with rates.", "Departments and consultation ticket types with rates.")</p></a>
    <a class="master-card" href="masters/services"><span class="module-icon teal">SV</span><b>@I18n.T("Service Masters", "Service Masters")</b><p>@I18n.T("Emergency/OT service categories, service names and sale rates.", "Emergency/OT service categories, service names and sale rates.")</p></a>
    <a class="master-card" href="masters/ipd"><span class="module-icon blue">IPD</span><b>@I18n.T("IPD & Bed Setup", "IPD & Bed Setup")</b><p>@I18n.T("IPD departments, bed categories, rates, beds and cabins.", "IPD departments, bed categories, rates, beds and cabins.")</p></a>
    <a class="master-card" href="pharmacy/masters"><span class="module-icon amber">RX</span><b>@I18n.T("Pharmacy Masters", "Pharmacy Masters")</b><p>@I18n.T("Medicine brands, generics, dosage forms, suppliers and pricing.", "Medicine brands, generics, dosage forms, suppliers and pricing.")</p></a>
    <a class="master-card" href="reports"><span class="module-icon amber">RP</span><b>@I18n.T("Hospital Reports", "Reports")</b><p>@I18n.T("Date-range operational and financial summary for the five modules.", "Date-range operational and financial summary for the five modules.")</p></a>
    <a class="master-card" href="admin/users"><span class="module-icon violet">US</span><b>@I18n.T("Users & Roles", "Users & Roles")</b><p>@I18n.T("Create staff accounts, assign module permissions, reset passwords and unlock access.", "Create staff accounts, assign module permissions, reset passwords and unlock access.")</p></a>
    <a class="master-card" href="admin/audit"><span class="module-icon red">AU</span><b>@I18n.T("Audit Trail", "Audit Log")</b><p>@I18n.T("Review who created, changed or deleted operational records.", "Review who created, changed or deleted operational records.")</p></a>
</div>

@code {
    protected override void OnInitialized() => I18n.OnLanguageChanged += HandleLanguageChanged;
    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => I18n.OnLanguageChanged -= HandleLanguageChanged;
}
