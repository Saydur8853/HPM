@page "/login"
@attribute [AllowAnonymous]
@layout Layout.LoginLayout

<PageTitle>@I18n.T("Sign In") | @Branding.HospitalName</PageTitle>

<div class="login-card">
    <!-- Hospital Branding with Logo -->
    <div class="login-brand" style="display: flex; align-items: center; gap: 14px; padding-bottom: 18px; border-bottom: 1px solid #e2e8f0;">
        @if (!string.IsNullOrWhiteSpace(Branding.LogoData))
        {
            <img src="@Branding.LogoData" alt="Hospital Logo" style="max-height: 46px; max-width: 46px; object-fit: contain; border-radius: 8px; background: #ffffff; padding: 2px; border: 1px solid #e2e8f0; flex-shrink: 0;" />
        }
        else
        {
            <div style="width: 44px; height: 44px; border-radius: 10px; background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); color: #ffffff; display: grid; place-items: center; font-size: 20px; flex-shrink: 0;">
                🏥
            </div>
        }
        <div style="min-width: 0; flex: 1;">
            <strong style="font-size: 17px; font-weight: 800; color: #0f172a; display: block; line-height: 1.25; letter-spacing: -0.3px; word-break: break-word;">
                @Branding.HospitalName
            </strong>
            @if (!string.IsNullOrWhiteSpace(Branding.Tagline))
            {
                <small style="color: #64748b; font-size: 11px; display: block; margin-top: 2px; line-height: 1.2;">
                    @Branding.Tagline
                </small>
            }
        </div>
    </div>

    <!-- Clean Header -->
    <div class="login-heading" style="margin: 20px 0 16px;">
        <h1 style="font-size: 22px; font-weight: 800; color: #0f172a; margin: 0; letter-spacing: -0.4px;">
            @I18n.T("Sign In")
        </h1>
    </div>

    @if (Error == "1")
    {
        <div class="alert danger" style="margin-bottom: 16px; padding: 10px 14px; font-size: 12.5px;">
            ⚠️ @I18n.T("Invalid username or password.")
        </div>
    }
    @if (Setup == 1)
    {
        <div class="alert success" style="margin-bottom: 16px; padding: 10px 14px; font-size: 12.5px;">
            ✅ @I18n.T("Setup completed! Please sign in with your administrator account.")
        </div>
    }

    <!-- Login Form -->
    <form method="post" action="/account/login" class="login-form">
        <AntiforgeryToken />
        <input type="hidden" name="ReturnUrl" value="@SafeReturnUrl" />
        
        <label>
            <span style="font-size: 12px; font-weight: 700; color: #475569; margin-bottom: 6px;">@I18n.T("Username")</span>
            <input name="UserName" autocomplete="username" placeholder="@I18n.T("Enter username")" required autofocus style="min-height: 42px; font-size: 13.5px;" />
        </label>

        <label>
            <span style="font-size: 12px; font-weight: 700; color: #475569; margin-bottom: 6px;">@I18n.T("Password")</span>
            <div style="position: relative; display: flex; align-items: center; width: 100%;">
                <input id="login-password" name="Password" type="password" autocomplete="current-password" placeholder="@I18n.T("Enter password")" required style="min-height: 42px; font-size: 13.5px; padding-right: 42px; width: 100%;" />
                <button type="button" onclick="togglePasswordVisibility()" aria-label="Toggle password visibility" style="position: absolute; right: 6px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; padding: 6px 8px; color: #64748b; display: flex; align-items: center; justify-content: center; border-radius: 6px;">
                    <svg id="eye-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <svg id="eye-off-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                        <line x1="1" y1="1" x2="23" y2="23"></line>
                    </svg>
                </button>
            </div>
        </label>

        <label class="inline-check" style="display: flex; align-items: center; gap: 8px; margin: 2px 0 4px; cursor: pointer;">
            <input type="checkbox" name="RememberMe" value="true" style="width: 16px; height: 16px; min-height: unset; cursor: pointer;" />
            <span style="font-size: 12.5px; color: #475569; font-weight: 500; margin: 0;">@I18n.T("Keep me signed in")</span>
        </label>

        <button class="btn btn-primary login-button" type="submit" style="min-height: 42px; font-size: 14px; font-weight: 750;">
            @I18n.T("Sign In")
        </button>
    </form>
</div>

<script>
    function togglePasswordVisibility() {
        var input = document.getElementById('login-password');
        var eye = document.getElementById('eye-icon');
        var eyeOff = document.getElementById('eye-off-icon');
        if (!input || !eye || !eyeOff) return;
        if (input.type === 'password') {
            input.type = 'text';
            eye.style.display = 'none';
            eyeOff.style.display = 'block';
        } else {
            input.type = 'password';
            eye.style.display = 'block';
            eyeOff.style.display = 'none';
        }
    }
</script>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] public int? Setup { get; set; }
    private string SafeReturnUrl => string.IsNullOrWhiteSpace(ReturnUrl) || !ReturnUrl.StartsWith('/') || ReturnUrl.StartsWith("//") ? "/" : ReturnUrl;

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await Branding.LoadAsync();
        if (!Branding.IsSetupComplete)
            Navigation.NavigateTo("/setup", true);
    }
}
