@page "/login"
@attribute [AllowAnonymous]
@layout Layout.LoginLayout

<PageTitle>@I18n.T("Sign In") | @Branding.HospitalName</PageTitle>

<div class="login-split-layout">
    <div class="login-hero-pane">
        @if (!string.IsNullOrWhiteSpace(Branding.LogoData))
        {
            <img src="@Branding.LogoData" alt="Hospital Logo" class="login-hero-logo" />
        }
        else
        {
            <div class="login-hero-fallback">🏥</div>
        }
        <h1 class="login-hero-title">@Branding.HospitalName</h1>
        @if (!string.IsNullOrWhiteSpace(Branding.Tagline))
        {
            <p class="login-hero-motto">@Branding.Tagline</p>
        }
    </div>

    <div class="login-card login-swipe-left">
        <div class="login-mode-tabs" role="tablist" aria-label="Login mode">
            <span class="login-mode-tab active" role="tab" aria-selected="true">🏥 @I18n.T("Staff Login")</span>
            <a href="/patient/login" class="login-mode-tab" role="tab" aria-selected="false">👤 @I18n.T("Patient Portal")</a>
        </div>

        @if (Error == "1")
        {
            <div class="login-alert danger">⚠️ @I18n.T("Invalid username or password.")</div>
        }
        @if (Setup == 1)
        {
            <div class="login-alert success">✅ @I18n.T("Setup completed! Please sign in with your administrator account.")</div>
        }

        <form method="post" action="/account/login" class="login-form-modern">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@SafeReturnUrl" />

            <label class="login-field">
                <span>@I18n.T("Username")</span>
                <input class="login-input" name="UserName" autocomplete="username" placeholder="@I18n.T("Enter username")" required autofocus />
            </label>

            <label class="login-field">
                <span>@I18n.T("Password")</span>
                <div class="login-password-wrap">
                    <input id="login-password" class="login-input has-toggle" name="Password" type="password" autocomplete="current-password" placeholder="@I18n.T("Enter password")" required />
                    <button type="button" class="login-eye-btn" onclick="togglePasswordVisibility()" aria-label="Toggle password visibility">
                        <svg id="eye-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                        <svg id="eye-off-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                            <line x1="1" y1="1" x2="23" y2="23"></line>
                        </svg>
                    </button>
                </div>
            </label>

            <button class="login-submit-btn" type="submit">@I18n.T("Sign In")</button>
        </form>
    </div>
</div>

<script>
    function togglePasswordVisibility() {
        var input = document.getElementById('login-password');
        var eye = document.getElementById('eye-icon');
        var eyeOff = document.getElementById('eye-off-icon');
        if (!input || !eye || !eyeOff) return;
        if (input.type === 'password') {
            input.type = 'text';
            eye.style.display = 'none';
            eyeOff.style.display = 'block';
        } else {
            input.type = 'password';
            eye.style.display = 'block';
            eyeOff.style.display = 'none';
        }
    }
</script>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] public int? Setup { get; set; }
    private string SafeReturnUrl => string.IsNullOrWhiteSpace(ReturnUrl) || !ReturnUrl.StartsWith('/') || ReturnUrl.StartsWith("//") ? "/" : ReturnUrl;

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await Branding.LoadAsync();
        if (!Branding.IsSetupComplete)
            Navigation.NavigateTo("/setup", true);
    }
}
