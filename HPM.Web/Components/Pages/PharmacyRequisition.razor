@page "/pharmacy/requisition"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.PharmacyOperator)]
@using HPM.Web.Data
@using HPM.Web.Data.Entities
@using HPM.Web.Security
@using HPM.Web.Localization
@using HPM.Web.Components.Common
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject I18nService I18n
@inject HospitalSetupService Branding
@inject IJSRuntime JS
@inject IBarcodeQrService BarcodeQr
@implements IDisposable

<PageTitle>@I18n.T("Purchase Requisition") | @Branding.HospitalName</PageTitle>

<div class="pharm-subnav-bar">
    <div>
        <h1 style="margin:0; font-size:20px; font-weight:800; color:#0f172a;">@I18n.T("Purchase Requisition")</h1>
    </div>
    <div style="display:flex; gap:6px; align-items:center;">
        <NavLink class="btn btn-ghost btn-sm" href="/pharmacy/purchases">@I18n.T("Go to Purchase / Stock In") &rarr;</NavLink>
        <button class="btn btn-secondary btn-sm" @onclick="ResetForm">@I18n.T("New Requisition")</button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @messageClass" style="margin-bottom:12px;">@message</div>
}

<div class="module-layout">
    <div class="panel form-panel">
        <div class="panel-heading" style="padding:12px 18px;">
            <h2 style="font-size:15px; margin:0;">
                @(savedReq == null ? I18n.T("Create Requisition") : $"{savedReq.RequisitionNo}")
            </h2>
            @if (savedReq != null)
            {
                <span class="pill @(savedReq.Status == "Approved" ? "pill-success" : savedReq.Status == "Rejected" ? "pill-danger" : "pill-warning")">@savedReq.Status</span>
            }
        </div>

        @if (savedReq == null)
        {
            <div class="form-grid">
                <label>
                    <span>@I18n.T("Store") *</span>
                    <select @bind="storeId" disabled="@isSaving">
                        @foreach (var s in stores)
                        {
                            <option value="@s.ID">@s.Name</option>
                        }
                    </select>
                </label>
                <label>
                    <span>@I18n.T("Purpose / Note")</span>
                    <input type="text" @bind="remarks" placeholder="@I18n.T("e.g. Weekly stock refill")" disabled="@isSaving" />
                </label>
            </div>

            <div class="form-grid" style="grid-template-columns: 2fr 90px 100px 1.2fr auto; gap:8px; align-items:end;">
                <div class="pos-typeahead-wrapper">
                    <span style="font-size:12px; font-weight:600; color:#334155; display:block; margin-bottom:4px;">@I18n.T("Search Medicine") *</span>
                    <input type="text"
                           placeholder="@I18n.T("Type medicine name...")"
                           @bind="medSearchQuery"
                           @bind:event="oninput"
                           @onfocus="() => showMedDropdown = true" />
                    @if (showMedDropdown && FilteredMedicines.Any())
                    {
                        <div class="pos-med-dropdown" style="z-index:130;">
                            @foreach (var m in FilteredMedicines)
                            {
                                <div class="pos-med-item" @onmousedown:preventDefault @onclick="() => SelectMedicine(m)">
                                    <div class="pos-med-name">@m.Name</div>
                                    <span style="font-size:11px; font-weight:700; color:#0369a1;">TP: @I18n.FormatCurrency(m.BuyRate ?? 0)</span>
                                </div>
                            }
                        </div>
                    }
                </div>
                <label>
                    <span>@I18n.T("Qty") *</span>
                    <input type="number" @bind="selectedQty" min="1" step="1" disabled="@isSaving" />
                </label>
                <label>
                    <span>@I18n.T("Est. TP")</span>
                    <input type="number" @bind="selectedRate" min="0" step="0.01" disabled="@isSaving" />
                </label>
                <label>
                    <span>@I18n.T("Note")</span>
                    <input type="text" @bind="selectedItemRemarks" placeholder="@I18n.T("Optional")" disabled="@isSaving" />
                </label>
                <div>
                    <button class="btn btn-secondary" type="button" @onclick="AddLine" disabled="@isSaving">+ @I18n.T("Add")</button>
                </div>
            </div>

            <div class="data-table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@I18n.T("Medicine")</th>
                            <th class="num">@I18n.T("Qty")</th>
                            <th class="num">@I18n.T("Est. Rate")</th>
                            <th class="num">@I18n.T("Est. Total")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (lines.Count == 0)
                        {
                            <tr><td colspan="6"><div class="empty-state small">@I18n.T("Search and add medicines needed for purchase.")</div></td></tr>
                        }
                        @foreach (var (line, idx) in lines.Select((l, i) => (l, i + 1)))
                        {
                            <tr>
                                <td>@idx</td>
                                <td><b>@line.MedicineName</b></td>
                                <td class="num">@line.Qty</td>
                                <td class="num">@(line.Rate.HasValue ? I18n.FormatCurrency(line.Rate.Value) : "—")</td>
                                <td class="num">@(line.Rate.HasValue ? I18n.FormatCurrency(line.Qty * line.Rate.Value) : "—")</td>
                                <td style="text-align:right;"><button class="icon-btn" type="button" @onclick="() => RemoveLine(line)">✕</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="form-actions">
                <button class="btn btn-primary" @onclick="() => SubmitAsync(false)" disabled="@isSaving">
                    @(isSaving ? I18n.T("Saving...") : I18n.T("Submit Requisition"))
                </button>
                <button class="btn btn-secondary" @onclick="() => SubmitAsync(true)" disabled="@isSaving">
                    @I18n.T("Submit & Print A4")
                </button>
            </div>
        }
        else
        {
            <div style="margin:8px 18px; padding:10px 14px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; display:flex; flex-wrap:wrap; gap:8px 20px; font-size:12.5px;">
                <div><span class="text-muted">@I18n.T("Store"):</span> <b>@(stores.FirstOrDefault(s => s.ID == savedReq.StoreID)?.Name ?? "—")</b></div>
                <div><span class="text-muted">@I18n.T("Date"):</span> <b>@savedReq.TransDate.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")</b></div>
                @if (!string.IsNullOrWhiteSpace(savedReq.Remarks))
                {
                    <div><span class="text-muted">@I18n.T("Note"):</span> <b>@savedReq.Remarks</b></div>
                }
            </div>

            <div class="data-table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@I18n.T("Medicine")</th>
                            <th class="num">@I18n.T("Requested Qty")</th>
                            <th class="num">@I18n.T("Est. Rate")</th>
                            <th class="num">@I18n.T("Est. Total")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (item, idx) in savedReq.Items.Select((x, i) => (x, i + 1)))
                        {
                            <tr>
                                <td>@idx</td>
                                <td><b>@(medicines.FirstOrDefault(m => m.ID == item.ServiceID)?.Name ?? item.ServiceID.ToString())</b></td>
                                <td class="num">@item.RequestedQty</td>
                                <td class="num">@(item.EstimatedRate.HasValue ? I18n.FormatCurrency(item.EstimatedRate.Value) : "—")</td>
                                <td class="num">@(item.EstimatedRate.HasValue ? I18n.FormatCurrency(item.RequestedQty * item.EstimatedRate.Value) : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (isAdmin && savedReq.Status == "Pending")
            {
                <div class="form-grid">
                    <label class="span-2">
                        <span>@I18n.T("Approval / Review Note")</span>
                        <input type="text" @bind="reviewNote" placeholder="@I18n.T("Optional note")" />
                    </label>
                </div>
            }

            <div class="form-actions">
                @if (isAdmin && savedReq.Status == "Pending")
                {
                    <button class="btn btn-primary" @onclick="() => ReviewAsync(true)" disabled="@isSaving">@I18n.T("Approve")</button>
                    <button class="btn btn-danger" @onclick="() => ReviewAsync(false)" disabled="@isSaving">@I18n.T("Reject")</button>
                }
                @if (savedReq.Status == "Approved")
                {
                    <NavLink class="btn btn-primary" href="@($"/pharmacy/purchases?reqId={savedReq.ID}")">@I18n.T("Receive Stock for This Requisition") &rarr;</NavLink>
                }
                <button class="btn btn-secondary" @onclick="PrintRequisitionAsync">@I18n.T("Print A4 Requisition")</button>
            </div>
        }
    </div>

    <div class="panel">
        <div class="panel-heading" style="padding:12px 18px;">
            <h2 style="font-size:15px; margin:0;">@I18n.T("Recent Requisitions") (@recentList.Count)</h2>
        </div>
        <div style="padding:0 18px 10px;">
            <input type="search" @bind="searchTerm" @bind:event="oninput" placeholder="@I18n.T("Search REQ # or status...")" />
        </div>
        <div class="data-table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>@I18n.T("Req #")</th>
                        <th>@I18n.T("Date")</th>
                        <th>@I18n.T("Store")</th>
                        <th class="num">@I18n.T("Items")</th>
                        <th>@I18n.T("Status")</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in FilteredList)
                    {
                        <tr>
                            <td><b>@r.RequisitionNo</b></td>
                            <td>@r.TransDate.ToLocalTime().ToString("dd MMM yy")</td>
                            <td>@(stores.FirstOrDefault(s => s.ID == r.StoreID)?.Name ?? "—")</td>
                            <td class="num">@r.Items.Count</td>
                            <td><span class="pill @(r.Status == "Approved" ? "pill-success" : r.Status == "Rejected" ? "pill-danger" : "pill-warning")">@r.Status</span></td>
                            <td style="text-align:right;"><button class="icon-btn" @onclick="() => LoadReq(r)">@I18n.T("View / Print")</button></td>
                        </tr>
                    }
                    @if (!FilteredList.Any())
                    {
                        <tr><td colspan="6"><div class="empty-state small">@I18n.T("No requisitions found.")</div></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (savedReq != null)
{
    <!-- Official Printable A4 Purchase Requisition -->
    <div id="pharmacy-requisition-print" class="print-sheet panel print-document print-a4-sheet pharm-print-only">
        <PrintDocumentHeader Title="@I18n.T("Pharmacy Purchase Requisition")"
                             SubTitle="@I18n.T("Hospital Pharmacy Procurement")"
                             DocumentNo="@savedReq.RequisitionNo"
                             BarcodeCode="@savedReq.RequisitionNo" />

        <div class="print-grid">
            <div><span>@I18n.T("Requisition No"):</span> <b>@savedReq.RequisitionNo</b></div>
            <div><span>@I18n.T("Status"):</span> <b>@savedReq.Status</b></div>
            <div><span>@I18n.T("Store"):</span> <b>@(stores.FirstOrDefault(s => s.ID == savedReq.StoreID)?.Name ?? "—")</b></div>
            <div><span>@I18n.T("Date"):</span> <b>@savedReq.TransDate.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")</b></div>
            @if (!string.IsNullOrWhiteSpace(savedReq.Remarks))
            {
                <div style="grid-column: span 2;"><span>@I18n.T("Purpose / Remarks"):</span> <b>@savedReq.Remarks</b></div>
            }
        </div>

        <table class="data-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>@I18n.T("Medicine Name")</th>
                    <th>@I18n.T("Remarks")</th>
                    <th class="num">@I18n.T("Requested Qty")</th>
                    <th class="num">@I18n.T("Est. Unit Rate")</th>
                    <th class="num">@I18n.T("Est. Amount")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var (item, idx) in savedReq.Items.Select((x, i) => (x, i + 1)))
                {
                    <tr>
                        <td>@idx</td>
                        <td><b>@(medicines.FirstOrDefault(m => m.ID == item.ServiceID)?.Name ?? item.ServiceID.ToString())</b></td>
                        <td>@(string.IsNullOrWhiteSpace(item.Remarks) ? "—" : item.Remarks)</td>
                        <td class="num"><b>@item.RequestedQty</b></td>
                        <td class="num">@(item.EstimatedRate.HasValue ? I18n.FormatCurrency(item.EstimatedRate.Value) : "—")</td>
                        <td class="num">@(item.EstimatedRate.HasValue ? I18n.FormatCurrency(item.RequestedQty * item.EstimatedRate.Value) : "—")</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="print-total">
            <div class="grand">
                <span>@I18n.T("Estimated Total")</span>
                <b>@I18n.FormatCurrency(savedReq.Items.Sum(x => x.RequestedQty * (x.EstimatedRate ?? 0)))</b>
            </div>
        </div>

        <PrintDocumentFooter Signatures='new string[] { I18n.T("Requested By"), I18n.T("Pharmacy In-Charge"), I18n.T("Approved By") }' />
    </div>
}

@code {
    private record LineItem(int ServiceId, string MedicineName, decimal Qty, decimal? Rate, string? ItemRemarks);

    private List<MedicineStore> stores = [];
    private List<Service> medicines = [];
    private List<PurchaseRequisition> recentList = [];

    private int storeId;
    private string remarks = string.Empty;
    private int selectedServiceId;
    private string medSearchQuery = string.Empty;
    private bool showMedDropdown;
    private decimal selectedQty = 1;
    private decimal? selectedRate;
    private string selectedItemRemarks = string.Empty;
    private List<LineItem> lines = [];

    private PurchaseRequisition? savedReq;
    private string reviewNote = string.Empty;
    private bool isAdmin;
    private bool isSaving;
    private string message = string.Empty;
    private string messageClass = string.Empty;
    private string searchTerm = string.Empty;

    private List<Service> FilteredMedicines => string.IsNullOrWhiteSpace(medSearchQuery)
        ? medicines.Take(20).ToList()
        : medicines.Where(x => x.Name?.Contains(medSearchQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false).Take(25).ToList();

    private IEnumerable<PurchaseRequisition> FilteredList => string.IsNullOrWhiteSpace(searchTerm)
        ? recentList
        : recentList.Where(r => r.RequisitionNo.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
            || r.ID.ToString().Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
            || r.Status.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        isAdmin = auth.User.IsInRole(RoleNames.Administrator);

        await using var db = await DbFactory.CreateDbContextAsync();
        stores = await db.MedicineStores.AsNoTracking().Where(x => x.IsActive).OrderBy(x => x.Name).ToListAsync();
        medicines = await db.Services.AsNoTracking().Where(x => x.CategoryID == 3).OrderBy(x => x.Name).ToListAsync();

        if (stores.Count > 0) storeId = stores[0].ID;
        await LoadListAsync(db);
    }

    private void SelectMedicine(Service m)
    {
        selectedServiceId = m.ID;
        medSearchQuery = m.Name ?? "";
        selectedRate = m.BuyRate > 0 ? m.BuyRate : null;
        showMedDropdown = false;
    }

    private async Task LoadListAsync(HpmDbContext db)
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = int.TryParse(auth.User.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : 0;

        var query = db.PurchaseRequisitions
            .AsNoTracking()
            .Include(x => x.Items)
            .OrderByDescending(x => x.ID);

        recentList = isAdmin
            ? await query.Take(50).ToListAsync()
            : await query.Where(x => x.RequestedBy == userId).Take(50).ToListAsync();
    }

    private void AddLine()
    {
        if (selectedServiceId <= 0) { Fail("Select a medicine."); return; }
        if (selectedQty <= 0) { Fail("Quantity must be greater than zero."); return; }
        if (lines.Any(l => l.ServiceId == selectedServiceId)) { Fail("This medicine is already in the list."); return; }

        var medicine = medicines.First(m => m.ID == selectedServiceId);
        lines.Add(new LineItem(selectedServiceId, medicine.Name ?? medicine.ID.ToString(), selectedQty, selectedRate > 0 ? selectedRate : null, selectedItemRemarks.Trim()));
        selectedServiceId = 0;
        medSearchQuery = string.Empty;
        selectedQty = 1;
        selectedRate = null;
        selectedItemRemarks = string.Empty;
        message = string.Empty;
    }

    private void RemoveLine(LineItem line) => lines.Remove(line);

    private async Task SubmitAsync(bool printAfterSave)
    {
        if (storeId <= 0) { Fail("Select a store."); return; }
        if (lines.Count == 0) { Fail("Add at least one medicine."); return; }

        isSaving = true;
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = int.TryParse(auth.User.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : 1;
            var now = DateTime.UtcNow;

            savedReq = await ResilientTransaction.ExecuteAsync(DbFactory, async db =>
            {
                var temporaryNo = $"TMP-{Guid.NewGuid():N}"[..20];
                var req = new PurchaseRequisition
                {
                    StoreID = storeId,
                    RequisitionNo = temporaryNo,
                    Status = "Pending",
                    RequestedBy = userId,
                    RequestedAt = now,
                    Remarks = remarks.Trim(),
                    TransDate = now,
                };
                db.PurchaseRequisitions.Add(req);
                await db.SaveChangesAsync();
                req.RequisitionNo = $"REQ-{req.ID:D6}";

                int slno = 1;
                foreach (var line in lines)
                {
                    db.PurchaseRequisitionItems.Add(new PurchaseRequisitionItem
                    {
                        RequisitionID = req.ID,
                        SLNO = slno++,
                        ServiceID = line.ServiceId,
                        RequestedQty = line.Qty,
                        EstimatedRate = line.Rate,
                        Remarks = line.ItemRemarks,
                    });
                }
                await db.SaveChangesAsync();
                return await db.PurchaseRequisitions.Include(x => x.Items).FirstAsync(x => x.ID == req.ID);
            });

            lines.Clear();
            remarks = string.Empty;
            Success($"Requisition {savedReq.RequisitionNo} submitted.");

            await using var db2 = await DbFactory.CreateDbContextAsync();
            await LoadListAsync(db2);

            if (printAfterSave)
            {
                StateHasChanged();
                await Task.Yield();
                await PrintRequisitionAsync();
            }
        }
        catch (Exception ex)
        {
            Fail($"Failed: {ex.GetBaseException().Message}");
        }
        finally { isSaving = false; }
    }

    private async Task ReviewAsync(bool approve)
    {
        if (savedReq == null) return;
        isSaving = true;
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = int.TryParse(auth.User.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : 1;
            var now = DateTime.UtcNow;
            var reqId = savedReq.ID;
            var note = reviewNote.Trim();
            var newStatus = approve ? "Approved" : "Rejected";

            await ResilientTransaction.ExecuteAsync(DbFactory, async db =>
            {
                var req = await db.PurchaseRequisitions.FirstAsync(x => x.ID == reqId);
                req.Status = newStatus;
                req.ReviewedBy = userId;
                req.ReviewedAt = now;
                req.ReviewNote = note;
                await db.SaveChangesAsync();
                return req;
            });

            await using var db2 = await DbFactory.CreateDbContextAsync();
            savedReq = await db2.PurchaseRequisitions.Include(x => x.Items).FirstAsync(x => x.ID == reqId);
            await LoadListAsync(db2);
            Success(approve ? "Requisition approved." : "Requisition rejected.");
        }
        catch (Exception ex)
        {
            Fail($"Failed: {ex.GetBaseException().Message}");
        }
        finally { isSaving = false; }
    }

    private void LoadReq(PurchaseRequisition r)
    {
        savedReq = r;
        reviewNote = string.Empty;
        message = string.Empty;
    }

    private async Task PrintRequisitionAsync() => await JS.InvokeVoidAsync("hpm.printElement", "pharmacy-requisition-print", savedReq?.RequisitionNo ?? "Requisition");

    private void ResetForm()
    {
        savedReq = null;
        lines.Clear();
        remarks = string.Empty;
        reviewNote = string.Empty;
        message = string.Empty;
        selectedServiceId = 0;
        medSearchQuery = string.Empty;
        selectedQty = 1;
        selectedRate = null;
    }

    private void Success(string x) { messageClass = "success"; message = x; }
    private void Fail(string x) { messageClass = "danger"; message = x; }
    public void Dispose() { }
}
