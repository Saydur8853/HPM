                {

                    <span>Weight: <b>@patientWeight kg</b></span>

                }

            </div>

            @if (!string.IsNullOrWhiteSpace(patientContact))

            {

                <div style="margin-top: 2px;">Contact: <b>@patientContact</b></div>

            }

        </div>

        <!-- Doctor Info -->

        <div style="font-size: 10.5px; border-bottom: 1px dashed #000; padding-bottom: 6px; margin-bottom: 6px;">

            <div>Doctor: <b style="font-size: 11.5px;">@DoctorName(editor.DoctorID)</b></div>

            @if (SelectedDoctor != null && !string.IsNullOrWhiteSpace(CleanDoctorDegree(SelectedDoctor)))

            {

                <div style="font-size: 9.5px; color:#222;">@CleanDoctorDegree(SelectedDoctor)</div>

            }

            <div style="font-size: 9.5px; margin-top: 2px;">Dept: <b>@DepartmentName(editor.DeptID)</b></div>

        </div>

        <!-- Payment Info -->

        <div style="border-bottom: 1.5px dashed #000; padding-bottom: 6px; margin-bottom: 6px;">

            <div style="display: flex; justify-content: space-between; font-size: 12px; font-weight: 800;">

                <span>Consultation Fee:</span>

                <span>@I18n.FormatCurrency(editor.Total)</span>

            </div>

            <div style="display: flex; justify-content: space-between; font-size: 9.5px; color: #333; margin-top: 2px;">

                <span>Mode: @paymentMethod</span>

                @if (cashTendered > 0)

                {

                    <span>Tendered: ৳@cashTendered.ToString("N0")</span>

