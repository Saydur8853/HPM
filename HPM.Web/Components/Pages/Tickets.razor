    private void HandleDoctorSearchKeyDown(KeyboardEventArgs e)

    {

        if (e.Key == "Escape")

        {

            showDoctorSuggestions = false;

        }

        else if (e.Key == "Enter")

        {

            var first = filteredDoctorItems.FirstOrDefault();

            if (first != null)

