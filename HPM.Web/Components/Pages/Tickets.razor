@page "/tickets"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.Reception + "," + RoleNames.Cashier)]
@rendermode InteractiveServer
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject IBarcodeQrService BarcodeQr
@inject PatientSelectionState PatientSelection
@implements IDisposable
@using System.Security.Claims
@using HPM.Web.Components.Common
@using HPM.Web.Services

<PageTitle>@I18n.T("OPD Ticket") | @Branding.HospitalName</PageTitle>

<div class="tickets-classic-fit">
    <!-- Compact Top Action & Status Bar -->
    <div class="tickets-classic-topbar">
        <div class="tickets-top-left">
            <h1 class="tickets-page-title">
                <span>@I18n.T("OPD Ticket")</span>
            </h1>
            <span class="tickets-count-pill">
                @tickets.Count @I18n.T("Tickets")
            </span>
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <span class="tickets-inline-alert @messageClass" title="@message">
                    @message
                </span>
            }
        </div>

        <div class="tickets-top-actions">
            <button type="button" class="btn btn-secondary tickets-btn" @onclick="PrintDailyAsync" title="@I18n.T("Print Daily List")">
                @I18n.T("Print List")
            </button>
            <button type="button" class="btn btn-secondary tickets-btn" @onclick="Reset" title="@I18n.T("New Ticket / Reset Form")">
                + @I18n.T("New Ticket")
            </button>
        </div>
    </div>

    <!-- Main Balanced Workspace Grid: Left Issue Form, Right Issued Queue -->
    <div class="tickets-classic-workspace">
        <!-- Left Panel: Ticket Issuance Form Card -->
        <div class="tickets-form-card">
            <div class="tickets-card-header">
                <h2>@(editor.ID == 0 ? I18n.T("Issue New OPD Ticket") : $"{I18n.T("Edit Ticket")} #{editor.ID}")</h2>
                <span class="tickets-serial-badge @(editor.ID == 0 ? "emerald" : "violet")">
                    @(editor.ID == 0 ? I18n.T("AUTO POST") : $"{I18n.T("TICKET #")}{editor.ID}")
                </span>
            </div>

            <EditForm Model="editor" OnValidSubmit="SaveAsync" class="tickets-form-wrapper">
                <DataAnnotationsValidator />

                <div class="tickets-form-body">
                    <!-- Row 1: Patient ID / Mobile & Patient Name -->
                    <div class="tickets-two-col">
                        <div class="tickets-field-group">
                            <span class="tickets-field-label">
                                @I18n.T("Find Patient")
                            </span>
                            <div class="tickets-patient-search-combo">
                                <input class="classic-input"
                                       value="@editor.RegNo"
                                       @oninput="HandlePatientIdInputAsync"
                                       @onfocus="ShowPatientIdSuggestionsAsync"
                                       @onblur="HidePatientSuggestionsAsync"
                                       @onkeydown="HandlePatientIdKeyDown"
                                       autocomplete="off"
                                       placeholder="@I18n.T("ID or mobile")"
                                       title="@I18n.T("Search by patient ID or mobile")" />
                                <button type="button" class="btn-find" @onclick="FindPatientAsync" title="@I18n.T("Search Patient")">
                                    <SearchIcon /> @I18n.T("Search")
                                </button>
                            </div>
                            @if (showPatientIdSuggestions && patientIdSuggestions.Count > 0)
                            {
                                <div class="tickets-patient-suggestions">
                                    <div class="tickets-patient-suggestions-header">
                                        <span><SearchIcon /> @(string.IsNullOrWhiteSpace(editor.RegNo) ? I18n.T("Latest Registered Patients") : I18n.T("Patient Search Results"))</span>
                                        <span style="font-size:10px; color:#94a3b8; font-weight:600;">@patientIdSuggestions.Count @I18n.T("patients")</span>
                                    </div>
                                    @foreach (var patient in patientIdSuggestions.Take(6))
                                    {
                                        <button type="button" class="tickets-patient-option" @onmousedown:preventDefault @onclick="() => SelectPatientFromSuggestion(patient)">
                                            <span class="patient-id">#@patient.PatientID</span>
                                            <span class="patient-name">@patient.Name</span>
                                            @if (!string.IsNullOrWhiteSpace(patient.Weight))
                                            {
                                                <span class="patient-weight-pill">⚖️ @patient.Weight kg</span>
                                            }
                                            <span class="patient-contact">📞 @patient.Contact</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>

                        <div class="tickets-field-group">
                            <span class="tickets-field-label">
                                @I18n.T("Patient Name")<span class="req">*</span>
                            </span>
                            <InputText class="classic-input" @bind-Value="editor.Name" placeholder="@I18n.T("Full name")" />
                        </div>
                    </div>

                    <!-- Row 2: Age & Sex -->
                    <div class="tickets-two-col">
                        <div class="tickets-field-group">
                            <span class="tickets-field-label">
                                @I18n.T("Age")
                            </span>
                            <InputText class="classic-input" @bind-Value="editor.Age" placeholder="e.g. 35Y" />
                        </div>

                        <div class="tickets-field-group">
                            <span class="tickets-field-label">
                                @I18n.T("Sex")
                            </span>
                            <InputSelect class="classic-input tickets-select" @bind-Value="editor.Sex">
                                <option value="">@I18n.T("Select")</option>
                                <option value="Male">@I18n.T("Male")</option>
                                <option value="Female">@I18n.T("Female")</option>
                                <option value="Other">@I18n.T("Other")</option>
                            </InputSelect>
                        </div>
                    </div>

                    <!-- Row 3: Consultant Doctor -->
                    <div class="tickets-field-group">
                        <span class="tickets-field-label">
                            @I18n.T("Consultant Doctor")<span class="req">*</span>
                        </span>
                        @if (SelectedDoctor != null)
                        {
                            <div class="selected-doctor-badge" style="background:#f8fafc; border:1.5px solid #0284c7; min-height:36px; padding:4px 8px; border-radius:6px; display:flex; align-items:center; justify-content:space-between; gap:8px;">
                                <div class="doc-badge-icon" style="font-size:16px; flex-shrink:0;">👨‍⚕️</div>
                                <div class="doc-badge-details" style="display:flex; flex-direction:column; min-width:0; flex:1; text-align:left;">
                                    <strong style="font-size:12px; color:#0369a1; font-weight:800; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@DoctorNameFormatter.FormatFullName(SelectedDoctor.Title, SelectedDoctor.Name)</strong>
                                    <small style="font-size:10px; color:#64748b; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                        @SelectedDoctor.Degree
                                        @if (!string.IsNullOrWhiteSpace(GetDoctorDeptName(SelectedDoctor)))
                                        {
                                            <span>· @GetDoctorDeptName(SelectedDoctor)</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(SelectedDoctor.Room))
                                        {
                                            <span>· Room @SelectedDoctor.Room</span>
                                        }
                                    </small>
                                </div>
                                <button type="button" class="btn-doc-change" @onclick="OpenDoctorModal" title="@I18n.T("Change doctor")">
                                    ✏️ @I18n.T("Change")
                                </button>
                            </div>
                        }
                        else
                        {
                            <button type="button" class="btn-select-doctor-trigger" @onclick="OpenDoctorModal" style="min-height:36px; border-color:#0284c7; color:#0284c7;">
                                <span class="trigger-icon-text">🩺 @I18n.T("Choose Consultant Doctor...")</span>
                                <span class="trigger-action-badge" style="background:#0284c7;"><SearchIcon /> @I18n.T("Search & Select")</span>
                            </button>
                        }
                    </div>

                    <!-- Row 4: Department & Room No -->
                    <div class="tickets-two-col">
                        <div class="tickets-field-group">
                            <span class="tickets-field-label">
                                @I18n.T("Department")<span class="req">*</span>
                            </span>
                            <InputSelect class="classic-input tickets-select" @bind-Value="editor.DeptID">
                                @foreach (var dept in departments)
                                {
                                    <option value="@dept.ID">@dept.Name</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="tickets-field-group">
                            <span class="tickets-field-label">
                                @I18n.T("Room")
                            </span>
                            <InputText class="classic-input" @bind-Value="editor.Room" placeholder="Room" />
                        </div>
                    </div>

                    <!-- Row 5: Ticket Type / Rate & Total Fee -->
                    <div class="tickets-two-col">
                        <div class="tickets-field-group">
                            <span class="tickets-field-label">
                                @I18n.T("Ticket Type")
                            </span>
                            <select class="classic-input tickets-select" value="@editor.TicketRate" @onchange="TicketTypeChanged">
                                @foreach (var type in ticketTypes)
                                {
                                    <option value="@type.ID">@type.Name (@I18n.FormatCurrency(type.Amount))</option>
                                }
                            </select>
                        </div>

                        <div class="tickets-field-group">
                            <span class="tickets-field-label">
                                @I18n.T("Total Fee")
                            </span>
                            <InputNumber class="classic-input bold-number" @bind-Value="editor.Total" />
                        </div>
                    </div>

                    <!-- Row 6: Clinical Comments / Notes -->
                    <div class="tickets-field-group">
                        <span class="tickets-field-label">
                                @I18n.T("Notes")
                        </span>
                        <InputTextArea class="classic-input tickets-textarea" @bind-Value="editor.Comments" placeholder="@I18n.T("Optional notes for doctor...")" rows="2" />
                    </div>
                </div>

                <!-- Footer Actions -->
                <div class="tickets-form-footer">
                    <button class="btn btn-primary tickets-btn" type="submit" disabled="@saving">
                        @(saving ? I18n.T("Saving...") : editor.ID == 0 ? I18n.T("Issue Ticket") : I18n.T("Update Ticket"))
                    </button>

                    <div style="display:flex; align-items:center; gap:6px;">
                        @if (editor.ID > 0)
                        {
                            <button class="btn btn-secondary tickets-btn" type="button" @onclick="PrintTicketAsync" title="@I18n.T("Print Ticket")">
                                @I18n.T("Print Ticket")
                            </button>
                            <button class="btn btn-ghost tickets-btn" type="button" @onclick="DeleteSelectedAsync" style="color: #dc2626;" title="@I18n.T("Delete Ticket")">
                                @I18n.T("Delete")
                            </button>
                        }
                        <button class="btn btn-ghost tickets-btn" type="button" @onclick="Reset">
                            @I18n.T("Clear")
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>

        <!-- Right Panel: Today's Issued Tickets Queue Card -->
        <div class="tickets-queue-card">
            <div class="tickets-queue-top">
                <div style="display:flex; align-items:center; gap:8px;">
                    <h2>@I18n.T("Today's Tickets")</h2>
                    <span style="font-size:11.5px; color:#64748b; font-weight:600;">
                        (@DateTime.Today.ToString("dd MMMM yyyy"))
                    </span>
                </div>
                <span class="pill" style="font-size:11px; font-weight:700;">
                    @FilteredTickets.Count() @I18n.T("Issued")
                </span>
            </div>

            <!-- Barcode & QR Scanner Bar -->
            <div class="tickets-scanner-bar">
                <div class="tickets-scanner-input-wrap">
                    <input type="text"
                           class="classic-input tickets-scanner-input"
                           placeholder="@I18n.T("Search ticket, patient or scan code")"
                           @bind="ticketScanQuery"
                           @bind:event="oninput"
                           @bind:after="ResetTicketPage"
                           @onkeydown="HandleTicketScanKeyDown" />
                    @if (!string.IsNullOrWhiteSpace(ticketScanQuery))
                    {
                        <button type="button" class="tickets-scanner-clear" @onclick="ClearTicketScan" title="Clear">✕</button>
                    }
                </div>
            </div>

            <!-- Queue List with Internal Vertical Scroll -->
            <div class="tickets-queue-list">
                @if (!FilteredTickets.Any())
                {
                    <div class="tickets-queue-empty">
                        <span>@I18n.T("No tickets found")</span>
                    </div>
                }
                @foreach (var ticket in VisibleTickets)
                {
                    <div class="tickets-queue-item @(editor.ID == ticket.ID ? "active" : "")" @onclick="() => Select(ticket)">
                        <span class="tickets-queue-serial">#@ticket.ID</span>
                        <div class="tickets-queue-info">
                            <span class="tickets-queue-name">
                                @ticket.Name
                                @if (!string.IsNullOrWhiteSpace(ticket.RegNo))
                                {
                                    <small class="tickets-queue-reg">(@ticket.RegNo)</small>
                                }
                            </span>
                            <span class="tickets-queue-meta">
                                @DoctorName(ticket.DoctorID) &bull; @DepartmentName(ticket.DeptID)@if (!string.IsNullOrWhiteSpace(ticket.Room)){<text> &bull; @ticket.Room</text>}@if (!string.IsNullOrWhiteSpace(ticket.Age)){<text> &bull; @ticket.Age</text>}@if (!string.IsNullOrWhiteSpace(ticket.Sex)){<text> / @ticket.Sex</text>}
                            </span>
                        </div>
                        <div class="tickets-queue-badges">
                            <span class="tickets-queue-fee">@(I18n.FormatCurrency(ticket.Total))</span>
                        </div>
                        <div class="tickets-queue-actions" @onclick:stopPropagation>
                            <button class="icon-btn" @onclick="() => Select(ticket)" title="@I18n.T("Edit")">&#9998;</button>
                            <button class="icon-btn" @onclick="() => Print(ticket)" title="@I18n.T("Print")">P</button>
                            <button class="icon-btn danger" @onclick="() => DeleteAsync(ticket)" title="@I18n.T("Delete")">×</button>
                        </div>
                    </div>
                }
            </div>
            @if (TicketPageCount > 1)
            {
                <div class="tickets-queue-pager">
                    <button type="button" @onclick="PreviousTicketPage" disabled="@(ticketPage == 0)" aria-label="Previous tickets">&lsaquo;</button>
                    <span>@(ticketPage + 1) / @TicketPageCount</span>
                    <button type="button" @onclick="NextTicketPage" disabled="@(ticketPage >= TicketPageCount - 1)" aria-label="Next tickets">&rsaquo;</button>
                </div>
            }
        </div>
    </div>
</div>

<div id="ticket-print" class="print-document">
    <div class="print-sheet">
        <PrintDocumentHeader Title="OPD Doctor Consultation Ticket"
                             DocNo="@($"#{editor.ID}")"
                             DocNoLabel="Ticket"
                             BarcodeCode="@($"TKT-{editor.ID:00000}")"
                             QrPayload="@BarcodeQr.GenerateTicketQrPayload(editor.ID, int.TryParse(editor.RegNo, out var pid) ? pid : 0, editor.Name ?? "", DoctorName(editor.DoctorID), editor.Total)" />

        <div class="print-grid">
            <div><span>@I18n.T("Patient Name")</span><b>@editor.Name</b></div>
            <div><span>@I18n.T("Patient ID")</span>@(string.IsNullOrWhiteSpace(editor.RegNo) ? I18n.T("Walk-in") : editor.RegNo)</div>
            <div><span>@I18n.T("Age / Sex")</span>@editor.Age / @editor.Sex</div>
            <div><span>@I18n.T("Issue Date")</span>@editor.TransDate.ToString("dd MMM yyyy hh:mm tt")</div>
            <div><span>@I18n.T("Consultant Doctor")</span><b>@DoctorName(editor.DoctorID)</b></div>
            <div><span>@I18n.T("Department")</span>@DepartmentName(editor.DeptID)</div>
            <div><span>@I18n.T("Room No.")</span><b>@editor.Room</b></div>
            <div><span>@I18n.T("Consultation Fee")</span><b style="color:#059669;">@(I18n.FormatCurrency(editor.Total))</b></div>
            <div><span>@I18n.T("Clinical Notes")</span>@editor.Comments</div>
        </div>

        <PrintDocumentFooter SignTitle1="Patient / Attendant"
                             SignTitle3="Reception / Cash Desk"
                             PageNumberText="Page 1 of 1" />
    </div>
</div>

<div id="tickets-daily-print" class="print-document">
    <div class="print-sheet">
        <PrintDocumentHeader Title="Daily Consultation Tickets Register"
                             Subtitle="@($"Register Date: {DateTime.Today:dd MMM yyyy}")" />

        <table class="data-table" style="margin-top: 12px;">
            <thead>
                <tr>
                    <th>@I18n.T("Ticket #", "Ticket #")</th>
                    <th>@I18n.T("Patient Name")</th>
                    <th>@I18n.T("Doctor")</th>
                    <th>@I18n.T("Department")</th>
                    <th>@I18n.T("Room")</th>
                    <th class="num">@I18n.T("Fee", "Fee")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in tickets)
                {
                    <tr>
                        <td>#@t.ID</td>
                        <td>@t.Name</td>
                        <td>@DoctorName(t.DoctorID)</td>
                        <td>@DepartmentName(t.DeptID)</td>
                        <td>@t.Room</td>
                        <td class="num">@(I18n.FormatCurrency(t.Total))</td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="print-total">
            <div class="grand">
                <span>@I18n.T("Total Collection:")</span>
                <strong>@(I18n.FormatCurrency(tickets.Sum(x => x.Total)))</strong>
            </div>
        </div>

        <PrintDocumentFooter SignTitle1="Duty Cashier"
                             SignTitle3="Accounts Supervisor"
                             PageNumberText="Page 1 of 1" />
    </div>
</div>

@if (isDoctorModalOpen)
{
    <div class="doctor-modal-backdrop" @onclick="CloseDoctorModal">
        <div class="doctor-modal-dialog" @onclick:stopPropagation>
            <div class="doctor-modal-header">
                <div class="doctor-modal-header-title">
                    <div class="doctor-modal-icon">🩺</div>
                    <div class="doctor-modal-heading">
                        <h3>@I18n.T("Select Consultant Doctor")</h3>
                        <small>@I18n.T("Search by name, degree, department, or room")</small>
                    </div>
                </div>
                <button type="button" class="doctor-modal-close" @onclick="CloseDoctorModal" title="@I18n.T("Close")">✕</button>
            </div>
            <div class="doctor-modal-search-wrap">
                <div class="doctor-modal-search-box">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="text"
                           @bind="doctorSearchQuery"
                           @bind:event="oninput"
                           autofocus
                           class="doctor-modal-search-input"
                           placeholder="@I18n.T("Search doctor by name, degree, department, room...")" />
                    @if (!string.IsNullOrWhiteSpace(doctorSearchQuery))
                    {
                        <button type="button" class="doctor-modal-search-clear" @onclick="() => doctorSearchQuery = string.Empty">×</button>
                    }
                </div>
            </div>
            <div class="doctor-modal-list">
                @if (!FilteredDoctors.Any())
                {
                    <div class="doc-modal-empty">@I18n.T("No doctor found matching your search.")</div>
                }
                else
                {
                    @foreach (var doc in FilteredDoctors.Take(60))
                    {
                        var deptName = GetDoctorDeptName(doc);
                        var fullName = DoctorNameFormatter.FormatFullName(doc.Title, doc.Name);
                        <div class="doctor-modal-item @(editor.DoctorID == doc.ID ? "active-selected" : "")"
                             @onclick="() => SelectDoctor(doc)">
                            <div class="doctor-modal-item-left">
                                <div class="doc-modal-avatar">👨‍⚕️</div>
                                <div class="doc-modal-info">
                                    <span class="doc-modal-name">@fullName</span>
                                    <span class="doc-modal-meta">
                                        <span>@doc.Degree</span>
                                        @if (!string.IsNullOrWhiteSpace(deptName))
                                        {
                                            <span class="doc-modal-dept-badge">@deptName</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(doc.Room))
                                        {
                                            <span class="doc-modal-dept-badge" style="background:#e0f2fe; color:#0369a1; border-color:#bae6fd;">Room @doc.Room</span>
                                        }
                                    </span>
                                </div>
                            </div>
                            <button type="button" class="btn-modal-choose">
                                @(editor.DoctorID == doc.ID ? "✓ " + I18n.T("Selected") : I18n.T("Select"))
                            </button>
                        </div>
                    }
                }
            </div>
            <div class="doctor-modal-footer">
                <span class="doctor-modal-footer-count">@FilteredDoctors.Count() @I18n.T("doctors found")</span>
                <button type="button" class="btn-modal-cancel" @onclick="CloseDoctorModal">@I18n.T("Cancel")</button>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "patientId")]
    public string? QueryPatientId { get; set; }

    private OPDTicket editor = NewTicket();
    private List<DoctorsProfile> doctors = [];
    private List<Department> departments = [];
    private List<TicketType> ticketTypes = [];
    private List<OPDTicket> tickets = [];
    private string ticketScanQuery = string.Empty;
    private string message = string.Empty;
    private string messageClass = "success";
    private bool saving;
    private bool showPatientIdSuggestions;
    private List<Registration> patientIdSuggestions = [];
    private const int TicketPageSize = 6;
    private int ticketPage;

    // Doctor modal state
    private string doctorSearchQuery = string.Empty;
    private bool isDoctorModalOpen = false;

    private DoctorsProfile? SelectedDoctor => doctors.FirstOrDefault(d => d.ID == editor.DoctorID);

    private string GetDoctorDeptName(DoctorsProfile? doc)
    {
        if (doc?.Department is int deptId && deptId > 0)
        {
            return departments.FirstOrDefault(d => d.ID == deptId)?.Name ?? string.Empty;
        }
        return string.Empty;
    }

    private IEnumerable<DoctorsProfile> FilteredDoctors => string.IsNullOrWhiteSpace(doctorSearchQuery)
        ? doctors
        : doctors.Where(d =>
        {
            var term = doctorSearchQuery.Trim();
            var fullName = DoctorNameFormatter.FormatFullName(d.Title, d.Name);
            var dept = GetDoctorDeptName(d);
            return fullName.Contains(term, StringComparison.OrdinalIgnoreCase)
                || (d.Name?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                || (d.Title?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                || (d.Degree?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                || (d.Room?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                || dept.Contains(term, StringComparison.OrdinalIgnoreCase);
        });

    private void OpenDoctorModal()
    {
        doctorSearchQuery = string.Empty;
        isDoctorModalOpen = true;
    }

    private void CloseDoctorModal()
    {
        isDoctorModalOpen = false;
    }

    private void SelectDoctor(DoctorsProfile doc)
    {
        editor.DoctorID = doc.ID;
        DoctorChanged();
        isDoctorModalOpen = false;
        doctorSearchQuery = string.Empty;
    }

    private IEnumerable<OPDTicket> FilteredTickets => string.IsNullOrWhiteSpace(ticketScanQuery)
        ? tickets
        : tickets.Where(t => t.ID.ToString().Contains(ticketScanQuery.Trim(), StringComparison.OrdinalIgnoreCase)
                          || (t.Name?.Contains(ticketScanQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)
                          || (t.RegNo?.Contains(ticketScanQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false));

    private int TicketPageCount => Math.Max(1, (int)Math.Ceiling(FilteredTickets.Count() / (double)TicketPageSize));
    private IEnumerable<OPDTicket> VisibleTickets => FilteredTickets
        .Skip(ticketPage * TicketPageSize)
        .Take(TicketPageSize);

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        await using var db = await DbFactory.CreateDbContextAsync();
        doctors = await db.Doctors.AsNoTracking().Where(x => x.Name != null).OrderBy(x => x.Name).ToListAsync();
        foreach (var doc in doctors)
        {
            doc.Title = DoctorNameFormatter.Sanitize(doc.Title);
            doc.Name = DoctorNameFormatter.Sanitize(doc.Name);
        }
        departments = await db.Departments.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
        ticketTypes = await db.TicketTypes.AsNoTracking().OrderBy(x => x.ID).ToListAsync();
        SetDefaults();
        await LoadTicketsAsync();
    }

    private void HandleLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnParametersSetAsync()
    {
        var patientId = QueryPatientId ?? PatientSelection.PatientId;
        if (!string.IsNullOrWhiteSpace(patientId) && editor.ID == 0)
        {
            editor.RegNo = patientId.Trim();
            await FindPatientAsync();
        }
    }

    private async Task LoadTicketsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var today = DateTime.Today;
        var tomorrow = today.AddDays(1);
        tickets = await db.OPDTickets.AsNoTracking().Where(x => x.TransDate >= today && x.TransDate < tomorrow).OrderByDescending(x => x.ID).Take(50).ToListAsync();
        ticketPage = 0;
    }

    private async Task HandlePatientIdInputAsync(ChangeEventArgs e)
    {
        editor.RegNo = e.Value?.ToString();
        await FilterPatientIdSuggestionsAsync();
    }

    private async Task ShowPatientIdSuggestionsAsync()
    {
        await FilterPatientIdSuggestionsAsync();
    }

    private async Task HidePatientSuggestionsAsync()
    {
        await Task.Delay(250);
        showPatientIdSuggestions = false;
    }

    private async Task FilterPatientIdSuggestionsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        if (string.IsNullOrWhiteSpace(editor.RegNo))
        {
            // When field is clicked or focused, immediately show the latest registered patients!
            patientIdSuggestions = await db.Registrations.AsNoTracking()
                .OrderByDescending(x => x.ID)
                .Take(8)
                .ToListAsync();
            showPatientIdSuggestions = patientIdSuggestions.Count > 0;
            return;
        }

        var term = editor.RegNo.Trim();
        patientIdSuggestions = await db.Registrations.AsNoTracking()
            .Where(x => (x.PatientID != null && x.PatientID.Contains(term)) 
                     || (x.Contact != null && x.Contact.Contains(term)) 
                     || (x.Name != null && x.Name.Contains(term)))
            .OrderByDescending(x => x.ID)
            .Take(8)
            .ToListAsync();

        showPatientIdSuggestions = patientIdSuggestions.Count > 0;
    }

    private void SelectPatient(Registration patient)
    {
        editor.RegNo = patient.PatientID;
        editor.Name = patient.Name;
        editor.Age = Age(patient.DateOfBirth);
        editor.Sex = patient.Sex;
        PatientSelection.Select(patient.PatientID);
        showPatientIdSuggestions = false;
        messageClass = "success";
        message = $"Patient: {patient.Name} ({patient.PatientID})";
    }

    private void SelectPatientFromSuggestion(Registration patient)
    {
        SelectPatient(patient);
    }

    private async Task HandlePatientIdKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            showPatientIdSuggestions = false;
            await FindPatientAsync();
        }
        else if (e.Key == "Escape")
        {
            showPatientIdSuggestions = false;
        }
    }

    private async Task FindPatientAsync()
    {
        if (string.IsNullOrWhiteSpace(editor.RegNo)) return;
        var lookup = editor.RegNo.Trim();
        await using var db = await DbFactory.CreateDbContextAsync();
        var patient = await db.Registrations.AsNoTracking()
            .FirstOrDefaultAsync(x => x.PatientID == lookup || x.Contact == lookup);

        if (patient is null && lookup.StartsWith("0") && lookup.Length >= 10)
        {
            var withoutLeadingZero = lookup[1..];
            patient = await db.Registrations.AsNoTracking()
                .Where(x => x.Contact != null && x.Contact.EndsWith(withoutLeadingZero))
                .OrderByDescending(x => x.ID)
                .FirstOrDefaultAsync();
        }

        if (patient is null)
        {
            messageClass = "danger";
            message = $"Patient not found: {editor.RegNo}";
            return;
        }

        SelectPatient(patient);
    }

    private void DoctorChanged()
    {
        var doc = doctors.FirstOrDefault(x => x.ID == editor.DoctorID);
        if (doc != null)
        {
            if (!string.IsNullOrWhiteSpace(doc.Room)) editor.Room = doc.Room;
            if (doc.Department is int deptId && deptId > 0) editor.DeptID = deptId;
        }
    }

    private void TicketTypeChanged(ChangeEventArgs e)
    {
        editor.TicketRate = e.Value?.ToString();
        if (int.TryParse(editor.TicketRate, out var id))
        {
            editor.Total = ticketTypes.FirstOrDefault(x => x.ID == id)?.Amount ?? 0;
        }
    }

    private async Task SaveAsync()
    {
        saving = true;
        try
        {
            var userId = await CurrentUserIdAsync();
            editor.Posted = true;
            editor.OPD = 1;
            editor.Vat = 0;
            var isNew = editor.ID == 0;
            if (isNew)
            {
                editor.TransDate = DateTime.Now;
                editor.EnteredBy = userId;
            }

            long ticketId = 0;
            int queueNo = 0;

            await using var strategyDb = await DbFactory.CreateDbContextAsync();
            var strategy = strategyDb.Database.CreateExecutionStrategy();
            await strategy.ExecuteAsync(async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                await using var tx = await db.Database.BeginTransactionAsync();

                if (isNew)
                {
                    db.OPDTickets.Add(editor);
                }
                else
                {
                    db.OPDTickets.Update(editor);
                }
                await db.SaveChangesAsync();
                var encounter = await ClinicalEncounterWorkflow.AttachTicketAsync(db, editor, userId);
                await OperationalAccounting.SyncRevenueAsync(db, $"OPD-TICKET:{editor.ID}", editor.ID,
                    editor.Total, editor.TransDate, userId, $"OPD consultation ticket #{editor.ID}",
                    AccountingPosting.Cash, 10);
                await db.SaveChangesAsync();
                await tx.CommitAsync();

                ticketId = editor.ID;
                queueNo = encounter.QueueNo;
            });

            messageClass = "success";
            message = $"Ticket #{ticketId} issued • Queue #{queueNo}";
            await LoadTicketsAsync();
        }
        catch (Exception ex)
        {
            messageClass = "danger";
            message = $"Ticket failed: {ex.GetBaseException().Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private void Reset()
    {
        showPatientIdSuggestions = false;
        PatientSelection.Clear();
        ResetEditor();
        message = string.Empty;
    }

    private void ResetEditor()
    {
        showPatientIdSuggestions = false;
        editor = NewTicket();
        SetDefaults();
    }

    private void Select(OPDTicket t)
    {
        showPatientIdSuggestions = false;
        editor = new OPDTicket
        {
            ID = t.ID,
            TransDate = t.TransDate,
            RegNo = t.RegNo,
            TicketRate = t.TicketRate,
            Name = t.Name,
            Age = t.Age,
            Sex = t.Sex,
            OPD = t.OPD,
            Vat = t.Vat,
            DoctorID = t.DoctorID,
            DeptID = t.DeptID,
            Room = t.Room,
            Comments = t.Comments,
            Total = t.Total,
            Posted = t.Posted,
            EnteredBy = t.EnteredBy
        };
        message = string.Empty;
    }

    private async Task DeleteAsync(OPDTicket t)
    {
        if (!await JS.InvokeAsync<bool>("hpm.confirm", $"Delete consultation ticket #{t.ID} for {t.Name}?")) return;
        var reason = await JS.InvokeAsync<string?>("hpm.prompt", "Reason for reversing this consultation ticket:");
        if (string.IsNullOrWhiteSpace(reason)) return;
        try
        {
            await using var strategyDb = await DbFactory.CreateDbContextAsync();
            var strategy = strategyDb.Database.CreateExecutionStrategy();
            await strategy.ExecuteAsync(async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                await using var tx = await db.Database.BeginTransactionAsync();
                var entity = await db.OPDTickets.FindAsync(t.ID);
                if (entity is not null)
                {
                    var encounter = await db.PatientEncounters.SingleOrDefaultAsync(x => x.TicketID == entity.ID);
                    if (encounter?.Status is EncounterStatuses.InConsultation or EncounterStatuses.Completed)
                    {
                        throw new InvalidOperationException("A ticket linked to an active or completed consultation cannot be deleted.");
                    }
                    var userId = await CurrentUserIdAsync();
                    await OperationalAccounting.ReverseRevenueAsync(db, "OPD Ticket", $"OPD-TICKET:{entity.ID}", entity.ID,
                        entity.Total, entity.TransDate, userId, reason, AccountingPosting.Cash, 10);
                    if (encounter is not null)
                    {
                        encounter.TicketID = null;
                        encounter.Status = EncounterStatuses.Cancelled;
                        encounter.UpdatedAt = DateTime.Now;
                    }
                    db.Remove(entity);
                    await db.SaveChangesAsync();
                    await tx.CommitAsync();
                }
            });

            if (editor.ID == t.ID) ResetEditor();
            messageClass = "success";
            message = "Ticket deleted";
            await LoadTicketsAsync();
        }
        catch (Exception ex)
        {
            messageClass = "danger";
            message = ex.GetBaseException().Message;
        }
    }

    private Task DeleteSelectedAsync() => DeleteAsync(editor);
    private async Task Print(OPDTicket t)
    {
        Select(t);
        await InvokeAsync(StateHasChanged);
        await Task.Delay(50);
        await JS.InvokeVoidAsync("hpm.printElement", "ticket-print", $"Ticket {t.ID}");
    }
    private async Task HandleTicketScanKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(ticketScanQuery))
        {
            await ProcessTicketScanAsync(ticketScanQuery.Trim());
        }
    }

    private async Task ProcessTicketScanAsync(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return;

        // 1. Check if it is a QR payload: HPM:TKT|ID:123...
        if (raw.StartsWith("HPM:TKT|", StringComparison.OrdinalIgnoreCase))
        {
            var parts = raw.Split('|');
            var idPart = parts.FirstOrDefault(p => p.StartsWith("ID:", StringComparison.OrdinalIgnoreCase));
            if (idPart != null && long.TryParse(idPart.Substring(3), out var tktId))
            {
                await LoadTicketByIdAsync(tktId);
                return;
            }
        }

        // 2. Check if it is a Patient QR payload: HPM:PAT|ID:12|REG:202600001...
        if (raw.StartsWith("HPM:PAT|", StringComparison.OrdinalIgnoreCase))
        {
            var parts = raw.Split('|');
            var regPart = parts.FirstOrDefault(p => p.StartsWith("REG:", StringComparison.OrdinalIgnoreCase));
            if (regPart != null)
            {
                var regNo = regPart.Substring(4).Trim();
                editor.RegNo = regNo;
                await FindPatientAsync();
                return;
            }
        }

        // 3. Check for TKT-XXXXX format
        if (raw.StartsWith("TKT-", StringComparison.OrdinalIgnoreCase) && long.TryParse(raw.Substring(4), out var scannedId))
        {
            await LoadTicketByIdAsync(scannedId);
            return;
        }

        // 4. If numeric, check if it matches an existing ticket ID first
        if (long.TryParse(raw, out var numericId))
        {
            var matched = tickets.FirstOrDefault(t => t.ID == numericId);
            if (matched != null)
            {
                Select(matched);
                messageClass = "success";
                message = $"Ticket #{numericId} selected from scan.";
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();
            var dbTicket = await db.OPDTickets.AsNoTracking().FirstOrDefaultAsync(t => t.ID == numericId);
            if (dbTicket != null)
            {
                Select(dbTicket);
                messageClass = "success";
                message = $"Ticket #{numericId} loaded from database.";
                return;
            }

            // Otherwise treat as Patient ID
            editor.RegNo = raw;
            await FindPatientAsync();
            return;
        }

        // 5. Try loading patient with this search term
        editor.RegNo = raw;
        await FindPatientAsync();
    }

    private async Task LoadTicketByIdAsync(long id)
    {
        var matched = tickets.FirstOrDefault(t => t.ID == id);
        if (matched != null)
        {
            Select(matched);
            messageClass = "success";
            message = $"Ticket #{id} selected from scan.";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var dbTicket = await db.OPDTickets.AsNoTracking().FirstOrDefaultAsync(t => t.ID == id);
        if (dbTicket != null)
        {
            Select(dbTicket);
            messageClass = "success";
            message = $"Ticket #{id} loaded from database.";
        }
        else
        {
            messageClass = "danger";
            message = $"Ticket #{id} not found.";
        }
    }

    private void ClearTicketScan()
    {
        ticketScanQuery = string.Empty;
        ticketPage = 0;
    }

    private void ResetTicketPage() => ticketPage = 0;
    private void PreviousTicketPage() => ticketPage = Math.Max(0, ticketPage - 1);
    private void NextTicketPage() => ticketPage = Math.Min(TicketPageCount - 1, ticketPage + 1);

    private Task PrintTicketAsync() => JS.InvokeVoidAsync("hpm.printElement", "ticket-print", $"Ticket {editor.ID}").AsTask();
    private Task PrintDailyAsync() => JS.InvokeVoidAsync("hpm.printElement", "tickets-daily-print", $"Tickets {DateTime.Today:yyyy-MM-dd}").AsTask();

    private void SetDefaults()
    {
        if (doctors.Count > 0)
        {
            editor.DoctorID = doctors[0].ID;
            editor.Room = doctors[0].Room;
            if (doctors[0].Department is int deptId && deptId > 0)
            {
                editor.DeptID = deptId;
            }
        }
        if (editor.DeptID == 0 && departments.Count > 0) editor.DeptID = departments[0].ID;
        if (ticketTypes.Count > 0)
        {
            editor.TicketRate = ticketTypes[0].ID.ToString();
            editor.Total = ticketTypes[0].Amount;
        }
    }

    private async Task<int> CurrentUserIdAsync()
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        return int.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : 1;
    }

    private static OPDTicket NewTicket() => new() { TransDate = DateTime.Now, Posted = true, OPD = 1 };
    private string DoctorName(int id)
    {
        var doc = doctors.FirstOrDefault(x => x.ID == id);
        return doc != null ? DoctorNameFormatter.FormatFullName(doc.Title, doc.Name) : "Doctor";
    }
    private string DepartmentName(int id) => departments.FirstOrDefault(x => x.ID == id)?.Name ?? "Department";
    private static string DoctorLabel(DoctorsProfile doctor) =>
        $"{DoctorNameFormatter.FormatFullName(doctor.Title, doctor.Name)} {doctor.Degree}".Trim();
    private static string Age(DateTime birth)
    {
        var years = DateTime.Today.Year - birth.Year;
        if (birth.Date > DateTime.Today.AddYears(-years)) years--;
        return $"{Math.Max(0, years)}Y";
    }

    public void Dispose()
    {
        I18n.OnLanguageChanged -= HandleLanguageChanged;
    }
