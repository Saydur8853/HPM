    private string DoctorName(int id)

    {

        if (doctorById.TryGetValue(id, out var item)) return item.DisplayName;

        var doc = doctors.FirstOrDefault(x => x.ID == id);

        return doc != null ? DoctorDisplayName(doc) : "Doctor";

    }

    private string DepartmentName(int id) => departments.TryGetValue(id, out var name) ? name : "Department";

    private static string CleanDoctorDegree(DoctorsProfile? doctor) => doctor?.Degree?.Trim() ?? string.Empty;

    private static string CleanDoctorRoom(string? room) => room?.Trim() ?? string.Empty;

    private static string DoctorDisplayName(DoctorsProfile? doctor)

    {

        if (doctor == null) return "Doctor";

        var title = doctor.Title?.Trim();

        var name = doctor.Name?.Trim() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(title)) return name;

        if (name.StartsWith(title, StringComparison.OrdinalIgnoreCase)) return name;

        return $"{title} {name}".Trim();

    }

    private static string Age(DateTime? birth)

    {

        if (!birth.HasValue) return string.Empty;

        var b = birth.Value;

        var years = DateTime.Today.Year - b.Year;

        if (b.Date > DateTime.Today.AddYears(-years)) years--;

        return $"{Math.Max(0, years)}Y";

    }

