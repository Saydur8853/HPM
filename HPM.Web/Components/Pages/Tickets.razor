            </div>

        </div>

        <!-- Info Grid -->

        <div style="font-size: 10.5px; border-bottom: 1px dashed #000; padding-bottom: 6px; margin-bottom: 6px;">

            <div style="display: flex; justify-content: space-between;">

                <span>Ticket: <b>#@editor.ID</b></span>

                <span>Date: <b>@editor.TransDate.ToString("dd/MM/yy hh:mm tt")</b></span>

            </div>

            <div style="margin-top: 3px;">

                <span>Patient: <b>@editor.Name</b></span>

                @if (!string.IsNullOrWhiteSpace(editor.RegNo))

