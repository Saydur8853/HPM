    private async Task LoadTicketsAsync()

    {

        await using var db = await DbFactory.CreateDbContextAsync();

        var today = DateTime.Today;

        var tomorrow = today.AddDays(1);

        tickets = await db.OPDTickets.AsNoTracking()

            .Where(x => x.TransDate >= today && x.TransDate < tomorrow)

            .OrderByDescending(x => x.ID)

            .Take(100)

            .ToListAsync();

        var ticketIds = tickets.Select(x => x.ID).ToList();

        var encounters = await db.PatientEncounters.AsNoTracking()

            .Where(x => x.TicketID.HasValue && ticketIds.Contains(x.TicketID.Value))

            .Select(x => new { x.TicketID, x.QueueNo, x.Status })

            .ToListAsync();

        ticketEncounterMap = encounters

            .Where(x => x.TicketID.HasValue)

            .ToDictionary(x => x.TicketID!.Value, x => x.QueueNo);

        completedEncounterTicketIds = encounters

            .Where(x => x.TicketID.HasValue && x.Status == EncounterStatuses.Completed)

            .Select(x => x.TicketID!.Value)

            .ToHashSet();

        var maxQueue = encounters.Count > 0 ? encounters.Max(x => x.QueueNo) : 0;

        nextQueueCounter = maxQueue + 1;

        ticketPage = 0;

    }

    private async Task LoadTodayAppointmentsAsync()

    {

        await using var db = await DbFactory.CreateDbContextAsync();

        var today = DateTime.Today;

        var tomorrow = today.AddDays(1);

        var existingTicketPatientIds = tickets

            .Where(t => !string.IsNullOrWhiteSpace(t.RegNo))

            .Select(t => t.RegNo!)

            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        todayAppointments = await db.DoctorAppointments.AsNoTracking()

            .Where(a => a.ApptDate >= today && a.ApptDate < tomorrow && a.Status == "Booked")

            .OrderBy(a => a.ApptSLNO)

            .ToListAsync();

        todayAppointments = todayAppointments

            .Where(a => string.IsNullOrWhiteSpace(a.PatientID) || !existingTicketPatientIds.Contains(a.PatientID))

            .ToList();

    }

    private async Task CheckFollowUpStatusAsync()

    {

        isFollowUpDetected = false;

        lastVisitTicket = null;

        if (editor.DoctorID <= 0 || string.IsNullOrWhiteSpace(editor.RegNo))

            return;

        var regNo = editor.RegNo.Trim();

        var doctorId = editor.DoctorID;

        var cutoffDate = DateTime.Today.AddDays(-14);

        try

        {

            await using var db = await DbFactory.CreateDbContextAsync();

            var prev = await db.OPDTickets.AsNoTracking()

                .Where(t => t.RegNo == regNo && t.DoctorID == doctorId && t.ID != editor.ID && t.TransDate >= cutoffDate)

                .OrderByDescending(t => t.TransDate)

                .FirstOrDefaultAsync();

            if (prev != null)

            {

                lastVisitTicket = prev;

                lastVisitDaysAgo = (int)(DateTime.Today - prev.TransDate.Date).TotalDays;

                isFollowUpDetected = true;

                await InvokeAsync(StateHasChanged);

            }

        }

        catch

