        </div>

        <!-- Barcode / QR -->

        <div style="text-align: center; margin: 6px 0;">

            <div style="display: inline-block; max-width: 140px; overflow: hidden; line-height: 1;">

                @((MarkupString)BarcodeQr.GenerateBarcodeSvg($"TKT-{editor.ID:00000}", barHeight: 22, includeText: true))

            </div>

