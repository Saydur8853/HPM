    private async Task FilterPatientSuggestionsAsync()

    {

        await using var db = await DbFactory.CreateDbContextAsync();

        if (string.IsNullOrWhiteSpace(patientSearchQuery))

        {

            patientIdSuggestions = await db.Registrations.AsNoTracking()

                .OrderByDescending(x => x.ID)

                .Take(6)

                .ToListAsync();

            showPatientIdSuggestions = patientIdSuggestions.Count > 0;

            return;

        }

        var term = patientSearchQuery.Trim();

        patientIdSuggestions = await db.Registrations.AsNoTracking()

            .Where(x => (x.PatientID != null && x.PatientID.Contains(term))

                     || (x.Contact != null && x.Contact.Contains(term))

                     || (x.Name != null && x.Name.Contains(term)))

            .OrderByDescending(x => x.ID)

            .Take(6)

            .ToListAsync();

        showPatientIdSuggestions = patientIdSuggestions.Count > 0;

    }

