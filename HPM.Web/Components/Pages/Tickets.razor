    private async Task ProcessTicketScanAsync(string raw)

    {

        if (string.IsNullOrWhiteSpace(raw)) return;

        if (raw.StartsWith("HPM:TKT|", StringComparison.OrdinalIgnoreCase))

        {

            var parts = raw.Split('|');

            var idPart = parts.FirstOrDefault(p => p.StartsWith("ID:", StringComparison.OrdinalIgnoreCase));

            if (idPart != null && long.TryParse(idPart.Substring(3), out var tktId))

            {

                await LoadTicketByIdAsync(tktId);

                return;

            }

        }

        if (raw.StartsWith("TKT-", StringComparison.OrdinalIgnoreCase) && long.TryParse(raw.Substring(4), out var scannedId))

        {

            await LoadTicketByIdAsync(scannedId);

            return;

        }

        if (long.TryParse(raw, out var numericId))

        {

            var matched = tickets.FirstOrDefault(t => t.ID == numericId);

            if (matched != null)

            {

                Select(matched);

                messageClass = "success";

                message = $"Ticket #{numericId} selected.";

                return;

            }

        }

        await FindPatientAsync(raw);

    }

    private async Task LoadTicketByIdAsync(long id)

    {

        var matched = tickets.FirstOrDefault(t => t.ID == id);

        if (matched != null)

        {

            Select(matched);

            messageClass = "success";

            message = $"Ticket #{id} selected.";

            return;

        }

        await using var db = await DbFactory.CreateDbContextAsync();

        var dbTicket = await db.OPDTickets.AsNoTracking().FirstOrDefaultAsync(t => t.ID == id);

        if (dbTicket != null)

        {

            Select(dbTicket);

            messageClass = "success";

            message = $"Ticket #{id} loaded.";

        }

        else

        {

            messageClass = "danger";

            message = $"Ticket #{id} not found.";

        }

    }

