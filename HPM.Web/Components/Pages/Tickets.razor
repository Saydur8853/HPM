    private async Task SaveQuickPatientAsync()

    {

        if (string.IsNullOrWhiteSpace(newPatientModel.Name))

        {

            newPatientError = "Patient Name is required.";

            return;

        }

        savingNewPatient = true;

        newPatientError = string.Empty;

        try

        {

            if (int.TryParse(newPatientAge, out var ageYears) && ageYears > 0)

            {

                newPatientModel.DateOfBirth = DateTime.Today.AddYears(-ageYears);

            }

            await using var strategyDb = await DbFactory.CreateDbContextAsync();

            var strategy = strategyDb.Database.CreateExecutionStrategy();

            Registration? created = null;

            await strategy.ExecuteAsync(async () =>

            {

                await using var db = await DbFactory.CreateDbContextAsync();

                await using var transaction = await db.Database.BeginTransactionAsync(System.Data.IsolationLevel.ReadCommitted);

                await SqlServerConcurrency.AcquireTransactionLockAsync(db, "HPM:PatientID");

                var todayPrefix = $"P{DateTime.Today:yyMMdd}";

                var maxExistingToday = await db.Registrations

                    .Where(x => x.PatientID.StartsWith(todayPrefix))

                    .OrderByDescending(x => x.PatientID)

                    .Select(x => x.PatientID)

                    .FirstOrDefaultAsync();

                var nextSeq = 1;

                if (!string.IsNullOrWhiteSpace(maxExistingToday) && maxExistingToday.Length >= 11)

                {

                    var seqPart = maxExistingToday.Substring(7);

                    if (int.TryParse(seqPart, out var parsedSeq))

                    {

                        nextSeq = parsedSeq + 1;

                    }

                }

                var generatedPatientId = $"{todayPrefix}{nextSeq:0000}";

                newPatientModel.PatientID = generatedPatientId;

                newPatientModel.TransDate = DateTime.Now;

                var userId = await CurrentUserIdAsync();

                newPatientModel.EnteredBy = userId > 0 ? userId : 1;

                db.Registrations.Add(newPatientModel);

                await db.SaveChangesAsync();

                await transaction.CommitAsync();

                created = newPatientModel;

            });

            if (created != null)

            {

                SelectPatient(created);

                showNewPatientModal = false;

                message = $"Registered: {created.Name} (#{created.PatientID})";

                messageClass = "success";

            }

        }

        catch (Exception ex)

        {

            newPatientError = ex.GetBaseException().Message;

        }

        finally

        {

            savingNewPatient = false;

        }

    }

    private async Task SaveAsync()

    {

        if (editor.DoctorID <= 0)

        {

            messageClass = "danger";

            message = I18n.T("Please select a consultant doctor.");

            return;

        }

        if (string.IsNullOrWhiteSpace(editor.Name))

        {

            messageClass = "danger";

            message = I18n.T("Patient Name is required.");

            return;

        }

        saving = true;

        try

        {

            var userId = await CurrentUserIdAsync();

            editor.Posted = true;

            editor.OPD = 1;

            editor.Vat = 0;

            var isNew = editor.ID == 0;

            if (isNew)

            {

                editor.TransDate = DateTime.Now;

                editor.EnteredBy = userId;

            }

            long ticketId = 0;

            int queueNo = 0;

            await using var strategyDb = await DbFactory.CreateDbContextAsync();

            var strategy = strategyDb.Database.CreateExecutionStrategy();

            await strategy.ExecuteAsync(async () =>

            {

                await using var db = await DbFactory.CreateDbContextAsync();

                await using var tx = await db.Database.BeginTransactionAsync();

                if (isNew)

                {

                    db.OPDTickets.Add(editor);

                }

                else

                {

                    db.OPDTickets.Update(editor);

                }

                await db.SaveChangesAsync();

                var encounter = await ClinicalEncounterWorkflow.AttachTicketAsync(db, editor, userId);

                // Attach vitals entered at reception

                if (decimal.TryParse(patientWeight, out var wt) && wt > 0)

                {

                    encounter.WeightKg = wt;

                }

                if (!string.IsNullOrWhiteSpace(bloodPressure))

                {

                    encounter.BloodPressure = bloodPressure;

                }

                if (!string.IsNullOrWhiteSpace(pulseRate))

                {

                    encounter.Pulse = pulseRate;

                }

                if (!string.IsNullOrWhiteSpace(editor.Comments))

                {

                    encounter.ChiefComplaint = editor.Comments;

                }

                await OperationalAccounting.SyncRevenueAsync(db, $"OPD-TICKET:{editor.ID}", editor.ID,

                    editor.Total, editor.TransDate, userId, $"OPD consultation ticket #{editor.ID} ({paymentMethod})",

                    AccountingPosting.Cash, 10);

                await db.SaveChangesAsync();

                await tx.CommitAsync();

                ticketId = editor.ID;

                queueNo = encounter.QueueNo;

            });

            currentQueueNo = queueNo;

            messageClass = "success";

            message = $"Ticket #{ticketId} issued • Token #{queueNo.ToString("00")}";

            await LoadTicketsAsync();

            await LoadTodayAppointmentsAsync();

            if (autoPrint)

            {

                await PrintActiveTicketAsync();

            }

        }

        catch (Exception ex)

        {

            messageClass = "danger";

            message = $"Ticket failed: {ex.GetBaseException().Message}";

        }

        finally

        {

            saving = false;

        }

    }

