    private async Task IssueTicketFromAppointmentAsync(DoctorAppointment appt)

    {

        editor = NewTicket();

        editor.DoctorID = appt.DoctorID;

        var doc = doctors.FirstOrDefault(d => d.ID == appt.DoctorID);

        if (doc != null)

        {

            editor.Room = doc.Room;

            if (doc.Department.HasValue) editor.DeptID = doc.Department.Value;

            doctorSearchText = $"D{doc.ID} - {DoctorDisplayName(doc)}";

        }

        editor.RegNo = appt.PatientID;

        editor.Name = appt.Name;

        editor.Age = appt.Age;

        editor.Sex = appt.Sex;

        patientContact = appt.ContactNo;

        patientWeight = appt.Weight;

        isWalkInMode = string.IsNullOrWhiteSpace(appt.PatientID);

        patientSearchQuery = appt.PatientID ?? string.Empty;

        var defaultType = ticketTypes.FirstOrDefault(x => x.IsActive);

        if (defaultType != null)

        {

            editor.TicketRate = defaultType.ID.ToString();

            if (doc != null && doc.OpdConsultationFee.HasValue && doc.OpdConsultationFee.Value > 0)
            {
                isUsingDoctorOpdFee = true;
                editor.Total = doc.OpdConsultationFee.Value;
            }
            else
            {
                isUsingDoctorOpdFee = false;
                editor.Total = defaultType.Amount;
            }

        }

        CloseScheduleDrawer();

        message = $"Loaded appointment #{appt.ApptSLNO:00} for {appt.Name}. Ready to issue ticket.";

        messageClass = "success";

        await CheckFollowUpStatusAsync();

    }

