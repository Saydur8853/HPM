@page "/tickets"

@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.Reception + "," + RoleNames.Cashier)]

@rendermode InteractiveServer

@inject IDbContextFactory<HpmDbContext> DbFactory

@inject IJSRuntime JS

@inject AuthenticationStateProvider AuthStateProvider

@inject IBarcodeQrService BarcodeQr

@inject PatientSelectionState PatientSelection

@implements IDisposable

@using System.Security.Claims

@using System.Text.RegularExpressions

@using HPM.Web.Components.Common

@using HPM.Web.Data

@using HPM.Web.Data.Entities

@using HPM.Web.Services

@using Microsoft.EntityFrameworkCore

<PageTitle>@I18n.T("OPD Ticket") | @Branding.HospitalName</PageTitle>

<div class="appointments-classic-fit tickets-classic-fit" tabindex="0" @onkeydown="HandlePageKeyDown">

    <!-- Compact Top Action & Status Bar -->

    <div class="appt-classic-topbar">

        <div class="appt-top-left">

            <h1 class="appt-page-title">

                <span>🎫 @I18n.T("OPD Ticket")</span>

            </h1>

            <span class="appt-count-pill" title="@I18n.T("Total tickets issued today")">

                @tickets.Count @I18n.T("Tickets")

            </span>

            <span class="appt-count-pill" style="background:#eff6ff; color:#1d4ed8; border-color:#bfdbfe;" title="@I18n.T("Waiting in OPD queue")">

                ⏱️ @WaitingCount @I18n.T("Waiting")

            </span>

            <span class="appt-count-pill" style="background:#ecfdf5; color:#047857; border-color:#a7f3d0;" title="@I18n.T("Today's total fee collection")">

                ৳ @TotalTodayCollection.ToString("N0") @I18n.T("Collection")

            </span>

            @if (!string.IsNullOrWhiteSpace(message))

            {

                <span class="appt-inline-alert @messageClass" title="@message">

                    @message

                </span>

            }

        </div>

        <div class="appt-top-actions">

            <!-- Print Slip Format Toggle -->

            <div class="tickets-print-mode-group" title="@I18n.T("Select printer slip format")">

                <button type="button" class="tickets-mode-pill @(isThermalMode ? "active" : "")" @onclick="() => isThermalMode = true" title="80mm Thermal POS Slip">

                    🖨️ @I18n.T("80mm POS")

                </button>

                <button type="button" class="tickets-mode-pill @(!isThermalMode ? "active" : "")" @onclick="() => isThermalMode = false" title="Standard A4 Voucher">

                    📄 @I18n.T("A4 Sheet")

                </button>

            </div>

            <!-- Auto-Print Toggle -->

            <button type="button" class="tickets-auto-print-pill @(autoPrint ? "active" : "")" @onclick="ToggleAutoPrint" title="@I18n.T("Automatically open print dialogue upon issuing ticket")">

                ⚡ @(autoPrint ? I18n.T("Auto-Print ON") : I18n.T("Auto-Print"))

            </button>

            <!-- Quick Patient Registration Modal -->

            <button type="button" class="btn btn-secondary appt-btn" @onclick="OpenNewPatientModal" title="@I18n.T("Quick Patient Registration")">

                + @I18n.T("New Patient")

            </button>

            <!-- Daily Register Print -->

            <button type="button" class="btn btn-secondary appt-btn" @onclick="PrintDailyAsync" title="@I18n.T("Print Daily Consultation Register")">

                🖨️ @I18n.T("Daily Register")

            </button>

            <!-- Reset / New Ticket -->

            <button type="button" class="btn btn-secondary appt-btn" @onclick="Reset" title="@I18n.T("New Ticket / Clear Form (Esc)")">

                + @I18n.T("New Ticket")

            </button>

        </div>

    </div>

    <!-- Main Balanced Workspace Grid: Full Widescreen Two-Column Form Card -->

    <div class="appt-classic-workspace">

        <div class="appt-form-card tickets-wide-card">

            <!-- Card Header with Next Token & Drawer Trigger -->

            <div class="appt-card-header">

                <div class="appt-card-header-title-wrap" style="display: flex; align-items: center; gap: 10px;">

                    <h2>@(editor.ID == 0 ? I18n.T("Issue New OPD Ticket") : $"{I18n.T("Edit Ticket")} #{editor.ID}")</h2>

                    <span class="appt-serial-badge @(editor.ID == 0 ? "emerald" : "violet")">

                        @(editor.ID == 0 ? $"{I18n.T("NEXT TOKEN #")}{NextAvailableTokenNo:00}" : $"{I18n.T("TOKEN #")}{CurrentTokenNo:00}")

                    </span>

                </div>

                <button type="button" 

                        class="appt-schedule-trigger-btn @(showScheduleDrawer ? "active" : "")" 

                        @onclick="ToggleScheduleDrawer" 

                        title="@I18n.T("View Today's OPD Tickets & Patient Queue (F2 / Ctrl+Q)")">

                    <span>📋</span>

                    <span>@I18n.T("Today's Tickets & Queue")</span>

                    <span class="trigger-pill">@tickets.Count</span>

                    @if (WaitingCount > 0)

                    {

                        <span class="trigger-pill checked" title="@I18n.T("Waiting in Queue")">

                            ⏳ @WaitingCount

                        </span>

                    }

                </button>

            </div>

            <!-- Form Content -->

            <EditForm Model="editor" OnValidSubmit="SaveAsync" @onkeydown="HandleFormKeyDown" style="display:flex; flex-direction:column; min-height:0; flex:1 1 auto;">

                <DataAnnotationsValidator />

                <div class="appt-form-body appt-form-twocol">

                    <!-- =========================================================================

                         Left Column: Doctor Selection, Fee Row & Notes

                         ========================================================================= -->

                    <div class="appt-col-left">

                        <!-- Consultant Doctor Search with Department Filter (Exact match to Appointments.razor) -->

                        <div class="appt-field-group">

                            <span class="appt-field-label">

                                <span>@I18n.T("Consultant Doctor")<span class="req">*</span></span>

                            </span>

                            <div class="appt-doctor-search-combo-wrap" id="appt-doctor-search-box" style="position: relative; width: 100%;">

                                <div style="display: flex; gap: 6px; align-items: center;">

                                    <select class="classic-input appt-dept-filter-select"

                                            value="@selectedDepartmentId"

                                            @onchange="HandleDepartmentFilterChanged"

                                            style="flex: 0 0 145px; max-width: 155px; height: 30px; font-size: 11.5px; font-weight: 650; cursor: pointer; background-color: #f8fafc; border: 1px solid #cbd5e1; border-radius: 6px;"

                                            title="@I18n.T("Filter by Department")">

                                        <option value="0">📂 @I18n.T("All Depts")</option>

                                        @foreach (var dept in departments.OrderBy(d => d.Value))

                                        {

                                            <option value="@dept.Key">@dept.Value</option>

                                        }

                                    </select>

                                    <div class="appt-doctor-search" style="flex: 1; min-width: 0; position: relative;">

                                        <input class="classic-input"

                                               id="appt-doctor-search-input"

                                               value="@doctorSearchText"

                                               @oninput="HandleDoctorSearchInputAsync"

                                               @onfocus="ShowDoctorSuggestions"

                                               @onkeydown="HandleDoctorSearchKeyDown"

                                               autocomplete="off"

                                               placeholder="@I18n.T("Search doctor ID, name, or specialty...")"

                                               title="@I18n.T("Search doctor")" />

                                    </div>

                                </div>

                                @if (showDoctorSuggestions)

                                {

                                    <div class="appt-doctor-suggestions" id="appt-doctor-suggestions-list" style="position: absolute; top: calc(100% + 2px); left: 0; right: 0; z-index: 120;">

                                        @if (filteredDoctorItems.Count > 0)

                                        {

                                            @foreach (var item in VisibleDoctorItems)

                                            {

                                                var doctor = item.Doctor;

                                                <button type="button"

                                                        @key="doctor.ID"

                                                        class="appt-doctor-option @(editor.DoctorID == doctor.ID ? "selected" : "")"

                                                        @onmousedown:preventDefault

                                                        @onclick="() => SelectDoctor(doctor)">

                                                    <div class="appt-doctor-option-main">

                                                        <span class="appt-doctor-option-name">

                                                            @if (doctor.Priority.HasValue && doctor.Priority.Value > 0)

                                                            {

                                                                <span class="appt-priority-pill" title="Priority #@doctor.Priority">⭐ #@doctor.Priority</span>

                                                            }

                                                            @item.DisplayName

                                                        </span>

                                                        <span class="appt-doctor-option-id">

                                                            @if (doctor.OpdConsultationFee.HasValue && doctor.OpdConsultationFee.Value > 0)

                                                            {

                                                                <span style="color:#0284c7; font-weight:800; margin-right:4px;">OPD ৳@doctor.OpdConsultationFee.Value.ToString("0")</span>

                                                            }

                                                            ID: D@(doctor.ID)

                                                        </span>

                                                    </div>

                                                    <div class="appt-doctor-option-sub">

                                                        @item.Degree@if (!string.IsNullOrWhiteSpace(item.DepartmentName)){<text> &bull; @item.DepartmentName</text>}@if(!string.IsNullOrWhiteSpace(item.Room)){<text> &bull; Room @item.Room</text>}

                                                    </div>

                                                </button>

                                            }

                                            @if (VisibleDoctorsCount < filteredDoctorItems.Count)

                                            {

                                                <div class="appt-doctor-scroll-hint"

                                                     @onmousedown:preventDefault

                                                     @onclick="LoadMoreDoctorsFromJs">

                                                    @I18n.T("Showing") @VisibleDoctorsCount / @filteredDoctorItems.Count &bull; @I18n.T("Scroll for more...")

                                                </div>

                                            }

                                        }

                                        else

                                        {

                                            <div class="appt-doctor-empty">

                                                @I18n.T("No doctor found")

                                                @if (selectedDepartmentId > 0)

                                                {

                                                    <button type="button" class="btn btn-link btn-sm p-0 ms-1" style="font-size: 11px; vertical-align: baseline;" @onmousedown:preventDefault @onclick="ResetDeptFilter">(@I18n.T("Show All"))</button>

                                                }

                                            </div>

                                        }

                                    </div>

                                }

                            </div>

                        </div>

                        <!-- Selected Doctor Card with Live Queue Count -->

                        @if (SelectedDoctor != null && editor.DoctorID > 0)

                        {

                            <div class="selected-doctor-badge" style="background:#f0f9ff; border:1px solid #7dd3fc; padding:5px 10px; border-radius:6px; display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:2px;">

                                <div style="display:flex; align-items:center; gap:8px; min-width:0;">

                                    <div class="doctor-caduceus-avatar" style="width:26px; height:26px; border-radius:6px; background:#e0f2fe; border:1px solid #7dd3fc; display:inline-flex; align-items:center; justify-content:center; flex-shrink:0;" title="@I18n.T("Consultant Doctor")">

                                        <img src="images/caduceus.png" alt="Medical Doctor" style="width:14px; height:20px; object-fit:contain; filter: brightness(0) saturate(100%) invert(26%) sepia(88%) saturate(1540%) hue-rotate(182deg) brightness(96%) contrast(97%);" />

                                    </div>

                                    <div style="display:flex; flex-direction:column; min-width:0;">

                                        <strong style="font-size:12px; color:#0369a1; font-weight:800; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">

                                            @DoctorDisplayName(SelectedDoctor)

                                        </strong>

                                        <small style="font-size:10.5px; color:#475569; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">

                                            @CleanDoctorDegree(SelectedDoctor)

                                            @if (SelectedDoctor.Department.HasValue && departments.TryGetValue(SelectedDoctor.Department.Value, out var dn))

                                            {

                                                <span> &bull; @dn</span>

                                            }

                                            @if (!string.IsNullOrWhiteSpace(SelectedDoctor.Room))

                                            {

                                                <span style="font-weight:700; color:#0284c7;"> &bull; Room @SelectedDoctor.Room</span>

                                            }

                                        </small>

                                    </div>

                                </div>

                                <div style="display:flex; align-items:center; gap:6px; flex-shrink:0;">

                                    @if (SelectedDoctor.OpdConsultationFee.HasValue && SelectedDoctor.OpdConsultationFee.Value > 0)

                                    {

                                        <span class="pill" style="font-size:10.5px; font-weight:800; background:#f0f9ff; color:#0284c7; border:1px solid #bae6fd;" title="@I18n.T("Doctor OPD Consultation Fee")">

                                            OPD ৳ @SelectedDoctor.OpdConsultationFee.Value.ToString("N0")

                                        </span>

                                    }

                                    @if (SelectedDoctor.ConsultationFee.HasValue && SelectedDoctor.ConsultationFee.Value > 0)

                                    {

                                        <span class="pill" style="font-size:10.5px; font-weight:800; background:#ecfdf5; color:#047857; border:1px solid #a7f3d0;" title="@I18n.T("Regular Consultation Fee")">

                                            Reg ৳ @SelectedDoctor.ConsultationFee.Value.ToString("N0")

                                        </span>

                                    }

                                    <span class="pill" style="font-size:10.5px; font-weight:700; background:#e0f2fe; color:#0369a1; border:1px solid #bae6fd;" title="@I18n.T("Patients in queue for this doctor today")">

                                        ⏱️ @DoctorTodayCount @I18n.T("in queue")

                                    </span>

                                </div>

                            </div>

                        }

                        <!-- Follow-up Re-visit Alert Banner (if within 14 days) -->

                        @if (isFollowUpDetected && lastVisitTicket != null)

                        {

                            <div class="tickets-followup-banner" style="margin-bottom: 2px;">

                                <div class="tickets-followup-info">

                                    <span>ℹ️ <strong>@I18n.T("Follow-up / Re-visit Alert"):</strong> @I18n.T("Patient visited") <strong>@DoctorDisplayName(SelectedDoctor)</strong> @I18n.T("on") <strong>@lastVisitTicket.TransDate.ToString("dd MMM yyyy")</strong> (@lastVisitDaysAgo @I18n.T("days ago")).</span>

                                </div>

                                <button type="button" class="tickets-followup-action-btn" @onclick="ApplyFollowUpRate" title="@I18n.T("Apply follow-up consultation rate")">

                                    ✓ @I18n.T("Apply Follow-up Rate")

                                </button>

                            </div>

                        }

                        <!-- Compact Fee Row: Ticket Type | Fee | Received | Change (100% Consistent Top Label Baseline & 30px Height) -->

                                                <div class="tickets-fee-row">
                            <div class="appt-field-group ticket-type-col">
                                <span class="appt-field-label">
                                    <span>@I18n.T("Ticket Type")<span class="req">*</span></span>
                                </span>

                                <div class="tickets-type-dropdown-container">
                                    <button type="button" 
                                            class="tickets-type-dropdown-trigger @(isTicketTypeOpen ? "open" : "")" 
                                            @onclick="ToggleTicketTypeDropdown"
                                            title="@I18n.T("Choose ticket category or fee slab")">
                                        <div class="tickets-type-trigger-left">
                                            <span class="tickets-type-trigger-icon">🎫</span>
                                            <span class="tickets-type-trigger-name">@GetSelectedTicketTypeName()</span>
                                        </div>
                                        <div class="tickets-type-trigger-right">
                                            <span class="tickets-type-trigger-rate">
                                                ৳@editor.Total.ToString("0.##")
                                            </span>
                                            <svg class="tickets-type-trigger-arrow @(isTicketTypeOpen ? "rotated" : "")" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="6 9 12 15 18 9"></polyline>
                                            </svg>
                                        </div>
                                    </button>

                                    @if (isTicketTypeOpen)
                                    {
                                        <div class="tickets-type-dropdown-backdrop" @onclick="CloseTicketTypeDropdown"></div>
                                        <div class="tickets-type-dropdown-menu">
                                            <div class="tickets-type-menu-header">
                                                <span style="font-weight: 700; color: #1e293b; font-size: 11px;">@I18n.T("Select OPD Ticket Type")</span>
                                                <span style="font-size: 10px; color: #64748b;">@AvailableTicketCount @I18n.T("Available")</span>
                                            </div>
                                            <div class="tickets-type-menu-list">
                                                @* Option 1: Doctor Profile OPD Fee (DEFAULT when doctor has OPD fee) *@
                                                @if (HasSelectedDoctorOpdFee)
                                                {
                                                    <button type="button" 
                                                            class="tickets-type-menu-item @(isUsingDoctorOpdFee ? "selected" : "")" 
                                                            @onclick="SelectDoctorOpdFeeAndClose">
                                                        <div class="tickets-type-item-main">
                                                            <span class="tickets-type-item-bullet">🏷️</span>
                                                            <div class="tickets-type-item-info">
                                                                <div class="tickets-type-item-title-row">
                                                                    <span class="tickets-type-item-title">@I18n.T("Doctor OPD Fee")</span>
                                                                    <span class="tickets-type-default-badge">@I18n.T("DEFAULT")</span>
                                                                </div>
                                                                <span class="tickets-type-item-hint">
                                                                    🩺 @I18n.T("Doctor Profile OPD Fee") (@(DoctorDisplayName(SelectedDoctor)))
                                                                </span>
                                                            </div>
                                                        </div>
                                                        <div class="tickets-type-item-rate-wrap">
                                                            <span class="tickets-type-item-rate @(isUsingDoctorOpdFee ? "active" : "")">
                                                                ৳@SelectedDoctor!.OpdConsultationFee!.Value.ToString("0.##")
                                                            </span>
                                                            @if (isUsingDoctorOpdFee)
                                                            {
                                                                <span class="tickets-type-item-check">✓</span>
                                                            }
                                                        </div>
                                                    </button>
                                                }

                                                @* Option 2+: Ticket Types from masters/clinical?section=ticket-types *@
                                                @foreach (var type in ticketTypes.Where(x => x.IsActive || x.ID.ToString() == editor.TicketRate))
                                                {
                                                    var isSelected = !isUsingDoctorOpdFee && editor.TicketRate == type.ID.ToString();
                                                    var isDefaultType = !HasSelectedDoctorOpdFee && type.ID == DefaultTicketType?.ID;

                                                    <button type="button" 
                                                            class="tickets-type-menu-item @(isSelected ? "selected" : "")" 
                                                            @onclick="() => SelectMasterTicketRateAndClose(type)">
                                                        <div class="tickets-type-item-main">
                                                            <span class="tickets-type-item-bullet">🎫</span>
                                                            <div class="tickets-type-item-info">
                                                                <div class="tickets-type-item-title-row">
                                                                    <span class="tickets-type-item-title">@type.Name</span>
                                                                    @if (isDefaultType)
                                                                    {
                                                                        <span class="tickets-type-default-badge">@I18n.T("DEFAULT")</span>
                                                                    }
                                                                </div>
                                                                <span class="tickets-type-item-hint">
                                                                    📋 @I18n.T("Standard Master Rate") (@I18n.T("Ticket Types & Fee"))
                                                                </span>
                                                            </div>
                                                        </div>
                                                        <div class="tickets-type-item-rate-wrap">
                                                            <span class="tickets-type-item-rate @(isSelected ? "active" : "")">
                                                                ৳@type.Amount.ToString("0.##")
                                                            </span>
                                                            @if (isSelected)
                                                            {
                                                                <span class="tickets-type-item-check">✓</span>
                                                            }
                                                        </div>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="appt-field-group fee-col">
                                <span class="appt-field-label">@I18n.T("Fee")</span>
                                <InputNumber class="classic-input tickets-fee-input" @bind-Value="editor.Total" />
                            </div>

                            <div class="appt-field-group received-col">
                                <span class="appt-field-label">@I18n.T("Received")</span>
                                <input type="number"
                                       class="classic-input"
                                       value="@(cashTendered > 0 ? cashTendered.ToString("0.##") : "")"
                                       @oninput="HandleCashTenderedInput"
                                       placeholder="@editor.Total.ToString("0")" />
                            </div>

                            <div class="appt-field-group change-col">
                                <span class="appt-field-label">@(cashTendered > 0 && cashTendered < editor.Total ? I18n.T("Due") : I18n.T("Change"))</span>
                                <div class="tickets-change-box @(cashTendered > 0 && cashTendered < editor.Total ? "due" : "")">
                                    ৳ @(cashTendered > 0 && cashTendered < editor.Total ? CashDue.ToString("N0") : CashChange.ToString("N0"))
                                </div>
                            </div>
                        </div>

                        <!-- Clinical Notes & Chief Complaint -->

                        <div class="appt-field-group">

                            <span class="appt-field-label">@I18n.T("Clinical Notes / Chief Complaint")</span>

                            <InputText class="classic-input" @bind-Value="editor.Comments" placeholder="@I18n.T("e.g. Fever, cough, follow-up, general consultation...")" />

                            <div class="tickets-complaint-chips">

                                <button type="button" class="complaint-chip" @onclick='() => AddComplaintSnippet("Fever & Cough")'>+ Fever & Cough</button>

                                <button type="button" class="complaint-chip" @onclick='() => AddComplaintSnippet("General Checkup")'>+ General Checkup</button>

                                <button type="button" class="complaint-chip" @onclick='() => AddComplaintSnippet("Follow-up Visit")'>+ Follow-up Visit</button>

                                <button type="button" class="complaint-chip" @onclick='() => AddComplaintSnippet("Report Review")'>+ Report Review</button>

                                <button type="button" class="complaint-chip" @onclick='() => AddComplaintSnippet("Severe Pain")'>+ Severe Pain</button>

                            </div>

                        </div>

                    </div>

                    <!-- =========================================================================

                         Right Column: Patient Intake, Demographics & Vitals

                         ========================================================================= -->

                    <div class="appt-col-right">

                        <!-- Patient Intake Header & Mode Toggle -->

                        <div class="appt-field-group">

                            <div class="appt-patient-header-row">

                                <span class="appt-field-label">

                                    <span>@I18n.T("Patient Information")<span class="req">*</span></span>

                                </span>

                                <div class="appt-mode-toggle">

                                    <button type="button" class="appt-mode-btn @(isWalkInMode ? "active" : "")" @onclick="() => SetPatientMode(true)">

                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">

                                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>

                                            <circle cx="12" cy="7" r="4"></circle>

                                        </svg>

                                        <span>@I18n.T("Walk-in")</span>

                                    </button>

                                    <button type="button" class="appt-mode-btn @(!isWalkInMode ? "active" : "")" @onclick="() => SetPatientMode(false)">

                                        <SearchIcon />

                                        <span>@I18n.T("Registered")</span>

                                    </button>

                                </div>

                            </div>

                            @if (!isWalkInMode)

                            {

                                @if (!string.IsNullOrWhiteSpace(editor.RegNo) && !string.IsNullOrWhiteSpace(editor.Name))

                                {

                                    <div class="appt-patient-verified">

                                        <div class="appt-patient-verified-info">

                                            <strong>#@editor.RegNo</strong> &bull; @editor.Name

                                            @if (!string.IsNullOrWhiteSpace(editor.Sex))

                                            {

                                                <text> &bull; </text>

                                                <span class="meta-tag sex-tag-@editor.Sex.ToLowerInvariant()">

                                                    @(editor.Sex == "Male" ? "♂ Male" : editor.Sex == "Female" ? "♀ Female" : editor.Sex)

                                                </span>

                                            }

                                            @if (!string.IsNullOrWhiteSpace(editor.Age)) { <text> &bull; @editor.Age</text> }

                                            @if (!string.IsNullOrWhiteSpace(patientWeight)) { <text> &bull; ⚖️ @patientWeight kg</text> }

                                            @if (!string.IsNullOrWhiteSpace(patientContact)) { <text> &bull; 📞 @patientContact</text> }

                                        </div>

                                        <button type="button" class="appt-clear-link" @onclick="ClearSelectedPatient" title="@I18n.T("Search different patient")">

                                            @I18n.T("Change")

                                        </button>

                                    </div>

                                }

                                else

                                {

                                    <div class="appt-patient-search-field">

                                        <div class="appt-patient-search-combo">

                                            <input class="classic-input"

                                                   value="@patientSearchQuery"

                                                   @oninput="HandlePatientSearchInputAsync"

                                                   @onfocus="ShowPatientIdSuggestionsAsync"

                                                   @onblur="HidePatientSuggestionsAsync"

                                                   @onkeydown="HandlePatientSearchKeyDown"

                                                   autocomplete="off"

                                                   placeholder="@I18n.T("Search by Patient ID, Mobile or Name...")"

                                                   title="@I18n.T("Search patient")" />

                                            <button type="button" class="btn-find" @onclick="() => FindPatientAsync(patientSearchQuery)" title="@I18n.T("Search Patient")">

                                                <SearchIcon /> @I18n.T("Search")

                                            </button>

                                        </div>

                                        @if (showPatientIdSuggestions)

                                        {

                                            <div class="appt-patient-suggestions" id="appt-patient-suggestions-list">

                                                @foreach (var patient in patientIdSuggestions)

                                                {

                                                    <button type="button" class="appt-patient-option" @onmousedown:preventDefault @onclick="() => SelectPatient(patient)">

                                                        <span class="patient-id">@patient.PatientID</span>

                                                        <span class="patient-name">@patient.Name</span>

                                                        @if (!string.IsNullOrWhiteSpace(patient.Sex))

                                                        {

                                                            <span class="meta-tag sex-tag-@patient.Sex.ToLowerInvariant()">

                                                                @(patient.Sex == "Male" ? "♂ Male" : patient.Sex == "Female" ? "♀ Female" : patient.Sex)

                                                            </span>

                                                        }

                                                        @if (!string.IsNullOrWhiteSpace(patient.Weight))

                                                        {

                                                            <span class="patient-weight-pill">⚖️ @patient.Weight kg</span>

                                                        }

                                                        <span class="patient-contact">@patient.Contact</span>

                                                    </button>

                                                }

                                            </div>

                                        }

                                    </div>

                                }

                            }

                        </div>

                        <!-- Patient Name & Mobile No -->

                        <div style="display: flex; gap: 8px;">

                            <div class="appt-field-group" style="flex: 1.4; min-width: 0;">

                                <span class="appt-field-label">

                                    <span>@I18n.T("Patient Name")<span class="req">*</span></span>

                                </span>

                                <InputText class="classic-input" @bind-Value="editor.Name" placeholder="@I18n.T("Full name of patient")" />

                            </div>

                            <div class="appt-field-group" style="flex: 1; min-width: 0;">

                                <span class="appt-field-label">@I18n.T("Mobile No")</span>

                                <input type="text" class="classic-input" @bind="patientContact" placeholder="017xxxxxxxx" />

                            </div>

                        </div>

                        <!-- Sex (Using identical .sex-btn-group from Appointments & Patients) -->

                        <div class="appt-field-group appt-field-sex">

                            <span class="appt-field-label">@I18n.T("Sex")</span>

                            <div class="sex-btn-group" role="radiogroup" aria-label="@I18n.T("Sex")">

                                @foreach (var sex in sexOptions)

                                {

                                    var isSelected = string.Equals(editor.Sex, sex.Key, StringComparison.OrdinalIgnoreCase);

                                    var sexClass = sex.Key.ToLowerInvariant();

                                    <button type="button"

                                            class="sex-btn sex-btn-@sexClass @(isSelected ? "is-selected" : "")"

                                            tabindex="@(isSelected ? 0 : -1)"

                                            @onclick="() => SelectSex(sex.Key)"

                                            title="@I18n.T(sex.Label)">

                                        <span class="sex-icon">

                                            @if (sex.Key == "Male")

                                            {

                                                <svg class="sex-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">

                                                    <circle cx="10" cy="14" r="5"></circle>

                                                    <line x1="19" y1="5" x2="13.6" y2="10.4"></line>

                                                    <polyline points="15 5 19 5 19 9"></polyline>

                                                </svg>

                                            }

                                            else if (sex.Key == "Female")

                                            {

                                                <svg class="sex-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">

                                                    <circle cx="12" cy="9" r="5"></circle>

                                                    <line x1="12" y1="14" x2="12" y2="21"></line>

                                                    <line x1="9" y1="18" x2="15" y2="18"></line>

                                                </svg>

                                            }

                                            else

                                            {

                                                <svg class="sex-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">

                                                    <circle cx="12" cy="12" r="4"></circle>

                                                    <line x1="12" y1="4" x2="12" y2="8"></line>

                                                    <line x1="10" y1="5" x2="14" y2="5"></line>

                                                    <line x1="12" y1="16" x2="12" y2="20"></line>

                                                    <line x1="10" y1="19" x2="14" y2="19"></line>

                                                </svg>

                                            }

                                        </span>

                                        <span class="sex-text">@I18n.T(sex.Label)</span>

                                    </button>

                                }

                            </div>

                        </div>

                        <!-- Age · Weight · BP · Pulse in ONE 100% Consistent Row (All using .appt-unit-input-box with unit addons) -->

                        <div class="tickets-vitals-row">

                            <div class="appt-field-group">

                                <span class="appt-field-label">@I18n.T("Age")</span>

                                <div class="appt-unit-input-box">

                                    <InputText class="classic-input appt-unit-input" @bind-Value="editor.Age" placeholder="28" />

                                    <span class="appt-unit-addon">Yrs</span>

                                </div>

                            </div>

                            <div class="appt-field-group">

                                <span class="appt-field-label">@I18n.T("Weight")</span>

                                <div class="appt-unit-input-box">

                                    <input type="text" class="classic-input appt-unit-input" @bind="patientWeight" placeholder="65" />

                                    <span class="appt-unit-addon">kg</span>

                                </div>

                            </div>

                            <div class="appt-field-group">

                                <span class="appt-field-label">@I18n.T("BP")</span>

                                <div class="appt-unit-input-box">

                                    <input type="text" class="classic-input appt-unit-input" @bind="bloodPressure" placeholder="120/80" />

                                    <span class="appt-unit-addon">mmHg</span>

                                </div>

                            </div>

                            <div class="appt-field-group">

                                <span class="appt-field-label">@I18n.T("Pulse")</span>

                                <div class="appt-unit-input-box">

                                    <input type="text" class="classic-input appt-unit-input" @bind="pulseRate" placeholder="72" />

                                    <span class="appt-unit-addon">bpm</span>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Form Footer -->

                <div class="appt-form-footer">

                    <div class="appt-footer-left-info">

                        @if (editor.ID > 0)

                        {

                            <button class="btn btn-ghost appt-btn" type="button" @onclick="DeleteSelectedAsync" style="color: #dc2626;" title="@I18n.T("Delete Ticket")">

                                @I18n.T("Delete")

                            </button>

                        }

                    </div>

                    <div class="appt-footer-right-actions">

                        <button class="btn btn-ghost appt-btn" type="button" @onclick="Reset" title="@I18n.T("Clear Form")">

                            @I18n.T("Clear")

                        </button>

                        <button class="btn btn-secondary appt-btn" type="submit" disabled="@saving" title="@I18n.T("Issue ticket without printing")">

                            ✓ @(saving ? I18n.T("Saving...") : editor.ID == 0 ? I18n.T("Issue Ticket") : I18n.T("Update Ticket"))

                        </button>

                        <button class="btn btn-primary appt-btn appt-book-btn" type="button" @onclick="SaveAndPrintAsync" disabled="@saving" title="@I18n.T("Issue & Print Ticket (Ctrl+Enter / F9)")">

                            🖨️ @I18n.T("Issue & Print")

                        </button>

                    </div>

                </div>

            </EditForm>

        </div>

    </div>

    <!-- =========================================================================

         Actionable Daily Tickets & Patient Queue Slide-Over Drawer

         ========================================================================= -->

    <div class="appt-drawer-backdrop @(showScheduleDrawer ? "show" : "")" @onclick="CloseScheduleDrawer"></div>

    <aside class="appt-drawer-panel @(showScheduleDrawer ? "show" : "")" aria-label="@I18n.T("Daily Tickets & Queue")">

        <div class="appt-drawer-header">

            <div class="appt-drawer-title-wrap">

                <span style="font-size:16px;">📋</span>

                <h3 class="appt-drawer-title">

                    @I18n.T("Today's OPD Queue & Tickets")

                </h3>

            </div>

            <div style="display:flex; align-items:center; gap:8px;">

                <span style="font-size:11.5px; font-weight:700; color:#475569;">

                    📅 @DateTime.Today.ToString("dd MMM yyyy")

                </span>

                <button type="button" class="appt-drawer-close" @onclick="CloseScheduleDrawer" title="@I18n.T("Close Drawer (Esc)")" aria-label="@I18n.T("Close")">

                    ✕

                </button>

            </div>

        </div>

        <div class="appt-drawer-body">

            <div class="appt-queue-card" style="border:none; border-radius:0; box-shadow:none; height:100%;">

                <div class="appt-queue-top">

                    <div class="appt-queue-title-wrap">

                        <h2>@I18n.T("Patient Queue")</h2>

                        <span class="appt-date-sub">(@DateTime.Today.ToString("dd MMM"))</span>

                    </div>

                    <!-- Scope Switcher: All Doctors vs Current Doctor -->

                    <div style="display:flex; flex-direction:column; gap:6px; width:100%; margin-top:4px;">

                        <div class="appt-scope-tabs">

                            <button type="button"

                                    class="appt-scope-tab @(!filterByCurrentDoctor ? "active" : "")"

                                    @onclick="() => SetDoctorScope(false)"

                                    title="@I18n.T("Show all tickets")">

                                👥 @I18n.T("All Doctors")

                                <span class="count-pill">@tickets.Count</span>

                            </button>

                            <button type="button"

                                    class="appt-scope-tab @(filterByCurrentDoctor ? "active" : "")"

                                    @onclick="() => SetDoctorScope(true)"

                                    title="@I18n.T("Filter by selected doctor")">

                                🩺 @(editor.DoctorID > 0 && doctorById.TryGetValue(editor.DoctorID, out var dItem) ? dItem.DisplayName : I18n.T("Doctor Wise"))

                                <span class="count-pill">@DoctorTodayCount</span>

                            </button>

                        </div>

                    </div>

                </div>

                <!-- Status Filter Strip (including 'From Appts' tab) -->

                <div class="appt-queue-filter-strip">

                    <div class="appt-status-chips">

                        <button type="button" class="status-chip @(statusFilter == "All" ? "active" : "")" @onclick='() => SetStatusFilter("All")'>

                            @I18n.T("All") (@ScopedTickets.Count())

                        </button>

                        <button type="button" class="status-chip checkedin @(statusFilter == "Waiting" ? "active" : "")" @onclick='() => SetStatusFilter("Waiting")'>

                            @I18n.T("Waiting") (@ScopedTickets.Count(t => !completedEncounterTicketIds.Contains(t.ID)))

                        </button>

                        <button type="button" class="status-chip booked @(statusFilter == "Done" ? "active" : "")" @onclick='() => SetStatusFilter("Done")'>

                            @I18n.T("Done") (@ScopedTickets.Count(t => completedEncounterTicketIds.Contains(t.ID)))

                        </button>

                        <button type="button" class="status-chip @(statusFilter == "Appointments" ? "active" : "")" @onclick='() => SetStatusFilter("Appointments")' title="@I18n.T("Today's booked appointments waiting for tickets")">

                            📅 @I18n.T("From Appts") (@todayAppointments.Count)

                        </button>

                    </div>

                    <span style="font-size:11px; font-weight:700; color:#64748b;">

                        @(statusFilter == "Appointments" ? todayAppointments.Count : FilteredTickets.Count()) @I18n.T("Listed")

                    </span>

                </div>

                <!-- Scanner Bar -->

                <div class="appt-scanner-bar">

                    <div class="appt-scanner-input-wrap">

                        <span class="appt-scanner-icon"><SearchIcon /></span>

                        <input type="text"

                               class="classic-input appt-scanner-input"

                               placeholder="@I18n.T("Scan barcode/QR or search token, patient, phone...")"

                               @bind="ticketScanQuery"

                               @bind:event="oninput"

                               @bind:after="ResetTicketPage"

                               @onkeydown="HandleTicketScanKeyDown" />

                        @if (!string.IsNullOrWhiteSpace(ticketScanQuery))

                        {

                            <button type="button" class="appt-scanner-clear" @onclick="ClearTicketScan" title="Clear">✕</button>

                        }

                    </div>

                </div>

                <!-- Queue List Content -->

                <div class="appt-queue-list">

                    @if (statusFilter == "Appointments")

                    {

                        <!-- Appointments Tab: Today's Booked Appointments -->

                        @if (!todayAppointments.Any())

                        {

                            <div class="appt-empty-state">

                                <div class="appt-empty-state-icon">📅</div>

                                <div class="appt-empty-state-title">@I18n.T("No booked appointments today")</div>

                                <div class="appt-empty-state-desc">@I18n.T("All appointments have either been issued tickets or there are no bookings for today.")</div>

                            </div>

                        }

                        @foreach (var appt in todayAppointments)

                        {

                            <div class="appt-queue-item @(appt.Status == "CheckedIn" ? "checkedin-item" : "")">

                                <div class="appt-serial-col">

                                    <span class="appt-queue-serial">#@appt.ApptSLNO.ToString("00")</span>

                                    <span class="appt-time-pill">@appt.ApptDate.ToString("hh:mm tt")</span>

                                </div>

                                <div class="appt-queue-info">

                                    <div class="appt-name-row">

                                        <strong class="appt-queue-name">@appt.Name</strong>

                                        <span class="pill pill-success" style="font-size:10px; font-weight:700;">

                                            @appt.Status

                                        </span>

                                    </div>

                                    <div class="appt-queue-meta">

                                        @if (!string.IsNullOrWhiteSpace(appt.PatientID))

                                        {

                                            <span class="meta-tag id-tag">ID: @appt.PatientID</span>

                                            <span class="meta-sep">&bull;</span>

                                        }

                                        @if (!string.IsNullOrWhiteSpace(appt.Sex))

                                        {

                                            <span class="meta-tag sex-tag-@appt.Sex.ToLowerInvariant()">@(appt.Sex == "Male" ? "♂ Male" : appt.Sex == "Female" ? "♀ Female" : appt.Sex)</span>

                                            <span class="meta-sep">&bull;</span>

                                        }

                                        @if (!string.IsNullOrWhiteSpace(appt.ContactNo))

                                        {

                                            <span>@appt.ContactNo</span>

                                            <span class="meta-sep">&bull;</span>

                                        }

                                        <span class="meta-doc">🩺 @DoctorName(appt.DoctorID)</span>

                                    </div>

                                </div>

                                <div class="appt-queue-actions">

                                    <button type="button" class="appt-action-checkin" @onclick="() => IssueTicketFromAppointmentAsync(appt)" title="@I18n.T("Issue OPD ticket for this appointment")">

                                        🎟️ @I18n.T("Issue Ticket")

                                    </button>

                                </div>

                            </div>

                        }

                    }

                    else

                    {

                        <!-- Issued Tickets List -->

                        @if (!FilteredTickets.Any())

                        {

                            <div class="appt-empty-state">

                                <div class="appt-empty-state-icon">📋</div>

                                <div class="appt-empty-state-title">@I18n.T("No tickets found")</div>

                                <div class="appt-empty-state-desc">@I18n.T("No consultation tickets matching current filter.")</div>

                            </div>

                        }

                        @foreach (var ticket in VisibleTickets)

                        {

                            var tokenNum = GetTokenNo(ticket);

                            var isCompleted = completedEncounterTicketIds.Contains(ticket.ID);

                            <div class="appt-queue-item @(isCompleted ? "checkedin-item" : "") @(editor.ID == ticket.ID ? "active" : "")">

                                <div class="appt-serial-col">

                                    <span class="appt-queue-serial">#@tokenNum.ToString("00")</span>

                                    <span class="appt-time-pill">@ticket.TransDate.ToString("hh:mm tt")</span>

                                </div>

                                <div class="appt-queue-info">

                                    <div class="appt-name-row">

                                        <strong class="appt-queue-name">@ticket.Name</strong>

                                        <span class="pill @(isCompleted ? "pill-success" : "")" style="font-size:10px; font-weight:700;">

                                            @(isCompleted ? I18n.T("Completed") : I18n.T("Waiting"))

                                        </span>

                                    </div>

                                    <div class="appt-queue-meta">

                                        @if (!string.IsNullOrWhiteSpace(ticket.RegNo))

                                        {

                                            <span class="meta-tag id-tag">ID: @ticket.RegNo</span>

                                            <span class="meta-sep">&bull;</span>

                                        }

                                        @if (!string.IsNullOrWhiteSpace(ticket.Sex))

                                        {

                                            <span class="meta-tag sex-tag-@ticket.Sex.ToLowerInvariant()">

                                                @(ticket.Sex == "Male" ? "♂ Male" : ticket.Sex == "Female" ? "♀ Female" : ticket.Sex)

                                            </span>

                                            <span class="meta-sep">&bull;</span>

                                        }

                                        @if (!string.IsNullOrWhiteSpace(ticket.Age))

                                        {

                                            <span>@ticket.Age</span>

                                            <span class="meta-sep">&bull;</span>

                                        }

                                        <span class="meta-doc">🩺 @DoctorName(ticket.DoctorID)</span>

                                        @if (!string.IsNullOrWhiteSpace(ticket.Room))

                                        {

                                            <span class="meta-sep">&bull;</span>

                                            <span style="font-weight:700; color:#0284c7;">Room @ticket.Room</span>

                                        }

                                    </div>

                                </div>

                                <div class="appt-queue-actions">

                                    <span class="tickets-queue-fee" style="font-size:11px; font-weight:800; color:#059669; margin-right:4px;">

                                        @(I18n.FormatCurrency(ticket.Total))

                                    </span>

                                    <button class="appt-tool-btn" @onclick="() => PrintTicketFromDrawerAsync(ticket)" title="@I18n.T("Print Slip")">

                                        🖨️

                                    </button>

                                    <button class="appt-tool-btn" @onclick="() => SelectAndCloseDrawer(ticket)" title="@I18n.T("Edit (Select & Open in Form)")">

                                        ✎

                                    </button>

                                    <button class="appt-tool-btn" @onclick="() => DeleteAsync(ticket)" style="color:#dc2626;" title="@I18n.T("Delete / Reverse Ticket")">

                                        ×

                                    </button>

                                </div>

                            </div>

                        }

                    }

                </div>

                @if (statusFilter != "Appointments" && TicketPageCount > 1)

                {

                    <div class="appt-queue-pager">

                        <button type="button" @onclick="PreviousTicketPage" disabled="@(ticketPage == 0)" aria-label="Previous">&lsaquo;</button>

                        <span>@(ticketPage + 1) / @TicketPageCount</span>

                        <button type="button" @onclick="NextTicketPage" disabled="@(ticketPage >= TicketPageCount - 1)" aria-label="Next">&rsaquo;</button>

                    </div>

                }

            </div>

        </div>

    </aside>

</div>

<!-- =========================================================================

     Quick Patient Registration Modal

     ========================================================================= -->

@if (showNewPatientModal)

{

    <div class="quick-patient-modal-backdrop" @onclick="CloseNewPatientModal">

        <div class="quick-patient-modal-dialog" @onclick:stopPropagation>

            <div class="quick-patient-modal-header">

                <h3>👤 @I18n.T("Quick Patient Registration")</h3>

                <button type="button" class="appt-drawer-close" @onclick="CloseNewPatientModal">✕</button>

            </div>

            <div class="quick-patient-modal-body">

                @if (!string.IsNullOrWhiteSpace(newPatientError))

                {

                    <div class="appt-inline-alert danger" style="margin-bottom:8px;">@newPatientError</div>

                }

                <!-- Patient Name -->

                <div class="appt-field-group">

                    <span class="appt-field-label"><span>@I18n.T("Patient Name")<span class="req">*</span></span></span>

                    <input type="text" class="classic-input" @bind="newPatientModel.Name" placeholder="@I18n.T("Full patient name...")" autofocus />

                </div>

                <!-- Contact & Age -->

                <div style="display:flex; gap:8px;">

                    <div class="appt-field-group" style="flex:1.2; min-width:0;">

                        <span class="appt-field-label">@I18n.T("Mobile No")</span>

                        <input type="text" class="classic-input" @bind="newPatientModel.Contact" placeholder="017xxxxxxxx" />

                    </div>

                    <div class="appt-field-group" style="flex:1; min-width:0;">

                        <span class="appt-field-label">@I18n.T("Age (Years)")</span>

                        <div class="appt-unit-input-box">

                            <input type="number" class="classic-input appt-unit-input" @bind="newPatientAge" placeholder="30" />

                            <span class="appt-unit-addon">Yrs</span>

                        </div>

                    </div>

                </div>

                <!-- Sex Selection -->

                <div class="appt-field-group">

                    <span class="appt-field-label">@I18n.T("Sex")</span>

                    <div class="sex-btn-group" role="radiogroup">

                        <button type="button" class="sex-btn sex-btn-male @(newPatientModel.Sex == "Male" ? "is-selected" : "")" @onclick='() => newPatientModel.Sex = "Male"'>

                            <span class="sex-text">♂ @I18n.T("Male")</span>

                        </button>

                        <button type="button" class="sex-btn sex-btn-female @(newPatientModel.Sex == "Female" ? "is-selected" : "")" @onclick='() => newPatientModel.Sex = "Female"'>

                            <span class="sex-text">♀ @I18n.T("Female")</span>

                        </button>

                        <button type="button" class="sex-btn sex-btn-other @(newPatientModel.Sex == "Other" ? "is-selected" : "")" @onclick='() => newPatientModel.Sex = "Other"'>

                            <span class="sex-text">⚥ @I18n.T("Other")</span>

                        </button>

                    </div>

                </div>

                <!-- Weight & Blood Group -->

                <div style="display:flex; gap:8px;">

                    <div class="appt-field-group" style="flex:1; min-width:0;">

                        <span class="appt-field-label">@I18n.T("Weight (kg)")</span>

                        <div class="appt-unit-input-box">

                            <input type="text" class="classic-input appt-unit-input" @bind="newPatientModel.Weight" placeholder="e.g. 65" />

                            <span class="appt-unit-addon">kg</span>

                        </div>

                    </div>

                    <div class="appt-field-group" style="flex:1; min-width:0;">

                        <span class="appt-field-label">@I18n.T("Blood Group")</span>

                        <select class="classic-input appt-select" @bind="newPatientModel.BloodGroup">

                            <option value="">-- @I18n.T("Select") --</option>

                            <option value="A+">A+</option>

                            <option value="A-">A-</option>

                            <option value="B+">B+</option>

                            <option value="B-">B-</option>

                            <option value="O+">O+</option>

                            <option value="O-">O-</option>

                            <option value="AB+">AB+</option>

                            <option value="AB-">AB-</option>

                        </select>

                    </div>

                </div>

            </div>

            <div class="quick-patient-modal-footer">

                <button type="button" class="btn btn-ghost appt-btn" @onclick="CloseNewPatientModal">@I18n.T("Cancel")</button>

                <button type="button" class="btn btn-primary appt-btn" @onclick="SaveQuickPatientAsync" disabled="@savingNewPatient">

                    ✓ @(savingNewPatient ? I18n.T("Registering...") : I18n.T("Register & Use in Ticket"))

                </button>

            </div>

        </div>

    </div>

}

<!-- =========================================================================

     Print Documents (Hidden on Screen via .print-document)

     ========================================================================= -->

<!-- 1. Standard A4 Consultation Ticket Slip -->

<div id="ticket-print" class="print-document">

    <div class="print-sheet">

        <PrintDocumentHeader Title="OPD Doctor Consultation Ticket"

                             DocNo="@($"#{editor.ID}")"

                             DocNoLabel="Ticket"

                             BarcodeCode="@($"TKT-{editor.ID:00000}")"

                             QrPayload="@BarcodeQr.GenerateTicketQrPayload(editor.ID, int.TryParse(editor.RegNo, out var pid) ? pid : 0, editor.Name ?? "", DoctorName(editor.DoctorID), editor.Total)" />

        <div class="print-grid">

            <div style="grid-column:span 2; background:#f0f9ff; border:1.5px solid #0284c7; padding:8px 12px; border-radius:6px; display:flex; justify-content:space-between; align-items:center;">

                <span style="font-size:13px; font-weight:800; color:#0369a1;">@I18n.T("CONSULTATION TOKEN NUMBER")</span>

                <b style="font-size:24px; color:#0284c7; font-weight:900;">#@(CurrentTokenNo > 0 ? CurrentTokenNo.ToString("00") : editor.ID.ToString())</b>

            </div>

            <div><span>@I18n.T("Patient Name")</span><b>@editor.Name</b></div>

