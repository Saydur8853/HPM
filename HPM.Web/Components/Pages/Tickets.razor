        <!-- Footer -->

        <div style="text-align: center; font-size: 9px; color: #555; margin-top: 4px;">

            <div>Please keep this slip and wait for your token call.</div>

            <div style="font-weight: 700; margin-top: 2px;">*** Get Well Soon ***</div>

        </div>

    </div>

</div>

