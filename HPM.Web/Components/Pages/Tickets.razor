    private void SelectDoctor(DoctorsProfile doc)
    {
        editor.DoctorID = doc.ID;
        if (!string.IsNullOrWhiteSpace(doc.Room)) editor.Room = doc.Room;
        if (doc.Department.HasValue && doc.Department.Value > 0)
        {
            editor.DeptID = doc.Department.Value;
            selectedDepartmentId = doc.Department.Value;
        }
        doctorSearchText = $"D{doc.ID} - {DoctorDisplayName(doc)}";
        showDoctorSuggestions = false;

        // User requirement: "doctor er profile e set kora opd Consultation Fee jodi select thake taile ticket type hobe default."
        var defaultType = DefaultTicketType;
        if (defaultType != null)
        {
            editor.TicketRate = defaultType.ID.ToString();
        }

        if (doc.OpdConsultationFee.HasValue && doc.OpdConsultationFee.Value > 0)
        {
