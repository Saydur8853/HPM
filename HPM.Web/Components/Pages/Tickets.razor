    private DoctorsProfile? SelectedDoctor => doctors.FirstOrDefault(d => d.ID == editor.DoctorID);

    private int DoctorTodayCount => tickets.Count(t => t.DoctorID == editor.DoctorID);

    private int WaitingCount => tickets.Count(t => !completedEncounterTicketIds.Contains(t.ID));

    private decimal TotalTodayCollection => tickets.Sum(t => t.Total);

    private int CurrentTokenNo => currentQueueNo > 0 ? currentQueueNo : (editor.ID > 0 && ticketEncounterMap.TryGetValue(editor.ID, out var q) ? q : (int)editor.ID);

    private int NextAvailableTokenNo => nextQueueCounter;

    private int GetTokenNo(OPDTicket ticket) => ticketEncounterMap.TryGetValue(ticket.ID, out var q) ? q : (int)ticket.ID;

    private IEnumerable<OPDTicket> ScopedTickets => filterByCurrentDoctor && editor.DoctorID > 0

        ? tickets.Where(t => t.DoctorID == editor.DoctorID)

        : tickets;

    private IEnumerable<OPDTicket> FilteredTickets

    {

        get

        {

            var list = ScopedTickets;

            if (statusFilter == "Waiting")

                list = list.Where(t => !completedEncounterTicketIds.Contains(t.ID));

            else if (statusFilter == "Done")

                list = list.Where(t => completedEncounterTicketIds.Contains(t.ID));

            if (!string.IsNullOrWhiteSpace(ticketScanQuery))

            {

                var q = ticketScanQuery.Trim();

                list = list.Where(t => t.ID.ToString().Contains(q, StringComparison.OrdinalIgnoreCase)

                                    || (t.Name?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)

                                    || (t.RegNo?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));

            }

            return list;

        }

    }

    private int TicketPageCount => Math.Max(1, (int)Math.Ceiling(FilteredTickets.Count() / (double)TicketPageSize));

    private IEnumerable<OPDTicket> VisibleTickets => FilteredTickets

        .Skip(ticketPage * TicketPageSize)

        .Take(TicketPageSize);

    protected override async Task OnInitializedAsync()

    {

        I18n.OnLanguageChanged += HandleLanguageChanged;

        try

        {

            await using var db = await DbFactory.CreateDbContextAsync();

            doctors = await db.Doctors.AsNoTracking()

                .Where(x => x.IsActive)

                .OrderBy(x => x.Priority.HasValue && x.Priority.Value > 0 ? 0 : 1)

                .ThenBy(x => x.Priority)

                .ThenBy(x => x.Name)

                .ToListAsync();

            departments = await db.Departments.AsNoTracking().ToDictionaryAsync(d => d.ID, d => d.Name);

            ticketTypes = await db.TicketTypes.AsNoTracking().OrderBy(x => x.ID).ToListAsync();

            BuildDoctorCache();

            SetDefaults();

            await LoadTicketsAsync();

            await LoadTodayAppointmentsAsync();

        }

        catch (Exception ex)

        {

            messageClass = "danger";

            message = $"Initialization error: {ex.GetBaseException().Message}";

        }

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)

    {

        dotNetRef ??= DotNetObjectReference.Create(this);

        if (showDoctorSuggestions)

        {

            try

            {

                await JS.InvokeVoidAsync("hpm.initDoctorInfiniteScroll", "appt-doctor-search-box", "appt-doctor-suggestions-list", dotNetRef);

            }

            catch

            {

            }

        }

    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnParametersSetAsync()

    {

        var patientId = QueryPatientId ?? PatientSelection.PatientId;

        if (!string.IsNullOrWhiteSpace(patientId) && editor.ID == 0)

        {

            editor.RegNo = patientId.Trim();

            patientSearchQuery = patientId.Trim();

            isWalkInMode = false;

            await FindPatientAsync(patientId);

        }

    }

    private void BuildDoctorCache()

    {

        var list = new List<DoctorViewItem>(doctors.Count);

        var map = new Dictionary<int, DoctorViewItem>(doctors.Count);

        foreach (var d in doctors)

        {

            var disp = DoctorDisplayName(d);

            var deg = CleanDoctorDegree(d);

            var deptName = d.Department.HasValue && departments.TryGetValue(d.Department.Value, out var dn) ? dn : string.Empty;

            var room = CleanDoctorRoom(d.Room);

            var haystack = $"D{d.ID} {d.ID} {disp} {deg} {deptName} {room} {d.Room}";

            var item = new DoctorViewItem(d, disp, deg, deptName, room, haystack);

            list.Add(item);

            map[d.ID] = item;

        }

        doctorViewItems = list;

        doctorById = map;

        UpdateFilteredDoctors();

    }

    private void UpdateFilteredDoctors()

    {

        var term = doctorSearchText.Trim();

        IEnumerable<DoctorViewItem> query = doctorViewItems;

        if (selectedDepartmentId > 0)

        {

            query = query.Where(x => x.Doctor.Department == selectedDepartmentId);

        }

        if (!string.IsNullOrWhiteSpace(term) && (editor.DoctorID <= 0 || !doctorSearchText.StartsWith($"D{editor.DoctorID}")))

        {

            query = query.Where(x => x.SearchHaystack.Contains(term, StringComparison.OrdinalIgnoreCase));

        }

        filteredDoctorItems = query.ToList();

    }

    private void ResetDeptFilter()

    {

        selectedDepartmentId = 0;

        doctorVisibleCount = DoctorBatchSize;

        UpdateFilteredDoctors();

    }

    private void HandleDepartmentFilterChanged(ChangeEventArgs e)

    {

        selectedDepartmentId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;

        if (editor.DoctorID > 0 && selectedDepartmentId > 0 && SelectedDoctor?.Department != selectedDepartmentId)

        {

            editor.DoctorID = 0;

            doctorSearchText = string.Empty;

        }

        doctorVisibleCount = DoctorBatchSize;

        UpdateFilteredDoctors();

    }

    private void HandleDoctorSearchInputAsync(ChangeEventArgs e)

    {

        doctorSearchText = e.Value?.ToString() ?? string.Empty;

        showDoctorSuggestions = true;

        doctorVisibleCount = DoctorBatchSize;

        UpdateFilteredDoctors();

