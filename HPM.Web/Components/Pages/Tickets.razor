<div id="ticket-thermal-print" class="print-document">

    <div class="thermal-sheet" style="width: 76mm; padding: 4mm 2mm; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size: 11px; line-height: 1.25; color: #000000; margin: 0 auto;">

        <!-- Header -->

        <div style="text-align: center; border-bottom: 1.5px dashed #000; padding-bottom: 4px; margin-bottom: 6px;">

