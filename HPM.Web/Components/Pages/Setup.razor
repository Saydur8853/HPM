@page "/setup"
@attribute [AllowAnonymous]
@layout Layout.LoginLayout
@implements IDisposable
@inject HospitalSetupService HospitalSetup
@inject NavigationManager Navigation

<PageTitle>@I18n.T("Hospital Setup & Branding", "Hospital Setup")</PageTitle>

<div class="login-card setup-card">
    <div class="login-brand"><span class="brand-mark">H+</span><div><strong>@I18n.T("Hospital Setup & Branding", "Hospital Setup")</strong><small>@I18n.T("First-time configuration", "First-time configuration")</small></div></div>
    <div class="login-heading"><span class="eyebrow">One-time setup</span><h1>Configure your hospital</h1><p>Create the App Owner account and hospital profile. The App Owner can then grant modules and create the Hospital Owner.</p></div>
    @if (!string.IsNullOrWhiteSpace(message)) { <div class="alert danger">@message</div> }
    <EditForm Model="model" OnValidSubmit="CompleteAsync" class="login-form">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <label><span>@I18n.T("Hospital name *", "Hospital name")</span><InputText @bind-Value="model.HospitalName" autocomplete="organization" /></label>
        <label><span>Hospital photo/logo (optional)</span><InputFile OnChange="UploadLogoAsync" accept="image/png,image/jpeg,image/webp" /></label>
        <label><span>App Owner user ID</span><InputText @bind-Value="model.UserName" autocomplete="username" /></label>
        <label><span>App Owner password</span><InputText type="password" @bind-Value="model.Password" autocomplete="new-password" /></label>
        <label><span>@I18n.T("Confirm password", "Confirm password")</span><InputText type="password" @bind-Value="model.ConfirmPassword" autocomplete="new-password" /></label>
        <button class="btn btn-primary login-button" type="submit" disabled="@saving">@(saving ? I18n.T("Setting up...", "Setting up...") : I18n.T("Complete setup", "Complete setup"))</button>
    </EditForm>
</div>

@code {
    private readonly SetupModel model = new();
    private string message = string.Empty;
    private bool saving;
    private string? logoData;

    private async Task UploadLogoAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > 2_000_000 || file.ContentType is not ("image/png" or "image/jpeg" or "image/webp"))
        { message = "Use a PNG, JPEG or WebP image under 2 MB."; return; }
        await using var stream = file.OpenReadStream(2_000_000);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);
        logoData = $"data:{file.ContentType};base64,{Convert.ToBase64String(memory.ToArray())}";
        message = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        await HospitalSetup.LoadAsync();
        if (HospitalSetup.IsSetupComplete)
            Navigation.NavigateTo("/login", true);
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => I18n.OnLanguageChanged -= HandleLanguageChanged;

    private async Task CompleteAsync()
    {
        saving = true;
        message = string.Empty;
        var result = await HospitalSetup.CompleteAsync(
            model.HospitalName, model.UserName, model.Password, model.ConfirmPassword, logoData);
        saving = false;
        if (!result.Succeeded) { message = result.Error; return; }
        Navigation.NavigateTo("/login?setup=1", true);
    }

    private sealed class SetupModel
    {
        [Required, StringLength(150, MinimumLength = 2)] public string HospitalName { get; set; } = string.Empty;
        [Required] public string UserName { get; set; } = string.Empty;
        [Required, MinLength(8)] public string Password { get; set; } = string.Empty;
        [Required] public string ConfirmPassword { get; set; } = string.Empty;
    }
}
