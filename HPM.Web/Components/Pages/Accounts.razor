    private decimal VoucherAmount(long id) => allLines.Where(x => x.VoucherID == id).Sum(x => x.Debit);
    private string AccountName(int id) => accounts.FirstOrDefault(x => x.ID == id)?.Name ?? "—";
    private async Task<int> CurrentUserIdAsync() { var u = (await AuthStateProvider.GetAuthenticationStateAsync()).User; return int.TryParse(u.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : 1; }
    private async Task PrintLedgerAsync() => await JS.InvokeVoidAsync("hpm.printElement", "accounts-ledger-print", "General Ledger");
    private void Success(string text) { messageClass = "success"; message = text; }
    private void Fail(string text) { messageClass = "danger"; message = text; }
    private sealed record LedgerRow(DateTime Date, string VoucherNo, int AccountID, string? Narration, decimal Debit, decimal Credit);
    private sealed record ReconciliationRow(DateTime Date, decimal CentralCash, decimal GlCash) { public decimal Variance => CentralCash - GlCash; }
