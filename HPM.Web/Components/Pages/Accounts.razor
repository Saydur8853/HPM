    private async Task PrintActiveReportAsync(string format)
    {
        if (activeTab == "voucher")
        {
            var target = selectedVoucher ?? FilteredVouchers.OrderByDescending(x => x.ID).FirstOrDefault();
            if (target != null)
            {
                await PrintVoucherFormatAsync(target, format);
            }
            else
            {
                await PrintLedgerFormatAsync(format);
            }
