@page "/accounts"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.Cashier)]
@implements IDisposable
@using HPM.Web.Components.Common
@using HPM.Web.Data
@using HPM.Web.Data.Entities
@using HPM.Web.Services
@using HPM.Web.Components.Pages.AccountsParts
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IBarcodeQrService BarcodeQr

<PageTitle>@I18n.T("Hospital Accounts, Vouchers & General Ledger", "অ্যাকাউন্টস, ভাউচার ও জেনারেল লেজার") | @Branding.HospitalName</PageTitle>

<style>
.acc-container {
    max-width: 1520px;
    margin: 0 auto;
    padding: 12px 18px 48px;
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    color: #1e293b;
    outline: none;
}

/* 1. Compact Header */
.acc-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
    flex-wrap: wrap;
    gap: 12px;
}
.acc-title-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}
.acc-title {
    font-size: 17px;
    font-weight: 850;
    color: #0f172a;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
}

/* Period / summary panel (opens on click) */
.acc-panel-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    font-size: 11.5px;
    font-weight: 750;
    color: #0369a1;
    background: #e0f2fe;
    border: 1px solid #bae6fd;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.12s;
}
.acc-panel-toggle:hover, .acc-panel-toggle.open {
    background: #0284c7;
    border-color: #0284c7;
    color: #ffffff;
}
.acc-panel-sep {
    width: 1px;
    height: 14px;
    background: currentColor;
    opacity: 0.35;
}
.acc-panel-badge {
    min-width: 18px;
    padding: 0 5px;
    border-radius: 999px;
    background: #7c3aed;
    color: #ffffff;
    font-size: 10px;
    line-height: 18px;
    text-align: center;
}
.acc-panel-badge.warn {
    background: #dc2626;
}
.acc-panel-caret {
    font-size: 10px;
}
.acc-panel.inline {
    margin-bottom: 4px;
}

/* Print Toolbar Buttons */
.acc-print-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
}
.acc-print-btn {
    padding: 5px 11px;
    font-size: 11.5px;
    font-weight: 750;
    border-radius: 6px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #0f172a;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: all 0.12s;
}
.acc-print-btn:hover {
    background: #f0f9ff;
    border-color: #0284c7;
    color: #0284c7;
}
.acc-print-btn.primary {
    background: #0284c7;
    border-color: #0284c7;
    color: #ffffff;
}
.acc-print-btn.primary:hover {
    background: #0369a1;
}

/* 2. Filter & Period Card */
.acc-filter-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 10px 16px;
    margin-bottom: 14px;
    box-shadow: 0 1px 3px rgba(15,23,42,0.04);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
}
.acc-presets-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
}
.acc-preset-btn {
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 700;
    border: 1px solid #cbd5e1;
    background: #f8fafc;
    color: #475569;
    border-radius: 5px;
    cursor: pointer;
    transition: all 0.12s;
}
.acc-preset-btn:hover {
    background: #e2e8f0;
    color: #0f172a;
}
.acc-preset-btn.active {
    background: #0284c7;
    border-color: #0284c7;
    color: #ffffff;
}
.acc-date-inputs {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}
.acc-date-group {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    font-weight: 700;
    color: #475569;
}

/* 3. KPI Metric Grid */
.acc-kpi-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 10px;
    margin-bottom: 14px;
}
@@media (max-width: 1280px) {
    .acc-kpi-grid {
        grid-template-columns: repeat(3, 1fr);
    }
}
@@media (max-width: 680px) {
    .acc-kpi-grid {
        grid-template-columns: 1fr;
    }
}
.acc-kpi-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 10px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 2px 5px rgba(15,23,42,0.04);
}
.acc-kpi-label {
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    color: #64748b;
    letter-spacing: 0.3px;
}
.acc-kpi-val {
    font-size: 18px;
    font-weight: 900;
    line-height: 1.2;
    margin-top: 2px;
}
.acc-kpi-sub {
    font-size: 10.5px;
    color: #64748b;
    margin-top: 2px;
}
.acc-kpi-icon {
    font-size: 23px;
    opacity: 0.85;
}

/* 4. Interactive Main Tabs */
.acc-tabs-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 2px solid #cbd5e1;
    margin-bottom: 14px;
    gap: 8px;
    flex-wrap: wrap;
}
.acc-tabs-left {
    display: flex;
    gap: 4px;
    flex-wrap: wrap; /* 7 tabs: wrap to a second row instead of hiding tabs off-screen */
    row-gap: 4px;
}
.acc-tab-btn {
    padding: 8px 16px;
    font-size: 12.5px;
    font-weight: 800;
    color: #64748b;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-bottom: none;
    border-radius: 7px 7px 0 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    transition: all 0.15s;
    white-space: nowrap;
}
.acc-tab-btn:hover {
    color: #0284c7;
    background: #f0f9ff;
}
.acc-tab-btn.active {
    background: #ffffff;
    color: #0284c7;
    border-color: #0284c7;
    border-top: 3px solid #0284c7;
    margin-bottom: -2px;
    padding-bottom: 9px;
}

/* 5. Workspace Grid & Cards */
.acc-grid-2col {
    display: grid;
    grid-template-columns: minmax(380px, 470px) minmax(0, 1fr);
    gap: 14px;
    align-items: start;
}
@@media (max-width: 1080px) {
    .acc-grid-2col {
        grid-template-columns: 1fr;
    }
}
.acc-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    box-shadow: 0 3px 10px rgba(15,23,42,0.05);
    overflow: hidden;
    margin-bottom: 14px;
}
.acc-card-header {
    padding: 10px 14px;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
}
.acc-card-title {
    font-size: 13.5px;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 7px;
}
.acc-card-body {
    padding: 14px;
}

/* Filter Pills */
.acc-pill-filter {
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 700;
    border-radius: 20px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #475569;
    cursor: pointer;
    transition: all 0.12s;
}
.acc-pill-filter:hover {
    background: #f1f5f9;
}
.acc-pill-filter.active {
    background: #0284c7;
    color: #ffffff;
    border-color: #0284c7;
}

/* Tables */
.acc-table-wrap {
    overflow-x: auto;
    width: 100%;
}
.acc-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
}
.acc-table th {
    background: #f1f5f9;
    color: #475569;
    font-weight: 800;
    text-align: left;
    padding: 8px 10px;
    border-bottom: 2px solid #cbd5e1;
    white-space: nowrap;
}
.acc-table th.num, .acc-table td.num {
    text-align: right;
}
.acc-table td {
    padding: 7px 10px;
    border-bottom: 1px solid #e2e8f0;
    vertical-align: middle;
}
.acc-table tr:hover td {
    background: #f8fafc;
}
.acc-table tr.total-row td {
    background: #f1f5f9;
    font-weight: 900;
    border-top: 2px solid #cbd5e1;
    color: #0f172a;
}

/* Form Elements */
.acc-field-label {
    font-size: 11px;
    font-weight: 750;
    color: #334155;
    margin-bottom: 3px;
    display: block;
}
.acc-chip-btn {
    font-size: 10.5px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid #bae6fd;
    background: #f0f9ff;
    color: #0369a1;
    cursor: pointer;
}
.acc-chip-btn:hover {
    background: #0284c7;
    color: #ffffff;
}

/* Searchable Account Head Dropdown */
.acc-head-picker {
    position: relative;
}
.acc-head-dropdown {
    position: absolute;
    top: calc(100% + 2px);
    left: 0;
    right: 0;
    max-height: 230px;
    overflow-y: auto;
    background: #ffffff;
    border: 1px solid #0284c7;
    border-radius: 6px;
    box-shadow: 0 8px 24px rgba(15,23,42,0.15);
    z-index: 120;
}
.acc-head-option {
    width: 100%;
    text-align: left;
    padding: 7px 10px;
    border: none;
    border-bottom: 1px solid #f1f5f9;
    background: #ffffff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 11.5px;
}
.acc-head-option:hover {
    background: #f0f9ff;
}
</style>

<div class="acc-container" @onkeydown="HandleGlobalKeyDown" tabindex="0">
    <!-- 1. Compact header: current section, period chip (opens the panel), print -->
    <div class="acc-header">
        <div class="acc-title-row">
            <h1 class="acc-title">
                <span>@ActiveTabIcon</span>
                <span>@ActiveTabTitle</span>
            </h1>
            @if (!PanelInline)
            {
            <button type="button" class="acc-panel-toggle @(showPanel ? "open" : "")" @onclick="TogglePanel" title="@(showPanel ? I18n.T("Hide period and summary", "পিরিয়ড ও সারাংশ লুকান") : I18n.T("Show period and summary", "পিরিয়ড ও সারাংশ দেখান"))">
                📅 @fromDate.ToString("dd MMM yyyy") — @toDate.ToString("dd MMM yyyy")
                <span class="acc-panel-sep"></span>
                📊 @I18n.T("Period & Summary", "পিরিয়ড ও সারাংশ")
                @if (pendingCount > 0)
                {
                    <span class="acc-panel-badge" title="@I18n.T("Pending vouchers", "অপেক্ষমাণ ভাউচার")">@pendingCount</span>
                }
                @if (cashDifference != 0)
                {
                    <span class="acc-panel-badge warn" title="@I18n.T("Cash variance needs review", "ক্যাশ পার্থক্য যাচাই প্রয়োজন")">⚠</span>
                }
                <span class="acc-panel-caret">@(showPanel ? "▴" : "▾")</span>
            </button>
            }
        </div>

        <!-- Multi-Format Print Toolbar -->
        <div class="acc-print-bar">
            @if (activeTab is "voucher" or "report" or "particulars")
            {
            <button type="button" class="acc-print-btn primary" @onclick='() => PrintActiveReportAsync("a4")' title="@I18n.T("Print Standard A4 Statement")">
                🖨️ @I18n.T("A4", "A4")
            </button>
            <button type="button" class="acc-print-btn" @onclick='() => PrintActiveReportAsync("a5")' title="@I18n.T("Print Compact A5 Statement")">
                📄 @I18n.T("A5", "A5")
            </button>
            <button type="button" class="acc-print-btn" @onclick='() => PrintActiveReportAsync("80mm")' title="@I18n.T("Print 80mm POS Thermal Slip")">
                🧾 80mm
            </button>
            }
            <button type="button" class="acc-print-btn" @onclick="RefreshAllAsync" title="@I18n.T("Refresh Data", "তথ্য রিফ্রেশ")">
                🔄
            </button>
        </div>
    </div>

    <AccToast Message="@message" Kind="@messageClass" OnClose='() => message = ""' />

    @if (showPanel || PanelInline)
    {
    <div class="acc-panel inline" role="region" aria-label="@I18n.T("Period and summary", "পিরিয়ড ও সারাংশ")">
    <!-- 2. Date Period Filter Bar -->
    <div class="acc-filter-card">
        <div class="acc-presets-bar">
            <span style="font-size:11px; font-weight:800; color:#475569; margin-right:4px;">@I18n.T("Quick Period", "কুইক পিরিয়ড"):</span>
            <button type="button" class="acc-preset-btn @(currentPreset == "today" ? "active" : "")" @onclick='() => ApplyDatePresetAsync("today")'>@I18n.T("Today", "আজ")</button>
            <button type="button" class="acc-preset-btn @(currentPreset == "yesterday" ? "active" : "")" @onclick='() => ApplyDatePresetAsync("yesterday")'>@I18n.T("Yesterday", "গতকাল")</button>
            <button type="button" class="acc-preset-btn @(currentPreset == "7days" ? "active" : "")" @onclick='() => ApplyDatePresetAsync("7days")'>@I18n.T("Last 7 Days", "বিগত ৭ দিন")</button>
            <button type="button" class="acc-preset-btn @(currentPreset == "month" ? "active" : "")" @onclick='() => ApplyDatePresetAsync("month")'>@I18n.T("This Month", "চলতি মাস")</button>
            <button type="button" class="acc-preset-btn @(currentPreset == "year" ? "active" : "")" @onclick='() => ApplyDatePresetAsync("year")'>@I18n.T("This Year", "চলতি বছর")</button>
        </div>

        <div class="acc-date-inputs">
            <div class="acc-date-group">
                <span>@I18n.T("From", "শুরু"):</span>
                <input type="date" class="classic-input" style="height:28px !important; font-size:11.5px !important; width:135px;" value="@fromDate.ToString("yyyy-MM-dd")" @onchange="OnFromDateChanged" />
            </div>
            <div class="acc-date-group">
                <span>@I18n.T("To", "শেষ"):</span>
                <input type="date" class="classic-input" style="height:28px !important; font-size:11.5px !important; width:135px;" value="@toDate.ToString("yyyy-MM-dd")" @onchange="OnToDateChanged" />
            </div>
            <button type="button" class="btn btn-primary" style="height:28px; font-size:11.5px; font-weight:750; padding:0 14px;" @onclick="LoadAsync">
                @I18n.T("Apply Filter", "লোড করুন")
            </button>
        </div>
    </div>

    <!-- 3. Real-Time Executive KPI Cards -->
    <div class="acc-kpi-grid">
        <div class="acc-kpi-card" style="border-left:4px solid #0284c7;">
            <div>
                <div class="acc-kpi-label">@I18n.T("Central Cash", "সেন্ট্রাল ক্যাশ আদায়")</div>
                <div class="acc-kpi-val" style="color:#0369a1;">@I18n.FormatCurrency(cashCollection)</div>
                <div class="acc-kpi-sub">@I18n.T("Operational collection", "কাউন্টার নগদ আদায়")</div>
            </div>
            <div class="acc-kpi-icon">💰</div>
        </div>

        <div class="acc-kpi-card" style="border-left:4px solid #0d9488;">
            <div>
                <div class="acc-kpi-label">@I18n.T("GL Cash Movement", "জিএল ক্যাশ ব্যালেন্স")</div>
                <div class="acc-kpi-val" style="color:#0f766e;">@I18n.FormatCurrency(glCash)</div>
                <div class="acc-kpi-sub">@I18n.T("Approved journals", "অনুমোদিত লেজার")</div>
            </div>
            <div class="acc-kpi-icon">📒</div>
        </div>

        <div class="acc-kpi-card" style="border-left:4px solid @(cashDifference == 0 ? "#10b981" : "#ef4444");">
            <div>
                <div class="acc-kpi-label">@I18n.T("Cash Variance", "ক্যাশ ও লেজার পার্থক্য")</div>
                <div class="acc-kpi-val" style="color:@(cashDifference == 0 ? "#047857" : "#dc2626");">@I18n.FormatCurrency(cashDifference)</div>
                <div class="acc-kpi-sub">@(cashDifference == 0 ? I18n.T("✓ Reconciled", "✓ সম্পূর্ণ মিলেছে") : I18n.T("⚠ Needs review", "⚠ যাচাই প্রয়োজন"))</div>
            </div>
            <div class="acc-kpi-icon">@(cashDifference == 0 ? "✅" : "⚠️")</div>
        </div>

        <div class="acc-kpi-card" style="border-left:4px solid #10b981;">
            <div>
                <div class="acc-kpi-label">@I18n.T("Posted Income", "মোট অনুমোদিত আয়")</div>
                <div class="acc-kpi-val" style="color:#047857;">@I18n.FormatCurrency(income)</div>
                <div class="acc-kpi-sub">@I18n.T("GL revenue heads", "লেজার আয় খাত")</div>
            </div>
            <div class="acc-kpi-icon">📈</div>
        </div>

        <div class="acc-kpi-card" style="border-left:4px solid #f59e0b;">
            <div>
                <div class="acc-kpi-label">@I18n.T("Posted Expense", "মোট অনুমোদিত ব্যয়")</div>
                <div class="acc-kpi-val" style="color:#b45309;">@I18n.FormatCurrency(expense)</div>
                <div class="acc-kpi-sub">@I18n.T("GL expense heads", "লেজার ব্যয় খাত")</div>
            </div>
            <div class="acc-kpi-icon">💸</div>
        </div>

        <div class="acc-kpi-card" style="border-left:4px solid #8b5cf6;">
            <div>
                <div class="acc-kpi-label">@I18n.T("Pending Vouchers", "অপেক্ষমাণ ভাউচার")</div>
                <div class="acc-kpi-val" style="color:#6d28d9;">@pendingCount</div>
                <div class="acc-kpi-sub">@I18n.T("Awaiting approval", "অনুমোদনের অপেক্ষায়")</div>
            </div>
            <div class="acc-kpi-icon">🧾</div>
        </div>
    </div>

    </div>
    }

    <!-- =========================================================================
         TAB 1: VOUCHERS, JOURNAL ENTRY & APPROVAL CONTROL
         ========================================================================= -->
    @if (activeTab == "voucher")
    {
        <div class="acc-grid-2col">
            <!-- Left: Prepare Manual Voucher -->
            <div class="acc-card">
                <div class="acc-card-header">
                    <h2 class="acc-card-title">
                        <span>✍️ @I18n.T("Prepare Double-Entry Voucher", "নতুন ভাউচার তৈরি করুন")</span>
                    </h2>
                    <button type="button" class="btn btn-ghost btn-sm" style="font-size:11px;" @onclick="ResetVoucher">
                        🧹 @I18n.T("Clear / Reset", "রিসেট")
                    </button>
                </div>

                <div class="acc-card-body">
                    <!-- Voucher Type Selector -->
                    <div style="margin-bottom:10px;">
                        <span class="acc-field-label">@I18n.T("Voucher Type *", "ভাউচারের ধরন *")</span>
                        <div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:6px;">
                            @foreach (var vt in new[] { ("Receipt", "📥 " + I18n.T("Receipt", "প্রাপ্তি")), ("Payment", "📤 " + I18n.T("Payment", "প্রদান")), ("Expense", "💸 " + I18n.T("Expense", "খরচ")), ("Journal", "📒 " + I18n.T("Journal", "জার্নাল")) })
                            {
                                <button type="button"
                                        class="acc-preset-btn @(voucherType == vt.Item1 ? "active" : "")"
                                        style="padding:6px 4px; text-align:center;"
                                        @onclick='() => voucherType = vt.Item1'>
                                    @vt.Item2
                                </button>
                            }
                        </div>
                    </div>

                    <div style="font-size:10.5px; color:#64748b; margin:-4px 0 10px;">@VoucherTypeHint</div>

                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:10px;">
                        <div>
                            <span class="acc-field-label">@I18n.T("Voucher Date *", "ভাউচারের তারিখ *")</span>
                            <InputDate class="classic-input" style="height:30px !important;" min="2000-01-01" max="@DateTime.Today.ToString("yyyy-MM-dd")" @bind-Value="voucherDate" />
                        </div>
                        <div>
                            <span class="acc-field-label">@I18n.T("Reference / Invoice #", "রেফারেন্স নং")</span>
                            <input class="classic-input" style="height:30px !important;" maxlength="100" @bind="reference" placeholder="@I18n.T("e.g. INV-1024, BILL-09...", "যেমন: INV-1024, BILL-09...")" />
                        </div>
                    </div>

                    <div style="margin-bottom:10px;">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:3px;">
                            <span class="acc-field-label" style="margin:0;">@I18n.T("Narration / Particulars *", "ভাউচারের বিবরণ *")</span>
                            <div style="display:flex; gap:4px; flex-wrap:wrap;">
                                <button type="button" class="acc-chip-btn" @onclick='() => SetQuickNarration(I18n.T("Daily cash deposited to bank account", "দৈনিক নগদ টাকা ব্যাংকে জমা"))'>🏦 @I18n.T("Bank Deposit", "ব্যাংকে জমা")</button>
                                <button type="button" class="acc-chip-btn" @onclick='() => SetQuickNarration(I18n.T("Hospital utility & electricity bill payment", "হাসপাতালের বিদ্যুৎ ও ইউটিলিটি বিল পরিশোধ"))'>⚡ @I18n.T("Utility", "ইউটিলিটি")</button>
                                <button type="button" class="acc-chip-btn" @onclick='() => SetQuickNarration(I18n.T("Office stationery & medical supplies expense", "অফিস স্টেশনারি ও চিকিৎসা সামগ্রী খরচ"))'>📎 @I18n.T("Stationery", "স্টেশনারি")</button>
                            </div>
                        </div>
                        <input class="classic-input" style="height:30px !important;" maxlength="500" @bind="narration" placeholder="@I18n.T("Enter clear accounting narration...", "পরিষ্কার বিবরণ লিখুন...")" />
                    </div>

                    <!-- Add Journal Line Section with Searchable Account Head Picker -->
                    <div style="background:#f8fafc; border:1px solid #cbd5e1; border-radius:6px; padding:10px; margin-bottom:12px;">
                        <div style="font-size:11.5px; font-weight:800; color:#0f172a; margin-bottom:8px;">
                            ➕ @I18n.T("Add Journal Line (Debit / Credit)", "জার্নাল লাইন যোগ করুন")
                        </div>

                        <!-- Searchable Account Head Picker -->
                        <div style="margin-bottom:8px;" class="acc-head-picker">
                            <span class="acc-field-label">@I18n.T("Account Head *", "হিসাব খাত নির্বাচন করুন *")</span>
                            <div style="position:relative;">
                                <input type="text"
                                       class="classic-input"
                                       style="height:30px !important; padding-right:26px !important;"
                                       placeholder="@I18n.T("Search account head by code or name...", "কোড বা নাম দিয়ে হিসাব খাত খুঁজুন...")"
                                       value="@accountHeadSearchText"
                                       @onfocus="() => showAccountDropdown = true"
                                       @oninput="OnAccountHeadSearchInput" />
                                @if (lineAccountId > 0 || !string.IsNullOrWhiteSpace(accountHeadSearchText))
                                {
                                    <button type="button"
                                            style="position:absolute; right:6px; top:50%; transform:translateY(-50%); border:none; background:none; color:#64748b; cursor:pointer;"
                                            @onclick="ClearSelectedLineAccount">✕</button>
                                }
                            </div>

                            @if (showAccountDropdown)
                            {
                                <div style="position:fixed; inset:0; z-index:110;" @onclick="() => showAccountDropdown = false"></div>
                                <div class="acc-head-dropdown">
                                    @foreach (var acc in FilteredPickerAccounts)
                                    {
                                        <button type="button" class="acc-head-option" @onclick="() => ChooseLineAccount(acc)">
                                            <div>
                                                <strong style="color:#0284c7;">@acc.Code</strong> &mdash; <b>@acc.Name</b>
                                            </div>
                                            <span class="pill" style="font-size:9.5px; background:#f1f5f9; color:#475569;">@TypeName(acc.AccountType)</span>
                                        </button>
                                    }
                                    @if (!FilteredPickerAccounts.Any())
                                    {
                                        <div style="padding:10px; font-size:11px; color:#64748b; text-align:center;">
                                            @I18n.T("No matching active account head found.", "মিলে এমন কোনো সক্রিয় হিসাব খাত নেই।")
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <div style="margin-bottom:8px;">
                            <span class="acc-field-label">
                                @I18n.T("Cost Center (Department)", "কস্ট সেন্টার (বিভাগ)")@(SelectedLineHeadRequiresCc ? " *" : "")
                            </span>
                            <select class="classic-input" style="height:30px !important;" @bind="lineCostCenterId">
                                <option value="0">@(SelectedLineHeadRequiresCc ? I18n.T("Select department (required for this head)...", "বিভাগ নির্বাচন করুন (এই খাতে আবশ্যক)...") : I18n.T("— None —", "— নেই —"))</option>
                                @foreach (var cc in costCenters.Where(x => x.IsActive))
                                {
                                    <option value="@cc.ID">@cc.Code · @cc.Name</option>
                                }
                            </select>
                        </div>

                        <div style="display:grid; grid-template-columns:1fr 1fr auto; gap:8px; align-items:end;">
                            <div>
                                <span class="acc-field-label">@I18n.T("Debit Amount (৳)", "ডেবিট (৳)")</span>
                                <input type="number" class="classic-input" style="height:30px !important;" min="0" max="9999999999999.99" step="0.01" placeholder="0.00" value="@AmountText(lineDebit)" @onchange="e => SetLineAmount(e, debit: true)" />
                            </div>
                            <div>
                                <span class="acc-field-label">@I18n.T("Credit Amount (৳)", "ক্রেডিট (৳)")</span>
                                <input type="number" class="classic-input" style="height:30px !important;" min="0" max="9999999999999.99" step="0.01" placeholder="0.00" value="@AmountText(lineCredit)" @onchange="e => SetLineAmount(e, debit: false)" />
                            </div>
                            <button type="button" class="btn btn-secondary" style="height:30px; font-size:11.5px; font-weight:750;" @onclick="AddVoucherLine">
                                + @I18n.T("Add Line", "যোগ করুন")
                            </button>
                        </div>
                    </div>

                    <!-- Voucher Lines Table -->
                    <div class="acc-table-wrap" style="border:1px solid #e2e8f0; border-radius:6px; margin-bottom:12px;">
                        <table class="acc-table">
                            <thead>
                                <tr>
                                    <th>@I18n.T("Account Head", "হিসাব খাত")</th>
                                    <th class="num">@I18n.T("Debit (৳)", "ডেবিট")</th>
                                    <th class="num">@I18n.T("Credit (৳)", "ক্রেডিট")</th>
                                    <th style="width:40px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (voucherLines.Count == 0)
                                {
                                    <tr>
                                        <td colspan="4" style="text-align:center; padding:16px; color:#94a3b8; font-size:11.5px;">
                                            @I18n.T("Add at least two balanced debit/credit lines above.", "উপরে কমপক্ষে দুটি সমান ডেবিট/ক্রেডিট লাইন যোগ করুন।")
                                        </td>
                                    </tr>
                                }
                                @foreach (var x in voucherLines)
                                {
                                    <tr>
                                        <td>
                                            <strong>@AccountCodeAndName(x.AccountID)</strong>
                                            @if (x.CostCenterID.HasValue) { <div style="font-size:10.5px; color:#0369a1;">🏥 @CostCenterLabel(x.CostCenterID)</div> }
                                        </td>
                                        <td class="num">@(x.Debit > 0 ? I18n.FormatCurrency(x.Debit) : "—")</td>
                                        <td class="num">@(x.Credit > 0 ? I18n.FormatCurrency(x.Credit) : "—")</td>
                                        <td style="text-align:center;">
                                            <button type="button" style="border:none; background:none; color:#dc2626; cursor:pointer; font-weight:800;" @onclick="() => voucherLines.Remove(x)" title="@I18n.T("Remove", "মুছুন")">✕</button>
                                        </td>
                                    </tr>
                                }
                                @{
                                    var totalDr = voucherLines.Sum(x => x.Debit);
                                    var totalCr = voucherLines.Sum(x => x.Credit);
                                    var diff = Math.Abs(totalDr - totalCr);
                                    var isBalanced = voucherLines.Count >= 2 && totalDr > 0 && totalDr == totalCr;
                                }
                                <tr class="total-row">
                                    <td>
                                        @I18n.T("Total", "মোট"):
                                        @if (voucherLines.Count > 0)
                                        {
                                            <span class="pill" style="margin-left:6px; font-size:10px; background:@(isBalanced ? "#d1fae5" : "#fee2e2"); color:@(isBalanced ? "#047857" : "#b91c1c");">
                                                @(isBalanced ? "✓ " + I18n.T("Balanced", "মিলেছে") : $"{I18n.T("Difference", "পার্থক্য")}: {I18n.FormatCurrency(diff)}")
                                            </span>
                                        }
                                    </td>
                                    <td class="num">@I18n.FormatCurrency(totalDr)</td>
                                    <td class="num">@I18n.FormatCurrency(totalCr)</td>
                                    <td></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <button type="button" class="btn btn-primary" style="width:100%; height:34px; font-weight:800; font-size:12.5px;" disabled="@saving" @onclick="SubmitVoucherAsync">
                        ✓ @I18n.T("Submit Voucher for Approval", "ভাউচার অনুমোদনের জন্য জমা দিন")
                    </button>
                </div>
            </div>

            <!-- Right: Voucher Approval & Audit Control Register -->
            <div class="acc-card">
                <div class="acc-card-header">
                    <div>
                        <h2 class="acc-card-title">
                            <span>🧾 @I18n.T("Voucher Approval & Control Register", "ভাউচার অনুমোদন ও অডিট রেজিস্টার")</span>
                        </h2>
                        <div style="font-size:10.5px; color:#64748b; margin-top:2px;">
                            @I18n.T("Posted vouchers are immutable; cancellation generates an equal opposite reversal journal.", "পোস্ট হওয়া ভাউচার বদলানো যায় না; বাতিল করলে সমান উল্টো রিভার্সাল জার্নাল তৈরি হয়।")
                        </div>
                    </div>
                    <span class="pill" style="background:#e0f2fe; color:#0369a1; font-weight:800; font-size:11px;">
                        @FilteredVouchers.Count() @I18n.T("Vouchers", "ভাউচার")
                    </span>
                </div>

                <!-- Search & Filter Bar -->
                <div style="padding:10px 14px; background:#f8fafc; border-bottom:1px solid #e2e8f0; display:flex; flex-direction:column; gap:8px;">
                    <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
                        <div style="position:relative; flex:1; min-width:220px;">
                            <input type="text"
                                   class="classic-input"
                                   style="height:30px !important; padding-left:28px !important; padding-right:24px !important;"
                                   placeholder="@I18n.T("Scan barcode (VCH-XXXX) or search voucher no, ref, narration...", "বারকোড স্ক্যান বা ভাউচার নং, রেফারেন্স, বিবরণ দিয়ে খুঁজুন...")"
                                   @bind="voucherSearchScan"
                                   @bind:event="oninput"
                                   @onkeydown="HandleVoucherScanKeyDownAsync" />
                            <span style="position:absolute; left:9px; top:50%; transform:translateY(-50%); font-size:12px; color:#64748b;">🔍</span>
                            @if (!string.IsNullOrWhiteSpace(voucherSearchScan))
                            {
                                <button type="button" style="position:absolute; right:7px; top:50%; transform:translateY(-50%); border:none; background:none; color:#94a3b8; cursor:pointer;" @onclick='() => voucherSearchScan = ""'>✕</button>
                            }
                        </div>

                        <select class="classic-input" style="height:30px !important; width:135px; font-size:11.5px !important;" @bind="voucherTypeFilter">
                            <option value="ALL">@I18n.T("All Types", "সব ধরন")</option>
                            @foreach (var t in vouchers.Select(v => v.VoucherType).Where(t => !string.IsNullOrWhiteSpace(t)).Distinct().OrderBy(t => t))
                            {
                                <option value="@t">@VoucherTypeName(t)</option>
                            }
                        </select>

                        @if (isAdministrator)
                        {
                            <label style="display:flex; flex-direction:column; gap:2px; margin:0;">
                                <span class="acc-field-label" style="margin:0;">@I18n.T("Reason (required for Reject / Reverse) *", "কারণ (বাতিল / রিভার্সের জন্য আবশ্যক) *")</span>
                                <input class="classic-input"
                                       style="height:30px !important; width:210px; font-size:11.5px !important;"
                                       maxlength="400"
                                       placeholder="@I18n.T("Reason for Reject / Reversal...", "বাতিল / রিভার্সালের কারণ...")"
                                       @bind="actionReason" />
                            </label>
                        }
                    </div>

                    <!-- Status Filter Pills -->
                    <div style="display:flex; gap:6px; flex-wrap:wrap; align-items:center;">
                        <span style="font-size:10.5px; font-weight:750; color:#64748b;">@I18n.T("Status", "অবস্থা"):</span>
                        @foreach (var st in new[] { ("ALL", I18n.T("All", "সব")), ("Pending", "⏳ " + I18n.T("Pending", "অপেক্ষমাণ")), ("Approved", "✓ " + I18n.T("Approved", "অনুমোদিত")), ("Rejected", "✕ " + I18n.T("Rejected", "বাতিল")), ("Cancelled", "↩ " + I18n.T("Reversed", "রিভার্স হয়েছে")) })
                        {
                            <button type="button"
                                    class="acc-pill-filter @(voucherStatusFilter == st.Item1 ? "active" : "")"
                                    @onclick='() => voucherStatusFilter = st.Item1'>
                                @st.Item2
                            </button>
                        }
                    </div>
                </div>

                <!-- Vouchers Table -->
                <div class="acc-table-wrap" style="max-height:560px; overflow-y:auto;">
                    <table class="acc-table">
                        <thead>
                            <tr>
                                <th>@I18n.T("Date / Voucher No", "তারিখ ও ভাউচার নং")</th>
                                <th>@I18n.T("Type", "ধরন")</th>
                                <th>@I18n.T("Reference & Narration", "রেফারেন্স ও বিবরণ")</th>
                                <th>@I18n.T("Status", "স্ট্যাটাস")</th>
                                <th class="num">@I18n.T("Amount (৳)", "পরিমাণ")</th>
                                <th style="text-align:right;">@I18n.T("Print & Actions", "প্রিন্ট ও অ্যাকশন")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!FilteredVouchers.Any())
                            {
                                <tr>
                                    <td colspan="6" style="text-align:center; padding:32px; color:#64748b;">
                                        @I18n.T("No vouchers found matching your filter criteria.", "এই ফিল্টারে কোনো ভাউচার নেই।")
                                    </td>
                                </tr>
                            }
                            @foreach (var x in FilteredVouchers.OrderByDescending(x => x.ID))
                            {
                                var statusBg = x.Status switch { "Approved" => "#d1fae5", "Pending" => "#fef3c7", "Cancelled" => "#f1f5f9", _ => "#fee2e2" };
                                var statusFg = x.Status switch { "Approved" => "#047857", "Pending" => "#b45309", "Cancelled" => "#475569", _ => "#b91c1c" };
                                <tr>
                                    <td>
                                        <div style="font-weight:800; color:#0f172a;">@x.VoucherNo</div>
                                        <div style="font-size:10.5px; color:#64748b;">@x.VoucherDate.ToString("dd MMM yyyy")</div>
                                    </td>
                                    <td>
                                        <span class="pill" style="font-size:10.5px; background:#f1f5f9; color:#334155; font-weight:750;">
                                            @VoucherTypeName(x.VoucherType)
                                        </span>
                                    </td>
                                    <td style="max-width:260px;">
                                        @if (!string.IsNullOrWhiteSpace(x.Reference))
                                        {
                                            <div style="font-size:10.5px; font-weight:750; color:#0284c7;">@I18n.T("Ref", "রেফ"): @x.Reference</div>
                                        }
                                        <div style="font-size:11.5px; color:#1e293b;">@x.Narration</div>
                                    </td>
                                    <td>
                                        <span class="pill" style="font-size:10.5px; background:@statusBg; color:@statusFg; font-weight:800;">
                                            @StatusName(x.Status)
                                        </span>
                                    </td>
                                    <td class="num" style="font-weight:800; color:#0f172a;">
                                        @I18n.FormatCurrency(VoucherAmount(x.ID))
                                    </td>
                                    <td style="text-align:right; white-space:nowrap;">
                                        <div style="display:inline-flex; gap:4px; align-items:center;">
                                            <button type="button" class="acc-print-btn" style="padding:2px 7px; font-size:10.5px;" @onclick='() => PrintVoucherFormatAsync(x, "a4")' title="@I18n.T("Print A4 Voucher", "A4 ভাউচার প্রিন্ট")">🖨️ A4</button>
                                            <button type="button" class="acc-print-btn" style="padding:2px 7px; font-size:10.5px;" @onclick='() => PrintVoucherFormatAsync(x, "a5")' title="@I18n.T("Print A5 Voucher", "A5 ভাউচার প্রিন্ট")">📄 A5</button>
                                            <button type="button" class="acc-print-btn" style="padding:2px 7px; font-size:10.5px;" @onclick='() => PrintVoucherFormatAsync(x, "80mm")' title="@I18n.T("Print 80mm POS Slip", "৮০মিমি স্লিপ প্রিন্ট")">🧾 80mm</button>

                                            @if (isAdministrator && x.Status == "Pending" && x.EnteredBy == currentUserId)
                                            {
                                                <span class="pill" style="font-size:9.5px; background:#fef3c7; color:#b45309;" title="@I18n.T("A voucher must be approved by a different administrator.", "ভাউচার অন্য একজন অ্যাডমিনিস্ট্রেটর অনুমোদন করবেন।")">⏳ @I18n.T("Needs another approver", "অন্য অনুমোদনকারী লাগবে")</span>
                                            }
                                            @if (isAdministrator && x.Status == "Pending" && x.EnteredBy != currentUserId)
                                            {
                                                <button type="button" class="btn btn-primary btn-sm" style="padding:2px 8px; font-size:10.5px; background:#059669; border-color:#059669;" disabled="@saving" @onclick="() => ApproveVoucherAsync(x)">✓ @I18n.T("Approve", "অনুমোদন")</button>
                                                <button type="button" class="btn btn-secondary btn-sm" style="padding:2px 8px; font-size:10.5px; color:#dc2626;" disabled="@saving" @onclick="() => RejectVoucherAsync(x)">✕ @I18n.T("Reject", "বাতিল")</button>
                                            }
                                            @if (isAdministrator && x.Status == "Approved" && x.ReversalOfVoucherID == null && !IsSystemVoucher(x))
                                            {
                                                <button type="button" class="btn btn-secondary btn-sm" style="padding:2px 8px; font-size:10.5px; color:#b45309;" disabled="@saving" @onclick="() => ReverseVoucherAsync(x)">↩ @I18n.T("Reverse", "রিভার্স")</button>
                                            }
                                            @if (x.Status == "Approved" && IsSystemVoucher(x))
                                            {
                                                <span class="pill" style="font-size:9.5px; background:#e0f2fe; color:#0369a1;" title="@I18n.T("Posted automatically by a bill or the month-end close. Change it from where it came from.", "বিল বা মাস-শেষ থেকে নিজে পোস্ট হয়েছে। যেখান থেকে এসেছে সেখান থেকেই বদলান।")">⚙ @I18n.T("Auto", "স্বয়ংক্রিয়")</span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    else if (activeTab == "report")
    {
        <!-- =========================================================================
             TAB 2: GENERAL LEDGER, CASH RECONCILIATION & SHIFT CLOSING
             ========================================================================= -->
        <!-- 2A. General Ledger Statement Card -->
        <div class="acc-card">
            <div class="acc-card-header">
                <div>
                    <h2 class="acc-card-title">
                        <span>📒 @I18n.T("General Ledger Statement", "জেনারেল লেজার স্টেটমেন্ট")</span>
                    </h2>
                    <div style="font-size:11px; color:#64748b;">
                        @I18n.T("Approved and reversal journal entries across selected account heads.")
                    </div>
                </div>

                <div style="display:flex; gap:6px; align-items:center; flex-wrap:wrap;">
                    <button type="button" class="acc-print-btn primary" @onclick='() => PrintLedgerFormatAsync("a4")'>🖨️ @I18n.T("Print A4 Ledger")</button>
                    <button type="button" class="acc-print-btn" @onclick='() => PrintLedgerFormatAsync("a5")'>📄 @I18n.T("Print A5 Ledger")</button>
                    <button type="button" class="acc-print-btn" @onclick='() => PrintLedgerFormatAsync("80mm")'>🧾 @I18n.T("80mm Summary")</button>
                </div>
            </div>

            <!-- Ledger Search & Account Filter Bar -->
            <div style="padding:10px 14px; background:#f8fafc; border-bottom:1px solid #e2e8f0; display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
                <div style="display:flex; align-items:center; gap:6px; min-width:260px;">
                    <span style="font-size:11.5px; font-weight:750; color:#334155; white-space:nowrap;">@I18n.T("Account Head", "হিসাব খাত"):</span>
                    <select class="classic-input" style="height:30px !important; font-size:12px !important;" @bind="ledgerAccountId">
                        <option value="0">@I18n.T("All Account Heads", "সকল হিসাব খাত")</option>
                        @foreach (var x in accounts)
                        {
                            <option value="@x.ID">@x.Code · @x.Name (@TypeName(x.AccountType))</option>
                        }
                    </select>
                </div>

                <div style="display:flex; align-items:center; gap:6px; min-width:220px;">
                    <span style="font-size:11.5px; font-weight:750; color:#334155; white-space:nowrap;">@I18n.T("Department", "বিভাগ"):</span>
                    <select class="classic-input" style="height:30px !important; font-size:12px !important;" @bind="ledgerCostCenterId">
                        <option value="0">@I18n.T("All Departments", "সকল বিভাগ")</option>
                        @foreach (var cc in costCenters)
                        {
                            <option value="@cc.ID">@cc.Code · @cc.Name</option>
                        }
                    </select>
                </div>

                <div style="position:relative; flex:1; min-width:220px;">
                    <input type="text"
                           class="classic-input"
                           style="height:30px !important; padding-left:28px !important;"
                           placeholder="@I18n.T("Search ledger by voucher no, account name, or narration...", "ভাউচার নং, হিসাবের নাম বা বিবরণ দিয়ে লেজার খুঁজুন...")"
                           @bind="ledgerSearchText"
                           @bind:event="oninput" />
                    <span style="position:absolute; left:9px; top:50%; transform:translateY(-50%); font-size:12px; color:#64748b;">🔍</span>
                </div>

                <span class="pill" style="background:#e0f2fe; color:#0369a1; font-weight:800; font-size:11px;">
                    @FilteredLedgerRows.Count() @I18n.T("Entries")
                </span>
            </div>

            <div class="acc-table-wrap" style="max-height:460px; overflow-y:auto;">
                <table class="acc-table">
                    <thead>
                        <tr>
                            <th>@I18n.T("Date", "তারিখ")</th>
                            <th>@I18n.T("Voucher No", "ভাউচার নং")</th>
                            <th>@I18n.T("Account Head", "হিসাব খাত")</th>
                            <th>@I18n.T("Narration / Particulars", "বিবরণ")</th>
                            <th class="num">@I18n.T("Debit (৳)", "ডেবিট")</th>
                            <th class="num">@I18n.T("Credit (৳)", "ক্রেডিট")</th>
                            <th class="num">@(ledgerAccountId > 0 ? I18n.T("Running (Dr - Cr)", "চলমান ব্যালেন্স") : I18n.T("Net (Dr - Cr)", "নিট (ডেবিট - ক্রেডিট)"))</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!FilteredLedgerRows.Any())
                        {
                            <tr>
                                <td colspan="7" style="text-align:center; padding:28px; color:#64748b;">
                                    @I18n.T("No ledger entries found for this period and filter.")
                                </td>
                            </tr>
                        }
                        @{
                            var showOpening = ledgerAccountId > 0 && ledgerCostCenterId == 0 && string.IsNullOrWhiteSpace(ledgerSearchText);
                            decimal runningNet = showOpening ? ledgerOpening.GetValueOrDefault(ledgerAccountId) : 0m;
                            var orderedLedger = FilteredLedgerRows.OrderBy(x => x.Date).ThenBy(x => x.VoucherNo).ToList();
                        }
                        @if (showOpening)
                        {
                            <tr style="background:#f8fafc;">
                                <td style="white-space:nowrap;">@fromDate.ToString("dd MMM yyyy")</td>
                                <td colspan="5" style="font-weight:750; color:#475569;">@I18n.T("Opening balance (before this period)", "প্রারম্ভিক ব্যালেন্স (এই সময়ের আগে)")</td>
                                <td class="num" style="font-weight:800;">@I18n.FormatCurrency(runningNet)</td>
                            </tr>
                        }
                        @foreach (var x in orderedLedger)
                        {
                            runningNet = ledgerAccountId > 0 ? runningNet + (x.Debit - x.Credit) : x.Debit - x.Credit;
                            <tr>
                                <td style="white-space:nowrap;">@x.Date.ToString("dd MMM yyyy")</td>
                                <td><strong style="color:#0284c7;">@x.VoucherNo</strong></td>
                                <td>
                                    <strong>@AccountCodeAndName(x.AccountID)</strong>
                                    @if (x.CostCenterID.HasValue) { <div style="font-size:10.5px; color:#0369a1;">🏥 @CostCenterLabel(x.CostCenterID)</div> }
                                </td>
                                <td>@x.Narration</td>
                                <td class="num" style="font-weight:700;">@(x.Debit > 0 ? I18n.FormatCurrency(x.Debit) : "—")</td>
                                <td class="num" style="font-weight:700;">@(x.Credit > 0 ? I18n.FormatCurrency(x.Credit) : "—")</td>
                                <td class="num" style="font-weight:800; color:#0f172a;">
                                    @I18n.FormatCurrency(runningNet)
                                </td>
                            </tr>
                        }
                        @if (orderedLedger.Count > 0)
                        {
                            var sumDr = orderedLedger.Sum(x => x.Debit);
                            var sumCr = orderedLedger.Sum(x => x.Credit);
                            <tr class="total-row">
                                <td colspan="4" style="text-align:right;">@I18n.T("Period Ledger Total", "সর্বমোট"):</td>
                                <td class="num">@I18n.FormatCurrency(sumDr)</td>
                                <td class="num">@I18n.FormatCurrency(sumCr)</td>
                                <td class="num">@I18n.FormatCurrency(sumDr - sumCr)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 2B. Two-Column Grid: Reconciliation & Cashier Day Closing -->
        <div class="acc-grid-2col">
            <!-- Left: Cashier Day Closing & Financial Period Lock -->
            <div>
                <div class="acc-card">
                    <div class="acc-card-header">
                        <div>
                            <h2 class="acc-card-title">
                                <span>🔒 @I18n.T("Cashier Shift & Day Closing", "ক্যাশিয়ার ডে-ক্লোজিং ও হ্যান্ডওভার")</span>
                            </h2>
                            <div style="font-size:11px; color:#64748b;">
                                @handoverDate.ToString("dd MMM yyyy") &bull; @I18n.T("System Cash", "সিস্টেম ক্যাশ"): <b>@I18n.FormatCurrency(handoverSystem)</b>
                            </div>
                        </div>
                        @if (currentHandover?.IsLocked == true)
                        {
                            <span class="pill" style="background:#fee2e2; color:#b91c1c; font-weight:800;">🔒 @I18n.T("LOCKED", "লক করা")</span>
                        }
                        else
                        {
                            <span class="pill" style="background:#d1fae5; color:#047857; font-weight:800;">🔓 @I18n.T("OPEN", "খোলা")</span>
                        }
                    </div>

                    <div class="acc-card-body">
                        <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:10px;">
                            <div>
                                <span class="acc-field-label">@I18n.T("Business Date", "তারিখ")</span>
                                <InputDate class="classic-input" style="height:30px !important;" max="@DateTime.Today.ToString("yyyy-MM-dd")" @bind-Value="handoverDate" @bind-Value:after="SafeCalculateHandoverAsync" />
                            </div>
                            <div>
                                <span class="acc-field-label">@I18n.T("Declared Handover (৳) *", "হস্তান্তরিত নগদ (৳) *")</span>
                                <InputNumber class="classic-input" style="height:30px !important;" min="0" max="9999999999999.99" step="0.01" @bind-Value="handedAmount" disabled="@(currentHandover?.IsLocked == true)" />
                            </div>
                        </div>

                        <div style="margin-bottom:12px;">
                            <span class="acc-field-label">@I18n.T("Shift Handover Notes", "মন্তব্য / নোট")</span>
                            <input class="classic-input" style="height:30px !important;" @bind="handoverNotes" maxlength="500" disabled="@(currentHandover?.IsLocked == true)" placeholder="@I18n.T("e.g. Handed over to Accounts Officer...", "যেমন: হিসাব কর্মকর্তার কাছে হস্তান্তর করা হয়েছে...")" />
                        </div>

                        <div style="display:flex; gap:8px; flex-wrap:wrap;">
                            @if (currentHandover?.IsLocked != true)
                            {
                                <button type="button" class="btn btn-primary" style="flex:1; height:32px; font-weight:800;" disabled="@saving" @onclick="CloseDayAsync">
                                    🔒 @I18n.T("Close & Lock Shift", "শিফট সমাপ্ত ও লক করুন")
                                </button>
                            }
                            else if (isAdministrator)
                            {
                                <button type="button" class="btn btn-secondary" style="flex:1; height:32px; font-weight:800;" @onclick="ReopenCurrentDayAsync">
                                    🔓 @I18n.T("Reopen Shift", "পুনরায় খুলুন")
                                </button>
                            }
                            <button type="button" class="acc-print-btn" @onclick='() => PrintLedgerFormatAsync("80mm")'>
                                🧾 @I18n.T("Print 80mm Closing Slip")
                            </button>
                        </div>

                        @if (isAdministrator && recentHandovers.Count > 0)
                        {
                            <div style="margin-top:14px; border-top:1px solid #e2e8f0; padding-top:10px;">
                                <div style="font-size:11.5px; font-weight:800; color:#334155; margin-bottom:6px;">
                                    📋 @I18n.T("Recent Cashier Closing Records", "সাম্প্রতিক ক্যাশিয়ার ক্লোজিং")
                                </div>
                                <div style="max-height:190px; overflow-y:auto; display:flex; flex-direction:column; gap:6px;">
                                    @foreach (var x in recentHandovers.Take(10))
                                    {
                                        <div style="display:flex; justify-content:space-between; align-items:center; background:#f8fafc; border:1px solid #e2e8f0; border-radius:6px; padding:6px 10px; font-size:11px;">
                                            <div>
                                                <strong>@x.BusinessDate.ToString("dd MMM yyyy") &bull; @I18n.T("Cashier", "ক্যাশিয়ার") #@x.CashierID</strong>
                                                <div style="color:#64748b; font-size:10.5px;">
                                                    @I18n.T("System", "সিস্টেম"): @I18n.FormatCurrency(x.SystemAmount) &bull; @I18n.T("Handed", "হস্তান্তরিত"): @I18n.FormatCurrency(x.HandedOverAmount) &bull;
                                                    <b>@(x.IsLocked ? "🔒 " + I18n.T("Locked", "লক করা") : "🔓 " + I18n.T("Open", "খোলা"))</b>
                                                </div>
                                            </div>
                                            @if (x.IsLocked)
                                            {
                                                <button type="button" class="acc-chip-btn" @onclick="() => ReopenHandoverAsync(x)">@I18n.T("Reopen", "পুনরায় খুলুন")</button>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @if (isAdministrator)
                {
                    <div class="acc-card">
                        <div class="acc-card-header">
                            <h2 class="acc-card-title">
                                <span>🛡️ @I18n.T("Financial Period Lock", "আর্থিক সময়কাল লক")</span>
                            </h2>
                        </div>
                        <div class="acc-card-body">
                            <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:8px;">
                                <div>
                                    <span class="acc-field-label">@I18n.T("Lock From *", "শুরুর তারিখ *")</span>
                                    <InputDate class="classic-input" style="height:30px !important;" min="2000-01-01" max="2100-12-31" @bind-Value="lockFrom" />
                                </div>
                                <div>
                                    <span class="acc-field-label">@I18n.T("Lock To *", "শেষের তারিখ *")</span>
                                    <InputDate class="classic-input" style="height:30px !important;" min="2000-01-01" max="2100-12-31" @bind-Value="lockTo" />
                                </div>
                            </div>
                            <div style="margin-bottom:10px;">
                                <span class="acc-field-label">@I18n.T("Audit Lock Reason *", "লক করার কারণ *")</span>
                                <input class="classic-input" style="height:30px !important;" @bind="lockReason" maxlength="500" placeholder="@I18n.T("e.g. Monthly audit completed...", "যেমন: মাসিক অডিট সম্পন্ন...")" />
                            </div>
                            <button type="button" class="btn btn-primary" style="width:100%; height:30px; font-size:12px; font-weight:750;" @onclick="LockPeriodAsync">
                                🛡️ @I18n.T("Lock Financial Period", "পিরিয়ড লক করুন")
                            </button>

                            @foreach (var x in periodLocks.Where(x => x.IsActive))
                            {
                                <div style="margin-top:8px; display:flex; justify-content:space-between; align-items:center; background:#fff1f2; border:1px solid #fecdd3; border-radius:6px; padding:6px 10px; font-size:11px;">
                                    <div>
                                        <strong style="color:#b91c1c;">🔒 @x.FromDate.ToString("dd MMM yyyy") – @x.ToDate.ToString("dd MMM yyyy")</strong>
                                        <div style="font-size:10px; color:#64748b;">@x.Reason</div>
                                    </div>
                                    <button type="button" class="acc-chip-btn" @onclick="() => UnlockPeriodAsync(x)">@I18n.T("Unlock", "আনলক")</button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Right: Cash vs General Ledger Daily Reconciliation -->
            <div class="acc-card">
                <div class="acc-card-header">
                    <div>
                        <h2 class="acc-card-title">
                            <span>⚖️ @I18n.T("Cash vs General Ledger Reconciliation", "সেন্ট্রাল ক্যাশ ও জিএল রিকনসিলিয়েশন")</span>
                        </h2>
                        <div style="font-size:11px; color:#64748b;">
                            @I18n.T("Daily comparison between Central Cash Collection and General Ledger Cash Head.")
                        </div>
                    </div>
                    @if (isAdministrator)
                    {
                        <button type="button" class="btn btn-secondary btn-sm" style="font-size:11px; font-weight:750;" disabled="@saving" @onclick="BackfillOperationalJournalsAsync">
                            ⚡ @I18n.T("Sync Operational Journals", "অপারেশনাল জার্নাল সিঙ্ক")
                        </button>
                    }
                </div>

                <div style="padding:8px 14px; background:#f8fafc; border-bottom:1px solid #e2e8f0; display:flex; gap:6px; align-items:center;">
                    <span style="font-size:11px; font-weight:750; color:#64748b;">@I18n.T("Filter"):</span>
                    <button type="button" class="acc-pill-filter @(reconFilter == "all" ? "active" : "")" @onclick='() => reconFilter = "all"'>@I18n.T("All Days", "সব দিন") (@reconciliationRows.Count)</button>
                    <button type="button" class="acc-pill-filter @(reconFilter == "matched" ? "active" : "")" @onclick='() => reconFilter = "matched"'>✓ @I18n.T("Matched", "মিলেছে") (@reconciliationRows.Count(x => x.Variance == 0))</button>
                    <button type="button" class="acc-pill-filter @(reconFilter == "variance" ? "active" : "")" @onclick='() => reconFilter = "variance"'>⚠ @I18n.T("Variance", "পার্থক্য") (@reconciliationRows.Count(x => x.Variance != 0))</button>
                </div>

                <div class="acc-table-wrap" style="max-height:460px; overflow-y:auto;">
                    <table class="acc-table">
                        <thead>
                            <tr>
                                <th>@I18n.T("Business Date", "তারিখ")</th>
                                <th class="num">@I18n.T("Central Cash (৳)", "সেন্ট্রাল ক্যাশ")</th>
                                <th class="num">@I18n.T("GL Cash (৳)", "জিএল ক্যাশ")</th>
                                <th class="num">@I18n.T("Variance (৳)", "পার্থক্য")</th>
                                <th style="text-align:center;">@I18n.T("Status", "স্ট্যাটাস")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var x in FilteredReconciliationRows)
                            {
                                <tr>
                                    <td style="font-weight:750;">@x.Date.ToString("dd MMM yyyy")</td>
                                    <td class="num">@I18n.FormatCurrency(x.CentralCash)</td>
                                    <td class="num">@I18n.FormatCurrency(x.GlCash)</td>
                                    <td class="num" style="font-weight:800; color:@(x.Variance == 0 ? "#047857" : "#dc2626");">
                                        @I18n.FormatCurrency(x.Variance)
                                    </td>
                                    <td style="text-align:center;">
                                        <span class="pill" style="font-size:10px; font-weight:800; background:@(x.Variance == 0 ? "#d1fae5" : "#fee2e2"); color:@(x.Variance == 0 ? "#047857" : "#b91c1c");">
                                            @(x.Variance == 0 ? "✓ MATCHED" : "⚠ REVIEW")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    else if (activeTab == "particulars")
    {
        <!-- =========================================================================
             TAB 3: PARTICULARS HEAD / CHART OF ACCOUNTS (COA)
             ========================================================================= -->
        <div class="acc-grid-2col">
            <!-- Left: Add / Edit Account Head -->
            <div class="acc-card">
                <div class="acc-card-header">
                    <h2 class="acc-card-title">
                        <span>🗂️ @(accountEditor.ID == 0 ? I18n.T("Add New Particulars Head", "নতুন হিসাব খাত যোগ করুন") : I18n.T("Edit Particulars Head", "হিসাব খাত সম্পাদনা"))</span>
                    </h2>
                    <button type="button" class="btn btn-ghost btn-sm" style="font-size:11px;" @onclick="ResetAccount">
                        + @I18n.T("New Head", "নতুন")
                    </button>
                </div>

                <div class="acc-card-body">
                    <div style="margin-bottom:10px;">
                        <span class="acc-field-label">@I18n.T("Account Classification / Type *", "হিসাবের শ্রেণি *")</span>
                        <div style="display:grid; grid-template-columns:repeat(5, 1fr); gap:5px;">
                            @foreach (var t in new[] { "Asset", "Liability", "Equity", "Income", "Expense" })
                            {
                                <button type="button"
                                        class="acc-preset-btn @(accountEditor.AccountType == t ? "active" : "")"
                                        style="padding:5px 2px; text-align:center;"
                                        disabled="@(accountEditor.IsSystem || !isAdministrator)"
                                        @onclick='() => SetAccountEditorType(t)'>
                                    @TypeName(t)
                                </button>
                            }
                        </div>
                    </div>

                    <div style="display:grid; grid-template-columns:130px 1fr; gap:10px; margin-bottom:10px;">
                        <div>
                            <span class="acc-field-label">@I18n.T("Account Code *", "হিসাব কোড *")</span>
                            <input class="classic-input" style="height:30px !important; font-weight:800;" @bind="accountEditor.Code" maxlength="20" disabled="@(accountEditor.IsSystem || !isAdministrator)" placeholder="@I18n.T("e.g. 1010", "যেমন: 1010")" />
                        </div>
                        <div>
                            <span class="acc-field-label">@I18n.T("Particulars / Account Head Name *", "হিসাব খাতের নাম *")</span>
                            <input class="classic-input" style="height:30px !important;" @bind="accountEditor.Name" maxlength="100" disabled="@(!isAdministrator)" placeholder="@I18n.T("e.g. Cash in Hand, Diagnostic Revenue...", "যেমন: হাতে নগদ, ডায়াগনস্টিক আয়...")" />
                        </div>
                    </div>

                    @if (accountEditor.IsSystem)
                    {
                        <div style="padding:8px 10px; background:#f1f5f9; color:#475569; border-radius:6px; font-size:11px; font-weight:700; margin-bottom:10px;">
                            🔒 @I18n.T("System head used by automatic billing posts: its type is fixed and it stays active. The name can be changed.",
                                       "অটো বিলিং পোস্টিংয়ের সিস্টেম খাত: ধরন স্থির, সবসময় সক্রিয় থাকবে। নাম বদলানো যাবে।")
                        </div>
                    }
                    <div style="margin-bottom:8px; display:flex; align-items:center; gap:8px;">
                        <InputCheckbox id="acc-cc-chk" @bind-Value="accountEditor.RequiresCostCenter" disabled="@(!isAdministrator)" />
                        <label for="acc-cc-chk" style="font-size:12px; font-weight:700; color:#334155; cursor:pointer;">
                            @I18n.T("Cost Center (department) required on every voucher line", "প্রতিটা ভাউচার লাইনে কস্ট সেন্টার (বিভাগ) আবশ্যক")
                        </label>
                    </div>
                    <div style="margin-bottom:14px; display:flex; align-items:center; gap:8px;">
                        <InputCheckbox id="acc-active-chk" @bind-Value="accountEditor.IsActive" disabled="@(accountEditor.IsSystem || !isAdministrator)" />
                        <label for="acc-active-chk" style="font-size:12px; font-weight:700; color:#334155; cursor:pointer;">
                            @I18n.T("Active for Voucher Posting", "ভাউচার পোস্টিংয়ের জন্য সক্রিয়")
                        </label>
                    </div>

                    @if (isAdministrator)
                    {
                        <button type="button" class="btn btn-primary" style="width:100%; height:34px; font-weight:800;" @onclick="SaveAccountAsync">
                            💾 @(accountEditor.ID == 0 ? I18n.T("Save Particulars Head", "হিসাব খাত সংরক্ষণ করুন") : I18n.T("Update Particulars Head", "হিসাব খাত আপডেট করুন"))
                        </button>
                    }
                    else
                    {
                        <div style="padding:10px; background:#fef3c7; color:#b45309; border-radius:6px; font-size:11.5px; font-weight:700;">
                            🔒 @I18n.T("Administrator permission is required to add or modify Chart of Accounts.", "চার্ট অফ অ্যাকাউন্টস যোগ বা পরিবর্তনের জন্য অ্যাডমিনিস্ট্রেটরের অনুমতি প্রয়োজন।")
                        </div>
                    }
                </div>
            </div>

            <!-- Right: Searchable Chart of Accounts Directory & Balances -->
            <div class="acc-card">
                <div class="acc-card-header">
                    <div>
                        <h2 class="acc-card-title">
                            <span>📋 @I18n.T("Chart of Accounts (Particulars Directory & Period Balances)", "চার্ট অফ অ্যাকাউন্টস ও ব্যালেন্স তালিকা")</span>
                        </h2>
                    </div>
                    <div style="display:flex; gap:6px;">
                        <button type="button" class="acc-print-btn primary" @onclick='() => PrintCoaFormatAsync("a4")'>🖨️ @I18n.T("Print A4 COA")</button>
                        <button type="button" class="acc-print-btn" @onclick='() => PrintCoaFormatAsync("a5")'>📄 @I18n.T("Print A5 COA")</button>
                    </div>
                </div>

                <!-- Search & Type Filter Bar -->
                <div style="padding:10px 14px; background:#f8fafc; border-bottom:1px solid #e2e8f0; display:flex; flex-direction:column; gap:8px;">
                    <div style="position:relative; width:100%;">
                        <input type="text"
                               class="classic-input"
                               style="height:30px !important; padding-left:28px !important;"
                               placeholder="@I18n.T("Search particulars head by code, name, or classification...", "কোড, নাম বা শ্রেণি দিয়ে হিসাব খাত খুঁজুন...")"
                               @bind="coaSearchText"
                               @bind:event="oninput" />
                        <span style="position:absolute; left:9px; top:50%; transform:translateY(-50%); font-size:12px; color:#64748b;">🔍</span>
                    </div>

                    <div style="display:flex; gap:6px; flex-wrap:wrap; align-items:center;">
                        <span style="font-size:10.5px; font-weight:750; color:#64748b;">@I18n.T("Filter Type"):</span>
                        @foreach (var t in new[] { "ALL", "Asset", "Liability", "Equity", "Income", "Expense" })
                        {
                            <button type="button"
                                    class="acc-pill-filter @(coaTypeFilter == t ? "active" : "")"
                                    @onclick='() => coaTypeFilter = t'>
                                @(t == "ALL" ? $"All ({accounts.Count})" : $"{t} ({accounts.Count(a => a.AccountType == t)})")
                            </button>
                        }
                    </div>
                </div>

                <div class="acc-table-wrap" style="max-height:520px; overflow-y:auto;">
                    <table class="acc-table">
                        <thead>
                            <tr>
                                <th style="width:90px;">@I18n.T("Code", "কোড")</th>
                                <th>@I18n.T("Particulars Head Name", "হিসাব খাতের নাম")</th>
                                <th>@I18n.T("Type", "শ্রেণি")</th>
                                <th class="num">@I18n.T("Period Debit", "ডেবিট")</th>
                                <th class="num">@I18n.T("Period Credit", "ক্রেডিট")</th>
                                <th>@I18n.T("Status", "অবস্থা")</th>
                                <th style="text-align:right;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var x in FilteredCoaAccounts)
                            {
                                var dr = AccountPeriodDebit(x.ID);
                                var cr = AccountPeriodCredit(x.ID);
                                <tr>
                                    <td><strong style="color:#0284c7;">@x.Code</strong></td>
                                    <td><strong>@x.Name</strong> @if (x.IsSystem) { <span title="@I18n.T("System head", "সিস্টেম খাত")" style="font-size:10px;">🔒</span> }</td>
                                    <td>
                                        <span class="pill" style="font-size:10px; background:#f1f5f9; color:#334155; font-weight:750;">
                                            @x.AccountType
                                        </span>
                                    </td>
                                    <td class="num">@(dr > 0 ? I18n.FormatCurrency(dr) : "—")</td>
                                    <td class="num">@(cr > 0 ? I18n.FormatCurrency(cr) : "—")</td>
                                    <td>
                                        <span class="pill" style="font-size:10px; background:@(x.IsActive ? "#d1fae5" : "#f1f5f9"); color:@(x.IsActive ? "#047857" : "#64748b");">
                                            @(x.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td style="text-align:right;">
                                        <button type="button" class="acc-chip-btn" @onclick="() => SelectAccount(x)">✎ Edit</button>
                                        <button type="button" class="acc-chip-btn" style="margin-left:4px;" @onclick="() => ViewAccountInLedger(x.ID)">📒 Ledger</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    else if (activeTab == "costcenters")
    {
        <CostCentersTab IsAdministrator="isAdministrator" FromDate="fromDate" ToDate="toDate" RefreshToken="refreshToken" OnChanged="ReloadFromTabAsync" />
    }

    else if (activeTab == "assets")
    {
        <FixedAssetsTab @key="reloadKey" IsAdministrator="isAdministrator" UserId="currentUserId" OnChanged="ReloadFromTabAsync" />
    }

    else if (activeTab == "closing")
    {
        <MonthEndTab @key="reloadKey" IsAdministrator="isAdministrator" UserId="currentUserId" OnChanged="ReloadFromTabAsync" />
    }

    else if (activeTab == "statements")
    {
        <StatementsTab FromDate="fromDate" ToDate="toDate" RefreshToken="refreshToken" OnOpenLedger="ViewAccountInLedger" />
    }
</div>

<!-- =========================================================================
     HIDDEN PRINT SHEETS (A4, A5, AND 80MM THERMAL)
     ========================================================================= -->

<!-- 1. VOUCHER PRINT SHEETS (A4, A5, 80MM) -->
@if (selectedVoucher is not null)
{
    <!-- 1A: A4 Official Voucher -->
    <div id="voucher-print-a4" class="print-sheet" style="display:none;">
        <PrintDocumentHeader Title="@($"{selectedVoucher.VoucherType?.ToUpperInvariant()} VOUCHER")"
                             Subtitle="Hospital Accounts & General Ledger Control"
                             DocNo="@selectedVoucher.VoucherNo"
                             DocNoLabel="Voucher #"
                             BarcodeCode="@($"VCH-{selectedVoucher.ID}")" />

        <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:8px; background:#f8fafc; border:1px solid #cbd5e1; border-radius:6px; padding:10px 12px; margin:12px 0; font-size:11.5px;">
            <div><span style="color:#64748b; font-weight:700;">Voucher No:</span> <strong>@selectedVoucher.VoucherNo</strong></div>
            <div><span style="color:#64748b; font-weight:700;">Voucher Date:</span> <strong>@selectedVoucher.VoucherDate.ToString("dd MMM yyyy")</strong></div>
            <div><span style="color:#64748b; font-weight:700;">Status:</span> <strong>@selectedVoucher.Status</strong></div>
            <div><span style="color:#64748b; font-weight:700;">Reference:</span> <strong>@(string.IsNullOrWhiteSpace(selectedVoucher.Reference) ? "—" : selectedVoucher.Reference)</strong></div>
            <div style="grid-column:span 2;"><span style="color:#64748b; font-weight:700;">Narration:</span> <strong>@selectedVoucher.Narration</strong></div>
        </div>

        <table style="width:100%; border-collapse:collapse; font-size:11.5px; margin-top:8px;" border="1" cellpadding="7">
            <thead>
                <tr style="background:#f1f5f9;">
                    <th style="text-align:left;">Account Head (Code & Name)</th>
                    <th style="text-align:right; width:140px;">Debit (৳)</th>
                    <th style="text-align:right; width:140px;">Credit (৳)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in selectedVoucherLines)
                {
                    <tr>
                        <td><b>@AccountCodeAndName(x.AccountID)</b></td>
                        <td style="text-align:right;">@I18n.FormatCurrency(x.Debit)</td>
                        <td style="text-align:right;">@I18n.FormatCurrency(x.Credit)</td>
                    </tr>
                }
                <tr style="background:#f8fafc; font-weight:900;">
                    <td style="text-align:right;">TOTAL:</td>
                    <td style="text-align:right;">@I18n.FormatCurrency(selectedVoucherLines.Sum(x => x.Debit))</td>
                    <td style="text-align:right;">@I18n.FormatCurrency(selectedVoucherLines.Sum(x => x.Credit))</td>
                </tr>
            </tbody>
        </table>

        <div style="display:flex; justify-content:space-between; margin-top:48px; font-size:11px;">
            <div style="border-top:1px solid #0f172a; width:150px; text-align:center; padding-top:4px;">Prepared By: <strong>@printPreparedBy</strong></div>
            <div style="border-top:1px solid #0f172a; width:150px; text-align:center; padding-top:4px;">Checked / Accounts</div>
            <div style="border-top:1px solid #0f172a; width:150px; text-align:center; padding-top:4px;">Approved By: <strong>@printApprovedBy</strong></div>
            <div style="border-top:1px solid #0f172a; width:150px; text-align:center; padding-top:4px;">Receiver Signature</div>
        </div>
    </div>

    <!-- 1B: A5 Half-Sheet Voucher -->
    <div id="voucher-print-a5" class="print-a5-sheet" style="display:none;">
        <div style="text-align:center; border-bottom:1.5px solid #0f172a; padding-bottom:6px; margin-bottom:8px;">
            <div style="font-size:15px; font-weight:900;">@Branding.HospitalName</div>
            <div style="font-size:10px; color:#475569;">@Branding.Address &bull; @Branding.Phone</div>
            <div style="font-size:12px; font-weight:800; margin-top:3px; text-transform:uppercase;">@selectedVoucher.VoucherType VOUCHER (@selectedVoucher.VoucherNo)</div>
        </div>
        <div style="display:flex; justify-content:space-between; font-size:10px; margin-bottom:6px;">
            <span><b>Date:</b> @selectedVoucher.VoucherDate.ToString("dd MMM yyyy")</span>
            <span><b>Status:</b> @selectedVoucher.Status</span>
            <span><b>Ref:</b> @(string.IsNullOrWhiteSpace(selectedVoucher.Reference) ? "—" : selectedVoucher.Reference)</span>
        </div>
        <div style="font-size:10px; margin-bottom:8px; padding:4px 6px; background:#f8fafc; border:1px solid #cbd5e1;">
            <b>Narration:</b> @selectedVoucher.Narration
        </div>
        <table style="width:100%; border-collapse:collapse; font-size:10px;" border="1" cellpadding="4">
            <thead>
                <tr style="background:#f1f5f9;">
                    <th style="text-align:left;">Account Head</th>
                    <th style="text-align:right;">Debit (৳)</th>
                    <th style="text-align:right;">Credit (৳)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in selectedVoucherLines)
                {
                    <tr>
                        <td>@AccountCodeAndName(x.AccountID)</td>
                        <td style="text-align:right;">@I18n.FormatCurrency(x.Debit)</td>
                        <td style="text-align:right;">@I18n.FormatCurrency(x.Credit)</td>
                    </tr>
                }
                <tr style="font-weight:800; background:#f8fafc;">
                    <td style="text-align:right;">Total:</td>
                    <td style="text-align:right;">@I18n.FormatCurrency(selectedVoucherLines.Sum(x => x.Debit))</td>
                    <td style="text-align:right;">@I18n.FormatCurrency(selectedVoucherLines.Sum(x => x.Credit))</td>
                </tr>
            </tbody>
        </table>
        <div style="display:flex; justify-content:space-between; margin-top:28px; font-size:9.5px;">
            <span style="border-top:1px solid #000; width:100px; text-align:center; padding-top:2px;">Prepared By: <strong>@printPreparedBy</strong></span>
            <span style="border-top:1px solid #000; width:100px; text-align:center; padding-top:2px;">Approved By: <strong>@printApprovedBy</strong></span>
            <span style="border-top:1px solid #000; width:100px; text-align:center; padding-top:2px;">Receiver</span>
        </div>
    </div>

    <!-- 1C: 80mm Thermal POS Slip Voucher -->
    <div id="voucher-print-80mm" class="pos-receipt-80mm" style="display:none;">
        <div style="text-align:center; border-bottom:1px dashed #000; padding-bottom:6px; margin-bottom:6px;">
            <div style="font-size:13px; font-weight:900;">@Branding.HospitalName</div>
            <div style="font-size:9.5px;">@Branding.Address</div>
            <div style="font-size:11px; font-weight:800; margin-top:3px;">@selectedVoucher.VoucherType?.ToUpperInvariant() VOUCHER</div>
        </div>
        <div style="font-size:10px; line-height:1.4; margin-bottom:6px;">
            <div><b>No:</b> @selectedVoucher.VoucherNo</div>
            <div><b>Date:</b> @selectedVoucher.VoucherDate.ToString("dd-MMM-yyyy") | <b>Status:</b> @selectedVoucher.Status</div>
            @if (!string.IsNullOrWhiteSpace(selectedVoucher.Reference)) { <div><b>Ref:</b> @selectedVoucher.Reference</div> }
            <div><b>Note:</b> @selectedVoucher.Narration</div>
        </div>
        <table style="width:100%; border-collapse:collapse; font-size:9.5px; border-top:1px dashed #000; border-bottom:1px dashed #000;">
            <thead>
                <tr style="border-bottom:1px dashed #000;">
                    <th style="text-align:left; padding:3px 0;">Account</th>
                    <th style="text-align:right; padding:3px 0;">Dr</th>
                    <th style="text-align:right; padding:3px 0;">Cr</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in selectedVoucherLines)
                {
                    <tr>
                        <td style="padding:2px 0;">@AccountName(x.AccountID)</td>
                        <td style="text-align:right;">@(x.Debit > 0 ? x.Debit.ToString("N0") : "-")</td>
                        <td style="text-align:right;">@(x.Credit > 0 ? x.Credit.ToString("N0") : "-")</td>
                    </tr>
                }
            </tbody>
        </table>
        <div style="display:flex; justify-content:space-between; font-weight:900; font-size:11px; margin-top:4px;">
            <span>TOTAL AMOUNT:</span>
            <span>@I18n.FormatCurrency(selectedVoucherLines.Sum(x => x.Debit))</span>
        </div>
        <div style="margin-top:20px; display:flex; justify-content:space-between; font-size:9px; text-align:center;">
            <span style="border-top:1px dashed #000; width:45%; padding-top:2px;">Prepared By: <strong>@printPreparedBy</strong></span>
            <span style="border-top:1px dashed #000; width:45%; padding-top:2px;">Approved</span>
        </div>
    </div>
}

<!-- 2. GENERAL LEDGER & RECONCILIATION PRINT SHEETS (A4, A5, 80MM) -->
<div id="accounts-ledger-print-a4" class="print-sheet" style="display:none;">
    <PrintDocumentHeader Title="GENERAL LEDGER & CASH RECONCILIATION STATEMENT"
                         Subtitle="@($"Reporting Period: {fromDate:dd MMM yyyy} - {toDate:dd MMM yyyy}")"
                         DocNo="@($"GL-{fromDate:yyyyMMdd}-{toDate:yyyyMMdd}")"
                         DocNoLabel="Period #" />

    <div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:8px; margin:10px 0; font-size:11px;">
        <div style="border:1px solid #cbd5e1; padding:6px 8px; border-radius:4px;"><b>Central Cash:</b> @I18n.FormatCurrency(cashCollection)</div>
        <div style="border:1px solid #cbd5e1; padding:6px 8px; border-radius:4px;"><b>GL Cash:</b> @I18n.FormatCurrency(glCash)</div>
        <div style="border:1px solid #cbd5e1; padding:6px 8px; border-radius:4px;"><b>Posted Income:</b> @I18n.FormatCurrency(income)</div>
        <div style="border:1px solid #cbd5e1; padding:6px 8px; border-radius:4px;"><b>Posted Expense:</b> @I18n.FormatCurrency(expense)</div>
    </div>

    <table style="width:100%; border-collapse:collapse; font-size:10.5px;" border="1" cellpadding="5">
        <thead>
            <tr style="background:#f1f5f9;">
                <th>Date</th>
                <th>Voucher No</th>
                <th>Account Head</th>
                <th>Narration</th>
                <th style="text-align:right;">Debit (৳)</th>
                <th style="text-align:right;">Credit (৳)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var x in FilteredLedgerRows)
            {
                <tr>
                    <td>@x.Date.ToString("dd MMM yy")</td>
                    <td>@x.VoucherNo</td>
                    <td>@AccountCodeAndName(x.AccountID)</td>
                    <td>@x.Narration</td>
                    <td style="text-align:right;">@I18n.FormatCurrency(x.Debit)</td>
                    <td style="text-align:right;">@I18n.FormatCurrency(x.Credit)</td>
                </tr>
            }
            <tr style="background:#f1f5f9; font-weight:900;">
                <td colspan="4" style="text-align:right;">TOTAL:</td>
                <td style="text-align:right;">@I18n.FormatCurrency(FilteredLedgerRows.Sum(x => x.Debit))</td>
                <td style="text-align:right;">@I18n.FormatCurrency(FilteredLedgerRows.Sum(x => x.Credit))</td>
            </tr>
        </tbody>
    </table>

    <div style="display:flex; justify-content:space-between; margin-top:40px; font-size:11px;">
        <div style="border-top:1px solid #000; width:150px; text-align:center; padding-top:4px;">Prepared By: <strong>@currentUserName</strong></div>
        <div style="border-top:1px solid #000; width:150px; text-align:center; padding-top:4px;">Accounts Officer</div>
        <div style="border-top:1px solid #000; width:150px; text-align:center; padding-top:4px;">Managing Director</div>
    </div>
</div>

<div id="accounts-ledger-print-a5" class="print-a5-sheet" style="display:none;">
    <div style="text-align:center; border-bottom:1.5px solid #000; padding-bottom:4px; margin-bottom:6px;">
        <div style="font-size:14px; font-weight:900;">@Branding.HospitalName</div>
        <div style="font-size:11px; font-weight:800;">GENERAL LEDGER STATEMENT (@fromDate.ToString("dd MMM yy") - @toDate.ToString("dd MMM yy"))</div>
    </div>
    <table style="width:100%; border-collapse:collapse; font-size:9.5px;" border="1" cellpadding="3">
        <thead>
            <tr style="background:#f1f5f9;">
                <th>Date / Voucher</th>
                <th>Account Head</th>
                <th>Narration</th>
                <th style="text-align:right;">Debit</th>
                <th style="text-align:right;">Credit</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var x in FilteredLedgerRows)
            {
                <tr>
                    <td>@x.Date.ToString("dd/MM/yy") (@x.VoucherNo)</td>
                    <td>@AccountName(x.AccountID)</td>
                    <td>@x.Narration</td>
                    <td style="text-align:right;">@x.Debit.ToString("N0")</td>
                    <td style="text-align:right;">@x.Credit.ToString("N0")</td>
                </tr>
            }
            <tr style="font-weight:800; background:#f8fafc;">
                <td colspan="3" style="text-align:right;">Total:</td>
                <td style="text-align:right;">@FilteredLedgerRows.Sum(x => x.Debit).ToString("N0")</td>
                <td style="text-align:right;">@FilteredLedgerRows.Sum(x => x.Credit).ToString("N0")</td>
            </tr>
        </tbody>
    </table>
</div>

<div id="accounts-ledger-print-80mm" class="pos-receipt-80mm" style="display:none;">
    <div style="text-align:center; border-bottom:1px dashed #000; padding-bottom:6px; margin-bottom:6px;">
        <div style="font-size:13px; font-weight:900;">@Branding.HospitalName</div>
        <div style="font-size:10px; font-weight:800;">ACCOUNTS & CASH CLOSING SUMMARY</div>
        <div style="font-size:9.5px;">@fromDate.ToString("dd MMM yyyy") - @toDate.ToString("dd MMM yyyy")</div>
    </div>
    <div style="font-size:10.5px; line-height:1.5; border-bottom:1px dashed #000; padding-bottom:6px; margin-bottom:6px;">
        <div style="display:flex; justify-content:space-between;"><span>Central Cash:</span><b>@I18n.FormatCurrency(cashCollection)</b></div>
        <div style="display:flex; justify-content:space-between;"><span>GL Cash Movement:</span><b>@I18n.FormatCurrency(glCash)</b></div>
        <div style="display:flex; justify-content:space-between;"><span>Cash Variance:</span><b>@I18n.FormatCurrency(cashDifference)</b></div>
        <div style="display:flex; justify-content:space-between;"><span>Posted Income:</span><b>@I18n.FormatCurrency(income)</b></div>
        <div style="display:flex; justify-content:space-between;"><span>Posted Expense:</span><b>@I18n.FormatCurrency(expense)</b></div>
        <div style="display:flex; justify-content:space-between;"><span>Handover (@handoverDate.ToString("dd MMM")):</span><b>@I18n.FormatCurrency(handedAmount)</b></div>
    </div>
    <div style="text-align:center; font-size:9px; margin-top:16px;">
        Printed: @DateTime.Now.ToString("dd-MMM-yyyy hh:mm tt")
    </div>
</div>

<!-- 3. CHART OF ACCOUNTS PRINT SHEETS (A4 & A5) -->
<div id="accounts-coa-print-a4" class="print-sheet" style="display:none;">
    <PrintDocumentHeader Title="CHART OF ACCOUNTS (PARTICULARS HEAD DIRECTORY)"
                         Subtitle="@($"Period Activity: {fromDate:dd MMM yyyy} - {toDate:dd MMM yyyy}")"
                         DocNo="@($"COA-{DateTime.Today:yyyyMMdd}")" />
    <table style="width:100%; border-collapse:collapse; font-size:11px; margin-top:10px;" border="1" cellpadding="6">
        <thead>
            <tr style="background:#f1f5f9;">
                <th>Code</th>
                <th>Particulars / Account Head Name</th>
                <th>Classification</th>
                <th style="text-align:right;">Period Debit (৳)</th>
                <th style="text-align:right;">Period Credit (৳)</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var x in FilteredCoaAccounts)
            {
                <tr>
                    <td><b>@x.Code</b></td>
                    <td><b>@x.Name</b></td>
                    <td>@x.AccountType</td>
                    <td style="text-align:right;">@I18n.FormatCurrency(AccountPeriodDebit(x.ID))</td>
                    <td style="text-align:right;">@I18n.FormatCurrency(AccountPeriodCredit(x.ID))</td>
                    <td>@(x.IsActive ? "Active" : "Inactive")</td>
                </tr>
            }
        </tbody>
    </table>
