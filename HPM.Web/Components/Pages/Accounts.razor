    private async Task CalculateHandoverAsync()
    {
        var uid = await CurrentUserIdAsync(); await using var db = await DbFactory.CreateDbContextAsync(); var end = handoverDate.Date.AddDays(1);
        handoverSystem = await db.CentralCashCollections.Where(x => x.EnteredBy == uid && x.TransDateCL >= handoverDate.Date && x.TransDateCL < end).SumAsync(x => (decimal?)x.Amount) ?? 0;
        currentHandover = await db.CashierHandovers.AsNoTracking().FirstOrDefaultAsync(x => x.BusinessDate == handoverDate.Date && x.CashierID == uid);
        handedAmount = currentHandover?.HandedOverAmount ?? handoverSystem; handoverNotes = currentHandover?.Notes ?? "";
    }

    private async Task CloseDayAsync()
    {
        if (handoverDate.Date > DateTime.Today) { Fail(I18n.T("The business date cannot be in the future.", "ব্যবসায়িক তারিখ ভবিষ্যতের হতে পারে না।")); return; }
        if (handedAmount > MaxAmount) { Fail(I18n.T("The handover amount cannot exceed 9,999,999,999,999.99.", "হস্তান্তরিত পরিমাণ ৯,৯৯৯,৯৯৯,৯৯৯,৯৯৯.৯৯ এর বেশি হতে পারে না।")); return; }
        if ((handoverNotes ?? "").Trim().Length > 500) { Fail(I18n.T("Keep the notes within 500 characters.", "নোট ৫০০ অক্ষরের মধ্যে লিখুন।")); return; }
        if (handedAmount < 0) { Fail(I18n.IsBangla ? "হস্তান্তরিত পরিমাণ ঋণাত্মক হতে পারে না।" : "Handover amount cannot be negative."); return; }
        await GuardAsync(async () =>
        {
            var uid = await CurrentUserIdAsync(); await using var db = await DbFactory.CreateDbContextAsync();
            await FinancialControl.EnsurePostingAllowedAsync(db, handoverDate, uid);
            var day = handoverDate.Date; var dayEnd = day.AddDays(1);
            handoverSystem = await db.CentralCashCollections.Where(c => c.EnteredBy == uid && c.TransDateCL >= day && c.TransDateCL < dayEnd).SumAsync(c => (decimal?)c.Amount) ?? 0;
            var x = await db.CashierHandovers.FirstOrDefaultAsync(x => x.BusinessDate == day && x.CashierID == uid) ?? new CashierHandover { BusinessDate = day, CashierID = uid };
            if (x.IsLocked) { Fail(I18n.IsBangla ? "এই দিনটি আগেই বন্ধ ও লক করা হয়েছে।" : "This day is already closed and locked."); return; }
            if (x.ID == 0) db.CashierHandovers.Add(x);
            x.SystemAmount = handoverSystem; x.HandedOverAmount = handedAmount; x.Variance = handedAmount - handoverSystem; x.Notes = handoverNotes.Trim(); x.TransDate = DateTime.Now; x.IsLocked = true; x.ClosedAt = DateTime.Now;
            await db.SaveChangesAsync(); Success(I18n.IsBangla ? $"ক্যাশিয়ার শিফট সমাপ্ত ও লক করা হয়েছে। পার্থক্য: {I18n.FormatCurrency(x.Variance)}।" : $"Cashier day closed and locked. Variance: {I18n.FormatCurrency(x.Variance)}."); await CalculateHandoverAsync();
        });
    }

    private async Task ReopenCurrentDayAsync()
    {
        if (currentHandover is not null) await ReopenHandoverAsync(currentHandover);
    }

    private async Task ReopenHandoverAsync(CashierHandover row)
    {
        if (!isAdministrator) return;
        var reason = await JS.InvokeAsync<string?>("hpm.prompt", I18n.IsBangla ? $"ক্যাশিয়ার #{row.CashierID} ({row.BusinessDate:dd MMM yyyy}) পুনরায় খোলার কারণ:" : $"Reason for reopening cashier #{row.CashierID} on {row.BusinessDate:dd MMM yyyy}:"); if (string.IsNullOrWhiteSpace(reason)) return;
        if (reason.Trim().Length > 500) { Fail(I18n.T("Keep the reason within 500 characters.", "কারণ ৫০০ অক্ষরের মধ্যে লিখুন।")); return; }
        await GuardAsync(async () =>
        {
            var uid = await CurrentUserIdAsync(); await using var db = await DbFactory.CreateDbContextAsync();
            var x = await db.CashierHandovers.FindAsync(row.ID); if (x is null || !x.IsLocked) return;
            x.IsLocked = false; x.ReopenedBy = uid; x.ReopenedAt = DateTime.Now; x.ReopenReason = reason.Trim(); await db.SaveChangesAsync();
            Success(I18n.IsBangla ? "ক্যাশিয়ার শিফট অডিট কারণসহ পুনরায় খোলা হয়েছে।" : "Cashier day reopened with audit reason."); await LoadAsync(); await CalculateHandoverAsync();
        });
    }

    private async Task LockPeriodAsync()
    {
        if (!isAdministrator || lockFrom.Date > lockTo.Date || string.IsNullOrWhiteSpace(lockReason)) { Fail(I18n.IsBangla ? "সঠিক সময়কাল এবং লক করার কারণ লিখুন।" : "Enter a valid period and lock reason."); return; }
        if (lockFrom.Date < new DateTime(2000, 1, 1) || lockTo.Date > new DateTime(2100, 12, 31)) { Fail(I18n.T("The lock period must be between 01 Jan 2000 and 31 Dec 2100.", "লকের সময়কাল ০১ জানুয়ারি ২০০০ থেকে ৩১ ডিসেম্বর ২১০০ এর মধ্যে হতে হবে।")); return; }
        if (lockReason.Trim().Length > 500) { Fail(I18n.IsBangla ? "কারণ ৫০০ অক্ষরের মধ্যে লিখুন।" : "Keep the reason within 500 characters."); return; }
        await GuardAsync(async () =>
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (await db.FinancialPeriodLocks.AnyAsync(x => x.IsActive && x.FromDate <= lockTo.Date && x.ToDate >= lockFrom.Date)) { Fail(I18n.IsBangla ? "এই সময়কালটি অন্য একটি সক্রিয় আর্থিক লকের সাথে মিলে যায়।" : "This range overlaps an active financial lock."); return; }
            db.FinancialPeriodLocks.Add(new FinancialPeriodLock { FromDate = lockFrom.Date, ToDate = lockTo.Date, Reason = lockReason.Trim(), IsActive = true, LockedBy = await CurrentUserIdAsync(), LockedAt = DateTime.Now });
            await db.SaveChangesAsync(); lockReason = ""; Success(I18n.IsBangla ? "আর্থিক সময়কাল লক করা হয়েছে।" : "Financial period locked."); await LoadAsync();
        });
    }

    private async Task UnlockPeriodAsync(FinancialPeriodLock row)
    {
        if (!isAdministrator) return;
        await GuardAsync(async () =>
        {
            var reason = await JS.InvokeAsync<string?>("hpm.prompt", I18n.IsBangla ? "আর্থিক সময়কাল আনলক করার কারণ:" : "Reason for unlocking this financial period:"); if (string.IsNullOrWhiteSpace(reason)) return;
            if (reason.Trim().Length > 500) { Fail(I18n.T("Keep the reason within 500 characters.", "কারণ ৫০০ অক্ষরের মধ্যে লিখুন।")); return; }
            await using var db = await DbFactory.CreateDbContextAsync(); var x = await db.FinancialPeriodLocks.FindAsync(row.ID); if (x is null || !x.IsActive) return;
            x.IsActive = false; x.UnlockedBy = await CurrentUserIdAsync(); x.UnlockedAt = DateTime.Now; x.UnlockReason = reason.Trim(); await db.SaveChangesAsync();
            Success(I18n.IsBangla ? "আর্থিক সময়কাল অডিট রেকর্ডসহ আনলক করা হয়েছে।" : "Financial period unlocked with audit trail."); await LoadAsync();
        });
    }

    private async Task BackfillOperationalJournalsAsync()
    {
        if (!isAdministrator || saving) return;
        if (!await JS.InvokeAsync<bool>("hpm.confirm", I18n.T(
                "Post journals for operational bills and receipts in the selected period that have no voucher yet? Days inside a locked period are skipped.",
                "নির্বাচিত সময়ের যেসব বিল ও রসিদের ভাউচার নেই সেগুলোর জার্নাল পোস্ট করবেন? লক করা সময়কালের দিনগুলো বাদ থাকবে।")))
            return;
        var failedPrefix = I18n.T("Backfill failed: ", "ব্যাকফিল ব্যর্থ হয়েছে: ");
        saving = true;
        try
        {
            var uid = await CurrentUserIdAsync();
            await ResilientTransaction.ExecuteAsync(DbFactory, async db =>
            {
                var end = toDate.Date.AddDays(1);
                // Only bills without any voucher are posted; bills already in the ledger are left as
                // they are, so history is never re-dated or duplicated.
                async Task<bool> PostedAsync(string reference) =>
                    await db.AccountVouchers.AnyAsync(v => v.Reference == reference && v.IsPosted && v.Status != "Cancelled");

                var opd = await db.OPDTickets.Where(x => x.TransDate >= fromDate.Date && x.TransDate < end).ToListAsync();
                foreach (var x in opd)
                    if (!await PostedAsync($"OPD-TICKET:{x.ID}"))
                        await OperationalAccounting.SyncRevenueAsync(db, $"OPD-TICKET:{x.ID}", x.ID, x.Total, x.TransDate, uid, $"OPD consultation ticket #{x.ID}",
                            AccountingPosting.Cash, AccountingPosting.ModuleFlags.OpdTicket, AccountMap.ConsultationIncome, AccountMap.CcOpd);
                var memos = await db.EmergencyMemos.Include(x => x.Items).Where(x => x.TransDate >= fromDate.Date && x.TransDate < end && (x.ModuleID == 11 || x.ModuleID == 2)).ToListAsync();
                foreach (var x in memos)
                {
                    var diagnostic = x.ModuleID == 2; var prefix = diagnostic ? "DIAGNOSTIC" : "EMERGENCY";
                    if (await PostedAsync($"{prefix}:{x.ID}")) continue;
                    var flag = diagnostic ? AccountingPosting.ModuleFlags.Diagnostic : AccountingPosting.ModuleFlags.Emergency;
                    var gross = Math.Max(x.Total, 0);
                    var discount = Math.Min(Math.Max(x.Discount, 0), gross);
                    var paidAmount = Math.Min(x.Paid, gross - discount);
                    var parts = diagnostic
                        ? await OperationalAccounting.DiagnosticPartsAsync(db, x.Items.Select(i => (i.TestID, i.Rate, (decimal)i.Quantity)), gross)
                        : await OperationalAccounting.SinglePartAsync(db, AccountMap.ProcedureOtIncome, AccountMap.CcEmergency, gross);
                    await OperationalAccounting.SyncBillAsync(db, $"{prefix}:{x.ID}", x.ID, parts, discount, paidAmount, x.TransDate, uid, $"{prefix} memo #{x.ID}", x.PatientType == "1" ? flag : null);
                }
                var ot = await db.OTCashMemos.Where(x => x.TransDate >= fromDate.Date && x.TransDate < end).ToListAsync();
                foreach (var x in ot)
                {
                    if (await PostedAsync($"OT-MEMO:{x.ID}")) continue;
                    var cashPatient = x.PatientType == "1";
                    var net = Math.Max(0, x.Total - x.Discount);
                    await OperationalAccounting.SyncBillAsync(db, $"OT-MEMO:{x.ID}", x.ID,
                        await OperationalAccounting.SinglePartAsync(db, AccountMap.ProcedureOtIncome, AccountMap.CcOt, x.Total),
                        x.Discount, cashPatient ? net : 0, x.TransDate, uid, $"OT cash memo #{x.ID}", cashPatient ? AccountingPosting.ModuleFlags.Ot : null);
                }
                var reversedIds = await db.FinancialReversals.Where(x => x.EntityType == "IPD Money Receipt").Select(x => x.EntityID).ToListAsync();
                // Legacy data has zero-amount receipts (e.g. a fully adjusted final bill): nothing to post.
                var receipts = await db.IpdMoneyReceipts.Where(x => x.TransDate >= fromDate.Date && x.TransDate < end && x.Amount > 0 && !reversedIds.Contains(x.ID)).ToListAsync();
                // A receipt dated inside a locked financial period is skipped: closed books are never changed.
                var activeLocks = await db.FinancialPeriodLocks.AsNoTracking().Where(l => l.IsActive && l.FromDate < end && l.ToDate >= fromDate.Date)
                    .Select(l => new { l.FromDate, l.ToDate }).ToListAsync();
                foreach (var x in receipts)
                {
                    var receiptDay = x.TransDate.Date;
                    if (activeLocks.Any(l => l.FromDate.Date <= receiptDay && l.ToDate.Date >= receiptDay)) continue;
                    var reference = $"IPD-RECEIPT:{x.ID}";
                    if (!await db.AccountVouchers.AnyAsync(v => v.Reference == reference && v.Status != "Cancelled"))
                    {
                        var credit = x.Against == "Advance" ? AccountingPosting.PatientAdvance : AccountingPosting.PatientReceivable;
                        AccountingPosting.AddPostedVoucher(db, "Receipt", x.TransDate, $"IPD {x.Against} receipt {x.RegNo}", reference, uid,
                            (AccountingPosting.Cash, x.Amount, 0), (credit, 0, x.Amount));
                    }
                }
                await db.SaveChangesAsync();
                return true;
            });
            Success(I18n.IsBangla ? "অপারেশনাল জার্নাল ব্যাকফিল সম্পন্ন হয়েছে।" : "Operational journal backfill completed. Review the reconciliation variance."); await LoadAsync();
        }
        catch (Exception ex) { Fail(failedPrefix + ex.GetBaseException().Message); }
        finally { saving = false; }
    }

    private async Task SaveAccountAsync()
    {
        if (!isAdministrator) return; accountEditor.Code = (accountEditor.Code ?? "").Trim(); accountEditor.Name = (accountEditor.Name ?? "").Trim();
        if (string.IsNullOrWhiteSpace(accountEditor.Code) || string.IsNullOrWhiteSpace(accountEditor.Name)) { Fail(I18n.IsBangla ? "হিসাব কোড ও নাম আবশ্যক।" : "Account code and name are required."); return; }
        if (accountEditor.Code.Length > 20 || accountEditor.Name.Length > 100) { Fail(I18n.IsBangla ? "কোড ২০ ও নাম ১০০ অক্ষরের মধ্যে লিখুন।" : "Keep the code within 20 and the name within 100 characters."); return; }
        await GuardAsync(SaveAccountCoreAsync);
    }

    private async Task SaveAccountCoreAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.AccountHeads.AnyAsync(x => x.Code == accountEditor.Code && x.ID != accountEditor.ID)) { Fail(I18n.IsBangla ? "হিসাব কোড ইতিমধ্যে বিদ্যমান।" : "Account code already exists."); return; }
        if (accountEditor.ID == 0)
        {
            accountEditor.IsSystem = false;
            db.AccountHeads.Add(accountEditor);
        }
        else
        {
            var x = await db.AccountHeads.FindAsync(accountEditor.ID); if (x is null) return;
            if (x.IsSystem && (x.Code != accountEditor.Code || x.AccountType != accountEditor.AccountType || !accountEditor.IsActive))
            {
                Fail(I18n.IsBangla ? "সিস্টেম খাতের কোড, ধরন বা সক্রিয় অবস্থা বদলানো যায় না। শুধু নাম বদলানো যাবে।" : "A system head's code, type and active status cannot change. Only its name can.");
                return;
            }
            if (x.AccountType != accountEditor.AccountType && await db.AccountVoucherLines.AnyAsync(l => l.AccountID == x.ID))
            {
                Fail(I18n.IsBangla ? "এই খাতে আগেই লেনদেন আছে, তাই ধরন বদলানো যাবে না (পুরনো হিসাব বদলে যেত)। নতুন খাত খুলুন।" : "This head already has postings, so its type cannot change (it would rewrite past reports). Create a new head instead.");
                return;
            }
            x.Code = accountEditor.Code; x.Name = accountEditor.Name; x.AccountType = accountEditor.AccountType; x.IsActive = accountEditor.IsActive; x.RequiresCostCenter = accountEditor.RequiresCostCenter;
        }
        await db.SaveChangesAsync(); AccountMap.Invalidate(); Success(I18n.IsBangla ? "হিসাব খাত সংরক্ষিত হয়েছে।" : "Account head saved."); ResetAccount(); await LoadAsync();
    }

    private void SelectAccount(AccountHead x) => accountEditor = new() { ID = x.ID, Code = x.Code, Name = x.Name, AccountType = x.AccountType, ParentID = x.ParentID, IsActive = x.IsActive, IsSystem = x.IsSystem, RequiresCostCenter = x.RequiresCostCenter };
    private void ResetAccount() => accountEditor = new() { AccountType = "Asset", IsActive = true };

    /// <summary>Vouchers that move counter cash recorded in Central Cash Collection (bills, receipts, refunds) and their reversals.</summary>
    private static async Task<HashSet<long>> CollectionVoucherIdsAsync(HpmDbContext db, List<AccountVoucher> list)
    {
        static bool IsCollection(string? reference) => reference is not null && (
            reference.StartsWith("OPD-TICKET:") || reference.StartsWith("EMERGENCY:") || reference.StartsWith("DIAGNOSTIC:") ||
            reference.StartsWith("DIAGNOSTIC-RETURN:") || reference.StartsWith("OT-MEMO:") || reference.StartsWith("PHARMACY-SALE:") ||
            reference.StartsWith("PHARMACY-SALES-RETURN:") || reference.StartsWith("IPD-RECEIPT:"));
        var ids = list.Where(x => IsCollection(x.Reference)).Select(x => x.ID).ToHashSet();
        var originals = list.Where(x => x.ReversalOfVoucherID.HasValue).Select(x => x.ReversalOfVoucherID!.Value).Distinct().ToList();
        if (originals.Count > 0)
        {
            var collectionOriginals = (await db.AccountVouchers.AsNoTracking().Where(x => originals.Contains(x.ID))
                .Select(x => new { x.ID, x.Reference }).ToListAsync()).Where(x => IsCollection(x.Reference)).Select(x => x.ID).ToHashSet();
            foreach (var v in list.Where(x => x.ReversalOfVoucherID.HasValue && collectionOriginals.Contains(x.ReversalOfVoucherID!.Value)))
                ids.Add(v.ID);
        }
        return ids;
    }
    private void ResetVoucher() { voucherLines = []; voucherType = "Journal"; voucherDate = DateTime.Today; reference = ""; narration = ""; lineAccountId = 0; lineCostCenterId = 0; accountHeadSearchText = ""; lineDebit = 0; lineCredit = 0; }
    private decimal VoucherAmount(long id) => voucherAmounts.GetValueOrDefault(id);
    private decimal AccountPeriodDebit(int accountId) => accountTotals.TryGetValue(accountId, out var t) ? t.Debit : 0;
    private decimal AccountPeriodCredit(int accountId) => accountTotals.TryGetValue(accountId, out var t) ? t.Credit : 0;
    private string AccountName(int id) => accounts.FirstOrDefault(x => x.ID == id)?.Name ?? "—";
    private string AccountCodeAndName(int id) { var a = accounts.FirstOrDefault(x => x.ID == id); return a != null ? $"{a.Code} · {a.Name}" : "—"; }
    private async Task<int> CurrentUserIdAsync() { var u = (await AuthStateProvider.GetAuthenticationStateAsync()).User; return int.TryParse(u.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : 1; }
    private void Success(string text) { messageClass = "success"; message = text; }
    private void Fail(string text) { messageClass = "danger"; message = text; }
    private sealed record LedgerRow(DateTime Date, string VoucherNo, int AccountID, string? Narration, decimal Debit, decimal Credit, int? CostCenterID = null);
    private sealed record ReconciliationRow(DateTime Date, decimal CentralCash, decimal GlCash) { public decimal Variance => CentralCash - GlCash; }
}
