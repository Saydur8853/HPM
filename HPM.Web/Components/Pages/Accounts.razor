    private IEnumerable<AccountHead> FilteredPickerAccounts
    {
        get
        {
            var active = accounts.Where(x => x.IsActive);
            if (string.IsNullOrWhiteSpace(accountHeadSearchText)) return active;
            var q = accountHeadSearchText.Trim();
            return active.Where(x =>
                x.Code.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                x.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                x.AccountType.Contains(q, StringComparison.OrdinalIgnoreCase));
        }
