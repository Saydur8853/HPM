    private async Task LoadAsync()
    {
        try
        {
            await LoadCoreAsync();
        }
        catch (Exception)
        {
            Fail(I18n.T("The database did not answer in time (it may be busy). Press 🔄 or reopen the tab to try again.", "ডাটাবেস সময়মতো উত্তর দেয়নি (ব্যস্ত থাকতে পারে)। 🔄 চাপুন বা ট্যাবটা আবার খুলুন।"));
        }
    }

    private async Task LoadCoreAsync()
    {
        if (fromDate > toDate)
        {
            (fromDate, toDate) = (toDate, fromDate);
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        accounts = await db.AccountHeads.AsNoTracking().OrderBy(x => x.Code).ToListAsync();
        costCenters = await db.CostCenters.AsNoTracking().OrderBy(x => x.Code).ToListAsync();
        var end = toDate.Date.AddDays(1);
        vouchers = await db.AccountVouchers.AsNoTracking().Where(x => x.VoucherDate >= fromDate.Date && x.VoucherDate < end).ToListAsync();
        var ids = vouchers.Select(x => x.ID).ToArray();
        allLines = ids.Length == 0 ? [] : await db.AccountVoucherLines.AsNoTracking().Where(x => ids.Contains(x.VoucherID)).ToListAsync();
        var collections = await db.CentralCashCollections.AsNoTracking().Where(x => x.TransDateCL >= fromDate.Date && x.TransDateCL < end).ToListAsync();
        cashCollection = collections.Sum(x => x.Amount);
        var postedIds = vouchers.Where(x => x.IsPosted && x.Status != "Pending" && x.Status != "Rejected").Select(x => x.ID).ToHashSet();
        var postedLines = allLines.Where(x => postedIds.Contains(x.VoucherID)).ToList();
        glCash = postedLines.Where(x => x.AccountID == AccountingPosting.Cash).Sum(x => x.Debit - x.Credit);
        // Central cash only records counter collections and refunds, so compare it with the cash lines
        // of those same postings; expenses and supplier payments paid in cash are not a variance.
        var collectionIds = await CollectionVoucherIdsAsync(db, vouchers);
        var collectionCashLines = postedLines.Where(x => x.AccountID == AccountingPosting.Cash && collectionIds.Contains(x.VoucherID)).ToList();
        cashDifference = cashCollection - collectionCashLines.Sum(x => x.Debit - x.Credit);
        pendingCount = vouchers.Count(x => x.Status == "Pending");
        var incomeIds = accounts.Where(x => x.AccountType == "Income").Select(x => x.ID).ToHashSet();
        var expenseIds = accounts.Where(x => x.AccountType == "Expense").Select(x => x.ID).ToHashSet();
        income = postedLines.Where(x => incomeIds.Contains(x.AccountID)).Sum(x => x.Credit - x.Debit);
        expense = postedLines.Where(x => expenseIds.Contains(x.AccountID)).Sum(x => x.Debit - x.Credit);
        periodLocks = await db.FinancialPeriodLocks.AsNoTracking().OrderByDescending(x => x.ID).ToListAsync();
        recentHandovers = isAdministrator
            ? await db.CashierHandovers.AsNoTracking().OrderByDescending(x => x.BusinessDate).ThenByDescending(x => x.ID).Take(50).ToListAsync()
            : [];

        var centralByDay = collections.GroupBy(x => x.TransDateCL.Date).ToDictionary(x => x.Key, x => x.Sum(y => y.Amount));
        var voucherDates = vouchers.ToDictionary(x => x.ID, x => x.VoucherDate.Date);
        var glByDay = collectionCashLines
            .GroupBy(x => voucherDates[x.VoucherID]).ToDictionary(x => x.Key, x => x.Sum(y => y.Debit - y.Credit));
        reconciliationRows = centralByDay.Keys.Union(glByDay.Keys).OrderByDescending(x => x)
            .Select(x => new ReconciliationRow(x, centralByDay.GetValueOrDefault(x), glByDay.GetValueOrDefault(x))).ToList();
        // Chart of accounts totals for the whole period, independent of the ledger filters.
        accountTotals = postedLines.GroupBy(x => x.AccountID).ToDictionary(g => g.Key, g => (g.Sum(x => x.Debit), g.Sum(x => x.Credit)));
        voucherAmounts = allLines.GroupBy(x => x.VoucherID).ToDictionary(g => g.Key, g => g.Sum(x => x.Debit));
        var openingStart = fromDate.Date;
        ledgerOpening = (await (from l in db.AccountVoucherLines
                                join v in db.AccountVouchers on l.VoucherID equals v.ID
                                where v.IsPosted && v.Status != "Pending" && v.Status != "Rejected" && v.VoucherDate < openingStart
                                group l by l.AccountID into g
                                select new { g.Key, Net = g.Sum(x => x.Debit - x.Credit) }).ToListAsync())
            .ToDictionary(x => x.Key, x => x.Net);
        dataVersion++;
    }

    /// <summary>Largest value a numeric(18,2) column can hold.</summary>
    private const decimal MaxAmount = 9_999_999_999_999.99m;
    /// <summary>References the system writes itself; a manual voucher must not imitate them.</summary>
    private static readonly string[] SystemReferencePrefixes =
        ["REV:", "FIXED-ASSET", "PHARMACY-", "SUPPLIER-PAYMENT:", "IPD-", "OPENING-MEDICINE-STOCK"];

    private static string AmountText(decimal v) => v == 0 ? "" : v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>A line has one side only: typing an amount on one side clears the other. An empty box is 0.</summary>
    private void SetLineAmount(ChangeEventArgs e, bool debit)
    {
        var value = decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : 0;
        if (debit) { lineDebit = value; if (value != 0) lineCredit = 0; }
        else { lineCredit = value; if (value != 0) lineDebit = 0; }
    }

    private void AddVoucherLine()
    {
        lineDebit = Math.Round(lineDebit, 2, MidpointRounding.AwayFromZero);
        lineCredit = Math.Round(lineCredit, 2, MidpointRounding.AwayFromZero);
        if (lineAccountId <= 0)
        {
            Fail(string.IsNullOrWhiteSpace(accountHeadSearchText)
                ? (I18n.IsBangla ? "হিসাব খাত নির্বাচন করুন।" : "Select an account head.")
                : (I18n.IsBangla ? "লিখে খোঁজার পর তালিকা থেকে হিসাব খাতটিতে ক্লিক করে নির্বাচন করুন।" : "After typing, click the account head in the list to select it."));
            return;
        }
        if (lineDebit < 0 || lineCredit < 0)
        {
            Fail(I18n.IsBangla ? "পরিমাণ ঋণাত্মক হতে পারে না।" : "Amounts cannot be negative.");
            return;
        }
        if (lineDebit == 0 && lineCredit == 0)
        {
            Fail(I18n.IsBangla ? "ডেবিট অথবা ক্রেডিট ঘরে পরিমাণ লিখুন।" : "Enter an amount in Debit or Credit.");
            return;
        }
        if (lineDebit > 0 && lineCredit > 0)
        {
            Fail(I18n.IsBangla ? "একটি লাইনে হয় ডেবিট, নয় ক্রেডিট — দুটো একসাথে নয়।" : "A line is either debit or credit, not both.");
            return;
        }
        if (SelectedLineHeadRequiresCc && lineCostCenterId <= 0)
        {
            Fail(I18n.IsBangla ? "এই হিসাব খাতে কস্ট সেন্টার (বিভাগ) নির্বাচন আবশ্যক।" : "Select the cost center (department) for this account head.");
            return;
        }
        var costCenterId = lineCostCenterId > 0 ? lineCostCenterId : (int?)null;
        // The same head, department and side again: add to that line instead of a duplicate row.
        var same = voucherLines.FirstOrDefault(x => x.AccountID == lineAccountId && x.CostCenterID == costCenterId && (x.Debit > 0) == (lineDebit > 0));
        // numeric(18,2): one line (after merging into an existing one) cannot exceed 9,999,999,999,999.99.
        if (lineDebit > MaxAmount || lineCredit > MaxAmount
            || (same is not null && (same.Debit + lineDebit > MaxAmount || same.Credit + lineCredit > MaxAmount)))
        {
            Fail(I18n.T("An amount cannot exceed 9,999,999,999,999.99.", "পরিমাণ ৯,৯৯৯,৯৯৯,৯৯৯,৯৯৯.৯৯ এর বেশি হতে পারে না।"));
            return;
        }
        if (same is not null) { same.Debit += lineDebit; same.Credit += lineCredit; }
        else voucherLines.Add(new AccountVoucherLine { AccountID = lineAccountId, Debit = lineDebit, Credit = lineCredit, CostCenterID = costCenterId });
        message = "";
        lineAccountId = 0;
        lineCostCenterId = 0;
        accountHeadSearchText = "";
        // Suggest the amount that balances the voucher on the other side.
        var gap = voucherLines.Sum(x => x.Debit) - voucherLines.Sum(x => x.Credit);
        lineDebit = gap < 0 ? -gap : 0;
        lineCredit = gap > 0 ? gap : 0;
    }

    private async Task SubmitVoucherAsync()
    {
        var debit = voucherLines.Sum(x => x.Debit);
        var credit = voucherLines.Sum(x => x.Credit);
        if (voucherLines.Count < 2 || debit <= 0 || debit != credit || string.IsNullOrWhiteSpace(narration))
        {
            Fail(I18n.IsBangla ? "ভাউচারের জন্য বিবরণ এবং কমপক্ষে দুটি সমপরিমাণ ডেবিট/ক্রেডিট লাইন আবশ্যক।" : "Voucher requires narration and at least two balanced lines.");
            return;
        }
        if (voucherDate.Date > DateTime.Today)
        {
            Fail(I18n.IsBangla ? "ভাউচারের তারিখ ভবিষ্যতের হতে পারে না।" : "The voucher date cannot be in the future.");
            return;
        }
        if (voucherDate.Date < new DateTime(2000, 1, 1))
        {
            Fail(I18n.T("The voucher date cannot be before 01 Jan 2000.", "ভাউচারের তারিখ ০১ জানুয়ারি ২০০০ এর আগে হতে পারে না।"));
            return;
        }
        if (voucherLines.Any(x => x.Debit > MaxAmount || x.Credit > MaxAmount) || debit > MaxAmount)
        {
            Fail(I18n.T("An amount cannot exceed 9,999,999,999,999.99.", "পরিমাণ ৯,৯৯৯,৯৯৯,৯৯৯,৯৯৯.৯৯ এর বেশি হতে পারে না।"));
            return;
        }
        var refText = (reference ?? "").Trim();
        if (refText.Length > 0 && SourceManagedPrefixes.Concat(SystemReferencePrefixes)
                .Any(p => refText.StartsWith(p, StringComparison.OrdinalIgnoreCase)))
        {
            Fail(I18n.T("This reference format is reserved for system-generated vouchers. Please use a different reference.",
                "এই রেফারেন্স ফরম্যাট সিস্টেমের স্বয়ংক্রিয় ভাউচারের জন্য সংরক্ষিত। অন্য রেফারেন্স দিন।"));
            return;
        }
        bool IsCashLine(AccountVoucherLine l) => accounts.FirstOrDefault(a => a.ID == l.AccountID) is { AccountType: "Asset" } a && a.Code.StartsWith("10");
        if (voucherType == "Receipt" && !voucherLines.Any(l => IsCashLine(l) && l.Debit > 0))
        {
            Fail(I18n.IsBangla ? "প্রাপ্তি ভাউচারে নগদ/ব্যাংক (১০xx) খাত ডেবিট হতে হবে। না হলে ধরন 'জার্নাল' দিন।" : "A Receipt voucher must debit a Cash/Bank head (10xx). Otherwise choose Journal.");
            return;
        }
        if (voucherType == "Payment" && !voucherLines.Any(l => IsCashLine(l) && l.Credit > 0))
        {
            Fail(I18n.IsBangla ? "প্রদান ভাউচারে নগদ/ব্যাংক (১০xx) খাত ক্রেডিট হতে হবে। না হলে ধরন 'জার্নাল' দিন।" : "A Payment voucher must credit a Cash/Bank head (10xx). Otherwise choose Journal.");
            return;
        }
        if (voucherType == "Expense" && !voucherLines.Any(l => l.Debit > 0 && accounts.FirstOrDefault(a => a.ID == l.AccountID)?.AccountType == "Expense"))
        {
            Fail(I18n.IsBangla ? "খরচ ভাউচারে কমপক্ষে একটি খরচের খাত ডেবিট হতে হবে।" : "An Expense voucher must debit at least one expense head.");
            return;
        }
        var missingCc = voucherLines.FirstOrDefault(x => x.CostCenterID == null && accounts.FirstOrDefault(a => a.ID == x.AccountID)?.RequiresCostCenter == true);
        if (missingCc is not null)
        {
            Fail(I18n.IsBangla ? $"{AccountCodeAndName(missingCc.AccountID)}: কস্ট সেন্টার (বিভাগ) আবশ্যক।" : $"{AccountCodeAndName(missingCc.AccountID)}: cost center (department) is required.");
            return;
        }
        if (saving) return;
        saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var uid = await CurrentUserIdAsync();
            await FinancialControl.EnsurePostingAllowedAsync(db, voucherDate, uid);
            var v = new AccountVoucher
            {
                VoucherNo = $"V{DateTime.Now:yyMMddHHmmssfff}",
                VoucherType = voucherType,
                VoucherDate = voucherDate.Date,
                Narration = narration.Trim(),
                Reference = reference.Trim(),
                IsPosted = false,
                Status = "Pending",
                EnteredBy = uid,
                TransDate = DateTime.Now,
                Lines = voucherLines.Select(x => new AccountVoucherLine { AccountID = x.AccountID, Debit = x.Debit, Credit = x.Credit, CostCenterID = x.CostCenterID }).ToList()
            };
            db.AccountVouchers.Add(v);
            await db.SaveChangesAsync();
            Success(I18n.IsBangla ? $"ভাউচার {v.VoucherNo} অনুমোদনের জন্য জমা দেওয়া হয়েছে।" : $"Voucher {v.VoucherNo} submitted for approval.");
            ResetVoucher();
            await LoadAsync();
        }
        catch (Exception ex) { Fail(ex.GetBaseException().Message); }
        finally { saving = false; }
    }

    private async Task ApproveVoucherAsync(AccountVoucher row)
    {
        if (!isAdministrator || saving) return;
        saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var x = await db.AccountVouchers.FindAsync(row.ID);
            if (x is null || x.Status != "Pending") { Fail(I18n.IsBangla ? "ভাউচারটি আর পেন্ডিং অবস্থায় নেই।" : "Voucher is no longer pending."); return; }
            var uid = await CurrentUserIdAsync();
            if (x.EnteredBy == uid)
            {
                Fail(I18n.IsBangla ? "নিজের লেখা ভাউচার নিজে অনুমোদন করা যায় না। অন্য একজন অ্যাডমিনিস্ট্রেটর অনুমোদন করবেন।" : "You cannot approve your own voucher. Another administrator must approve it.");
                return;
            }
            await FinancialControl.EnsurePostingAllowedAsync(db, x.VoucherDate, uid);
            x.Status = "Approved"; x.IsPosted = true; x.ApprovedBy = uid; x.ApprovedAt = DateTime.Now;
            await db.SaveChangesAsync();
            Success(I18n.IsBangla ? $"ভাউচার {x.VoucherNo} অনুমোদিত ও পোস্ট হয়েছে।" : $"Voucher {x.VoucherNo} approved and posted.");
            await LoadAsync();
        }
        catch (Exception ex) { Fail(ex.GetBaseException().Message); }
        finally { saving = false; }
    }

    private async Task RejectVoucherAsync(AccountVoucher row)
    {
        if (!isAdministrator || string.IsNullOrWhiteSpace(actionReason)) { Fail(I18n.IsBangla ? "প্রথমে বাতিলের কারণ লিখুন।" : "Enter a rejection reason first."); return; }
        if (actionReason.Trim().Length > 400) { Fail(I18n.T("Keep the reason within 400 characters.", "কারণ ৪০০ অক্ষরের মধ্যে লিখুন।")); return; }
        await GuardAsync(async () =>
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var x = await db.AccountVouchers.FindAsync(row.ID);
            if (x is null || x.Status != "Pending") { Fail(I18n.IsBangla ? "ভাউচারটি আর পেন্ডিং অবস্থায় নেই।" : "Voucher is no longer pending."); return; }
            x.Status = "Rejected"; x.IsPosted = false; x.CancelledBy = await CurrentUserIdAsync(); x.CancelledAt = DateTime.Now; x.CancellationReason = actionReason.Trim();
            await db.SaveChangesAsync(); actionReason = "";
            Success(I18n.IsBangla ? $"ভাউচার {x.VoucherNo} বাতিল করা হয়েছে।" : $"Voucher {x.VoucherNo} rejected.");
            await LoadAsync();
        });
    }

    private async Task ReverseVoucherAsync(AccountVoucher row)
    {
        if (!isAdministrator || string.IsNullOrWhiteSpace(actionReason)) { Fail(I18n.IsBangla ? "প্রথমে রিভার্সালের কারণ লিখুন।" : "Enter a reversal reason first."); return; }
        if (actionReason.Trim().Length > 400) { Fail(I18n.T("Keep the reason within 400 characters.", "কারণ ৪০০ অক্ষরের মধ্যে লিখুন।")); return; }
        if (saving) return;
        saving = true;
        try
        {
            AccountVoucher x = null!;
            AccountVoucher reversal = null!;
            var uid = await CurrentUserIdAsync();
            await ResilientTransaction.ExecuteAsync(DbFactory, async db =>
            {
                await FinancialControl.EnsurePostingAllowedAsync(db, DateTime.Today, uid);
                x = await db.AccountVouchers.SingleAsync(x => x.ID == row.ID);
                if (IsSystemVoucher(x))
                    throw new InvalidOperationException(I18n.IsBangla ? "এই ভাউচার বিল বা মাস-শেষ থেকে নিজে পোস্ট হয়েছে; যেখান থেকে এসেছে সেখান থেকে বাতিল করুন।" : "This voucher was posted automatically; cancel it from the bill or month-end screen it came from.");
                reversal = await AccountingPosting.ReversePostedVoucherAsync(db, x, actionReason, uid, DateTime.Now);
                await db.SaveChangesAsync();
                return true;
            });
            actionReason = "";
            Success(I18n.IsBangla ? $"{x.VoucherNo} রিভার্সাল {reversal.VoucherNo} এর মাধ্যমে বাতিল করা হয়েছে।" : $"{x.VoucherNo} cancelled through reversal {reversal.VoucherNo}.");
            await LoadAsync();
        }
        catch (Exception ex) { Fail(ex.GetBaseException().Message); }
        finally { saving = false; }
    }

    private async Task PrintVoucherFormatAsync(AccountVoucher row, string format)
    {
        try
        {
            selectedVoucher = row;
            await using var db = await DbFactory.CreateDbContextAsync();
            selectedVoucherLines = await db.AccountVoucherLines.AsNoTracking().Where(x => x.VoucherID == row.ID).ToListAsync();
            var userIds = new[] { row.EnteredBy, row.ApprovedBy ?? 0 }.Where(x => x > 0).Distinct().ToArray();
            var users = await db.Users.AsNoTracking().Where(u => userIds.Contains(u.Id)).ToListAsync();
            printPreparedBy = users.FirstOrDefault(u => u.Id == row.EnteredBy)?.GetEffectiveName() ?? "";
            printApprovedBy = row.ApprovedBy is int a ? users.FirstOrDefault(u => u.Id == a)?.GetEffectiveName() ?? "" : "";
            await InvokeAsync(StateHasChanged);
            await Task.Delay(60);
            var elementId = format switch
            {
                "a5" => "voucher-print-a5",
                "80mm" => "voucher-print-80mm",
                _ => "voucher-print-a4"
            };
            await JS.InvokeVoidAsync("hpm.printElement", elementId, row.VoucherNo);
        }
        catch (Exception ex) { Fail(ex.GetBaseException().Message); }
    }

