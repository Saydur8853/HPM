        var today = DateTime.Today;
        switch (preset)
        {
            case "today":
                fromDate = today;
                toDate = today;
                break;
            case "yesterday":
                fromDate = today.AddDays(-1);
                toDate = today.AddDays(-1);
                break;
            case "7days":
                fromDate = today.AddDays(-6);
                toDate = today;
                break;
            case "month":
                fromDate = new DateTime(today.Year, today.Month, 1);
                toDate = today;
                break;
            case "year":
                fromDate = new DateTime(today.Year, 1, 1);
                toDate = today;
                break;
        }
        await LoadAsync();
    }

