    private async Task CalculateHandoverAsync()
    {
        var uid = await CurrentUserIdAsync(); await using var db = await DbFactory.CreateDbContextAsync(); var end = handoverDate.Date.AddDays(1);
        handoverSystem = await db.CentralCashCollections.Where(x => x.EnteredBy == uid && x.TransDateCL >= handoverDate.Date && x.TransDateCL < end).SumAsync(x => (decimal?)x.Amount) ?? 0;
        currentHandover = await db.CashierHandovers.AsNoTracking().FirstOrDefaultAsync(x => x.BusinessDate == handoverDate.Date && x.CashierID == uid);
        handedAmount = currentHandover?.HandedOverAmount ?? handoverSystem; handoverNotes = currentHandover?.Notes ?? "";
    }

    private async Task CloseDayAsync()
    {
        if (handedAmount < 0) { Fail(I18n.IsBangla ? "হস্তান্তরিত পরিমাণ ঋণাত্মক হতে পারে না।" : "Handover amount cannot be negative."); return; }
        var uid = await CurrentUserIdAsync(); await using var db = await DbFactory.CreateDbContextAsync();
        await FinancialControl.EnsurePostingAllowedAsync(db, handoverDate, uid);
        var x = await db.CashierHandovers.FirstOrDefaultAsync(x => x.BusinessDate == handoverDate.Date && x.CashierID == uid) ?? new CashierHandover { BusinessDate = handoverDate.Date, CashierID = uid };
        if (x.ID == 0) db.CashierHandovers.Add(x);
        x.SystemAmount = handoverSystem; x.HandedOverAmount = handedAmount; x.Variance = handedAmount - handoverSystem; x.Notes = handoverNotes.Trim(); x.TransDate = DateTime.Now; x.IsLocked = true; x.ClosedAt = DateTime.Now;
        await db.SaveChangesAsync(); Success(I18n.IsBangla ? $"ক্যাশিয়ার শিফট সমাপ্ত ও লক করা হয়েছে। পার্থক্য: {I18n.FormatCurrency(x.Variance)}।" : $"Cashier day closed and locked. Variance: {I18n.FormatCurrency(x.Variance)}."); await CalculateHandoverAsync();
    }

    private async Task ReopenCurrentDayAsync()
    {
        if (currentHandover is not null) await ReopenHandoverAsync(currentHandover);
    }

    private async Task ReopenHandoverAsync(CashierHandover row)
    {
        if (!isAdministrator) return;
        var reason = await JS.InvokeAsync<string?>("hpm.prompt", I18n.IsBangla ? $"ক্যাশিয়ার #{row.CashierID} ({row.BusinessDate:dd MMM yyyy}) পুনরায় খোলার কারণ:" : $"Reason for reopening cashier #{row.CashierID} on {row.BusinessDate:dd MMM yyyy}:"); if (string.IsNullOrWhiteSpace(reason)) return;
        var uid = await CurrentUserIdAsync(); await using var db = await DbFactory.CreateDbContextAsync();
        var x = await db.CashierHandovers.FindAsync(row.ID); if (x is null || !x.IsLocked) return;
        x.IsLocked = false; x.ReopenedBy = uid; x.ReopenedAt = DateTime.Now; x.ReopenReason = reason.Trim(); await db.SaveChangesAsync();
        Success(I18n.IsBangla ? "ক্যাশিয়ার শিফট অডিট কারণসহ পুনরায় খোলা হয়েছে।" : "Cashier day reopened with audit reason."); await LoadAsync(); await CalculateHandoverAsync();
    }

    private async Task LockPeriodAsync()
    {
        if (!isAdministrator || lockFrom.Date > lockTo.Date || string.IsNullOrWhiteSpace(lockReason)) { Fail(I18n.IsBangla ? "সঠিক সময়কাল এবং লক করার কারণ লিখুন।" : "Enter a valid period and lock reason."); return; }
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.FinancialPeriodLocks.AnyAsync(x => x.IsActive && x.FromDate <= lockTo.Date && x.ToDate >= lockFrom.Date)) { Fail(I18n.IsBangla ? "এই সময়কালটি অন্য একটি সক্রিয় আর্থিক লকের সাথে মিলে যায়।" : "This range overlaps an active financial lock."); return; }
        db.FinancialPeriodLocks.Add(new FinancialPeriodLock { FromDate = lockFrom.Date, ToDate = lockTo.Date, Reason = lockReason.Trim(), IsActive = true, LockedBy = await CurrentUserIdAsync(), LockedAt = DateTime.Now });
        await db.SaveChangesAsync(); lockReason = ""; Success(I18n.IsBangla ? "আর্থিক সময়কাল লক করা হয়েছে।" : "Financial period locked."); await LoadAsync();
    }

    private async Task UnlockPeriodAsync(FinancialPeriodLock row)
    {
        var reason = await JS.InvokeAsync<string?>("hpm.prompt", I18n.IsBangla ? "আর্থিক সময়কাল আনলক করার কারণ:" : "Reason for unlocking this financial period:"); if (string.IsNullOrWhiteSpace(reason)) return;
        await using var db = await DbFactory.CreateDbContextAsync(); var x = await db.FinancialPeriodLocks.FindAsync(row.ID); if (x is null || !x.IsActive) return;
        x.IsActive = false; x.UnlockedBy = await CurrentUserIdAsync(); x.UnlockedAt = DateTime.Now; x.UnlockReason = reason.Trim(); await db.SaveChangesAsync();
        Success(I18n.IsBangla ? "আর্থিক সময়কাল অডিট রেকর্ডসহ আনলক করা হয়েছে।" : "Financial period unlocked with audit trail."); await LoadAsync();
    }

    private async Task BackfillOperationalJournalsAsync()
    {
        if (!isAdministrator) return;
        try
        {
            var uid = await CurrentUserIdAsync();
            await ResilientTransaction.ExecuteAsync(DbFactory, async db =>
            {
                var end = toDate.Date.AddDays(1);
                var opd = await db.OPDTickets.Where(x => x.TransDate >= fromDate.Date && x.TransDate < end).ToListAsync();
                foreach (var x in opd) await OperationalAccounting.SyncRevenueAsync(db, $"OPD-TICKET:{x.ID}", x.ID, x.Total, x.TransDate, uid, $"OPD consultation ticket #{x.ID}", AccountingPosting.Cash, AccountingPosting.ModuleFlags.OpdTicket);
                var memos = await db.EmergencyMemos.Where(x => x.TransDate >= fromDate.Date && x.TransDate < end && (x.ModuleID == 11 || x.ModuleID == 2)).ToListAsync();
                foreach (var x in memos)
                {
                    var diagnostic = x.ModuleID == 2; var prefix = diagnostic ? "DIAGNOSTIC" : "EMERGENCY";
                    var flag = diagnostic ? AccountingPosting.ModuleFlags.Diagnostic : AccountingPosting.ModuleFlags.Emergency;
                    var netAmount = Math.Max(0, x.Total - x.Discount);
                    var paidAmount = Math.Min(x.Paid, netAmount);
                    await OperationalAccounting.SyncSplitRevenueAsync(db, $"{prefix}:{x.ID}", x.ID, netAmount, paidAmount, x.TransDate, uid, $"{prefix} memo #{x.ID}", x.PatientType == "1" ? flag : null);
                }
                var ot = await db.OTCashMemos.Where(x => x.TransDate >= fromDate.Date && x.TransDate < end).ToListAsync();
                foreach (var x in ot)
                {
                    var debit = x.PatientType == "1" ? AccountingPosting.Cash : AccountingPosting.PatientReceivable;
                    await OperationalAccounting.SyncRevenueAsync(db, $"OT-MEMO:{x.ID}", x.ID, Math.Max(0, x.Total - x.Discount), x.TransDate, uid, $"OT cash memo #{x.ID}", debit, x.PatientType == "1" ? AccountingPosting.ModuleFlags.Ot : null);
                }
                var reversedIds = await db.FinancialReversals.Where(x => x.EntityType == "IPD Money Receipt").Select(x => x.EntityID).ToListAsync();
                var receipts = await db.IpdMoneyReceipts.Where(x => x.TransDate >= fromDate.Date && x.TransDate < end && !reversedIds.Contains(x.ID)).ToListAsync();
                foreach (var x in receipts)
                {
                    var reference = $"IPD-RECEIPT:{x.ID}";
                    if (!await db.AccountVouchers.AnyAsync(v => v.Reference == reference && v.Status != "Cancelled"))
                    {
                        var credit = x.Against == "Advance" ? AccountingPosting.PatientAdvance : AccountingPosting.PatientReceivable;
                        AccountingPosting.AddPostedVoucher(db, "Receipt", x.TransDate, $"IPD {x.Against} receipt {x.RegNo}", reference, uid,
                            (AccountingPosting.Cash, x.Amount, 0), (credit, 0, x.Amount));
                    }
                }
                await db.SaveChangesAsync();
                return true;
            });
            Success(I18n.IsBangla ? "অপারেশনাল জার্নাল ব্যাকফিল সম্পন্ন হয়েছে।" : "Operational journal backfill completed. Review the reconciliation variance."); await LoadAsync();
        }
        catch (Exception ex) { Fail($"Backfill failed: {ex.GetBaseException().Message}"); }
    }

    private async Task SaveAccountAsync()
    {
        if (!isAdministrator) return; accountEditor.Code = accountEditor.Code.Trim(); accountEditor.Name = accountEditor.Name.Trim();
        if (string.IsNullOrWhiteSpace(accountEditor.Code) || string.IsNullOrWhiteSpace(accountEditor.Name)) { Fail(I18n.IsBangla ? "হিসাব কোড ও নাম আবশ্যক।" : "Account code and name are required."); return; }
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.AccountHeads.AnyAsync(x => x.Code == accountEditor.Code && x.ID != accountEditor.ID)) { Fail(I18n.IsBangla ? "হিসাব কোড ইতিমধ্যে বিদ্যমান।" : "Account code already exists."); return; }
        if (accountEditor.ID == 0) db.AccountHeads.Add(accountEditor); else { var x = await db.AccountHeads.FindAsync(accountEditor.ID); if (x is null) return; x.Code = accountEditor.Code; x.Name = accountEditor.Name; x.AccountType = accountEditor.AccountType; x.IsActive = accountEditor.IsActive; }
        await db.SaveChangesAsync(); Success(I18n.IsBangla ? "হিসাব খাত সংরক্ষিত হয়েছে।" : "Account head saved."); ResetAccount(); await LoadAsync();
    }

    private void SelectAccount(AccountHead x) => accountEditor = new() { ID = x.ID, Code = x.Code, Name = x.Name, AccountType = x.AccountType, ParentID = x.ParentID, IsActive = x.IsActive };
    private void ResetAccount() => accountEditor = new() { AccountType = "Asset", IsActive = true };
    private void ResetVoucher() { voucherLines = []; voucherType = "Journal"; voucherDate = DateTime.Today; reference = ""; narration = ""; lineAccountId = 0; accountHeadSearchText = ""; lineDebit = 0; lineCredit = 0; }
    private decimal VoucherAmount(long id) => allLines.Where(x => x.VoucherID == id).Sum(x => x.Debit);
    private decimal AccountPeriodDebit(int accountId) => LedgerRows.Where(x => x.AccountID == accountId).Sum(x => x.Debit);
    private decimal AccountPeriodCredit(int accountId) => LedgerRows.Where(x => x.AccountID == accountId).Sum(x => x.Credit);
    private string AccountName(int id) => accounts.FirstOrDefault(x => x.ID == id)?.Name ?? "—";
    private string AccountCodeAndName(int id) { var a = accounts.FirstOrDefault(x => x.ID == id); return a != null ? $"{a.Code} · {a.Name}" : "—"; }
    private async Task<int> CurrentUserIdAsync() { var u = (await AuthStateProvider.GetAuthenticationStateAsync()).User; return int.TryParse(u.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : 1; }
    private void Success(string text) { messageClass = "success"; message = text; }
    private void Fail(string text) { messageClass = "danger"; message = text; }
    private sealed record LedgerRow(DateTime Date, string VoucherNo, int AccountID, string? Narration, decimal Debit, decimal Credit);
    private sealed record ReconciliationRow(DateTime Date, decimal CentralCash, decimal GlCash) { public decimal Variance => CentralCash - GlCash; }
}
