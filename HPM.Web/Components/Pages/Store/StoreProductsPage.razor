@page "/store/products"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.StoreKeeper)]
@inherits StorePageBase

<PageTitle>@I18n.T("Store Item List & Setup") | @Branding.HospitalName</PageTitle>

<div class="pharmacy-classic-fit px-root">
    <div class="px-topbar">
        <div class="px-topbar-left">
            <h1 class="px-title">⚙️ @I18n.T("Item List & Setup")</h1>
            <div class="px-seg">
                @foreach (var t in Tabs)
                {
                    var tt = t;
                    <button type="button" class="@(tab == tt.Key ? "on" : "")" @onclick="() => SwitchTab(tt.Key)">@tt.Icon @I18n.T(tt.Label)</button>
                }
            </div>
        </div>
        <div class="px-topbar-right">
            <div class="px-metric"><span>@I18n.T("Items")</span><b>@Lookups.Products.Count(p => p.IsActive)</b></div>
            <div class="px-metric"><span>@I18n.T("Low Stock")</span><b class="bad">@Lookups.Products.Count(p => p.IsActive && p.Balance <= p.ReOrderLevel)</b></div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="px-alert @MessageClass"><span>@Message</span><button type="button" @onclick='() => Message = ""'>✕</button></div>
    }

    <div class="pharmacy-classic-workspace">
        @* ---------------- LEFT: list ---------------- *@
        <section class="px-card">
            <header class="px-card-head stack">
                <div class="px-filter-row">
                    <div class="px-search-box sm grow">
                        <span class="px-search-icon">🔍</span>
                        <input type="text" placeholder="@I18n.T("Search...")" @bind="search" @bind:event="oninput" autocomplete="off" />
                        @if (!string.IsNullOrWhiteSpace(search))
                        {
                            <button type="button" class="px-x" @onclick='() => search = ""'>✕</button>
                        }
                    </div>
                    @if (tab == "items")
                    {
                        <select @bind="categoryFilter">
                            <option value="0">@I18n.T("All categories")</option>
                            @foreach (var c in Lookups.Categories)
                            {
                                <option value="@c.ID">@c.Name</option>
                            }
                        </select>
                        <label class="px-check"><input type="checkbox" checked="@showInactive" @onchange="e => showInactive = e.Value is true" /> <span>@I18n.T("Show inactive")</span></label>
                    }
                    <button type="button" class="px-btn primary" @onclick="StartNew">+ @I18n.T("Add New")</button>
                </div>
            </header>
            <div class="px-queue">
                @{ var tokens = SearchText.Tokenize(search); }
                @if (tab == "items")
                {
                    var items = Lookups.Products.Where(p => (showInactive || p.IsActive) && (categoryFilter == 0 || p.CategoryID == categoryFilter)
                        && SearchText.MatchesAll(tokens, p.Name, Lookups.CategoryName(p.CategoryID), p.Unit)).ToList();
                    @if (items.Count == 0) { <div class="px-empty sm">@I18n.T("No item found.")</div> }
                    @foreach (var p in items.Take(500))
                    {
                        var low = p.Balance <= p.ReOrderLevel;
                        <button type="button" class="px-q-item @(itemEditor?.ID == p.ID ? "active" : "")" @onclick="() => EditItem(p)">
                            <span class="px-q-id">#@p.ID</span>
                            <span class="px-q-info">
                                <span class="px-q-name">
                                    @SearchText.Highlight(p.Name, tokens)
                                    @if (p.TrackExpiry) { <span class="px-tag amber">EXP</span> }
                                    @if (!p.IsActive) { <span class="px-tag gray">@I18n.T("Inactive")</span> }
                                </span>
                                <span class="px-q-meta">@SearchText.Highlight(Lookups.CategoryName(p.CategoryID), tokens) · @p.Unit · @I18n.T("Reorder") @p.ReOrderLevel · @I18n.FormatCurrency(p.BuyRate)</span>
                            </span>
                            <span class="px-stock @(p.Balance <= 0 ? "out" : low ? "low" : "ok")">@p.Balance.ToString("0.##")</span>
                        </button>
                    }
                }
                else if (tab == "categories")
                {
                    @foreach (var c in Lookups.Categories.Where(c => SearchText.MatchesAll(tokens, c.Name)))
                    {
                        <button type="button" class="px-q-item @(nameEditorId == c.ID ? "active" : "")" @onclick="() => EditName(c.ID, c.Name, true)">
                            <span class="px-q-id">#@c.ID</span>
                            <span class="px-q-info"><span class="px-q-name">@SearchText.Highlight(c.Name, tokens)</span><span class="px-q-meta">@Lookups.Products.Count(p => p.CategoryID == c.ID) @I18n.T("items")</span></span>
                        </button>
                    }
                }
                else if (tab == "suppliers")
                {
                    @foreach (var s in Lookups.Suppliers.Where(s => SearchText.MatchesAll(tokens, s.Name, s.Contact, s.Address)))
                    {
                        <button type="button" class="px-q-item @(supplierEditor?.ID == s.ID ? "active" : "")" @onclick="() => EditSupplier(s)">
                            <span class="px-q-id">#@s.ID</span>
                            <span class="px-q-info"><span class="px-q-name">@SearchText.Highlight(s.Name, tokens)</span><span class="px-q-meta">@SearchText.Highlight(s.Contact, tokens) @(string.IsNullOrWhiteSpace(s.Address) ? "" : $"· {s.Address}")</span></span>
                        </button>
                    }
                }
                else if (tab == "stores")
                {
                    @foreach (var l in Lookups.Locations.Where(l => SearchText.MatchesAll(tokens, l.Name)))
                    {
                        <button type="button" class="px-q-item @(locationEditor?.ID == l.ID ? "active" : "")" @onclick="() => EditLocation(l)">
                            <span class="px-q-id">#@l.ID</span>
                            <span class="px-q-info">
                                <span class="px-q-name">@SearchText.Highlight(l.Name, tokens) @if (l.IsCentral) { <span class="px-tag blue">@I18n.T("Central")</span> } @if (!l.IsActive) { <span class="px-tag gray">@I18n.T("Inactive")</span> }</span>
                                <span class="px-q-meta">@I18n.T("Usable stock lines"): @Lookups.Stock.Count(kv => kv.Key.Location == l.ID)</span>
                            </span>
                        </button>
                    }
                }
                else
                {
                    @foreach (var d in Lookups.Departments.Where(d => SearchText.MatchesAll(tokens, d.Name)))
                    {
                        <button type="button" class="px-q-item @(departmentEditor?.ID == d.ID ? "active" : "")" @onclick="() => EditDepartment(d)">
                            <span class="px-q-id">#@d.ID</span>
                            <span class="px-q-info"><span class="px-q-name">@SearchText.Highlight(d.Name, tokens) @if (!d.IsActive) { <span class="px-tag gray">@I18n.T("Inactive")</span> }</span></span>
                        </button>
                    }
                }
            </div>
        </section>

        @* ---------------- RIGHT: editor ---------------- *@
        <aside class="px-card">
            @if (tab == "items" && itemEditor != null)
            {
                <header class="px-card-head"><div class="px-card-title"><h2>@(itemEditor.ID == 0 ? I18n.T("New Item") : $"{I18n.T("Edit Item")} #{itemEditor.ID}")</h2></div></header>
                <div class="px-card-body">
                    <div class="px-form-grid two">
                        <label class="px-field span-all"><span>@I18n.T("Item Name") <i>*</i></span><input @bind="itemEditor.Name" maxlength="50" /></label>
                        <label class="px-field">
                            <span>@I18n.T("Category") <i>*</i></span>
                            <select @bind="itemEditor.CategoryID">
                                <option value="0">@I18n.T("Select...")</option>
                                @foreach (var c in Lookups.Categories) { <option value="@c.ID">@c.Name</option> }
                            </select>
                        </label>
                        <label class="px-field">
                            <span>@I18n.T("Unit") <i>*</i></span>
                            <input @bind="itemEditor.Unit" maxlength="50" list="store-units" placeholder="Pcs, Box, Pack..." />
                            <datalist id="store-units">@foreach (var u in CommonUnits) { <option value="@u"></option> }</datalist>
                        </label>
                        <label class="px-field">
                            <span>@I18n.T("Main Supplier")</span>
                            <select @bind="itemEditor.Supplier">
                                <option value="0">@I18n.T("None")</option>
                                @foreach (var s in Lookups.Suppliers) { <option value="@s.ID">@s.Name</option> }
                            </select>
                        </label>
                        <label class="px-field"><span>@I18n.T("Reorder Level")</span><input type="number" min="0" @bind="itemEditor.ReOrderLevel" /></label>
                        <label class="px-field"><span>@I18n.T("Buy Rate")</span><input type="number" min="0" step="0.01" @bind="itemEditor.BuyRate" /></label>
                        <label class="px-field"><span>@I18n.T("Sale / Charge Rate")</span><input type="number" min="0" step="0.01" @bind="itemEditor.SaleRate" /></label>
                        <label class="px-check span-all"><input type="checkbox" checked="@itemEditor.TrackExpiry" @onchange="e => itemEditor.TrackExpiry = e.Value is true" /> <span>@I18n.T("Track batch & expiry (reagents, kits, sterile items)")</span></label>
                        <label class="px-check span-all"><input type="checkbox" checked="@itemEditor.IsActive" @onchange="e => itemEditor.IsActive = e.Value is true" /> <span>@I18n.T("Active (available for requisition & issue)")</span></label>
                    </div>

                    @if (itemEditor.ID == 0)
                    {
                        <h3 class="px-section-title">@I18n.T("Opening Stock") <em class="muted">@I18n.T("optional")</em></h3>
                        <div class="px-panel px-form-grid two">
                            <label class="px-field">
                                <span>@I18n.T("Store")</span>
                                <select @bind="openingLocationId">@foreach (var l in Lookups.Locations) { <option value="@l.ID">@l.Name</option> }</select>
                            </label>
                            <label class="px-field"><span>@I18n.T("Quantity")</span><input type="number" min="0" @bind="openingQty" /></label>
                            <label class="px-field"><span>@I18n.T("Batch No")</span><input @bind="openingBatch" maxlength="50" /></label>
                            <label class="px-field"><span>@I18n.T("Expiry")</span><input type="date" @bind="openingExpiry" /></label>
                        </div>
                    }
                    else
                    {
                        <div class="px-bill-strip">
                            <div><span>@I18n.T("Total Stock")</span><b>@itemEditor.Balance.ToString("0.##") @itemEditor.Unit</b></div>
                            @foreach (var l in Lookups.Locations)
                            {
                                var q = Lookups.StockAt(l.ID, itemEditor.ID);
                                if (q > 0) { <div><span>@l.Name</span><b>@q.ToString("0.##")</b></div> }
                            }
                        </div>
                        <small class="muted">@I18n.T("Stock changes only through GRN, issue, return, transfer or stock count.")</small>
                    }
                </div>
                <footer class="px-card-foot">
                    <button type="button" class="px-btn" @onclick="() => itemEditor = null">@I18n.T("Cancel")</button>
                    <button type="button" class="px-btn primary lg" disabled="@IsBusy" @onclick="SaveItemAsync">@(IsBusy ? I18n.T("Saving…") : I18n.T("Save Item"))</button>
                </footer>
            }
            else if (tab == "categories" && nameEditorId != null)
            {
                <header class="px-card-head"><div class="px-card-title"><h2>@(nameEditorId == 0 ? I18n.T("New Category") : I18n.T("Edit Category"))</h2></div></header>
                <div class="px-card-body">
                    <label class="px-field"><span>@I18n.T("Category Name") <i>*</i></span><input @bind="nameEditorValue" maxlength="50" /></label>
                </div>
                <footer class="px-card-foot">
                    <button type="button" class="px-btn" @onclick="() => nameEditorId = null">@I18n.T("Cancel")</button>
                    <button type="button" class="px-btn primary lg" disabled="@IsBusy" @onclick="SaveCategoryAsync">@I18n.T("Save")</button>
                </footer>
            }
            else if (tab == "suppliers" && supplierEditor != null)
            {
                <header class="px-card-head"><div class="px-card-title"><h2>@(supplierEditor.ID == 0 ? I18n.T("New Supplier") : I18n.T("Edit Supplier"))</h2></div></header>
                <div class="px-card-body">
                    <label class="px-field"><span>@I18n.T("Supplier Name") <i>*</i></span><input @bind="supplierEditor.Name" maxlength="50" /></label>
                    <label class="px-field"><span>@I18n.T("Contact")</span><input @bind="supplierEditor.Contact" maxlength="50" /></label>
                    <label class="px-field"><span>@I18n.T("Address")</span><input @bind="supplierEditor.Address" maxlength="100" /></label>
                </div>
                <footer class="px-card-foot">
                    <button type="button" class="px-btn" @onclick="() => supplierEditor = null">@I18n.T("Cancel")</button>
                    <button type="button" class="px-btn primary lg" disabled="@IsBusy" @onclick="SaveSupplierAsync">@I18n.T("Save")</button>
                </footer>
            }
            else if (tab == "stores" && locationEditor != null)
            {
                <header class="px-card-head"><div class="px-card-title"><h2>@(locationEditor.ID == 0 ? I18n.T("New Sub-store") : I18n.T("Edit Sub-store"))</h2></div></header>
                <div class="px-card-body">
                    <label class="px-field"><span>@I18n.T("Store Name") <i>*</i></span><input @bind="locationEditor.Name" maxlength="60" /></label>
                    <label class="px-field"><span>@I18n.T("Display Order")</span><input type="number" @bind="locationEditor.SortOrder" /></label>
                    <label class="px-check"><input type="checkbox" checked="@locationEditor.IsCentral" @onchange="e => locationEditor.IsCentral = e.Value is true" /> <span>@I18n.T("Central store (default for receiving & issue)")</span></label>
                    <label class="px-check"><input type="checkbox" checked="@locationEditor.IsActive" @onchange="e => locationEditor.IsActive = e.Value is true" /> <span>@I18n.T("Active")</span></label>
                </div>
                <footer class="px-card-foot">
                    <button type="button" class="px-btn" @onclick="() => locationEditor = null">@I18n.T("Cancel")</button>
                    <button type="button" class="px-btn primary lg" disabled="@IsBusy" @onclick="SaveLocationAsync">@I18n.T("Save")</button>
                </footer>
            }
            else if (tab == "departments" && departmentEditor != null)
            {
                <header class="px-card-head"><div class="px-card-title"><h2>@(departmentEditor.ID == 0 ? I18n.T("New Department") : I18n.T("Edit Department"))</h2></div></header>
                <div class="px-card-body">
                    <label class="px-field"><span>@I18n.T("Department / Cost Centre") <i>*</i></span><input @bind="departmentEditor.Name" maxlength="80" /></label>
                    <label class="px-check"><input type="checkbox" checked="@departmentEditor.IsActive" @onchange="e => departmentEditor.IsActive = e.Value is true" /> <span>@I18n.T("Active")</span></label>
                </div>
                <footer class="px-card-foot">
                    <button type="button" class="px-btn" @onclick="() => departmentEditor = null">@I18n.T("Cancel")</button>
                    <button type="button" class="px-btn primary lg" disabled="@IsBusy" @onclick="SaveDepartmentAsync">@I18n.T("Save")</button>
                </footer>
            }
            else
            {
                <div class="px-finder-empty">
                    <div class="icon">@Tabs.First(t => t.Key == tab).Icon</div>
                    <h3>@I18n.T("Select a row to edit, or Add New")</h3>
                    <ul>
                        <li>@I18n.T("Items: name, unit, category, reorder level, expiry tracking")</li>
                        <li>@I18n.T("Sub-stores: Central, Laboratory, OT...")</li>
                        <li>@I18n.T("Departments: who can request and receive items")</li>
                    </ul>
                </div>
            }
        </aside>
    </div>
</div>

@code {
    private static readonly (string Key, string Icon, string Label)[] Tabs =
    [
        ("items", "📦", "Items"), ("categories", "🏷️", "Categories"), ("suppliers", "🚚", "Suppliers"), ("stores", "🏬", "Sub-stores"), ("departments", "🏥", "Departments")
    ];
    private static readonly string[] CommonUnits = ["Pcs", "Box", "Pack", "Pair", "Bottle", "Vial", "Kit", "Test", "Roll", "Ream", "Set", "Litre", "ml", "Kg", "Gm", "Meter"];

    private string tab = "items";
    private string search = "";
    private int categoryFilter;
    private bool showInactive;

    private StoreProduct? itemEditor;
    private int openingLocationId;
    private decimal openingQty;
    private string? openingBatch;
    private DateTime? openingExpiry;
    private int? nameEditorId;
    private string nameEditorValue = "";
    private SupplierStore? supplierEditor;
    private StoreLocation? locationEditor;
    private StoreDepartment? departmentEditor;

    protected override async Task OnStoreInitializedAsync() => await ReloadLookupsAsync(includeInactive: true);

    private void SwitchTab(string t)
    {
        tab = t;
        search = "";
        CloseEditors();
    }

    private void CloseEditors()
    {
        itemEditor = null;
        nameEditorId = null;
        supplierEditor = null;
        locationEditor = null;
        departmentEditor = null;
        Message = "";
    }

    private void StartNew()
    {
        CloseEditors();
        switch (tab)
        {
            case "items":
                itemEditor = new StoreProduct { Unit = "Pcs", ReOrderLevel = 10, IsActive = true, CategoryID = categoryFilter };
                openingLocationId = Lookups.DefaultLocationId;
                openingQty = 0; openingBatch = null; openingExpiry = null;
                break;
            case "categories": nameEditorId = 0; nameEditorValue = ""; break;
            case "suppliers": supplierEditor = new SupplierStore(); break;
            case "stores": locationEditor = new StoreLocation { IsActive = true, SortOrder = Lookups.Locations.Count }; break;
            default: departmentEditor = new StoreDepartment { IsActive = true }; break;
        }
    }

    private void EditItem(StoreProduct p)
    {
        CloseEditors();
        itemEditor = new StoreProduct
        {
            ID = p.ID, Name = p.Name, Unit = p.Unit, CategoryID = p.CategoryID, Supplier = p.Supplier, ReOrderLevel = p.ReOrderLevel,
            Balance = p.Balance, BuyRate = p.BuyRate, SaleRate = p.SaleRate, IsActive = p.IsActive, TrackExpiry = p.TrackExpiry
        };
    }

    private void EditName(int id, string name, bool _) { CloseEditors(); nameEditorId = id; nameEditorValue = name; }
    private void EditSupplier(SupplierStore s) { CloseEditors(); supplierEditor = new SupplierStore { ID = s.ID, Name = s.Name, Contact = s.Contact, Address = s.Address, Amount = s.Amount, TransDate = s.TransDate }; }
    private void EditLocation(StoreLocation l) { CloseEditors(); locationEditor = new StoreLocation { ID = l.ID, Name = l.Name, IsCentral = l.IsCentral, IsActive = l.IsActive, SortOrder = l.SortOrder }; }
    private void EditDepartment(StoreDepartment d) { CloseEditors(); departmentEditor = new StoreDepartment { ID = d.ID, Name = d.Name, IsActive = d.IsActive }; }

    private async Task SaveItemAsync()
    {
        if (itemEditor == null) return;
        var e = itemEditor;
        e.Name = (e.Name ?? "").Trim();
        e.Unit = (e.Unit ?? "").Trim();
        if (e.Name.Length < 2 || e.Unit.Length == 0 || e.CategoryID <= 0) { Fail(I18n.T("Item name, unit and category are required.")); return; }
        if (Lookups.Products.Any(p => p.ID != e.ID && string.Equals(p.Name, e.Name, StringComparison.OrdinalIgnoreCase))) { Fail(I18n.T("An item with this name already exists.")); return; }
        if (e.ReOrderLevel < 0 || e.BuyRate < 0 || e.SaleRate < 0) { Fail(I18n.T("Values cannot be negative.")); return; }
        IsBusy = true;
        try
        {
            int id;
            await using (var db = await DbFactory.CreateDbContextAsync())
            {
                if (e.ID == 0)
                {
                    var entity = new StoreProduct
                    {
                        Name = e.Name, Unit = e.Unit, CategoryID = e.CategoryID, Supplier = e.Supplier, ReOrderLevel = e.ReOrderLevel, BuyRate = e.BuyRate,
                        SaleRate = e.SaleRate, IsActive = e.IsActive, TrackExpiry = e.TrackExpiry, Balance = 0, EnteredBy = CurrentUserId, TransDate = DateTime.Now
                    };
                    db.StoreProducts.Add(entity);
                    await db.SaveChangesAsync();
                    id = entity.ID;
                }
                else
                {
                    var entity = await db.StoreProducts.FirstAsync(p => p.ID == e.ID);
                    entity.Name = e.Name; entity.Unit = e.Unit; entity.CategoryID = e.CategoryID; entity.Supplier = e.Supplier; entity.ReOrderLevel = e.ReOrderLevel;
                    entity.BuyRate = e.BuyRate; entity.SaleRate = e.SaleRate; entity.IsActive = e.IsActive; entity.TrackExpiry = e.TrackExpiry;
                    await db.SaveChangesAsync();
                    id = entity.ID;
                }
            }
            if (e.ID == 0 && openingQty > 0)
                await Inventory.OpeningAsync(id, openingLocationId, openingQty, e.BuyRate, openingBatch, openingExpiry, CurrentUserId);
            await ReloadLookupsAsync(includeInactive: true);
            var fresh = Lookups.Products.FirstOrDefault(p => p.ID == id);
            if (fresh != null) EditItem(fresh);
            Success(I18n.IsBangla ? $"আইটেম \"{e.Name}\" সংরক্ষিত হয়েছে।" : $"Item \"{e.Name}\" saved.");
        }
        catch (Exception ex) { Fail(RootMessage(ex)); }
        finally { IsBusy = false; }
    }

    private async Task SaveCategoryAsync()
    {
        var name = nameEditorValue.Trim();
        if (name.Length < 2) { Fail(I18n.T("Enter a category name.")); return; }
        if (Lookups.Categories.Any(c => c.ID != nameEditorId && string.Equals(c.Name, name, StringComparison.OrdinalIgnoreCase))) { Fail(I18n.T("This category already exists.")); return; }
        await SaveAsync(async db =>
        {
            if (nameEditorId == 0) db.StoreProductCategories.Add(new StoreProductCategory { Name = name });
            else (await db.StoreProductCategories.FirstAsync(c => c.ID == nameEditorId)).Name = name;
        }, () => nameEditorId = null);
    }

    private async Task SaveSupplierAsync()
    {
        var s = supplierEditor!;
        s.Name = (s.Name ?? "").Trim();
        if (s.Name.Length < 2) { Fail(I18n.T("Enter the supplier name.")); return; }
        await SaveAsync(async db =>
        {
            if (s.ID == 0) db.StoreSuppliers.Add(new SupplierStore { Name = s.Name, Contact = s.Contact?.Trim(), Address = s.Address?.Trim(), Amount = 0, TransDate = DateTime.Now });
            else
            {
                var entity = await db.StoreSuppliers.FirstAsync(x => x.ID == s.ID);
                entity.Name = s.Name; entity.Contact = s.Contact?.Trim(); entity.Address = s.Address?.Trim();
            }
        }, () => supplierEditor = null);
    }

    private async Task SaveLocationAsync()
    {
        var l = locationEditor!;
        l.Name = (l.Name ?? "").Trim();
        if (l.Name.Length < 2) { Fail(I18n.T("Enter the store name.")); return; }
        if (!l.IsActive && l.ID > 0 && Lookups.Stock.Any(kv => kv.Key.Location == l.ID)) { Fail(I18n.T("This store still has stock. Transfer it out before deactivating.")); return; }
        await SaveAsync(async db =>
        {
            if (l.IsCentral) await db.StoreLocations.Where(x => x.ID != l.ID && x.IsCentral).ExecuteUpdateAsync(x => x.SetProperty(p => p.IsCentral, false));
            if (l.ID == 0) db.StoreLocations.Add(new StoreLocation { Name = l.Name, IsCentral = l.IsCentral, IsActive = l.IsActive, SortOrder = l.SortOrder });
            else
            {
                var entity = await db.StoreLocations.FirstAsync(x => x.ID == l.ID);
                entity.Name = l.Name; entity.IsCentral = l.IsCentral; entity.IsActive = l.IsActive; entity.SortOrder = l.SortOrder;
            }
        }, () => locationEditor = null);
    }

    private async Task SaveDepartmentAsync()
    {
        var d = departmentEditor!;
        d.Name = (d.Name ?? "").Trim();
        if (d.Name.Length < 2) { Fail(I18n.T("Enter the department name.")); return; }
        if (Lookups.Departments.Any(x => x.ID != d.ID && string.Equals(x.Name, d.Name, StringComparison.OrdinalIgnoreCase))) { Fail(I18n.T("This department already exists.")); return; }
        await SaveAsync(async db =>
        {
            if (d.ID == 0) db.StoreDepartments.Add(new StoreDepartment { Name = d.Name, IsActive = d.IsActive });
            else
            {
                var entity = await db.StoreDepartments.FirstAsync(x => x.ID == d.ID);
                entity.Name = d.Name; entity.IsActive = d.IsActive;
            }
        }, () => departmentEditor = null);
    }

    private async Task SaveAsync(Func<HpmDbContext, Task> change, Action close)
    {
        IsBusy = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await change(db);
            await db.SaveChangesAsync();
            await ReloadLookupsAsync(includeInactive: true);
            close();
            Success(I18n.T("Saved."));
        }
        catch (Exception ex) { Fail(RootMessage(ex)); }
        finally { IsBusy = false; }
    }
}
