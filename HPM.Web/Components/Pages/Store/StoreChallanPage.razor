@page "/store/challan"
@attribute [Authorize(Roles = RoleNames.Administrator)]
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject IBarcodeQrService BarcodeQr
@implements IDisposable
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using HPM.Web.Components.Common
@using HPM.Web.Data.Entities
@using HPM.Web.Services

<PageTitle>@I18n.T("Hospital Store Stock Receiving Challan") | @Branding.HospitalName</PageTitle>

<div class="canteen-classic-fit">
    <!-- Top Action & Status Bar -->
    <div class="canteen-classic-topbar">
        <div class="tickets-top-left">
            <h1 class="tickets-page-title">
                <span>📦</span>
                <span>@I18n.T("General Store Stock Receiving Challan", "Hospital Store Stock Receiving Challan")</span>
            </h1>
            <span class="tickets-count-pill">
                @challans.Count @I18n.T("Challans Recorded", "Challans Recorded")
            </span>
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <span class="tickets-inline-alert @messageClass" title="@message">
                    @(messageClass == "success" ? "✓" : "⚠") @message
                </span>
            }
        </div>

        <div class="tickets-top-actions">
            <a href="/store/products" class="btn btn-ghost tickets-btn" style="text-decoration:none;" title="@I18n.T("Manage Store Products & Inventory")">
                📋 @I18n.T("Store Products", "Store Products") (@products.Count)
            </a>
            <button type="button" class="btn btn-secondary tickets-btn" @onclick="ResetForm" title="@I18n.T("New Challan")">
                + @I18n.T("New Challan", "New Challan")
            </button>
        </div>
    </div>

    <!-- Main Workspace Grid: Left Challan Form, Right Recent Challan List -->
    <div class="canteen-classic-workspace">
        <!-- Left Panel: Challan Editor Card -->
        <div class="canteen-form-card">
            <div class="canteen-card-header">
                <h2>@(editor.ID == 0 ? I18n.T("Receive Inward Stock Challan", "Receive Inward Stock Challan") : $"{I18n.T("Challan", "Challan")} #{editor.ID}")</h2>
                <span class="canteen-badge">
                    @(editor.ID == 0 ? "STORE INWARD" : $"CHALLAN #{editor.ID}")
                </span>
            </div>

            <EditForm Model="editor" OnValidSubmit="SaveChallanAsync" class="canteen-form-wrapper">
                <DataAnnotationsValidator />

                <div class="canteen-form-body">
                    <!-- Challan Header Details (3-column) -->
                    <div class="billing-demographics-grid" style="grid-template-columns: 1.2fr 1fr 1.2fr;">
                        <label>
                            <span>@I18n.T("Supplier / Vendor", "Supplier")<span class="req">*</span></span>
                            <select class="classic-input tickets-select" @bind="editor.Supplier" disabled="@(editor.ID > 0)">
                                <option value="0">-- @I18n.T("Select Supplier", "Select Supplier") --</option>
                                @foreach (var s in suppliers)
                                {
                                    <option value="@s.ID">@s.Name</option>
                                }
                            </select>
                        </label>
                        <label>
                            <span>@I18n.T("Invoice / Challan No", "Invoice / Challan No")<span class="req">*</span></span>
                            <InputText class="classic-input" @bind-Value="editor.InvoiceNo" placeholder="INV-STORE-001" disabled="@(editor.ID > 0)" />
                        </label>
                        <label>
                            <span>@I18n.T("Invoice Date", "Invoice Date")</span>
                            <InputDate class="classic-input" @bind-Value="editor.InvoiceDate" disabled="@(editor.ID > 0)" />
                        </label>
                    </div>

                    @if (editor.ID == 0)
                    {
                        <!-- Line Editor Bar -->
                        <div class="billing-line-editor canteen-line-editor" style="margin-top: 10px;">
                            <label style="flex: 2; min-width: 200px;">
                                <span>@I18n.T("Select Store Item / Consumable", "Select Store Item")</span>
                                <select class="classic-input tickets-select" value="@lineProductId" @onchange="ProductChanged">
                                    <option value="0">-- @I18n.T("Select Product", "Select Product") --</option>
                                    @foreach (var p in products)
                                    {
                                        <option value="@p.ID">@p.Name (@p.Unit) — @I18n.T("Current Stock", "Current Stock"): @p.Balance</option>
                                    }
                                </select>
                            </label>
                            <label style="width: 100px;">
                                <span>@I18n.T("Buy Rate", "Buy Rate") (@I18n.CurrencySymbol)</span>
                                <input type="number" step="0.01" class="classic-input bold-number" @bind="lineBuyRate" />
                            </label>
                            <label style="width: 90px;">
                                <span>@I18n.T("Quantity", "Quantity")</span>
                                <input type="number" step="1" min="1" class="classic-input bold-number" @bind="lineQuantity" />
                            </label>
                            <label style="width: 110px;">
                                <span>@I18n.T("Total", "Total")</span>
                                <input type="text" class="classic-input bold-number" readonly value="@I18n.FormatCurrency(LineItemTotal)" />
                            </label>
                            <div class="canteen-line-btn-wrap" style="align-self: flex-end;">
                                <button type="button" class="btn btn-secondary tickets-btn" @onclick="AddLineItem" disabled="@(lineProductId <= 0 || lineQuantity <= 0)">
                                    + @I18n.T("Add Line", "Add")
                                </button>
                            </div>
                        </div>
                    }

                    <!-- Items Table -->
                    <div class="billing-table-container" style="margin-top: 12px; min-height: 180px;">
                        <table class="tickets-table billing-table">
                            <thead>
                                <tr>
                                    <th style="width: 36px;">#</th>
                                    <th>@I18n.T("Store Product Name", "Product Name")</th>
                                    <th>@I18n.T("Unit", "Unit")</th>
                                    <th class="num">@I18n.T("Buy Rate", "Buy Rate")</th>
                                    <th class="num">@I18n.T("Quantity", "Quantity")</th>
                                    <th class="num">@I18n.T("Line Total", "Total")</th>
                                    <th style="width: 40px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (lineItems.Count == 0)
                                {
                                    <tr>
                                        <td colspan="7" class="text-center" style="padding: 24px; color: #94a3b8;">
                                            @I18n.T("No items added yet. Select products above to receive inward stock.", "No items added yet.")
                                        </td>
                                    </tr>
                                }
                                @for (int i = 0; i < lineItems.Count; i++)
                                {
                                    var item = lineItems[i];
                                    var idx = i;
                                    var pName = products.FirstOrDefault(p => p.ID == item.ProductID)?.Name ?? $"Item #{item.ProductID}";
                                    var pUnit = products.FirstOrDefault(p => p.ID == item.ProductID)?.Unit ?? "Pcs";
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td><b>@pName</b></td>
                                        <td><span class="badge" style="background:#f1f5f9; color:#475569;">@pUnit</span></td>
                                        <td class="num">@I18n.FormatCurrency(item.BuyRate)</td>
                                        <td class="num"><b>@item.Quantity.ToString("0.##")</b></td>
                                        <td class="num"><b>@I18n.FormatCurrency(item.Total)</b></td>
                                        <td class="text-center">
                                            @if (editor.ID == 0)
                                            {
                                                <button type="button" class="tickets-icon-action" style="color: #ef4444;" title="@I18n.T("Remove")" @onclick="() => RemoveLineItem(idx)">✕</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Challan Summary Footer -->
                    <div class="billing-summary-grid" style="grid-template-columns: 2fr 1fr; margin-top: 12px; gap: 16px;">
                        <div style="display:flex; flex-direction:column; justify-content:center; gap:4px;">
                            <span style="font-size:12px; color:#64748b;">@I18n.T("Total In Words", "Total In Words"):</span>
                            <span style="font-size:13px; font-weight:600; color:#1e293b;">@NetPayableInWords</span>
                        </div>
                        <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:6px; padding:10px 14px; text-align:right;">
                            <span style="font-size:12px; color:#64748b; font-weight:600;">@I18n.T("NET TOTAL", "Net Total")</span>
                            <div style="font-size:22px; font-weight:800; color:#0f172a;">
                                @I18n.FormatCurrency(editor.Total)
                            </div>
                        </div>
                    </div>
                </div>

                <div class="results-form-footer">
                    <div>
                        @if (editor.ID > 0)
                        {
                            <span class="badge" style="background:#dcfce7; color:#166534; font-weight:700; padding:6px 12px;">
                                ✓ @I18n.T("POSTED TO STOCK INVENTORY", "POSTED")
                            </span>
                        }
                    </div>
                    <div style="display:flex; gap:8px;">
                        <button type="button" class="btn btn-ghost tickets-btn" @onclick="ResetForm">
                            @I18n.T("Clear / New", "Clear")
                        </button>
                        @if (editor.ID > 0)
                        {
                            <button type="button" class="btn btn-secondary tickets-btn" @onclick="() => PrintChallanItem(editor)">
                                🖨️ @I18n.T("Print Challan Voucher", "Print")
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-primary tickets-btn" disabled="@(isSaving || lineItems.Count == 0)">
                                @(isSaving ? I18n.T("Posting...") : I18n.T("Save & Post Stock Challan", "Save & Post Challan"))
                            </button>
                        }
                    </div>
                </div>
            </EditForm>
        </div>

        <!-- Right Panel: Recent Challans Queue -->
        <div class="canteen-queue-card">
            <div class="canteen-queue-top">
                <div style="display:flex; align-items:center; gap:8px;">
                    <h2>@I18n.T("Recent Store Challans", "Recent Store Challans")</h2>
                </div>
                <span class="pill" style="font-size:11px; font-weight:700;">
                    @FilteredChallans.Count() @I18n.T("Challans", "Challans")
                </span>
            </div>

            <div class="tickets-scanner-bar">
                <div class="tickets-scanner-input-wrap">
                    <span class="tickets-scanner-icon"><SearchIcon /></span>
                    <input type="text"
                           class="classic-input tickets-scanner-input"
                           placeholder="@I18n.T("Search Invoice #, Challan #, or Supplier...", "Search Invoice #, Challan #, or Supplier...")"
                           @bind="searchQuery"
                           @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(searchQuery))
                    {
                        <button type="button" class="tickets-scanner-clear" @onclick="() => searchQuery = string.Empty">✕</button>
                    }
                </div>
            </div>

            <div class="billing-queue-list">
                @if (!FilteredChallans.Any())
                {
                    <div class="tickets-queue-empty">
                        <span style="font-size:2rem;">📦</span>
                        <span>@I18n.T("No store stock inward challans found.", "No store challans found.")</span>
                    </div>
                }
                @foreach (var ch in FilteredChallans)
                {
                    var suppName = suppliers.FirstOrDefault(s => s.ID == ch.Supplier)?.Name ?? $"Supplier #{ch.Supplier}";
                    <div class="billing-queue-item @(editor.ID == ch.ID ? "active" : "")" @onclick="() => SelectChallan(ch)">
                        <span class="billing-queue-serial">#@ch.ID</span>
                        <div class="billing-queue-info">
                            <span class="billing-queue-name">
                                @ch.InvoiceNo
                                <small class="canteen-type-tag">(@suppName)</small>
                            </span>
                            <span class="billing-queue-meta">
                                @ch.InvoiceDate.ToString("dd MMM yyyy") &bull; @ch.Items.Count @I18n.T("item(s)", "item(s)")
                            </span>
                        </div>
                        <div class="tickets-queue-badges">
                            <span class="billing-queue-amount">@(I18n.FormatCurrency(ch.Total))</span>
                        </div>
                        <div class="tickets-queue-actions" @onclick:stopPropagation="true">
                            <button type="button" class="tickets-icon-action" title="@I18n.T("View")" @onclick="() => SelectChallan(ch)">✏️</button>
                            <button type="button" class="tickets-icon-action" title="@I18n.T("Print")" @onclick="() => PrintChallanItem(ch)">🖨️</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Print Challan Document -->
<div id="store-challan-print" class="print-document">
    <div class="print-sheet">
        <PrintDocumentHeader Title="Hospital Store Stock Receiving Challan"
                             DocNo="@($"STR-CH-{editor.ID:0000}")"
                             DocNoLabel="Challan #"
                             BarcodeCode="@($"STR-CH-{editor.ID}")" />

        <div class="print-grid">
            <div><span>@I18n.T("Invoice No", "Invoice No"):</span> <b>@editor.InvoiceNo</b></div>
            <div><span>@I18n.T("Invoice Date", "Invoice Date"):</span> @editor.InvoiceDate.ToString("dd MMM yyyy")</div>
            <div><span>@I18n.T("Supplier Name", "Supplier"):</span> <b>@(suppliers.FirstOrDefault(s => s.ID == editor.Supplier)?.Name ?? "—")</b></div>
            <div><span>@I18n.T("Received Date", "Received Date"):</span> @editor.TransDate.ToString("dd MMM yyyy hh:mm tt")</div>
        </div>

        <table class="data-table" style="margin-top: 14px;">
            <thead>
                <tr>
                    <th>#</th>
                    <th>@I18n.T("Product Item Name", "Product Name")</th>
                    <th>@I18n.T("Unit", "Unit")</th>
                    <th class="num">@I18n.T("Buy Rate", "Buy Rate")</th>
                    <th class="num">@I18n.T("Quantity", "Quantity")</th>
                    <th class="num">@I18n.T("Total Amount", "Total")</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < lineItems.Count; i++)
                {
                    var item = lineItems[i];
                    var pName = products.FirstOrDefault(p => p.ID == item.ProductID)?.Name ?? $"Item #{item.ProductID}";
                    var pUnit = products.FirstOrDefault(p => p.ID == item.ProductID)?.Unit ?? "Pcs";
                    <tr>
                        <td>@(i + 1)</td>
                        <td><b>@pName</b></td>
                        <td>@pUnit</td>
                        <td class="num">@I18n.FormatCurrency(item.BuyRate)</td>
                        <td class="num">@item.Quantity.ToString("0.##")</td>
                        <td class="num"><b>@I18n.FormatCurrency(item.Total)</b></td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="5" class="text-right"><b>@I18n.T("Grand Total", "Grand Total"):</b></td>
                    <td class="num"><b>@I18n.FormatCurrency(editor.Total)</b></td>
                </tr>
            </tfoot>
        </table>

        <div style="margin-top: 10px; font-size: 13px;">
            <b>@I18n.T("In Words", "In Words"):</b> @NetPayableInWords
        </div>

        <div class="print-signatures" style="margin-top: 48px; display:flex; justify-content:space-between;">
            <div class="sig-line"><span>@I18n.T("Store Keeper / Received By")</span></div>
            <div class="sig-line"><span>@I18n.T("Checked By")</span></div>
            <div class="sig-line"><span>@I18n.T("Store Manager / Approved By")</span></div>
        </div>
    </div>
</div>

@code {
    private StoreChallan editor = new() { InvoiceDate = DateTime.Today, TransDate = DateTime.Now, IsPosted = true };
    private List<StoreChallanSub> lineItems = [];
    private List<StoreProduct> products = [];
    private List<SupplierStore> suppliers = [];
    private List<StoreChallan> challans = [];

    private int lineProductId = 0;
    private decimal lineBuyRate = 0;
    private decimal lineQuantity = 1;
    private decimal LineItemTotal => Math.Round(lineBuyRate * lineQuantity, 2);

    private string searchQuery = "";
    private string message = "";
    private string messageClass = "success";
    private bool isSaving = false;

    private string NetPayableInWords => ConvertAmountToWords(editor.Total);

    private IEnumerable<StoreChallan> FilteredChallans
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchQuery))
                return challans;

            var q = searchQuery.Trim().ToLowerInvariant();
            return challans.Where(c =>
                c.ID.ToString().Contains(q) ||
                c.InvoiceNo.ToLowerInvariant().Contains(q) ||
                (suppliers.FirstOrDefault(s => s.ID == c.Supplier)?.Name.ToLowerInvariant().Contains(q) ?? false)
            );
        }
    }

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        await LoadDataAsync();
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => I18n.OnLanguageChanged -= HandleLanguageChanged;

    private async Task LoadDataAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        products = await db.StoreProducts.AsNoTracking().OrderBy(p => p.Name).ToListAsync();
        suppliers = await db.StoreSuppliers.AsNoTracking().OrderBy(s => s.Name).ToListAsync();
        challans = await db.StoreChallans
            .Include(c => c.Items)
            .AsNoTracking()
            .OrderByDescending(c => c.ID)
            .Take(100)
            .ToListAsync();
    }

    private void ProductChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var pId))
        {
            lineProductId = pId;
            var prod = products.FirstOrDefault(p => p.ID == pId);
            if (prod != null)
            {
                lineBuyRate = prod.BuyRate;
            }
        }
        else
        {
            lineProductId = 0;
            lineBuyRate = 0;
        }
    }

    private void AddLineItem()
    {
        if (lineProductId <= 0 || lineQuantity <= 0) return;

        var existing = lineItems.FirstOrDefault(i => i.ProductID == lineProductId);
        if (existing != null)
        {
            existing.Quantity += lineQuantity;
            existing.BuyRate = lineBuyRate;
            existing.Total = Math.Round(existing.Quantity * existing.BuyRate, 2);
        }
        else
        {
            lineItems.Add(new StoreChallanSub
            {
                ProductID = lineProductId,
                SLNO = lineItems.Count + 1,
                BuyRate = lineBuyRate,
                Quantity = lineQuantity,
                Total = LineItemTotal
            });
        }

        RecalculateTotal();
        lineProductId = 0;
        lineBuyRate = 0;
        lineQuantity = 1;
    }

    private void RemoveLineItem(int index)
    {
        if (index >= 0 && index < lineItems.Count)
        {
            lineItems.RemoveAt(index);
            for (int i = 0; i < lineItems.Count; i++)
            {
                lineItems[i].SLNO = i + 1;
            }
            RecalculateTotal();
        }
    }

    private void RecalculateTotal()
    {
        editor.Total = lineItems.Sum(x => x.Total);
    }

    private async Task SaveChallanAsync()
    {
        if (editor.Supplier <= 0)
        {
            ShowMsg(I18n.IsBangla ? "দয়া করে সরবরাহকারী (Supplier) নির্বাচন করুন।" : "Please select a supplier.", "danger");
            return;
        }
        if (string.IsNullOrWhiteSpace(editor.InvoiceNo))
        {
            ShowMsg(I18n.IsBangla ? "চালান বা ইনভয়েস নম্বর প্রদান করুন।" : "Please provide Invoice / Challan number.", "danger");
            return;
        }
        if (lineItems.Count == 0)
        {
            ShowMsg(I18n.IsBangla ? "চালানে অন্তত একটি প্রোডাক্ট আইটেম যোগ করুন।" : "Please add at least one line item.", "danger");
            return;
        }

        isSaving = true;
        message = "";

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
            var uid = int.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var parsed) ? parsed : 1;

            editor.EnteredBy = uid;
            editor.TransDate = DateTime.Now;
            editor.IsPosted = true;
            editor.InvoiceNo = editor.InvoiceNo.Trim();
            RecalculateTotal();

            // Check if duplicate Invoice No for same supplier
            if (await db.StoreChallans.AnyAsync(c => c.Supplier == editor.Supplier && c.InvoiceNo == editor.InvoiceNo))
            {
                ShowMsg(I18n.IsBangla ? "এই সরবরাহকারীর একই ইনভয়েস নম্বর ইতিমধ্যে এন্ট্রি করা হয়েছে।" : "This invoice number already exists for this supplier.", "danger");
                isSaving = false;
                return;
            }

            db.StoreChallans.Add(editor);
            await db.SaveChangesAsync();

            // Add line items & update inventory balance
            foreach (var item in lineItems)
            {
                item.ChallanNo = editor.ID;
                db.StoreChallanItems.Add(item);

                var prod = await db.StoreProducts.FindAsync(item.ProductID);
                if (prod != null)
                {
                    prod.Balance += item.Quantity;
                    prod.BuyRate = item.BuyRate;
                }
            }

            await db.SaveChangesAsync();

            ShowMsg(I18n.IsBangla ? $"স্টোর চালান #{editor.ID} সফলভাবে সংরক্ষিত ও স্টক হালনাগাদ করা হয়েছে।" : $"Store Challan #{editor.ID} posted and inventory updated successfully.", "success");

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            ShowMsg($"Error saving challan: {ex.Message}", "danger");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void SelectChallan(StoreChallan ch)
    {
        editor = new StoreChallan
        {
            ID = ch.ID,
            Supplier = ch.Supplier,
            InvoiceNo = ch.InvoiceNo,
            InvoiceDate = ch.InvoiceDate,
            IsPosted = ch.IsPosted,
            Total = ch.Total,
            EnteredBy = ch.EnteredBy,
            TransDate = ch.TransDate
        };

        lineItems = ch.Items.Select(x => new StoreChallanSub
        {
            ID = x.ID,
            ChallanNo = x.ChallanNo,
            ProductID = x.ProductID,
            SLNO = x.SLNO,
            BuyRate = x.BuyRate,
            Quantity = x.Quantity,
            Total = x.Total
        }).ToList();

        message = "";
    }

    private async Task PrintChallanItem(StoreChallan ch)
    {
        SelectChallan(ch);
        await Task.Yield();
        await JS.InvokeVoidAsync("print");
    }

    private void ResetForm()
    {
        editor = new StoreChallan { InvoiceDate = DateTime.Today, TransDate = DateTime.Now, IsPosted = true };
        lineItems.Clear();
        lineProductId = 0;
        lineBuyRate = 0;
        lineQuantity = 1;
        message = "";
    }

    private void ShowMsg(string msg, string cls)
    {
        message = msg;
        messageClass = cls;
    }

    private static string ConvertAmountToWords(decimal amount)
    {
        if (amount <= 0) return "Zero Taka Only";
        long whole = (long)Math.Floor(amount);
        long paisa = (long)Math.Round((amount - whole) * 100);

        string words = NumberToWords(whole) + " Taka";
        if (paisa > 0)
            words += " and " + NumberToWords(paisa) + " Paisa";
        return words + " Only";
    }

    private static string NumberToWords(long number)
    {
        if (number == 0) return "Zero";
        if (number < 0) return "Minus " + NumberToWords(Math.Abs(number));

        string words = "";

        if ((number / 10000000) > 0)
        {
            words += NumberToWords(number / 10000000) + " Crore ";
            number %= 10000000;
        }

        if ((number / 100000) > 0)
        {
            words += NumberToWords(number / 100000) + " Lac ";
            number %= 100000;
        }

        if ((number / 1000) > 0)
        {
            words += NumberToWords(number / 1000) + " Thousand ";
            number %= 1000;
        }

        if ((number / 100) > 0)
        {
            words += NumberToWords(number / 100) + " Hundred ";
            number %= 100;
        }

        if (number > 0)
        {
            var units = new[] { "Zero", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Ten", "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen", "Sixteen", "Seventeen", "Eighteen", "Nineteen" };
            var tens = new[] { "Zero", "Ten", "Twenty", "Thirty", "Forty", "Fifty", "Sixty", "Seventy", "Eighty", "Ninety" };

            if (number < 20)
                words += units[number];
            else
            {
                words += tens[number / 10];
                if ((number % 10) > 0)
                    words += " " + units[number % 10];
            }
        }

        return words.Trim();
    }
}
