@page "/store/challan"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.StoreKeeper)]
@inherits StorePageBase

<PageTitle>@I18n.T("Goods Receive (GRN)") | @Branding.HospitalName</PageTitle>

<div class="pharmacy-classic-fit px-root">
    <div class="px-topbar">
        <div class="px-topbar-left"><h1 class="px-title">📥 @I18n.T("Goods Receive (GRN)")</h1></div>
        <div class="px-topbar-right">
            <div class="px-metric"><span>@I18n.T("This Month")</span><b>@recent.Count(x => x.TransDate >= MonthStart)</b></div>
            <div class="px-metric"><span>@I18n.T("Month Value")</span><b class="ok">@I18n.FormatCurrency(recent.Where(x => x.TransDate >= MonthStart).Sum(x => x.Total))</b></div>
            <button type="button" class="px-btn" @onclick="NewGrn">+ @I18n.T("New GRN")</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="px-alert @MessageClass"><span>@Message</span><button type="button" @onclick='() => Message = ""'>✕</button></div>
    }

    <div class="pharmacy-classic-workspace">
        <section class="px-card">
            @if (saved == null)
            {
                <header class="px-card-head"><div class="px-card-title"><h2>@I18n.T("Receive Stock from Supplier")</h2><span class="px-badge new">@I18n.T("NEW")</span></div></header>
                <div class="px-card-body">
                    <div class="px-panel px-form-grid four">
                        <label class="px-field">
                            <span>@I18n.T("Supplier") <i>*</i></span>
                            <select @bind="supplierId">
                                <option value="0">@I18n.T("Select supplier...")</option>
                                @foreach (var s in Lookups.Suppliers)
                                {
                                    <option value="@s.ID">@s.Name</option>
                                }
                            </select>
                        </label>
                        <label class="px-field">
                            <span>@I18n.T("Invoice / Challan No") <i>*</i></span>
                            <input @bind="invoiceNo" maxlength="20" />
                        </label>
                        <label class="px-field">
                            <span>@I18n.T("Invoice Date")</span>
                            <input type="date" @bind="invoiceDate" />
                        </label>
                        <label class="px-field">
                            <span>@I18n.T("Receive Into Store") <i>*</i></span>
                            <select @bind="locationId">
                                @foreach (var l in Lookups.Locations)
                                {
                                    <option value="@l.ID">@l.Name</option>
                                }
                            </select>
                        </label>
                        <label class="px-field span-all">
                            <span>@I18n.T("Note") <em>@I18n.T("optional")</em></span>
                            <input @bind="note" maxlength="300" />
                        </label>
                    </div>

                    <div class="px-field">
                        <span>@I18n.T("Add Item") <em>@I18n.T("items marked EXP need batch & expiry date")</em></span>
                        <StoreItemPicker @ref="picker" Items="@Lookups.PickItems(null)" OnPick="AddLine" Placeholder="@I18n.T("Search item received...")" />
                    </div>

                    <div class="px-cart">
                        <div class="px-cart-head" style="grid-template-columns: minmax(150px,1fr) 90px 100px 120px 130px 100px 32px;">
                            <div>@I18n.T("Item")</div><div class="c">@I18n.T("Qty")</div><div class="c">@I18n.T("Unit Rate")</div><div>@I18n.T("Batch No")</div><div>@I18n.T("Expiry")</div><div class="r">@I18n.T("Total")</div><div></div>
                        </div>
                        <div class="px-cart-rows">
                            @if (lines.Count == 0)
                            {
                                <div class="px-empty"><div class="px-empty-icon">📥</div><div>@I18n.T("No items yet")</div><small>@I18n.T("Search the received items and enter quantity, rate, batch and expiry.")</small></div>
                            }
                            @for (var i = 0; i < lines.Count; i++)
                            {
                                var line = lines[i];
                                var idx = i;
                                var missingExpiry = line.TrackExpiry && line.ExpireDate == null;
                                <div class="px-cart-row @(missingExpiry ? "warn-row" : "")" style="grid-template-columns: minmax(150px,1fr) 90px 100px 120px 130px 100px 32px;">
                                    <div class="px-cart-name stack"><b>@Lookups.ProductName(line.ProductId)</b><small>@Lookups.ProductUnit(line.ProductId) @(line.TrackExpiry ? "· EXP" : "")</small></div>
                                    <div class="c"><input type="number" min="0" class="px-qty-input" @bind="line.Qty" /></div>
                                    <div class="c"><input type="number" min="0" step="0.01" class="px-qty-input" @bind="line.Rate" /></div>
                                    <div><input class="px-cell-input" @bind="line.BatchNo" maxlength="50" placeholder="@I18n.T("Batch")" /></div>
                                    <div><input type="date" class="px-cell-input @(missingExpiry ? "invalid" : "")" @bind="line.ExpireDate" /></div>
                                    <div class="r strong">@I18n.FormatCurrency(line.Qty * line.Rate)</div>
                                    <div class="c"><button type="button" class="px-del" @onclick="() => lines.RemoveAt(idx)">✕</button></div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <footer class="px-card-foot">
                    <span class="px-print-fmt">@lines.Count @I18n.T("item(s)") · <b>@I18n.FormatCurrency(lines.Sum(x => x.Qty * x.Rate))</b></span>
                    <div class="px-foot-actions">
                        <button type="button" class="px-btn" disabled="@(!CanSave)" @onclick="() => SaveAsync(false)">@I18n.T("Save Only")</button>
                        <button type="button" class="px-btn primary lg" disabled="@(!CanSave)" @onclick="() => SaveAsync(true)">@(IsBusy ? I18n.T("Saving…") : $"🖨 {I18n.T("Receive & Print")}")</button>
                    </div>
                </footer>
            }
            else
            {
                <header class="px-card-head">
                    <div class="px-card-title"><h2>GRN #@saved.ID</h2><span class="px-badge paid">@I18n.T("RECEIVED")</span></div>
                    <button type="button" class="px-btn" @onclick='() => PrintAsync("store-grn-print", $"GRN-{saved.ID}")'>🖨 @I18n.T("Print")</button>
                </header>
                <div class="px-card-body">
                    <div class="px-bill-strip">
                        <div><span>@I18n.T("Supplier")</span><b>@Lookups.SupplierName(saved.Supplier)</b></div>
                        <div><span>@I18n.T("Invoice")</span><b>@saved.InvoiceNo (@saved.InvoiceDate.ToString("dd MMM yy"))</b></div>
                        <div><span>@I18n.T("Store")</span><b>@Lookups.LocationName(saved.LocationID)</b></div>
                        <div><span>@I18n.T("Received")</span><b>@saved.TransDate.ToString("dd MMM yyyy, hh:mm tt")</b></div>
                        <div><span>@I18n.T("Total")</span><b>@I18n.FormatCurrency(saved.Total)</b></div>
                    </div>
                    <div class="px-cart">
                        <div class="px-cart-head" style="grid-template-columns: 30px minmax(150px,1fr) 110px 90px 80px 90px 100px;">
                            <div>#</div><div>@I18n.T("Item")</div><div>@I18n.T("Batch")</div><div>@I18n.T("Expiry")</div><div class="r">@I18n.T("Qty")</div><div class="r">@I18n.T("Rate")</div><div class="r">@I18n.T("Total")</div>
                        </div>
                        <div class="px-cart-rows">
                            @foreach (var it in saved.Items.OrderBy(x => x.SLNO))
                            {
                                <div class="px-cart-row" style="grid-template-columns: 30px minmax(150px,1fr) 110px 90px 80px 90px 100px;">
                                    <div class="muted">@it.SLNO</div>
                                    <div class="px-cart-name"><b>@Lookups.ProductName(it.ProductID)</b><small>@Lookups.ProductUnit(it.ProductID)</small></div>
                                    <div class="muted">@(it.BatchNo ?? "—")</div>
                                    <div class="muted">@(it.ExpireDate?.ToString("MMM yy") ?? "—")</div>
                                    <div class="r strong">@it.Quantity.ToString("0.##")</div>
                                    <div class="r">@I18n.FormatCurrency(it.BuyRate)</div>
                                    <div class="r">@I18n.FormatCurrency(it.Total)</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <footer class="px-card-foot">
                    <span></span>
                    <div class="px-foot-actions"><button type="button" class="px-btn primary lg" @onclick="NewGrn">+ @I18n.T("New GRN")</button></div>
                </footer>
            }
        </section>

        <aside class="px-card">
            <header class="px-card-head stack">
                <h2 style="margin:0; font-size:13.5px; font-weight:800;">@I18n.T("Recent GRNs")</h2>
                <div class="px-search-box sm">
                    <span class="px-search-icon">🔍</span>
                    <input type="text" placeholder="@I18n.T("GRN #, invoice, supplier...")" @bind="search" @bind:event="oninput" autocomplete="off" />
                </div>
            </header>
            <div class="px-queue">
                @{ var tokens = SearchText.Tokenize(search); var list = recent.Where(x => SearchText.MatchesAll(tokens, x.ID.ToString(), x.InvoiceNo, Lookups.SupplierName(x.Supplier))).ToList(); }
                @if (list.Count == 0)
                {
                    <div class="px-empty sm">@I18n.T("No GRN found.")</div>
                }
                @foreach (var x in list)
                {
                    <button type="button" class="px-q-item @(saved?.ID == x.ID ? "active" : "")" @onclick="() => OpenAsync(x.ID)">
                        <span class="px-q-id">GRN-@x.ID</span>
                        <span class="px-q-info">
                            <span class="px-q-name">@SearchText.Highlight(Lookups.SupplierName(x.Supplier), tokens)</span>
                            <span class="px-q-meta">@I18n.T("Inv") @SearchText.Highlight(x.InvoiceNo, tokens) · @x.TransDate.ToString("dd MMM yy") · @Lookups.LocationName(x.LocationID)</span>
                        </span>
                        <span class="px-q-amt">@I18n.FormatCurrency(x.Total)</span>
                    </button>
                }
            </div>
        </aside>
    </div>
</div>

@if (saved != null)
{
    <div id="store-grn-print" class="print-sheet panel print-document print-a4-sheet pharm-print-only">
        <PrintDocumentHeader Title="@I18n.T("Goods Receive Note (GRN)")" Subtitle="@Lookups.LocationName(saved.LocationID)" DocumentNo="@($"GRN-{saved.ID}")" BarcodeCode="@($"GRN-{saved.ID}")" />
        <div class="print-grid">
            <div><span>@I18n.T("Supplier"):</span> <b>@Lookups.SupplierName(saved.Supplier)</b></div>
            <div><span>@I18n.T("Invoice"):</span> <b>@saved.InvoiceNo (@saved.InvoiceDate.ToString("dd MMM yyyy"))</b></div>
            <div><span>@I18n.T("Received On"):</span> <b>@saved.TransDate.ToString("dd MMM yyyy hh:mm tt")</b></div>
            <div><span>@I18n.T("Note"):</span> <b>@(saved.Note ?? "—")</b></div>
        </div>
        <table class="data-table">
            <thead><tr><th>#</th><th>@I18n.T("Item")</th><th>@I18n.T("Batch")</th><th>@I18n.T("Expiry")</th><th class="num">@I18n.T("Qty")</th><th>@I18n.T("Unit")</th><th class="num">@I18n.T("Rate")</th><th class="num">@I18n.T("Total")</th></tr></thead>
            <tbody>
                @foreach (var it in saved.Items.OrderBy(x => x.SLNO))
                {
                    <tr><td>@it.SLNO</td><td><b>@Lookups.ProductName(it.ProductID)</b></td><td>@(it.BatchNo ?? "—")</td><td>@(it.ExpireDate?.ToString("MMM yyyy") ?? "—")</td><td class="num">@it.Quantity.ToString("0.##")</td><td>@Lookups.ProductUnit(it.ProductID)</td><td class="num">@I18n.FormatCurrency(it.BuyRate)</td><td class="num">@I18n.FormatCurrency(it.Total)</td></tr>
                }
            </tbody>
        </table>
        <div class="print-total"><div class="grand"><span>@I18n.T("Grand Total")</span><b>@I18n.FormatCurrency(saved.Total)</b></div></div>
        <PrintDocumentFooter SignTitle1="@I18n.T("Store Keeper / Received By")" SignTitle2="@I18n.T("Checked By")" SignTitle3="@I18n.T("Store Manager / Approved By")" />
    </div>
}

@code {
    private StoreItemPicker? picker;
    private List<StoreChallan> recent = [];
    private StoreChallan? saved;
    private List<GrnLine> lines = [];
    private int supplierId;
    private string invoiceNo = "";
    private DateTime invoiceDate = DateTime.Today;
    private int locationId;
    private string note = "";
    private string search = "";

    private static DateTime MonthStart => new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private bool CanSave => !IsBusy && supplierId > 0 && !string.IsNullOrWhiteSpace(invoiceNo) && lines.Any(x => x.Qty > 0) && lines.All(x => !x.TrackExpiry || x.Qty <= 0 || x.ExpireDate != null);

    protected override async Task OnStoreInitializedAsync()
    {
        locationId = Lookups.DefaultLocationId;
        await LoadRecentAsync();
    }

    private async Task LoadRecentAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var since = DateTime.Today.AddDays(-120);
        recent = await db.StoreChallans.AsNoTracking().Where(x => x.TransDate >= since).OrderByDescending(x => x.ID).Take(300).ToListAsync();
    }

    private void NewGrn()
    {
        saved = null;
        lines = [];
        invoiceNo = "";
        invoiceDate = DateTime.Today;
        note = "";
        Message = "";
    }

    private async Task AddLine(StorePickItem item)
    {
        lines.Add(new GrnLine { ProductId = item.Id, Qty = 1, Rate = item.BuyRate, TrackExpiry = item.TrackExpiry });
        Message = "";
        if (picker != null) await picker.FocusAsync();
    }

    private async Task SaveAsync(bool print)
    {
        IsBusy = true;
        try
        {
            var challan = await Inventory.ReceiveAsync(supplierId, invoiceNo, invoiceDate, locationId, note,
                lines.Select(x => new StoreGrnLineInput(x.ProductId, x.Qty, x.Rate, x.BatchNo, x.ExpireDate)).ToList(), CurrentUserId);
            await ReloadLookupsAsync();
            await LoadRecentAsync();
            await OpenAsync(challan.ID);
            Success(I18n.IsBangla ? $"GRN #{challan.ID} সংরক্ষিত, স্টক বেড়েছে।" : $"GRN #{challan.ID} saved; stock added to {Lookups.LocationName(challan.LocationID)}.");
            if (print)
            {
                StateHasChanged();
                await Task.Yield();
                await PrintAsync("store-grn-print", $"GRN-{challan.ID}");
            }
        }
        catch (Exception ex) { Fail(RootMessage(ex)); }
        finally { IsBusy = false; }
    }

    private async Task OpenAsync(long id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        saved = await db.StoreChallans.AsNoTracking().Include(x => x.Items).FirstOrDefaultAsync(x => x.ID == id);
        lines = [];
        Message = "";
    }

    private sealed class GrnLine
    {
        public int ProductId { get; init; }
        public decimal Qty { get; set; }
        public decimal Rate { get; set; }
        public string? BatchNo { get; set; }
        public DateTime? ExpireDate { get; set; }
        public bool TrackExpiry { get; init; }
    }
}
