@page "/diagnostic/cash-memo-return"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.Cashier + "," + RoleNames.Reception)]
@rendermode InteractiveServer
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@implements IDisposable
@using System.Data
@using System.Security.Claims

<PageTitle>@I18n.T("Cash Memo Return") | @Branding.HospitalName</PageTitle>

<div class="diagnostic-classic-fit">
    <!-- Compact Top Action & Status Bar -->
    <div class="diagnostic-classic-topbar">
        <div class="tickets-top-left">
            <h1 class="tickets-page-title">
                <span>↩️</span>
                <span>@I18n.T("Cash Memo Return & Refund")</span>
            </h1>
            <span class="tickets-count-pill">
                @recent.Count @I18n.T("Returns")
            </span>
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <span class="tickets-inline-alert @messageClass" title="@message">
                    @(messageClass.Contains("danger") ? "⚠" : "✓") @message
                </span>
            }
        </div>

        <DiagnosticNavTabs />

        <div class="tickets-top-actions">
            <button type="button" class="btn btn-secondary tickets-btn" @onclick="Reset" title="@I18n.T("New Return")">
                + @I18n.T("New Return")
            </button>
        </div>
    </div>

    <!-- Main Balanced Workspace Grid: Left Return Form, Right Recent Returns -->
    <div class="diagnostic-classic-workspace">
        <!-- Left Panel: Return Form Card -->
        <div class="diagnostic-form-card" style="flex: 1.15;">
            <div class="diagnostic-card-header">
                <h2>@(savedReturn is null ? I18n.T("Find Original Investigation Memo") : $"{I18n.T("Return Voucher")} #{savedReturn.ID}")</h2>
                @if (savedReturn is not null)
                {
                    <span class="diagnostic-badge" style="background:#dcfce7; color:#166534;">
                        ✓ @I18n.T("POSTED")
                    </span>
                }
            </div>

            <div class="diagnostic-form-body" style="overflow-y:auto; padding:10px 14px;">
                @if (savedReturn is null)
                {
                    <div class="return-memo-search">
                        <label class="return-memo-search-field">
                            <span style="font-size:11.5px; font-weight:700; color:#334155;">@I18n.T("Memo / Patient Search") <span class="required-mark">*</span></span>
                            <input class="classic-input return-memo-search-input" @bind="memoLookup" @bind:event="oninput" @bind:after="QueueMemoSuggestionsAsync" @onkeydown="HandleLookupKeyDown" autocomplete="off" placeholder="@I18n.T("Memo ID, Patient ID, mobile or patient name")" />
                            @if (searchingMemos || memoMatches.Count > 0)
                            {
                                <div class="return-memo-suggestions">
                                    @if (searchingMemos)
                                    {
                                        <div class="return-memo-searching">@I18n.T("Searching...")</div>
                                    }
                                    else
                                    {
                                        @foreach (var match in memoMatches)
                                        {
                                            <button type="button" class="return-memo-suggestion" @onclick="() => LoadMemoByIdAsync(match.ID)">
                                                <strong>#@match.ID</strong>
                                                <span><b>@match.PatientName</b><small>@(match.PatientID ?? I18n.T("Walk-in")) · @(match.Contact ?? "—")</small></span>
                                                <span class="return-memo-suggestion-meta">@(match.PatientType == "2" ? $"IPD · {match.RegNo}" : "OPD")<small>@match.TransDate.ToString("dd MMM yy")</small></span>
                                            </button>
                                        }
                                    }
                                </div>
                            }
                        </label>
                        <button type="button" class="btn btn-primary return-memo-load" @onclick="FindMemoAsync">
                            <SearchIcon /> @I18n.T("Load Memo")
                        </button>
                    </div>
                }

                @if (memo is not null)
                {
                    <!-- Patient & Memo Summary Pills -->
                    <div style="display:flex; flex-wrap:wrap; gap:8px; margin-bottom:10px; background:#f0f9ff; border:1px solid #bae6fd; border-radius:8px; padding:8px 12px; font-size:11.5px;">
                        <span style="color:#0369a1;"><strong>@I18n.T("Memo"):</strong> #@memo.ID</span>
                        <span style="color:#0369a1;"><strong>@I18n.T("Patient"):</strong> @memo.PatientName (@(memo.PatientType == "2" ? $"IPD · {memo.RegNo}" : "OPD"))</span>
                        <span style="color:#0369a1;"><strong>@I18n.T("Date"):</strong> @memo.TransDate.ToString("dd MMM yyyy")</span>
                        <span style="color:#0369a1;"><strong>@I18n.T("Net Total"):</strong> @I18n.FormatCurrency(originalNet)</span>
                        @if (priorAdjustment > 0)
                        {
                            <span style="color:#b45309;"><strong>@I18n.T("Prior Adj"):</strong> @I18n.FormatCurrency(priorAdjustment)</span>
                        }
                    </div>

                    <!-- Items Return Table -->
                    <div class="diagnostic-table-wrap return-items-table-wrap">
                        <table class="classic-table return-items-table">
                            <thead>
                                <tr>
                                    <th style="width:36px; text-align:center;"></th>
                                    <th>@I18n.T("Investigation / Test") <span class="required-mark">*</span></th>
                                    <th class="num" style="width:65px;">@I18n.T("Sold")</th>
                                    <th class="num" style="width:75px;">@I18n.T("Remain")</th>
                                    <th class="num" style="width:80px;">@I18n.T("Return")</th>
                                    <th class="num" style="width:80px;">@I18n.T("Rate")</th>
                                    <th class="num" style="width:90px;">@I18n.T("Amount")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in lines)
                                {
                                    <tr style="@(line.Selected ? "background:#f0fdf4;" : "")">
                                        <td style="text-align:center;">
                                            <input class="return-item-check" type="checkbox" @bind="line.Selected" disabled="@(savedReturn is not null || line.Remaining <= 0)" aria-label="@I18n.T("Select investigation for return")" />
                                        </td>
                                        <td><b>@ServiceName(line.Item.TestID)</b></td>
                                        <td class="num">@line.Item.Quantity</td>
                                        <td class="num"><b>@line.Remaining</b></td>
                                        <td class="num">
                                            <input type="number" class="classic-input" @bind="line.Quantity" min="1" max="@line.Remaining" disabled="@(savedReturn is not null || !line.Selected)" style="width:60px; height:26px; text-align:right; padding:2px 4px;" />
                                        </td>
                                        <td class="num">@I18n.FormatCurrency(line.Item.Rate)</td>
                                        <td class="num"><b>@I18n.FormatCurrency(line.Selected ? line.Item.Rate * line.Quantity : 0)</b></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Reason & Financial Calculation Summary -->
                    <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px; margin-bottom:12px;">
                        <label style="margin:0; grid-column:span 2;">
                            <span style="font-size:11.5px; font-weight:700; color:#334155;">@I18n.T("Return Reason") <span class="required-mark">*</span></span>
                            <input class="classic-input" @bind="reason" maxlength="500" disabled="@(savedReturn is not null)" placeholder="@I18n.T("Enter specific reason for return / cancellation...")" style="height:30px;" />
                        </label>
                        @if (estimatedCashRefund > 0 || savedReturn?.RefundAmount > 0)
                        {
                            <label style="margin:0;">
                                <span style="font-size:11.5px; font-weight:700; color:#334155;">@I18n.T("Refund Method") <span class="required-mark">*</span></span>
                                <select class="classic-input" @bind="refundMethod" disabled="@(savedReturn is not null)" style="height:30px;">
                                    <option value="Cash">@I18n.T("Cash")</option>
                                </select>
                            </label>
                            <label style="margin:0;">
                                <span style="font-size:11.5px; font-weight:700; color:#334155;">@I18n.T("Refund Reference") @if (refundMethod != "Cash") { <span class="required-mark">*</span> }</span>
                                <input class="classic-input" @bind="refundReference" maxlength="100" disabled="@(savedReturn is not null)" placeholder="@I18n.T("Transaction / reference number")" style="height:30px;" />
                            </label>
                            <label style="margin:0; grid-column:span 2;">
                                <span style="font-size:11.5px; font-weight:700; color:#334155;">@I18n.T("Refund Received By") <span class="required-mark">*</span></span>
                                <input class="classic-input" @bind="refundReceivedBy" maxlength="100" disabled="@(savedReturn is not null)" placeholder="@I18n.T("Patient / attendant name")" style="height:30px;" />
                            </label>
                            @if (!canIssueCashRefund && savedReturn is null)
                            {
                                <div class="alert danger" style="grid-column:span 2; margin:0; padding:6px 10px; font-size:11px;">
                                    @I18n.T("Cash refunds require Cashier or Administrator authorization.")
                                </div>
                            }
                        }
                        <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:6px; padding:6px 10px; font-size:11.5px; display:flex; justify-content:space-between;">
                            <span style="color:#64748b;">@I18n.T("Bill Adjustment"):</span>
                            <strong style="color:#0f172a;">@I18n.FormatCurrency(estimatedAdjustment)</strong>
                        </div>
                        <div style="background:#f0fdf4; border:1px solid #bbf7d0; border-radius:6px; padding:6px 10px; font-size:11.5px; display:flex; justify-content:space-between;">
                            <span style="color:#166534; font-weight:700;">@I18n.T("Cash Refund"):</span>
                            <strong style="color:#15803d; font-size:13px;">@I18n.FormatCurrency(estimatedCashRefund)</strong>
                        </div>
                        @if (estimatedReceivableAdjustment > 0)
                        {
                            <div style="background:#fffbeb; border:1px solid #fef3c7; border-radius:6px; padding:6px 10px; font-size:11.5px; display:flex; justify-content:space-between; grid-column:span 2;">
                                <span style="color:#b45309;">@I18n.T("Due / IPD Adjustment"):</span>
                                <strong style="color:#b45309;">@I18n.FormatCurrency(estimatedReceivableAdjustment)</strong>
                            </div>
                        }
                    </div>

                    <!-- Post & Print Actions -->
                    <div class="return-action-bar">
                        @if (savedReturn is null)
                        {
                            <button class="btn btn-primary" @onclick="PostAsync" disabled="@(!CanPostReturn)" style="padding:6px 16px;">
                                @(saving ? I18n.T("Posting…") : "✓ " + I18n.T("Post Return & Refund"))
                            </button>
                        }
                        else
                        {
                            @if (savedReturn.Status == "Posted")
                            {
                                <button class="btn btn-secondary" @onclick="PrintAsync" style="padding:6px 16px;">
                                    🖨️ @I18n.T("Print Return Voucher")
                                </button>
                                @if (isAdministrator)
                                {
                                    <button class="btn" @onclick="OpenVoidReturnModal" disabled="@saving" style="padding:6px 16px; background:#dc2626; border-color:#b91c1c; color:#fff;">
                                        ⛔ @I18n.T("Void Return")
                                    </button>
                                }
                            }
                            else
                            {
                                <span class="badge" style="background:#fee2e2; color:#991b1b;">@I18n.T("VOIDED")</span>
                            }
                        }
                    </div>
                }
                else if (savedReturn is null && memoMatches.Count == 0)
                {
                    <div style="display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; margin-top:18px;">
                        <div style="padding:14px; border:1px solid #bae6fd; border-radius:10px; background:#f0f9ff;">
                            <div style="font-size:20px; margin-bottom:6px;">① 🔎</div>
                            <strong style="font-size:12px; color:#0c4a6e;">@I18n.T("Find the original memo")</strong>
                            <p style="margin:5px 0 0; font-size:10.5px; line-height:1.45; color:#475569;">@I18n.T("Search by memo, patient ID, mobile or name and select the correct bill.")</p>
                        </div>
                        <div style="padding:14px; border:1px solid #bbf7d0; border-radius:10px; background:#f0fdf4;">
                            <div style="font-size:20px; margin-bottom:6px;">② ✅</div>
                            <strong style="font-size:12px; color:#166534;">@I18n.T("Select tests and quantity")</strong>
                            <p style="margin:5px 0 0; font-size:10.5px; line-height:1.45; color:#475569;">@I18n.T("Choose only the tests being returned and enter a specific reason.")</p>
                        </div>
                        <div style="padding:14px; border:1px solid #fde68a; border-radius:10px; background:#fffbeb;">
                            <div style="font-size:20px; margin-bottom:6px;">③ 🧾</div>
                            <strong style="font-size:12px; color:#92400e;">@I18n.T("Review and post safely")</strong>
                            <p style="margin:5px 0 0; font-size:10.5px; line-height:1.45; color:#475569;">@I18n.T("Review the due adjustment and cash refund before final confirmation.")</p>
                        </div>
                    </div>
                    <div style="margin-top:12px; padding:9px 12px; border-left:4px solid #dc2626; border-radius:6px; background:#fff7ed; color:#9a3412; font-size:11px; line-height:1.45;">
                        <strong>⚠ @I18n.T("Safety checks"):</strong>
                        @I18n.T("Reported tests and final-billed IPD accounts cannot be returned. Cash refunds require Cashier or Administrator authorization.")
                    </div>
                }
            </div>
        </div>

        <!-- Right Panel: Recent Returns List -->
        <div class="diagnostic-queue-card" style="flex: 0.85;">
            <div class="diagnostic-card-header">
                <h2>@I18n.T("Recent Returns")</h2>
                <span class="diagnostic-badge">@recent.Count</span>
            </div>

            <div class="diagnostic-queue-body" style="overflow-y:auto; padding:8px;">
                <table class="classic-table" style="font-size:11px; width:100%;">
                    <thead>
                        <tr>
                            <th>@I18n.T("Ret #")</th>
                            <th>@I18n.T("Memo")</th>
                            <th>@I18n.T("Date")</th>
                            <th class="num">@I18n.T("Refund")</th>
                            <th style="width:45px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (recent.Count == 0)
                        {
                            <tr><td colspan="5" style="text-align:center; padding:20px; color:#94a3b8;">@I18n.T("No recent returns found.")</td></tr>
                        }
                        @foreach (var entry in recent)
                        {
                            <tr style="@(savedReturn?.ID == entry.ID ? "background:#e0f2fe; font-weight:700;" : "")">
                                <td><b>#@entry.ID</b> @if (entry.Status == "Cancelled") { <span class="badge" style="background:#fee2e2; color:#991b1b;">@I18n.T("VOID")</span> }</td>
                                <td>#@entry.MemoID</td>
                                <td>@entry.TransDate.ToString("dd MMM")</td>
                                <td class="num" style="color:#15803d; font-weight:700;">@I18n.FormatCurrency(entry.RefundAmount)</td>
                                <td style="text-align:right;">
                                    <button class="btn btn-ghost" style="padding:2px 6px; font-size:10px;" @onclick="() => OpenReturnAsync(entry.ID)" title="@I18n.T("View return")">
                                        👁️
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@if (showPostConfirmation && memo is not null)
{
    <div class="return-confirm-backdrop" role="presentation">
        <section class="return-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="return-confirm-title">
            <div class="return-confirm-header">
                <div class="return-confirm-icon">↩</div>
                <div>
                    <h3 id="return-confirm-title">@I18n.T("Confirm Return & Refund")</h3>
                    <p>@I18n.T("Review the information carefully before posting.")</p>
                </div>
                <button type="button" class="return-confirm-close" @onclick="ClosePostConfirmation" aria-label="@I18n.T("Cancel")">×</button>
            </div>

            <div class="return-confirm-body">
                <div class="return-confirm-memo">
                    <div><span>@I18n.T("Memo")</span><strong>#@memo.ID</strong></div>
                    <div><span>@I18n.T("Patient")</span><strong>@memo.PatientName</strong></div>
                    <div><span>@I18n.T("Reason")</span><strong>@reason</strong></div>
                </div>

                <div class="return-confirm-section-title">@I18n.T("Selected investigations")</div>
                <div class="return-confirm-items">
                    @foreach (var line in lines.Where(x => x.Selected))
                    {
                        <div class="return-confirm-item">
                            <span>@ServiceName(line.Item.TestID) <small>× @line.Quantity</small></span>
                            <strong>@I18n.FormatCurrency(line.Item.Rate * line.Quantity)</strong>
                        </div>
                    }
                </div>

                <div class="return-confirm-totals">
                    <div><span>@I18n.T("Bill Adjustment")</span><strong>@I18n.FormatCurrency(estimatedAdjustment)</strong></div>
                    @if (estimatedReceivableAdjustment > 0)
                    {
                        <div class="due"><span>@I18n.T("Due / IPD Adjustment")</span><strong>@I18n.FormatCurrency(estimatedReceivableAdjustment)</strong></div>
                    }
                    <div class="refund"><span>@I18n.T("Cash Refund")</span><strong>@I18n.FormatCurrency(estimatedCashRefund)</strong></div>
                </div>

                @if (estimatedCashRefund > 0)
                {
                    <div class="return-confirm-receiver">
                        <span>@I18n.T("Refund Received By")</span>
                        <strong>@refundReceivedBy</strong>
                    </div>
                }

                <div class="return-confirm-warning">
                    <span>!</span>
                    <p><strong>@I18n.T("Important"):</strong> @I18n.T("Posting will update the bill, accounts and diagnostic workflow. Verify the selected tests and amount before continuing.")</p>
                </div>
            </div>

            <div class="return-confirm-actions">
                <button type="button" class="btn btn-secondary" @onclick="ClosePostConfirmation">@I18n.T("Cancel")</button>
                <button type="button" class="btn btn-primary return-confirm-submit" @onclick="ConfirmPostAsync" disabled="@saving">
                    @(saving ? I18n.T("Posting…") : "✓ " + I18n.T("Confirm & Post Return"))
                </button>
            </div>
        </section>
    </div>
}

@if (showVoidConfirmation && savedReturn is not null && memo is not null)
{
    <div class="return-confirm-backdrop" role="presentation">
        <section class="return-confirm-modal void-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="void-confirm-title">
            <div class="return-confirm-header void-confirm-header">
                <div class="return-confirm-icon void-confirm-icon">!</div>
                <div>
                    <h3 id="void-confirm-title">@I18n.T("Void & Reverse Return")</h3>
                    <p>@I18n.T("This action reverses the posted return and its financial entries.")</p>
                </div>
                <button type="button" class="return-confirm-close" @onclick="CloseVoidReturnModal" aria-label="@I18n.T("Cancel")">×</button>
            </div>

            <div class="return-confirm-body">
                <div class="void-confirm-summary">
                    <div><span>@I18n.T("Return Voucher")</span><strong>#@savedReturn.ID</strong></div>
                    <div><span>@I18n.T("Original Memo")</span><strong>#@memo.ID</strong></div>
                    <div><span>@I18n.T("Bill Adjustment")</span><strong>@I18n.FormatCurrency(savedReturn.AdjustmentAmount)</strong></div>
                    <div><span>@I18n.T("Cash Refund")</span><strong>@I18n.FormatCurrency(savedReturn.RefundAmount)</strong></div>
                </div>

                <label class="void-reason-field">
                    <span>@I18n.T("Void Reason") <span class="required-mark">*</span></span>
                    <textarea class="classic-input" @bind="voidReason" @bind:event="oninput" maxlength="500" rows="3" autofocus placeholder="@I18n.T("Enter a clear reason for cancelling and reversing this return...")"></textarea>
                    <small>@I18n.T("This reason will be saved in the audit history.")</small>
                </label>

                <div class="return-confirm-warning void-confirm-warning">
                    <span>!</span>
                    <p><strong>@I18n.T("Important"):</strong> @I18n.T("The refund, accounting voucher and IPD adjustment will be reversed. Returned tests may become active again.")</p>
                </div>
            </div>

            <div class="return-confirm-actions">
                <button type="button" class="btn btn-secondary" @onclick="CloseVoidReturnModal">@I18n.T("Keep Return")</button>
                <button type="button" class="btn void-confirm-submit" @onclick="ConfirmVoidReturnAsync" disabled="@(saving || string.IsNullOrWhiteSpace(voidReason))">
                    @(saving ? I18n.T("Reversing…") : "⛔ " + I18n.T("Void & Reverse Return"))
                </button>
            </div>
        </section>
    </div>
}

@if (savedReturn is not null && memo is not null)
{
    <div id="diagnostic-return-print" class="print-sheet panel print-document" style="display:none;">
        <PrintDocumentHeader Title="Investigation Return / Refund Voucher" Subtitle="@Branding.LabHeaderDept" DocNo="@($"RET-{savedReturn.ID}")" DocNoLabel="Return #" BarcodeCode="@($"DRET-{savedReturn.ID}")" />
        <div class="print-grid">
            <div><span>@I18n.T("Original Memo"):</span> <b>#@memo.ID</b></div><div><span>@I18n.T("Patient Name"):</span> <b>@memo.PatientName</b></div>
            <div><span>@I18n.T("Patient Type"):</span> <b>@(memo.PatientType == "2" ? $"IPD · {memo.RegNo}" : "OPD")</b></div><div><span>@I18n.T("Return Date"):</span> <b>@savedReturn.TransDate.ToString("dd MMM yyyy hh:mm tt")</b></div>
        </div>
        <table class="data-table"><thead><tr><th>@I18n.T("Investigation / Test")</th><th class="num">@I18n.T("Qty")</th><th class="num">@I18n.T("Rate")</th><th class="num">@I18n.T("Amount")</th></tr></thead><tbody>
            @foreach (var line in lines.Where(x => x.Selected)) { <tr><td>@ServiceName(line.Item.TestID)</td><td class="num">@line.Quantity</td><td class="num">@I18n.FormatCurrency(line.Item.Rate)</td><td class="num">@I18n.FormatCurrency(line.Item.Rate * line.Quantity)</td></tr> }
        </tbody></table>
        <div class="print-total"><div><span>@I18n.T("Reason"):</span> <b>@savedReturn.Reason</b></div><div><span>@I18n.T("Refund Method"):</span> <b>@(savedReturn.RefundMethod ?? "—") @(string.IsNullOrWhiteSpace(savedReturn.RefundReference) ? "" : $"· {savedReturn.RefundReference}")</b></div><div><span>@I18n.T("Refund Received By"):</span> <b>@(savedReturn.RefundReceivedBy ?? "—")</b></div><div><span>@I18n.T("Due / IPD Adjustment"):</span> <b>@I18n.FormatCurrency(savedReturn.ReceivableAdjustment)</b></div><div class="grand"><span>@I18n.T("Cash Refund"):</span> <b>@I18n.FormatCurrency(savedReturn.RefundAmount)</b></div></div>
        <PrintDocumentFooter SignTitle1="Patient / Attendant" SignTitle2="Authorized By" SignTitle3="Cashier" />
    </div>
}

@code {
    private List<Service> services = [];
    private List<DiagnosticCashMemoReturn> recent = [];
    private List<CashMemoDInvestigation> memoMatches = [];
    private List<ReturnLine> lines = [];
    private CashMemoDInvestigation? memo;
    private DiagnosticCashMemoReturn? savedReturn;
    private string memoLookup = "";
    private string reason = "";
    private string message = "";
    private string messageClass = "success";
    private bool saving;
    private bool showPostConfirmation;
    private bool showVoidConfirmation;
    private bool searchingMemos;
    private CancellationTokenSource? memoSearchCts;
    private bool isAdministrator;
    private bool canIssueCashRefund;
    private string refundMethod = "Cash";
    private string refundReference = "";
    private string refundReceivedBy = "";
    private string voidReason = "";
    private decimal originalGross;
    private decimal originalNet;
    private decimal priorAdjustment;
    private decimal priorRefund;

    private decimal selectedGross => lines.Where(x => x.Selected).Sum(x => x.Item.Rate * x.Quantity);
    private decimal estimatedAdjustment => originalGross <= 0 ? 0 : Math.Min(Math.Max(0, originalNet - priorAdjustment), Math.Round(originalNet * selectedGross / originalGross, 2));
    private decimal originalReceivable => Math.Max(0, originalNet - (memo?.Paid ?? 0));
    private decimal priorReceivableAdjustment => Math.Max(0, priorAdjustment - priorRefund);
    private decimal estimatedReceivableAdjustment => Math.Min(estimatedAdjustment, Math.Max(0, originalReceivable - priorReceivableAdjustment));
    private decimal estimatedCashRefund => Math.Max(0, estimatedAdjustment - estimatedReceivableAdjustment);
    private bool CanPostReturn => !saving
        && memo is not null
        && lines.Any(x => x.Selected && x.Quantity > 0 && x.Quantity <= x.Remaining)
        && !string.IsNullOrWhiteSpace(reason)
        && (estimatedCashRefund <= 0 || (canIssueCashRefund && !string.IsNullOrWhiteSpace(refundReceivedBy)));

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        var principal = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        isAdministrator = principal.IsInRole(RoleNames.Administrator);
        canIssueCashRefund = isAdministrator || principal.IsInRole(RoleNames.Cashier);
        await using var db = await DbFactory.CreateDbContextAsync();
        services = await db.Services.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
        recent = await db.DiagnosticCashMemoReturns.AsNoTracking().OrderByDescending(x => x.ID).Take(100).ToListAsync();
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);
    private async Task HandleLookupKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") await FindMemoAsync(); }

    private async Task QueueMemoSuggestionsAsync()
    {
        memoSearchCts?.Cancel();
        memoSearchCts?.Dispose();
        memoSearchCts = new CancellationTokenSource();
        var token = memoSearchCts.Token;
        var raw = memoLookup.Trim();

        if (raw.Length < 2)
        {
            memoMatches = [];
            searchingMemos = false;
            return;
        }

        searchingMemos = true;
        try
        {
            await Task.Delay(300, token);
            memoMatches = await SearchMemoMatchesAsync(raw, token);
        }
        catch (OperationCanceledException) { }
        finally
        {
            if (!token.IsCancellationRequested) searchingMemos = false;
        }
    }

    private async Task<List<CashMemoDInvestigation>> SearchMemoMatchesAsync(string raw, CancellationToken token = default)
    {
        var lookup = raw.StartsWith("LAB-", StringComparison.OrdinalIgnoreCase) ? raw[4..] : raw;
        var hasMemoId = long.TryParse(lookup, out var memoId) && memoId > 0;
        await using var db = await DbFactory.CreateDbContextAsync(token);
        return await db.EmergencyMemos.AsNoTracking()
            .Where(x => x.ModuleID == 2 &&
                ((hasMemoId && x.ID == memoId) ||
                 (x.PatientID != null && x.PatientID.Contains(raw)) ||
                 (x.Contact != null && x.Contact.Contains(raw)) ||
                 (x.PatientName != null && x.PatientName.Contains(raw))))
            .OrderByDescending(x => x.ID)
            .Take(10)
            .ToListAsync(token);
    }

    private async Task FindMemoAsync()
    {
        var raw = memoLookup.Trim();
        if (raw.StartsWith("LAB-", StringComparison.OrdinalIgnoreCase)) raw = raw[4..];
        if (long.TryParse(raw, out var id) && id > 0)
        {
            await LoadMemoByIdAsync(id);
            return;
        }
        if (raw.Length < 2) { Fail(I18n.T("Enter at least two characters to search.")); return; }
        memoSearchCts?.Cancel();
        searchingMemos = true;
        memoMatches = await SearchMemoMatchesAsync(raw);
        searchingMemos = false;
        memo = null;
        savedReturn = null;
        if (memoMatches.Count == 0) { Fail(I18n.T("No matching diagnostic cash memo was found.")); return; }
        if (memoMatches.Count == 1) { await LoadMemoByIdAsync(memoMatches[0].ID); return; }
        Success(I18n.T("Select the correct diagnostic memo from the matches below."));
    }

    private async Task LoadMemoByIdAsync(long id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        memo = await db.EmergencyMemos.AsNoTracking().Include(x => x.Items).FirstOrDefaultAsync(x => x.ID == id && x.ModuleID == 2);
        if (memo is null) { Fail(I18n.T("Diagnostic cash memo was not found.")); return; }
        memoLookup = memo.ID.ToString();
        memoMatches = [];
        var returned = await db.DiagnosticCashMemoReturnItems.AsNoTracking().Where(x => x.CashMemoItem!.MemoID == id && x.Return!.Status == "Posted").GroupBy(x => x.CashMemoItemID).ToDictionaryAsync(x => x.Key, x => x.Sum(y => y.Quantity));
        lines = memo.Items.OrderBy(x => x.SLNo).Select(x => new ReturnLine(x, Math.Max(0, x.Quantity - returned.GetValueOrDefault(x.ID)))).ToList();
        originalGross = memo.Items.Sum(x => x.Rate * x.Quantity);
        originalNet = Math.Max(0, memo.Total - memo.Discount);
        priorAdjustment = await db.DiagnosticCashMemoReturns.Where(x => x.MemoID == id && x.Status == "Posted").SumAsync(x => (decimal?)x.AdjustmentAmount) ?? 0;
        priorRefund = await db.DiagnosticCashMemoReturns.Where(x => x.MemoID == id && x.Status == "Posted").SumAsync(x => (decimal?)x.RefundAmount) ?? 0;
        savedReturn = null;
        reason = "";
        refundMethod = "Cash";
        refundReference = "";
        refundReceivedBy = "";
        if (lines.All(x => x.Remaining <= 0)) Fail(I18n.T("All investigations on this memo have already been returned.")); else Success(I18n.T("Diagnostic cash memo loaded."));
    }

    private void PostAsync()
    {
        var selected = lines.Where(x => x.Selected).ToList();
        if (memo is null || selected.Count == 0 || string.IsNullOrWhiteSpace(reason)) { Fail(I18n.T("Select at least one investigation and enter a return reason.")); return; }
        if (selected.Any(x => x.Quantity <= 0 || x.Quantity > x.Remaining)) { Fail(I18n.T("Return quantity must be within the remaining quantity.")); return; }
        if (estimatedCashRefund > 0)
        {
            if (!canIssueCashRefund) { Fail(I18n.T("Cash refunds require Cashier or Administrator authorization.")); return; }
            if (refundMethod != "Cash") { Fail(I18n.T("Select a valid refund method.")); return; }
            if (string.IsNullOrWhiteSpace(refundReceivedBy)) { Fail(I18n.T("Enter the name of the person receiving the refund.")); return; }
        }
        showPostConfirmation = true;
    }

    private void ClosePostConfirmation() => showPostConfirmation = false;

    private async Task ConfirmPostAsync()
    {
        if (memo is null || !CanPostReturn) { showPostConfirmation = false; return; }
        var selected = lines.Where(x => x.Selected).ToList();
        showPostConfirmation = false;
        saving = true;
        try
        {
            var result = await ResilientTransaction.ExecuteAsync(DbFactory, async db =>
            {
            var source = await db.EmergencyMemos.Include(x => x.Items).SingleAsync(x => x.ID == memo.ID && x.ModuleID == 2);
            if (source.PatientType == "2" && !string.IsNullOrWhiteSpace(source.RegNo))
            {
                var admission = await db.PatientAdmissions.AsNoTracking().FirstOrDefaultAsync(x => x.RegNo == source.RegNo);
                if (admission is not null && await db.IpdFinalBills.AnyAsync(x => x.AdmissionID == admission.ID))
                    throw new InvalidOperationException("This IPD admission already has a final bill. Use an authorized post-discharge adjustment instead.");
            }
            foreach (var line in selected)
            {
                var sold = source.Items.Single(x => x.ID == line.Item.ID);
                var already = await db.DiagnosticCashMemoReturnItems.Where(x => x.CashMemoItemID == sold.ID && x.Return!.Status == "Posted").SumAsync(x => (int?)x.Quantity) ?? 0;
                if (line.Quantity > sold.Quantity - already) throw new InvalidOperationException($"Return quantity exceeded for {ServiceName(sold.TestID)}.");
                if (await db.LabTestResults.AnyAsync(x => x.MemoID == source.ID && x.ServiceID == sold.TestID && (x.IsVerified || x.ReportedAt != null)))
                    throw new InvalidOperationException($"{ServiceName(sold.TestID)} already has a reported/verified result and cannot be returned.");
                var sampleStatus = await db.LabSampleCollections.Where(x => x.MemoID == source.ID && x.ServiceID == sold.TestID).Select(x => x.Status).FirstOrDefaultAsync();
                if (!isAdministrator && sampleStatus is "InProcess" or "Completed")
                    throw new InvalidOperationException($"{ServiceName(sold.TestID)} is already in laboratory processing. Administrator authorization is required.");
            }

            var priorTotal = await db.DiagnosticCashMemoReturns.Where(x => x.MemoID == source.ID && x.Status == "Posted").SumAsync(x => (decimal?)x.AdjustmentAmount) ?? 0;
            var priorCash = await db.DiagnosticCashMemoReturns.Where(x => x.MemoID == source.ID && x.Status == "Posted").SumAsync(x => (decimal?)x.RefundAmount) ?? 0;
            var gross = source.Items.Sum(x => x.Rate * x.Quantity);
            var net = Math.Max(0, source.Total - source.Discount);
            var returnGross = selected.Sum(x => x.Item.Rate * x.Quantity);
            var adjustment = gross <= 0 ? 0 : Math.Min(net - priorTotal, Math.Round(net * returnGross / gross, 2));
            if (adjustment <= 0) throw new InvalidOperationException("No adjustable amount remains on this memo.");
            var originalDue = Math.Max(0, net - source.Paid);
            var priorReceivable = Math.Max(0, priorTotal - priorCash);
            var receivableAdjustment = Math.Min(adjustment, Math.Max(0, originalDue - priorReceivable));
            var refund = adjustment - receivableAdjustment;
            var userId = await CurrentUserIdAsync();
            var now = DateTime.Now;
            var header = new DiagnosticCashMemoReturn
            {
                MemoID = source.ID, AdjustmentAmount = adjustment, RefundAmount = refund,
                ReceivableAdjustment = receivableAdjustment, Reason = reason.Trim(), Status = "Posted",
                RefundMethod = refund > 0 ? refundMethod : null,
                RefundReference = refund > 0 && !string.IsNullOrWhiteSpace(refundReference) ? refundReference.Trim() : null,
                RefundReceivedBy = refund > 0 ? refundReceivedBy.Trim() : null,
                EnteredBy = userId, TransDate = now
            };
            db.DiagnosticCashMemoReturns.Add(header);
            await db.SaveChangesAsync();

            foreach (var line in selected)
            {
                var sold = source.Items.Single(x => x.ID == line.Item.ID);
                db.DiagnosticCashMemoReturnItems.Add(new DiagnosticCashMemoReturnItem { ReturnID = header.ID, CashMemoItemID = sold.ID, ServiceID = sold.TestID, Quantity = line.Quantity, Rate = sold.Rate });
                if (source.PatientType == "2" && !string.IsNullOrWhiteSpace(source.RegNo))
                {
                    db.IpdPatientServiceItems.Add(new IpdPatientServiceItem { RegNo = source.RegNo, PatientID = source.PatientID, ServiceID = sold.TestID, ServiceName = ServiceName(sold.TestID), Rate = sold.Rate, Quantity = -line.Quantity, Total = -(sold.Rate * line.Quantity), DoctorID = source.DoctorID, ServiceDate = now, EnteredBy = userId, Remarks = $"[DIAGNOSTIC-RETURN:{header.ID}:{sold.ID}]" });
                }
                var totalReturned = (await db.DiagnosticCashMemoReturnItems.Where(x => x.CashMemoItemID == sold.ID && x.Return!.Status == "Posted").SumAsync(x => (int?)x.Quantity) ?? 0) + line.Quantity;
                if (totalReturned >= sold.Quantity)
                {
                    var samples = await db.LabSampleCollections.Where(x => x.MemoID == source.ID && x.ServiceID == sold.TestID).ToListAsync();
                    foreach (var sample in samples)
                    {
                        sample.Status = "Cancelled";
                        sample.Remarks = $"Returned on voucher #{header.ID}";
                    }
                    var results = await db.LabTestResults.Where(x => x.MemoID == source.ID && x.ServiceID == sold.TestID).ToListAsync();
                    foreach (var labResult in results)
                    {
                        labResult.Status = "Cancelled";
                        labResult.CancelledBy = userId;
                        labResult.CancelledAt = now;
                        labResult.CancellationReason = $"Diagnostic return voucher #{header.ID}: {reason.Trim()}";
                    }
                }
            }

            var originalReference = $"DIAGNOSTIC:{source.ID}";
            if (!await db.AccountVouchers.AnyAsync(x => x.Reference == originalReference && x.IsPosted && x.Status != "Cancelled"))
            {
                var originalLines = new List<(int AccountID, decimal Debit, decimal Credit)>();
                if (source.Paid > 0) originalLines.Add((AccountingPosting.Cash, source.Paid, 0));
                if (net - source.Paid > 0) originalLines.Add((AccountingPosting.PatientReceivable, net - source.Paid, 0));
                originalLines.Add((AccountingPosting.HospitalRevenue, 0, net));
                AccountingPosting.AddPostedVoucher(db, source.Paid > 0 ? "Receipt" : "Journal", source.TransDate, $"Diagnostic memo #{source.ID}", originalReference, source.EnteredBy, originalLines.ToArray());
            }
            var returnLines = new List<(int AccountID, decimal Debit, decimal Credit)> { (AccountingPosting.HospitalRevenue, adjustment, 0) };
            if (refund > 0) returnLines.Add((AccountingPosting.Cash, 0, refund));
            if (receivableAdjustment > 0) returnLines.Add((AccountingPosting.PatientReceivable, 0, receivableAdjustment));
            AccountingPosting.AddPostedVoucher(db, "Sales Return", now, $"Investigation return for memo #{source.ID}", $"DIAGNOSTIC-RETURN:{header.ID}", userId, returnLines.ToArray());
            if (refund > 0) db.CentralCashCollections.Add(new CentralCashCollection { Amount = -refund, ModuleFlag = 12, HeadID = 12, EnteredBy = userId, TransDate = now, TransDateCL = now, ReferenceID = source.ID });
            await db.SaveChangesAsync();
            return (Header: header, Adjustment: adjustment, Refund: refund);
            }, IsolationLevel.Serializable);
            savedReturn = result.Header;
            priorAdjustment += result.Adjustment;
            priorRefund += result.Refund;
            Success(I18n.T($"Return voucher #{result.Header.ID} posted successfully."));
            await using var refreshDb = await DbFactory.CreateDbContextAsync();
            recent = await refreshDb.DiagnosticCashMemoReturns.AsNoTracking().OrderByDescending(x => x.ID).Take(100).ToListAsync();
        }
        catch (Exception ex) { Fail(ex.GetBaseException().Message); }
        finally { saving = false; }
    }

    private async Task OpenReturnAsync(long id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        savedReturn = await db.DiagnosticCashMemoReturns.AsNoTracking().Include(x => x.Items).SingleAsync(x => x.ID == id);
        memo = await db.EmergencyMemos.AsNoTracking().Include(x => x.Items).SingleAsync(x => x.ID == savedReturn.MemoID);
        memoLookup = memo.ID.ToString();
        reason = savedReturn.Reason;
        refundMethod = savedReturn.RefundMethod ?? "Cash";
        refundReference = savedReturn.RefundReference ?? "";
        refundReceivedBy = savedReturn.RefundReceivedBy ?? "";
        lines = savedReturn.Items.Select(x => new ReturnLine(memo.Items.Single(i => i.ID == x.CashMemoItemID), x.Quantity) { Selected = true, Quantity = x.Quantity }).ToList();
        originalGross = memo.Items.Sum(x => x.Rate * x.Quantity);
        originalNet = Math.Max(0, memo.Total - memo.Discount);
        priorAdjustment = await db.DiagnosticCashMemoReturns.Where(x => x.MemoID == memo.ID && x.ID < id && x.Status == "Posted").SumAsync(x => (decimal?)x.AdjustmentAmount) ?? 0;
        priorRefund = await db.DiagnosticCashMemoReturns.Where(x => x.MemoID == memo.ID && x.ID < id && x.Status == "Posted").SumAsync(x => (decimal?)x.RefundAmount) ?? 0;
    }

    private void OpenVoidReturnModal()
    {
        if (!isAdministrator || savedReturn is null || savedReturn.Status != "Posted") return;
        voidReason = "";
        showVoidConfirmation = true;
    }

    private void CloseVoidReturnModal()
    {
        if (saving) return;
        showVoidConfirmation = false;
        voidReason = "";
    }

    private async Task ConfirmVoidReturnAsync()
    {
        if (!isAdministrator || savedReturn is null || savedReturn.Status != "Posted" || string.IsNullOrWhiteSpace(voidReason)) return;
        var cancellationReason = voidReason.Trim();
        showVoidConfirmation = false;
        saving = true;
        try
        {
            var returnId = savedReturn.ID;
            await ResilientTransaction.ExecuteAsync<bool>(DbFactory, async db =>
            {
                var entity = await db.DiagnosticCashMemoReturns.Include(x => x.Items).SingleAsync(x => x.ID == returnId);
                if (entity.Status != "Posted") throw new InvalidOperationException("This return voucher is no longer active.");
                if (await db.DiagnosticCashMemoReturns.AnyAsync(x => x.MemoID == entity.MemoID && x.Status == "Posted" && x.ID > entity.ID))
                    throw new InvalidOperationException("Void the latest active return voucher for this memo first.");

                var userId = await CurrentUserIdAsync();
                var now = DateTime.Now;
                var source = await db.EmergencyMemos.Include(x => x.Items).SingleAsync(x => x.ID == entity.MemoID);
                if (source.PatientType == "2" && !string.IsNullOrWhiteSpace(source.RegNo))
                {
                    var admission = await db.PatientAdmissions.AsNoTracking().FirstOrDefaultAsync(x => x.RegNo == source.RegNo);
                    if (admission is not null && await db.IpdFinalBills.AnyAsync(x => x.AdmissionID == admission.ID))
                        throw new InvalidOperationException("This IPD admission already has a final bill. Use an authorized post-discharge adjustment instead.");
                }
                var voucher = await db.AccountVouchers.SingleOrDefaultAsync(x => x.Reference == $"DIAGNOSTIC-RETURN:{entity.ID}" && x.IsPosted && x.Status != "Cancelled")
                    ?? throw new InvalidOperationException("The posted accounting voucher for this return was not found.");
                await AccountingPosting.ReversePostedVoucherAsync(db, voucher, cancellationReason.Trim(), userId, now);

                foreach (var returnedItem in entity.Items)
                {
                    var sold = source.Items.Single(x => x.ID == returnedItem.CashMemoItemID);
                    if (source.PatientType == "2" && !string.IsNullOrWhiteSpace(source.RegNo))
                    {
                        db.IpdPatientServiceItems.Add(new IpdPatientServiceItem
                        {
                            RegNo = source.RegNo, PatientID = source.PatientID, ServiceID = sold.TestID,
                            ServiceName = ServiceName(sold.TestID), Rate = sold.Rate, Quantity = returnedItem.Quantity,
                            Total = sold.Rate * returnedItem.Quantity, DoctorID = source.DoctorID, ServiceDate = now,
                            EnteredBy = userId, Remarks = $"[DIAGNOSTIC-RETURN-REVERSAL:{entity.ID}:{sold.ID}]"
                        });
                    }

                    var otherReturned = await db.DiagnosticCashMemoReturnItems
                        .Where(x => x.CashMemoItemID == sold.ID && x.ReturnID != entity.ID && x.Return!.Status == "Posted")
                        .SumAsync(x => (int?)x.Quantity) ?? 0;
                    if (otherReturned < sold.Quantity)
                    {
                        var samples = await db.LabSampleCollections.Where(x => x.MemoID == source.ID && x.ServiceID == sold.TestID && x.Status == "Cancelled").ToListAsync();
                        foreach (var sample in samples)
                        {
                            sample.Status = "Pending";
                            sample.Remarks = $"Reactivated after voiding return voucher #{entity.ID}";
                        }
                        var results = await db.LabTestResults.IgnoreQueryFilters()
                            .Where(x => x.MemoID == source.ID && x.ServiceID == sold.TestID && x.Status == "Cancelled")
                            .ToListAsync();
                        foreach (var labResult in results)
                        {
                            labResult.Status = "Active";
                            labResult.CancelledBy = null;
                            labResult.CancelledAt = null;
                            labResult.CancellationReason = null;
                        }
                    }
                }

                if (entity.RefundAmount > 0)
                    db.CentralCashCollections.Add(new CentralCashCollection { Amount = entity.RefundAmount, ModuleFlag = 12, HeadID = 12, EnteredBy = userId, TransDate = now, TransDateCL = now, ReferenceID = source.ID });

                entity.Status = "Cancelled";
                entity.CancelledBy = userId;
                entity.CancelledAt = now;
                entity.CancellationReason = cancellationReason.Trim();
                await db.SaveChangesAsync();
                return true;
            }, IsolationLevel.Serializable);

            Success(I18n.T($"Return voucher #{returnId} was voided with a complete reversal."));
            await OpenReturnAsync(returnId);
            await using var refreshDb = await DbFactory.CreateDbContextAsync();
            recent = await refreshDb.DiagnosticCashMemoReturns.AsNoTracking().OrderByDescending(x => x.ID).Take(100).ToListAsync();
        }
        catch (Exception ex) { Fail(ex.GetBaseException().Message); }
        finally { saving = false; }
    }

    private async Task<int> CurrentUserIdAsync() { var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User; return int.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : 1; }
    private Task PrintAsync() => JS.InvokeVoidAsync("hpm.printElement", "diagnostic-return-print").AsTask();
    private string ServiceName(int id) => services.FirstOrDefault(x => x.ID == id)?.Name ?? "—";
    private void Reset() { memoSearchCts?.Cancel(); searchingMemos = false; showPostConfirmation = false; showVoidConfirmation = false; memo = null; savedReturn = null; memoMatches = []; memoLookup = ""; reason = ""; refundMethod = "Cash"; refundReference = ""; refundReceivedBy = ""; voidReason = ""; lines = []; message = ""; originalGross = originalNet = priorAdjustment = priorRefund = 0; }
    private void Success(string text) { messageClass = "success"; message = text; }
    private void Fail(string text) { messageClass = "danger"; message = text; }
    public void Dispose()
    {
        memoSearchCts?.Cancel();
        memoSearchCts?.Dispose();
        I18n.OnLanguageChanged -= HandleLanguageChanged;
    }

    private sealed class ReturnLine(CashMemoSubDInvestigation item, int remaining)
    {
        public CashMemoSubDInvestigation Item { get; } = item;
        public int Remaining { get; } = remaining;
        public bool Selected { get; set; }
        public int Quantity { get; set; } = remaining > 0 ? 1 : 0;
    }
}
