                <div class="return-confirm-warning void-confirm-warning">
                    <span>!</span>
                    <p><strong>@I18n.T("Important"):</strong> @I18n.T("The refund, central cash deduction and IPD adjustments will be reversed. Returned investigations may become active again.")</p>
