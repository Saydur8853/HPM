                    </div>
                }
            </div>
        </div>

        <!-- Right Panel: Recent Returns Operational Center -->
        <div class="diagnostic-queue-card" style="display:flex; flex-direction:column; min-height:0; overflow:hidden;">
            <div class="diagnostic-card-header">
                <div style="display:flex; align-items:center; gap:8px;">
