            <div><span>@I18n.T("Patient Type"):</span> <b>@(memo.PatientType == "2" ? $"IPD · {memo.RegNo}" : "OPD")</b></div><div><span>@I18n.T("Return Date"):</span> <b>@savedReturn.TransDate.ToString("dd MMM yyyy hh:mm tt")</b></div>
        </div>
        <table class="data-table"><thead><tr><th>@I18n.T("Investigation / Test")</th><th class="num">@I18n.T("Qty")</th><th class="num">@I18n.T("Rate")</th><th class="num">@I18n.T("Amount")</th></tr></thead><tbody>
            @foreach (var line in lines.Where(x => x.Selected)) { <tr><td>@ServiceName(line.Item.TestID)</td><td class="num">@line.Quantity</td><td class="num">@I18n.FormatCurrency(line.Item.Rate)</td><td class="num">@I18n.FormatCurrency(line.Item.Rate * line.Quantity)</td></tr> }
