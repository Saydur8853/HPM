    private void PostAsync()
    {
        var selected = lines.Where(x => x.Selected).ToList();
        if (memo is null || selected.Count == 0 || string.IsNullOrWhiteSpace(reason)) { Fail(I18n.T("Select at least one investigation and enter a return reason.")); return; }
        if (selected.Any(x => x.Quantity <= 0 || x.Quantity > x.Remaining)) { Fail(I18n.T("Return quantity must be within the remaining quantity.")); return; }
        if (estimatedCashRefund > 0)
        {
            if (!canIssueCashRefund) { Fail(I18n.T("Cash refunds require Cashier or Administrator authorization.")); return; }
            if (refundMethod != "Cash") { Fail(I18n.T("Select a valid refund method.")); return; }
            if (string.IsNullOrWhiteSpace(refundReceivedBy)) { Fail(I18n.T("Enter the name of the person receiving the refund.")); return; }
        }
        showPostConfirmation = true;
    }

    private void ClosePostConfirmation() => showPostConfirmation = false;

    private async Task ConfirmPostAsync()
    {
        if (memo is null || !CanPostReturn) { showPostConfirmation = false; return; }
        var selected = lines.Where(x => x.Selected).ToList();
        showPostConfirmation = false;
        saving = true;
        try
        {
            var result = await ResilientTransaction.ExecuteAsync(DbFactory, async db =>
            {
                var source = await db.EmergencyMemos.Include(x => x.Items).SingleAsync(x => x.ID == memo.ID && x.ModuleID == 2);
                if (source.PatientType == "2" && !string.IsNullOrWhiteSpace(source.RegNo))
                {
                    var admission = await db.PatientAdmissions.AsNoTracking().FirstOrDefaultAsync(x => x.RegNo == source.RegNo);
                    if (admission is not null && await db.IpdFinalBills.AnyAsync(x => x.AdmissionID == admission.ID))
                        throw new InvalidOperationException("This IPD admission already has a final bill. Use an authorized post-discharge adjustment instead.");
                }
                foreach (var line in selected)
                {
                    var sold = source.Items.Single(x => x.ID == line.Item.ID);
                    var already = await db.DiagnosticCashMemoReturnItems.Where(x => x.CashMemoItemID == sold.ID && x.Return!.Status == "Posted").SumAsync(x => (int?)x.Quantity) ?? 0;
                    if (line.Quantity > sold.Quantity - already) throw new InvalidOperationException($"Return quantity exceeded for {ServiceName(sold.TestID)}.");
                    if (await db.LabTestResults.AnyAsync(x => x.MemoID == source.ID && x.ServiceID == sold.TestID && (x.IsVerified || x.ReportedAt != null)))
                        throw new InvalidOperationException($"{ServiceName(sold.TestID)} already has a reported/verified result and cannot be returned.");
                    var sampleStatus = await db.LabSampleCollections.Where(x => x.MemoID == source.ID && x.ServiceID == sold.TestID).Select(x => x.Status).FirstOrDefaultAsync();
                    if (!isAdministrator && sampleStatus is "InProcess" or "Completed")
                        throw new InvalidOperationException($"{ServiceName(sold.TestID)} is already in laboratory processing. Administrator authorization is required.");
                }

                var priorTotal = await db.DiagnosticCashMemoReturns.Where(x => x.MemoID == source.ID && x.Status == "Posted").SumAsync(x => (decimal?)x.AdjustmentAmount) ?? 0;
                var priorCash = await db.DiagnosticCashMemoReturns.Where(x => x.MemoID == source.ID && x.Status == "Posted").SumAsync(x => (decimal?)x.RefundAmount) ?? 0;
                var gross = source.Items.Sum(x => x.Rate * x.Quantity);
                var net = Math.Max(0, source.Total - source.Discount);
                var returnGross = selected.Sum(x => x.Item.Rate * x.Quantity);
                var adjustment = gross <= 0 ? 0 : Math.Min(net - priorTotal, Math.Round(net * returnGross / gross, 2));
                if (adjustment <= 0) throw new InvalidOperationException("No adjustable amount remains on this memo.");
                var originalDue = Math.Max(0, net - source.Paid);
                var priorReceivable = Math.Max(0, priorTotal - priorCash);
                var receivableAdjustment = Math.Min(adjustment, Math.Max(0, originalDue - priorReceivable));
                var refund = adjustment - receivableAdjustment;
                var userId = await CurrentUserIdAsync();
                var now = DateTime.Now;
                var header = new DiagnosticCashMemoReturn
                {
                    MemoID = source.ID, AdjustmentAmount = adjustment, RefundAmount = refund,
                    ReceivableAdjustment = receivableAdjustment, Reason = reason.Trim(), Status = "Posted",
                    RefundMethod = refund > 0 ? refundMethod : null,
                    RefundReference = refund > 0 && !string.IsNullOrWhiteSpace(refundReference) ? refundReference.Trim() : null,
                    RefundReceivedBy = refund > 0 ? refundReceivedBy.Trim() : null,
                    EnteredBy = userId, TransDate = now
                };
                db.DiagnosticCashMemoReturns.Add(header);
                await db.SaveChangesAsync();

                foreach (var line in selected)
                {
                    var sold = source.Items.Single(x => x.ID == line.Item.ID);
                    db.DiagnosticCashMemoReturnItems.Add(new DiagnosticCashMemoReturnItem { ReturnID = header.ID, CashMemoItemID = sold.ID, ServiceID = sold.TestID, Quantity = line.Quantity, Rate = sold.Rate });
                    if (source.PatientType == "2" && !string.IsNullOrWhiteSpace(source.RegNo))
                    {
                        db.IpdPatientServiceItems.Add(new IpdPatientServiceItem { RegNo = source.RegNo, PatientID = source.PatientID, ServiceID = sold.TestID, ServiceName = ServiceName(sold.TestID), Rate = sold.Rate, Quantity = -line.Quantity, Total = -(sold.Rate * line.Quantity), DoctorID = source.DoctorID, ServiceDate = now, EnteredBy = userId, Remarks = $"[DIAGNOSTIC-RETURN:{header.ID}:{sold.ID}]" });
                    }
                    var totalReturned = (await db.DiagnosticCashMemoReturnItems.Where(x => x.CashMemoItemID == sold.ID && x.Return!.Status == "Posted").SumAsync(x => (int?)x.Quantity) ?? 0) + line.Quantity;
                    if (totalReturned >= sold.Quantity)
                    {
                        var samples = await db.LabSampleCollections.Where(x => x.MemoID == source.ID && x.ServiceID == sold.TestID).ToListAsync();
                        foreach (var sample in samples)
                        {
                            sample.Status = "Cancelled";
                            sample.Remarks = $"Returned on voucher #{header.ID}";
                        }
                        var results = await db.LabTestResults.Where(x => x.MemoID == source.ID && x.ServiceID == sold.TestID).ToListAsync();
                        foreach (var labResult in results)
                        {
                            labResult.Status = "Cancelled";
                            labResult.CancelledBy = userId;
                            labResult.CancelledAt = now;
                            labResult.CancellationReason = $"Diagnostic return voucher #{header.ID}: {reason.Trim()}";
                        }
                    }
                }

                var originalReference = $"DIAGNOSTIC:{source.ID}";
                if (!await db.AccountVouchers.AnyAsync(x => x.Reference == originalReference && x.IsPosted && x.Status != "Cancelled"))
                {
                    var originalLines = new List<(int AccountID, decimal Debit, decimal Credit)>();
                    if (source.Paid > 0) originalLines.Add((AccountingPosting.Cash, source.Paid, 0));
                    if (net - source.Paid > 0) originalLines.Add((AccountingPosting.PatientReceivable, net - source.Paid, 0));
                    originalLines.Add((AccountingPosting.HospitalRevenue, 0, net));
                    AccountingPosting.AddPostedVoucher(db, source.Paid > 0 ? "Receipt" : "Journal", source.TransDate, $"Diagnostic memo #{source.ID}", originalReference, source.EnteredBy, originalLines.ToArray());
                }
                var returnLines = new List<(int AccountID, decimal Debit, decimal Credit)> { (AccountingPosting.HospitalRevenue, adjustment, 0) };
                if (refund > 0) returnLines.Add((AccountingPosting.Cash, 0, refund));
                if (receivableAdjustment > 0) returnLines.Add((AccountingPosting.PatientReceivable, 0, receivableAdjustment));
                AccountingPosting.AddPostedVoucher(db, "Sales Return", now, $"Investigation return for memo #{source.ID}", $"DIAGNOSTIC-RETURN:{header.ID}", userId, returnLines.ToArray());
                if (refund > 0) db.CentralCashCollections.Add(new CentralCashCollection { Amount = -refund, ModuleFlag = 12, HeadID = 12, EnteredBy = userId, TransDate = now, TransDateCL = now, ReferenceID = source.ID });
                await db.SaveChangesAsync();
                return (Header: header, Adjustment: adjustment, Refund: refund);
            }, IsolationLevel.Serializable);

            savedReturn = result.Header;
            priorAdjustment += result.Adjustment;
            priorRefund += result.Refund;
            Success(I18n.T($"Return voucher #{result.Header.ID} posted successfully."));
            await using var refreshDb = await DbFactory.CreateDbContextAsync();
            await LoadRecentReturnsAsync(refreshDb);
            recentBills = await refreshDb.EmergencyMemos.AsNoTracking().Where(x => x.ModuleID == 2).OrderByDescending(x => x.ID).Take(8).ToListAsync();
        }
        catch (Exception ex) { Fail(ex.GetBaseException().Message); }
        finally { saving = false; }
    }

    private async Task OpenReturnAsync(long id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        savedReturn = await db.DiagnosticCashMemoReturns.AsNoTracking().Include(x => x.Items).SingleAsync(x => x.ID == id);
        memo = await db.EmergencyMemos.AsNoTracking().Include(x => x.Items).SingleAsync(x => x.ID == savedReturn.MemoID);
        memoLookup = memo.ID.ToString();
        reason = savedReturn.Reason;
        refundMethod = savedReturn.RefundMethod ?? "Cash";
        refundReference = savedReturn.RefundReference ?? "";
        refundReceivedBy = savedReturn.RefundReceivedBy ?? "";
        lines = savedReturn.Items.Select(x => new ReturnLine(memo.Items.Single(i => i.ID == x.CashMemoItemID), x.Quantity, false, "", true) { Selected = true, Quantity = x.Quantity }).ToList();
        originalGross = memo.Items.Sum(x => x.Rate * x.Quantity);
        originalNet = Math.Max(0, memo.Total - memo.Discount);
        priorAdjustment = await db.DiagnosticCashMemoReturns.Where(x => x.MemoID == memo.ID && x.ID < id && x.Status == "Posted").SumAsync(x => (decimal?)x.AdjustmentAmount) ?? 0;
        priorRefund = await db.DiagnosticCashMemoReturns.Where(x => x.MemoID == memo.ID && x.ID < id && x.Status == "Posted").SumAsync(x => (decimal?)x.RefundAmount) ?? 0;
    }

    private void OpenVoidReturnModal()
    {
        if (!isAdministrator || savedReturn is null || savedReturn.Status != "Posted") return;
        voidReason = "";
        showVoidConfirmation = true;
    }

    private void CloseVoidReturnModal()
    {
        if (saving) return;
        showVoidConfirmation = false;
        voidReason = "";
    }

    private async Task ConfirmVoidReturnAsync()
    {
        if (!isAdministrator || savedReturn is null || savedReturn.Status != "Posted" || string.IsNullOrWhiteSpace(voidReason)) return;
        var cancellationReason = voidReason.Trim();
        showVoidConfirmation = false;
        saving = true;
        try
        {
            var returnId = savedReturn.ID;
            await ResilientTransaction.ExecuteAsync<bool>(DbFactory, async db =>
            {
                var entity = await db.DiagnosticCashMemoReturns.Include(x => x.Items).SingleAsync(x => x.ID == returnId);
                if (entity.Status != "Posted") throw new InvalidOperationException("This return voucher is no longer active.");
                if (await db.DiagnosticCashMemoReturns.AnyAsync(x => x.MemoID == entity.MemoID && x.Status == "Posted" && x.ID > entity.ID))
                    throw new InvalidOperationException("Void the latest active return voucher for this memo first.");

                var userId = await CurrentUserIdAsync();
                var now = DateTime.Now;
                var source = await db.EmergencyMemos.Include(x => x.Items).SingleAsync(x => x.ID == entity.MemoID);
                if (source.PatientType == "2" && !string.IsNullOrWhiteSpace(source.RegNo))
                {
                    var admission = await db.PatientAdmissions.AsNoTracking().FirstOrDefaultAsync(x => x.RegNo == source.RegNo);
                    if (admission is not null && await db.IpdFinalBills.AnyAsync(x => x.AdmissionID == admission.ID))
                        throw new InvalidOperationException("This IPD admission already has a final bill. Use an authorized post-discharge adjustment instead.");
                }
                var voucher = await db.AccountVouchers.SingleOrDefaultAsync(x => x.Reference == $"DIAGNOSTIC-RETURN:{entity.ID}" && x.IsPosted && x.Status != "Cancelled")
                    ?? throw new InvalidOperationException("The posted accounting voucher for this return was not found.");
                await AccountingPosting.ReversePostedVoucherAsync(db, voucher, cancellationReason.Trim(), userId, now);

                foreach (var returnedItem in entity.Items)
                {
                    var sold = source.Items.Single(x => x.ID == returnedItem.CashMemoItemID);
                    if (source.PatientType == "2" && !string.IsNullOrWhiteSpace(source.RegNo))
                    {
                        db.IpdPatientServiceItems.Add(new IpdPatientServiceItem
                        {
                            RegNo = source.RegNo, PatientID = source.PatientID, ServiceID = sold.TestID,
                            ServiceName = ServiceName(sold.TestID), Rate = sold.Rate, Quantity = returnedItem.Quantity,
                            Total = sold.Rate * returnedItem.Quantity, DoctorID = source.DoctorID, ServiceDate = now,
                            EnteredBy = userId, Remarks = $"[DIAGNOSTIC-RETURN-REVERSAL:{entity.ID}:{sold.ID}]"
                        });
                    }

                    var otherReturned = await db.DiagnosticCashMemoReturnItems
                        .Where(x => x.CashMemoItemID == sold.ID && x.ReturnID != entity.ID && x.Return!.Status == "Posted")
                        .SumAsync(x => (int?)x.Quantity) ?? 0;
                    if (otherReturned < sold.Quantity)
                    {
                        var samples = await db.LabSampleCollections.Where(x => x.MemoID == source.ID && x.ServiceID == sold.TestID && x.Status == "Cancelled").ToListAsync();
                        foreach (var sample in samples)
                        {
                            sample.Status = "Pending";
                            sample.Remarks = $"Reactivated after voiding return voucher #{entity.ID}";
                        }
                        var results = await db.LabTestResults.IgnoreQueryFilters()
                            .Where(x => x.MemoID == source.ID && x.ServiceID == sold.TestID && x.Status == "Cancelled")
                            .ToListAsync();
                        foreach (var labResult in results)
                        {
                            labResult.Status = "Active";
                            labResult.CancelledBy = null;
                            labResult.CancelledAt = null;
                            labResult.CancellationReason = null;
                        }
                    }
                }

                if (entity.RefundAmount > 0)
                    db.CentralCashCollections.Add(new CentralCashCollection { Amount = entity.RefundAmount, ModuleFlag = 12, HeadID = 12, EnteredBy = userId, TransDate = now, TransDateCL = now, ReferenceID = source.ID });

                entity.Status = "Cancelled";
                entity.CancelledBy = userId;
                entity.CancelledAt = now;
                entity.CancellationReason = cancellationReason.Trim();
                await db.SaveChangesAsync();
                return true;
            }, IsolationLevel.Serializable);

            Success(I18n.T($"Return voucher #{returnId} was voided with a complete reversal."));
            await OpenReturnAsync(returnId);
            await using var refreshDb = await DbFactory.CreateDbContextAsync();
            await LoadRecentReturnsAsync(refreshDb);
        }
        catch (Exception ex) { Fail(ex.GetBaseException().Message); }
        finally { saving = false; }
    }

    private async Task<int> CurrentUserIdAsync() { var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User; return int.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : 1; }
    private Task PrintAsync() => JS.InvokeVoidAsync("hpm.printElement", "diagnostic-return-print").AsTask();
    private string ServiceName(int id) => services.FirstOrDefault(x => x.ID == id)?.Name ?? "—";
    private void Reset()
    {
        memoSearchCts?.Cancel();
        searchingMemos = false;
        showPostConfirmation = false;
        showVoidConfirmation = false;
        memo = null;
        savedReturn = null;
        memoMatches = [];
        memoLookup = "";
        reason = "";
        refundMethod = "Cash";
        refundReference = "";
        refundReceivedBy = "";
        voidReason = "";
        lines = [];
        message = "";
        originalGross = originalNet = priorAdjustment = priorRefund = 0;
        selectAllChecked = false;
    }

    private void Success(string text) { messageClass = "success"; message = text; }
    private void Fail(string text) { messageClass = "danger"; message = text; }

    public void Dispose()
    {
        memoSearchCts?.Cancel();
        memoSearchCts?.Dispose();
        I18n.OnLanguageChanged -= HandleLanguageChanged;
    }

    private sealed class ReturnLine
    {
        public CashMemoSubDInvestigation Item { get; }
        public int Remaining { get; }
        public bool Selected { get; set; }
        public int Quantity { get; set; }
        public bool IsReported { get; }
        public string SampleStatus { get; }
        public bool CanReturn { get; }
        public string BlockReason { get; }

        public ReturnLine(CashMemoSubDInvestigation item, int remaining, bool isReported, string sampleStatus, bool isAdmin)
        {
            Item = item;
            Remaining = remaining;
            Quantity = remaining > 0 ? remaining : 0;
            IsReported = isReported;
            SampleStatus = sampleStatus;

            if (remaining <= 0)
            {
                CanReturn = false;
                BlockReason = "Already Returned";
            }
            else if (isReported)
            {
                CanReturn = false;
                BlockReason = "Report Verified";
            }
            else if (!isAdmin && (sampleStatus is "InProcess" or "Completed"))
            {
                CanReturn = false;
                BlockReason = "In Lab Processing";
            }
            else
            {
                CanReturn = true;
                BlockReason = "";
            }
        }
    }
}
