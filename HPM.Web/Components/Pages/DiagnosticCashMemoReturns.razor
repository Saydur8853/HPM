    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);
    private async Task HandleLookupKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") await FindMemoAsync(); }

    private async Task QueueMemoSuggestionsAsync()
    {
        memoSearchCts?.Cancel();
        memoSearchCts?.Dispose();
        memoSearchCts = new CancellationTokenSource();
        var token = memoSearchCts.Token;
        var raw = memoLookup.Trim();

        if (memo is not null || raw.Length < 2)
        {
            memoMatches = [];
            searchingMemos = false;
            return;
        }

        searchingMemos = true;
        try
        {
            await Task.Delay(300, token);
            memoMatches = await SearchMemoMatchesAsync(raw, token);
        }
        catch (OperationCanceledException) { }
        finally
        {
            if (!token.IsCancellationRequested) searchingMemos = false;
        }
    }

    private async Task<List<CashMemoDInvestigation>> SearchMemoMatchesAsync(string raw, CancellationToken token = default)
    {
        var lookup = raw.StartsWith("LAB-", StringComparison.OrdinalIgnoreCase) ? raw[4..] : raw;
        var hasMemoId = long.TryParse(lookup, out var memoId) && memoId > 0;
        await using var db = await DbFactory.CreateDbContextAsync(token);
        return await db.EmergencyMemos.AsNoTracking()
            .Where(x => x.ModuleID == 2 &&
                ((hasMemoId && x.ID == memoId) ||
                 (x.PatientID != null && x.PatientID.Contains(raw)) ||
                 (x.Contact != null && x.Contact.Contains(raw)) ||
                 (x.PatientName != null && x.PatientName.Contains(raw))))
            .OrderByDescending(x => x.ID)
            .Take(10)
            .ToListAsync(token);
    }

    private async Task FindMemoAsync()
    {
        var raw = memoLookup.Trim();
        if (raw.StartsWith("LAB-", StringComparison.OrdinalIgnoreCase)) raw = raw[4..];
        if (long.TryParse(raw, out var id) && id > 0)
        {
            await LoadMemoByIdAsync(id);
            return;
        }
        if (raw.Length < 2) { Fail(I18n.T("Enter at least two characters to search.")); return; }
        memoSearchCts?.Cancel();
        searchingMemos = true;
        memoMatches = await SearchMemoMatchesAsync(raw);
        searchingMemos = false;
        memo = null;
        savedReturn = null;
        if (memoMatches.Count == 0) { Fail(I18n.T("No matching diagnostic cash memo was found.")); return; }
        if (memoMatches.Count == 1) { await LoadMemoByIdAsync(memoMatches[0].ID); return; }
        Success(I18n.T("Select the correct diagnostic memo from the matches below."));
    }

    private async Task LoadMemoByIdAsync(long id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        memo = await db.EmergencyMemos.AsNoTracking().Include(x => x.Items).FirstOrDefaultAsync(x => x.ID == id && x.ModuleID == 2);
        if (memo is null) { Fail(I18n.T("Diagnostic cash memo was not found.")); return; }
        memoLookup = memo.ID.ToString();
        memoMatches = [];

        var returned = await db.DiagnosticCashMemoReturnItems.AsNoTracking()
            .Where(x => x.CashMemoItem!.MemoID == id && x.Return!.Status == "Posted")
            .GroupBy(x => x.CashMemoItemID)
            .ToDictionaryAsync(x => x.Key, x => x.Sum(y => y.Quantity));

        var testIds = memo.Items.Select(x => x.TestID).Distinct().ToList();
        var reportedTestIds = (await db.LabTestResults.AsNoTracking()
            .Where(x => x.MemoID == id && testIds.Contains(x.ServiceID) && (x.IsVerified || x.ReportedAt != null))
            .Select(x => x.ServiceID)
            .Distinct()
            .ToListAsync()).ToHashSet();

        var sampleStatuses = await db.LabSampleCollections.AsNoTracking()
            .Where(x => x.MemoID == id && testIds.Contains(x.ServiceID))
            .GroupBy(x => x.ServiceID)
            .ToDictionaryAsync(x => x.Key, x => x.OrderByDescending(s => s.ID).Select(s => s.Status).FirstOrDefault() ?? "");

        lines = memo.Items.OrderBy(x => x.SLNo).Select(x =>
        {
            var remaining = Math.Max(0, x.Quantity - returned.GetValueOrDefault(x.ID));
            var isReported = reportedTestIds.Contains(x.TestID);
            var sampleStatus = sampleStatuses.GetValueOrDefault(x.TestID, "");
            return new ReturnLine(x, remaining, isReported, sampleStatus, isAdministrator);
        }).ToList();

        originalGross = memo.Items.Sum(x => x.Rate * x.Quantity);
        originalNet = Math.Max(0, memo.Total - memo.Discount);
        priorAdjustment = await db.DiagnosticCashMemoReturns.Where(x => x.MemoID == id && x.Status == "Posted").SumAsync(x => (decimal?)x.AdjustmentAmount) ?? 0;
        priorRefund = await db.DiagnosticCashMemoReturns.Where(x => x.MemoID == id && x.Status == "Posted").SumAsync(x => (decimal?)x.RefundAmount) ?? 0;
        savedReturn = null;
        reason = "";
        refundMethod = "Cash";
        refundReference = "";
        refundReceivedBy = memo.PatientName ?? "";
        selectAllChecked = false;

        if (lines.All(x => !x.CanReturn))
            Fail(I18n.T("None of the investigations on this memo are eligible for return (already returned, reported, or in lab)."));
        else
            Success(I18n.T("Diagnostic cash memo loaded successfully."));
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        selectAllChecked = e.Value is bool b && b;
        foreach (var line in lines.Where(x => x.CanReturn))
        {
            line.Selected = selectAllChecked;
            if (line.Selected && line.Quantity <= 0) line.Quantity = line.Remaining;
        }
    }

    private void ToggleLineSelection(ReturnLine line)
    {
        if (!line.CanReturn || savedReturn is not null) return;
        line.Selected = !line.Selected;
        if (line.Selected && line.Quantity <= 0) line.Quantity = line.Remaining;
        selectAllChecked = lines.Where(x => x.CanReturn).All(x => x.Selected);
    }

    private void IncrementQty(ReturnLine line)
    {
        if (!line.CanReturn || savedReturn is not null) return;
        if (line.Quantity < line.Remaining) line.Quantity++;
    }

    private void DecrementQty(ReturnLine line)
    {
        if (!line.CanReturn || savedReturn is not null) return;
        if (line.Quantity > 1) line.Quantity--;
    }

    private void SelectCommonReason(string r)
    {
        if (savedReturn is not null) return;
        reason = r;
    }

    private void ClearSearch()
    {
        memoLookup = "";
        memoMatches = [];
    }

