@code {
    private List<Service> services = [];
    private List<DiagnosticCashMemoReturn> recent = [];
    private List<CashMemoDInvestigation> recentBills = [];
    private List<DoctorsProfile> doctors = [];
    private Dictionary<int, string> userDisplayNames = [];
    private List<CashMemoDInvestigation> memoMatches = [];
    private List<ReturnLine> lines = [];
    private CashMemoDInvestigation? memo;
    private DiagnosticCashMemoReturn? savedReturn;
    private string memoLookup = "";
    private string reason = "";
    private string message = "";
    private string messageClass = "success";
    private bool saving;
    private bool showPostConfirmation;
    private bool showVoidConfirmation;
    private bool searchingMemos;
    private CancellationTokenSource? memoSearchCts;
    private bool isAdministrator;
    private bool canIssueCashRefund;
    private string refundMethod = "Cash";
    private string refundReference = "";
    private string refundReceivedBy = "";
    private string voidReason = "";
    private decimal originalGross;
    private decimal originalNet;
    private decimal priorAdjustment;
    private decimal priorRefund;
    private string recentFilter = "";
    private string recentStatusFilter = "all";
    private bool selectAllChecked;

    private readonly string[] commonReasons =
    [
        "Patient Refused / Cancelled",
        "Doctor Changed Investigation",
        "Sample Cannot Be Collected",
        "Wrong Investigation Selected",
        "Duplicate Billing",
        "Financial Constraints"
    ];

    private int todayReturnsCount => recent.Count(x => x.TransDate.Date == DateTime.Today && x.Status == "Posted");
    private decimal todayRefundTotal => recent.Where(x => x.TransDate.Date == DateTime.Today && x.Status == "Posted").Sum(x => x.RefundAmount);

    private IEnumerable<DiagnosticCashMemoReturn> FilteredRecentReturns =>
        recent.Where(r =>
            (string.IsNullOrWhiteSpace(recentFilter) ||
             r.ID.ToString().Contains(recentFilter, StringComparison.OrdinalIgnoreCase) ||
             r.MemoID.ToString().Contains(recentFilter, StringComparison.OrdinalIgnoreCase) ||
             (r.Memo?.PatientName != null && r.Memo.PatientName.Contains(recentFilter, StringComparison.OrdinalIgnoreCase)) ||
             (r.Memo?.Contact != null && r.Memo.Contact.Contains(recentFilter, StringComparison.OrdinalIgnoreCase)) ||
             (r.RefundReceivedBy != null && r.RefundReceivedBy.Contains(recentFilter, StringComparison.OrdinalIgnoreCase))) &&
            (recentStatusFilter == "all" ||
             (recentStatusFilter == "posted" && r.Status == "Posted") ||
             ((recentStatusFilter is "cancelled" or "voided") && r.Status == "Cancelled") ||
             (recentStatusFilter == "today" && r.TransDate.Date == DateTime.Today)));

    private decimal selectedGross => lines.Where(x => x.Selected).Sum(x => x.Item.Rate * x.Quantity);
    private decimal estimatedAdjustment => originalGross <= 0 ? 0 : Math.Min(Math.Max(0, originalNet - priorAdjustment), Math.Round(originalNet * selectedGross / originalGross, 2));
    private decimal originalReceivable => Math.Max(0, originalNet - (memo?.Paid ?? 0));
    private decimal priorReceivableAdjustment => Math.Max(0, priorAdjustment - priorRefund);
    private decimal estimatedReceivableAdjustment => Math.Min(estimatedAdjustment, Math.Max(0, originalReceivable - priorReceivableAdjustment));
    private decimal estimatedCashRefund => Math.Max(0, estimatedAdjustment - estimatedReceivableAdjustment);
    private bool CanPostReturn => !saving
        && memo is not null
        && lines.Any(x => x.Selected && x.Quantity > 0 && x.Quantity <= x.Remaining)
        && !string.IsNullOrWhiteSpace(reason)
        && (estimatedCashRefund <= 0 || (canIssueCashRefund && !string.IsNullOrWhiteSpace(refundReceivedBy)));

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        var principal = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        isAdministrator = principal.IsInRole(RoleNames.Administrator);
        canIssueCashRefund = isAdministrator || principal.IsInRole(RoleNames.Cashier);
        await using var db = await DbFactory.CreateDbContextAsync();
        services = await db.Services.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
        doctors = await db.Doctors.AsNoTracking().ToListAsync();
        userDisplayNames = await db.Users.AsNoTracking()
            .ToDictionaryAsync(u => u.Id, u => string.IsNullOrWhiteSpace(u.DisplayName) ? (u.UserName ?? $"User #{u.Id}") : u.DisplayName);
        await LoadRecentReturnsAsync(db);
        recentBills = await db.EmergencyMemos.AsNoTracking()
            .Where(x => x.ModuleID == 2)
            .OrderByDescending(x => x.ID)
            .Take(8)
            .ToListAsync();
