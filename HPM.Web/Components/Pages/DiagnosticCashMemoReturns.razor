            <div class="return-recent-footer">
                <span>@I18n.T("Showing") <b>@FilteredRecentReturns.Count()</b> @I18n.T("of") <b>@recent.Count</b> @I18n.T("returns")</span>
                <span>@DateTime.Today.ToString("dd MMM yyyy")</span>
