@page "/diagnostic/cash-memo-return"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.Cashier + "," + RoleNames.Reception)]
@rendermode InteractiveServer
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@implements IDisposable
@using System.Data
@using System.Security.Claims
@using HPM.Web.Security
@using HPM.Web.Services

<PageTitle>@I18n.T("Cash Memo Return & Refund") | @Branding.HospitalName</PageTitle>

<div class="diagnostic-classic-fit">
    <!-- Compact Top Action & Status Bar -->
    <div class="diagnostic-classic-topbar">
        <div class="tickets-top-left">
            <h1 class="tickets-page-title">
                <span>↩️</span>
                <span>@I18n.T("Cash Memo Return & Refund")</span>
            </h1>
            <span class="tickets-count-pill" title="@I18n.T("Total historical returns")">
                @recent.Count @I18n.T("Returns")
            </span>
            @if (todayReturnsCount > 0)
            {
                <span class="tickets-count-pill" style="background:#f0fdf4; border-color:#86efac; color:#166534;" title="@I18n.T("Today's returns summary")">
                    ⚡ @todayReturnsCount @I18n.T("Today") · @I18n.FormatCurrency(todayRefundTotal)
                </span>
            }
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <span class="tickets-inline-alert @messageClass" title="@message">
                    @(messageClass.Contains("danger") ? "⚠" : "✓") @message
                </span>
            }
        </div>

        <DiagnosticNavTabs />

        <div class="tickets-top-actions">
            <button type="button" class="btn btn-secondary tickets-btn" @onclick="Reset" title="@I18n.T("Start a new return search")">
                + @I18n.T("New Return")
            </button>
        </div>
    </div>

    <!-- Main Balanced Workspace Grid: Left Return Workspace, Right Recent Returns Operational Center -->
    <div class="diagnostic-classic-workspace diagnostic-returns-workspace">
        <!-- Left Panel: Return Form Card -->
        <div class="diagnostic-form-card" style="display:flex; flex-direction:column; min-height:0; overflow:hidden;">
            <div class="diagnostic-card-header">
                <div style="display:flex; align-items:center; gap:10px;">
                    <h2>@(savedReturn is null ? (memo is null ? I18n.T("Find Original Investigation Memo") : $"{I18n.T("Process Return for Memo")} #{memo.ID}") : $"{I18n.T("Return Voucher")} #{savedReturn.ID}")</h2>
                    @if (savedReturn is not null)
                    {
                        <span class="diagnostic-badge" style="@(savedReturn.Status == "Posted" ? "background:#dcfce7; color:#166534;" : "background:#fee2e2; color:#991b1b;")">
                            @(savedReturn.Status == "Posted" ? "✓ " + I18n.T("COMPLETED") : "⛔ " + I18n.T("CANCELLED"))
                        </span>
                    }
                    else if (memo is not null)
                    {
                        <span class="diagnostic-badge" style="background:#e0f2fe; color:#0369a1;">
                            @I18n.T("MEMO LOADED")
                        </span>
                    }
                </div>
                @if (memo is not null || savedReturn is not null)
                {
                    <button type="button" class="btn btn-ghost" style="font-size:11px; padding:3px 10px; color:#475569;" @onclick="Reset" title="@I18n.T("Clear and start another return")">
                        ↩ @I18n.T("Search Another Memo")
                    </button>
                }
            </div>

            <div class="diagnostic-form-body" style="flex:1 1 auto; overflow-y:auto; padding:12px 16px;">
                @if (savedReturn is null)
                {
                    <!-- Hero Search Bar -->
                    <div class="return-search-hero">
                        <span class="return-search-icon">🔍</span>
                        <div class="return-search-input-wrap">
                            <input class="return-search-input"
                                   @bind="memoLookup"
                                   @bind:event="oninput"
                                   @bind:after="QueueMemoSuggestionsAsync"
                                   @onkeydown="HandleLookupKeyDown"
                                   autocomplete="off"
                                   placeholder="@I18n.T("Search by Memo ID, Patient ID, mobile or patient name...")" />
                            @if (!string.IsNullOrWhiteSpace(memoLookup))
                            {
                                <button type="button" class="return-search-clear-btn" @onclick="ClearSearch" title="@I18n.T("Clear search")">✕</button>
                            }
                            @if ((searchingMemos || memoMatches.Count > 0) && memo is null)
                            {
                                <div class="return-memo-suggestions">
                                    @if (searchingMemos)
                                    {
                                        <div class="return-memo-searching">
                                            <span>⏳</span> @I18n.T("Searching diagnostic cash memos...")
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (var match in memoMatches)
                                        {
                                            <button type="button" class="return-memo-suggestion" @onclick="() => LoadMemoByIdAsync(match.ID)">
                                                <span class="return-memo-suggestion-id">#@match.ID</span>
                                                <div class="return-memo-suggestion-info">
                                                    <span class="return-memo-suggestion-name">@match.PatientName</span>
                                                    <span class="return-memo-suggestion-sub">PID: @(match.PatientID ?? I18n.T("Walk-in")) · 📞 @(match.Contact ?? "—")</span>
                                                </div>
                                                <div class="return-memo-suggestion-meta">
                                                    <span class="return-memo-suggestion-badge @(match.PatientType == "2" ? "ipd" : "opd")">
                                                        @(match.PatientType == "2" ? $"IPD · {match.RegNo}" : "OPD")
                                                    </span>
                                                    <small style="color:#64748b; font-size:10px;">@match.TransDate.ToString("dd MMM yyyy")</small>
                                                </div>
                                            </button>
                                        }
                                    }
                                </div>
                            }
                        </div>
                        <button type="button" class="return-search-action-btn" @onclick="FindMemoAsync" disabled="@searchingMemos">
                            @if (searchingMemos)
                            {
                                <span>⏳</span>
                            }
                            else
                            {
                                <SearchIcon />
                            }
                            <span>@I18n.T("Load Memo")</span>
                        </button>
                    </div>
                }

                @if (savedReturn is null && memo is null)
                {
                    <!-- Process Flow Steps Indicator -->
                    <div class="return-process-steps">
                        <div class="return-process-step active">
                            <span class="return-step-num">1</span>
                            <div class="return-step-label">
                                <strong>@I18n.T("Find Memo")</strong>
                                <span>@I18n.T("Search or pick below")</span>
                            </div>
                        </div>
                        <span class="return-step-arrow">➔</span>
                        <div class="return-process-step pending">
                            <span class="return-step-num">2</span>
                            <div class="return-step-label">
                                <strong>@I18n.T("Select Tests")</strong>
                                <span>@I18n.T("Qty & return reason")</span>
                            </div>
                        </div>
                        <span class="return-step-arrow">➔</span>
                        <div class="return-process-step pending">
                            <span class="return-step-num">3</span>
                            <div class="return-step-label">
                                <strong>@I18n.T("Review & Refund")</strong>
                                <span>@I18n.T("Post safely")</span>
                            </div>
                        </div>
                    </div>

                    <!-- Safety Notice Alert -->
                    <div class="return-policy-alert">
                        <span class="return-policy-alert-icon">🛡️</span>
                        <div>
                            <strong>@I18n.T("Return Policy & Safety Notice"):</strong>
                            <span>@I18n.T("Completed/verified test results and final-billed IPD admissions cannot be returned. Cash refunds require Cashier authorization.")</span>
                        </div>
                    </div>

                    <!-- Recently Billed Diagnostic Memos (Quick Select) -->
                    <div class="return-quick-bills-card">
                        <div class="return-quick-bills-header">
                            <span class="return-quick-bills-title">
                                <span>⚡</span> @I18n.T("Recent Diagnostic Bills")
                                <span class="return-quick-bills-badge">@I18n.T("Quick Select")</span>
                            </span>
                            <small style="color:#64748b; font-size:10.5px;">@I18n.T("Click to load for return")</small>
                        </div>
                        <div style="overflow-x:auto;">
                            <table class="return-quick-bills-table">
                                <thead>
                                    <tr>
                                        <th style="width:75px;">@I18n.T("Memo #")</th>
                                        <th>@I18n.T("Patient Name")</th>
                                        <th style="width:90px;">@I18n.T("Type")</th>
                                        <th style="width:110px;">@I18n.T("Date")</th>
                                        <th class="num" style="width:100px; text-align:right;">@I18n.T("Net Bill")</th>
                                        <th style="width:130px; text-align:right;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (recentBills.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="6" style="text-align:center; padding:18px; color:#94a3b8;">
                                                @I18n.T("No recent diagnostic bills found.")
                                            </td>
                                        </tr>
                                    }
                                    @foreach (var bill in recentBills)
                                    {
                                        <tr>
                                            <td><strong style="color:#0284c7;">#@bill.ID</strong></td>
                                            <td>
                                                <strong style="color:#1e293b;">@bill.PatientName</strong>
                                                <small style="display:block; color:#64748b; font-size:10px;">PID: @(bill.PatientID ?? I18n.T("Walk-in")) · 📞 @(bill.Contact ?? "—")</small>
                                            </td>
                                            <td>
                                                <span class="return-memo-suggestion-badge @(bill.PatientType == "2" ? "ipd" : "opd")">
                                                    @(bill.PatientType == "2" ? $"IPD · {bill.RegNo}" : "OPD")
                                                </span>
                                            </td>
                                            <td style="color:#64748b; font-size:11px;">@bill.TransDate.ToString("dd MMM, hh:mm tt")</td>
                                            <td style="text-align:right; font-weight:700; color:#0f172a;">@I18n.FormatCurrency(Math.Max(0, bill.Total - bill.Discount))</td>
                                            <td style="text-align:right;">
                                                <button type="button" class="return-quick-bills-btn" @onclick="() => LoadMemoByIdAsync(bill.ID)">
                                                    ↩ @I18n.T("Select for Return")
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                @if (memo is not null && savedReturn is null)
                {
                    <!-- Patient & Memo Summary Banner -->
                    <div class="return-patient-banner">
                        <div class="return-patient-header-row">
                            <div class="return-patient-id-block">
                                <div class="return-patient-avatar">
                                    @(string.IsNullOrWhiteSpace(memo.PatientName) ? "P" : memo.PatientName.Substring(0, 1).ToUpper())
                                </div>
                                <div class="return-patient-name-wrap">
                                    <div class="return-patient-name">
                                        <span>@memo.PatientName</span>
                                        <span class="return-memo-suggestion-badge @(memo.PatientType == "2" ? "ipd" : "opd")">
                                            @(memo.PatientType == "2" ? $"IPD · Reg #{memo.RegNo} {(string.IsNullOrWhiteSpace(memo.Bed) ? "" : $"· Bed {memo.Bed}")}" : "OPD Walk-in")
                                        </span>
                                    </div>
                                    <div class="return-patient-meta">
                                        <span><strong>@I18n.T("Memo"):</strong> #@memo.ID</span>
                                        <span>•</span>
                                        <span><strong>PID:</strong> @(memo.PatientID ?? I18n.T("Walk-in"))</span>
                                        @if (!string.IsNullOrWhiteSpace(memo.Age) || !string.IsNullOrWhiteSpace(memo.Sex))
                                        {
                                            <span>•</span>
                                            <span>@memo.Age / @memo.Sex</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(memo.Contact))
                                        {
                                            <span>•</span>
                                            <span>📞 @memo.Contact</span>
                                        }
                                        <span>•</span>
                                        <span>📅 @memo.TransDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                                        @if (memo.DoctorID is not null)
                                        {
                                            <span>•</span>
                                            <span>👨‍⚕️ @DoctorName(memo.DoctorID)</span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <button type="button" class="return-patient-change-btn" @onclick="Reset" title="@I18n.T("Clear and change memo")">
                                ✕ @I18n.T("Change Memo")
                            </button>
                        </div>

                        <!-- Financial Snapshot Pills -->
                        <div class="return-patient-financial-pills">
                            <div class="return-patient-fin-pill">
                                <span>@I18n.T("Original Gross")</span>
                                <strong>@I18n.FormatCurrency(originalGross)</strong>
                            </div>
                            <div class="return-patient-fin-pill">
                                <span>@I18n.T("Discount")</span>
                                <strong style="color:#0284c7;">@I18n.FormatCurrency(memo.Discount)</strong>
                            </div>
                            <div class="return-patient-fin-pill">
                                <span>@I18n.T("Net Total")</span>
                                <strong>@I18n.FormatCurrency(originalNet)</strong>
                            </div>
                            <div class="return-patient-fin-pill">
                                <span>@I18n.T("Paid Amount")</span>
                                <strong style="color:#15803d;">@I18n.FormatCurrency(memo.Paid)</strong>
                            </div>
                            <div class="return-patient-fin-pill @(originalReceivable > 0 ? "due" : "")">
                                <span>@I18n.T("Due / IPD Ledger")</span>
                                <strong>@I18n.FormatCurrency(originalReceivable)</strong>
                            </div>
                            @if (priorAdjustment > 0)
                            {
                                <div class="return-patient-fin-pill adj">
                                    <span>@I18n.T("Prior Returns")</span>
                                    <strong>@I18n.FormatCurrency(priorAdjustment)</strong>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Items Return Selection Table Card -->
                    <div class="return-items-table-card">
                        <div class="return-items-table-toolbar">
                            <span class="return-items-table-title">
                                <span>🧪</span> @I18n.T("Select Investigation Items for Return")
                            </span>
                            @if (lines.Any(x => x.CanReturn))
                            {
                                <label class="return-select-all-label">
                                    <input type="checkbox" checked="@selectAllChecked" @onchange="ToggleSelectAll" />
                                    <span>@I18n.T("Select All Returnable")</span>
                                </label>
                            }
                        </div>

                        <div class="return-items-table-wrap">
                            <table class="return-items-table">
                                <thead>
                                    <tr>
                                        <th style="width:40px; text-align:center;"></th>
                                        <th>@I18n.T("Investigation / Test")</th>
                                        <th style="width:130px;">@I18n.T("Lab Status")</th>
                                        <th class="num" style="width:65px; text-align:right;">@I18n.T("Sold")</th>
                                        <th class="num" style="width:75px; text-align:right;">@I18n.T("Remain")</th>
                                        <th class="num" style="width:105px; text-align:center;">@I18n.T("Return Qty")</th>
                                        <th class="num" style="width:85px; text-align:right;">@I18n.T("Rate")</th>
                                        <th class="num" style="width:95px; text-align:right;">@I18n.T("Amount")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var line in lines)
                                    {
                                        <tr class="@(line.Selected ? "selected-row" : (!line.CanReturn ? "blocked-row" : ""))" @onclick="() => ToggleLineSelection(line)">
                                            <td style="text-align:center;" @onclick:stopPropagation="true">
                                                <input class="return-item-check"
                                                       type="checkbox"
                                                       checked="@line.Selected"
                                                       @onchange="() => ToggleLineSelection(line)"
                                                       disabled="@(!line.CanReturn)"
                                                       aria-label="@I18n.T("Select investigation")" />
                                            </td>
                                            <td>
                                                <strong style="color:#0f172a;">@ServiceName(line.Item.TestID)</strong>
                                            </td>
                                            <td>
                                                @if (line.Remaining <= 0)
                                                {
                                                    <span class="return-status-badge returned">✓ @I18n.T("Returned")</span>
                                                }
                                                else if (line.IsReported)
                                                {
                                                    <span class="return-status-badge reported" title="@I18n.T("Result has already been verified/reported")">🔒 @I18n.T("Report Done")</span>
                                                }
                                                else if (!isAdministrator && (line.SampleStatus is "InProcess" or "Completed"))
                                                {
                                                    <span class="return-status-badge inlab" title="@I18n.T("Sample is currently processing in laboratory")">⏳ @I18n.T("In Lab")</span>
                                                }
                                                else
                                                {
                                                    <span class="return-status-badge ready">● @I18n.T("Available")</span>
                                                }
                                            </td>
                                            <td class="num" style="text-align:right;">@line.Item.Quantity</td>
                                            <td class="num" style="text-align:right;"><b>@line.Remaining</b></td>
                                            <td style="text-align:center;" @onclick:stopPropagation="true">
                                                @if (line.CanReturn && line.Selected)
                                                {
                                                    <div class="return-qty-stepper">
                                                        <button type="button" class="return-qty-btn" @onclick="() => DecrementQty(line)" disabled="@(line.Quantity <= 1)">−</button>
                                                        <input type="number"
                                                               class="return-qty-input"
                                                               @bind="line.Quantity"
                                                               min="1"
                                                               max="@line.Remaining" />
                                                        <button type="button" class="return-qty-btn" @onclick="() => IncrementQty(line)" disabled="@(line.Quantity >= line.Remaining)">+</button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span style="color:#64748b;">@(line.Selected ? line.Quantity : "—")</span>
                                                }
                                            </td>
                                            <td class="num" style="text-align:right;">@I18n.FormatCurrency(line.Item.Rate)</td>
                                            <td class="num" style="text-align:right;">
                                                <b style="color:@(line.Selected ? "#15803d" : "#94a3b8");">
                                                    @I18n.FormatCurrency(line.Selected ? line.Item.Rate * line.Quantity : 0)
                                                </b>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Return Reason & Quick Chips -->
                    <div class="return-reason-section">
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <label style="margin:0; font-size:11.5px; font-weight:700; color:#334155;">
                                @I18n.T("Return Reason") <span class="required-mark">*</span>
                            </label>
                            <small style="color:#64748b; font-size:10.5px;">@I18n.T("Choose a quick reason or type custom details")</small>
                        </div>
                        <div class="return-reason-chips">
                            @foreach (var r in commonReasons)
                            {
                                <button type="button" class="return-reason-chip @(reason == r ? "active" : "")" @onclick="() => SelectCommonReason(r)">
                                    @r
                                </button>
                            }
                        </div>
                        <input class="classic-input"
                               @bind="reason"
                               maxlength="500"
                               placeholder="@I18n.T("Enter specific justification for return / cancellation...")"
                               style="height:34px; width:100%; border-radius:7px;" />
                    </div>

                    <!-- Financial Impact KPI Cards -->
                    <div class="return-settlement-grid">
                        <div class="return-settlement-card">
                            <span class="label">@I18n.T("Selected Tests")</span>
                            <span class="value">@I18n.FormatCurrency(selectedGross)</span>
                        </div>
                        <div class="return-settlement-card">
                            <span class="label">@I18n.T("Net Adjustment")</span>
                            <span class="value">@I18n.FormatCurrency(estimatedAdjustment)</span>
                        </div>
                        <div class="return-settlement-card @(estimatedReceivableAdjustment > 0 ? "due-kpi" : "")">
                            <span class="label">@I18n.T("Due / IPD Deducted")</span>
                            <span class="value">@I18n.FormatCurrency(estimatedReceivableAdjustment)</span>
                        </div>
                        <div class="return-settlement-card refund-kpi">
                            <span class="label">💵 @I18n.T("Cash Refund Payable")</span>
                            <span class="value">@I18n.FormatCurrency(estimatedCashRefund)</span>
                        </div>
                    </div>

                    <!-- Refund Settlement Details (When Cash Refund > 0) -->
                    @if (estimatedCashRefund > 0)
                    {
                        <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:12px; margin-bottom:12px; display:grid; grid-template-columns:1fr 1fr; gap:10px;">
                            <label style="margin:0;">
                                <span style="font-size:11.5px; font-weight:700; color:#334155;">@I18n.T("Refund Method") <span class="required-mark">*</span></span>
                                <select class="classic-input" @bind="refundMethod" style="height:32px; border-radius:6px;">
                                    <option value="Cash">@I18n.T("Cash")</option>
                                </select>
                            </label>
                            <label style="margin:0;">
                                <span style="font-size:11.5px; font-weight:700; color:#334155;">@I18n.T("Refund Reference")</span>
                                <input class="classic-input" @bind="refundReference" maxlength="100" placeholder="@I18n.T("Voucher / reference number (optional)")" style="height:32px; border-radius:6px;" />
                            </label>
                            <div style="grid-column:span 2;">
                                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:3px;">
                                    <span style="font-size:11.5px; font-weight:700; color:#334155;">@I18n.T("Refund Received By") <span class="required-mark">*</span></span>
                                    <button type="button" class="btn btn-ghost" style="padding:1px 6px; font-size:10px; color:#0284c7;" @onclick="() => refundReceivedBy = memo.PatientName">
                                        @I18n.T("Same as Patient")
                                    </button>
                                </div>
                                <input class="classic-input" @bind="refundReceivedBy" maxlength="100" placeholder="@I18n.T("Patient or attendant name who received the cash")" style="height:32px; border-radius:6px; width:100%;" />
                            </div>
                            @if (!canIssueCashRefund)
                            {
                                <div class="alert danger" style="grid-column:span 2; margin:0; padding:6px 10px; font-size:11px;">
                                    ⚠️ @I18n.T("Cash refunds require Cashier or Administrator authorization.")
                                </div>
                            }
                        </div>
                    }

                    <!-- Post Action Bar -->
                    <div class="return-action-bar">
                        <button type="button" class="btn btn-secondary" @onclick="Reset" style="padding:7px 16px;">
                            @I18n.T("Cancel")
                        </button>
                        <button type="button" class="btn btn-primary" @onclick="PostAsync" disabled="@(!CanPostReturn)" style="padding:7px 20px; font-weight:700; display:inline-flex; align-items:center; gap:6px;">
                            @(saving ? I18n.T("Posting…") : (estimatedCashRefund > 0 ? $"✓ {I18n.T("Post Return & Refund")} ({I18n.FormatCurrency(estimatedCashRefund)})" : $"✓ {I18n.T("Post Return & Ledger Adjustment")}"))
                        </button>
                    </div>
                }

                @if (savedReturn is not null && memo is not null)
                {
                    <!-- Official Return Voucher Display -->
                    <div class="return-voucher-card">
                        <div class="return-voucher-header">
                            <div class="return-voucher-title">
                                <span>🧾</span>
                                <h2>@I18n.T("Return Voucher") #@savedReturn.ID</h2>
                                <span class="diagnostic-badge" style="@(savedReturn.Status == "Posted" ? "background:#dcfce7; color:#166534;" : "background:#fee2e2; color:#991b1b;")">
                                    @(savedReturn.Status == "Posted" ? "✓ " + I18n.T("COMPLETED") : "⛔ " + I18n.T("CANCELLED"))
                                </span>
                            </div>
                            <div style="display:flex; gap:8px;">
