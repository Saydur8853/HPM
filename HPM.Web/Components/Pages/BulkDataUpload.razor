@page "/admin/bulk-upload"
@attribute [Authorize(Roles = RoleNames.Administrator)]

<PageTitle>@I18n.T("বাল্ক ডেটা আপলোড", "Bulk Data Upload") | @Branding.HospitalName</PageTitle>

<div class="bu-header">
    <h1>@I18n.T("বাল্ক ডেটা আপলোড", "Bulk Data Upload")</h1>
</div>

<div class="bu-tabs" role="tablist" aria-label="Bulk upload modules">
    @foreach (var tab in Tabs)
    {
        <button type="button"
                role="tab"
                aria-selected="@(activeKey == tab.Key)"
                class="bu-tab @(activeKey == tab.Key ? "active" : "")"
                @onclick="() => activeKey = tab.Key">
            @I18n.T(tab.TitleBn, tab.Title)
        </button>
    }
</div>

<section class="panel bu-panel">
    <BulkUploadWidget TypeKey="@activeKey" ShowFullPageGuide="true" />
</section>

@code {
    [SupplyParameterFromQuery(Name = "type")] public string? QueryType { get; set; }
    private string activeKey = "doctor";

    private static readonly (string Key, string Title, string TitleBn)[] Tabs =
    [
        ("doctor", "Doctor", "ডাক্তার"),
        ("nurse", "Nurse", "নার্স"),
        ("medicine", "Pharmacy Medicine", "ফার্মেসি ঔষধ"),
        ("canteen", "Canteen Food", "ক্যান্টিন খাবার"),
        ("pathology", "Pathology Tests", "প্যাথোলজি টেস্ট"),
        ("imaging", "Imaging Tests", "ইমেজিং টেস্ট")
    ];

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(QueryType) && Tabs.Any(t => t.Key.Equals(QueryType, StringComparison.OrdinalIgnoreCase)))
            activeKey = QueryType.ToLowerInvariant();
    }
}
