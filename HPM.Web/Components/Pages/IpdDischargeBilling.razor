@page "/ipd/discharge-billing"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.Cashier + "," + RoleNames.IPDOperator)]
@rendermode InteractiveServer
@using HPM.Web.Components.Common
@using HPM.Web.Services
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject IBarcodeQrService BarcodeQr
@implements IDisposable

<PageTitle>@I18n.T("Discharge & Final Bill") | @Branding.HospitalName</PageTitle>

<div class="ipd-classic-fit">
    <!-- Compact Top Action & Status Bar -->
    <div class="ipd-classic-topbar">
        <div class="tickets-top-left">
            <h1 class="tickets-page-title">
                <span>💳</span>
                <span>@I18n.T("Final Billing & Patient Discharge")</span>
            </h1>
            <span class="tickets-count-pill">
                @FilteredRecentDischarges.Count() @I18n.T("Discharges")
            </span>
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <span class="tickets-inline-alert @messageClass" title="@message">
                    @(messageClass == "success" ? "✓" : "⚠") @message
                </span>
            }
        </div>

        <div class="tickets-top-actions">
            <button type="button" class="btn btn-secondary tickets-btn" @onclick="Reset" title="@I18n.T("+ Clear / New Search")">
                + @I18n.T("New Search")
            </button>
        </div>
    </div>

    <!-- Main Balanced Workspace Grid: Left Settlement Form, Right Discharges Queue -->
    <div class="ipd-classic-workspace">
        <!-- Left Panel: Account Settlement Card -->
        <div class="ipd-form-card">
            <div class="ipd-card-header">
                <h2>@I18n.T("Patient Account Settlement")</h2>
                @if (selectedAdmission != null)
                {
                    <span class="ipd-badge">
                        @(selectedAdmission.IsAdmitted == true ? I18n.T("CURRENTLY ADMITTED") : I18n.T("DISCHARGED"))
                    </span>
                }
                else
                {
                    <span class="ipd-badge">SELECT INPATIENT</span>
                }
            </div>

            <div class="ipd-form-wrapper">
                <div class="ipd-form-body">
                    <!-- Scanner / Search Bar -->
                    <div class="billing-demographics-grid" style="grid-template-columns: 1fr;">
                        <label>
                            <span>@I18n.T("Scan / Search IPD Reg. No., Wristband QR, or Patient ID *")</span>
                            <div class="tickets-patient-search-combo">
                                <InputText class="classic-input" @bind-Value="searchQuery" placeholder="e.g. I260000001, scan wristband QR or Patient ID" @onkeydown="HandleSearchKeyDownAsync" />
                                <button type="button" class="btn-find" @onclick="SearchAdmissionAsync"><SearchIcon /> @I18n.T("Find")</button>
                            </div>
                        </label>
                    </div>

                    @if (selectedAdmission != null)
                    {
                        <!-- Selected Patient Summary Strip -->
                        <div class="patient-summary" style="margin: 0; padding: 6px 10px; font-size: 11.5px; border-radius: 6px;">
                            <div>
                                <b>@patientName (@selectedAdmission.RegNo)</b>
                                <small style="display: block; margin-top: 1px; color: #64748b;">
                                    ID: @selectedAdmission.PatientID &bull; @I18n.T("Age"): @selectedAdmission.Age &bull; Dr: @DoctorName(selectedAdmission.Consultant)
                                </small>
                            </div>
                            <div style="text-align: right;">
                                <span style="font-size: 10px; color: #64748b; display: block;">@I18n.T("Admitted")</span>
                                <b style="color: #0369a1;">@selectedAdmission.AdmissionDate?.ToString("dd MMM yyyy")</b>
                            </div>
                        </div>

                        <!-- 1. Bed Stay Calculation Table -->
                        <div class="billing-section-heading">1. @I18n.T("Bed & Cabin Stay Calculation")</div>
                        <div class="billing-line-table-wrap" style="max-height: 105px;">
                            <div class="billing-line-head" style="grid-template-columns: minmax(110px, 1.2fr) minmax(90px, 1fr) minmax(90px, 1fr) 50px 75px 85px;">
                                <span>@I18n.T("Bed / Cabin")</span>
                                <span>@I18n.T("Start Date")</span>
                                <span>@I18n.T("End Date")</span>
                                <span style="text-align: center;">@I18n.T("Days")</span>
                                <span style="text-align: right;">@I18n.T("Rate")</span>
                                <span style="text-align: right;">@I18n.T("Total")</span>
                            </div>
                            <div class="billing-line-rows">
                                @foreach (var mov in bedMovements)
                                {
                                    <div class="billing-line-row" style="grid-template-columns: minmax(110px, 1.2fr) minmax(90px, 1fr) minmax(90px, 1fr) 50px 75px 85px;">
                                        <b>@BedName(mov.BedCabinID)</b>
                                        <small>@mov.StartDate.ToString("dd MMM yy hh:mm tt")</small>
                                        <small>@(mov.EndDate?.ToString("dd MMM yy hh:mm tt") ?? I18n.T("Active"))</small>
                                        <span style="text-align: center;">@mov.CalculatedDays</span>
                                        <span style="text-align: right;">@I18n.FormatCurrency(mov.Rate ?? 0)</span>
                                        <strong style="text-align: right;">@I18n.FormatCurrency(mov.TotalAmount)</strong>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- 2. Settlement & Billing Summary -->
                        <div class="billing-section-heading">2. @I18n.T("Settlement & Billing Summary")</div>
                        <div class="billing-demographics-grid" style="grid-template-columns: repeat(6, 1fr);">
                            <label>
                                <span>@I18n.T("Admission Fee")</span>
                                <input class="classic-input" value="@I18n.FormatCurrency(selectedAdmission.AdmissionFee ?? 0)" disabled />
                            </label>
                            <label>
                                <span>@I18n.T("Total Bed Stay")</span>
                                <input class="classic-input" value="@I18n.FormatCurrency(totalBedCharges)" disabled />
                            </label>
                            <label>
                                <span>@I18n.T("Services & Tests")</span>
                                <input class="classic-input" value="@I18n.FormatCurrency(totalServiceCharges)" disabled />
                            </label>
                            <label>
                                <span>@I18n.T("Food & Service")</span>
                                <input class="classic-input" value="@I18n.FormatCurrency(totalHospitalCharges)" disabled />
                            </label>
                            <label>
                                <span>@I18n.T("Ambulance Fee")</span>
                                <input class="classic-input" value="@I18n.FormatCurrency(selectedAdmission.AmbulanceFee ?? 0)" disabled />
                            </label>
                            <label>
                                <span>@I18n.T("Gross Total")</span>
                                <input class="classic-input" style="font-weight: 800; color: #0f766e;" value="@I18n.FormatCurrency(grossTotal)" disabled />
                            </label>
                        </div>

                        <!-- Discount & Receipts Row -->
                        <div class="billing-demographics-grid" style="grid-template-columns: repeat(3, 1fr);">
                            <label>
                                <span>@I18n.T("Special Discount (৳)")</span>
                                <InputNumber class="classic-input" @bind-Value="discountAmount" @bind-Value:after="RecalculateNet" />
                            </label>
                            <label>
                                <span>@I18n.T("Discount Authorized By")</span>
                                <InputText class="classic-input" @bind-Value="discountBy" placeholder="@I18n.T("Required for discount")" />
                            </label>
                            <label>
                                <span>@I18n.T("Active Hospital Receipts")</span>
                                <input class="classic-input" style="color: #0369a1; font-weight: 700;" value="@I18n.FormatCurrency(totalAdvancePaid)" disabled />
                            </label>
                        </div>

                        <!-- Net Payable Banner -->
                        <div style="display: flex; justify-content: space-between; align-items: center; background: #ecfeff; border: 1px solid #a5f3fc; border-radius: 6px; padding: 8px 14px;">
                            <div>
                                <span style="font-size: 10.5px; text-transform: uppercase; color: #0e7490; font-weight: 750;">@I18n.T("Balance Due")</span>
                                <h2 style="margin: 2px 0 0; color: #083344; font-size: 18px; font-weight: 800;">@I18n.FormatCurrency(netPayable)</h2>
                            </div>
                            @if (selectedAdmission.IsAdmitted == true)
                            {
                                <span class="pill pill-danger" style="font-size: 11px;">@I18n.T("Pending Clearance")</span>
                            }
                            else
                            {
                                <span class="pill pill-success" style="font-size: 11px;">@I18n.T("DISCHARGED") &bull; @I18n.T("Bill No") #B@(selectedAdmission.BillNo)</span>
                            }
                        </div>

                        <!-- 3. Discharge Details -->
                        @if (selectedAdmission.IsAdmitted == true)
                        {
                            <div class="billing-section-heading">3. @I18n.T("Discharge & Final Bill")</div>
                            @if (medicalDischargeOrder is null)
                            {
                                <div class="tickets-inline-alert danger" style="max-width: none;">@I18n.T("Medical discharge order is required. The assigned doctor must mark this patient ready before final billing.")</div>
                            }
                            else
                            {
                                <div class="tickets-inline-alert success" style="max-width: none;">
                                    <b>@I18n.T("Medical clearance approved")</b> &bull; @DoctorName(medicalDischargeOrder.DoctorID) &bull; @medicalDischargeOrder.OrderedAt.ToString("dd MMM yy hh:mm tt") &bull; @medicalDischargeOrder.FinalDiagnosis
                                </div>
                            }
                            <div class="billing-demographics-grid" style="grid-template-columns: 180px 180px 1fr;">
                                <label>
                                    <span>@I18n.T("Release / Discharge Date *")</span>
                                    <InputDate Type="InputDateType.DateTimeLocal" class="classic-input" @bind-Value="dischargeDate" @bind-Value:after="RefreshPreviewAsync" />
                                </label>
                                <label>
                                    <span>@I18n.T("Discharge Outcome")</span>
                                    <InputSelect class="classic-input tickets-select" @bind-Value="dischargeOutcome" disabled>
                                        <option value="Cured">Cured / Recovered</option>
                                        <option value="Improved">Improved</option>
                                        <option value="Referred">Referred to Higher Centre</option>
                                        <option value="DOR">Discharge on Request (DOR)</option>
                                        <option value="DAMA">Discharged Against Medical Advice (DAMA)</option>
                                        <option value="Expired">Expired</option>
                                    </InputSelect>
                                </label>
                                <label>
                                    <span>@I18n.T("Discharge Notes / Follow-up Advice")</span>
                                    <InputText class="classic-input" @bind-Value="dischargeNotes" disabled />
                                </label>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="tickets-queue-empty" style="padding: 2.5rem 1rem;">
                            <span style="font-size: 2rem;">💳</span>
                            <span>@I18n.T("Scan or search an active IPD Reg. No. to calculate stay settlement and final bill.")</span>
                        </div>
                    }
                </div>

                <!-- Sticky Footer Actions -->
                <div class="ipd-form-footer">
                    <div style="display: flex; gap: 8px; align-items: center;">
                        @if (selectedAdmission?.IsAdmitted == true)
                        {
                            <button class="btn btn-primary" type="button" @onclick="SettleAndDischargeAsync" disabled="@(isSaving || medicalDischargeOrder is null)" style="font-size: 12px; padding: 5px 14px;">
                                @(isSaving ? I18n.T("Saving…") : I18n.T("Generate Final Bill & Discharge"))
                            </button>
                        }
                        else if (selectedAdmission != null)
                        {
                            <button class="btn btn-secondary tickets-btn" type="button" @onclick="PrintAsync">
                                🖨️ @I18n.T("Print Final Bill")
                            </button>
                            <button class="btn btn-primary tickets-btn" type="button" @onclick="PrintGatePassAsync">
                                🚪 @I18n.T("Print Gate Pass")
                            </button>
                        }
                        <button class="btn btn-ghost" type="button" @onclick="Reset" style="font-size: 12px; padding: 5px 10px;">@I18n.T("Clear")</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Panel: Recent Discharges Queue Card -->
        <div class="ipd-queue-card">
            <div class="ipd-queue-top">
                <h2>@I18n.T("Recent Discharges")</h2>
                <span class="pill pill-success" style="font-size: 10.5px; padding: 2px 7px;">
                    @FilteredRecentDischarges.Count() @I18n.T("discharged")
                </span>
            </div>

            <!-- Scanner Bar -->
            <div class="tickets-scanner-bar">
                <div class="tickets-scanner-input-wrap">
                    <span class="tickets-scanner-icon"><SearchIcon /></span>
                    <input type="text"
                           class="tickets-scanner-input"
                           placeholder="@I18n.T("Filter / scan discharge...")"
                           @bind="recentFilter"
                           @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(recentFilter))
                    {
                        <button type="button" class="tickets-scanner-clear" @onclick="() => recentFilter = string.Empty">✕</button>
                    }
                </div>
            </div>

            <!-- Internal Scrollable Queue List -->
            <div class="tickets-queue-list">
                @if (!FilteredRecentDischarges.Any())
                {
                    <div class="tickets-queue-empty">
                        <span style="font-size: 2rem;">🚪</span>
                        <span>@I18n.T("No recent discharge records found.")</span>
                    </div>
                }
                @foreach (var d in FilteredRecentDischarges)
                {
                    <div class="tickets-queue-item @(selectedAdmission?.ID == d.ID ? "active" : "")" @onclick="() => SelectDischarged(d)">
                        <span class="tickets-queue-serial" style="min-width: 65px; font-size: 11px;">#@(d.BillNo.HasValue ? $"B{d.BillNo}" : "—")</span>
                        <div class="tickets-queue-info">
                            <span class="tickets-queue-name">
                                @(patientNames.GetValueOrDefault(d.PatientID ?? "", "—"))
                                <small class="tickets-queue-reg">(@d.RegNo)</small>
                            </span>
                            <span class="tickets-queue-meta">
                                @d.ReleaseDate?.ToString("dd MMM yy") &bull; @(d.Outcome ?? I18n.T("Discharged"))
                            </span>
                        </div>
                        <div class="tickets-queue-badges">
                            <span class="pill pill-success" style="font-size: 10px;">@I18n.T("DISCHARGED")</span>
                        </div>
                        <div class="tickets-queue-actions" @onclick:stopPropagation>
                            <button class="icon-btn" @onclick="() => SelectDischarged(d)" title="@I18n.T("View")">👁️</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (selectedAdmission != null)
{
    <div id="final-bill-print" class="print-sheet panel">
        <PrintDocumentHeader Title="Official IPD Final Clearance Bill"
                             DocNo="@(selectedAdmission.BillNo.HasValue ? $"B{selectedAdmission.BillNo}" : "PROVISIONAL")"
                             DocNoLabel="Bill No"
                             BarcodeCode="@($"DC-{selectedAdmission.ID}")"
                             QrPayload="@BarcodeQr.GenerateDischargeQrPayload(selectedAdmission.ID, selectedAdmission.RegNo ?? "", patientName, netBillAmount, netPayable <= 0)" />

        <div class="print-grid">
            <div><span>@I18n.T("IPD Reg No:")</span> <b>@selectedAdmission.RegNo</b></div>
            <div><span>@I18n.T("Patient ID")</span> <b>@selectedAdmission.PatientID</b></div>
            <div><span>@I18n.T("Patient Name")</span> <b>@patientName</b></div>
            <div><span>@I18n.T("Age")</span> <b>@selectedAdmission.Age</b></div>
            <div><span>@I18n.T("Admitted:")</span> <b>@selectedAdmission.AdmissionDate?.ToString("dd MMM yyyy hh:mm tt")</b></div>
            <div><span>@I18n.T("Discharge Date & Time"):</span> <b>@((selectedAdmission.ReleaseDate ?? DateTime.Now).ToString("dd MMM yyyy hh:mm tt"))</b></div>
            <div><span>@I18n.T("Consultant Doctor"):</span> <b>@DoctorName(selectedAdmission.Consultant)</b></div>
            <div><span>@I18n.T("Status"):</span> <b>@(selectedAdmission.Outcome ?? dischargeOutcome)</b></div>
        </div>

        <table class="data-table" style="margin-top: 16px;">
            <thead>
                <tr>
                    <th>@I18n.T("Description", "Billing Head / Description")</th>
                    <th class="num">@I18n.T("Amount", "Amount (৳)")</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@I18n.T("Admission Fee")</td>
                    <td class="num">@I18n.FormatCurrency(selectedAdmission.AdmissionFee ?? 0)</td>
                </tr>
                <tr>
                    <td>@I18n.T("Total Bed Charges") (@bedMovements.Sum(x => x.CalculatedDays) @I18n.T("days"))</td>
                    <td class="num">@I18n.FormatCurrency(totalBedCharges)</td>
                </tr>
                @if (totalHospitalCharges > 0)
                {
                    <tr>
                        <td>@I18n.T("Total Hospital & Food Charges")</td>
                        <td class="num">@I18n.FormatCurrency(totalHospitalCharges)</td>
                    </tr>
                }
                @if ((selectedAdmission.AmbulanceFee ?? 0) > 0)
                {
                    <tr>
                        <td>@I18n.T("Ambulance Fee")</td>
                        <td class="num">@I18n.FormatCurrency(selectedAdmission.AmbulanceFee ?? 0)</td>
                    </tr>
                }
                @if (totalServiceCharges > 0)
                {
                    <tr>
                        <td>@I18n.T("Total Service Charges")</td>
                        <td class="num">@I18n.FormatCurrency(totalServiceCharges)</td>
                    </tr>
                }
                <tr style="background:#f8fafc; font-weight:750;">
                    <td><b>@I18n.T("Gross Total")</b></td>
                    <td class="num"><b>@I18n.FormatCurrency(grossTotal)</b></td>
                </tr>
                @if (discountAmount > 0)
                {
                    <tr style="color:#dc2626;">
                        <td>@I18n.T("Special Concession / Discount") @(string.IsNullOrWhiteSpace(discountBy) ? "" : $"({discountBy})")</td>
                        <td class="num">- @I18n.FormatCurrency(discountAmount)</td>
                    </tr>
                }
                <tr style="background:#f8fafc; font-weight:750;">
                    <td><b>@I18n.T("Net Total")</b></td>
                    <td class="num"><b>@I18n.FormatCurrency(netBillAmount)</b></td>
                </tr>
                @if (totalAdvancePaid > 0)
                {
                    <tr style="color:#0369a1;">
                        <td>@I18n.T("Total Receipts / Advances") (@advanceReceipts.Count @I18n.T("item(s)"))</td>
                        <td class="num">- @I18n.FormatCurrency(totalAdvancePaid)</td>
                    </tr>
                }
                @if (excessPayment > 0)
                {
                    <tr style="color:#7c3aed;">
                        <td>@I18n.T("Excess / Refund Due")</td>
                        <td class="num">@I18n.FormatCurrency(excessPayment)</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="print-total">
            <div class="grand">
                <span>@I18n.T("Net Balance Due")</span>
                <b>@I18n.FormatCurrency(netPayable)</b>
            </div>
        </div>

        <PrintDocumentFooter SignTitle1="Patient / Attendant"
                             SignTitle2="Discharge Authority"
                             SignTitle3="Accounts Officer"
                             PageNumberText="Page 1 of 1" />
    </div>

    <div id="gate-pass-print" class="print-sheet panel" style="margin-top:20px;">
        <PrintDocumentHeader Title="Patient Discharge Security Gate Pass"
                             Subtitle="Inpatient Department (IPD) — Security Exit Clearance"
                             DocNo="@selectedAdmission.RegNo"
                             DocNoLabel="IPD Reg. #"
                             BarcodeCode="@($"DC-{selectedAdmission.ID}")"
                             QrPayload="@BarcodeQr.GenerateDischargeQrPayload(selectedAdmission.ID, selectedAdmission.RegNo ?? "", patientName, netBillAmount, netPayable <= 0)" />

        <div style="display:flex; justify-content:space-between; align-items:center; background:#f0fdf4; border:2px solid #86efac; border-radius:8px; padding:16px; margin:16px 0;">
            <div style="flex:1;">
                <h3 style="margin:0 0 8px 0; color:#166534; font-size:16px;">@I18n.T("PATIENT DISCHARGE SECURITY GATE PASS", "Patient Exit Clearance Pass")</h3>
                <div style="color:#374151; font-size:13px; line-height:1.7;">
                    <b>@patientName</b> &nbsp;|&nbsp; @I18n.T("IPD Reg No:"): <b>@selectedAdmission.RegNo</b> &nbsp;|&nbsp; @I18n.T("Patient ID:"): <b>@selectedAdmission.PatientID</b>
                    <br />
                    @I18n.T("Bed / Cabin:"): <b>@BedName(selectedAdmission.BedCabinID ?? 0)</b> &nbsp;|&nbsp; @I18n.T("Consultant:"): <b>@DoctorName(selectedAdmission.Consultant)</b>
                    <br />
                    @I18n.T("Discharge Outcome:"): <b>@(selectedAdmission.Outcome ?? dischargeOutcome)</b> &nbsp;|&nbsp; @I18n.T("Discharge Time:"): <b>@((selectedAdmission.ReleaseDate ?? DateTime.Now).ToString("dd MMM yyyy hh:mm tt"))</b>
                    <br />
                    @I18n.T("Bill Status:"): <b>@(netPayable <= 0 ? I18n.T("PAID & SETTLED IN FULL") : $"{I18n.T("BALANCE DUE:")} {I18n.FormatCurrency(netPayable)}")</b>
                </div>
            </div>
            <div style="margin-left:16px;">
                <span class="pill @(netPayable <= 0 ? "pill-success" : "pill-danger")" style="font-size:12px; font-weight:800; padding:6px 12px; display:inline-block;">
                    @(netPayable <= 0 ? I18n.T("EXIT CLEARANCE APPROVED") : I18n.T("PAYMENT PENDING / DUES REMAIN"))
                </span>
            </div>
        </div>

        <div style="background:#fffbeb; border:1px dashed #f59e0b; border-radius:6px; padding:10px 14px; font-size:12px; color:#92400e; margin-bottom:24px;">
            ℹ️ <b>@I18n.T("Security Gate Instruction:"):</b> @I18n.T("Security officers must scan the QR/Barcode on this pass to verify discharge authorization before permitting hospital exit. Retain this slip or stamp upon exit.")
        </div>

        <PrintDocumentFooter SignTitle1="Discharge Billing Officer"
                             SignTitle2="Nursing Supervisor"
                             SignTitle3="Security Gate Officer"
                             PageNumberText="Page 1 of 1" />
    </div>
}

@code {
    private PatientAdmission? selectedAdmission;
    private IpdFinalBill? finalBill;
    private IpdMedicalDischargeOrder? medicalDischargeOrder;
    private List<PatientAdmission> recentDischarges = [];
    private List<CalculatedBedMovement> bedMovements = [];
    private List<IpdPatientServiceItem> serviceItems = [];
    private List<IpdMoneyReceipt> advanceReceipts = [];
    private List<BedCabin> beds = [];
    private List<DoctorsProfile> doctors = [];
    private Dictionary<string, string> patientNames = new(StringComparer.OrdinalIgnoreCase);

    private string searchQuery = "";
    private string recentFilter = "";
    private string patientName = "";
    private DateTime dischargeDate = DateTime.Now;
    private string dischargeOutcome = "Cured";
    private string dischargeNotes = "";
    private decimal discountAmount = 0;
    private string discountBy = "";

    private decimal totalBedCharges = 0;
    private decimal totalServiceCharges = 0;
    private decimal totalHospitalCharges = 0;
    private decimal totalAdvancePaid = 0;
    private decimal grossTotal = 0;
    private decimal netBillAmount = 0;
    private decimal netPayable = 0;
    private decimal excessPayment = 0;
    private bool isSaving;

    private string message = "";
    private string messageClass = "success";

    private IEnumerable<PatientAdmission> FilteredRecentDischarges
    {
        get
        {
            if (string.IsNullOrWhiteSpace(recentFilter)) return recentDischarges;
            var q = recentFilter.Trim();
            return recentDischarges.Where(x =>
                (x.RegNo?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.PatientID?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.BillNo?.ToString().Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (patientNames.GetValueOrDefault(x.PatientID ?? "", "").Contains(q, StringComparison.OrdinalIgnoreCase)));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        await LoadAsync();
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    private async Task HandleSearchKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAdmissionAsync();
        }
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        beds = await db.BedCabins.AsNoTracking().ToListAsync();
        doctors = await db.Doctors.AsNoTracking().Where(x => x.Name != null).ToListAsync();
        recentDischarges = await db.PatientAdmissions.AsNoTracking()
            .Where(x => x.IsAdmitted == false && x.ReleaseDate != null)
            .OrderByDescending(x => x.ReleaseDate)
            .Take(50)
            .ToListAsync();

        var pIds = recentDischarges.Where(x => !string.IsNullOrWhiteSpace(x.PatientID)).Select(x => x.PatientID!).Distinct().ToArray();
        patientNames = pIds.Length == 0 ? new(StringComparer.OrdinalIgnoreCase) : await db.Registrations.AsNoTracking().Where(x => pIds.Contains(x.PatientID)).ToDictionaryAsync(x => x.PatientID, x => x.Name, StringComparer.OrdinalIgnoreCase);
    }

    private async Task SearchAdmissionAsync()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            Fail(I18n.IsBangla ? "আইপিডি রেজি. নং বা পেশেন্ট আইডি লিখুন।" : "Enter an IPD Reg No or Patient ID.");
            return;
        }

        var q = searchQuery.Trim();
        await using var db = await DbFactory.CreateDbContextAsync();
        PatientAdmission? adm = null;

        if (q.StartsWith("HPM:WB|", StringComparison.OrdinalIgnoreCase))
        {
            var parts = q.Split('|');
            if (parts.Length > 1)
            {
                var ipdPart = parts[1].Replace("IPD-", "", StringComparison.OrdinalIgnoreCase);
                if (int.TryParse(ipdPart, out var admId))
                    adm = await db.PatientAdmissions.AsNoTracking().FirstOrDefaultAsync(x => x.ID == admId);
            }
            if (adm == null && parts.Length > 2)
            {
                var patId = parts[2];
                adm = await db.PatientAdmissions.AsNoTracking().OrderByDescending(x => x.AdmissionDate).FirstOrDefaultAsync(x => x.PatientID == patId);
            }
        }
        else if (q.StartsWith("HPM:IPD|", StringComparison.OrdinalIgnoreCase) || q.StartsWith("HPM:DC|", StringComparison.OrdinalIgnoreCase))
        {
            var parts = q.Split('|');
            if (parts.Length > 1 && int.TryParse(parts[1], out var admId))
                adm = await db.PatientAdmissions.AsNoTracking().FirstOrDefaultAsync(x => x.ID == admId);
            else if (parts.Length > 2)
                adm = await db.PatientAdmissions.AsNoTracking().FirstOrDefaultAsync(x => x.RegNo == parts[2]);
        }
        else if (q.StartsWith("DC-", StringComparison.OrdinalIgnoreCase))
        {
            if (int.TryParse(q[3..], out var admId))
                adm = await db.PatientAdmissions.AsNoTracking().FirstOrDefaultAsync(x => x.ID == admId || (x.BillNo.HasValue && x.BillNo.Value == admId));
        }
        else if (q.StartsWith("HPM:PAT|", StringComparison.OrdinalIgnoreCase))
        {
            var parts = q.Split('|');
            if (parts.Length > 1)
                adm = await db.PatientAdmissions.AsNoTracking().OrderByDescending(x => x.AdmissionDate).FirstOrDefaultAsync(x => x.PatientID == parts[1]);
        }
        else
        {
            var bStripped = q.StartsWith("B", StringComparison.OrdinalIgnoreCase) ? q[1..] : q;
            int.TryParse(bStripped, out var parsedNum);
            adm = await db.PatientAdmissions.AsNoTracking()
                .FirstOrDefaultAsync(x => x.RegNo == q || x.PatientID == q || (parsedNum > 0 && x.BillNo == parsedNum));
        }

        if (adm == null)
        {
            Fail(I18n.IsBangla ? "আইপিডি ভর্তি রেকর্ড পাওয়া যায়নি।" : "IPD admission record was not found.");
            return;
        }

        selectedAdmission = adm;
        var p = adm.PatientID == null ? null : await db.Registrations.AsNoTracking().FirstOrDefaultAsync(x => x.PatientID == adm.PatientID);
        patientName = p?.Name ?? "—";
        dischargeDate = adm.ReleaseDate ?? DateTime.Now;
        dischargeOutcome = adm.Outcome ?? "Cured";
        dischargeNotes = string.Empty;
        finalBill = null;
        medicalDischargeOrder = await db.IpdMedicalDischargeOrders.AsNoTracking().SingleOrDefaultAsync(x => x.AdmissionID == adm.ID && x.Status != "Cancelled");
        if (adm.IsAdmitted == true && medicalDischargeOrder?.Status == "Ready")
        {
            dischargeOutcome = medicalDischargeOrder.Outcome;
            dischargeNotes = BuildMedicalDischargeNotes(medicalDischargeOrder);
        }

        await CalculateSettlementAsync(adm);
        message = "";
    }

    private async Task CalculateSettlementAsync(PatientAdmission adm)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var snapshot = await BuildSettlementSnapshotAsync(db, adm, adm.ReleaseDate ?? DateTime.Now);
        bedMovements = snapshot.BedMovements;
        serviceItems = snapshot.ServiceItems;

        finalBill = await db.IpdFinalBills.AsNoTracking().SingleOrDefaultAsync(x => x.AdmissionID == adm.ID);
        if (finalBill is not null)
        {
            var receiptIds = await db.IpdFinalBillReceipts.AsNoTracking()
                .Where(x => x.BillNo == finalBill.BillNo)
                .Select(x => x.MoneyReceiptID)
                .ToListAsync();
            advanceReceipts = receiptIds.Count == 0
                ? []
                : await db.IpdMoneyReceipts.AsNoTracking().Where(x => receiptIds.Contains(x.ID)).OrderBy(x => x.TransDate).ToListAsync();
            totalBedCharges = finalBill.BedCharges;
            totalServiceCharges = finalBill.ServiceCharges;
            totalHospitalCharges = finalBill.HospitalCharges;
            grossTotal = finalBill.GrossAmount;
            discountAmount = finalBill.DiscountAmount;
            discountBy = finalBill.DiscountAuthorizedBy ?? string.Empty;
            totalAdvancePaid = finalBill.ReceiptAmount;
            netBillAmount = finalBill.NetAmount;
            netPayable = finalBill.BalanceDue;
            excessPayment = finalBill.ExcessPayment;
            dischargeNotes = finalBill.DischargeNotes ?? string.Empty;
            return;
        }

        advanceReceipts = snapshot.ActiveReceipts;
        totalBedCharges = snapshot.BedCharges;
        totalServiceCharges = snapshot.ServiceCharges;
        totalHospitalCharges = snapshot.HospitalCharges;
        totalAdvancePaid = snapshot.ActiveReceipts.Sum(x => x.Amount);
        grossTotal = snapshot.GrossAmount;
        discountAmount = 0;
        discountBy = string.Empty;
        excessPayment = 0;
        RecalculateNet();
    }

    private void RecalculateNet()
    {
        netBillAmount = Math.Max(0, grossTotal - discountAmount);
        netPayable = Math.Max(0, netBillAmount - totalAdvancePaid);
        excessPayment = Math.Max(0, totalAdvancePaid - netBillAmount);
    }

    private async Task RefreshPreviewAsync()
    {
        if (selectedAdmission is null || finalBill is not null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var snapshot = await BuildSettlementSnapshotAsync(db, selectedAdmission, dischargeDate);
        bedMovements = snapshot.BedMovements;
        serviceItems = snapshot.ServiceItems;
        advanceReceipts = snapshot.ActiveReceipts;
        totalBedCharges = snapshot.BedCharges;
        totalServiceCharges = snapshot.ServiceCharges;
        totalHospitalCharges = snapshot.HospitalCharges;
        totalAdvancePaid = snapshot.ActiveReceipts.Sum(x => x.Amount);
        grossTotal = snapshot.GrossAmount;
        RecalculateNet();
    }

    private async Task SettleAndDischargeAsync()
    {
        if (selectedAdmission == null) return;
        if (medicalDischargeOrder?.Status != "Ready") { Fail(I18n.T("An approved medical discharge order is required before final billing.")); return; }
        if (dischargeDate < (selectedAdmission.AdmissionDate ?? DateTime.MinValue)) { Fail(I18n.IsBangla ? "ছাড়পত্রের তারিখ ভর্তির পূর্বের হতে পারবে না।" : "Discharge date cannot be before admission."); return; }
        if (dischargeDate > DateTime.Now.AddMinutes(1)) { Fail(I18n.IsBangla ? "ভবিষ্যতের তারিখ দেওয়া যাবে না।" : "Discharge date cannot be in the future."); return; }
        if (discountAmount < 0 || discountAmount > grossTotal) { Fail(I18n.IsBangla ? "ছাড়ের পরিমাণ মোট বিলের মধ্যে হতে হবে।" : "Discount must be between zero and the gross bill amount."); return; }
        if (discountAmount > 0 && string.IsNullOrWhiteSpace(discountBy)) { Fail(I18n.IsBangla ? "ছাড়ের জন্য অনুমোদনকারী ব্যক্তির নাম আবশ্যক।" : "Discount authorization is required."); return; }
        if ((discountBy?.Trim().Length ?? 0) > 100) { Fail(I18n.IsBangla ? "অনুমোদনকারীর নাম ১০০ অক্ষরের বেশি হতে পারবে না।" : "Discount authorization cannot exceed 100 characters."); return; }
        if ((dischargeNotes?.Trim().Length ?? 0) > 1000) { Fail(I18n.IsBangla ? "মন্তব্য ১০০০ অক্ষরের বেশি হতে পারবে না।" : "Discharge notes cannot exceed 1000 characters."); return; }
        
        var confirmMsg = I18n.IsBangla ? $"আইপিডি রেজি {selectedAdmission.RegNo}-এর চূড়ান্ত বিল নিষ্পত্তি ও ছাড়পত্র নিশ্চিত করছেন?" : $"Confirm settlement & discharge for IPD Reg {selectedAdmission.RegNo}?";
        if (!await JS.InvokeAsync<bool>("hpm.confirm", confirmMsg)) return;

        isSaving = true;
        try
        {
            var entityId = selectedAdmission.ID;
            var curDischargeDate = dischargeDate;
            var curDiscountAmount = discountAmount;
            var curDiscountBy = discountBy;

            await using var strategyDb = await DbFactory.CreateDbContextAsync();
            var strategy = strategyDb.Database.CreateExecutionStrategy();
            PatientAdmission? updatedEntity = null;
            IpdFinalBill? savedBill = null;

            await strategy.ExecuteAsync(async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                await using var tx = await db.Database.BeginTransactionAsync(System.Data.IsolationLevel.Serializable);

                var entity = await db.PatientAdmissions.FindAsync(entityId);
                if (entity == null) throw new InvalidOperationException("Admission not found.");
                if (entity.IsAdmitted != true) throw new InvalidOperationException(I18n.IsBangla ? "এই রোগীকে আগেই ছাড়পত্র দেওয়া হয়েছে।" : "This patient is already discharged.");
                if (await db.IpdFinalBills.AnyAsync(x => x.AdmissionID == entity.ID))
                    throw new InvalidOperationException(I18n.IsBangla ? "এই ভর্তির জন্য ইতিমধ্যে একটি চূড়ান্ত বিল তৈরি আছে।" : "A final bill already exists for this admission.");
                var medicalOrder = await db.IpdMedicalDischargeOrders.SingleOrDefaultAsync(x => x.AdmissionID == entity.ID && x.Status == "Ready")
                    ?? throw new InvalidOperationException(I18n.T("The approved medical discharge order is missing or was cancelled."));
                var outcome = medicalOrder.Outcome;
                var notes = BuildMedicalDischargeNotes(medicalOrder);

                var snapshot = await BuildSettlementSnapshotAsync(db, entity, curDischargeDate);
                if (curDiscountAmount > snapshot.GrossAmount)
                    throw new InvalidOperationException(I18n.IsBangla ? "ছাড়ের পরিমাণ মোট টাকার বেশি হতে পারে না।" : "Discount cannot exceed the current gross bill amount.");

                var userId = await CurrentUserIdAsync();
                await FinancialControl.EnsurePostingAllowedAsync(db, curDischargeDate, userId);
                var netAmount = snapshot.GrossAmount - curDiscountAmount;
                var receiptAmount = snapshot.ActiveReceipts.Sum(x => x.Amount);
                var directReceiptAmount = snapshot.ActiveReceipts
                    .Where(x => !string.Equals(x.Against, "Advance", StringComparison.OrdinalIgnoreCase))
                    .Sum(x => x.Amount);
                var advanceAmount = snapshot.ActiveReceipts
                    .Where(x => string.Equals(x.Against, "Advance", StringComparison.OrdinalIgnoreCase))
                    .Sum(x => x.Amount);
                var appliedAdvanceAmount = Math.Min(advanceAmount, Math.Max(0, netAmount - directReceiptAmount));
                var balanceDue = Math.Max(0, netAmount - receiptAmount);
                var creditBalance = Math.Max(0, receiptAmount - netAmount);

                var bill = new IpdFinalBill
                {
                    AdmissionID = entity.ID,
                    MedicalDischargeOrderID = medicalOrder.ID,
                    RegNo = entity.RegNo,
                    AdmissionFee = entity.AdmissionFee ?? 0,
                    BedCharges = snapshot.BedCharges,
                    ServiceCharges = snapshot.ServiceCharges,
                    HospitalCharges = snapshot.HospitalCharges,
                    AmbulanceCharges = entity.AmbulanceFee ?? 0,
                    GrossAmount = snapshot.GrossAmount,
                    DiscountAmount = curDiscountAmount,
                    DiscountAuthorizedBy = string.IsNullOrWhiteSpace(curDiscountBy) ? null : curDiscountBy.Trim(),
                    NetAmount = netAmount,
                    ReceiptAmount = receiptAmount,
                    AppliedAdvanceAmount = appliedAdvanceAmount,
                    BalanceDue = balanceDue,
                    ExcessPayment = creditBalance,
                    SettlementStatus = balanceDue > 0 ? "Due" : creditBalance > 0 ? "Credit" : "Settled",
                    DischargeDate = curDischargeDate,
                    Outcome = outcome,
                    DischargeNotes = string.IsNullOrWhiteSpace(notes) ? null : notes.Trim(),
                    GeneratedBy = userId,
                    GeneratedAt = DateTime.Now
                };
                db.IpdFinalBills.Add(bill);
                await db.SaveChangesAsync();

                foreach (var receipt in snapshot.ActiveReceipts)
                    db.IpdFinalBillReceipts.Add(new IpdFinalBillReceipt
                    {
                        BillNo = bill.BillNo,
                        MoneyReceiptID = receipt.ID,
                        Amount = receipt.Amount,
                        Against = receipt.Against
                    });

                if (netAmount > 0)
                    AccountingPosting.AddPostedVoucher(db, "Journal", curDischargeDate,
                        $"IPD final bill #{bill.BillNo} for {entity.RegNo}", $"IPD-FINAL-BILL:{bill.BillNo}", userId,
                        (AccountingPosting.PatientReceivable, netAmount, 0),
                        (AccountingPosting.HospitalRevenue, 0, netAmount));

                if (appliedAdvanceAmount > 0)
                    AccountingPosting.AddPostedVoucher(db, "Journal", curDischargeDate,
                        $"Apply IPD advance to final bill #{bill.BillNo}", $"IPD-ADVANCE-APPLY:{bill.BillNo}", userId,
                        (AccountingPosting.PatientAdvance, appliedAdvanceAmount, 0),
                        (AccountingPosting.PatientReceivable, 0, appliedAdvanceAmount));

                entity.BillNo = bill.BillNo;
                entity.IsAdmitted = false;
                entity.ReleaseDate = curDischargeDate;
                entity.Outcome = outcome;
                entity.BillGeneratedBy = userId;
                medicalOrder.Status = "Completed";
                medicalOrder.CompletedBy = userId;
                medicalOrder.CompletedAt = DateTime.Now;

                if (!string.IsNullOrWhiteSpace(notes))
                {
                    var note = $"Discharge: {notes.Trim()}";
                    var combined = string.IsNullOrWhiteSpace(entity.Comments) ? note : $"{entity.Comments} | {note}";
                    entity.Comments = combined.Length <= 200 ? combined : combined[..200];
                }

                var openTx = await db.BedCabinTransactions.Where(x => x.RegNo == entity.RegNo && x.EndDate == null).ToListAsync();
                foreach (var t in openTx) t.EndDate = curDischargeDate;

                if (entity.BedCabinID.HasValue)
                {
                    var bed = await db.BedCabins.FindAsync(entity.BedCabinID.Value);
                    if (bed != null)
                    {
                        bed.IsAllocated = false;
                        bed.Status = BedStatuses.Cleaning;
                        var openTurnover = await db.BedTurnovers.AnyAsync(x => x.BedCabinID == bed.ID
                            && (x.Status == "Cleaning" || x.Status == "AwaitingApproval"));
                        if (!openTurnover)
                        {
                            db.BedTurnovers.Add(new BedTurnover
                            {
                                BedCabinID = bed.ID,
                                AdmissionID = entity.ID,
                                RegNo = entity.RegNo,
                                Status = "Cleaning",
                                RequestedAt = DateTime.Now
                            });
                        }
                    }
                }

                await db.SaveChangesAsync();
                await tx.CommitAsync();

                updatedEntity = entity;
                savedBill = bill;
                dischargeOutcome = outcome;
                dischargeNotes = notes;
            });

            Success(I18n.IsBangla ? $"রোগী {updatedEntity?.RegNo}-কে সফলভাবে ছাড়পত্র দেওয়া হয়েছে। চূড়ান্ত বিল #B{savedBill?.BillNo} (স্ট্যাটাস: {savedBill?.SettlementStatus})" : $"Patient {updatedEntity?.RegNo} discharged. Final bill #B{savedBill?.BillNo} saved with status {savedBill?.SettlementStatus}.");
            selectedAdmission = updatedEntity;
            await LoadAsync();
            if (updatedEntity != null) await CalculateSettlementAsync(updatedEntity);
        }
        catch (Exception ex)
        {
            Fail(I18n.IsBangla ? $"ছাড়পত্র দেওয়া যায়নি: {ex.GetBaseException().Message}" : $"Discharge failed: {ex.GetBaseException().Message}");
        }
        finally { isSaving = false; }
    }

    private static async Task<SettlementSnapshot> BuildSettlementSnapshotAsync(
        HpmDbContext db, PatientAdmission admission, DateTime calculationDate)
    {
        var rawMovements = await db.BedCabinTransactions.AsNoTracking()
            .Where(x => x.RegNo == admission.RegNo && x.StartDate <= calculationDate)
            .OrderBy(x => x.StartDate)
            .ToListAsync();
        var movements = new List<CalculatedBedMovement>();
        if (rawMovements.Count == 1)
        {
            var m = rawMovements[0];
            var end = m.EndDate ?? calculationDate;
            var days = Math.Max(1, (int)Math.Ceiling((end - m.StartDate).TotalDays));
            var rate = m.Rate ?? 0;
            movements.Add(new CalculatedBedMovement
            {
                BedCabinID = m.BedCabinID,
                StartDate = m.StartDate,
                EndDate = m.EndDate,
                CalculatedDays = days,
                Rate = rate,
                TotalAmount = days * rate
            });
        }
        else if (rawMovements.Count > 1)
        {
            var overallStart = rawMovements[0].StartDate;
            var overallEnd = rawMovements[^1].EndDate ?? calculationDate;
            var totalExpectedDays = Math.Max(1, (int)Math.Ceiling((overallEnd - overallStart).TotalDays));
            var allocatedDays = 0;
            for (var i = 0; i < rawMovements.Count; i++)
            {
                var m = rawMovements[i];
                var end = m.EndDate ?? calculationDate;
                var durationDays = (end - m.StartDate).TotalDays;
                int days;
                if (i == rawMovements.Count - 1)
                {
                    days = Math.Max(0, totalExpectedDays - allocatedDays);
                    if (days == 0 && totalExpectedDays > 0 && allocatedDays == 0) days = 1;
                }
                else
                {
                    days = (int)Math.Floor(durationDays);
                    if (durationDays >= 0.5 && days == 0 && allocatedDays < totalExpectedDays)
                    {
                        days = 1;
                    }
                }
                allocatedDays += days;
                var rate = m.Rate ?? 0;
                movements.Add(new CalculatedBedMovement
                {
                    BedCabinID = m.BedCabinID,
                    StartDate = m.StartDate,
                    EndDate = m.EndDate,
                    CalculatedDays = days,
                    Rate = rate,
                    TotalAmount = days * rate
                });
            }
        }

        var services = await db.IpdPatientServiceItems.AsNoTracking()
            .Where(x => x.RegNo == admission.RegNo && x.ServiceDate <= calculationDate)
            .ToListAsync();
        var extension = await db.AdmissionExtensions.AsNoTracking()
            .FirstOrDefaultAsync(x => x.RegNo == admission.RegNo);

        var receipts = await db.IpdMoneyReceipts.AsNoTracking()
            .Where(x => x.RegNo == admission.RegNo && x.Against != "DoctorPayment" && x.TransDate <= calculationDate)
            .OrderBy(x => x.TransDate)
            .ToListAsync();
        if (receipts.Count > 0)
        {
            var receiptIds = receipts.Select(x => x.ID).ToArray();
            var reversedIds = (await db.FinancialReversals.AsNoTracking()
                .Where(x => x.EntityType == "IPD Money Receipt" && receiptIds.Contains(x.EntityID))
                .Select(x => x.EntityID)
                .ToListAsync()).ToHashSet();
            receipts = receipts.Where(x => !reversedIds.Contains(x.ID)).ToList();
        }

        var bedCharges = movements.Sum(x => x.TotalAmount);
        var serviceCharges = services.Sum(x => x.Total);
        var hospitalCharges = (extension?.ServiceCharge ?? 0) + (extension?.Food ?? 0);
        var gross = (admission.AdmissionFee ?? 0) + (admission.AmbulanceFee ?? 0)
            + bedCharges + serviceCharges + hospitalCharges;
        return new SettlementSnapshot(movements, services, receipts, bedCharges, serviceCharges, hospitalCharges, gross);
    }

    private async Task<int> CurrentUserIdAsync()
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        var value = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (!int.TryParse(value, out var id))
            throw new InvalidOperationException("The signed-in user could not be identified.");
        return id;
    }

    private async Task SelectDischarged(PatientAdmission d)
    {
        searchQuery = d.RegNo;
        await SearchAdmissionAsync();
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("hpm.printElement", "final-bill-print");
    private async Task PrintGatePassAsync() => await JS.InvokeVoidAsync("hpm.printElement", "gate-pass-print");

    private void Reset()
    {
        selectedAdmission = null;
        finalBill = null;
        medicalDischargeOrder = null;
        patientName = "";
        searchQuery = "";
        bedMovements.Clear();
        serviceItems.Clear();
        advanceReceipts.Clear();
        discountAmount = 0;
        discountBy = "";
        totalBedCharges = 0;
        totalServiceCharges = 0;
        totalHospitalCharges = 0;
        totalAdvancePaid = 0;
        grossTotal = 0;
        netBillAmount = 0;
        netPayable = 0;
        excessPayment = 0;
        message = "";
    }

    private string BedName(int id) => beds.FirstOrDefault(x => x.ID == id)?.Name ?? "—";
    private string DoctorName(int? id)
    {
        var d = doctors.FirstOrDefault(x => x.ID == id);
        return d == null ? "—" : $"{d.Title} {d.Name}";
    }

    private static string BuildMedicalDischargeNotes(IpdMedicalDischargeOrder order)
    {
        var parts = new[] { $"Final diagnosis: {order.FinalDiagnosis}", string.IsNullOrWhiteSpace(order.ConditionAtDischarge) ? null : $"Condition: {order.ConditionAtDischarge}", $"Advice: {order.Advice}", string.IsNullOrWhiteSpace(order.FollowUp) ? null : $"Follow-up: {order.FollowUp}" };
        var text = string.Join(" | ", parts.Where(x => !string.IsNullOrWhiteSpace(x)));
        return text.Length <= 1000 ? text : text[..1000];
    }

    private void Success(string text) { messageClass = "alert success"; message = text; }
    private void Fail(string text) { messageClass = "alert danger"; message = text; }

    public void Dispose()
    {
        I18n.OnLanguageChanged -= HandleLanguageChanged;
    }

    private sealed class CalculatedBedMovement
    {
        public int BedCabinID { get; set; }
        public DateTime StartDate { get; set; }
        public DateTime? EndDate { get; set; }
        public int CalculatedDays { get; set; }
        public decimal? Rate { get; set; }
        public decimal TotalAmount { get; set; }
    }

    private sealed record SettlementSnapshot(
        List<CalculatedBedMovement> BedMovements,
        List<IpdPatientServiceItem> ServiceItems,
        List<IpdMoneyReceipt> ActiveReceipts,
        decimal BedCharges,
        decimal ServiceCharges,
        decimal HospitalCharges,
        decimal GrossAmount);
}
