@code {
    private PatientAdmission? selectedAdmission;
    private IpdFinalBill? finalBill;
    private IpdMedicalDischargeOrder? medicalDischargeOrder;
    private List<PatientAdmission> readyAdmissions = [];
    private List<PatientAdmission> recentDischarges = [];
    private Dictionary<long, IpdMedicalDischargeOrder> readyOrders = [];
    private List<CalculatedBedMovement> bedMovements = [];
    private List<IpdPatientServiceItem> serviceItems = [];
    private List<IpdMoneyReceipt> advanceReceipts = [];
    private List<BedCabin> beds = [];
    private List<DoctorsProfile> doctors = [];
    private Dictionary<string, string> patientNames = new(StringComparer.OrdinalIgnoreCase);

    // KPI Metrics
    private int todayDischargesCount = 0;
    private decimal todaySettlementTotal = 0;
    private int activeInpatientsCount = 0;

    private string searchQuery = "";
    private string recentFilter = "";
    private string rightQueueMode = "Ready";
    private string patientName = "";
    private DateTime dischargeDate = DateTime.Now;
    private string dischargeOutcome = "Cured";
    private string dischargeNotes = "";
    private decimal discountAmount = 0;
    private string discountBy = "";

    private decimal totalBedCharges = 0;
    private decimal totalServiceCharges = 0;
    private decimal totalHospitalCharges = 0;
    private decimal totalAdvancePaid = 0;
    private decimal grossTotal = 0;
    private decimal netBillAmount = 0;
    private decimal netPayable = 0;
    private decimal excessPayment = 0;
    private bool isSaving;

    private string message = "";
    private string messageClass = "success";

    private DotNetObjectReference<IpdDischargeBilling>? dotNetRef;
    private bool showPatientSuggestions = false;
    private bool isLoadingMorePatients = false;
    private bool hasMorePatientSuggestions = false;
    private const int PatientSuggestionBatchSize = 15;
    private List<PatientAdmission> suggestedAdmissions = [];

    private IEnumerable<PatientAdmission> FilteredRecentDischarges
    {
        get
        {
            if (string.IsNullOrWhiteSpace(recentFilter)) return recentDischarges;
            var q = recentFilter.Trim();
            return recentDischarges.Where(x =>
                (x.RegNo?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.PatientID?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.BillNo?.ToString().Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                patientNames.GetValueOrDefault(x.PatientID ?? "", "").Contains(q, StringComparison.OrdinalIgnoreCase) ||
                BedName(x.BedCabinID ?? 0).Contains(q, StringComparison.OrdinalIgnoreCase));
        }
    }

    private IEnumerable<PatientAdmission> FilteredReadyAdmissions
    {
        get
        {
            if (string.IsNullOrWhiteSpace(recentFilter)) return readyAdmissions;
            var q = recentFilter.Trim();
            return readyAdmissions.Where(x =>
                (x.RegNo?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.PatientID?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                patientNames.GetValueOrDefault(x.PatientID ?? "", "").Contains(q, StringComparison.OrdinalIgnoreCase) ||
                BedName(x.BedCabinID ?? 0).Contains(q, StringComparison.OrdinalIgnoreCase));
        }
    }

    private static IQueryable<PatientAdmission> BuildPatientSuggestionQuery(HpmDbContext db, string term)
    {
        var query = db.PatientAdmissions.AsNoTracking();
        if (string.IsNullOrWhiteSpace(term))
        {
            query = query.Where(x => x.IsAdmitted == true);
        }
        else
        {
            query = query.Where(a => a.RegNo.Contains(term)
                || (a.PatientID != null && a.PatientID.Contains(term))
                || db.Registrations.Any(r => r.PatientID == a.PatientID
                    && (r.Name.Contains(term) || (r.Contact != null && r.Contact.Contains(term))))
                || db.BedCabins.Any(b => b.ID == a.BedCabinID && b.Name.Contains(term)));
        }
        return query.OrderByDescending(x => x.IsAdmitted)
                    .ThenByDescending(x => x.AdmissionDate)
                    .ThenByDescending(x => x.ID);
    }

    private async Task CacheSuggestionPatientsAsync(HpmDbContext db, IEnumerable<PatientAdmission> admissions)
    {
        var batch = admissions.ToList();
        var pIds = batch.Where(x => !string.IsNullOrWhiteSpace(x.PatientID) && !patientNames.ContainsKey(x.PatientID!))
                        .Select(x => x.PatientID!)
                        .Distinct()
                        .ToArray();
        if (pIds.Length > 0)
        {
            var newNames = await db.Registrations.AsNoTracking()
                .Where(x => pIds.Contains(x.PatientID))
                .ToDictionaryAsync(x => x.PatientID, x => x.Name, StringComparer.OrdinalIgnoreCase);
            foreach (var kvp in newNames)
            {
                patientNames[kvp.Key] = kvp.Value;
            }
        }
    }

    private async Task LoadPatientSuggestionsAsync(bool reset)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var query = BuildPatientSuggestionQuery(db, searchQuery.Trim());
        var skip = reset ? 0 : suggestedAdmissions.Count;
        var batch = await query.Skip(skip).Take(PatientSuggestionBatchSize).ToListAsync();
        await CacheSuggestionPatientsAsync(db, batch);

        if (reset)
        {
            suggestedAdmissions = batch;
            try { await JS.InvokeVoidAsync("hpm.resetPatientIdScrollTop", "ipd-discharge-patient-suggestions-list"); } catch { }
        }
        else
        {
            suggestedAdmissions.AddRange(batch);
        }

        hasMorePatientSuggestions = batch.Count == PatientSuggestionBatchSize;
        showPatientSuggestions = true;
    }

    private async Task HandleSearchInputAsync(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        await LoadPatientSuggestionsAsync(reset: true);
    }

    private async Task ShowPatientSuggestionsAsync()
    {
        await LoadPatientSuggestionsAsync(reset: true);
    }

    private void HidePatientSuggestions()
    {
        showPatientSuggestions = false;
    }

    private Task LoadMorePatientSuggestionsAsync() => LoadMorePatientsFromJs();

    [JSInvokable]
    public async Task LoadMorePatientsFromJs()
    {
        if (isLoadingMorePatients || !hasMorePatientSuggestions || !showPatientSuggestions) return;
        isLoadingMorePatients = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            await LoadPatientSuggestionsAsync(reset: false);
        }
        catch
        {
            hasMorePatientSuggestions = false;
        }
        finally
        {
            isLoadingMorePatients = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SelectSuggestionAsync(PatientAdmission adm)
    {
        showPatientSuggestions = false;
        searchQuery = adm.RegNo;
        await SearchAdmissionAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        dotNetRef ??= DotNetObjectReference.Create(this);
        if (!showPatientSuggestions) return;

        try
        {
            await JS.InvokeVoidAsync("hpm.initPatientIdScroll", "ipd-discharge-patient-suggestions-list", dotNetRef, nameof(LoadMorePatientsFromJs));
        }
        catch { }
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    private async Task HandleSearchKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            showPatientSuggestions = false;
            await SearchAdmissionAsync();
        }
        else if (e.Key == "Escape")
        {
            showPatientSuggestions = false;
        }
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        beds = await db.BedCabins.AsNoTracking().ToListAsync();
        doctors = await db.Doctors.AsNoTracking().Where(x => x.Name != null).ToListAsync();
        readyOrders = await db.IpdMedicalDischargeOrders.AsNoTracking()
            .Where(x => x.Status == "Ready")
            .OrderBy(x => x.OrderedAt)
            .ToDictionaryAsync(x => x.AdmissionID);
        var readyAdmissionIds = readyOrders.Keys.ToArray();
        readyAdmissions = readyAdmissionIds.Length == 0
            ? []
            : await db.PatientAdmissions.AsNoTracking()
                .Where(x => x.IsAdmitted == true && readyAdmissionIds.Contains(x.ID))
                .OrderBy(x => x.AdmissionDate)
                .ToListAsync();
        recentDischarges = await db.PatientAdmissions.AsNoTracking()
            .Where(x => x.IsAdmitted == false && x.ReleaseDate != null)
            .OrderByDescending(x => x.ReleaseDate)
            .Take(50)
            .ToListAsync();

        var todayStart = DateTime.Today;
        var todayEnd = todayStart.AddDays(1);
        todayDischargesCount = await db.PatientAdmissions.AsNoTracking()
            .CountAsync(x => x.IsAdmitted == false && x.ReleaseDate >= todayStart && x.ReleaseDate < todayEnd);
        todaySettlementTotal = await db.IpdFinalBills.AsNoTracking()
            .Where(x => x.DischargeDate >= todayStart && x.DischargeDate < todayEnd)
            .SumAsync(x => (decimal?)x.NetAmount) ?? 0;
        activeInpatientsCount = await db.PatientAdmissions.AsNoTracking()
            .CountAsync(x => x.IsAdmitted == true);

        var pIds = recentDischarges.Concat(readyAdmissions).Where(x => !string.IsNullOrWhiteSpace(x.PatientID)).Select(x => x.PatientID!).Distinct().ToArray();
        patientNames = pIds.Length == 0 ? new(StringComparer.OrdinalIgnoreCase) : await db.Registrations.AsNoTracking().Where(x => pIds.Contains(x.PatientID)).ToDictionaryAsync(x => x.PatientID, x => x.Name, StringComparer.OrdinalIgnoreCase);
    }

    private void SetRightQueueMode(string mode)
    {
        rightQueueMode = mode;
        recentFilter = string.Empty;
    }

    private void ApplyDiscountPercent(decimal percent)
    {
        if (grossTotal > 0)
        {
            discountAmount = Math.Round(grossTotal * (percent / 100m), 0);
            RecalculateNet();
        }
    }

