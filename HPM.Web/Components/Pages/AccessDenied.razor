@page "/access-denied"
@implements IDisposable

<PageTitle>@I18n.T("Access Denied", "Access denied") | @Branding.HospitalName</PageTitle>
<div class="panel" style="max-width:620px;margin:50px auto;padding:35px;text-align:center">
    <span class="module-icon red" style="margin:0 auto 18px">!</span>
    <h1>@I18n.T("Access Denied", "Access denied")</h1>
    <p style="color:#6b778c">@I18n.T("Your account does not have permission to open this module.", "Your account does not have permission to open this module.")</p>
    <a class="btn btn-primary" href="/">@I18n.T("Return to dashboard", "Return to dashboard")</a>
</div>

@code {
    protected override void OnInitialized() => I18n.OnLanguageChanged += HandleLanguageChanged;
    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => I18n.OnLanguageChanged -= HandleLanguageChanged;
}
