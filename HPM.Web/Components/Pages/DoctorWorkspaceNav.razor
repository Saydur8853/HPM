@inject NavigationManager Navigation

<nav class="doctor-workspace-tabs" aria-label="Doctor Desk sections">
    <a href="/doctor" class="@(IsActive("overview") ? "active" : null)"><span>⌂</span>@I18n.T("Overview")</a>
    <a href="/doctor/queue" class="@(IsActive("queue") ? "active" : null)"><span>Q</span>@I18n.T("My Queue")</a>
    <a href="/doctor/patient-documents" class="@(IsActive("records") ? "active" : null)"><span>R</span>@I18n.T("Patient Records")</a>
    <a href="/doctor/follow-ups" class="@(IsActive("followups") ? "active" : null)"><span>F</span>@I18n.T("Follow-ups")</a>
    <AuthorizeView Roles="Administrator,Doctor,PharmacyOperator">
        <a href="/doctor/prescriptions" class="@(IsActive("orders") ? "active" : null)"><span>Rx</span>@I18n.T("Prescriptions & Orders")</a>
    </AuthorizeView>
    <AuthorizeView Roles="Administrator,Doctor">
        <a href="/doctor/my-earnings" class="@(IsActive("earnings") ? "active" : null)"><span>৳</span>@I18n.T("Earnings")</a>
    </AuthorizeView>
</nav>

@code {
    private string CurrentPath => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/').ToLowerInvariant();

    private bool IsActive(string section) => section switch
    {
        "overview" => CurrentPath is "doctor" or "doctor/overview",
        "queue" => CurrentPath is "doctor/queue" or "doctor/consultation" or "clinical/doctor-queue",
        "records" => CurrentPath.StartsWith("doctor/patient-documents", StringComparison.Ordinal),
        "followups" => CurrentPath == "doctor/follow-ups",
        "orders" => CurrentPath is "doctor/prescriptions" or "doctor/prescription" or "pharmacy/prescriptions",
        "earnings" => CurrentPath is "doctor/my-earnings" or "doctor/earnings",
        _ => false
    };
}
