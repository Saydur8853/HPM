    private string ServiceName(int id) => services.FirstOrDefault(x => x.ID == id)?.Name ?? $"Study #{id}";
    
    private bool IsRouteService(int id)
    {
        var service = services.FirstOrDefault(x => x.ID == id);
        if (service is null) return false;
        var category = service.CategoryID.HasValue ? categories.GetValueOrDefault(service.CategoryID.Value) : null;
        return IsImagingMode ? DiagnosticTestRouting.IsImaging(service, category) : DiagnosticTestRouting.IsPathology(service, category);
    }

    private string DoctorName(int? id)
    {
        var d = doctors.FirstOrDefault(x => x.ID == id);
        return d == null ? (I18n.IsBangla ? "ডিউটি ডাক্তার" : "Duty Doctor") : $"{d.Title} {d.Name}";
    }

    private string DoctorFormatted(int? id)
    {
        var d = doctors.FirstOrDefault(x => x.ID == id);
        if (d == null) return I18n.IsBangla ? "ডিউটি ডাক্তার" : "Duty Doctor / OPD";
        var titleName = string.Join(" ", new[] { d.Title, d.Name }.Where(s => !string.IsNullOrWhiteSpace(s)));
        var degree = !string.IsNullOrWhiteSpace(d.Degree) ? $", {d.Degree}" : "";
        var att = !string.IsNullOrWhiteSpace(d.Attachment) && d.Attachment != "Temporary" && d.Attachment != "Permanent" ? $" ({d.Attachment})" : "";
        return $"{titleName}{degree}{att}";
    }

    private string GetImagingModality(string serviceName)
    {
        var sLower = serviceName.ToLowerInvariant();
        if (sLower.Contains("x-ray") || sLower.Contains("xray") || sLower.Contains("radiograph"))
            return "DIGITAL RADIOGRAPHY (X-RAY)";
        if (sLower.Contains("usg") || sLower.Contains("ultra") || sLower.Contains("sonogram"))
            return "ULTRASONOGRAPHY (USG)";
        if (sLower.Contains("ct") || sLower.Contains("computed"))
            return "COMPUTED TOMOGRAPHY (CT SCAN)";
        if (sLower.Contains("mri") || sLower.Contains("magnetic"))
            return "MAGNETIC RESONANCE IMAGING (MRI)";
        if (sLower.Contains("echo"))
            return "ECHOCARDIOGRAPHY";
        if (sLower.Contains("ecg") || sLower.Contains("ekg"))
            return "ELECTROCARDIOGRAM (ECG)";
        if (sLower.Contains("endo"))
            return "ENDOSCOPY";
        return "DIAGNOSTIC IMAGING";
    }

    private string GetReportCategoryTitle()
    {
        if (IsImagingMode)
        {
            var sName = ServiceName(activeTestId).ToUpperInvariant();
            if (sName.Contains("X-RAY") || sName.Contains("XRAY") || sName.Contains("CHEST"))
                return "DEPARTMENT OF RADIOLOGY & IMAGING - X-RAY REPORT";
            if (sName.Contains("USG") || sName.Contains("ULTRA") || sName.Contains("SONO"))
                return "DEPARTMENT OF RADIOLOGY & IMAGING - ULTRASONOGRAPHY REPORT";
            if (sName.Contains("CT"))
                return "DEPARTMENT OF RADIOLOGY & IMAGING - CT SCAN REPORT";
            if (sName.Contains("MRI"))
                return "DEPARTMENT OF RADIOLOGY & IMAGING - MRI REPORT";
            return "DEPARTMENT OF RADIOLOGY & IMAGING REPORT";
        }

        var pName = (printMode == "all" && orderItems.Count > 0 ? ServiceName(orderItems[0].TestID) : ServiceName(activeTestId)).ToUpperInvariant();
        if (pName.Contains("CBC") || pName.Contains("HAEMATOLOGY") || pName.Contains("BLOOD") || pName.Contains("ESR") || pName.Contains("TC, DC") || pName.Contains("HEMOGLOBIN"))
            return "HAEMATOLOGY REPORT";
        if (pName.Contains("GLUCOSE") || pName.Contains("SUGAR") || pName.Contains("LIPID") || pName.Contains("CREATININE") || pName.Contains("UREA") || pName.Contains("SGPT") || pName.Contains("SGOT") || pName.Contains("LFT") || pName.Contains("ELECTROLYTE") || pName.Contains("BILIRUBIN"))
            return "BIOCHEMISTRY REPORT";
        if (pName.Contains("URINE") || pName.Contains("STOOL") || pName.Contains("SEMEN") || pName.Contains("R/E"))
            return "CLINICAL PATHOLOGY REPORT";
        if (pName.Contains("CULTURE") || pName.Contains("SENSITIVITY") || pName.Contains("GRAM") || pName.Contains("AFB"))
            return "MICROBIOLOGY REPORT";
        if (pName.Contains("SEROLOGY") || pName.Contains("WIDAL") || pName.Contains("HBSAG") || pName.Contains("HIV") || pName.Contains("VDRL") || pName.Contains("DENGUE") || pName.Contains("COVID"))
            return "SEROLOGY & IMMUNOLOGY REPORT";
        if (pName.Contains("BIOPSY") || pName.Contains("FNAC") || pName.Contains("HISTOPATHOLOGY") || pName.Contains("CYTOLOGY"))
            return "HISTOPATHOLOGY REPORT";
        return $"{pName} REPORT";
    }

    private string GetReportTestsTitle()
    {
        if (printMode == "all")
        {
            return string.Join(", ", orderItems.Select(x => ServiceName(x.TestID)));
        }
        return ServiceName(activeTestId);
    }

    private string GetExpectedDeliveryDate()
    {
        if (selectedMemo == null) return DateTime.Today.ToString("dd/MM/yy");
        return selectedMemo.TransDate.ToString("dd/MM/yy");
    }

    private string GetSampleCollectionTime()
    {
        if (currentSample?.CollectedAt != null) return currentSample.CollectedAt.Value.ToString("dd/MM/yy hh:mm tt");
        return selectedMemo?.TransDate.AddMinutes(5).ToString("dd/MM/yy hh:mm tt") ?? DateTime.Now.ToString("dd/MM/yy hh:mm tt");
    }

    private string GetSampleReceiveTime()
    {
        if (currentSample?.ReceivedAt != null) return currentSample.ReceivedAt.Value.ToString("dd/MM/yy hh:mm tt");
        return selectedMemo?.TransDate.AddMinutes(25).ToString("dd/MM/yy hh:mm tt") ?? DateTime.Now.ToString("dd/MM/yy hh:mm tt");
    }

    private List<int> GetTestsToDisplay()
    {
        if (printMode == "all")
        {
            return orderItems.Select(x => x.TestID).Distinct().ToList();
        }
        return activeTestId > 0 ? [activeTestId] : [];
    }

    private string GetTechnicianName()
    {
        if (!string.IsNullOrWhiteSpace(currentUserDisplayName) && currentUserDisplayName != "System User") return currentUserDisplayName;
        return IsImagingMode ? "Medical Radiographer" : "Masud Pervez";
    }

    private DoctorsProfile? GetConsultantDoctor()
    {
        if (selectedDoctorId > 0)
        {
            var doc = doctors.FirstOrDefault(x => x.ID == selectedDoctorId);
            if (doc != null) return doc;
        }
        if (selectedMemo?.DoctorID > 0)
        {
            var doc = doctors.FirstOrDefault(x => x.ID == selectedMemo.DoctorID);
            if (doc != null) return doc;
        }
        if (IsImagingMode)
        {
            return doctors.FirstOrDefault(x => x.Attachment != null && (x.Attachment.Contains("Radiolog") || x.Attachment.Contains("Imaging")))
                ?? doctors.FirstOrDefault(x => x.Degree != null && (x.Degree.Contains("DMRD") || x.Degree.Contains("FCPS(Radiology)")))
                ?? doctors.FirstOrDefault();
        }
        return doctors.FirstOrDefault(x => x.Attachment != null && (x.Attachment.Contains("Consultant") || x.Attachment.Contains("Patholog") || x.Attachment.Contains("Lab")))
            ?? doctors.FirstOrDefault();
    }

    private string GetConsultantDoctorTitleAndName()
    {
        var d = GetConsultantDoctor();
        if (d == null) return IsImagingMode ? "DR. RADIOLOGIST" : "DR. MAMUNUR RAHMAN";
        return string.Join(" ", new[] { d.Title ?? "Dr.", d.Name }.Where(s => !string.IsNullOrWhiteSpace(s))).ToUpperInvariant();
    }

    private string GetConsultantDoctorDegree()
    {
        var d = GetConsultantDoctor();
        if (d == null || string.IsNullOrWhiteSpace(d.Degree)) return IsImagingMode ? "MBBS, DMRD, FCPS (Radiology & Imaging)" : "MBBS, MPH, MCPS (Lab Medicine)";
        return d.Degree;
    }

