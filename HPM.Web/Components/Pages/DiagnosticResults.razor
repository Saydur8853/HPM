@page "/diagnostic/pathology-results"
@page "/diagnostic/results"
@page "/diagnostic/imaging-results"
@page "/diagnostic/special-results"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.LabTechnician + "," + RoleNames.Doctor)]
@using System.Security.Claims
@using System.Text.Json
@using System.Text.RegularExpressions
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject IBarcodeQrService BarcodeQr
@inject NavigationManager Navigation
@inject HospitalSetupService Branding
@inject IWebHostEnvironment HostEnv
@implements IDisposable
@using HPM.Web.Components.Common

<PageTitle>@I18n.T(IsSpecialMode ? "Special Investigation Report" : IsImagingMode ? "Imaging Report Entry" : "Pathology Results & Report") | @Branding.HospitalName</PageTitle>

<div class="results-classic-fit">
    <!-- Clean Minimal Topbar with Integrated Search -->
    <div class="results-classic-topbar" style="display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap;">
        <div class="tickets-top-left" style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
            <h1 class="tickets-page-title" style="margin:0; display:inline-flex; align-items:center; gap:8px;">
                @if (IsImagingMode)
                {
                    <span style="color:#1e3a8a; display:inline-flex; align-items:center;"><RadiologyIcon Size="19" /></span>
                }
                <span>@I18n.T(IsSpecialMode ? "Special Investigation Reports" : IsImagingMode ? "Imaging & Radiology Reports" : "Pathology & Lab Results")</span>
            </h1>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <span class="tickets-inline-alert @messageClass" title="@message">
                    @message
                </span>
            }
        </div>

        <div style="display:flex; align-items:center; gap:6px; flex:0 1 430px; min-width:260px;">
            <div style="position:relative; flex:1; min-width:0;">
                <input type="text"
                       class="classic-input"
                       style="width:100% !important; height:32px !important; font-size:12px; padding:4px 28px 4px 10px !important;"
                       placeholder="@I18n.T(IsImagingMode ? "Search Memo #, PID, Phone or Scan..." : "Search Memo #, PID, Phone or Barcode...")"
                       @bind="searchQuery"
                       @bind:event="oninput"
                       @onkeydown="HandleSearchKeyDown" />
                @if (!string.IsNullOrWhiteSpace(searchQuery))
                {
                    <button type="button" style="position:absolute; right:6px; top:50%; transform:translateY(-50%); border:none; background:transparent; color:#94a3b8; cursor:pointer; font-size:12px; padding:2px 4px;" @onclick="ClearSearch" title="Clear">✕</button>
                }
            </div>
            <button type="button" class="btn btn-primary tickets-btn" style="height:32px; padding:0 12px; font-size:12px; white-space:nowrap;" @onclick="ExecuteSearchAsync" disabled="@searching">
                <SearchIcon /> @(searching ? I18n.T("...") : I18n.T("Search"))
            </button>
            @if (selectedMemo != null)
            {
                <button type="button" class="btn btn-secondary tickets-btn" style="height:32px; padding:0 10px; font-size:12px; white-space:nowrap;" @onclick="Reset" title="@I18n.T("Close current order")">
                    @I18n.T("Reset")
                </button>
            }
        </div>
    </div>

    <!-- Main Workspace Grid: Left Result Entry Form, Right Recent Orders Queue -->
    <div class="results-classic-workspace">
        @if (showResultEntryModal)
        {
            <div class="results-entry-backdrop" @onclick="CloseResultEntryAsync"></div>
        }
        <!-- Left Panel: Result Entry Card -->
        <div class="results-form-card @(showResultEntryModal ? "results-entry-modal" : selectedMemo != null ? "results-entry-collapsed" : "")">
            @if (selectedMemo != null)
            {
                <div class="results-card-header" style="padding:10px 14px; border-bottom:1px solid #e2e8f0; background:#ffffff;">
                    <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap; min-width:0;">
                        <span style="font-size:12px; font-weight:800; color:#0369a1; background:#f0f9ff; border:1px solid #bae6fd; padding:2px 8px; border-radius:6px;">#@selectedMemo.ID</span>
                        <h2 style="margin:0; font-size:14px; font-weight:800; color:#0f172a;">@selectedMemo.PatientName</h2>
                        <span style="font-size:12px; color:#475569; font-weight:600;">
                            @(string.IsNullOrWhiteSpace(selectedMemo.PatientID) ? "Walk-in" : $"PID: {selectedMemo.PatientID}") &bull; @selectedMemo.Age / @selectedMemo.Sex
                            @if (!string.IsNullOrWhiteSpace(selectedMemo.Contact))
                            {
                                <span> &bull; @selectedMemo.Contact</span>
                            }
                        </span>
                    </div>
                    <div style="display:flex; align-items:center; gap:8px;">
                        @if (orderItems.Count > 0)
                        {
                            <span class="pill" style="font-size:11px; font-weight:700; background:#f8fafc; color:#334155; border:1px solid #cbd5e1;">
                                @CompletedTestsCount / @orderItems.Count @I18n.T("Completed")
                            </span>
                        }
                        @if (showResultEntryModal)
                        {
                            <button type="button" class="tickets-modal-close" @onclick="CloseResultEntryAsync" title="@I18n.T("Close")">&#10005;</button>
                        }
                        else if (activeTestId > 0)
                        {
                            <button type="button" class="btn btn-primary tickets-btn" style="height:28px; padding:0 12px; font-size:11.5px;" @onclick="OpenResultEntry">
                                @I18n.T("Enter Results")
                            </button>
                        }
                    </div>
                </div>
            }

            <div class="results-form-body" style="gap:10px;">
                @if (patientMemosList.Count > 1)
                {
                    <div class="results-patient-memos-bar">
                        <strong style="font-size:11.5px; color:#065f46;">
                            @I18n.T("Patient Bills"):
                        </strong>
                        <div class="results-patient-memos-pills">
                            @foreach (var pm in patientMemosList)
                            {
                                <button type="button"
                                        class="results-memo-pill @(selectedMemo?.ID == pm.ID ? "active" : "")"
                                        @onclick="() => SwitchPatientMemo(pm.ID)">
                                    #@pm.ID (@pm.TransDate.ToString("dd/MM/yy")) &bull; @pm.Items.Count @I18n.T("tests")
                                </button>
                            }
                        </div>
                    </div>
                }

                @if (selectedMemo != null)
                {
                    <!-- Compact Metadata Strip (Specimen, Timestamps & Referring Doctor in 1 clean bar) -->
                    <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:7px 12px; font-size:11.5px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:6px 16px; color:#475569;">
                        @if (!IsImagingMode && !IsSpecialMode)
                        {
                            <div style="display:flex; align-items:center; gap:14px; flex-wrap:wrap;">
                                <span>@I18n.T("Specimen"): <strong style="color:#0369a1;">@(string.IsNullOrWhiteSpace(currentSampleType) ? "Blood" : currentSampleType)</strong></span>
                                <span>@I18n.T("Collected"): <strong style="color:#1e293b;">@GetSampleCollectionTime()</strong></span>
                                <span>@I18n.T("Received"): <strong style="color:#1e293b;">@GetSampleReceiveTime()</strong></span>
                            </div>
                        }
                        else if (IsImagingMode)
                        {
                            <span style="color:#92400e; font-weight:600;">@I18n.T("Film Delivery: Diagnostic Counter")</span>
                        }
                        <div style="margin-left:auto;">
                            <span>@I18n.T("Ref. By"): <strong style="color:#1e293b;">@DoctorFormatted(selectedMemo.DoctorID)</strong></span>
                        </div>
                    </div>

                    @if (pendingUncollectedTests.Count > 0 && !IsImagingMode && !IsSpecialMode)
                    {
                        <div style="padding:6px 10px; border-radius:6px; background:#fffbeb; border:1px solid #fde68a; color:#92400e; font-size:11.5px; display:flex; justify-content:space-between; align-items:center; gap:8px; flex-wrap:wrap;">
                            <span><strong>@pendingUncollectedTests.Count @I18n.T("awaiting sample collection"):</strong> @string.Join(", ", pendingUncollectedTests)</span>
                            <a href="/diagnostic/sample-collection" style="color:#0369a1; font-weight:700; text-decoration:none; white-space:nowrap;">@I18n.T("Sample Collection") &rarr;</a>
                        </div>
                    }

                    <!-- Unified Test Tabs + Quick Actions Bar -->
                    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; padding-top:2px;">
                        <div class="results-test-tabs" style="display:flex; align-items:center; gap:6px; flex-wrap:wrap;">
                            @foreach (var test in orderItems)
                            {
                                var sName = ServiceName(test.TestID);
                                var hasResults = allResults.Any(x => x.ServiceID == test.TestID && !string.IsNullOrWhiteSpace(x.ResultValue));
                                var isTestVerified = allResults.Any(x => x.ServiceID == test.TestID) && allResults.Where(x => x.ServiceID == test.TestID).All(x => x.IsVerified);
                                <button type="button"
                                        class="btn tickets-btn @(activeTestId == test.TestID ? "btn-primary" : "btn-secondary")"
                                        style="font-size:11.5px; padding:4px 12px; border-radius:8px; font-weight:600;"
                                        @onclick="() => OpenTestAsync(test.TestID)">
                                    @(isTestVerified ? "✓ " : hasResults ? "• " : "")@sName
                                </button>
                            }
                        </div>

                        @if (activeTestId > 0 && !IsImagingMode)
                        {
                            <div style="display:flex; align-items:center; gap:5px; flex-wrap:wrap;">
                                <button type="button" class="results-quick-btn success" @onclick="SetAllNormal" title="@I18n.T("Fill normal reference findings")">
                                    @I18n.T("Set Normal")
                                </button>
                                <button type="button" class="results-quick-btn" @onclick="SetBlankResultsToNil" title="@I18n.T("Fill only empty result fields with Nil")">
                                    @I18n.T("Set Nil")
                                </button>
                                <button type="button" class="results-quick-btn" @onclick="ClearParameterValues">
                                    @I18n.T("Clear")
                                </button>
                                <button type="button" class="results-quick-btn" @onclick="ResetToDefaultTemplateAsync" title="@I18n.T("Reload parameters from Investigations Setup")">
                                    @I18n.T("Reset")
                                </button>
                                @if (isAdministrator)
                                {
                                    <button type="button" class="results-quick-btn" style="color:#0369a1; border-color:#bae6fd; background:#f0f9ff;" @onclick="SaveParametersToMasterAsync" title="@I18n.T("Save parameters, units & ranges permanently to Investigations Setup")">
                                        @I18n.T("Save Template")
                                    </button>
                                }
                                <button type="button" class="results-quick-btn" @onclick="AddBlankParameter">
                                    + @I18n.T("Parameter")
                                </button>
                                <button type="button" class="results-quick-btn" @onclick="AddSectionHeader">
                                    + @I18n.T("Heading")
                                </button>
                            </div>
                        }
                    </div>

                    @if (activeTestId > 0)
                    {
                        @if (IsImagingMode)
                        {
                            <div class="imaging-template-bar">
                                <span style="font-size: 11px; font-weight: 700; color: #475569;">@I18n.T("Templates"):</span>
                                <button type="button" class="imaging-template-btn" @onclick='() => LoadImagingTemplate("Chest")'>Chest X-Ray</button>
                                <button type="button" class="imaging-template-btn" @onclick='() => LoadImagingTemplate("Abdomen")'>USG Abdomen</button>
                                <button type="button" class="imaging-template-btn" @onclick='() => LoadImagingTemplate("KUB")'>KUB</button>
                                <button type="button" class="imaging-template-btn" @onclick='() => LoadImagingTemplate("Pelvis")'>Pelvis / TVS</button>
                                <button type="button" class="imaging-template-btn" @onclick='() => LoadImagingTemplate("CTBrain")'>CT Brain</button>
                                <button type="button" class="imaging-template-btn" @onclick='() => LoadImagingTemplate("CSpine")'>C-Spine</button>
                                <button type="button" class="imaging-template-btn" @onclick='() => LoadImagingTemplate("LSSpine")'>LS Spine</button>
                                <button type="button" class="imaging-template-btn" @onclick='() => LoadImagingTemplate("Bone")'>Bone</button>
                                <button type="button" class="imaging-template-btn" @onclick='() => LoadImagingTemplate("ECG")'>ECG</button>
                            </div>
                        }

                        <!-- Clean Parameter / Section Table -->
                        <div class="results-param-table-wrap">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th style="width: 34px; text-align:center;">#</th>
                                        <th>@I18n.T(IsImagingMode ? "Section" : "Parameter")</th>
                                        <th style="width:@(IsImagingMode ? "430px" : "195px");">@I18n.T(IsImagingMode ? "Findings" : "Result") <span style="color:#dc2626;">*</span></th>
                                        @if (!IsImagingMode)
                                        {
                                            <th style="width:105px;">@I18n.T("Unit")</th>
                                            <th style="width:235px;">@I18n.T("Reference Range")</th>
                                        }
                                        <th style="width:68px; text-align:center;">@I18n.T("Order")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < currentTestResults.Count; i++)
                                    {
                                        var idx = i;
                                        var row = currentTestResults[idx];
                                        var isHeaderRow = IsGroupHeaderRow(row);
                                        <tr class="@(isHeaderRow ? "results-row-header" : "")">
                                            <td style="text-align:center; color:#64748b; font-size:11px;">@(idx + 1)</td>
                                            <td>
                                                <InputText class="classic-input" @bind-Value="row.ParameterName" style="font-weight:600; height:28px !important; padding:2px 8px !important;" placeholder="@(isHeaderRow ? "Group Heading" : "Parameter Name")" />
                                            </td>
                                            @if (isHeaderRow)
                                            {
                                                <td colspan="3" style="color:#64748b; font-size:11px; font-style:italic; padding-left:10px;">
                                                    @I18n.T("Group Heading")
                                                </td>
                                            }
                                            else
                                            {
                                                <td>
                                                    @if (IsImagingMode)
                                                    {
                                                        <InputTextArea class="classic-input" @bind-Value="row.ResultValue" style="min-height:85px !important; line-height:1.5; font-size:12px; padding:6px 8px !important; resize:vertical;" placeholder="@I18n.T("Enter findings...")" />
                                                    }
                                                    else
                                                    {
                                                        <input type="text"
                                                               class="classic-input bold-number"
                                                               value="@row.ResultValue"
                                                               @oninput="(e) => OnResultValueInput(row, e.Value?.ToString())"
                                                               style="height:28px !important; padding:2px 8px !important;"
                                                               placeholder="@I18n.T("Enter result")" />
                                                    }
                                                </td>
                                                @if (!IsImagingMode)
                                                {
                                                    <td><InputText class="classic-input" @bind-Value="row.Unit" style="width:98px; height:28px !important; padding:2px 8px !important;" placeholder="—" /></td>
                                                    <td><InputText class="classic-input" @bind-Value="row.ReferenceRange" style="height:28px !important; padding:2px 8px !important;" placeholder="—" /></td>
                                                }
                                            }
                                            <td style="text-align:center;">
                                                <div style="display:inline-flex; align-items:center; gap:2px;">
                                                    <button type="button" class="tickets-icon-action" @onclick="() => MoveParameterUp(idx)" disabled="@(idx == 0)" title="@I18n.T("Move Up")">↑</button>
                                                    <button type="button" class="tickets-icon-action" @onclick="() => MoveParameterDown(idx)" disabled="@(idx == currentTestResults.Count - 1)" title="@I18n.T("Move Down")">↓</button>
                                                    <button type="button" class="tickets-icon-action danger" @onclick="() => RemoveParameter(idx)" title="@I18n.T("Remove")">✕</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Unified Compact Method Note & Signatories Card -->
                        <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:10px 12px; display:flex; flex-direction:column; gap:8px;">
                            @if (!IsImagingMode)
                            {
                                <div style="display:flex; align-items:center; gap:8px; flex-wrap:nowrap;">
                                    <span style="font-size:11.5px; font-weight:600; color:#475569; white-space:nowrap; width:92px; flex-shrink:0;">@I18n.T("Method Note"):</span>
                                    <select class="classic-input tickets-select" style="width:185px !important; flex:0 0 185px; height:28px !important; font-size:11.5px;" value="@selectedNotePresetId" @onchange="OnAnalyzerPresetSelected">
                                        <option value="">@I18n.T("Saved Notes...")</option>
                                        @foreach (var p in analyzerNotePresets)
                                        {
                                            <option value="@p.Id">@p.Title</option>
                                        }
                                    </select>
                                    <input type="text" class="classic-input" @bind="analyzerMethodNote" style="width:auto !important; flex:1 1 auto; min-width:140px; height:28px !important; font-size:11.5px;" placeholder="@I18n.T("Optional analyzer or method note...")" />
                                    <button type="button" class="btn btn-secondary tickets-btn" style="height:28px; padding:0 10px; font-size:11px; white-space:nowrap; flex-shrink:0;" @onclick="OpenAnalyzerNoteModal">
                                        @I18n.T("Notes")
                                    </button>
                                </div>
                            }

                            <div style="display:flex; align-items:center; justify-content:space-between; gap:8px 14px; flex-wrap:wrap;">
                                <div style="display:flex; align-items:center; gap:8px; flex:0 1 235px; min-width:190px; flex-wrap:nowrap;">
                                    <span style="font-size:11.5px; font-weight:600; color:#475569; white-space:nowrap; width:92px; flex-shrink:0;">@I18n.T(IsImagingMode ? "Radiographer" : "Technologist"):</span>
                                    <input type="text" class="classic-input" style="width:auto !important; flex:1 1 auto; min-width:90px; height:28px !important; font-size:11.5px;" @bind="checkedByTechnologist" placeholder="@I18n.T("Optional")" />
                                </div>

                                <div style="display:flex; align-items:center; gap:8px; flex:1 1 320px; min-width:0; flex-wrap:nowrap;">
                                    @if (IsImagingMode)
                                    {
                                        <span style="font-size:11.5px; font-weight:600; color:#475569; white-space:nowrap; flex-shrink:0; display:inline-flex; align-items:center; gap:5px;"><RadiologyIcon Size="15" /> @I18n.T("Radiologist"):</span>
                                    }
                                    else
                                    {
                                        <span style="font-size:11.5px; font-weight:600; color:#475569; white-space:nowrap; flex-shrink:0;">@I18n.T("Pathologist"):</span>
                                    }
                                    <InputSelect class="classic-input tickets-select" style="width:auto !important; flex:1 1 auto; min-width:130px; height:28px !important; font-size:11.5px;" @bind-Value="selectedDoctorId">
                                        <option value="0">@I18n.T(IsImagingMode ? "Select Radiologist" : "Select Pathologist")</option>
                                        @if (labConsultants.Count > 0)
                                        {
                                            <optgroup label="@I18n.T("Saved Consultants")">
                                                @foreach (var lc in labConsultants)
                                                {
                                                    <option value="@(-lc.ID)">@lc.Name @(string.IsNullOrWhiteSpace(lc.Degree) ? "" : $"({lc.Degree})")</option>
                                                }
                                            </optgroup>
                                        }
                                        @if (doctors.Count > 0)
                                        {
                                            <optgroup label="@I18n.T("Hospital Doctors")">
                                                @foreach (var d in doctors)
                                                {
                                                    <option value="@d.ID">@d.Title @d.Name @(string.IsNullOrWhiteSpace(d.Degree) ? "" : $"({d.Degree})")</option>
                                                }
                                            </optgroup>
                                        }
                                    </InputSelect>
                                    <button type="button" class="btn btn-secondary tickets-btn" style="height:28px; padding:0 10px; font-size:11px; white-space:nowrap; flex-shrink:0;" @onclick="OpenConsultantModal">
                                        @I18n.T("Manage")
                                    </button>
                                </div>

                                <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap; flex-shrink:0;">
                                    @if (canVerify)
                                    {
                                        <label style="display:inline-flex !important; flex-direction:row !important; align-items:center !important; gap:6px; margin:0; font-size:11.5px; font-weight:700; color:#047857; cursor:pointer; width:auto !important; white-space:nowrap;">
                                            <InputCheckbox @bind-Value="isVerified" style="width:15px !important; height:15px !important; min-height:0 !important; margin:0 !important; padding:0 !important; accent-color:#047857; cursor:pointer;" />
                                            <span>@I18n.T("Verified & Signed")</span>
                                        </label>
                                    }
                                    @if (isVerified && isAdministrator)
                                    {
                                        <button type="button" class="btn btn-secondary tickets-btn" style="height:26px; font-size:10.5px; padding:0 8px;" @onclick="UnlockReportAsync">
                                            @I18n.T("Unlock")
                                        </button>
                                    }
                                    @if (canVerify && orderItems.Count > 1)
                                    {
                                        <button type="button" class="btn btn-secondary tickets-btn" style="height:26px; font-size:10.5px; padding:0 8px; color:#047857; border-color:#a7f3d0;" @onclick="VerifyAllTestsAsync">
                                            @I18n.T("Verify All")
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="tickets-queue-empty" style="padding: 3.5rem 1.5rem; gap:6px;">
                        @if (IsImagingMode)
                        {
                            <span style="color:#64748b; display:inline-flex; margin-bottom:4px;"><RadiologyIcon Size="34" /></span>
                        }
                        <strong style="font-size: 14px; color:#1e293b;">@I18n.T("Select an order from the queue or search above")</strong>
                        <span style="font-size: 12px; color:#64748b;">
                            @I18n.T("Enter Memo #, Patient ID (PID), or Phone in the top search bar, or click any order on the right.")
                        </span>
                        @if (recentOrderDtos.Count > 0)
                        {
                            <div style="margin-top: 10px;">
                                <button type="button" class="btn btn-secondary tickets-btn" @onclick="() => SelectOrder(recentOrderDtos[0].ID)">
                                    @I18n.T("Open Latest Order") (#@recentOrderDtos[0].ID &bull; @recentOrderDtos[0].PatientName)
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (selectedMemo != null && activeTestId > 0 && showResultEntryModal)
            {
                <div class="results-form-footer" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
                    <div class="results-autosave-state" role="status">
                        @if (isAutoSaving)
                        {
                            <span>@I18n.T("Saving draft...")</span>
                        }
                        else if (lastDraftSavedAt.HasValue)
                        {
                            <span>&#10003; @I18n.T("Draft saved automatically") @lastDraftSavedAt.Value.ToString("hh:mm tt")</span>
                        }
                        else
                        {
                            <span>@I18n.T("Draft saves automatically when you change tests or close")</span>
                        }
                    </div>

                    <div style="display:flex; align-items:center; gap:6px;">
                        <button class="btn btn-secondary tickets-btn" type="button" @onclick="CloseResultEntryAsync">
                            @I18n.T("Close")
                        </button>
                        <button class="btn btn-primary tickets-btn" type="button" @onclick="PublishAsync" disabled="@isAutoSaving">
                            @I18n.T("Publish")
                        </button>
                    </div>
                </div>
            }
        </div>

        <!-- Right Panel: Clean Minimal Recent Orders Queue -->
        <div class="results-queue-card">
            <div class="results-queue-top" style="flex-wrap:wrap; gap:6px;">
                <div style="display:flex; align-items:center; gap:6px;">
                    <h2>@I18n.T("Orders Queue")</h2>
                    <span class="pill" style="font-size:10.5px; font-weight:700;">
                        @filteredQueueOrders.Count
                    </span>
                </div>
                <div style="display:flex; align-items:center; gap:4px;">
                    <input type="date" class="classic-input" style="height:24px !important; font-size:10.5px; padding:1px 6px !important; width:118px !important;" value="@(queueDateFilter?.ToString("yyyy-MM-dd") ?? "")" @onchange="OnQueueDateChangedAsync" title="@I18n.T("Filter by date")" />
                    @if (queueDateFilter.HasValue)
                    {
                        <button type="button" class="tickets-icon-action" @onclick="ClearQueueDateAsync" title="@I18n.T("Clear date")">✕</button>
                    }
                </div>
            </div>

            <div class="results-queue-filter-wrap">
                <div style="position:relative; width:100%;">
                    <input class="classic-input"
                           style="width:100% !important; height:28px !important; font-size:11.5px; padding:2px 24px 2px 8px !important;"
                           placeholder="@I18n.T("Filter by name, memo, PID, test...")"
                           @bind="queueSearchQuery"
                           @bind:event="oninput"
                           @bind:after="FilterQueueOrders" />
                    @if (!string.IsNullOrWhiteSpace(queueSearchQuery))
                    {
                        <button type="button" style="position:absolute; right:5px; top:50%; transform:translateY(-50%); border:none; background:transparent; color:#94a3b8; cursor:pointer; font-size:11px;" @onclick="ClearQueueSearch">✕</button>
                    }
                </div>
                <div class="results-queue-tabs">
                    <button type="button" class="results-queue-tab @(queueStatusFilter == "all" ? "active" : "")" @onclick='() => SetQueueFilter("all")'>
                        @I18n.T("All") (@recentOrderDtos.Count)
                    </button>
                    <button type="button" class="results-queue-tab @(queueStatusFilter == "Pending" ? "active" : "")" @onclick='() => SetQueueFilter("Pending")'>
                        @I18n.T("Pending") (@recentOrderDtos.Count(x => x.OverallStatus == "Pending"))
                    </button>
                    <button type="button" class="results-queue-tab @(queueStatusFilter == "InProcess" ? "active" : "")" @onclick='() => SetQueueFilter("InProcess")'>
                        @I18n.T("Draft") (@recentOrderDtos.Count(x => x.OverallStatus == "InProcess"))
                    </button>
                    <button type="button" class="results-queue-tab @(queueStatusFilter == "Verified" ? "active" : "")" @onclick='() => SetQueueFilter("Verified")'>
                        @I18n.T("Ready") (@recentOrderDtos.Count(x => x.OverallStatus == "Verified"))
                    </button>
                </div>
            </div>

            <div class="billing-queue-list">
                @if (filteredQueueOrders.Count == 0)
                {
                    <div class="tickets-queue-empty">
                        <span>@I18n.T("No orders match the current filter.")</span>
                    </div>
                }
                @foreach (var o in filteredQueueOrders)
                {
                    var isSelected = selectedMemo?.ID == o.ID;
                    <div class="billing-queue-item @(isSelected ? "active" : "")" style="cursor:pointer;" @onclick="() => SelectOrder(o.ID)">
                        <span class="billing-queue-serial">#@o.ID</span>
                        <div class="billing-queue-info">
                            <div style="display:flex; justify-content:space-between; align-items:center; gap:6px;">
                                <span class="billing-queue-name">
                                    @o.PatientName
                                    @if (!string.IsNullOrWhiteSpace(o.PatientID))
                                    {
                                        <small class="tickets-queue-reg">(@o.PatientID)</small>
                                    }
                                </span>
                                @if (o.OverallStatus == "Verified")
                                {
                                    <span class="pill pill-success" style="font-size:9.5px; padding:1px 6px;">@I18n.T("Ready")</span>
                                }
                                else if (o.OverallStatus == "InProcess")
                                {
                                    <span class="pill" style="font-size:9.5px; padding:1px 6px; background:#e0f2fe; color:#0369a1; border:1px solid #bae6fd;">@I18n.T("Draft")</span>
                                }
                                else
                                {
                                    <span class="pill" style="font-size:9.5px; padding:1px 6px; background:#fffbeb; color:#92400e; border:1px solid #fde68a;">@I18n.T("Pending")</span>
                                }
                            </div>
                            <span class="billing-queue-meta">
                                @o.TransDate.ToString("dd MMM · hh:mm tt") &bull; @o.Age / @o.Sex
                            </span>
                            @if (o.TestNames.Count > 0)
                            {
                                <div style="display:flex; flex-wrap:wrap; gap:3px; margin-top:3px;">
                                    @foreach (var tName in o.TestNames.Take(3))
                                    {
                                        <span class="results-queue-chip" title="@tName">@tName</span>
                                    }
                                    @if (o.TestNames.Count > 3)
                                    {
                                        <span class="results-queue-chip" style="background:#e2e8f0;">+@(o.TestNames.Count - 3)</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (selectedMemo != null)
{
    <div class="@(showReportPreview ? "tickets-modal-backdrop" : "")"
         style="@(showReportPreview ? "" : "position:fixed; left:-10000px; top:0; width:840px; pointer-events:none; z-index:-1; opacity:0;")"
         @onclick="() => { if (showReportPreview) showReportPreview = false; }">
        <div class="@(showReportPreview ? "tickets-modal" : "")"
             style="@(showReportPreview ? "max-width:900px; width:96%; max-height:94dvh;" : "")"
             @onclick:stopPropagation="true">
            @if (showReportPreview)
            {
                <div class="tickets-modal-head no-print" style="flex-wrap:wrap; gap:8px;">
                    <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                        <h3 style="margin:0;">👁️ @I18n.T("Report Print Preview") — #D@(selectedMemo.ID)</h3>
                        <button type="button" class="btn btn-sm @(printMode == "active" ? "btn-primary active" : "btn-secondary")" style="font-size:11px; padding:3px 9px;" @onclick='() => printMode = "active"'>
                            @I18n.T("Active Test") (@ServiceName(activeTestId))
                        </button>
                        @if (orderItems.Count > 1)
                        {
                            <button type="button" class="btn btn-sm @(printMode == "all" ? "btn-primary active" : "btn-secondary")" style="font-size:11px; padding:3px 9px;" @onclick='() => printMode = "all"'>
                                📑 @I18n.T("All Tests") (@orderItems.Count)
                            </button>
                        }
                    </div>
                    <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                        <label style="display:inline-flex !important; flex-direction:row !important; align-items:center !important; gap:5px; margin:0; font-size:11.5px; font-weight:700; color:#334155; cursor:pointer; width:auto !important; white-space:nowrap;">
                            <input type="checkbox" @bind="usePreprintedPad" style="width:14px !important; height:14px !important; min-height:0 !important; margin:0 !important;" />
                            <span>@I18n.T("Pre-printed Pad")</span>
                        </label>
                        <button type="button" class="btn btn-primary tickets-btn" style="height:28px; padding:0 12px; font-size:11.5px;" @onclick="PrintAsync">
                            🖨️ @I18n.T("Print")
                        </button>
                        <button type="button" class="tickets-modal-close" @onclick="() => showReportPreview = false" title="@I18n.T("Close Preview")">✕</button>
                    </div>
                </div>
            }

            <div class="@(showReportPreview ? "tickets-modal-body" : "")" style="@(showReportPreview ? "background:#f1f5f9; padding:16px;" : "")">
                <!-- Official Clinical Laboratory & Written Radiology Report Sheet -->
                <div id="lab-report-print" class="print-sheet print-document">
                    <div class="delta-report-sheet @(usePreprintedPad ? "delta-pad-mode" : "")">
                        <table class="delta-paged-report @(!IsImagingMode ? "delta-results-table" : "")" role="presentation">
                            <thead class="delta-repeat-header">
                                <tr><td colspan="@(IsImagingMode ? 1 : 4)" class="delta-report-header-cell">
                        @if (!usePreprintedPad)
                        {
                            <!-- Top Hospital Letterhead / Banner -->
                            <div class="delta-report-header">
                                <div class="delta-hosp-banner">
                                    @if (!string.IsNullOrWhiteSpace(Branding.LogoData))
                                    {
                                        <img src="@Branding.LogoData" alt="Logo" class="delta-hosp-logo" />
                                    }
                                    <div class="delta-hosp-info">
                                        <h1 class="delta-hosp-name">@Branding.HospitalName</h1>
                                        @if (!string.IsNullOrWhiteSpace(Branding.Tagline))
                                        {
                                            <p class="delta-hosp-tagline">@Branding.Tagline</p>
                                        }
                                        <p class="delta-hosp-addr">@GetFormattedHospitalAddress()@(string.IsNullOrWhiteSpace(Branding.Hotline) && string.IsNullOrWhiteSpace(Branding.Phone) ? "" : $"  •  Hotline: {(string.IsNullOrWhiteSpace(Branding.Hotline) ? Branding.Phone : Branding.Hotline)}")</p>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="delta-pad-spacer"></div>
                        }

                        <!-- Barcodes & Department Title Row -->
                        <div class="delta-barcodes-strip">
                            <div class="delta-barcode-left" title="Invoice Barcode: *D@selectedMemo.ID*">
                                @((MarkupString)BarcodeQr.GenerateBarcodeSvg($"D{selectedMemo.ID}", 22, true))
                            </div>
                            <div class="delta-report-title-wrap">
                                <h2 class="delta-report-title">@GetReportCategoryTitle()</h2>
                            </div>
                            <div class="delta-barcode-right" title="Patient ID Barcode">
                                @((MarkupString)BarcodeQr.GenerateBarcodeSvg($"{selectedMemo.PatientID ?? selectedMemo.ID.ToString()}", 22, true))
                            </div>
                        </div>

                        <!-- Clean Non-Wrapping Patient Demographics Box -->
                        <div class="delta-patient-box">
                            <div class="delta-patient-grid-3">
                                <div class="delta-cell">
                                    <span class="delta-lbl">Invoice No</span>
                                    <span class="delta-sep">:</span>
                                    <strong class="delta-val">D@(selectedMemo.ID)</strong>
                                </div>
                                <div class="delta-cell">
                                    <span class="delta-lbl">Patient ID (PID)</span>
                                    <span class="delta-sep">:</span>
                                    <strong class="delta-val">@(string.IsNullOrWhiteSpace(selectedMemo.PatientID) ? "Walk-in" : selectedMemo.PatientID)</strong>
                                </div>
                                <div class="delta-cell">
                                    <span class="delta-lbl">Invoice Date</span>
                                    <span class="delta-sep">:</span>
                                    <strong class="delta-val" style="white-space:nowrap;">@selectedMemo.TransDate.ToString("dd/MM/yyyy hh:mm tt")</strong>
                                </div>
                            </div>

                            <div class="delta-patient-grid-3" style="margin-top: 4px;">
                                <div class="delta-cell span-2">
                                    <span class="delta-lbl">Patient Name</span>
                                    <span class="delta-sep">:</span>
                                    <strong class="delta-val delta-pt-name">@selectedMemo.PatientName.ToUpperInvariant()</strong>
                                </div>
                                <div class="delta-cell">
                                    <span class="delta-lbl">Age / Sex</span>
                                    <span class="delta-sep">:</span>
                                    <strong class="delta-val" style="white-space:nowrap;">@selectedMemo.Age / @selectedMemo.Sex</strong>
                                </div>
                            </div>

                            <div class="delta-patient-grid-3" style="margin-top: 4px;">
                                <div class="delta-cell">
                                    <span class="delta-lbl">Contact No</span>
                                    <span class="delta-sep">:</span>
                                    <strong class="delta-val">@(string.IsNullOrWhiteSpace(selectedMemo.Contact) ? "—" : selectedMemo.Contact)</strong>
                                </div>
                                <div class="delta-cell">
                                    <span class="delta-lbl">@(IsImagingMode ? "Modality" : "Specimen")</span>
                                    <span class="delta-sep">:</span>
                                    <strong class="delta-val">@(IsImagingMode ? GetImagingModality(ServiceName(activeTestId)) : (string.IsNullOrWhiteSpace(currentSampleType) ? "BLOOD" : currentSampleType.ToUpperInvariant()))</strong>
                                </div>
                                <div class="delta-cell">
                                    <span class="delta-lbl">Report Date</span>
                                    <span class="delta-sep">:</span>
                                    <strong class="delta-val" style="white-space:nowrap;">@DateTime.Now.ToString("dd/MM/yyyy")</strong>
                                </div>
                            </div>

                            @if (!IsImagingMode)
                            {
                                <div class="delta-patient-grid-2" style="margin-top: 4px;">
                                    <div class="delta-cell">
                                        <span class="delta-lbl">Sample Collected</span>
                                        <span class="delta-sep">:</span>
                                        <span class="delta-val" style="white-space:nowrap;">@GetSampleCollectionTime()</span>
                                    </div>
                                    <div class="delta-cell">
                                        <span class="delta-lbl">Lab Received</span>
                                        <span class="delta-sep">:</span>
                                        <span class="delta-val" style="white-space:nowrap;">@GetSampleReceiveTime()</span>
                                    </div>
                                </div>
                            }

                            <div class="delta-patient-grid-1" style="margin-top: 4px;">
                                <div class="delta-cell">
                                    <span class="delta-lbl">Referred By</span>
                                    <span class="delta-sep">:</span>
                                    <strong class="delta-val">@DoctorFormatted(selectedMemo.DoctorID)</strong>
                                </div>
                            </div>

                            <div class="delta-patient-grid-1" style="margin-top: 4px;">
                                <div class="delta-cell">
                                    <span class="delta-lbl">@(IsImagingMode ? "Examination" : "Investigation")</span>
                                    <span class="delta-sep">:</span>
                                    <strong class="delta-val">@GetReportTestsTitle()</strong>
                                </div>
                            </div>

                            @if (IsImagingMode)
                            {
                                <div class="delta-analyzer-note" style="color: #854d0e; font-style: normal; font-weight: 600;">
                                    <b>FILM COUNTER NOTICE:</b> Original imaging film/plate is to be collected from the Diagnostic Imaging Delivery Counter. This document constitutes the certified written radiology report.
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(analyzerMethodNote))
                            {
                                <div class="delta-analyzer-note">
                                    @analyzerMethodNote
                                </div>
                            }
                        </div>

                                </td></tr>
                                @if (!IsImagingMode)
                                {
                                    <tr class="delta-results-column-head">
                                        <th style="width: 36%;">Test</th>
                                        <th class="text-center" style="width: 18%;">Result</th>
                                        <th class="text-center" style="width: 14%;">Unit</th>
                                        <th style="width: 32%;">Reference Value</th>
                                    </tr>
                                }
                            </thead>
                            <tbody class="delta-repeat-content">

            @if (IsImagingMode)
            {
                <tr><td>
                <!-- Official Written Radiology / Imaging Report Layout -->
                <div class="delta-imaging-report-body">
                    <div class="delta-imaging-study-header">
                        <span class="delta-imaging-lbl">EXAMINATION / STUDY:</span>
                        <strong class="delta-imaging-study-name">@ServiceName(activeTestId).ToUpperInvariant()</strong>
                    </div>

                    <div class="delta-film-counter-banner">
                        <span style="font-size: 16px;">🎞️</span>
                        <div>
                            <strong>@I18n.T("FILM PICKUP NOTICE"):</strong>
                            <span>@(I18n.IsBangla ? "মূল এক্স-রে/সিটি/এমআরআই ফিল্ম ডেলিভারি কাউন্টার থেকে সংগ্রহ করুন। এটি চিকিৎসকের মূল লিখিত ডায়াগনস্টিক রিপোর্ট।" : "Physical imaging film/plate is to be collected from the Diagnostic Imaging Counter. Below is the official written diagnostic radiology report.")</span>
                        </div>
                    </div>

                    @foreach (var res in currentTestResults.Where(x => !string.IsNullOrWhiteSpace(x.ResultValue) || !string.IsNullOrWhiteSpace(x.ParameterName)))
                    {
                        <div class="delta-imaging-section">
                            <div class="delta-imaging-section-title">@res.ParameterName.ToUpperInvariant():</div>
                            <div class="delta-imaging-section-content">
                                @res.ResultValue
                            </div>
                        </div>
                    }

                    <div class="delta-imaging-counter-footer-notice">
                        <b>@I18n.T("Important Note"):</b> @(I18n.IsBangla ? "রোগীর মূল ফিল্ম ডায়াগনস্টিক কাউন্টারে হস্তান্তরের জন্য প্রস্তুত থাকে। এই লিখিত রিপোর্টে রেডিওলজিস্টের চূড়ান্ত অভিমত রয়েছে, যা রোগীর ব্যবস্থাপত্রে সংযুক্ত করার জন্য প্রযোজ্য।" : "Original films/plates are available for patient collection at the Diagnostic Imaging Counter upon showing this invoice. This written diagnostic report contains the certified clinical radiological interpretation.")
                    </div>
                </div>
                </td></tr>
            }
            else
            {
                <!-- Pathology / Clinical Laboratory Test Table (Delta Hospital standard) -->
                        @foreach (var testId in GetTestsToDisplay())
                        {
                            var testResults = (testId == activeTestId ? currentTestResults : allResults.Where(r => r.ServiceID == testId).ToList())
                                .Where(r => !string.IsNullOrWhiteSpace(r.ParameterName))
                                .ToList();
                            @if (printMode == "all" && GetTestsToDisplay().Count > 1)
                            {
                                <tr class="delta-test-separator-row">
                                    <td colspan="4">
                                        🔬 <b>@ServiceName(testId).ToUpperInvariant()</b>
                                    </td>
                                </tr>
                            }
                            @if (testResults.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" style="text-align:center; color:#94a3b8; font-style:italic;">
                                        @I18n.T("No results recorded yet for") @ServiceName(testId)
                                    </td>
                                </tr>
                            }
                            @foreach (var res in testResults)
                            {
                                var isGroupHeader = IsGroupHeaderRow(res);
                                if (isGroupHeader)
                                {
                                    <tr class="delta-group-heading">
                                        <td colspan="4"><b>@res.ParameterName.Trim()</b></td>
                                    </tr>
                                }
                                else
                                {
                                    <tr>
                                        <td class="delta-param-name @(res.ParameterName.StartsWith("  ") ? "delta-sub-param" : "")">
                                            @res.ParameterName.Trim()
                                        </td>
                                        <td class="text-center delta-val-cell">
                                            <b>@res.ResultValue</b>
                                        </td>
                                        <td class="text-center delta-unit-cell">@(res.Unit ?? "—")</td>
                                        <td class="delta-ref-cell">
                                            @if (!string.IsNullOrWhiteSpace(res.ReferenceRange))
                                            {
                                                <div style="white-space: pre-line;">@res.ReferenceRange</div>
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }
                                        </td>
                                    </tr>
                                    @if (!string.IsNullOrWhiteSpace(res.Interpretation))
                                    {
                                        <tr class="delta-interpretation-row">
                                            <td colspan="4">
                                                <small><em>Note: @res.Interpretation</em></small>
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                        }
            }

                            </tbody>
                            <tfoot class="delta-repeat-footer">
                                <tr><td colspan="@(IsImagingMode ? 1 : 4)" class="delta-report-footer-cell">

            <!-- Signatures Row -->
            <div class="delta-signatures-row">
                <div class="delta-sign-col">
                    <div class="delta-sign-line"></div>
                    <div class="delta-sign-name">@GetTechnicianName()</div>
                    <div class="delta-sign-sub">@GetTechnicianDesignation()</div>
                    <div class="delta-sign-sub">@Branding.HospitalName</div>
                </div>
                <div class="delta-sign-col" style="text-align: right;">
                    @if (GetConsultantSignatureDataUrl() is string sigUrl)
                    {
                        <img src="@sigUrl" alt="Consultant Signature" style="max-height:46px; max-width:170px; object-fit:contain; display:block; margin-left:auto; margin-bottom:2px;" />
                    }
                    <div class="delta-sign-line" style="margin-left: auto;"></div>
                    <div class="delta-sign-name">@GetConsultantDoctorTitleAndName()</div>
                    @if (!string.IsNullOrWhiteSpace(GetConsultantDoctorDegree()))
                    {
                        <div class="delta-sign-sub">@GetConsultantDoctorDegree()</div>
                    }
                    <div class="delta-sign-sub">@GetConsultantDesignation()</div>
                    @if (!string.IsNullOrWhiteSpace(GetConsultantDoctorBmdc()))
                    {
                        <div class="delta-sign-sub">BM&amp;DC Reg. No: @GetConsultantDoctorBmdc()</div>
                    }
                    <div class="delta-sign-sub">@Branding.HospitalName</div>
                </div>
            </div>

            <!-- Footer Strip -->
            <div class="delta-report-footer">
                <div>
                    Print by &amp; Date: <b>@currentUserDisplayName</b> on @DateTime.Now.ToString("dd/MM/yyyy hh:mm tt")
                </div>
            </div>
            <PrintDeveloperFooter />
                                </td></tr>
                            </tfoot>
                        </table>
        </div>
    </div>
            </div>
        </div>
    </div>
}

@if (showAnalyzerNoteModal)
{
    <div class="tickets-modal-backdrop" @onclick="CloseAnalyzerNoteModal">
        <div class="tickets-modal" style="max-width:620px; width:95%;" @onclick:stopPropagation="true">
            <div class="tickets-modal-head">
                <h3>🔬 @I18n.T("Manage Analyzer / Method Notes")</h3>
                <button type="button" class="tickets-modal-close" @onclick="CloseAnalyzerNoteModal">✕</button>
            </div>
            <div class="tickets-modal-body" style="display:flex; flex-direction:column; gap:12px;">
                <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:10px; display:flex; flex-direction:column; gap:8px;">
                    <div style="font-size:12px; font-weight:700; color:#334155;">@(string.IsNullOrWhiteSpace(editingNoteId) ? I18n.T("Add New Analyzer / Method Note") : I18n.T("Edit Analyzer / Method Note"))</div>
                    <input type="text" class="classic-input" @bind="noteFormTitle" placeholder="@I18n.T("Short Title (e.g. Sysmex XN-1000, CLIA, ICT Rapid)")" />
                    <textarea class="classic-input" rows="2" @bind="noteFormText" style="min-height:58px !important; padding:6px 8px !important;" placeholder="@I18n.T("Full note text to print on report...")"></textarea>
                    <div style="display:flex; gap:8px; justify-content:flex-end;">
                        @if (!string.IsNullOrWhiteSpace(editingNoteId))
                        {
                            <button type="button" class="btn btn-secondary tickets-btn" @onclick="ResetAnalyzerNoteForm">@I18n.T("Cancel Edit")</button>
                        }
                        <button type="button" class="btn btn-primary tickets-btn" @onclick="SaveAnalyzerNotePresetAsync">💾 @I18n.T("Save Note")</button>
                    </div>
                </div>

                <div style="max-height:240px; overflow-y:auto; border:1px solid #e2e8f0; border-radius:8px;">
                    <table class="data-table" style="margin:0;">
                        <thead>
                            <tr>
                                <th style="width:150px;">@I18n.T("Title")</th>
                                <th>@I18n.T("Note Text")</th>
                                <th style="width:120px; text-align:center;">@I18n.T("Action")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in analyzerNotePresets)
                            {
                                <tr>
                                    <td style="font-weight:700; font-size:11.5px;">@p.Title</td>
                                    <td style="font-size:11.5px; color:#475569;">@p.NoteText</td>
                                    <td style="text-align:center; white-space:nowrap;">
                                        <button type="button" class="tickets-icon-action" @onclick="() => UseAnalyzerNotePreset(p)" title="@I18n.T("Use this note")">✓</button>
                                        <button type="button" class="tickets-icon-action" @onclick="() => EditAnalyzerNotePreset(p)" title="@I18n.T("Edit")">✎</button>
                                        <button type="button" class="tickets-icon-action danger" @onclick="() => DeleteAnalyzerNotePresetAsync(p.Id)" title="@I18n.T("Delete")">✕</button>
                                    </td>
                                </tr>
                            }
