    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        var principal = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        isAdministrator = principal.IsInRole(RoleNames.Administrator);
        currentUserDisplayName = principal.Identity?.Name ?? (IsImagingMode ? "Medical Radiographer" : "Lab Technician");
        if (int.TryParse(principal.FindFirstValue(AppUserClaimsPrincipalFactory.DoctorProfileIdClaim), out var mappedDoctorId)) currentDoctorProfileId = mappedDoctorId;
        canVerify = isAdministrator || (principal.IsInRole(RoleNames.Doctor) && currentDoctorProfileId.HasValue);
        await using var db = await DbFactory.CreateDbContextAsync();
        doctors = await db.Doctors.AsNoTracking().Where(x => x.Name != null).ToListAsync();
        services = await db.Services.AsNoTracking().ToListAsync();
        categories = await db.ServiceCategories.AsNoTracking().ToDictionaryAsync(x => x.ID);
        await LoadRecentOrdersAsync(db);
        loadedImagingMode = IsImagingMode;
        initialized = true;

        if (memoId.HasValue && memoId.Value > 0)
        {
            searchQuery = memoId.Value.ToString();
            searchMemoId = memoId.Value;
            await LoadMemoAsync();
        }
        else if (!string.IsNullOrWhiteSpace(patientId))
        {
            searchQuery = patientId;
            await ExecuteSearchAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
