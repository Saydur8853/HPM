            "KUB" => GetDefaultImagingParameters("KUB"),
            "Pelvis" => GetDefaultImagingParameters("Pelvis"),
            "CTBrain" => GetDefaultImagingParameters("CT Brain"),
            "CSpine" => GetDefaultImagingParameters("Cervical Spine"),
            "LSSpine" => GetDefaultImagingParameters("Lumbo-Sacral Spine"),
            "Bone" => GetDefaultImagingParameters("Bone"),
            "ECG" => GetDefaultImagingParameters("ECG"),
            _ => GetDefaultImagingParameters("General")
        };
        StateHasChanged();
    }

