    private string AnalyzerNotesFilePath => Path.Combine(HostEnv.ContentRootPath, "App_Data", "analyzer-method-notes.json");

    private async Task LoadAnalyzerNotePresetsAsync()
    {
        try
        {
            if (File.Exists(AnalyzerNotesFilePath))
            {
                var json = await File.ReadAllTextAsync(AnalyzerNotesFilePath);
                analyzerNotePresets = JsonSerializer.Deserialize<List<AnalyzerNotePreset>>(json) ?? [];
            }
        }
        catch
        {
            analyzerNotePresets = [];
        }

        if (analyzerNotePresets.Count == 0)
        {
            analyzerNotePresets =
            [
                new AnalyzerNotePreset { Title = "Sysmex XN 1000-2 & Vision C", NoteText = "Estimations were carried out by automated analyzer Sysmex XN 1000-2, Vision C and Checked manually." },
                new AnalyzerNotePreset { Title = "Biochemistry (Mindray / Cobas)", NoteText = "Assayed by Automated Biochemistry Analyzer and verified by quality control." },
                new AnalyzerNotePreset { Title = "CLIA Immunoassay", NoteText = "Assayed by Chemiluminescence Immunoassay (CLIA) Automated Analyzer." },
                new AnalyzerNotePreset { Title = "ICT Rapid Method", NoteText = "Tested by Rapid Immunochromatographic Assay (ICT) Method." }
            ];
            await PersistAnalyzerNotePresetsAsync();
        }
    }

    private async Task PersistAnalyzerNotePresetsAsync()
    {
        var dir = Path.GetDirectoryName(AnalyzerNotesFilePath);
        if (!string.IsNullOrWhiteSpace(dir)) Directory.CreateDirectory(dir);
        await File.WriteAllTextAsync(AnalyzerNotesFilePath, JsonSerializer.Serialize(analyzerNotePresets, new JsonSerializerOptions { WriteIndented = true }));
    }

    private void OnAnalyzerPresetSelected(ChangeEventArgs e)
    {
        selectedNotePresetId = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(selectedNotePresetId))
        {
            analyzerMethodNote = "";
            return;
        }
        var match = analyzerNotePresets.FirstOrDefault(x => x.Id == selectedNotePresetId);
        if (match != null) analyzerMethodNote = match.NoteText;
    }

    private void OpenAnalyzerNoteModal()
    {
        ResetAnalyzerNoteForm();
        if (!string.IsNullOrWhiteSpace(analyzerMethodNote))
        {
            noteFormText = analyzerMethodNote;
        }
        showAnalyzerNoteModal = true;
    }
    private void CloseAnalyzerNoteModal() => showAnalyzerNoteModal = false;
    private void ResetAnalyzerNoteForm() { editingNoteId = ""; noteFormTitle = ""; noteFormText = ""; }

    private void EditAnalyzerNotePreset(AnalyzerNotePreset p)
    {
        editingNoteId = p.Id;
        noteFormTitle = p.Title;
        noteFormText = p.NoteText;
    }

    private void UseAnalyzerNotePreset(AnalyzerNotePreset p)
    {
        selectedNotePresetId = p.Id;
        analyzerMethodNote = p.NoteText;
        showAnalyzerNoteModal = false;
    }

    private async Task SaveAnalyzerNotePresetAsync()
    {
        if (string.IsNullOrWhiteSpace(noteFormTitle) || string.IsNullOrWhiteSpace(noteFormText)) return;
        if (!string.IsNullOrWhiteSpace(editingNoteId))
        {
            var existing = analyzerNotePresets.FirstOrDefault(x => x.Id == editingNoteId);
            if (existing != null)
            {
                existing.Title = noteFormTitle.Trim();
                existing.NoteText = noteFormText.Trim();
            }
        }
        else
        {
            var created = new AnalyzerNotePreset { Title = noteFormTitle.Trim(), NoteText = noteFormText.Trim() };
            analyzerNotePresets.Add(created);
            selectedNotePresetId = created.Id;
            analyzerMethodNote = created.NoteText;
        }
        await PersistAnalyzerNotePresetsAsync();
        ResetAnalyzerNoteForm();
    }

    private async Task DeleteAnalyzerNotePresetAsync(string id)
    {
        analyzerNotePresets.RemoveAll(x => x.Id == id);
        if (selectedNotePresetId == id) selectedNotePresetId = "";
        await PersistAnalyzerNotePresetsAsync();
    }

