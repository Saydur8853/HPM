@code {
    [SupplyParameterFromQuery] public long? memoId { get; set; }
    [SupplyParameterFromQuery] public string? patientId { get; set; }

    private string searchQuery = "";
    private bool searching;
    private long? searchMemoId;
    private CashMemoDInvestigation? selectedMemo;
    private List<CashMemoDInvestigation> patientMemosList = [];
    private List<CashMemoSubDInvestigation> orderItems = [];
    private List<string> pendingUncollectedTests = [];
    private List<RecentOrderDto> recentOrderDtos = [];
    private List<RecentOrderDto> filteredQueueOrders = [];
    private string queueSearchQuery = "";
    private string queueStatusFilter = "all"; // "all", "Pending", "InProcess", "Verified"
    private DateTime? queueDateFilter;

    private List<LabTestResult> allResults = [];
    private List<LabTestResult> currentTestResults = [];
    private List<LabTestResult> initialTemplateBackup = [];
    private LabSampleCollection? currentSample;
    private string currentSampleType = "Blood";
    private readonly string[] QuickSpecimens = ["Blood", "Serum", "Plasma", "Urine", "Stool", "Sputum", "CSF", "Swab", "Fluid"];
    private string analyzerMethodNote = "";
    private string printMode = "all"; // "active" or "all"
    private bool usePreprintedPad = false;
    private bool showReportPreview = false;
    private bool showResultEntryModal;
    private bool isAutoSaving;
    private DateTime? lastDraftSavedAt;
    private string draftSnapshot = "";
    private string currentUserDisplayName = "Lab Technician";
    private string checkedByTechnologist = "";

    private List<Service> services = [];
    private Dictionary<int, ServiceCategory> categories = [];
    private List<DoctorsProfile> doctors = [];
    private List<LabConsultant> labConsultants = [];
    private List<AnalyzerNotePreset> analyzerNotePresets = [];
    private string selectedNotePresetId = "";
    private bool showAnalyzerNoteModal;
    private string editingNoteId = "";
    private string noteFormTitle = "";
    private string noteFormText = "";
    private bool showConsultantModal;
    private int editingConsultantId;
    private string consultantName = "";
    private string consultantDegree = "";
    private string consultantDesignation = "";
    private string consultantBmdc = "";
    private byte[]? consultantSignatureBytes;
    private bool initialized;

    private sealed class AnalyzerNotePreset
    {
        public string Id { get; set; } = Guid.NewGuid().ToString("N");
        public string Title { get; set; } = "";
        public string NoteText { get; set; } = "";
    }
    private string loadedModeKey = "";
    private string CurrentRouteModeKey => IsSpecialMode ? "special" : IsImagingMode ? "imaging" : "pathology";
    private bool IsImagingMode => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].Equals("diagnostic/imaging-results", StringComparison.OrdinalIgnoreCase);
    private bool IsSpecialMode => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].Equals("diagnostic/special-results", StringComparison.OrdinalIgnoreCase);

    private int activeTestId = 0;
    private int selectedDoctorId = 0;
    private bool isVerified;
    private bool canVerify;
    private bool isAdministrator;
    private int? currentDoctorProfileId;

    private int CompletedTestsCount => orderItems.Count(t => allResults.Any(r => r.ServiceID == t.TestID && !string.IsNullOrWhiteSpace(r.ResultValue)));
    private bool ReportVerified => orderItems.Count > 0
        && orderItems.Select(x => x.TestID).Distinct().All(testId =>
            allResults.Any(x => x.ServiceID == testId) && allResults.Where(x => x.ServiceID == testId).All(x => x.IsVerified));

    private string message = "";
    private string messageClass = "success";

    public sealed class RecentOrderDto
    {
        public long ID { get; set; }
        public string PatientName { get; set; } = "";
        public string? PatientID { get; set; }
        public string? Age { get; set; }
        public string? Sex { get; set; }
        public string? Contact { get; set; }
        public DateTime TransDate { get; set; }
        public int TotalTests { get; set; }
        public int CompletedTests { get; set; }
        public int VerifiedTests { get; set; }
        public string OverallStatus { get; set; } = "Pending";
        public List<string> TestNames { get; set; } = [];
    }

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        Navigation.LocationChanged += HandleLocationChanged;
        var principal = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        isAdministrator = principal.IsInRole(RoleNames.Administrator) || principal.IsInRole(RoleNames.HospitalOwner);
        var isPureLabTech = principal.IsInRole(RoleNames.LabTechnician) && !isAdministrator;
        currentUserDisplayName = AppUser.GetEffectiveName(principal, IsImagingMode ? "Medical Radiographer" : "Lab Technician");
        if (int.TryParse(principal.FindFirstValue(AppUserClaimsPrincipalFactory.DoctorProfileIdClaim), out var mappedDoctorId)) currentDoctorProfileId = mappedDoctorId;
        canVerify = isAdministrator || (principal.IsInRole(RoleNames.Doctor) && currentDoctorProfileId.HasValue);
        await using var db = await DbFactory.CreateDbContextAsync();
        if (int.TryParse(principal.FindFirstValue(ClaimTypes.NameIdentifier), out var uid))
        {
            var currentUser = await db.Users.AsNoTracking().SingleOrDefaultAsync(x => x.Id == uid);
            if (currentUser is not null) currentUserDisplayName = currentUser.GetEffectiveName();
        }
        checkedByTechnologist = isPureLabTech ? currentUserDisplayName : "";
        doctors = await db.Doctors.AsNoTracking().Where(x => x.Name != null).ToListAsync();
        labConsultants = await db.LabConsultants.AsNoTracking().Where(x => x.Is_Active).OrderBy(x => x.Name).ToListAsync();
        await LoadAnalyzerNotePresetsAsync();
        services = await db.Services.AsNoTracking().ToListAsync();
        categories = await db.ServiceCategories.AsNoTracking().ToDictionaryAsync(x => x.ID);
        await LoadRecentOrdersAsync(db);
        loadedModeKey = CurrentRouteModeKey;
        initialized = true;

        if (memoId.HasValue && memoId.Value > 0)
        {
            searchQuery = memoId.Value.ToString();
            searchMemoId = memoId.Value;
            await LoadMemoAsync();
        }
        else if (!string.IsNullOrWhiteSpace(patientId))
        {
            searchQuery = patientId;
            await ExecuteSearchAsync();
        }
    }

    protected override async Task OnParametersSetAsync() => await SyncRouteModeAsync();

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(SyncRouteModeAsync);

    private async Task SyncRouteModeAsync()
    {
        if (!initialized || loadedModeKey == CurrentRouteModeKey) return;
        Reset();
        var principal = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        currentUserDisplayName = AppUser.GetEffectiveName(principal, IsImagingMode ? "Medical Radiographer" : "Lab Technician");
        await using var db = await DbFactory.CreateDbContextAsync();
        if (int.TryParse(principal.FindFirstValue(ClaimTypes.NameIdentifier), out var uid))
        {
            var currentUser = await db.Users.AsNoTracking().SingleOrDefaultAsync(x => x.Id == uid);
            if (currentUser is not null) currentUserDisplayName = currentUser.GetEffectiveName();
        }
        await LoadRecentOrdersAsync(db);
        loadedModeKey = CurrentRouteModeKey;
        StateHasChanged();
    }

    private static readonly string[] PathologyReadyStatuses = ["Collected", "Received", "InProcess", "Completed"];
    private static readonly string[] ImagingReadyStatuses = ["Completed", "InProcess", "Scheduled"];

    private async Task OnQueueDateChangedAsync(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
            queueDateFilter = dt.Date;
        else
            queueDateFilter = null;

        await using var db = await DbFactory.CreateDbContextAsync();
        await LoadRecentOrdersAsync(db);
    }

    private async Task ClearQueueDateAsync()
    {
        queueDateFilter = null;
        await using var db = await DbFactory.CreateDbContextAsync();
        await LoadRecentOrdersAsync(db);
    }

    private async Task LoadRecentOrdersAsync(HpmDbContext db)
    {
        var query = db.EmergencyMemos.Include(x => x.Items).AsNoTracking()
            .Where(x => x.ModuleID == 2);

        if (queueDateFilter.HasValue)
        {
            var dayStart = queueDateFilter.Value.Date;
            var dayEnd = dayStart.AddDays(1);
            query = query.Where(x => x.TransDate >= dayStart && x.TransDate < dayEnd);
        }

        var recentCandidates = await query
            .OrderByDescending(x => x.ID)
            .Take(200)
            .ToListAsync();
        var recentMemoIds = recentCandidates.Select(x => x.ID).ToArray();
        var eligibleStatuses = (IsImagingMode || IsSpecialMode) ? ImagingReadyStatuses : PathologyReadyStatuses;

        var sampleList = await db.LabSampleCollections.AsNoTracking()
            .Where(x => recentMemoIds.Contains(x.MemoID))
            .ToListAsync();
        var sampleDict = sampleList.ToDictionary(x => (x.MemoID, x.ServiceID));

        var resultsList = await db.LabTestResults.AsNoTracking()
            .Where(x => recentMemoIds.Contains(x.MemoID))
            .ToListAsync();
        var resultsGroup = resultsList.GroupBy(x => (x.MemoID, x.ServiceID)).ToDictionary(g => g.Key, g => g.ToList());

        var list = new List<RecentOrderDto>();
        foreach (var m in recentCandidates)
        {
            var validItems = m.Items.Where(i => IsRouteService(i.TestID)).ToList();
            if (validItems.Count == 0) continue;

            // Check eligibility (collected or in process or completed)
            var hasEligible = validItems.Any(i => sampleDict.TryGetValue((m.ID, i.TestID), out var samp) && eligibleStatuses.Contains(samp.Status));
            if (!hasEligible && !IsImagingMode && !IsSpecialMode) continue;

            int totalTests = validItems.Count;
            int completedTests = 0;
            int verifiedTests = 0;

            foreach (var item in validItems)
            {
                if (resultsGroup.TryGetValue((m.ID, item.TestID), out var res) && res.Count > 0)
                {
                    if (res.Any(x => !string.IsNullOrWhiteSpace(x.ResultValue))) completedTests++;
                    if (res.All(x => x.IsVerified)) verifiedTests++;
                }
            }

            string overall = "Pending";
            if (verifiedTests == totalTests && totalTests > 0) overall = "Verified";
            else if (completedTests > 0) overall = "InProcess";

            list.Add(new RecentOrderDto
            {
                ID = m.ID,
                PatientName = m.PatientName,
                PatientID = m.PatientID,
                Age = m.Age,
                Sex = m.Sex,
                Contact = m.Contact,
                TransDate = m.TransDate,
                TotalTests = totalTests,
                CompletedTests = completedTests,
                VerifiedTests = verifiedTests,
                OverallStatus = overall,
                TestNames = validItems.Select(x => ServiceName(x.TestID)).ToList()
            });
        }

        recentOrderDtos = list;
        FilterQueueOrders();
    }

    private void FilterQueueOrders()
    {
        var q = recentOrderDtos.AsEnumerable();
        if (queueStatusFilter != "all")
        {
            q = q.Where(x => x.OverallStatus == queueStatusFilter);
        }
        if (!string.IsNullOrWhiteSpace(queueSearchQuery))
        {
            var s = queueSearchQuery.Trim();
            q = q.Where(x => x.ID.ToString().Contains(s, StringComparison.OrdinalIgnoreCase) ||
                             x.PatientName.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                             (x.PatientID?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                             (x.Contact?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                             x.TestNames.Any(t => t.Contains(s, StringComparison.OrdinalIgnoreCase)));
        }
        filteredQueueOrders = q.ToList();
    }

    private void SetQueueFilter(string filter)
    {
        queueStatusFilter = filter;
        FilterQueueOrders();
    }

    private void ClearQueueSearch()
    {
        queueSearchQuery = "";
        FilterQueueOrders();
    }

    private void SwitchMode(bool imaging)
    {
        var url = imaging ? "diagnostic/imaging-results" : "diagnostic/results";
        if (selectedMemo != null) url += $"?memoId={selectedMemo.ID}";
        Navigation.NavigateTo(url);
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ExecuteSearchAsync();
        }
    }

    private void ClearSearch()
    {
        searchQuery = "";
    }

    private void OpenResultEntry()
    {
        if (selectedMemo != null && activeTestId > 0) showResultEntryModal = true;
    }

    private async Task CloseResultEntryAsync()
    {
        if (!await AutoSaveDraftAsync()) return;
        showResultEntryModal = false;
    }

    private async Task OpenTestAsync(int testId)
    {
        if (testId == activeTestId)
        {
            showResultEntryModal = true;
            return;
        }

        if (!await AutoSaveDraftAsync()) return;
        await SwitchActiveTest(testId);
        showResultEntryModal = true;
    }

    private void SelectSpecimen(string spec)
    {
        currentSampleType = spec;
    }

    private async Task SwitchPatientMemo(long id)
    {
        searchMemoId = id;
        await LoadMemoAsync();
    }

    private async Task ExecuteSearchAsync()
    {
        if (string.IsNullOrWhiteSpace(searchQuery)) return;
        var raw = searchQuery.Trim();
        searching = true;
        message = "";

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            // 1. Check if raw matches barcode/QR (SMP-XXXX-X, LAB-XXXX, HPM:TUBE|...)
            long parsedMemoId = 0;
            int targetSL = 0;
            if (raw.StartsWith("HPM:TUBE|", StringComparison.OrdinalIgnoreCase) || raw.StartsWith("HPM:LAB|", StringComparison.OrdinalIgnoreCase))
            {
                var parts = raw.Split('|');
                foreach (var p in parts)
                {
                    if (p.StartsWith("INV:", StringComparison.OrdinalIgnoreCase) && long.TryParse(p[4..], out var invId)) parsedMemoId = invId;
                    if (p.StartsWith("SMP:", StringComparison.OrdinalIgnoreCase))
                    {
                        var segs = p[4..].Trim().Replace("SMP-", "", StringComparison.OrdinalIgnoreCase).Split('-');
                        if (segs.Length > 0 && long.TryParse(segs[0], out var smpId)) parsedMemoId = smpId;
                        if (segs.Length > 1 && int.TryParse(segs[1], out var sl)) targetSL = sl;
                    }
                }
            }
            else if (raw.StartsWith("LAB-", StringComparison.OrdinalIgnoreCase) && long.TryParse(raw[4..], out var labId))
            {
                parsedMemoId = labId;
            }
            else if (raw.StartsWith("SMP-", StringComparison.OrdinalIgnoreCase))
            {
                var segs = raw[4..].Split('-');
                if (segs.Length > 0 && long.TryParse(segs[0], out var smpId)) parsedMemoId = smpId;
                if (segs.Length > 1 && int.TryParse(segs[1], out var sl)) targetSL = sl;
            }
            else if (raw.StartsWith("D", StringComparison.OrdinalIgnoreCase) && long.TryParse(raw[1..], out var dId))
            {
                parsedMemoId = dId;
            }
            else if (long.TryParse(raw, out var numId))
            {
                var memoById = await db.EmergencyMemos.Include(x => x.Items).AsNoTracking().FirstOrDefaultAsync(x => x.ID == numId && x.ModuleID == 2);
                if (memoById != null)
                {
                    parsedMemoId = numId;
                }
            }

            if (parsedMemoId > 0)
            {
                searchMemoId = parsedMemoId;
                patientMemosList.Clear();
                await LoadMemoAsync();
                if (targetSL > 0 && targetSL <= orderItems.Count)
                {
                    await SwitchActiveTest(orderItems[targetSL - 1].TestID);
                }
                return;
            }

            // 2. Search by Patient ID (PID), Contact/Phone, or Patient Name
            var patientMemos = await db.EmergencyMemos.Include(x => x.Items).AsNoTracking()
                .Where(x => x.ModuleID == 2 && (
                    (x.PatientID != null && x.PatientID == raw) ||
                    (x.PatientID != null && x.PatientID.Contains(raw)) ||
                    (x.Contact != null && x.Contact == raw) ||
                    (x.PatientName != null && x.PatientName.Contains(raw)) ||
                    (x.RegNo != null && x.RegNo == raw)
                ))
                .OrderByDescending(x => x.ID)
                .Take(15)
                .ToListAsync();

            if (patientMemos.Count > 0)
            {
                patientMemosList = patientMemos;
                searchMemoId = patientMemos[0].ID;
                await LoadMemoAsync();
                Success(I18n.IsBangla
                    ? $"রোগী: {patientMemos[0].PatientName} (PID: {patientMemos[0].PatientID ?? "Walk-in"}) এর {patientMemos.Count} টি ডায়াগনস্টিক রেকর্ড পাওয়া গেছে।"
                    : $"Found {patientMemos.Count} diagnostic bills for patient: {patientMemos[0].PatientName} (PID: {patientMemos[0].PatientID ?? "Walk-in"}).");
            }
            else
            {
                Fail(I18n.IsBangla
                    ? $"'{raw}' নম্বরে কোনো ডায়াগনস্টিক টেস্ট বা রোগীর রেকর্ড পাওয়া যায়নি।"
                    : $"No diagnostic order or patient record found for '{raw}'.");
            }
        }
        catch (Exception ex)
        {
            Fail($"Search failed: {ex.Message}");
        }
        finally
        {
            searching = false;
        }
    }

    private async Task LoadMemoAsync()
    {
        if (!searchMemoId.HasValue || searchMemoId.Value <= 0)
        {
            Fail(I18n.IsBangla ? "একটি সঠিক মেমো নম্বর লিখুন।" : "Enter a valid diagnostic memo number.");
            return;
        }

        if (selectedMemo != null && selectedMemo.ID != searchMemoId.Value && !await AutoSaveDraftAsync()) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        selectedMemo = await db.EmergencyMemos.Include(x => x.Items).AsNoTracking()
            .FirstOrDefaultAsync(x => x.ID == searchMemoId.Value && x.ModuleID == 2);

        if (selectedMemo == null)
        {
            Fail(I18n.IsBangla ? "ডায়াগনস্টিক মেমো পাওয়া যায়নি।" : "Diagnostic memo was not found.");
            return;
        }

        var progress = await db.LabSampleCollections.AsNoTracking().Where(x => x.MemoID == selectedMemo.ID).ToDictionaryAsync(x => x.ServiceID, x => x.Status);
        var eligibleStatuses = (IsImagingMode || IsSpecialMode) ? ImagingReadyStatuses : PathologyReadyStatuses;
        orderItems = selectedMemo.Items.Where(x => IsRouteService(x.TestID) && eligibleStatuses.Contains(progress.GetValueOrDefault(x.TestID) ?? "")).ToList();
        pendingUncollectedTests = (!IsImagingMode && !IsSpecialMode)
            ? selectedMemo.Items
                .Where(x => IsRouteService(x.TestID) && !eligibleStatuses.Contains(progress.GetValueOrDefault(x.TestID) ?? ""))
                .Select(x => ServiceName(x.TestID))
                .Distinct()
                .ToList()
            : [];
        allResults = await db.LabTestResults.AsNoTracking()
            .Where(x => x.MemoID == selectedMemo.ID)
            .ToListAsync();
        lastDraftSavedAt = null;

        if (orderItems.Count > 0)
        {
            await SwitchActiveTest(orderItems[0].TestID);
            showResultEntryModal = true;
        }
        else
        {
            showResultEntryModal = false;
            activeTestId = 0;
            currentTestResults.Clear();
            var hasPendingSample = !IsImagingMode && !IsSpecialMode && selectedMemo.Items.Any(x => IsRouteService(x.TestID) && progress.GetValueOrDefault(x.TestID) == "Pending");
            if (hasPendingSample)
            {
                Fail(I18n.IsBangla ? "স্যাম্পল এখনও সংগ্রহ করা হয়নি। দয়া করে আগে স্যাম্পল সংগ্রহ সম্পন্ন করুন।" : "Sample has not been collected yet. Please collect the sample first.");
            }
            else
            {
                Fail(I18n.T(IsSpecialMode ? "No completed special investigations are ready for reporting on this memo." : IsImagingMode ? "No completed imaging studies are ready for reporting on this memo." : "No collected pathology tests are ready for result entry on this memo."));
            }
            return;
        }
        message = "";
    }

    private async Task SwitchActiveTest(int testId)
    {
        activeTestId = testId;
        currentTestResults = allResults.Where(r => r.ServiceID == testId).ToList();
        isVerified = currentTestResults.Count > 0 && currentTestResults.All(x => x.IsVerified);
        selectedDoctorId = currentTestResults.Where(x => x.ReportedBy.HasValue).Select(x => x.ReportedBy!.Value).FirstOrDefault();
        if (!isAdministrator && currentDoctorProfileId.HasValue) selectedDoctorId = currentDoctorProfileId.Value;

        await using var db = await DbFactory.CreateDbContextAsync();
        currentSample = await db.LabSampleCollections.AsNoTracking().FirstOrDefaultAsync(x => x.MemoID == (selectedMemo != null ? selectedMemo.ID : 0) && x.ServiceID == testId);
        if (currentSample != null && !string.IsNullOrWhiteSpace(currentSample.SpecimenType))
        {
            currentSampleType = currentSample.SpecimenType;
        }
        else
        {
            currentSampleType = IsImagingMode ? "Digital Film" : "Blood";
        }
        if (currentSample != null && !string.IsNullOrWhiteSpace(currentSample.Remarks))
        {
            analyzerMethodNote = currentSample.Remarks;
            selectedNotePresetId = analyzerNotePresets.FirstOrDefault(x => string.Equals(x.NoteText.Trim(), analyzerMethodNote.Trim(), StringComparison.OrdinalIgnoreCase))?.Id ?? "";
        }
        else
        {
            analyzerMethodNote = "";
            selectedNotePresetId = "";
        }

        var templates = await db.LabTestParameters.AsNoTracking()
            .Where(x => x.ServiceID == testId)
            .OrderBy(x => x.SortOrder)
            .ToListAsync();

        if (currentTestResults.Count == 0)
        {
            if (templates.Count > 0)
            {
                currentTestResults = templates.Select(t =>
                {
                    var isGroupHead = templates.Count > 1 && string.IsNullOrWhiteSpace(t.Unit) && string.IsNullOrWhiteSpace(t.ReferenceRange);
                    return new LabTestResult
                    {
                        MemoID = selectedMemo?.ID ?? 0,
                        ServiceID = testId,
                        ParameterName = t.ParameterName,
                        Unit = t.Unit,
                        ReferenceRange = t.ReferenceRange,
                        Flag = isGroupHead ? "Header" : "Normal"
                    };
                }).ToList();
            }
            else if (IsImagingMode)
            {
                currentTestResults = GetDefaultImagingParameters(ServiceName(testId));
            }
            else
            {
                currentTestResults = GetDefaultParametersForService(ServiceName(testId), testId);
            }
        }
        else if (templates.Count > 0)
        {
            foreach (var row in currentTestResults)
            {
                var matched = templates.FirstOrDefault(t => string.Equals(t.ParameterName?.Trim(), row.ParameterName?.Trim(), StringComparison.OrdinalIgnoreCase))
                    ?? (templates.Count == 1 && currentTestResults.Count == 1 ? templates[0] : null);
                if (matched != null)
                {
                    if (string.IsNullOrWhiteSpace(row.Unit) && !string.IsNullOrWhiteSpace(matched.Unit))
                        row.Unit = matched.Unit;
                    if (string.IsNullOrWhiteSpace(row.ReferenceRange) && !string.IsNullOrWhiteSpace(matched.ReferenceRange))
                        row.ReferenceRange = matched.ReferenceRange;
                }
            }
        }

        initialTemplateBackup = currentTestResults.Select(x => new LabTestResult
        {
            ParameterName = x.ParameterName,
            Unit = x.Unit,
            ReferenceRange = x.ReferenceRange,
            Flag = x.Flag,
            ResultValue = x.ResultValue
        }).ToList();
        draftSnapshot = BuildDraftSnapshot();
    }

    private string BuildDraftSnapshot() => JsonSerializer.Serialize(new
    {
        MemoId = selectedMemo?.ID,
        TestId = activeTestId,
        SampleType = currentSampleType,
        MethodNote = analyzerMethodNote,
        DoctorId = selectedDoctorId,
        Verified = isVerified,
        Rows = currentTestResults.Select(x => new
        {
            x.ParameterName,
            x.ResultValue,
            x.Unit,
            x.ReferenceRange,
            x.Flag,
            x.Interpretation
        })
    });

    private async Task<bool> AutoSaveDraftAsync()
    {
        if (selectedMemo == null || activeTestId <= 0 || BuildDraftSnapshot() == draftSnapshot) return true;

        isAutoSaving = true;
        try
        {
            var saved = await SaveResultsCoreAsync(showSuccess: false);
            if (saved) lastDraftSavedAt = DateTime.Now;
            return saved;
        }
        finally
        {
            isAutoSaving = false;
        }
    }

    private void OnResultValueInput(LabTestResult row, string? newVal)
    {
        row.ResultValue = newVal ?? "";
        AutoEvaluateFlag(row);
    }

    private void AutoEvaluateFlag(LabTestResult row)
    {
        if (string.IsNullOrWhiteSpace(row.ResultValue)) return;
        var valStr = row.ResultValue.Trim();

        // Check qualitative values first
        var lowerVal = valStr.ToLowerInvariant();
        if (lowerVal is "nil" or "negative" or "normal" or "clear" or "absent" or "none" or "non-reactive")
        {
            row.Flag = "Normal";
            return;
        }
        if (lowerVal is "positive" or "reactive" or "+" or "++" or "+++" or "++++" or "detected")
        {
            row.Flag = "Positive";
            return;
        }

        if (string.IsNullOrWhiteSpace(row.ReferenceRange)) return;
        var refStr = row.ReferenceRange.Trim();

        // Try parsing numeric value
        if (double.TryParse(valStr, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var num))
        {
            // Case: "< 150" or "<= 150"
            if (refStr.StartsWith("<") && double.TryParse(refStr.TrimStart('<', '=', ' '), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var maxVal))
            {
                row.Flag = num > maxVal ? "High" : "Normal";
                return;
            }
            // Case: "> 40" or ">= 40"
            if (refStr.StartsWith(">") && double.TryParse(refStr.TrimStart('>', '=', ' '), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var minVal))
            {
                row.Flag = num < minVal ? "Low" : "Normal";
                return;
            }
            // Case: "12.0 - 16.0" or "12 - 16"
            var rangeMatch = Regex.Match(refStr, @"(?<low>\d+(\.\d+)?)\s*[-–—to]\s*(?<high>\d+(\.\d+)?)");
            if (rangeMatch.Success)
            {
                if (double.TryParse(rangeMatch.Groups["low"].Value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var low) &&
                    double.TryParse(rangeMatch.Groups["high"].Value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var high))
                {
                    if (num < low) row.Flag = "Low";
                    else if (num > high) row.Flag = "High";
                    else row.Flag = "Normal";
                    return;
                }
            }
        }
    }

    private bool IsGroupHeaderRow(LabTestResult r) =>
        !IsImagingMode && string.Equals(r.Flag, "Header", StringComparison.OrdinalIgnoreCase);

    private void SetAllNormal()
    {
        var svcLower = ServiceName(activeTestId).ToLowerInvariant();
        foreach (var r in currentTestResults)
        {
            if (IsGroupHeaderRow(r)) continue;
            r.Flag = "Normal";
            if (string.IsNullOrWhiteSpace(r.ResultValue))
            {
                var pLower = (r.ParameterName ?? "").ToLowerInvariant();
                var refLower = (r.ReferenceRange ?? "").ToLowerInvariant();

                if (refLower.Contains("non-reactive") || refLower.Contains("non reactive")) r.ResultValue = "Non-Reactive";
                else if (refLower.Contains("negative")) r.ResultValue = "Negative";
                else if (refLower == "nil") r.ResultValue = "Nil";
                else if (refLower == "absent") r.ResultValue = "Absent";
                else if (refLower == "clear") r.ResultValue = "Clear";
                else if (pLower.Contains("colour") || pLower.Contains("color")) r.ResultValue = "Straw / Pale Yellow";
                else if (pLower.Contains("appearance")) r.ResultValue = "Clear";
                else if (pLower.Contains("sugar") || pLower.Contains("albumin") || pLower.Contains("protein") || pLower.Contains("blood") || pLower.Contains("ketone") || pLower.Contains("bilirubin") || pLower.Contains("casts") || pLower.Contains("crystals") || pLower.Contains("rbc")) r.ResultValue = "Nil";
                else if (pLower.Contains("pus")) r.ResultValue = "0 - 2 /HPF";
                else if (pLower.Contains("epithelial")) r.ResultValue = "Few (1 - 2 /HPF)";
                else if (pLower.Contains("specific gravity")) r.ResultValue = "1.015";
                else if (pLower.Contains("reaction") || pLower.Contains("ph")) r.ResultValue = "6.0 (Acidic)";
                else if (pLower.Contains("igm") || pLower.Contains("igg") || pLower.Contains("hbsag") || pLower.Contains("hcv") || pLower.Contains("hiv") || pLower.Contains("vdrl") || pLower.Contains("tpha") || pLower.Contains("dengue") || pLower.Contains("ns1") || svcLower.Contains("igm") || svcLower.Contains("igg") || svcLower.Contains("hbsag") || svcLower.Contains("hcv") || svcLower.Contains("hiv") || svcLower.Contains("vdrl"))
                    r.ResultValue = "Non-Reactive";
            }
        }
        Success(I18n.IsBangla ? "সকল প্যারামিটার স্বাভাবিক (Normal) নির্ধারণ করা হয়েছে।" : "All parameters set to Normal reference findings.");
    }

    private void SetBlankResultsToNil()
    {
        var changed = 0;
        foreach (var row in currentTestResults)
        {
            if (IsGroupHeaderRow(row)
                || string.IsNullOrWhiteSpace(row.ParameterName)
                || !string.IsNullOrWhiteSpace(row.ResultValue))
            {
                continue;
            }

            row.ResultValue = "Nil";
            row.Flag = "Normal";
            changed++;
        }

        Success(I18n.IsBangla
            ? $"{changed}টি ফাঁকা রেজাল্টে Nil বসানো হয়েছে।"
            : changed == 1 ? "1 empty result set to Nil." : $"{changed} empty results set to Nil.");
    }

    private void ClearParameterValues()
    {
        foreach (var r in currentTestResults)
        {
            if (IsGroupHeaderRow(r)) continue;
            r.ResultValue = "";
            r.Flag = "Normal";
        }
        Success(I18n.IsBangla ? "প্যারামিটার ভ্যালু মুছে দেওয়া হয়েছে।" : "Parameter values cleared.");
    }

