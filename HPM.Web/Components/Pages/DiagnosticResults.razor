    private string ServiceName(int id) => services.FirstOrDefault(x => x.ID == id)?.Name ?? $"Study #{id}";
    
    private bool IsRouteService(int id)
    {
        var service = services.FirstOrDefault(x => x.ID == id);
        if (service is null) return false;
        var category = service.CategoryID.HasValue ? categories.GetValueOrDefault(service.CategoryID.Value) : null;
        if (IsSpecialMode) return DiagnosticTestRouting.IsProcedure(service, category);
        if (IsImagingMode) return DiagnosticTestRouting.IsImaging(service, category);
        return DiagnosticTestRouting.IsPathology(service, category);
    }

    private string DoctorFormatted(int? id)
    {
        var d = doctors.FirstOrDefault(x => x.ID == id);
        if (d == null) return I18n.IsBangla ? "ডিউটি ডাক্তার" : "Duty Doctor / OPD";
        var titleName = string.Join(" ", new[] { d.Title, d.Name }.Where(s => !string.IsNullOrWhiteSpace(s)));
        var degree = !string.IsNullOrWhiteSpace(d.Degree) ? $", {d.Degree}" : "";
        var att = !string.IsNullOrWhiteSpace(d.Attachment) && d.Attachment != "Temporary" && d.Attachment != "Permanent" ? $" ({d.Attachment})" : "";
        return $"{titleName}{degree}{att}";
    }

    private string GetImagingModality(string serviceName)
    {
        var sLower = serviceName.ToLowerInvariant();
        if (sLower.Contains("x-ray") || sLower.Contains("xray") || sLower.Contains("radiograph"))
            return "DIGITAL RADIOGRAPHY (X-RAY)";
        if (sLower.Contains("usg") || sLower.Contains("ultra") || sLower.Contains("sonogram"))
            return "ULTRASONOGRAPHY (USG)";
        if (sLower.Contains("ct") || sLower.Contains("computed"))
            return "COMPUTED TOMOGRAPHY (CT SCAN)";
        if (sLower.Contains("mri") || sLower.Contains("magnetic"))
            return "MAGNETIC RESONANCE IMAGING (MRI)";
        if (sLower.Contains("echo"))
            return "ECHOCARDIOGRAPHY";
        if (sLower.Contains("ecg") || sLower.Contains("ekg"))
            return "ELECTROCARDIOGRAM (ECG)";
        if (sLower.Contains("endo"))
            return "ENDOSCOPY";
        return "DIAGNOSTIC IMAGING";
    }

    private string GetFormattedHospitalAddress()
    {
        var addr = (Branding.Address ?? "").Trim();
        var city = (Branding.CityDistrict ?? "").Trim();
        if (string.IsNullOrWhiteSpace(city)) return addr;
        if (string.IsNullOrWhiteSpace(addr)) return city;
        var cityFirstToken = city.Split(',')[0].Trim();
        if (!string.IsNullOrWhiteSpace(cityFirstToken) && addr.Contains(cityFirstToken[..Math.Min(6, cityFirstToken.Length)], StringComparison.OrdinalIgnoreCase))
        {
            var lastPart = city.Contains(',') ? city[(city.IndexOf(',') + 1)..].Trim() : "";
            if (!string.IsNullOrWhiteSpace(lastPart) && !addr.Contains(lastPart, StringComparison.OrdinalIgnoreCase))
                return $"{addr}, {lastPart}";
            return addr;
        }
        return $"{addr}, {city}";
    }

    private string GetReportCategoryTitle()
    {
        var targetId = printMode == "all" && orderItems.Count > 0 ? orderItems[0].TestID : activeTestId;
        var svc = services.FirstOrDefault(x => x.ID == targetId);
        var cat = svc?.CategoryID != null ? categories.GetValueOrDefault(svc.CategoryID.Value) : null;

        if (cat != null && !string.IsNullOrWhiteSpace(cat.Name))
        {
            var catUpper = cat.Name.Trim().ToUpperInvariant();
            if (catUpper is not ("INVESTIGATION" or "OTHERS" or "OTHERS(D INVESTIGATION)" or "PATHOLOGY INSTRUMENT"))
            {
                if (catUpper.EndsWith("REPORT")) return catUpper;
                if (IsImagingMode) return $"RADIOLOGY & IMAGING — {catUpper} REPORT";
                return $"{catUpper} REPORT";
            }
        }

        if (IsImagingMode)
        {
            var sName = ServiceName(activeTestId).ToUpperInvariant();
            if (sName.Contains("X-RAY") || sName.Contains("XRAY") || sName.Contains("CHEST"))
                return "RADIOLOGY & IMAGING — X-RAY REPORT";
            if (sName.Contains("USG") || sName.Contains("ULTRA") || sName.Contains("SONO"))
                return "RADIOLOGY & IMAGING — ULTRASONOGRAPHY REPORT";
            if (sName.Contains("CT"))
                return "RADIOLOGY & IMAGING — CT SCAN REPORT";
            if (sName.Contains("MRI"))
                return "RADIOLOGY & IMAGING — MRI REPORT";
            return "RADIOLOGY & IMAGING REPORT";
        }

        var pName = ServiceName(targetId).ToUpperInvariant();
        if (pName.Contains("CBC") || pName.Contains("HAEMATOLOGY") || pName.Contains("BLOOD GROUP") || pName.Contains("ESR") || pName.Contains("TC, DC") || pName.Contains("HEMOGLOBIN") || pName.Contains("HAEMOGLOBIN") || pName.Contains("PLATELET") || pName.Contains("PBF"))
            return "HAEMATOLOGY REPORT";
        if (pName.Contains("TSH") || pName.Contains("FT3") || pName.Contains("FT4") || pName.Contains("T3") || pName.Contains("T4") || pName.Contains("PROLACTIN") || pName.Contains("FERRITIN") || pName.Contains("VITAMIN") || pName.Contains("HBA1C") || pName.Contains("INSULIN") || pName.Contains("HORMONE") || pName.Contains("TROPONIN") || pName.Contains("PSA") || pName.Contains("HCG"))
            return "HORMONE & IMMUNOASSAY REPORT";
        if (pName.Contains("GLUCOSE") || pName.Contains("SUGAR") || pName.Contains("RBS") || pName.Contains("FBS") || pName.Contains("LIPID") || pName.Contains("CHOLESTEROL") || pName.Contains("TRIGLYCERIDE") || pName.Contains("CREATININE") || pName.Contains("UREA") || pName.Contains("SGPT") || pName.Contains("SGOT") || pName.Contains("ALT") || pName.Contains("AST") || pName.Contains("LFT") || pName.Contains("ELECTROLYTE") || pName.Contains("BILIRUBIN") || pName.Contains("URIC ACID") || pName.Contains("CALCIUM"))
            return "CLINICAL BIOCHEMISTRY REPORT";
        if (pName.Contains("URINE") || pName.Contains("STOOL") || pName.Contains("SEMEN") || pName.Contains("R/E"))
            return "CLINICAL PATHOLOGY REPORT";
        if (pName.Contains("CULTURE") || pName.Contains("SENSITIVITY") || pName.Contains("GRAM") || pName.Contains("AFB") || pName.Contains("SPUTUM"))
            return "MICROBIOLOGY REPORT";
        if (pName.Contains("SEROLOGY") || pName.Contains("WIDAL") || pName.Contains("HBSAG") || pName.Contains("HCV") || pName.Contains("HIV") || pName.Contains("VDRL") || pName.Contains("TPHA") || pName.Contains("DENGUE") || pName.Contains("NS1") || pName.Contains("COVID") || pName.Contains("HEPATITIS") || pName.Contains("IGM") || pName.Contains("IGG") || pName.Contains("ASO") || pName.Contains("CRP"))
            return "IMMUNOLOGY & SEROLOGY REPORT";
        if (pName.Contains("BIOPSY") || pName.Contains("FNAC") || pName.Contains("HISTOPATHOLOGY") || pName.Contains("CYTOLOGY"))
            return "HISTOPATHOLOGY & CYTOLOGY REPORT";
        return IsSpecialMode ? "SPECIAL INVESTIGATION REPORT" : "LABORATORY INVESTIGATION REPORT";
    }

    private string GetReportTestsTitle()
    {
