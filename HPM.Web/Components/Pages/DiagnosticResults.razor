        loadedImagingMode = IsImagingMode;
    }

    private static readonly string[] PathologyReadyStatuses = ["Collected", "Received", "InProcess", "Completed"];
    private static readonly string[] ImagingReadyStatuses = ["Completed", "InProcess", "Scheduled"];

    private async Task LoadRecentOrdersAsync(HpmDbContext db)
    {
        var recentCandidates = await db.EmergencyMemos.Include(x => x.Items).AsNoTracking()
            .Where(x => x.ModuleID == 2)
            .OrderByDescending(x => x.ID)
            .Take(40)
            .ToListAsync();
        var recentMemoIds = recentCandidates.Select(x => x.ID).ToArray();
        var eligibleStatuses = IsImagingMode ? ImagingReadyStatuses : PathologyReadyStatuses;

        var sampleList = await db.LabSampleCollections.AsNoTracking()
            .Where(x => recentMemoIds.Contains(x.MemoID))
            .ToListAsync();
        var sampleDict = sampleList.ToDictionary(x => (x.MemoID, x.ServiceID));

        var resultsList = await db.LabTestResults.AsNoTracking()
            .Where(x => recentMemoIds.Contains(x.MemoID))
            .ToListAsync();
        var resultsGroup = resultsList.GroupBy(x => (x.MemoID, x.ServiceID)).ToDictionary(g => g.Key, g => g.ToList());

        var list = new List<RecentOrderDto>();
        foreach (var m in recentCandidates)
        {
            var validItems = m.Items.Where(i => IsRouteService(i.TestID)).ToList();
            if (validItems.Count == 0) continue;

            // Check eligibility (collected or in process or completed)
            var hasEligible = validItems.Any(i => sampleDict.TryGetValue((m.ID, i.TestID), out var samp) && eligibleStatuses.Contains(samp.Status));
            if (!hasEligible && !IsImagingMode) continue;

            int totalTests = validItems.Count;
            int completedTests = 0;
            int verifiedTests = 0;

            foreach (var item in validItems)
            {
                if (resultsGroup.TryGetValue((m.ID, item.TestID), out var res) && res.Count > 0)
                {
                    if (res.Any(x => !string.IsNullOrWhiteSpace(x.ResultValue))) completedTests++;
                    if (res.All(x => x.IsVerified)) verifiedTests++;
                }
            }

            string overall = "Pending";
            if (verifiedTests == totalTests && totalTests > 0) overall = "Verified";
            else if (completedTests > 0) overall = "InProcess";

            list.Add(new RecentOrderDto
            {
                ID = m.ID,
                PatientName = m.PatientName,
                PatientID = m.PatientID,
                Age = m.Age,
                Sex = m.Sex,
                Contact = m.Contact,
                TransDate = m.TransDate,
                TotalTests = totalTests,
                CompletedTests = completedTests,
                VerifiedTests = verifiedTests,
                OverallStatus = overall,
                TestNames = validItems.Select(x => ServiceName(x.TestID)).ToList()
            });
        }

        recentOrderDtos = list;
        FilterQueueOrders();
    }

    private void FilterQueueOrders()
    {
        var q = recentOrderDtos.AsEnumerable();
        if (queueStatusFilter != "all")
        {
            q = q.Where(x => x.OverallStatus == queueStatusFilter);
        }
        if (!string.IsNullOrWhiteSpace(queueSearchQuery))
        {
            var s = queueSearchQuery.Trim();
            q = q.Where(x => x.ID.ToString().Contains(s, StringComparison.OrdinalIgnoreCase) ||
                             x.PatientName.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                             (x.PatientID?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                             (x.Contact?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                             x.TestNames.Any(t => t.Contains(s, StringComparison.OrdinalIgnoreCase)));
        }
        filteredQueueOrders = q.ToList();
    }

    private void SetQueueFilter(string filter)
    {
        queueStatusFilter = filter;
        FilterQueueOrders();
    }

