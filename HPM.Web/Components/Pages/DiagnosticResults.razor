    private List<LabTestResult> GetDefaultParametersForService(string serviceName, int testId)
    {
        var sLower = serviceName.ToLowerInvariant();
        var memoIdVal = selectedMemo?.ID ?? 0;

        if (sLower.Contains("cbc") || sLower.Contains("complete blood") || sLower.Contains("haematology") || sLower.Contains("hemoglobin") || sLower.Contains("tc, dc"))
        {
            return
            [
                new LabTestResult { MemoID = memoIdVal, ServiceID = testId, ParameterName = "Haemoglobin", Unit = "g/dL", ReferenceRange = "Adult: Men: 15.0±2.0, Women: 13.5±1.5\nAt birth: 13.5, 3 Days: 14.5 - 22.5\n1 Month: 11-17, 2-6 Months: 9.5-13.5", Flag = "Normal" },
                new LabTestResult { MemoID = memoIdVal, ServiceID = testId, ParameterName = "Haematocrit/PCV", Unit = "%", ReferenceRange = "36 - 50", Flag = "Normal" },
