    private List<LabTestResult> GetDefaultImagingParameters(string serviceName)
    {
        var memoIdVal = selectedMemo?.ID ?? 0;
        var sLower = serviceName.ToLowerInvariant();

        if (sLower.Contains("chest"))
        {
            return
            [
                new LabTestResult { MemoID = memoIdVal, ServiceID = activeTestId, ParameterName = "Technique", ResultValue = "Digital Radiography - Chest P/A View" },
                new LabTestResult { MemoID = memoIdVal, ServiceID = activeTestId, ParameterName = "Findings", ResultValue = "Bony thorax, ribs and visualized clavicles appear normal.\nBoth diaphragmatic domes and costophrenic angles are clear.\nLung fields are clear of any focal parenchymal infiltration, consolidation or mass lesion.\nCardiac silhouette is within normal limits in size and configuration (CTR < 50%).\nMediastinum and hilar vascular shadows are within normal limits.\nTrachea is midline in position." },
                new LabTestResult { MemoID = memoIdVal, ServiceID = activeTestId, ParameterName = "Impression", ResultValue = "Normal chest radiograph (No active cardiopulmonary lesion seen)." }
            ];
        }
        else if (sLower.Contains("abdomen") || sLower.Contains("usg"))
        {
            return
            [
                new LabTestResult { MemoID = memoIdVal, ServiceID = activeTestId, ParameterName = "Technique", ResultValue = "Real-time B-mode transabdominal ultrasonography" },
                new LabTestResult { MemoID = memoIdVal, ServiceID = activeTestId, ParameterName = "Findings", ResultValue = "LIVER: Normal in size, contour and parenchymal echotexture. No focal mass lesion, cyst or calcification seen. Intrahepatic biliary channels and portal vein are normal.\nGALLBLADDER: Well distended with smooth, thin wall. Lumen is acoustic shadow-free. No calculus or polyp seen. CBD is normal in caliber.\nPANCREAS: Visualized portions are normal in size and echogenicity.\nSPLEEN: Normal in size and homogenous. Splenic vein is normal.\nKIDNEYS: Both kidneys are normal in size, shape, position and cortical thickness. Corticomedullary differentiation is well preserved. No calculus, mass or hydronephrosis seen.\nURINARY BLADDER: Well distended with smooth mucosal wall. Lumen is clear. No calculus or mass lesion seen.\nPELVIC CAVITY: No free fluid in pouch of Douglas / peritoneal cavity." },
                new LabTestResult { MemoID = memoIdVal, ServiceID = activeTestId, ParameterName = "Impression", ResultValue = "Sonographically normal study of whole abdomen. No significant organic abnormality detected." }
            ];
        }
        else if (sLower.Contains("kub"))
        {
            return
            [
                new LabTestResult { MemoID = memoIdVal, ServiceID = activeTestId, ParameterName = "Technique", ResultValue = "Plain Radiography - KUB Region" },
