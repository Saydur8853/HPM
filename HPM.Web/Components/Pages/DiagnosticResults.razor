    }

    private async Task SaveParametersToMasterAsync()
    {
        if (!isAdministrator || activeTestId <= 0) return;
        var validRows = currentTestResults.Where(x => !string.IsNullOrWhiteSpace(x.ParameterName)).ToList();
        if (validRows.Count == 0)
        {
            Fail(I18n.IsBangla ? "সেভ করার জন্য কমপক্ষে একটি প্যারামিটার রাখুন।" : "Add at least one parameter to save as master template.");
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var existingParams = await db.LabTestParameters.Where(x => x.ServiceID == activeTestId).ToListAsync();
        db.LabTestParameters.RemoveRange(existingParams);

        for (var i = 0; i < validRows.Count; i++)
        {
            var r = validRows[i];
            var isHead = IsGroupHeaderRow(r);
            db.LabTestParameters.Add(new LabTestParameter
            {
                ServiceID = activeTestId,
                ParameterName = r.ParameterName.Trim(),
                Unit = isHead || string.IsNullOrWhiteSpace(r.Unit) ? null : r.Unit.Trim(),
                ReferenceRange = isHead || string.IsNullOrWhiteSpace(r.ReferenceRange) ? null : r.ReferenceRange.Trim(),
                SortOrder = i + 1
            });
        }
        await db.SaveChangesAsync();
        Success(I18n.IsBangla ? $"{ServiceName(activeTestId)}-এর প্যারামিটারগুলো মাস্টার সেটআপে সংরক্ষিত হয়েছে।" : $"Parameters saved permanently to Investigations Setup for {ServiceName(activeTestId)}.");
    }

