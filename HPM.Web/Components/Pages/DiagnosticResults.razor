    private async Task SaveConsultantAsync()
    {
        if (string.IsNullOrWhiteSpace(consultantName)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        LabConsultant entity;
        if (editingConsultantId > 0)
        {
            entity = await db.LabConsultants.FirstOrDefaultAsync(x => x.ID == editingConsultantId) ?? new LabConsultant();
            if (entity.ID == 0) db.LabConsultants.Add(entity);
        }
        else
        {
            entity = new LabConsultant { Is_Active = true };
            db.LabConsultants.Add(entity);
        }
        entity.Name = consultantName.Trim();
        entity.Degree = string.IsNullOrWhiteSpace(consultantDegree) ? null : consultantDegree.Trim();
        entity.Title1 = string.IsNullOrWhiteSpace(consultantDesignation) ? null : consultantDesignation.Trim();
        entity.Title2 = string.IsNullOrWhiteSpace(consultantBmdc) ? null : consultantBmdc.Trim();
        entity.Signature = consultantSignatureBytes;
        entity.Is_Active = true;
        await db.SaveChangesAsync();

        labConsultants = await db.LabConsultants.AsNoTracking().Where(x => x.Is_Active).OrderBy(x => x.Name).ToListAsync();
        selectedDoctorId = -entity.ID;
        ResetConsultantForm();
    }

    private async Task DeleteConsultantAsync(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.LabConsultants.FirstOrDefaultAsync(x => x.ID == id);
        if (entity != null)
        {
            entity.Is_Active = false;
            await db.SaveChangesAsync();
        }
        labConsultants = await db.LabConsultants.AsNoTracking().Where(x => x.Is_Active).OrderBy(x => x.Name).ToListAsync();
        if (selectedDoctorId == -id) selectedDoctorId = 0;
    }

