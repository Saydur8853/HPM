@page "/diagnostic/results"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.LabTechnician + "," + RoleNames.Doctor)]
@using System.Security.Claims
@rendermode InteractiveServer
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject IBarcodeQrService BarcodeQr
@inject NavigationManager Navigation
@implements IDisposable
@using HPM.Web.Components.Common

<PageTitle>@I18n.T("Results & Report") | @Branding.HospitalName</PageTitle>

<div class="results-classic-fit">
    <!-- Compact Top Action & Status Bar -->
    <div class="results-classic-topbar">
        <div class="tickets-top-left">
            <h1 class="tickets-page-title">
                <span>🧪</span>
                <span>@I18n.T("Pathology & Lab Result Entry")</span>
            </h1>
            @if (selectedMemo != null)
            {
                <span class="tickets-count-pill" style="background:#e0f2fe; color:#0369a1; border-color:#bae6fd;">
                    #@selectedMemo.ID &bull; @selectedMemo.PatientName
                </span>
            }
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <span class="tickets-inline-alert @messageClass" title="@message">
                    @(messageClass.Contains("danger") ? "⚠" : "✓") @message
                </span>
            }
        </div>

        <div class="tickets-top-actions" style="display:flex; align-items:center; gap:8px;">
            <NavLink href="diagnostic/worklist" class="btn btn-secondary tickets-btn">
                &larr; @I18n.T("Lab Worklist")
            </NavLink>
            <button class="btn btn-secondary tickets-btn" @onclick="Reset" title="@I18n.T("Clear / New search")">
                + @I18n.T("Clear / New")
            </button>
        </div>
    </div>

    <!-- Main Workspace Grid: Left Result Entry Form, Right Recent Lab Orders -->
    <div class="results-classic-workspace">
        <!-- Left Panel: Result Entry Card -->
        <div class="results-form-card">
            <div class="results-card-header">
                <h2>@(selectedMemo == null ? I18n.T("Search Invoice No or Scan Specimen Tube") : $"{I18n.T("Results & Report Entry")} — #{selectedMemo.ID}")</h2>
                @if (selectedMemo != null)
                {
                    <span class="diagnostic-badge">
                        MEMO #@selectedMemo.ID
                    </span>
                }
            </div>

            <div class="results-form-body">
                <!-- Search & Scanner Bar -->
                <div style="display:flex; gap:8px; align-items:center;">
                    <div class="tickets-scanner-bar" style="margin:0; flex:1;">
                        <div class="tickets-scanner-input-wrap">
                            <span class="tickets-scanner-icon" title="Barcode Scanner">📷</span>
                            <input type="text"
                                   class="classic-input tickets-scanner-input"
                                   placeholder="@I18n.T("Scan Sample Tube (SMP-XXXX), Invoice (LAB-XXXX), or Diagnostic QR & press Enter...")"
                                   @bind="resultsScanQuery"
                                   @bind:event="oninput"
                                   @onkeydown="HandleResultsScanKeyDown" />
                            @if (!string.IsNullOrWhiteSpace(resultsScanQuery))
                            {
                                <button type="button" class="tickets-scanner-clear" @onclick="ClearResultsScan" title="Clear">✕</button>
                            }
                        </div>
                    </div>

                    <div style="display:flex; gap:4px; align-items:center;">
                        <InputNumber class="classic-input" style="width:110px;" @bind-Value="searchMemoId" placeholder="@I18n.T("Memo #")" />
                        <button type="button" class="btn btn-secondary tickets-btn" @onclick="LoadMemoAsync">
                            🔍 @I18n.T("Load")
                        </button>
                    </div>
                </div>

                @if (selectedMemo != null)
                {
                    <!-- Patient Summary Strip -->
                    <div class="results-patient-strip">
                        <div>
                            <span>@I18n.T("Patient Name")</span>
                            <strong>@selectedMemo.PatientName</strong>
                        </div>
                        <div>
                            <span>@I18n.T("Patient ID / Sex")</span>
                            <strong>@(selectedMemo.PatientID ?? I18n.T("Walk-in")) (@selectedMemo.Age / @selectedMemo.Sex)</strong>
                        </div>
                        <div>
                            <span>@I18n.T("Contact")</span>
                            <strong>@(selectedMemo.Contact ?? "—")</strong>
                        </div>
                        <div>
                            <span>@I18n.T("Referred by")</span>
                            <strong>@DoctorName(selectedMemo.DoctorID)</strong>
                        </div>
                    </div>

                    <!-- Test Selector Tabs -->
                    <div>
                        <div class="billing-section-heading" style="margin-bottom:4px;">
                            🔬 @I18n.T("Selected Tests & Investigations")
                        </div>
                        <div class="results-test-tabs">
                            @foreach (var test in orderItems)
                            {
                                var sName = ServiceName(test.TestID);
                                var hasResults = allResults.Any(x => x.ServiceID == test.TestID);
                                var isTestVerified = hasResults && allResults.Where(x => x.ServiceID == test.TestID).All(x => x.IsVerified);
                                <button type="button"
                                        class="btn tickets-btn @(activeTestId == test.TestID ? "btn-primary" : "btn-secondary")"
                                        style="font-size:11px; padding:3px 10px; border-radius:14px;"
                                        @onclick="() => SwitchActiveTest(test.TestID)">
                                    @(isTestVerified ? "✓ " : hasResults ? "📝 " : "")@sName
                                </button>
                            }
                        </div>
                    </div>

                    @if (activeTestId > 0)
                    {
                        <!-- Parameter Table -->
                        <div>
                            <div class="billing-section-heading" style="margin-bottom:4px;">
                                📋 @I18n.T("Investigation Details"): @ServiceName(activeTestId)
                            </div>
                            <div class="results-param-table-wrap">
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th>@I18n.T("Parameter Name")</th>
                                            <th style="width:160px;">@I18n.T("Observed Value")<span style="color:#dc2626;">*</span></th>
                                            <th style="width:85px;">@I18n.T("Unit")</th>
                                            <th style="width:130px;">@I18n.T("Reference Range")</th>
                                            <th style="width:100px;">@I18n.T("Flag")</th>
                                            <th style="width:30px;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (var i = 0; i < currentTestResults.Count; i++)
                                        {
                                            var idx = i;
                                            var row = currentTestResults[idx];
                                            <tr>
                                                <td>
                                                    <InputText class="classic-input" @bind-Value="row.ParameterName" style="font-weight:700; height:26px !important; padding:2px 6px !important;" />
                                                </td>
                                                <td>
                                                    <InputText class="classic-input bold-number" @bind-Value="row.ResultValue" style="height:26px !important; padding:2px 6px !important;" placeholder="e.g. 14.5 or Negative" />
                                                </td>
                                                <td>
                                                    <InputText class="classic-input" @bind-Value="row.Unit" style="width:80px; height:26px !important; padding:2px 6px !important;" placeholder="g/dL" />
                                                </td>
                                                <td>
                                                    <InputText class="classic-input" @bind-Value="row.ReferenceRange" style="height:26px !important; padding:2px 6px !important;" placeholder="12.0 - 16.0" />
                                                </td>
                                                <td>
                                                    <InputSelect class="classic-input tickets-select" @bind-Value="row.Flag" style="font-size:11px; height:26px !important; padding:2px 4px !important;">
                                                        <option value="Normal">Normal</option>
                                                        <option value="High">High</option>
                                                        <option value="Low">Low</option>
                                                        <option value="Positive">Positive</option>
                                                        <option value="Negative">Negative</option>
                                                    </InputSelect>
                                                </td>
                                                <td>
                                                    <button type="button" class="tickets-icon-action danger" @onclick="() => RemoveParameter(idx)" title="@I18n.T("Delete")">✕</button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Verification & Add Parameter Bar -->
                        <div style="display:flex; justify-content:space-between; align-items:center; background:#f8fafc; border:1px solid #e2e8f0; border-radius:6px; padding:6px 10px;">
                            <button class="btn btn-secondary tickets-btn" type="button" style="font-size:11px;" @onclick="AddBlankParameter">
                                + @I18n.T("Add Parameter")
                            </button>

                            @if (canVerify)
                            {
                                <div style="display:flex; align-items:center; gap:10px;">
                                    <label style="display:flex; align-items:center; gap:6px; margin:0; font-size:11px; font-weight:700; color:#334155;">
                                        <span>@I18n.T("Pathologist / Consultant"):</span>
                                        <InputSelect class="classic-input tickets-select" style="min-width:140px; height:26px !important;" @bind-Value="selectedDoctorId" disabled="@(!isAdministrator)">
                                            <option value="0">@I18n.T("Select Doctor")</option>
                                            @foreach (var d in doctors)
                                            {
                                                <option value="@d.ID">@d.Title @d.Name</option>
                                            }
                                        </InputSelect>
                                    </label>
                                    <label style="display:flex; align-items:center; gap:5px; margin:0; font-size:11.5px; font-weight:750; color:#047857; cursor:pointer;">
                                        <InputCheckbox @bind-Value="isVerified" />
                                        <span>@I18n.T("Mark Verified & Signed")</span>
                                    </label>
                                </div>
                            }
                            else
                            {
                                <span style="font-size:11px; color:#64748b; font-style:italic;">
                                    @I18n.T("Draft results only. Pathologist / Doctor must verify.")
                                </span>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="tickets-queue-empty" style="padding: 3rem 1rem;">
                        <span style="font-size: 2.5rem;">🧪</span>
                        <strong style="font-size: 13.5px; color:#1e293b;">@I18n.T("Select a Diagnostic Bill to Enter Test Results")</strong>
                        <span style="font-size: 11.5px; color:#64748b;">
                            @I18n.T("Scan barcode from specimen tube or bill invoice, or click an order from the list on the right.")
                        </span>
                    </div>
                }
            </div>

            <!-- Footer Actions -->
            <div class="results-form-footer">
                @if (selectedMemo != null && activeTestId > 0)
                {
                    <button class="btn btn-primary tickets-btn" type="button" @onclick="SaveResultsAsync">
                        💾 @I18n.T("Save Test Results")
                    </button>
                    <div style="display:flex; align-items:center; gap:6px;">
                        <button class="btn btn-secondary tickets-btn" type="button" @onclick="PrintAsync" disabled="@(!ReportVerified)" title="@(ReportVerified ? I18n.T("Print Lab Report") : I18n.T("Report must be verified before printing"))">
                            🖨 @I18n.T("Print Lab Report")
                        </button>
                        <button class="btn btn-ghost tickets-btn" type="button" @onclick="Reset">
                            @I18n.T("Clear")
                        </button>
                    </div>
                }
                else
                {
                    <div></div>
                    <button class="btn btn-ghost tickets-btn" type="button" @onclick="Reset">
                        @I18n.T("Clear")
                    </button>
                }
            </div>
        </div>

        <!-- Right Panel: Recent Lab Orders Queue Card -->
        <div class="results-queue-card">
            <div class="results-queue-top">
                <div style="display:flex; align-items:center; gap:8px;">
                    <h2>@I18n.T("Recent Lab Orders")</h2>
                    <span style="font-size:11.5px; color:#64748b; font-weight:600;">
                        (@DateTime.Today.ToString("dd MMMM yyyy"))
                    </span>
                </div>
                <span class="pill" style="font-size:11px; font-weight:700;">
                    @recentOrders.Count @I18n.T("Listed")
                </span>
            </div>

            <div class="billing-queue-list">
                @if (!recentOrders.Any())
                {
                    <div class="tickets-queue-empty">
                        <span style="font-size: 2rem;">🧪</span>
                        <span>@I18n.T("No recent lab orders found.")</span>
                    </div>
                }
                @foreach (var o in recentOrders)
                {
                    <div class="billing-queue-item @(selectedMemo?.ID == o.ID ? "active" : "")" @onclick="() => SelectOrder(o.ID)">
                        <span class="billing-queue-serial">#@o.ID</span>
                        <div class="billing-queue-info">
                            <span class="billing-queue-name">
                                @o.PatientName
                                @if (!string.IsNullOrWhiteSpace(o.PatientID))
                                {
                                    <small class="tickets-queue-reg">(@o.PatientID)</small>
                                }
                            </span>
                            <span class="billing-queue-meta">
                                @o.TransDate.ToString("dd MMM · hh:mm tt") &bull; @o.Age / @o.Sex
                            </span>
                        </div>
                        <div class="tickets-queue-actions" @onclick:stopPropagation="true">
                            <button type="button" class="btn btn-secondary tickets-btn" style="font-size:10.5px; padding:2px 8px;" @onclick="() => SelectOrder(o.ID)">
                                @I18n.T("View") &rarr;
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (selectedMemo != null)
{
    <div id="lab-report-print" class="print-sheet print-document">
        <div class="clinical-report-sheet a4-page-sheet">
            <PrintDocumentHeader Title="@I18n.T("OFFICIAL CLINICAL LABORATORY INVESTIGATION REPORT", "OFFICIAL CLINICAL LABORATORY INVESTIGATION REPORT")"
                                 Subtitle="@Branding.LabHeaderDept"
                                 DocNo="@($"#{selectedMemo.ID}")"
                                 DocNoLabel="Invoice #"
                                 BarcodeCode="@($"LAB-{selectedMemo.ID}")"
                                 QrPayload="@BarcodeQr.GenerateLabQrPayload(selectedMemo.ID, selectedMemo.PatientID ?? "", selectedMemo.PatientName, $"SMP-{selectedMemo.ID}", Navigation.BaseUri)" />

            <!-- Patient Demographics Info Grid -->
            <div class="report-patient-grid">
                <div class="patient-grid-item">
                    <span class="grid-label">@I18n.T("Patient Name"):</span>
                    <strong class="grid-value">@selectedMemo.PatientName</strong>
                </div>
                <div class="patient-grid-item">
                    <span class="grid-label">@I18n.T("Patient ID (PID)"):</span>
                    <strong class="grid-value">@(selectedMemo.PatientID ?? I18n.T("Walk-in"))</strong>
                </div>
                <div class="patient-grid-item">
                    <span class="grid-label">@I18n.T("Age / Gender"):</span>
                    <strong class="grid-value">@selectedMemo.Age / @selectedMemo.Sex</strong>
                </div>
                <div class="patient-grid-item">
                    <span class="grid-label">@I18n.T("Contact No"):</span>
                    <strong class="grid-value">@(selectedMemo.Contact ?? "—")</strong>
                </div>
                <div class="patient-grid-item">
                    <span class="grid-label">@I18n.T("Invoice / Memo #"):</span>
                    <strong class="grid-value">#@selectedMemo.ID</strong>
                </div>
                <div class="patient-grid-item">
                    <span class="grid-label">@I18n.T("Specimen / Tube ID"):</span>
                    <strong class="grid-value">SMP-@selectedMemo.ID</strong>
                </div>
                <div class="patient-grid-item span-2">
                    <span class="grid-label">@I18n.T("Referred By Doctor"):</span>
                    <strong class="grid-value">@DoctorName(selectedMemo.DoctorID)</strong>
                </div>
                <div class="patient-grid-item">
                    <span class="grid-label">@I18n.T("Date of Order"):</span>
                    <strong class="grid-value">@selectedMemo.TransDate.ToString("dd MMM yyyy, hh:mm tt")</strong>
                </div>
                <div class="patient-grid-item">
                    <span class="grid-label">@I18n.T("Report Released"):</span>
                    <strong class="grid-value">@DateTime.Now.ToString("dd MMM yyyy, hh:mm tt")</strong>
                </div>
            </div>

            <!-- Investigation Test Results -->
            @foreach (var testId in orderItems.Select(x => x.TestID).Distinct())
            {
                var testResults = allResults.Where(r => r.ServiceID == testId).ToList();
                if (testResults.Count > 0)
                {
                    <div class="report-investigation-block">
                        <div class="investigation-title-bar">
                            <h3 class="investigation-name">🔬 @ServiceName(testId)</h3>
                            <span class="investigation-badge">@I18n.T("VERIFIED TEST", "VERIFIED TEST")</span>
                        </div>

                        <table class="report-parameter-table">
                            <thead>
                                <tr>
                                    <th style="width: 32%;">@I18n.T("Investigation Parameter", "Investigation Parameter")</th>
                                    <th class="text-center" style="width: 20%;">@I18n.T("Observed Result", "Observed Result")</th>
                                    <th class="text-center" style="width: 14%;">@I18n.T("Unit", "Unit")</th>
                                    <th style="width: 22%;">@I18n.T("Reference Range", "Reference Range")</th>
                                    <th class="text-center" style="width: 12%;">@I18n.T("Status", "Status")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var res in testResults)
                                {
                                    var flagClass = (res.Flag ?? "Normal").ToLowerInvariant() switch
                                    {
                                        "high" => "flag-high",
                                        "low" => "flag-low",
                                        "critical" => "flag-critical",
                                        "positive" => "flag-high",
                                        _ => "flag-normal"
                                    };
                                    <tr>
                                        <td class="param-name"><b>@res.ParameterName</b></td>
                                        <td class="param-value text-center">
                                            <span class="value-highlight @flagClass">@res.ResultValue</span>
                                        </td>
                                        <td class="param-unit text-center">@(res.Unit ?? "—")</td>
                                        <td class="param-range">@(res.ReferenceRange ?? "—")</td>
                                        <td class="param-flag text-center">
                                            <span class="flag-pill @flagClass">
                                                @(res.Flag ?? "Normal")
                                            </span>
                                        </td>
                                    </tr>
                                    @if (!string.IsNullOrWhiteSpace(res.Interpretation))
                                    {
                                        <tr class="interpretation-row">
                                            <td colspan="5">
                                                <small><b>@I18n.T("Interpretation / Clinical Note:", "Interpretation / Clinical Note:"):</b> @res.Interpretation</small>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

            <PrintDocumentFooter SignTitle1="@I18n.T("Medical Technologist (Lab)", "Medical Technologist (Lab)")"
                                 SignTitle3="@DoctorName(selectedDoctorId > 0 ? selectedDoctorId : selectedMemo.DoctorID)"
                                 PageNumberText="Page 1 of 1" />
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery] public long? memoId { get; set; }

    private long? searchMemoId;
    private string resultsScanQuery = "";
    private CashMemoDInvestigation? selectedMemo;
    private List<CashMemoSubDInvestigation> orderItems = [];
    private List<CashMemoDInvestigation> recentOrders = [];
    private List<LabTestResult> allResults = [];
    private List<LabTestResult> currentTestResults = [];
    private List<Service> services = [];
    private List<DoctorsProfile> doctors = [];

    private int activeTestId = 0;
    private int selectedDoctorId = 0;
    private bool isVerified;
    private bool canVerify;
    private bool isAdministrator;
    private int? currentDoctorProfileId;
    private bool ReportVerified => orderItems.Count > 0
        && orderItems.Select(x => x.TestID).Distinct().All(testId =>
            allResults.Any(x => x.ServiceID == testId) && allResults.Where(x => x.ServiceID == testId).All(x => x.IsVerified));

    private string message = "";
    private string messageClass = "success";

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        var principal = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        isAdministrator = principal.IsInRole(RoleNames.Administrator);
        if (int.TryParse(principal.FindFirstValue(AppUserClaimsPrincipalFactory.DoctorProfileIdClaim), out var mappedDoctorId)) currentDoctorProfileId = mappedDoctorId;
        canVerify = isAdministrator || (principal.IsInRole(RoleNames.Doctor) && currentDoctorProfileId.HasValue);
        await using var db = await DbFactory.CreateDbContextAsync();
        doctors = await db.Doctors.AsNoTracking().Where(x => x.Name != null).ToListAsync();
        services = await db.Services.AsNoTracking().ToListAsync();
        recentOrders = await db.EmergencyMemos.AsNoTracking()
            .Where(x => x.ModuleID == 2)
            .OrderByDescending(x => x.ID)
            .Take(30)
            .ToListAsync();

        if (memoId.HasValue && memoId.Value > 0)
        {
            searchMemoId = memoId.Value;
            await LoadMemoAsync();
        }
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadMemoAsync()
    {
        if (!searchMemoId.HasValue || searchMemoId.Value <= 0)
        {
            Fail(I18n.IsBangla ? "একটি সঠিক মেমো নম্বর লিখুন।" : "Enter a valid diagnostic memo number.");
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        selectedMemo = await db.EmergencyMemos.Include(x => x.Items).AsNoTracking()
            .FirstOrDefaultAsync(x => x.ID == searchMemoId.Value && x.ModuleID == 2);

        if (selectedMemo == null)
        {
            Fail(I18n.IsBangla ? "ডায়াগনস্টিক মেমো পাওয়া যায়নি।" : "Diagnostic memo was not found.");
            return;
        }

        orderItems = selectedMemo.Items.ToList();
        allResults = await db.LabTestResults.AsNoTracking()
            .Where(x => x.MemoID == selectedMemo.ID)
            .ToListAsync();

        if (orderItems.Count > 0)
        {
            await SwitchActiveTest(orderItems[0].TestID);
        }
        message = "";
    }

    private async Task SwitchActiveTest(int testId)
    {
        activeTestId = testId;
        currentTestResults = allResults.Where(r => r.ServiceID == testId).ToList();
        isVerified = currentTestResults.Count > 0 && currentTestResults.All(x => x.IsVerified);
        selectedDoctorId = currentTestResults.Where(x => x.ReportedBy.HasValue).Select(x => x.ReportedBy!.Value).FirstOrDefault();
        if (!isAdministrator && currentDoctorProfileId.HasValue) selectedDoctorId = currentDoctorProfileId.Value;

        if (currentTestResults.Count == 0)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var templates = await db.LabTestParameters.AsNoTracking()
                .Where(x => x.ServiceID == testId)
                .OrderBy(x => x.SortOrder)
                .ToListAsync();

            if (templates.Count > 0)
            {
                currentTestResults = templates.Select(t => new LabTestResult
                {
                    MemoID = selectedMemo?.ID ?? 0,
                    ServiceID = testId,
                    ParameterName = t.ParameterName,
                    Unit = t.Unit,
                    ReferenceRange = t.ReferenceRange,
                    Flag = "Normal"
                }).ToList();
            }
            else
            {
                currentTestResults.Add(new LabTestResult
                {
                    MemoID = selectedMemo?.ID ?? 0,
                    ServiceID = testId,
                    ParameterName = ServiceName(testId),
                    Flag = "Normal"
                });
            }
        }
    }

    private void AddBlankParameter()
    {
        currentTestResults.Add(new LabTestResult
        {
            MemoID = selectedMemo?.ID ?? 0,
            ServiceID = activeTestId,
            ParameterName = I18n.IsBangla ? "নতুন প্যারামিটার" : "New Parameter",
            Flag = "Normal"
        });
    }

    private void RemoveParameter(int idx)
    {
        if (idx >= 0 && idx < currentTestResults.Count)
        {
            currentTestResults.RemoveAt(idx);
        }
    }

    private async Task SaveResultsAsync()
    {
        if (selectedMemo == null || activeTestId <= 0) return;

        var principal = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        var canVerifyNow = isAdministrator || (principal.IsInRole(RoleNames.Doctor) && currentDoctorProfileId.HasValue);
        if (!isAdministrator && currentDoctorProfileId.HasValue) selectedDoctorId = currentDoctorProfileId.Value;
        var verify = canVerifyNow && isVerified;
        if (verify && selectedDoctorId <= 0)
        {
            Fail(I18n.IsBangla ? "রিপোর্ট সত্যায়নকারী ডাক্তার/প্যাথলজিস্ট নির্বাচন করুন।" : "Select the doctor/pathologist who verified the report.");
            return;
        }
        if (currentTestResults.Count == 0 || currentTestResults.Any(x => string.IsNullOrWhiteSpace(x.ParameterName) || string.IsNullOrWhiteSpace(x.ResultValue)))
        {
            Fail(I18n.IsBangla ? "প্রতিটি প্যারামিটারের নাম এবং ফলাফল লিখুন।" : "Every result needs a parameter name and result value.");
            return;
        }

        try
        {
            await using var strategyDb = await DbFactory.CreateDbContextAsync();
            var strategy = strategyDb.Database.CreateExecutionStrategy();
            await strategy.ExecuteAsync(async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                var existing = await db.LabTestResults
                    .Where(x => x.MemoID == selectedMemo.ID && x.ServiceID == activeTestId)
                    .ToListAsync();

                if (!canVerifyNow && existing.Any(x => x.IsVerified))
                {
                    throw new InvalidOperationException("This test is already verified. Only a Doctor or Administrator can change it.");
                }
                if (!isAdministrator && existing.Any(x => x.IsVerified && x.ReportedBy != currentDoctorProfileId))
                {
                    throw new InvalidOperationException("A report verified by another doctor can be amended only by an administrator.");
                }

                db.LabTestResults.RemoveRange(existing);

                var now = DateTime.Now;
                foreach (var r in currentTestResults)
                {
                    r.MemoID = selectedMemo.ID;
                    r.ServiceID = activeTestId;
                    r.ReportedAt = now;
                    r.ReportedBy = verify ? selectedDoctorId : null;
                    r.IsVerified = verify;
                    db.LabTestResults.Add(r);
                }

                await db.SaveChangesAsync();
            });

            Success(I18n.IsBangla ? $"{ServiceName(activeTestId)}-এর ফলাফল সংরক্ষিত হয়েছে।" : $"Results for {ServiceName(activeTestId)} saved successfully.");
            await using var dbQuery = await DbFactory.CreateDbContextAsync();
            allResults = await dbQuery.LabTestResults.AsNoTracking().Where(x => x.MemoID == selectedMemo.ID).ToListAsync();
        }
        catch (Exception ex)
        {
            Fail(I18n.IsBangla ? $"ফলাফল সংরক্ষণ করা যায়নি: {ex.GetBaseException().Message}" : $"Could not save results: {ex.GetBaseException().Message}");
        }
    }

    private async Task HandleResultsScanKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ProcessResultsScanAsync();
        }
    }

    private async Task ProcessResultsScanAsync()
    {
        if (string.IsNullOrWhiteSpace(resultsScanQuery)) return;
        var raw = resultsScanQuery.Trim();

        long parsedMemoId = 0;
        int targetTestSL = 0;

        if (raw.StartsWith("HPM:TUBE|", StringComparison.OrdinalIgnoreCase) || raw.StartsWith("HPM:LAB|", StringComparison.OrdinalIgnoreCase))
        {
            var parts = raw.Split('|');
            foreach (var p in parts)
            {
                if (p.StartsWith("INV:", StringComparison.OrdinalIgnoreCase) && long.TryParse(p.Substring(4), out var invId))
                {
                    parsedMemoId = invId;
                }
                if (p.StartsWith("SMP:", StringComparison.OrdinalIgnoreCase))
                {
                    var smp = p.Substring(4).Trim();
                    if (smp.StartsWith("SMP-", StringComparison.OrdinalIgnoreCase))
                    {
                        var segs = smp.Substring(4).Split('-');
                        if (segs.Length > 0 && long.TryParse(segs[0], out var smpMemoId))
                        {
                            parsedMemoId = smpMemoId;
                        }
                        if (segs.Length > 1 && int.TryParse(segs[1], out var sl))
                        {
                            targetTestSL = sl;
                        }
                    }
                }
            }
        }
        else if (raw.StartsWith("LAB-", StringComparison.OrdinalIgnoreCase) && long.TryParse(raw.Substring(4), out var labId))
        {
            parsedMemoId = labId;
        }
        else if (raw.Contains("/portal/report/", StringComparison.OrdinalIgnoreCase))
        {
            var idx = raw.LastIndexOf("/portal/report/", StringComparison.OrdinalIgnoreCase);
            var idStr = raw.Substring(idx + "/portal/report/".Length).Trim().TrimEnd('/');
            if (long.TryParse(idStr, out var portalId))
            {
                parsedMemoId = portalId;
            }
        }
        else if (raw.StartsWith("SMP-", StringComparison.OrdinalIgnoreCase))
        {
            var segs = raw.Substring(4).Split('-');
            if (segs.Length > 0 && long.TryParse(segs[0], out var smpMemoId))
            {
                parsedMemoId = smpMemoId;
            }
            if (segs.Length > 1 && int.TryParse(segs[1], out var sl))
            {
                targetTestSL = sl;
            }
        }
        else if (long.TryParse(raw, out var numId))
        {
            parsedMemoId = numId;
        }

        if (parsedMemoId > 0)
        {
            searchMemoId = parsedMemoId;
            await LoadMemoAsync();
            resultsScanQuery = "";

            if (selectedMemo != null && targetTestSL > 0 && targetTestSL <= orderItems.Count)
            {
                var targetItem = orderItems[targetTestSL - 1];
                await SwitchActiveTest(targetItem.TestID);
            }
        }
        else
        {
            Fail(I18n.IsBangla ? "স্ক্যান করা কোড থেকে মেমো পাওয়া যায়নি।" : "Could not resolve diagnostic order from scanned code.");
        }
    }

    private void ClearResultsScan() => resultsScanQuery = "";

    private async Task SelectOrder(long id)
    {
        searchMemoId = id;
        await LoadMemoAsync();
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("hpm.printElement", "lab-report-print", "Lab Investigation Report");

    private void Reset()
    {
        searchMemoId = null;
        selectedMemo = null;
        orderItems.Clear();
        allResults.Clear();
        currentTestResults.Clear();
        activeTestId = 0;
        message = "";
    }

    private string ServiceName(int id) => services.FirstOrDefault(x => x.ID == id)?.Name ?? $"Test #{id}";
    private string DoctorName(int? id)
    {
        var d = doctors.FirstOrDefault(x => x.ID == id);
        return d == null ? (I18n.IsBangla ? "ডিউটি ডাক্তার" : "Duty Doctor") : $"{d.Title} {d.Name}";
    }

    private void Success(string text) { messageClass = "success"; message = text; }
    private void Fail(string text) { messageClass = "danger"; message = text; }

    public void Dispose()
    {
        I18n.OnLanguageChanged -= HandleLanguageChanged;
    }
}
