    private void MoveParameterUp(int idx)
    {
        if (idx > 0 && idx < currentTestResults.Count)
        {
            var temp = currentTestResults[idx];
            currentTestResults[idx] = currentTestResults[idx - 1];
            currentTestResults[idx - 1] = temp;
        }
    }

    private void MoveParameterDown(int idx)
    {
        if (idx >= 0 && idx < currentTestResults.Count - 1)
        {
            var temp = currentTestResults[idx];
            currentTestResults[idx] = currentTestResults[idx + 1];
            currentTestResults[idx + 1] = temp;
        }
    }

    private void RemoveParameter(int idx)
    {
        if (idx >= 0 && idx < currentTestResults.Count)
        {
            currentTestResults.RemoveAt(idx);
        }
    }

    private async Task SaveResultsAsync()
    {
        if (selectedMemo == null || activeTestId <= 0) return;

        var principal = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        var canVerifyNow = isAdministrator || (principal.IsInRole(RoleNames.Doctor) && currentDoctorProfileId.HasValue);
        if (!isAdministrator && currentDoctorProfileId.HasValue) selectedDoctorId = currentDoctorProfileId.Value;
        var verify = canVerifyNow && isVerified;
        if (verify && selectedDoctorId <= 0)
        {
            Fail(I18n.IsBangla ? "রিপোর্ট সত্যায়নকারী ডাক্তার নির্বাচন করুন।" : $"Select the doctor/{(IsImagingMode ? "radiologist" : "pathologist")} who verified the report.");
            return;
        }

        var validRows = currentTestResults.Where(x => !string.IsNullOrWhiteSpace(x.ParameterName)).ToList();
        if (validRows.Count == 0)
        {
            Fail(I18n.IsBangla ? "কমপক্ষে একটি প্যারামিটার বা সেকশন নাম লিখুন।" : "Enter at least one parameter or report section name.");
            return;
        }

        try
        {
            await using var strategyDb = await DbFactory.CreateDbContextAsync();
            var strategy = strategyDb.Database.CreateExecutionStrategy();
            await strategy.ExecuteAsync(async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                var existing = await db.LabTestResults
                    .Where(x => x.MemoID == selectedMemo.ID && x.ServiceID == activeTestId)
                    .ToListAsync();

                if (!canVerifyNow && existing.Any(x => x.IsVerified))
                {
                    throw new InvalidOperationException("This report is already verified. Only a Doctor or Administrator can change it.");
                }
                if (!isAdministrator && existing.Any(x => x.IsVerified && x.ReportedBy != currentDoctorProfileId))
                {
                    throw new InvalidOperationException("A report verified by another doctor can be amended only by an administrator.");
                }

                db.LabTestResults.RemoveRange(existing);

                var now = DateTime.Now;
                foreach (var r in currentTestResults)
                {
                    r.MemoID = selectedMemo.ID;
                    r.ServiceID = activeTestId;
                    r.ReportedAt = verify ? now : null;
                    r.ReportedBy = selectedDoctorId > 0 ? selectedDoctorId : null;
                    r.IsVerified = verify;
                    db.LabTestResults.Add(r);
                }

                // Update sample collection / imaging tracking
                var sample = await db.LabSampleCollections.FirstOrDefaultAsync(x => x.MemoID == selectedMemo.ID && x.ServiceID == activeTestId);
                if (sample != null)
                {
                    if (!string.IsNullOrWhiteSpace(currentSampleType))
                    {
                        sample.SpecimenType = currentSampleType;
                    }
                    if (verify)
                    {
                        sample.Status = "Completed";
                        sample.CompletedAt = now;
                        sample.CompletedBy = selectedDoctorId;
                    }
                    else if (sample.Status == "Collected" || sample.Status == "Received")
                    {
                        sample.Status = "InProcess";
                        sample.ProcessingStartedAt ??= now;
                    }
                }

                await db.SaveChangesAsync();
            });

            Success(I18n.IsBangla ? $"{ServiceName(activeTestId)}-এর লিখিত রিপোর্ট সংরক্ষিত হয়েছে।" : $"Written report for {ServiceName(activeTestId)} saved successfully.");
            await using var dbQuery = await DbFactory.CreateDbContextAsync();
            allResults = await dbQuery.LabTestResults.AsNoTracking().Where(x => x.MemoID == selectedMemo.ID).ToListAsync();
            await LoadRecentOrdersAsync(dbQuery);
        }
        catch (Exception ex)
        {
            Fail(I18n.IsBangla ? $"ফলাফল সংরক্ষণ করা যায়নি: {ex.GetBaseException().Message}" : $"Could not save results: {ex.GetBaseException().Message}");
        }
    }

    private async Task SaveAndNextTestAsync()
    {
        await SaveResultsAsync();
        var currentIndex = orderItems.FindIndex(x => x.TestID == activeTestId);
        if (currentIndex >= 0 && currentIndex < orderItems.Count - 1)
        {
            await SwitchActiveTest(orderItems[currentIndex + 1].TestID);
        }
        else
        {
            Success(I18n.IsBangla ? "সকল টেস্টের ফলাফল সংরক্ষণ সম্পন্ন হয়েছে।" : "All ordered tests have been saved.");
        }
    }

    private async Task VerifyAllTestsAsync()
    {
        if (selectedMemo == null) return;
        var principal = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        var canVerifyNow = isAdministrator || (principal.IsInRole(RoleNames.Doctor) && currentDoctorProfileId.HasValue);
        if (!canVerifyNow)
        {
            Fail(I18n.IsBangla ? "শুধুমাত্র অনুমোদিত ডাক্তার বা অ্যাডমিন রিপোর্ট সত্যায়ন করতে পারবেন।" : "Only authorized Doctor or Administrator can verify reports.");
            return;
        }
        if (selectedDoctorId <= 0)
        {
            Fail(I18n.IsBangla ? "রিপোর্ট সত্যায়নকারী ডাক্তার নির্বাচন করুন।" : "Please select the verifying doctor.");
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var now = DateTime.Now;
            var results = await db.LabTestResults.Where(x => x.MemoID == selectedMemo.ID).ToListAsync();
            foreach (var r in results)
            {
                r.IsVerified = true;
                r.ReportedAt = now;
                r.ReportedBy = selectedDoctorId;
            }

            var samples = await db.LabSampleCollections.Where(x => x.MemoID == selectedMemo.ID).ToListAsync();
            foreach (var s in samples)
            {
                s.Status = "Completed";
                s.CompletedAt = now;
                s.CompletedBy = selectedDoctorId;
            }

            await db.SaveChangesAsync();
            Success(I18n.IsBangla ? "এই মেমোর সকল টেস্ট সফলভাবে সত্যায়ন ও সম্পন্ন করা হয়েছে।" : "All tests on this memo have been verified and marked completed.");
            allResults = await db.LabTestResults.AsNoTracking().Where(x => x.MemoID == selectedMemo.ID).ToListAsync();
            isVerified = true;
            await LoadRecentOrdersAsync(db);
        }
        catch (Exception ex)
        {
            Fail($"Verification failed: {ex.Message}");
        }
    }

    private async Task UnlockReportAsync()
    {
        if (!isAdministrator) return;
        if (selectedMemo == null || activeTestId <= 0) return;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var results = await db.LabTestResults.Where(x => x.MemoID == selectedMemo.ID && x.ServiceID == activeTestId).ToListAsync();
            foreach (var r in results)
            {
                r.IsVerified = false;
            }
            var sample = await db.LabSampleCollections.FirstOrDefaultAsync(x => x.MemoID == selectedMemo.ID && x.ServiceID == activeTestId);
            if (sample != null)
            {
                sample.Status = "InProcess";
            }
            await db.SaveChangesAsync();
            isVerified = false;
            allResults = await db.LabTestResults.AsNoTracking().Where(x => x.MemoID == selectedMemo.ID).ToListAsync();
            Success(I18n.IsBangla ? "রিপোর্ট এডিটের জন্য আনলক করা হয়েছে।" : "Report unlocked for amendments.");
            await LoadRecentOrdersAsync(db);
        }
        catch (Exception ex)
        {
            Fail($"Unlock failed: {ex.Message}");
        }
    }

    private async Task CopySummaryAsync()
    {
        if (selectedMemo == null) return;
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"--- {Branding.HospitalName} ---");
        sb.AppendLine($"{(IsImagingMode ? "RADIOLOGY REPORT" : "DIAGNOSTIC LAB REPORT")}");
        sb.AppendLine($"Patient: {selectedMemo.PatientName} (PID: {selectedMemo.PatientID ?? "Walk-in"}) | {selectedMemo.Age} / {selectedMemo.Sex}");
        sb.AppendLine($"Bill No: #D{selectedMemo.ID} | Date: {selectedMemo.TransDate:dd/MM/yyyy}");
        sb.AppendLine($"Test: {ServiceName(activeTestId)}");
        sb.AppendLine("--------------------------------");
        foreach (var r in currentTestResults.Where(x => !string.IsNullOrWhiteSpace(x.ParameterName)))
        {
            if (string.IsNullOrWhiteSpace(r.ResultValue) && string.IsNullOrWhiteSpace(r.Unit))
            {
                sb.AppendLine($"\n[{r.ParameterName}]");
            }
            else
            {
                sb.AppendLine($"{r.ParameterName}: {r.ResultValue} {r.Unit} (Ref: {r.ReferenceRange}) {(r.Flag != "Normal" ? $"[{r.Flag}]" : "")}");
            }
        }
        sb.AppendLine("--------------------------------");
        sb.AppendLine($"Reported by: {GetConsultantDoctorTitleAndName()}");
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", sb.ToString());
        Success(I18n.IsBangla ? "রিপোর্ট সামারি ক্লিপবোর্ডে কপি করা হয়েছে।" : "Report summary copied to clipboard.");
    }

