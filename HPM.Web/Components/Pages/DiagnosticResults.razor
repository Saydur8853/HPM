    private string GetExpectedDeliveryDate()
    {
        if (selectedMemo == null) return DateTime.Today.ToString("dd/MM/yy");
        var displayedIds = GetTestsToDisplay();
        var maxTatHours = services
            .Where(s => displayedIds.Contains(s.ID) && s.DeliveryHours.HasValue && s.DeliveryHours.Value > 0)
            .Select(s => s.DeliveryHours!.Value)
            .DefaultIfEmpty(0)
            .Max();
        if (maxTatHours > 0)
        {
            return selectedMemo.TransDate.AddHours(maxTatHours).ToString("dd/MM/yy hh:mm tt");
        }
        return selectedMemo.TransDate.ToString("dd/MM/yy");
    }

    private string GetSampleCollectionTime()
    {
        if (currentSample?.CollectedAt != null) return currentSample.CollectedAt.Value.ToString("dd/MM/yyyy hh:mm tt");
        return selectedMemo?.TransDate.AddMinutes(5).ToString("dd/MM/yyyy hh:mm tt") ?? DateTime.Now.ToString("dd/MM/yyyy hh:mm tt");
    }

    private string GetSampleReceiveTime()
    {
        if (currentSample?.ReceivedAt != null) return currentSample.ReceivedAt.Value.ToString("dd/MM/yyyy hh:mm tt");
        if (currentSample?.ProcessingStartedAt != null) return currentSample.ProcessingStartedAt.Value.ToString("dd/MM/yyyy hh:mm tt");
        if (currentSample?.CollectedAt != null) return currentSample.CollectedAt.Value.AddMinutes(10).ToString("dd/MM/yyyy hh:mm tt");
        return selectedMemo?.TransDate.AddMinutes(25).ToString("dd/MM/yyyy hh:mm tt") ?? DateTime.Now.ToString("dd/MM/yyyy hh:mm tt");
    }

