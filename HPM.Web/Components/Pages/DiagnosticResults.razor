@page "/diagnostic/results"
@page "/diagnostic/imaging-results"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.LabTechnician + "," + RoleNames.Doctor)]
@using System.Security.Claims
@using System.Text.RegularExpressions
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject IBarcodeQrService BarcodeQr
@inject NavigationManager Navigation
@inject HospitalSetupService Branding
@implements IDisposable
@using HPM.Web.Components.Common

<PageTitle>@I18n.T(IsImagingMode ? "Imaging Report Entry" : "Lab Results & Report") | @Branding.HospitalName</PageTitle>

<!-- Diagnostic Module Workflow Navigation Tabs -->
<DiagnosticNavTabs />

<div class="results-classic-fit" style="margin-top: 8px;">
    <!-- Top Action & Status Bar -->
    <div class="results-classic-topbar">
        <div class="tickets-top-left" style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
            <h1 class="tickets-page-title" style="margin:0;">
                <span>@(IsImagingMode ? "🩻" : "🧪")</span>
                <span>@I18n.T(IsImagingMode ? "Imaging & Radiology Reports" : "Pathology & Lab Results")</span>
            </h1>

            <!-- Quick Mode Switcher -->
            <div class="results-mode-toggle">
                <button type="button" 
                        class="results-mode-btn @(!IsImagingMode ? "active" : "")" 
                        @onclick="() => SwitchMode(false)"
                        title="@I18n.T("Switch to Pathology / Laboratory Results")">
                    🧪 @I18n.T("Pathology / Lab")
                </button>
                <button type="button" 
                        class="results-mode-btn @(IsImagingMode ? "active imaging" : "")" 
                        @onclick="() => SwitchMode(true)"
                        title="@I18n.T("Switch to Radiology / Imaging Reports")">
                    🩻 @I18n.T("Radiology / Imaging")
                </button>
            </div>

            @if (selectedMemo != null)
            {
                <span class="tickets-count-pill" style="background:#e0f2fe; color:#0369a1; border-color:#bae6fd;">
                    #@selectedMemo.ID &bull; @selectedMemo.PatientName @(string.IsNullOrWhiteSpace(selectedMemo.PatientID) ? "" : $"(PID: {selectedMemo.PatientID})")
                </span>
            }

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <span class="tickets-inline-alert @messageClass" title="@message">
                    @(messageClass.Contains("danger") ? "⚠" : "✓") @message
                </span>
            }
        </div>

        <div class="tickets-top-actions" style="display:flex; align-items:center; gap:8px;">
            <button class="btn btn-secondary tickets-btn" @onclick="Reset" title="@I18n.T("Clear / New search")">
                + @I18n.T("Clear / New")
            </button>
        </div>
    </div>

    <!-- Quick Status / KPI Counters Bar -->
    <div class="results-kpi-bar" style="margin-top: 6px;">
        <button type="button" class="results-kpi-pill total @(queueStatusFilter == "all" ? "active" : "")" @onclick='() => SetQueueFilter("all")'>
            📊 @I18n.T("Total Listed"): <strong>@recentOrderDtos.Count</strong>
        </button>
        <button type="button" class="results-kpi-pill pending @(queueStatusFilter == "Pending" ? "active" : "")" @onclick='() => SetQueueFilter("Pending")'>
            ⏳ @I18n.T("Awaiting Results"): <strong>@recentOrderDtos.Count(x => x.OverallStatus == "Pending")</strong>
        </button>
        <button type="button" class="results-kpi-pill draft @(queueStatusFilter == "InProcess" ? "active" : "")" @onclick='() => SetQueueFilter("InProcess")'>
            📝 @I18n.T("Draft / In Process"): <strong>@recentOrderDtos.Count(x => x.OverallStatus == "InProcess")</strong>
        </button>
        <button type="button" class="results-kpi-pill verified @(queueStatusFilter == "Verified" ? "active" : "")" @onclick='() => SetQueueFilter("Verified")'>
            ✅ @I18n.T("Verified & Finalized"): <strong>@recentOrderDtos.Count(x => x.OverallStatus == "Verified")</strong>
        </button>
    </div>

    <!-- Main Workspace Grid: Left Result Entry Form, Right Recent Orders Queue -->
    <div class="results-classic-workspace">
        <!-- Left Panel: Result Entry Card -->
        <div class="results-form-card">
            <div class="results-card-header">
                <h2>@(selectedMemo == null ? I18n.T("Search Test #, Memo #, or Patient ID (PID)") : $"{I18n.T(IsImagingMode ? "Imaging Report Entry" : "Results & Report Entry")} — #{selectedMemo.ID}")</h2>
                @if (selectedMemo != null)
                {
                    <div style="display:flex; align-items:center; gap:8px;">
                        <span class="diagnostic-badge">
                            MEMO #@selectedMemo.ID
                        </span>
                        @if (orderItems.Count > 0)
                        {
                            <span class="pill" style="font-size:11px; font-weight:700; background:#f0f9ff; color:#0369a1; border:1px solid #bae6fd;">
                                @CompletedTestsCount / @orderItems.Count @I18n.T("Tests Completed")
                            </span>
                        }
                    </div>
                }
            </div>

            <div class="results-form-body">
                <!-- Search & Scanner Bar -->
                <div style="display:flex; gap:8px; align-items:center;">
                    <div class="tickets-scanner-bar" style="margin:0; flex:1;">
                        <div class="tickets-scanner-input-wrap">
                            <span class="tickets-scanner-icon" title="Barcode Scanner">🔍</span>
                            <input type="text"
                                   class="classic-input tickets-scanner-input"
                                   placeholder="@I18n.T(IsImagingMode ? "Enter Study #, Memo #, Patient ID (PID e.g. H2610...), Phone, or Scan..." : "Enter Test #, Memo #, Patient ID (PID e.g. H2610...), Phone, or Scan...")"
                                   @bind="searchQuery"
                                   @bind:event="oninput"
                                   @onkeydown="HandleSearchKeyDown" />
                            @if (!string.IsNullOrWhiteSpace(searchQuery))
                            {
                                <button type="button" class="tickets-scanner-clear" @onclick="ClearSearch" title="Clear">✕</button>
                            }
                        </div>
                    </div>

                    <button type="button" class="btn btn-primary tickets-btn" @onclick="ExecuteSearchAsync" disabled="@searching">
                        <SearchIcon /> @(searching ? I18n.T("Searching...") : I18n.T("Search / Fetch"))
                    </button>
                </div>

                @if (patientMemosList.Count > 1)
                {
                    <!-- Patient ID Invoices Switcher Banner -->
                    <div class="results-patient-memos-bar">
                        <div style="display:flex; align-items:center; gap:6px;">
                            <span>👤</span>
                            <strong style="font-size:11.5px; color:#065f46;">
                                @I18n.T("Patient Bills"): @patientMemosList[0].PatientName (@(patientMemosList[0].PatientID ?? "Walk-in"))
                            </strong>
                        </div>
                        <div class="results-patient-memos-pills">
                            @foreach (var pm in patientMemosList)
                            {
                                <button type="button"
                                        class="results-memo-pill @(selectedMemo?.ID == pm.ID ? "active" : "")"
                                        @onclick="() => SwitchPatientMemo(pm.ID)">
                                    #@pm.ID (@pm.TransDate.ToString("dd/MM/yy")) &bull; @pm.Items.Count @I18n.T("tests")
                                </button>
                            }
                        </div>
                    </div>
                }

                @if (selectedMemo != null)
                {
                    <!-- Patient Summary Strip -->
                    <div class="results-patient-strip">
                        <div>
                            <span>@I18n.T("Patient Name")</span>
                            <strong>@selectedMemo.PatientName</strong>
                        </div>
                        <div>
                            <span>@I18n.T("Patient ID (PID) / Sex")</span>
                            <strong style="color:#0369a1;">@(selectedMemo.PatientID ?? I18n.T("Walk-in")) (@selectedMemo.Age / @selectedMemo.Sex)</strong>
                        </div>
                        <div>
                            <span>@I18n.T("Contact")</span>
                            <strong>@(selectedMemo.Contact ?? "—")</strong>
                        </div>
                        <div>
                            <span>@I18n.T("Referred by")</span>
                            <strong>@DoctorFormatted(selectedMemo.DoctorID)</strong>
                        </div>
                    </div>

                    <!-- Film Delivery Notice for Imaging Mode -->
                    @if (IsImagingMode)
                    {
                        <div class="delta-film-counter-banner" style="margin-bottom: 8px;">
                            <span style="font-size: 18px;">🎞️</span>
                            <div style="flex: 1;">
                                <strong style="color: #92400e;">@I18n.T("FILM PICKUP FROM COUNTER"):</strong>
                                <span style="color: #78350f;"> @(I18n.IsBangla ? "রোগী এক্স-রে/আল্ট্রা/সিটি/এমআরআই ফিল্ম ডায়াগনস্টিক কাউন্টার থেকে সংগ্রহ করবেন। এই পেজ থেকে চিকিৎসকের জন্য অফিসিয়াল লিখিত রেডিওলজি রিপোর্ট প্রিন্ট দেওয়া যাবে।" : "Patient collects the physical imaging film/plate from the Diagnostic Imaging Counter. The official signed written report can be printed directly from this page.")</span>
                            </div>
                            <span class="pill" style="background:#ffffff; color:#92400e; font-weight:700; border:1px solid #fde047; font-size:10px;">
                                Counter Delivery
                            </span>
                        </div>
                    }
                    else
                    {
                        <!-- Specimen Type & Collection Summary Strip for Lab Mode with Quick Chips -->
                        <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:6px; padding:6px 12px; font-size:11.5px;">
                            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
                                <div style="display:flex; align-items:center; gap:8px;">
                                    <span style="color:#64748b; font-weight:700;">🧪 @I18n.T("Specimen / Sample"):</span>
                                    <input type="text" class="classic-input" style="width:120px; height:24px; padding:2px 6px; display:inline-block; font-weight:700;" @bind="currentSampleType" placeholder="Blood" />
                                </div>
                                <div style="display:flex; align-items:center; gap:16px;">
                                    <div>
                                        <span style="color:#64748b;">🕒 @I18n.T("Coll"):</span>
                                        <b>@GetSampleCollectionTime()</b>
                                    </div>
                                    <div>
                                        <span style="color:#64748b;">📥 @I18n.T("Recv"):</span>
                                        <b>@GetSampleReceiveTime()</b>
                                    </div>
                                </div>
                            </div>
                            <!-- Specimen Quick Chips -->
                            <div class="specimen-chip-bar">
                                <span style="font-size:10.5px; color:#64748b; font-weight:600;">@I18n.T("Quick Select"):</span>
                                @foreach (var spec in QuickSpecimens)
                                {
                                    <button type="button" 
                                            class="specimen-chip @(currentSampleType.Equals(spec, StringComparison.OrdinalIgnoreCase) ? "active" : "")" 
                                            @onclick="() => SelectSpecimen(spec)">
                                        @spec
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    <!-- Test Selector Tabs with Progress & Save & Next Button -->
                    <div>
                        <div class="billing-section-heading" style="margin-bottom:4px; display:flex; justify-content:space-between; align-items:center;">
                            <span>@(IsImagingMode ? "🩻 " + I18n.T("Selected Imaging Studies") : "🔬 " + I18n.T("Selected Tests & Investigations"))</span>
                            @if (orderItems.Count > 1)
                            {
                                <span style="font-size:11px; color:#0369a1; font-weight:700;">
                                    @CompletedTestsCount / @orderItems.Count @I18n.T("Done")
                                </span>
                            }
                        </div>
                        <div class="results-test-tabs" style="display:flex; align-items:center; gap:6px; flex-wrap:wrap;">
                            @foreach (var test in orderItems)
                            {
                                var sName = ServiceName(test.TestID);
                                var hasResults = allResults.Any(x => x.ServiceID == test.TestID && !string.IsNullOrWhiteSpace(x.ResultValue));
                                var isTestVerified = allResults.Any(x => x.ServiceID == test.TestID) && allResults.Where(x => x.ServiceID == test.TestID).All(x => x.IsVerified);
                                <button type="button"
                                        class="btn tickets-btn @(activeTestId == test.TestID ? "btn-primary" : "btn-secondary")"
                                        style="font-size:11px; padding:3px 10px; border-radius:14px;"
                                        @onclick="() => SwitchActiveTest(test.TestID)">
                                    @(isTestVerified ? "✓ " : hasResults ? "📝 " : "⏳ ")@sName
                                </button>
                            }

                            @if (orderItems.Count > 1 && activeTestId > 0)
                            {
                                <button type="button"
                                        class="btn btn-secondary tickets-btn"
                                        style="font-size:11px; padding:3px 10px; border-radius:14px; margin-left:auto; background:#e0f2fe; color:#0369a1; border-color:#bae6fd;"
                                        @onclick="SaveAndNextTestAsync"
                                        title="@I18n.T("Save current test and move to next test")">
                                    💾 @I18n.T("Save & Next Test") &rarr;
                                </button>
                            }
                        </div>
                    </div>

                    @if (activeTestId > 0)
                    {
                        <!-- Quick Templates Bar for Imaging Mode -->
                        @if (IsImagingMode)
                        {
                            <div class="imaging-template-bar">
                                <span style="font-size: 11px; font-weight: 700; color: #475569;">🩻 @I18n.T("Quick Templates"):</span>
                                <button type="button" class="imaging-template-btn" @onclick='() => LoadImagingTemplate("Chest")'>
                                    + Normal Chest X-Ray
                                </button>
                                <button type="button" class="imaging-template-btn" @onclick='() => LoadImagingTemplate("Abdomen")'>
                                    + Normal USG Abdomen
                                </button>
                                <button type="button" class="imaging-template-btn" @onclick='() => LoadImagingTemplate("KUB")'>
                                    + Normal KUB Study
                                </button>
                                <button type="button" class="imaging-template-btn" @onclick='() => LoadImagingTemplate("Pelvis")'>
                                    + Normal Pelvis / TVS
                                </button>
                                <button type="button" class="imaging-template-btn" @onclick='() => LoadImagingTemplate("CTBrain")'>
                                    + Normal CT Brain Plain
                                </button>
                                <button type="button" class="imaging-template-btn" @onclick='() => LoadImagingTemplate("CSpine")'>
                                    + Normal Cervical Spine
                                </button>
                                <button type="button" class="imaging-template-btn" @onclick='() => LoadImagingTemplate("LSSpine")'>
                                    + Normal LS Spine
                                </button>
                                <button type="button" class="imaging-template-btn" @onclick='() => LoadImagingTemplate("Bone")'>
                                    + Normal Bone / Extremity
                                </button>
                                <button type="button" class="imaging-template-btn" @onclick='() => LoadImagingTemplate("ECG")'>
                                    + Normal 12-Lead ECG
                                </button>
                            </div>
                        }

                        <!-- Action Toolbar above Table for Lab Mode -->
                        @if (!IsImagingMode)
                        {
                            <div class="results-table-toolbar">
                                <div style="display:flex; align-items:center; gap:6px;">
                                    <button type="button" class="results-quick-btn success" @onclick="SetAllNormal" title="@I18n.T("Fill normal reference findings for all parameters")">
                                        ⚡ @I18n.T("Set All Normal")
                                    </button>
                                    <button type="button" class="results-quick-btn" @onclick="ClearParameterValues" title="@I18n.T("Clear entered result values")">
                                        🧹 @I18n.T("Clear Values")
                                    </button>
                                    <button type="button" class="results-quick-btn" @onclick="ResetToDefaultTemplate" title="@I18n.T("Reset to standard test parameters")">
                                        🔄 @I18n.T("Reset Template")
                                    </button>
                                </div>
                                <div style="display:flex; align-items:center; gap:6px;">
                                    <button type="button" class="results-quick-btn" @onclick="AddBlankParameter">
                                        + @I18n.T("Add Parameter")
                                    </button>
                                    <button type="button" class="results-quick-btn" @onclick="AddSectionHeader">
                                        + @I18n.T("Add Group Heading")
                                    </button>
                                </div>
                            </div>
                        }

                        <!-- Parameter / Section Table -->
                        <div>
                            <div class="billing-section-heading" style="margin-bottom:4px; display:flex; justify-content:space-between; align-items:center;">
                                <span>📋 @I18n.T(IsImagingMode ? "Radiology Report Sections" : "Investigation Details"): <strong>@ServiceName(activeTestId)</strong></span>
                                <span style="font-size:11px; color:#64748b; font-weight:normal;">
                                    (@currentTestResults.Count @I18n.T(IsImagingMode ? "sections" : "parameters"))
                                </span>
                            </div>
                            <div class="results-param-table-wrap">
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 32px; text-align:center;">#</th>
                                            <th>@I18n.T(IsImagingMode ? "Report Section Heading" : "Parameter Name")</th>
                                            <th style="width:@(IsImagingMode ? "420px" : "175px");">@I18n.T(IsImagingMode ? "Radiological Findings / Detailed Report" : "Observed Value")<span style="color:#dc2626;">*</span></th>
                                            @if (!IsImagingMode)
                                            {
                                                <th style="width:95px;">@I18n.T("Unit")</th>
                                                <th style="width:180px;">@I18n.T("Reference Range")</th>
                                                <th style="width:115px;">@I18n.T("Flag")</th>
                                            }
                                            <th style="width:65px; text-align:center;">@I18n.T("Action")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (var i = 0; i < currentTestResults.Count; i++)
                                        {
                                            var idx = i;
                                            var row = currentTestResults[idx];
                                            var isHeaderRow = string.IsNullOrWhiteSpace(row.ResultValue) && string.IsNullOrWhiteSpace(row.Unit) && !IsImagingMode;
                                            var flagClass = row.Flag switch
                                            {
                                                "High" or "Positive" => "results-row-high",
                                                "Low" => "results-row-low",
                                                "Critical" => "results-row-critical",
                                                _ => ""
                                            };
                                            <tr class="@(isHeaderRow ? "results-row-header" : flagClass)">
                                                <td style="text-align:center; color:#64748b; font-size:11px;">@(idx + 1)</td>
                                                <td>
                                                    <InputText class="classic-input" @bind-Value="row.ParameterName" style="font-weight:700; height:26px !important; padding:2px 6px !important;" placeholder="Section Heading" />
                                                </td>
                                                <td>
                                                    @if (IsImagingMode)
                                                    {
                                                        <InputTextArea class="classic-input" @bind-Value="row.ResultValue" style="min-height:85px !important; line-height:1.5; font-size:12px; padding:6px 8px !important; resize:vertical; font-family:Arial, sans-serif;" placeholder="@I18n.T("Enter detailed radiology findings, impressions or clinical observations")" />
                                                    }
                                                    else
                                                    {
                                                        <input type="text" 
                                                               class="classic-input bold-number" 
                                                               value="@row.ResultValue"
                                                               @oninput="(e) => OnResultValueInput(row, e.Value?.ToString())"
                                                               style="height:26px !important; padding:2px 6px !important;" 
                                                               placeholder="e.g. 12.7 or Negative" />
                                                    }
                                                </td>
                                                @if (!IsImagingMode)
                                                {
                                                    <td><InputText class="classic-input" @bind-Value="row.Unit" style="width:88px; height:26px !important; padding:2px 6px !important;" placeholder="g/dL" /></td>
                                                    <td><InputText class="classic-input" @bind-Value="row.ReferenceRange" style="height:26px !important; padding:2px 6px !important;" placeholder="12.0 - 16.0" /></td>
                                                    <td>
                                                        <InputSelect class="classic-input tickets-select" @bind-Value="row.Flag" style="font-size:11px; height:26px !important; padding:2px 4px !important; font-weight:700;">
                                                            <option value="Normal">✓ Normal</option>
                                                            <option value="High" style="color:#b91c1c; font-weight:bold;">▲ High</option>
                                                            <option value="Low" style="color:#b45309; font-weight:bold;">▼ Low</option>
                                                            <option value="Positive" style="color:#b91c1c; font-weight:bold;">+ Positive</option>
                                                            <option value="Negative">− Negative</option>
                                                            <option value="Critical" style="color:#dc2626; font-weight:bold;">⚠ Critical</option>
                                                        </InputSelect>
                                                    </td>
                                                }
                                                <td style="text-align:center;">
                                                    <div style="display:inline-flex; align-items:center; gap:2px;">
                                                        <button type="button" class="tickets-icon-action" @onclick="() => MoveParameterUp(idx)" disabled="@(idx == 0)" title="@I18n.T("Move Up")">▲</button>
                                                        <button type="button" class="tickets-icon-action" @onclick="() => MoveParameterDown(idx)" disabled="@(idx == currentTestResults.Count - 1)" title="@I18n.T("Move Down")">▼</button>
                                                        <button type="button" class="tickets-icon-action danger" @onclick="() => RemoveParameter(idx)" title="@I18n.T("Delete")">✕</button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Analyzer / Method Note (Lab Mode) -->
                        @if (!IsImagingMode)
                        {
                            <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:6px; padding:6px 10px; margin-top:6px; display:flex; align-items:center; gap:8px;">
                                <span style="font-size:11px; font-weight:700; color:#475569; white-space:nowrap;">🔬 @I18n.T("Analyzer / Method Note"):</span>
                                <input type="text" class="classic-input" @bind="analyzerMethodNote" style="height:26px !important; font-size:11px;" placeholder="Estimations were carried out by automated analyzer..." />
                            </div>
                        }

                        <!-- Verification & Consultant Selection Bar -->
                        <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:6px; padding:8px 12px; margin-top:6px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
                            <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
                                <label style="display:flex; align-items:center; gap:6px; margin:0; font-size:11.5px; font-weight:700; color:#334155;">
                                    <span>@(IsImagingMode ? "🩻 " + I18n.T("Consultant Radiologist") : "🔬 " + I18n.T("Consultant Pathologist")):</span>
                                    <InputSelect class="classic-input tickets-select" style="min-width:180px; height:28px !important;" @bind-Value="selectedDoctorId">
                                        <option value="0">@I18n.T("Select Doctor")</option>
                                        @foreach (var d in doctors)
                                        {
                                            <option value="@d.ID">@d.Title @d.Name @(string.IsNullOrWhiteSpace(d.Degree) ? "" : $"({d.Degree})")</option>
                                        }
                                    </InputSelect>
                                </label>

                                @if (canVerify)
                                {
                                    <label style="display:flex; align-items:center; gap:6px; margin:0; font-size:11.5px; font-weight:750; color:#047857; cursor:pointer;">
                                        <InputCheckbox @bind-Value="isVerified" />
                                        <span>@I18n.T("Mark Verified & Signed")</span>
                                    </label>
                                }
                            </div>

                            <div style="display:flex; align-items:center; gap:6px;">
                                @if (isVerified)
                                {
                                    <span class="results-verified-seal">
                                        ✓ @I18n.T("Verified & Finalized")
                                    </span>
                                    @if (isAdministrator)
                                    {
                                        <button type="button" class="btn btn-secondary tickets-btn" style="font-size:10.5px; padding:2px 8px;" @onclick="UnlockReportAsync" title="@I18n.T("Unlock report for corrections")">
                                            🔓 @I18n.T("Unlock")
                                        </button>
                                    }
                                }
                                @if (canVerify && orderItems.Count > 1)
                                {
                                    <button type="button" class="btn btn-secondary tickets-btn" style="font-size:10.5px; padding:3px 8px; color:#047857; border-color:#a7f3d0;" @onclick="VerifyAllTestsAsync" title="@I18n.T("Verify all completed tests on this invoice at once")">
                                        ✓ @I18n.T("Verify All Tests on Bill")
                                    </button>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="tickets-queue-empty" style="padding: 3rem 1rem;">
                        <span style="font-size: 2.5rem;">@(IsImagingMode ? "🩻" : "🧪")</span>
                        <strong style="font-size: 13.5px; color:#1e293b;">@I18n.T(IsImagingMode ? "Search Study #, Memo #, or Patient ID to Enter Imaging Report" : "Search Test #, Memo #, or Patient ID to Enter Lab Results")</strong>
                        <span style="font-size: 11.5px; color:#64748b;">
                            @I18n.T(IsImagingMode ? "Patient collects film from counter; enter findings & print official written radiology report here." : "Scan barcode from specimen tube, or enter Patient ID (PID) to fetch patient tests and print reports.")
                        </span>
                        <div style="margin-top: 12px; display:flex; gap:8px;">
                            @if (recentOrderDtos.Count > 0)
                            {
                                <button type="button" class="btn btn-secondary tickets-btn" @onclick="() => SelectOrder(recentOrderDtos[0].ID)">
                                    👉 @I18n.T("Load Latest Order") (#@recentOrderDtos[0].ID &bull; @recentOrderDtos[0].PatientName)
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Footer Actions -->
            <div class="results-form-footer" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
                @if (selectedMemo != null && activeTestId > 0)
                {
                    <div style="display:flex; align-items:center; gap:6px;">
                        <button class="btn btn-primary tickets-btn" type="button" @onclick="SaveResultsAsync">
                            💾 @I18n.T(IsImagingMode ? "Save Written Imaging Report" : "Save Test Results")
                        </button>
                        @if (orderItems.Count > 1)
                        {
                            <button class="btn btn-secondary tickets-btn" type="button" @onclick="SaveAndNextTestAsync" title="@I18n.T("Save and move to next test")">
                                💾 ⏭ @I18n.T("Save & Next")
                            </button>
                        }
                    </div>

                    <div style="display:flex; align-items:center; gap:6px;">
                        <button class="btn btn-secondary tickets-btn" type="button" @onclick="ToggleReportPreview" title="@I18n.T("Show / Hide on-screen print preview")">
                            👁️ @(showReportPreview ? I18n.T("Hide Preview") : I18n.T("Preview Report"))
                        </button>
                        <button class="btn btn-secondary tickets-btn" type="button" @onclick="PrintAsync" title="@I18n.T("Print official report")">
                            🖨 @I18n.T("Print")
                        </button>
                        <button class="btn btn-secondary tickets-btn" type="button" @onclick="DownloadPdfAsync" title="@I18n.T("Download official report as PDF")">
                            📄 PDF
                        </button>
                        <button class="btn btn-secondary tickets-btn" type="button" @onclick="CopySummaryAsync" title="@I18n.T("Copy text summary for WhatsApp / SMS")">
                            📋 @I18n.T("Copy")
                        </button>
                        <button class="btn btn-ghost tickets-btn" type="button" @onclick="Reset">
                            @I18n.T("Clear")
                        </button>
                    </div>
                }
                else
                {
                    <div></div>
                    <button class="btn btn-ghost tickets-btn" type="button" @onclick="Reset">
                        @I18n.T("Clear")
                    </button>
                }
            </div>
        </div>

        <!-- Right Panel: Recent Lab / Imaging Orders Queue Card with Search & Filters -->
        <div class="results-queue-card">
            <div class="results-queue-top">
                <div style="display:flex; align-items:center; gap:8px;">
                    <h2>@I18n.T(IsImagingMode ? "Recent Imaging Orders" : "Recent Lab Orders")</h2>
                    <span style="font-size:11px; color:#64748b; font-weight:600;">
                        (@DateTime.Today.ToString("dd MMM"))
                    </span>
                </div>
                <span class="pill" style="font-size:11px; font-weight:700;">
                    @filteredQueueOrders.Count @I18n.T("Orders")
                </span>
            </div>

            <!-- Queue Search & Filter Tabs -->
            <div class="results-queue-filter-wrap">
                <div class="tickets-search-wrap" style="width:100%;">
                    <input class="classic-input"
                           style="width:100%; height:26px; font-size:11px;"
                           placeholder="@I18n.T("Search queue by patient, memo, PID, test...")"
                           @bind="queueSearchQuery"
                           @bind:event="oninput"
                           @bind:after="FilterQueueOrders" />
                    <span class="tickets-search-icon" style="font-size:11px;">🔍</span>
                    @if (!string.IsNullOrWhiteSpace(queueSearchQuery))
                    {
                        <button type="button" class="tickets-search-clear" @onclick="ClearQueueSearch" style="font-size:11px;">✕</button>
                    }
                </div>
                <div class="results-queue-tabs">
                    <button type="button" class="results-queue-tab @(queueStatusFilter == "all" ? "active" : "")" @onclick='() => SetQueueFilter("all")'>
                        @I18n.T("All") (@recentOrderDtos.Count)
                    </button>
                    <button type="button" class="results-queue-tab @(queueStatusFilter == "Pending" ? "active" : "")" @onclick='() => SetQueueFilter("Pending")'>
                        ⏳ @I18n.T("Pending") (@recentOrderDtos.Count(x => x.OverallStatus == "Pending"))
                    </button>
                    <button type="button" class="results-queue-tab @(queueStatusFilter == "InProcess" ? "active" : "")" @onclick='() => SetQueueFilter("InProcess")'>
                        📝 @I18n.T("Draft") (@recentOrderDtos.Count(x => x.OverallStatus == "InProcess"))
                    </button>
                    <button type="button" class="results-queue-tab @(queueStatusFilter == "Verified" ? "active" : "")" @onclick='() => SetQueueFilter("Verified")'>
                        ✓ @I18n.T("Ready") (@recentOrderDtos.Count(x => x.OverallStatus == "Verified"))
                    </button>
                </div>
            </div>

            <div class="billing-queue-list">
                @if (filteredQueueOrders.Count == 0)
                {
                    <div class="tickets-queue-empty">
                        <span style="font-size: 2rem;">@(IsImagingMode ? "🩻" : "🧪")</span>
                        <span>@I18n.T(IsImagingMode ? "No imaging orders match the filter." : "No lab orders match the filter.")</span>
                    </div>
                }
                @foreach (var o in filteredQueueOrders)
                {
                    var isSelected = selectedMemo?.ID == o.ID;
                    <div class="billing-queue-item @(isSelected ? "active" : "")" @onclick="() => SelectOrder(o.ID)">
                        <span class="billing-queue-serial">#@o.ID</span>
                        <div class="billing-queue-info">
                            <div style="display:flex; justify-content:space-between; align-items:center;">
                                <span class="billing-queue-name">
                                    @o.PatientName
                                    @if (!string.IsNullOrWhiteSpace(o.PatientID))
                                    {
                                        <small class="tickets-queue-reg">(@o.PatientID)</small>
                                    }
                                </span>
                                @if (o.OverallStatus == "Verified")
                                {
                                    <span class="pill pill-success" style="font-size:9.5px; padding:1px 6px;">✓ @I18n.T("Verified")</span>
                                }
                                else if (o.OverallStatus == "InProcess")
                                {
                                    <span class="pill" style="font-size:9.5px; padding:1px 6px; background:#e0f2fe; color:#0369a1; border:1px solid #bae6fd;">📝 @I18n.T("Draft")</span>
                                }
                                else
                                {
                                    <span class="pill" style="font-size:9.5px; padding:1px 6px; background:#fffbeb; color:#92400e; border:1px solid #fde68a;">⏳ @I18n.T("Pending")</span>
                                }
                            </div>
                            <span class="billing-queue-meta">
                                @o.TransDate.ToString("dd MMM · hh:mm tt") &bull; @o.Age / @o.Sex
                            </span>
                            @if (o.TestNames.Count > 0)
                            {
                                <div style="display:flex; flex-wrap:wrap; margin-top:2px;">
                                    @foreach (var tName in o.TestNames.Take(3))
                                    {
                                        <span class="results-queue-chip" title="@tName">@tName</span>
                                    }
                                    @if (o.TestNames.Count > 3)
                                    {
                                        <span class="results-queue-chip" style="background:#e2e8f0;">+@(o.TestNames.Count - 3)</span>
                                    }
                                </div>
                            }
                        </div>
                        <div class="tickets-queue-actions" @onclick:stopPropagation="true">
                            <button type="button" class="btn btn-secondary tickets-btn" style="font-size:10.5px; padding:2px 8px;" @onclick="() => SelectOrder(o.ID)">
                                @I18n.T("View") &rarr;
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (selectedMemo != null && showReportPreview)
{
    <!-- Print & Preview Mode Switcher Toolbar -->
    <div class="results-print-toolbar no-print" style="max-width:840px; margin:20px auto 10px auto;">
        <div class="results-print-mode-group">
            <span style="font-weight:700; font-size:12px; color:#334155;">🖨️ @I18n.T("Print Scope"):</span>
            <button type="button" class="btn btn-sm @(printMode == "active" ? "btn-primary active" : "btn-secondary")" @onclick='() => printMode = "active"' title="@I18n.T("Print only currently selected test/study")">
                @(IsImagingMode ? "🩻 " : "🔬 ")@I18n.T("Active Test") (@ServiceName(activeTestId))
            </button>
            <button type="button" class="btn btn-sm @(printMode == "all" ? "btn-primary active" : "btn-secondary")" @onclick='() => printMode = "all"' title="@I18n.T("Print all studies/tests for this patient / memo")">
                📑 @I18n.T("All Tests Combined") (@orderItems.Count @I18n.T("items"))
            </button>
        </div>

        <!-- Pre-printed Stationery / Letterhead Mode Toggle -->
        <div style="display:flex; align-items:center; gap:8px;">
            <label style="display:flex; align-items:center; gap:5px; margin:0; font-size:11.5px; font-weight:700; color:#334155; cursor:pointer;" title="@I18n.T("Check this to print on hospital pre-printed pad paper without hospital header")">
                <input type="checkbox" @bind="usePreprintedPad" />
                <span>📄 @I18n.T("Pre-printed Pad Mode (Blank Header)")</span>
            </label>
            <button type="button" class="btn btn-primary" @onclick="PrintAsync" title="@I18n.T("Print to printer or PDF preview")">
                🖨️ @I18n.T("Print Report")
            </button>
            <button type="button" class="btn btn-secondary" @onclick="DownloadPdfAsync" title="@I18n.T("Download report directly as a PDF file")">
                📄 @I18n.T("Download PDF")
            </button>
        </div>
    </div>

    <!-- Delta Hospital Official Clinical Laboratory & Written Radiology Report Sheet -->
    <div id="lab-report-print" class="print-sheet print-document">
        <div class="delta-report-sheet @(usePreprintedPad ? "delta-pad-mode" : "")">
            @if (!usePreprintedPad)
            {
                <!-- Top Hospital Letterhead / Banner -->
                <div class="delta-report-header">
                    <div class="delta-hosp-banner">
                        @if (!string.IsNullOrWhiteSpace(Branding.LogoData))
                        {
                            <img src="@Branding.LogoData" alt="Logo" class="delta-hosp-logo" />
                        }
                        else
                        {
                            <div class="delta-logo-placeholder">🏥</div>
                        }
                        <div class="delta-hosp-info">
                            <h1 class="delta-hosp-name">@Branding.HospitalName</h1>
                            <p class="delta-hosp-tagline">@(string.IsNullOrWhiteSpace(Branding.Tagline) ? "Delta Hospital Limited, Dhaka" : Branding.Tagline)</p>
                            <p class="delta-hosp-addr">📍 @Branding.Address@(string.IsNullOrWhiteSpace(Branding.CityDistrict) ? "" : $", {Branding.CityDistrict}") &bull; 📞 Hotline: @(string.IsNullOrWhiteSpace(Branding.Hotline) ? Branding.Phone : Branding.Hotline)</p>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- Pad Spacing Reservation for Pre-printed Stationery -->
                <div class="delta-pad-spacer"></div>
            }

            <!-- Barcodes & Department Title Row -->
            <div class="delta-barcodes-strip">
                <div class="delta-barcode-left" title="Invoice Barcode: *D@selectedMemo.ID*">
                    @((MarkupString)BarcodeQr.GenerateBarcodeSvg($"D{selectedMemo.ID}", 22, true))
                </div>
                <div class="delta-report-title-wrap">
                    <h2 class="delta-report-title">@GetReportCategoryTitle()</h2>
                </div>
                <div class="delta-barcode-right" title="Report Barcode: *@selectedMemo.ID*">
                    @((MarkupString)BarcodeQr.GenerateBarcodeSvg($"{selectedMemo.ID}", 22, true))
                </div>
            </div>

            <!-- Delta Patient Demographics Box -->
            <div class="delta-patient-box">
                <div class="delta-patient-grid-4">
                    <div class="delta-cell">
                        <span class="delta-lbl">Invoice No</span>
                        <span class="delta-sep">:</span>
                        <strong class="delta-val">D@(selectedMemo.ID)</strong>
                    </div>
                    <div class="delta-cell">
                        <span class="delta-lbl">Invoice Date</span>
                        <span class="delta-sep">:</span>
                        <strong class="delta-val">@selectedMemo.TransDate.ToString("dd/MM/yy hh:mm:ss tt")</strong>
                    </div>
                    <div class="delta-cell">
                        <span class="delta-lbl">Delivery Date</span>
                        <span class="delta-sep">:</span>
                        <strong class="delta-val">@GetExpectedDeliveryDate()</strong>
                    </div>
                    <div class="delta-cell">
                        <span class="delta-lbl">Report No</span>
                        <span class="delta-sep">:</span>
                        <strong class="delta-val">@selectedMemo.ID</strong>
                    </div>
                </div>

                <div class="delta-patient-grid-3" style="margin-top: 4px;">
                    <div class="delta-cell span-2">
                        <span class="delta-lbl">Patient Name</span>
                        <span class="delta-sep">:</span>
                        <strong class="delta-val delta-pt-name">@selectedMemo.PatientName.ToUpperInvariant()</strong>
                    </div>
                    <div class="delta-cell">
                        <span class="delta-lbl">Age / Gender</span>
                        <span class="delta-sep">:</span>
                        <strong class="delta-val">@selectedMemo.Age / @selectedMemo.Sex</strong>
                    </div>
                </div>

                <div class="delta-patient-grid-1" style="margin-top: 4px;">
                    <div class="delta-cell">
                        <span class="delta-lbl">Referred By</span>
                        <span class="delta-sep">:</span>
                        <strong class="delta-val">@DoctorFormatted(selectedMemo.DoctorID)</strong>
                    </div>
                </div>

                <div class="delta-patient-grid-2" style="margin-top: 4px;">
                    <div class="delta-cell">
                        <span class="delta-lbl">@(IsImagingMode ? "Modality" : "Sample")</span>
                        <span class="delta-sep">:</span>
                        <strong class="delta-val">@(IsImagingMode ? GetImagingModality(ServiceName(activeTestId)) : (string.IsNullOrWhiteSpace(currentSampleType) ? "BLOOD" : currentSampleType.ToUpperInvariant()))</strong>
                    </div>
                    <div class="delta-cell">
                        <span class="delta-lbl">@(IsImagingMode ? "Examination" : "Tests")</span>
                        <span class="delta-sep">:</span>
                        <strong class="delta-val">@GetReportTestsTitle()</strong>
                    </div>
                </div>

                <div class="delta-patient-grid-3" style="margin-top: 4px;">
                    <div class="delta-cell">
                        <span class="delta-lbl">@(IsImagingMode ? "Accession #" : "Lab No")</span>
                        <span class="delta-sep">:</span>
                        <strong class="delta-val">#D@(selectedMemo.ID)</strong>
                    </div>
                    <div class="delta-cell">
                        <span class="delta-lbl">@(IsImagingMode ? "Study Time" : "Coll Time")</span>
                        <span class="delta-sep">:</span>
                        <span class="delta-val">@GetSampleCollectionTime()</span>
                    </div>
                    <div class="delta-cell">
                        <span class="delta-lbl">@(IsImagingMode ? "Film Status" : "Lab Receive Time")</span>
                        <span class="delta-sep">:</span>
                        <span class="delta-val">@(IsImagingMode ? "Counter Delivery" : GetSampleReceiveTime())</span>
                    </div>
                </div>

                @if (IsImagingMode)
                {
                    <div class="delta-analyzer-note" style="color: #854d0e; font-style: normal; font-weight: 600;">
                        🎞️ <b>FILM COUNTER NOTICE:</b> Original imaging film/plate is to be collected from the Diagnostic Imaging Delivery Counter. This document constitutes the certified written radiology report.
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(analyzerMethodNote))
                {
                    <div class="delta-analyzer-note">
                        @analyzerMethodNote
                    </div>
                }
            </div>

            <!-- Vertical Left HN Barcode Watermark/Indicator -->
            <div class="delta-hn-indicator">
                <span>HN: <b>@(selectedMemo.PatientID ?? $"P-{selectedMemo.ID}")</b></span>
                <span>&bull;</span>
                <span>Report Status: <b>@(ReportVerified ? "Finalized" : "Draft / In Process")</b></span>
            </div>

            @if (IsImagingMode)
            {
                <!-- Official Written Radiology / Imaging Report Layout -->
                <div class="delta-imaging-report-body">
                    <div class="delta-imaging-study-header">
                        <span class="delta-imaging-lbl">EXAMINATION / STUDY:</span>
                        <strong class="delta-imaging-study-name">@ServiceName(activeTestId).ToUpperInvariant()</strong>
                    </div>

                    <div class="delta-film-counter-banner">
                        <span style="font-size: 16px;">🎞️</span>
                        <div>
                            <strong>@I18n.T("FILM PICKUP NOTICE"):</strong>
                            <span>@(I18n.IsBangla ? "মূল এক্স-রে/সিটি/এমআরআই ফিল্ম ডেলিভারি কাউন্টার থেকে সংগ্রহ করুন। এটি চিকিৎসকের মূল লিখিত ডায়াগনস্টিক রিপোর্ট।" : "Physical imaging film/plate is to be collected from the Diagnostic Imaging Counter. Below is the official written diagnostic radiology report.")</span>
                        </div>
                    </div>

                    @foreach (var res in currentTestResults.Where(x => !string.IsNullOrWhiteSpace(x.ResultValue) || !string.IsNullOrWhiteSpace(x.ParameterName)))
                    {
                        <div class="delta-imaging-section">
                            <div class="delta-imaging-section-title">@res.ParameterName.ToUpperInvariant():</div>
                            <div class="delta-imaging-section-content">
                                @res.ResultValue
                            </div>
                        </div>
                    }

                    <div class="delta-imaging-counter-footer-notice">
                        <b>@I18n.T("Important Note"):</b> @(I18n.IsBangla ? "রোগীর মূল ফিল্ম ডায়াগনস্টিক কাউন্টারে হস্তান্তরের জন্য প্রস্তুত থাকে। এই লিখিত রিপোর্টে রেডিওলজিস্টের চূড়ান্ত অভিমত রয়েছে, যা রোগীর ব্যবস্থাপত্রে সংযুক্ত করার জন্য প্রযোজ্য।" : "Original films/plates are available for patient collection at the Diagnostic Imaging Counter upon showing this invoice. This written diagnostic report contains the certified clinical radiological interpretation.")
                    </div>
                </div>
            }
            else
            {
                <!-- Pathology / Clinical Laboratory Test Table (Delta Hospital standard) -->
                <table class="delta-results-table">
                    <thead>
                        <tr>
                            <th style="width: 36%;">Test</th>
                            <th class="text-center" style="width: 18%;">Result</th>
                            <th class="text-center" style="width: 14%;">Unit</th>
                            <th style="width: 32%;">Reference Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var testId in GetTestsToDisplay())
                        {
                            var testResults = allResults.Where(r => r.ServiceID == testId).ToList();
                            @if (printMode == "all" && GetTestsToDisplay().Count > 1)
                            {
                                <tr class="delta-test-separator-row">
                                    <td colspan="4">
                                        🔬 <b>@ServiceName(testId).ToUpperInvariant()</b>
                                    </td>
                                </tr>
                            }
                            @if (testResults.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" style="text-align:center; color:#94a3b8; font-style:italic;">
                                        @I18n.T("No results recorded yet for") @ServiceName(testId)
                                    </td>
                                </tr>
                            }
                            @foreach (var res in testResults)
                            {
                                var isGroupHeader = string.IsNullOrWhiteSpace(res.ResultValue) && string.IsNullOrWhiteSpace(res.Unit);
                                if (isGroupHeader)
                                {
                                    <tr class="delta-group-heading">
                                        <td colspan="4"><b>@res.ParameterName.Trim()</b></td>
                                    </tr>
                                }
                                else
                                {
                                    var flag = (res.Flag ?? "Normal").ToLowerInvariant();
                                    var isAbnormal = flag == "high" || flag == "low" || flag == "positive" || flag == "critical";
                                    <tr>
                                        <td class="delta-param-name @(res.ParameterName.StartsWith("  ") ? "delta-sub-param" : "")">
                                            @res.ParameterName.Trim()
                                        </td>
                                        <td class="text-center delta-val-cell @(flag == "high" ? "delta-val-high" : flag == "low" ? "delta-val-low" : "")">
                                            <b>@res.ResultValue</b>
                                            @if (isAbnormal)
                                            {
                                                <span class="delta-abnormal-marker" title="@res.Flag">▲</span>
                                            }
                                        </td>
                                        <td class="text-center delta-unit-cell">@(res.Unit ?? "—")</td>
                                        <td class="delta-ref-cell">
                                            @if (!string.IsNullOrWhiteSpace(res.ReferenceRange))
                                            {
                                                <div style="white-space: pre-line;">@res.ReferenceRange</div>
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }
                                        </td>
                                    </tr>
                                    @if (!string.IsNullOrWhiteSpace(res.Interpretation))
                                    {
                                        <tr class="delta-interpretation-row">
                                            <td colspan="4">
                                                <small><em>Note: @res.Interpretation</em></small>
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                        }
                    </tbody>
                </table>
            }

            <!-- Signatures Row -->
            <div class="delta-signatures-row">
                <div class="delta-sign-col">
                    <div class="delta-sign-line"></div>
                    <div class="delta-sign-name">@GetTechnicianName()</div>
                    <div class="delta-sign-sub">@(IsImagingMode ? "Medical Radiographer / Imaging Technologist" : "Senior Medical Technologist / Lab Technician")</div>
                    <div class="delta-sign-sub">@Branding.HospitalName</div>
                </div>
                <div class="delta-sign-col" style="text-align: right;">
                    <div class="delta-sign-line" style="margin-left: auto;"></div>
                    <div class="delta-sign-name">@GetConsultantDoctorTitleAndName()</div>
                    <div class="delta-sign-sub">@GetConsultantDoctorDegree()</div>
                    <div class="delta-sign-sub">@(IsImagingMode ? "Consultant Radiologist & Imaging Specialist" : "Consultant, Laboratory Medicine")</div>
                    <div class="delta-sign-sub">BM&DC Reg. No: @GetConsultantDoctorBmdc()</div>
                    <div class="delta-sign-sub">@Branding.HospitalName</div>
                </div>
            </div>

            <!-- Footer Strip -->
            <div class="delta-report-footer">
                <div>
                    Print by &amp; Date: <b>@currentUserDisplayName</b> on @DateTime.Now.ToString("dd/MM/yyyy hh:mm:ss tt")
                </div>
                <div>
                    Page 1 of 1
                </div>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery] public long? memoId { get; set; }
    [SupplyParameterFromQuery] public string? patientId { get; set; }

    private string searchQuery = "";
    private bool searching;
    private long? searchMemoId;
