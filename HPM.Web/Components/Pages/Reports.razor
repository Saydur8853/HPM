@page "/reports"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.Reception + "," + RoleNames.Cashier + "," + RoleNames.Doctor)]
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject NavigationManager Navigation
@implements IDisposable
@using HPM.Web.Data
@using Microsoft.EntityFrameworkCore

<PageTitle>@I18n.T("Reports & Analytics Hub") | @Branding.HospitalName</PageTitle>

<style>
.rep-hub-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 16px 20px 48px;
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    color: #1e293b;
}

.rep-hub-header {
    margin-bottom: 20px;
}
.rep-hub-title {
    font-size: 22px;
    font-weight: 850;
    color: #0f172a;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
}
.rep-hub-sub {
    font-size: 12.5px;
    color: #64748b;
    margin: 4px 0 0;
}

/* Quick Hub Cards Grid */
.rep-portals-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 24px;
}
@@media (max-width: 960px) {
    .rep-portals-grid {
        grid-template-columns: 1fr;
    }
}

.rep-portal-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 2px 8px rgba(15,23,42,0.06);
    transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s;
}
.rep-portal-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(15,23,42,0.1);
    border-color: #0284c7;
    text-decoration: none;
}

.portal-top {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 12px;
}
.portal-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    flex-shrink: 0;
}
.portal-info h2 {
    font-size: 16px;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 4px;
}
.portal-info p {
    font-size: 11.5px;
    color: #64748b;
    line-height: 1.4;
    margin: 0;
}
.portal-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 12px;
    border-top: 1px solid #f1f5f9;
    font-size: 12px;
    font-weight: 800;
    color: #0284c7;
}

/* Today's Pulse Strip */
.rep-pulse-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(15,23,42,0.06);
}
.rep-pulse-header {
    padding: 12px 18px;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.rep-pulse-title {
    font-size: 13.5px;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
}

.pulse-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: #e2e8f0;
}
@@media (max-width: 800px) {
    .pulse-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}
.pulse-cell {
    background: #ffffff;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
}
.pulse-cell-label {
    font-size: 11px;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
}
.pulse-cell-val {
    font-size: 22px;
    font-weight: 900;
    color: #0f172a;
}
.pulse-cell-sub {
    font-size: 11px;
    color: #94a3b8;
}
</style>

<div class="rep-hub-container">
    <div class="rep-hub-header">
        <h1 class="rep-hub-title">@I18n.T("Reports", "রিপোর্ট")</h1>
    </div>

    <div class="rep-portals-grid">
        <a href="/reports/financial" class="rep-portal-card" style="border-top: 4px solid #0284c7;">
            <div class="portal-info">
                <h2>@I18n.T("Financial Reports", "আর্থিক রিপোর্ট")</h2>
                <p>@I18n.T("Revenue, discount, collection and due by department", "বিভাগভিত্তিক আয়, ছাড়, আদায় ও বকেয়া")</p>
            </div>
        </a>

        <a href="/reports/mis" class="rep-portal-card" style="border-top: 4px solid #10b981;">
            <div class="portal-info">
                <h2>@I18n.T("MIS Reports", "এমআইএস রিপোর্ট")</h2>
                <p>@I18n.T("Patient volume, bed occupancy and clinical statistics", "রোগী, বেড অকুপেন্সি ও ক্লিনিক্যাল পরিসংখ্যান")</p>
            </div>
        </a>

        <a href="/accounts" class="rep-portal-card" style="border-top: 4px solid #8b5cf6;">
            <div class="portal-info">
                <h2>@I18n.T("Accounts & Ledger", "অ্যাকাউন্টস ও লেজার")</h2>
                <p>@I18n.T("Vouchers, ledger and day closing", "ভাউচার, লেজার ও ডে-ক্লোজিং")</p>
            </div>
        </a>
    </div>

    <div class="rep-pulse-card">
        <div class="rep-pulse-header">
            <h3 class="rep-pulse-title">@I18n.T("Today", "আজ") &middot; @DateTime.Today.ToString("dd MMM yyyy")</h3>
        </div>

        <div class="pulse-grid">
            <div class="pulse-cell">
                <span class="pulse-cell-label">@I18n.T("Collection", "আদায়")</span>
                <span class="pulse-cell-val" style="color: #047857;">৳ @todayTotalCollection.ToString("N0")</span>
            </div>

            <div class="pulse-cell">
                <span class="pulse-cell-label">@I18n.T("OPD Patients", "ওপিডি রোগী")</span>
                <span class="pulse-cell-val" style="color: #0284c7;">@todayOpdCount</span>
            </div>

            <div class="pulse-cell">
                <span class="pulse-cell-label">@I18n.T("Admitted", "ভর্তি রোগী")</span>
                <span class="pulse-cell-val" style="color: #6d28d9;">@activeInpatientsCount</span>
            </div>

            <div class="pulse-cell">
                <span class="pulse-cell-label">@I18n.T("Bed Occupancy", "বেড অকুপেন্সি")</span>
                <span class="pulse-cell-val" style="color: #b45309;">@occupancyRate.ToString("F1")%</span>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "type")]
    public string? ReportType { get; set; }

    private decimal todayTotalCollection;
    private int todayMemosCount;
    private int todayOpdCount;
    private int todayApptsCount;
    private int activeInpatientsCount;
    private int todayAdmissionsCount;
    private int totalBeds;
    private int occupiedBeds;
    private double occupancyRate;

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        CheckRedirect();
        if (string.IsNullOrWhiteSpace(ReportType))
        {
            try
            {
                await LoadPulseAsync();
            }
            catch (Exception)
            {
                // The pulse strip is informational; show zeros rather than breaking the page.
            }
        }
    }

    protected override void OnParametersSet()
    {
        CheckRedirect();
    }

    private void CheckRedirect()
    {
        if (string.Equals(ReportType, "financial", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/reports/financial", replace: true);
        }
        else if (string.Equals(ReportType, "mis", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/reports/mis", replace: true);
        }
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadPulseAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var today = DateTime.Today;
        var tomorrow = today.AddDays(1);

        // 1. Collections today
        var opdToday = await db.OPDTickets.AsNoTracking().Where(x => x.TransDate >= today && x.TransDate < tomorrow).ToListAsync();
        var emgToday = await db.EmergencyMemos.AsNoTracking().Where(x => x.TransDate >= today && x.TransDate < tomorrow).ToListAsync();
        var otToday = await db.OTCashMemos.AsNoTracking().Where(x => x.TransDate >= today && x.TransDate < tomorrow).ToListAsync();
        var ipdRcptToday = await db.IpdMoneyReceipts.AsNoTracking().Where(x => x.TransDate >= today && x.TransDate < tomorrow).ToListAsync();
        var pharmToday = await db.PharmacyCashMemos.AsNoTracking().Where(x => x.TransDate >= today && x.TransDate < tomorrow).ToListAsync();

        todayTotalCollection = opdToday.Sum(x => x.Total)
            + emgToday.Sum(x => x.Paid)
            + otToday.Sum(x => x.Total - x.Discount)
            + ipdRcptToday.Sum(x => x.Amount)
            + pharmToday.Sum(x => (x.Total ?? 0) - (x.Discount ?? 0));

        todayMemosCount = opdToday.Count + emgToday.Count + otToday.Count + ipdRcptToday.Count + pharmToday.Count;

        // 2. OPD & Appts
        todayOpdCount = opdToday.Count;
        todayApptsCount = await db.DoctorAppointments.AsNoTracking().CountAsync(x => x.ApptDate >= today && x.ApptDate < tomorrow);

        // 3. IPD & Beds
        activeInpatientsCount = await db.PatientAdmissions.AsNoTracking().CountAsync(x => x.ReleaseDate == null);
        todayAdmissionsCount = await db.PatientAdmissions.AsNoTracking().CountAsync(x => x.AdmissionDate >= today && x.AdmissionDate < tomorrow);

        var beds = await db.BedCabins.AsNoTracking().ToListAsync();
        totalBeds = beds.Count;
        occupiedBeds = beds.Count(x => x.Status == "Occupied");
        occupancyRate = totalBeds > 0 ? (occupiedBeds * 100.0 / totalBeds) : 0;
    }

    public void Dispose()
    {
        I18n.OnLanguageChanged -= HandleLanguageChanged;
    }
}
