@page "/reports"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.Reception + "," + RoleNames.Cashier + "," + RoleNames.Doctor)]
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject NavigationManager Navigation
@implements IDisposable
@using HPM.Web.Data
@using Microsoft.EntityFrameworkCore

<PageTitle>@I18n.T("Reports & Analytics Hub") | @Branding.HospitalName</PageTitle>

<style>
.rep-hub-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 16px 20px 48px;
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    color: #1e293b;
}

.rep-hub-header {
    margin-bottom: 20px;
}
.rep-hub-title {
    font-size: 22px;
    font-weight: 850;
    color: #0f172a;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
}
.rep-hub-sub {
    font-size: 12.5px;
    color: #64748b;
    margin: 4px 0 0;
}

/* Quick Hub Cards Grid */
.rep-portals-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 24px;
}
@@media (max-width: 960px) {
    .rep-portals-grid {
        grid-template-columns: 1fr;
    }
}

.rep-portal-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 2px 8px rgba(15,23,42,0.06);
    transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s;
}
.rep-portal-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(15,23,42,0.1);
    border-color: #0284c7;
    text-decoration: none;
}

.portal-top {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 12px;
}
.portal-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    flex-shrink: 0;
}
.portal-info h2 {
    font-size: 16px;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 4px;
}
.portal-info p {
    font-size: 11.5px;
    color: #64748b;
    line-height: 1.4;
    margin: 0;
}
.portal-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 12px;
    border-top: 1px solid #f1f5f9;
    font-size: 12px;
    font-weight: 800;
    color: #0284c7;
}

/* Today's Pulse Strip */
.rep-pulse-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(15,23,42,0.06);
}
.rep-pulse-header {
    padding: 12px 18px;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.rep-pulse-title {
    font-size: 13.5px;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
}

.pulse-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: #e2e8f0;
}
@@media (max-width: 800px) {
    .pulse-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}
.pulse-cell {
    background: #ffffff;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
}
.pulse-cell-label {
    font-size: 11px;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
}
.pulse-cell-val {
    font-size: 22px;
    font-weight: 900;
    color: #0f172a;
}
.pulse-cell-sub {
    font-size: 11px;
    color: #94a3b8;
}
</style>

<div class="rep-hub-container">
    <div class="rep-hub-header">
        <h1 class="rep-hub-title">
            <span>📊</span>
            <span>@I18n.T("Hospital Reports & Analytics Portal", "হাসপাতাল রিপোর্ট ও অ্যানালিটিক্স হাব")</span>
        </h1>
        <p class="rep-hub-sub">
            @I18n.T("Select a reporting center below to review hospital revenues, clinical statistics, or audit ledgers.", "হাসপাতালের আয়-ব্যয়, রোগী সেবা ও প্রশাসনিক তথ্যের জন্য নিচের যেকোনো রিপোর্ট বিভাগ নির্বাচন করুন।")
        </p>
    </div>

    <!-- 3 Big Dedicated Portal Cards -->
    <div class="rep-portals-grid">
        <!-- 1. Financial Reports -->
        <a href="/reports/financial" class="rep-portal-card" style="border-top: 4px solid #0284c7;">
            <div class="portal-top">
                <div class="portal-icon-wrap" style="background: #e0f2fe; color: #0284c7;">
                    💰
                </div>
                <div class="portal-info">
                    <h2>@I18n.T("Financial Reports", "আর্থিক ও রাজস্ব রিপোর্ট")</h2>
                    <p>@I18n.T("Departmental collection, gross invoiced billings, discount audits, and net cash receipts across OPD, IPD, lab, OT, and pharmacy.", "সকল বিভাগের মোট আয়, বিশেষ ছাড়, আদায়, বকেয়া এবং নগদ ক্যাশ ফ্লো বিবরণী।")</p>
                </div>
            </div>
            <div class="portal-action">
                <span>@I18n.T("Open Financial Center", "ফাইন্যান্সিয়াল রিপোর্ট খুলুন")</span>
                <span>→</span>
            </div>
        </a>

        <!-- 2. MIS Reports -->
        <a href="/reports/mis" class="rep-portal-card" style="border-top: 4px solid #10b981;">
            <div class="portal-top">
                <div class="portal-icon-wrap" style="background: #d1fae5; color: #059669;">
                    📊
                </div>
                <div class="portal-info">
                    <h2>@I18n.T("MIS Reports", "ব্যবস্থাপনা ও পরিসংখ্যান (MIS)")</h2>
                    <p>@I18n.T("Key executive governance: outpatient flow, bed occupancy rates, average length of stay (ALOS), surgical cases, and laboratory metrics.", "রোগী উপস্থিতি, বেড ব্যবহারের হার, গড় অবস্থানকাল ও বিভাগীয় ক্লিনিক্যাল পরিসংখ্যান।")</p>
                </div>
            </div>
            <div class="portal-action" style="color: #059669;">
                <span>@I18n.T("Open Executive MIS", "এমআইএস পরিসংখ্যান খুলুন")</span>
                <span>→</span>
            </div>
        </a>

        <!-- 3. Accounts & General Ledger -->
        <a href="/accounts" class="rep-portal-card" style="border-top: 4px solid #8b5cf6;">
            <div class="portal-top">
                <div class="portal-icon-wrap" style="background: #ede9fe; color: #7c3aed;">
                    💳
                </div>
                <div class="portal-info">
                    <h2>@I18n.T("Accounts & General Ledger", "অ্যাকাউন্টস ও সাধারণ লেজার")</h2>
                    <p>@I18n.T("Cashier day closing, voucher journal, trial balance, and Cash vs General Ledger reconciliation.", "ক্যাশিয়ার শিফট ক্লোজিং, দিনভিত্তিক হ্যান্ডওভার ও অ্যাকাউন্টস লেজার মিলন।")</p>
                </div>
            </div>
            <div class="portal-action" style="color: #7c3aed;">
                <span>@I18n.T("Open Accounts Center", "অ্যাকাউন্টস লেজার খুলুন")</span>
                <span>→</span>
            </div>
        </a>
    </div>

    <!-- Today's Live Hospital Pulse Strip -->
    <div class="rep-pulse-card">
        <div class="rep-pulse-header">
            <h3 class="rep-pulse-title">
                <span>⚡</span>
                <span>@I18n.T("Today's Live Hospital Operations Pulse", "আজকের লাইভ হাসপাতাল পরিচালন চিত্র")</span>
            </h3>
            <span class="pill" style="font-size: 11px; background: #ecfdf5; color: #047857; font-weight: 700;">
                @DateTime.Today.ToString("dd MMMM yyyy")
            </span>
        </div>

        <div class="pulse-grid">
            <div class="pulse-cell">
                <span class="pulse-cell-label">@I18n.T("Today's Collection", "আজকের আদায়")</span>
                <span class="pulse-cell-val" style="color: #047857;">৳ @todayTotalCollection.ToString("N0")</span>
                <span class="pulse-cell-sub">@todayMemosCount @I18n.T("receipts recorded today")</span>
            </div>

            <div class="pulse-cell">
                <span class="pulse-cell-label">@I18n.T("OPD Consultations", "ওপিডি কনসালটেশন")</span>
                <span class="pulse-cell-val" style="color: #0284c7;">@todayOpdCount</span>
                <span class="pulse-cell-sub">@todayApptsCount @I18n.T("appointments scheduled")</span>
            </div>

            <div class="pulse-cell">
                <span class="pulse-cell-label">@I18n.T("Inpatients Admitted", "ভর্তি রোগী")</span>
                <span class="pulse-cell-val" style="color: #6d28d9;">@activeInpatientsCount</span>
                <span class="pulse-cell-sub">@todayAdmissionsCount @I18n.T("new admissions today")</span>
            </div>

            <div class="pulse-cell">
                <span class="pulse-cell-label">@I18n.T("Bed Occupancy", "বেড অকুপেন্সি")</span>
                <span class="pulse-cell-val" style="color: #b45309;">@occupancyRate.ToString("F1")%</span>
                <span class="pulse-cell-sub">@occupiedBeds / @totalBeds @I18n.T("beds utilized")</span>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "type")]
    public string? ReportType { get; set; }

    private decimal todayTotalCollection;
    private int todayMemosCount;
    private int todayOpdCount;
    private int todayApptsCount;
    private int activeInpatientsCount;
    private int todayAdmissionsCount;
    private int totalBeds;
    private int occupiedBeds;
    private double occupancyRate;

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        CheckRedirect();
        if (string.IsNullOrWhiteSpace(ReportType))
        {
            await LoadPulseAsync();
        }
    }

    protected override void OnParametersSet()
    {
        CheckRedirect();
    }

    private void CheckRedirect()
    {
        if (string.Equals(ReportType, "financial", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/reports/financial", replace: true);
        }
        else if (string.Equals(ReportType, "mis", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/reports/mis", replace: true);
        }
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadPulseAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var today = DateTime.Today;
        var tomorrow = today.AddDays(1);

        // 1. Collections today
        var opdToday = await db.OPDTickets.AsNoTracking().Where(x => x.TransDate >= today && x.TransDate < tomorrow).ToListAsync();
        var emgToday = await db.EmergencyMemos.AsNoTracking().Where(x => x.TransDate >= today && x.TransDate < tomorrow).ToListAsync();
        var otToday = await db.OTCashMemos.AsNoTracking().Where(x => x.TransDate >= today && x.TransDate < tomorrow).ToListAsync();
        var ipdRcptToday = await db.IpdMoneyReceipts.AsNoTracking().Where(x => x.TransDate >= today && x.TransDate < tomorrow).ToListAsync();
        var pharmToday = await db.PharmacyCashMemos.AsNoTracking().Where(x => x.TransDate >= today && x.TransDate < tomorrow).ToListAsync();

        todayTotalCollection = opdToday.Sum(x => x.Total)
            + emgToday.Sum(x => x.Paid)
            + otToday.Sum(x => x.Total - x.Discount)
            + ipdRcptToday.Sum(x => x.Amount)
            + pharmToday.Sum(x => (x.Total ?? 0) - (x.Discount ?? 0));

        todayMemosCount = opdToday.Count + emgToday.Count + otToday.Count + ipdRcptToday.Count + pharmToday.Count;

        // 2. OPD & Appts
        todayOpdCount = opdToday.Count;
        todayApptsCount = await db.DoctorAppointments.AsNoTracking().CountAsync(x => x.ApptDate >= today && x.ApptDate < tomorrow);

        // 3. IPD & Beds
        activeInpatientsCount = await db.PatientAdmissions.AsNoTracking().CountAsync(x => x.ReleaseDate == null);
        todayAdmissionsCount = await db.PatientAdmissions.AsNoTracking().CountAsync(x => x.AdmissionDate >= today && x.AdmissionDate < tomorrow);

        var beds = await db.BedCabins.AsNoTracking().ToListAsync();
        totalBeds = beds.Count;
        occupiedBeds = beds.Count(x => x.Status == "Occupied");
        occupancyRate = totalBeds > 0 ? (occupiedBeds * 100.0 / totalBeds) : 0;
    }

    public void Dispose()
    {
        I18n.OnLanguageChanged -= HandleLanguageChanged;
    }
}
