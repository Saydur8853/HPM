@page "/account/change-password"
@page "/account/profile"
@attribute [AllowAnonymous]
@implements IDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<AppUser> UserManager

<PageTitle>@I18n.T("User Profile & Password", "User Profile & Password") | @Branding.HospitalName</PageTitle>

<div class="page-heading">
    <div>
        <span class="eyebrow">@I18n.T("System Admin", "System Admin")</span>
        <h1>@I18n.T("User Profile & Security", "User Profile & Security")</h1>
        <p>@I18n.T("View your user profile credentials and update your sign-in password.", "View your user profile credentials and update your sign-in password.")</p>
    </div>
</div>

<div class="master-layout">
    <!-- User Profile Overview Card -->
    <div class="panel">
        <div class="panel-heading">
            <div>
                <h2>@I18n.T("Current User Profile", "Current User Profile")</h2>
                <p>@I18n.T("Your active system credentials and role assignment.", "Your active system credentials and role assignment.")</p>
            </div>
            <span class="badge badge-station-live">@I18n.T("Active Session", "Active Session")</span>
        </div>

        <div style="padding: 1.25rem; display: flex; flex-direction: column; gap: 1rem;">
            <div style="display: flex; align-items: center; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border);">
                <div style="width: 52px; height: 52px; border-radius: 50%; background: linear-gradient(135deg, #0284c7, #0369a1); color: #ffffff; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; font-weight: 700; box-shadow: 0 4px 12px rgba(2,132,199,0.25);">
                    @(string.IsNullOrWhiteSpace(currentUser?.DisplayName) ? "U" : currentUser.DisplayName[0].ToString().ToUpper())
                </div>
                <div>
                    <h3 style="margin: 0; font-size: 1.15rem; font-weight: 700; color: var(--text-heading);">@(currentUser?.DisplayName ?? "Staff Member")</h3>
                    <div style="color: var(--text-muted); font-size: 0.85rem;">@($"@{currentUser?.UserName ?? "user"}")</div>
                </div>
            </div>

            <div class="stat-grid" style="grid-template-columns: repeat(2, 1fr); gap: 0.75rem; margin-top: 0.25rem;">
                <div style="padding: 0.75rem; background: var(--surface-bg, #f8fafc); border: 1px solid var(--border); border-radius: 8px;">
                    <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600;">@I18n.T("Assigned Role", "Assigned Role")</div>
                    <div style="font-weight: 700; color: #0284c7; font-size: 0.95rem; margin-top: 0.25rem;">@(currentRole ?? "Staff")</div>
                </div>
                <div style="padding: 0.75rem; background: var(--surface-bg, #f8fafc); border: 1px solid var(--border); border-radius: 8px;">
                    <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600;">@I18n.T("Account Status", "Account Status")</div>
                    <div style="font-weight: 700; color: #10b981; font-size: 0.95rem; margin-top: 0.25rem;">@I18n.T("Active & Verified", "Active & Verified")</div>
                </div>
                <div style="padding: 0.75rem; background: var(--surface-bg, #f8fafc); border: 1px solid var(--border); border-radius: 8px;">
                    <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600;">@I18n.T("Email Address", "Email Address")</div>
                    <div style="font-weight: 600; color: var(--text-main); font-size: 0.85rem; margin-top: 0.25rem; word-break: break-all;">@(string.IsNullOrWhiteSpace(currentUser?.Email) ? I18n.T("Not configured", "Not configured") : currentUser.Email)</div>
                </div>
                <div style="padding: 0.75rem; background: var(--surface-bg, #f8fafc); border: 1px solid var(--border); border-radius: 8px;">
                    <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600;">@I18n.T("Member Since", "Member Since")</div>
                    <div style="font-weight: 600; color: var(--text-main); font-size: 0.85rem; margin-top: 0.25rem;">@(currentUser?.CreatedAt.ToLocalTime().ToString("dd MMM yyyy") ?? "-")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Password Change Form -->
    <div class="panel form-panel">
        <div class="panel-heading">
            <div>
                <h2>@I18n.T("Update sign-in password", "Update sign-in password")</h2>
                <p>@I18n.T("Minimum 8 characters with uppercase, lowercase, number and symbol.", "Minimum 8 characters with uppercase, lowercase, number and symbol.")</p>
            </div>
        </div>
        @if (Success == 1)
        {
            <div class="alert success">@I18n.T("Password changed successfully.", "Password changed successfully.")</div>
        }
        else if (Error == "mismatch")
        {
            <div class="alert danger">@I18n.T("The new password and confirmation do not match.", "The new password and confirmation do not match.")</div>
        }
        else if (Error == "invalid")
        {
            <div class="alert danger">@I18n.T("The current password is incorrect or the new password does not meet the policy.", "The current password is incorrect or the new password does not meet the policy.")</div>
        }
        <form method="post" action="/account/change-password-submit">
            <AntiforgeryToken />
            <div class="form-grid">
                <label class="span-2"><span>@I18n.T("Current password *", "Current password *")</span><input type="password" name="CurrentPassword" autocomplete="current-password" required /></label>
                <label class="span-2"><span>@I18n.T("New password *", "New password *")</span><input type="password" name="NewPassword" autocomplete="new-password" minlength="8" required /></label>
                <label class="span-2"><span>@I18n.T("Confirm new password *", "Confirm new password *")</span><input type="password" name="ConfirmPassword" autocomplete="new-password" minlength="8" required /></label>
            </div>
            <div class="form-actions"><button class="btn btn-primary" type="submit">@I18n.T("Change password", "Change password")</button></div>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public int? Success { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }

    private AppUser? currentUser;
    private string? currentRole;

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        if (auth.User.Identity?.IsAuthenticated == true)
        {
            currentUser = await UserManager.GetUserAsync(auth.User);
            if (currentUser != null)
            {
                var roles = await UserManager.GetRolesAsync(currentUser);
                currentRole = roles.FirstOrDefault() ?? "Staff";
            }
        }
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => I18n.OnLanguageChanged -= HandleLanguageChanged;
}
