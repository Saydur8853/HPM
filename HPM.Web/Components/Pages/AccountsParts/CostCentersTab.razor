    private async Task SetBasisAsync(int sourceId, string basis)
    {
        await RunAsync(async () =>
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var existing = await db.AllocationRules.Where(x => x.SourceCostCenterID == sourceId).ToListAsync();
            if (basis == "Fixed" && existing.Any(x => x.Basis == "Fixed"))
            {
                foreach (var r in existing) r.IsActive = r.Basis == "Fixed";
            }
            else
            {
                db.AllocationRules.RemoveRange(existing);
                if (basis != "None")
                    db.AllocationRules.Add(new AllocationRule { SourceCostCenterID = sourceId, Basis = basis, IsActive = true });
            }
            await db.SaveChangesAsync();
            rules = await db.AllocationRules.AsNoTracking().ToListAsync();
            Ok(I18n.T("Allocation rule saved.", "বণ্টনের নিয়ম সংরক্ষিত হয়েছে।"));
        }, reloadOnError: true);
    }

    private async Task AddFixedTargetAsync(int sourceId)
    {
        await RunAsync(async () =>
        {
            if (fixedTarget <= 0 || fixedWeight <= 0) { Fail(I18n.T("Choose a receiving department and a percentage above zero.", "বিভাগ ও শতাংশ (শূন্যের বেশি) দিন।")); return; }
            if (fixedWeight > 100) { Fail(I18n.T("A percentage cannot exceed 100.", "শতাংশ ১০০ এর বেশি হতে পারে না।")); return; }
            await using var db = await DbFactory.CreateDbContextAsync();
            var otherTotal = await db.AllocationRules
                .Where(x => x.SourceCostCenterID == sourceId && x.Basis == "Fixed" && x.IsActive && x.TargetCostCenterID != null && x.TargetCostCenterID != fixedTarget)
                .SumAsync(x => x.Weight ?? 0);
            if (otherTotal + fixedWeight > 100)
            {
                Fail(I18n.T($"The total would be {otherTotal + fixedWeight:0.##}%. The percentages of one department cannot exceed 100% (at most {100 - otherTotal:0.##}% left).",
                    $"মোট {otherTotal + fixedWeight:0.##}% হয়ে যাবে। এক বিভাগের শতাংশের যোগফল ১০০% এর বেশি হতে পারে না (সর্বোচ্চ {100 - otherTotal:0.##}% বাকি)।"));
                return;
            }
            var placeholder = await db.AllocationRules.Where(x => x.SourceCostCenterID == sourceId && x.Basis == "Fixed" && x.TargetCostCenterID == null).ToListAsync();
            db.AllocationRules.RemoveRange(placeholder);
            var same = await db.AllocationRules.FirstOrDefaultAsync(x => x.SourceCostCenterID == sourceId && x.Basis == "Fixed" && x.TargetCostCenterID == fixedTarget);
            if (same is null) db.AllocationRules.Add(new AllocationRule { SourceCostCenterID = sourceId, Basis = "Fixed", TargetCostCenterID = fixedTarget, Weight = fixedWeight, IsActive = true });
            else { same.Weight = fixedWeight; same.IsActive = true; }
            await db.SaveChangesAsync();
            rules = await db.AllocationRules.AsNoTracking().ToListAsync();
            fixedTarget = 0; fixedWeight = 0;
            Ok(I18n.T("Receiving department added.", "গ্রহীতা বিভাগ যোগ হয়েছে।"));
        });
    }

    private async Task RemoveRuleAsync(AllocationRule r)
    {
        await RunAsync(async () =>
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var x = await db.AllocationRules.FindAsync(r.ID);
            if (x is null) return;
            db.AllocationRules.Remove(x);
            await db.SaveChangesAsync();
            rules = await db.AllocationRules.AsNoTracking().ToListAsync();
            if (!rules.Any(y => y.SourceCostCenterID == r.SourceCostCenterID))
            {
                db.AllocationRules.Add(new AllocationRule { SourceCostCenterID = r.SourceCostCenterID, Basis = "Fixed", IsActive = true });
                await db.SaveChangesAsync();
                rules = await db.AllocationRules.AsNoTracking().ToListAsync();
            }
        }, reloadOnError: true);
    }

    private void Ok(string text) { messageClass = "success"; message = text; }
    private void Fail(string text) { messageClass = "danger"; message = text; }
}
