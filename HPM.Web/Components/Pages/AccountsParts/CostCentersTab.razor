@* Accounts tab 4: cost centers (departments), which department each service / bed category belongs to,
   and how shared department costs are spread at month end. Uses the Accounts page styles. *@
@inject IDbContextFactory<HpmDbContext> DbFactory

<AccToast Message="@message" Kind="@messageClass" OnClose='() => message = ""' />

<div class="acc-grid-2col">
    <!-- Left: Add / Edit Cost Center -->
    <div class="acc-card">
        <div class="acc-card-header">
            <h2 class="acc-card-title">
                <span>🏥 @(editor.ID == 0 ? I18n.T("Add Cost Center (Department)", "নতুন কস্ট সেন্টার (বিভাগ)") : I18n.T("Edit Cost Center", "কস্ট সেন্টার সম্পাদনা"))</span>
            </h2>
            <button type="button" class="btn btn-ghost btn-sm" style="font-size:11px;" @onclick="ResetEditor">+ @I18n.T("New", "নতুন")</button>
        </div>
        <div class="acc-card-body">
            <div style="margin-bottom:10px;">
                <span class="acc-field-label">@I18n.T("Department Group *", "বিভাগের দল *")</span>
                <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:5px;">
                    @foreach (var t in new[] { "Revenue", "Service", "Admin" })
                    {
                        <button type="button" class="acc-preset-btn @(editor.CenterType == t ? "active" : "")" style="padding:5px 2px; text-align:center;"
                                disabled="@(editor.IsSystem || !IsAdministrator)" @onclick='() => editor.CenterType = t'>@GroupIcon(t) @GroupLabel(t)</button>
                    }
                </div>
                <div style="font-size:10.5px; color:#64748b; margin-top:4px;">
                    @I18n.T("Revenue = earns income (Lab, OT, Pharmacy). Service = serves other departments. Admin = management & shared cost.",
                            "Revenue = আয় করে (ল্যাব, OT, ফার্মেসি)। Service = অন্য বিভাগকে সেবা দেয়। Admin = প্রশাসন ও যৌথ খরচ।")
                </div>
            </div>
            <div style="display:grid; grid-template-columns:120px 1fr; gap:10px; margin-bottom:10px;">
                <div>
                    <span class="acc-field-label">@I18n.T("Code *", "কোড *")</span>
                    <input class="classic-input" style="height:30px !important; font-weight:800;" @bind="editor.Code" maxlength="20" disabled="@(editor.IsSystem || !IsAdministrator)" placeholder="CC-113" />
                </div>
                <div>
                    <span class="acc-field-label">@I18n.T("Department Name *", "বিভাগের নাম *")</span>
                    <input class="classic-input" style="height:30px !important;" @bind="editor.Name" maxlength="100" disabled="@(!IsAdministrator)" placeholder="@I18n.T("e.g. Dialysis Unit", "যেমন: ডায়ালাইসিস ইউনিট")" />
                </div>
            </div>
            <div style="display:grid; grid-template-columns:1fr 140px; gap:10px; margin-bottom:10px;">
                <div>
                    <span class="acc-field-label">@I18n.T("In-charge", "ইনচার্জ")</span>
                    <input class="classic-input" style="height:30px !important;" @bind="editor.Incharge" maxlength="100" disabled="@(!IsAdministrator)" placeholder="@I18n.T("Responsible person", "দায়িত্বপ্রাপ্ত ব্যক্তি")" />
                </div>
                <div>
                    <span class="acc-field-label">@I18n.T("Area (sq ft)", "জায়গা (বর্গফুট)")</span>
                    <InputNumber class="classic-input" style="height:30px !important;" min="0" max="10000000" @bind-Value="editor.AreaSqFt" disabled="@(!IsAdministrator)" />
                </div>
            </div>
            <div style="margin-bottom:14px; display:flex; align-items:center; gap:8px;">
                <InputCheckbox id="cc-active-chk" @bind-Value="editor.IsActive" disabled="@(editor.IsSystem || !IsAdministrator)" />
                <label for="cc-active-chk" style="font-size:12px; font-weight:700; color:#334155; cursor:pointer;">@I18n.T("Active", "সক্রিয়")</label>
                @if (editor.IsSystem)
                {
                    <span class="pill" style="font-size:10px; background:#f1f5f9; color:#475569;">🔒 @I18n.T("Standard department: code and group are fixed", "স্ট্যান্ডার্ড বিভাগ: কোড ও দল স্থির")</span>
                }
            </div>
            @if (IsAdministrator)
            {
                <button type="button" class="btn btn-primary" style="width:100%; height:34px; font-weight:800;" disabled="@busy" @onclick="SaveAsync">
                    💾 @(editor.ID == 0 ? I18n.T("Save Cost Center", "কস্ট সেন্টার সংরক্ষণ") : I18n.T("Update Cost Center", "কস্ট সেন্টার আপডেট"))
                </button>
            }
            else
            {
                <div style="padding:10px; background:#fef3c7; color:#b45309; border-radius:6px; font-size:11.5px; font-weight:700;">
                    🔒 @I18n.T("Administrator permission is required to change cost centers.", "কস্ট সেন্টার বদলাতে অ্যাডমিনিস্ট্রেটর অনুমতি লাগবে।")
                </div>
            }
        </div>
    </div>

    <!-- Right: Cost Center directory with period result -->
    <div class="acc-card">
        <div class="acc-card-header">
            <div>
                <h2 class="acc-card-title"><span>📋 @I18n.T("Cost Centers & Period Result", "কস্ট সেন্টার ও পিরিয়ডের ফলাফল")</span></h2>
                <div style="font-size:11px; color:#64748b;">@FromDate.ToString("dd MMM yyyy") — @ToDate.ToString("dd MMM yyyy")</div>
            </div>
            <div style="display:flex; gap:6px; flex-wrap:wrap;">
                @foreach (var t in new[] { "ALL", "Revenue", "Service", "Admin" })
                {
                    <button type="button" class="acc-pill-filter @(typeFilter == t ? "active" : "")" @onclick='() => typeFilter = t'>
                        @(t == "ALL" ? $"{I18n.T("All", "সব")} ({centers.Count})" : $"{GroupLabel(t)} ({centers.Count(c => c.CenterType == t)})")
                    </button>
                }
            </div>
        </div>
        <div class="acc-table-wrap" style="max-height:520px; overflow-y:auto;">
            <table class="acc-table">
                <thead>
                    <tr>
                        <th style="width:80px;">@I18n.T("Code", "কোড")</th>
                        <th>@I18n.T("Department", "বিভাগ")</th>
                        <th>@I18n.T("Group", "দল")</th>
                        <th class="num">@I18n.T("Income (৳)", "আয়")</th>
                        <th class="num">@I18n.T("Expense (৳)", "খরচ")</th>
                        <th class="num">@I18n.T("Result (৳)", "ফলাফল")</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in centers.Where(c => typeFilter == "ALL" || c.CenterType == typeFilter))
                    {
                        var inc = periodIncome.GetValueOrDefault(c.ID);
                        var exp = periodExpense.GetValueOrDefault(c.ID);
                        <tr style="@(c.IsActive ? "" : "opacity:0.55;")">
                            <td><strong style="color:#0284c7;">@c.Code</strong></td>
                            <td>
                                <strong>@c.Name</strong>
                                @if (!string.IsNullOrWhiteSpace(c.Incharge)) { <div style="font-size:10.5px; color:#64748b;">👤 @c.Incharge</div> }
                            </td>
                            <td><span class="pill" style="font-size:10px; background:@GroupBg(c.CenterType); color:#334155; font-weight:750;">@GroupLabel(c.CenterType)</span></td>
                            <td class="num">@(inc != 0 ? I18n.FormatCurrency(inc) : "—")</td>
                            <td class="num">@(exp != 0 ? I18n.FormatCurrency(exp) : "—")</td>
                            <td class="num" style="font-weight:800; color:@(inc - exp >= 0 ? "#047857" : "#b91c1c");">@(inc != 0 || exp != 0 ? I18n.FormatCurrency(inc - exp) : "—")</td>
                            <td style="text-align:right;"><button type="button" class="acc-chip-btn" @onclick="() => Select(c)">✎ @I18n.T("Edit", "সম্পাদনা")</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="acc-grid-2col" style="margin-top:14px;">
    <!-- Category → department mapping -->
    <div class="acc-card">
        <div class="acc-card-header">
            <div>
                <h2 class="acc-card-title"><span>🔗 @I18n.T("Which Department Earns Each Service", "কোন সার্ভিসের আয় কোন বিভাগের")</span></h2>
                <div style="font-size:11px; color:#64748b;">
                    @I18n.T("Bills post their income to these departments automatically. \"Auto\" uses the test type (Pathology / Imaging / Procedure) or the ward.",
                            "বিল করলেই আয় এই বিভাগগুলোতে নিজে থেকে যায়। \"Auto\" মানে টেস্টের ধরন (প্যাথলজি / ইমেজিং / প্রসিডিওর) বা ওয়ার্ড অনুযায়ী।")
                </div>
            </div>
        </div>
        <div style="padding:10px 14px; background:#f8fafc; border-bottom:1px solid #e2e8f0; display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
            <button type="button" class="acc-pill-filter @(mapTab == "service" ? "active" : "")" @onclick='() => mapTab = "service"'>🧪 @I18n.T("Service Categories", "সার্ভিস ক্যাটাগরি") (@serviceCategories.Count)</button>
            <button type="button" class="acc-pill-filter @(mapTab == "bed" ? "active" : "")" @onclick='() => mapTab = "bed"'>🛏️ @I18n.T("Bed Categories", "বেড ক্যাটাগরি") (@bedCategories.Count)</button>
            @if (mapTab == "service")
            {
                <input type="text" class="classic-input" style="height:28px !important; flex:1; min-width:160px;" placeholder="@I18n.T("Search category...", "ক্যাটাগরি খুঁজুন...")" @bind="mapSearch" @bind:event="oninput" />
            }
        </div>
        <div class="acc-table-wrap" style="max-height:420px; overflow-y:auto;">
            <table class="acc-table">
                <thead><tr><th>@I18n.T("Category", "ক্যাটাগরি")</th><th style="width:260px;">@I18n.T("Department (Cost Center)", "বিভাগ")</th></tr></thead>
                <tbody>
                    @if (mapTab == "service")
                    {
                        @foreach (var c in serviceCategories.Where(c => string.IsNullOrWhiteSpace(mapSearch) || c.Name.Contains(mapSearch.Trim(), StringComparison.OrdinalIgnoreCase)))
                        {
                            <tr>
                                <td><strong>@c.Name</strong> @if (!string.IsNullOrWhiteSpace(c.DiagnosticType)) { <span class="pill" style="font-size:9.5px; background:#e0f2fe; color:#0369a1;">@c.DiagnosticType</span> }</td>
                                <td>
                                    <select class="classic-input" style="height:28px !important; font-size:11.5px !important;" disabled="@(!IsAdministrator || busy)"
                                            value="@(c.CostCenterID?.ToString() ?? "")" @onchange="e => SetServiceCategoryAsync(c, e.Value?.ToString())">
                                        <option value="">@I18n.T("Auto (by test type)", "Auto (টেস্টের ধরন অনুযায়ী)")</option>
                                        @foreach (var cc in centers.Where(x => x.IsActive && x.CenterType == "Revenue"))
                                        {
                                            <option value="@cc.ID">@cc.Code · @cc.Name</option>
                                        }
                                    </select>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        @foreach (var b in bedCategories)
                        {
                            <tr>
                                <td><strong>@b.Name</strong> <span style="font-size:10.5px; color:#64748b;">@I18n.FormatCurrency(b.Rate ?? 0)/@I18n.T("day", "দিন")</span></td>
                                <td>
                                    <select class="classic-input" style="height:28px !important; font-size:11.5px !important;" disabled="@(!IsAdministrator || busy)"
                                            value="@(b.CostCenterID?.ToString() ?? "")" @onchange="e => SetBedCategoryAsync(b, e.Value?.ToString())">
                                        <option value="">@I18n.T("Auto (IPD Ward & Cabin)", "Auto (IPD ওয়ার্ড ও কেবিন)")</option>
                                        @foreach (var cc in centers.Where(x => x.IsActive && x.CenterType == "Revenue"))
                                        {
                                            <option value="@cc.ID">@cc.Code · @cc.Name</option>
                                        }
                                    </select>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Allocation rules -->
    <div class="acc-card">
        <div class="acc-card-header">
            <div>
                <h2 class="acc-card-title"><span>⚖️ @I18n.T("Month-End Cost Allocation Rules", "মাস শেষে খরচ বণ্টনের নিয়ম")</span></h2>
                <div style="font-size:11px; color:#64748b;">
                    @I18n.T("Each service / admin department's monthly expenses are spread over the revenue departments.",
                            "প্রতিটা সেবা/প্রশাসন বিভাগের মাসিক খরচ আয় করা বিভাগগুলোতে ভাগ হয়।")
                </div>
            </div>
        </div>
        <div class="acc-table-wrap" style="max-height:420px; overflow-y:auto;">
            <table class="acc-table">
                <thead><tr><th>@I18n.T("Department to spread", "যে বিভাগের খরচ ভাগ হবে")</th><th style="width:210px;">@I18n.T("Basis", "ভাগের ভিত্তি")</th></tr></thead>
                <tbody>
                    @foreach (var src in centers.Where(x => x.IsActive && x.CenterType != "Revenue"))
                    {
                        var basis = rules.FirstOrDefault(r => r.SourceCostCenterID == src.ID && r.IsActive)?.Basis ?? "None";
                        <tr>
                            <td>
                                <strong style="color:#0284c7;">@src.Code</strong> · <strong>@src.Name</strong>
                                @if (basis == "Fixed")
                                {
                                    <div style="margin-top:6px; display:flex; flex-direction:column; gap:4px;">
                                        @foreach (var r in rules.Where(r => r.SourceCostCenterID == src.ID && r.Basis == "Fixed" && r.TargetCostCenterID != null))
                                        {
                                            <div style="display:flex; gap:6px; align-items:center; font-size:11px;">
                                                <span>→ @CenterName(r.TargetCostCenterID)</span>
                                                <b>@(r.Weight?.ToString("0.##"))%</b>
                                                @if (IsAdministrator) { <button type="button" style="border:none; background:none; color:#dc2626; cursor:pointer;" @onclick="() => RemoveRuleAsync(r)">✕</button> }
                                            </div>
                                        }
                                        @{ var fixedTotal = rules.Where(r => r.SourceCostCenterID == src.ID && r.Basis == "Fixed" && r.TargetCostCenterID != null && r.IsActive).Sum(r => r.Weight ?? 0); }
                                        <div style="font-size:11px; font-weight:800; color:@(fixedTotal == 100 ? "#047857" : "#b45309");">
                                            @I18n.T("Total", "মোট"): @fixedTotal.ToString("0.##")% @(fixedTotal == 100 ? "✓" : I18n.T("⚠ must be 100% — not spread until then", "⚠ ১০০% হতে হবে — তার আগে ভাগ হবে না"))
                                        </div>
                                        @if (IsAdministrator)
                                        {
                                            <div style="display:flex; gap:4px; align-items:center;">
                                                <select class="classic-input" style="height:26px !important; font-size:11px !important;" @bind="fixedTarget">
                                                    <option value="0">@I18n.T("Receiving department...", "গ্রহীতা বিভাগ...")</option>
                                                    @foreach (var cc in centers.Where(x => x.IsActive && x.CenterType == "Revenue"))
                                                    {
                                                        <option value="@cc.ID">@cc.Code · @cc.Name</option>
                                                    }
                                                </select>
                                                <InputNumber class="classic-input" style="height:26px !important; width:70px;" min="0.01" max="100" step="0.01" @bind-Value="fixedWeight" />
                                                <span style="font-size:11px; font-weight:750; color:#64748b;">%</span>
                                                <button type="button" class="acc-chip-btn" disabled="@busy" @onclick="() => AddFixedTargetAsync(src.ID)">+ %</button>
                                            </div>
                                        }
                                    </div>
                                }
                            </td>
                            <td>
                                <select class="classic-input" style="height:28px !important; font-size:11.5px !important;" disabled="@(!IsAdministrator || busy)"
                                        value="@basis" @onchange='e => SetBasisAsync(src.ID, e.Value?.ToString() ?? "None")'>
                                    <option value="None">@I18n.T("Do not spread", "ভাগ হবে না")</option>
                                    <option value="Revenue">@I18n.T("By income share", "আয়ের অনুপাতে")</option>
                                    <option value="Area">@I18n.T("By floor area (sq ft)", "জায়গা (বর্গফুট) অনুযায়ী")</option>
                                    <option value="BillCount">@I18n.T("By number of bills", "বিলের সংখ্যা অনুযায়ী")</option>
                                    <option value="Fixed">@I18n.T("Fixed percentages", "নির্দিষ্ট শতাংশে")</option>
                                </select>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsAdministrator { get; set; }
    [Parameter] public DateTime FromDate { get; set; }
    [Parameter] public DateTime ToDate { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public int RefreshToken { get; set; }

    private List<CostCenter> centers = [];
    private List<ServiceCategory> serviceCategories = [];
    private List<BedCategory> bedCategories = [];
    private List<AllocationRule> rules = [];
    private Dictionary<int, decimal> periodIncome = [], periodExpense = [];
    private CostCenter editor = new() { CenterType = "Revenue", IsActive = true };
    private string typeFilter = "ALL", mapTab = "service", mapSearch = "", message = "", messageClass = "success";
    private int fixedTarget;
    private decimal fixedWeight;
    private (DateTime, DateTime, int)? loadedRange;
    private bool busy;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedRange == (FromDate, ToDate, RefreshToken)) return;
        try { await LoadAsync(); }
        catch (Exception)
        {
            loadedRange = (FromDate, ToDate, RefreshToken);
            Fail(I18n.T("The database did not answer in time (it may be busy). Press 🔄 or reopen the tab to try again.", "ডাটাবেস সময়মতো উত্তর দেয়নি (ব্যস্ত থাকতে পারে)। 🔄 চাপুন বা ট্যাবটা আবার খুলুন।"));
        }
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        centers = await db.CostCenters.AsNoTracking().OrderBy(x => x.Code).ToListAsync();
        serviceCategories = await db.ServiceCategories.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
        bedCategories = await db.BedCategories.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
        rules = await db.AllocationRules.AsNoTracking().ToListAsync();

        var end = ToDate.Date.AddDays(1);
        var rows = await (from l in db.AccountVoucherLines
                          join v in db.AccountVouchers on l.VoucherID equals v.ID
                          join a in db.AccountHeads on l.AccountID equals a.ID
                          where v.IsPosted && v.Status != "Pending" && v.Status != "Rejected"
                                && v.VoucherDate >= FromDate.Date && v.VoucherDate < end && l.CostCenterID != null
                                && (a.AccountType == "Income" || a.AccountType == "Expense")
                          group l by new { CC = l.CostCenterID!.Value, a.AccountType } into g
                          select new { g.Key.CC, g.Key.AccountType, Net = g.Sum(x => x.Credit - x.Debit) }).ToListAsync();
        periodIncome = rows.Where(x => x.AccountType == "Income").ToDictionary(x => x.CC, x => x.Net);
        periodExpense = rows.Where(x => x.AccountType == "Expense").ToDictionary(x => x.CC, x => -x.Net);
        loadedRange = (FromDate, ToDate, RefreshToken);
    }

    /// <summary>Runs one action: one at a time, and any database error becomes a message instead of breaking the page.</summary>
    private async Task RunAsync(Func<Task> work, bool reloadOnError = false)
    {
        if (!IsAdministrator || busy) return;
        busy = true;
        try { await work(); }
        catch (Exception ex)
        {
            Fail(ex.GetBaseException().Message);
            if (reloadOnError) { try { await LoadAsync(); } catch (Exception) { } }
        }
        finally { busy = false; }
    }

    private string GroupLabel(string t) => t switch
    {
        "Revenue" => I18n.T("Revenue", "আয়ের বিভাগ"),
        "Service" => I18n.T("Service", "সেবা বিভাগ"),
        "Admin" => I18n.T("Admin", "প্রশাসন"),
        _ => t
    };
    private static string GroupIcon(string t) => t switch { "Revenue" => "💰", "Service" => "🛠️", _ => "🏛️" };

    private static string GroupBg(string t) => t switch { "Revenue" => "#d1fae5", "Service" => "#e0f2fe", _ => "#ede9fe" };
    private string CenterName(int? id) => centers.FirstOrDefault(x => x.ID == id) is { } c ? $"{c.Code} · {c.Name}" : "—";
    private void Select(CostCenter c) => editor = new() { ID = c.ID, Code = c.Code, Name = c.Name, CenterType = c.CenterType, Incharge = c.Incharge, AreaSqFt = c.AreaSqFt, IsActive = c.IsActive, IsSystem = c.IsSystem };
    private void ResetEditor() => editor = new() { CenterType = "Revenue", IsActive = true };

    private async Task SaveAsync()
    {
        await RunAsync(async () =>
        {
            editor.Code = (editor.Code ?? "").Trim().ToUpperInvariant();
            editor.Name = (editor.Name ?? "").Trim();
            if (string.IsNullOrWhiteSpace(editor.Code) || string.IsNullOrWhiteSpace(editor.Name)) { Fail(I18n.T("Code and name are required.", "কোড ও নাম আবশ্যক।")); return; }
            editor.Incharge = editor.Incharge?.Trim();
            if (editor.Code.Length > 20 || editor.Name.Length > 100 || (editor.Incharge?.Length ?? 0) > 100)
            {
                Fail(I18n.T("Keep the code within 20, the name within 100 and the in-charge within 100 characters.", "কোড ২০, নাম ১০০ ও ইনচার্জ ১০০ অক্ষরের মধ্যে লিখুন।"));
                return;
            }
            if (editor.AreaSqFt < 0) { Fail(I18n.T("Area cannot be negative.", "জায়গা ঋণাত্মক হতে পারে না।")); return; }
            if (editor.AreaSqFt > 10_000_000) { Fail(I18n.T("Area cannot exceed 10,000,000 sq ft.", "জায়গা ১,০০,০০,০০০ বর্গফুটের বেশি হতে পারে না।")); return; }
            await using var db = await DbFactory.CreateDbContextAsync();
            if (await db.CostCenters.AnyAsync(x => x.Code == editor.Code && x.ID != editor.ID)) { Fail(I18n.T("This code already exists.", "এই কোড আগে থেকেই আছে।")); return; }
            if (editor.ID == 0)
            {
                db.CostCenters.Add(new CostCenter { Code = editor.Code, Name = editor.Name, CenterType = editor.CenterType, Incharge = editor.Incharge?.Trim(), AreaSqFt = editor.AreaSqFt, IsActive = editor.IsActive });
            }
            else
            {
                var x = await db.CostCenters.FindAsync(editor.ID);
                if (x is null) return;
                if (!x.IsSystem) { x.Code = editor.Code; x.CenterType = editor.CenterType; }
                // A standard (system) department always stays active.
                x.Name = editor.Name; x.Incharge = editor.Incharge?.Trim(); x.AreaSqFt = editor.AreaSqFt; x.IsActive = x.IsSystem || editor.IsActive;
            }
            await db.SaveChangesAsync();
            AccountMap.Invalidate();
            Ok(I18n.T("Cost center saved.", "কস্ট সেন্টার সংরক্ষিত হয়েছে।"));
            ResetEditor();
            await LoadAsync();
            await OnChanged.InvokeAsync();
        });
    }

