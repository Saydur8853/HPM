@page "/appointments"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.Reception)]
@rendermode InteractiveServer
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject IJSRuntime JS
@inject IBarcodeQrService BarcodeQr
@inject AuthenticationStateProvider AuthStateProvider
@inject PatientSelectionState PatientSelection
@implements IDisposable
@using System.Security.Claims
@using HPM.Web.Components.Common

@using System.Text.RegularExpressions

<PageTitle>@I18n.T("Doctor Appointments") | @Branding.HospitalName</PageTitle>

<div class="appointments-classic-fit" tabindex="0" @onkeydown="HandlePageKeyDown">
    <!-- Compact Top Action & Filter Bar -->
    <div class="appt-classic-topbar">
        <div class="appt-top-left">
            <h1 class="appt-page-title">
                <span>@I18n.T("Doctor Appointments")</span>
            </h1>
            <span class="appt-count-pill">
                @appointments.Count @I18n.T("Appointments")
            </span>
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <span class="appt-inline-alert @messageClass" title="@message">
                    @message
                </span>
            }
        </div>

        <div class="appt-top-actions">
            <div class="appt-date-filter-wrap">
                <label>@I18n.T("Date"):</label>
                <div class="appt-date-chips">
                    <button type="button" class="appt-chip @(filterDate.Date == DateTime.Today ? "active" : "")" @onclick="() => SetFilterDateAsync(DateTime.Today)">@I18n.T("Today")</button>
                    <button type="button" class="appt-chip @(filterDate.Date == DateTime.Today.AddDays(1) ? "active" : "")" @onclick="() => SetFilterDateAsync(DateTime.Today.AddDays(1))">@I18n.T("Tomorrow")</button>
                </div>
                <InputDate class="appt-date-filter-input"
                           @bind-Value="filterDate"
                           @bind-Value:after="LoadAppointmentsAsync"
                           title="@I18n.T("Filter schedule by appointment date")" />
            </div>

            <button type="button" class="btn btn-secondary appt-btn" @onclick="PrintScheduleAsync" title="@I18n.T("Print Daily Schedule")">
                🖨️ @I18n.T("Print Schedule")
            </button>
            <button type="button" class="btn btn-secondary appt-btn" @onclick="Reset" title="@I18n.T("New Appointment / Reset Form")">
                + @I18n.T("New Appointment")
            </button>
        </div>
    </div>

    <!-- Main Balanced Workspace Grid: Left Booking Form, Right Schedule & Queue -->
    <div class="appt-classic-workspace">
        <!-- Left Panel: Appointment Booking Form Card -->
        <div class="appt-form-card">
            <div class="appt-card-header">
                <div class="appt-card-header-title-wrap" style="display: flex; align-items: center; gap: 10px;">
                    <h2>@(editor.ID == 0 ? I18n.T("Book Doctor Appointment") : $"{I18n.T("Edit Appointment")} #{editor.ID}")</h2>
                    <span class="appt-serial-badge @(editor.ID == 0 ? "emerald" : "violet")">
                        @(editor.ID == 0 ? $"{I18n.T("NEXT SERIAL #")}{NextAvailableSerial:00}" : $"{I18n.T("SERIAL #")}{editor.ApptSLNO:00}")
                    </span>
                </div>
                <button type="button" 
                        class="appt-schedule-trigger-btn @(showScheduleDrawer ? "active" : "")" 
                        @onclick="ToggleScheduleDrawer" 
                        title="@I18n.T("View Daily Schedule & Patient Queue (F2 / Ctrl+Q)")">
                    <span>📋</span>
                    <span>@I18n.T("Daily Schedule & Queue")</span>
                    <span class="trigger-pill">@appointments.Count</span>
                    @if (appointments.Any(x => x.Status == "CheckedIn"))
                    {
                        <span class="trigger-pill checked" title="@I18n.T("Checked-in Patients")">
                            ✓ @appointments.Count(x => x.Status == "CheckedIn")
                        </span>
                    }
                </button>
            </div>

            <EditForm Model="editor" OnValidSubmit="SaveAsync" @onkeydown="HandleFormKeyDown" style="display:flex; flex-direction:column; min-height:0;">
                <DataAnnotationsValidator />

                <div class="appt-form-body appt-form-twocol">
                    <!-- Left Column: Doctor Selection & Chamber Schedule -->
                    <div class="appt-col-left">
                        <!-- Consultant Doctor -->
                        <div class="appt-field-group">
                            <span class="appt-field-label">
                                <span>@I18n.T("Consultant Doctor")<span class="req">*</span></span>
                            </span>
                            <div class="appt-doctor-search-combo-wrap" id="appt-doctor-search-box" style="position: relative; width: 100%;">
                                <div style="display: flex; gap: 6px; align-items: center;">
                                    <select class="classic-input appt-dept-filter-select"
                                            value="@selectedDepartmentId"
                                            @onchange="HandleDepartmentFilterChanged"
                                            style="flex: 0 0 145px; max-width: 155px; height: 28px; font-size: 11px; font-weight: 650; cursor: pointer; background-color: #f8fafc; border: 1px solid #cbd5e1; border-radius: 4px;"
                                            title="@I18n.T("Filter by Department")">
                                        <option value="0">📂 @I18n.T("All Depts")</option>
                                        @foreach (var dept in departments.OrderBy(d => d.Value))
                                        {
                                            <option value="@dept.Key">@dept.Value</option>
                                        }
                                    </select>
                                    <div class="appt-doctor-search" style="flex: 1; min-width: 0; position: relative;">
                                        <input class="classic-input"
                                               id="appt-doctor-search-input"
                                               value="@doctorSearchText"
                                               @oninput="HandleDoctorSearchInputAsync"
                                               @onfocus="ShowDoctorSuggestions"
                                               @onkeydown="HandleDoctorSearchKeyDown"
                                               autocomplete="off"
                                               placeholder="@I18n.T("Search doctor ID, name, or specialty...")"
                                               title="@I18n.T("Search doctor")" />
                                    </div>
                                </div>
                                @if (showDoctorSuggestions)
                                {
                                    <div class="appt-doctor-suggestions" id="appt-doctor-suggestions-list" style="position: absolute; top: calc(100% + 2px); left: 0; right: 0; z-index: 120;">
                                        @if (filteredDoctorItems.Count > 0)
                                        {
                                            @foreach (var item in VisibleDoctorItems)
                                            {
                                                var doctor = item.Doctor;
                                                <button type="button"
                                                        @key="doctor.ID"
                                                        class="appt-doctor-option @(editor.DoctorID == doctor.ID ? "selected" : "")"
                                                        @onmousedown:preventDefault
                                                        @onclick="() => SelectDoctor(doctor)">
                                                    <div class="appt-doctor-option-main">
                                                        <span class="appt-doctor-option-name">
                                                            @if (doctor.Priority.HasValue && doctor.Priority.Value > 0)
                                                            {
                                                                <span class="appt-priority-pill" title="Priority #@doctor.Priority">⭐ #@doctor.Priority</span>
                                                            }
                                                            @item.DisplayName
                                                        </span>
                                                        <span class="appt-doctor-option-id">ID: D@(doctor.ID)</span>
                                                    </div>
                                                    <div class="appt-doctor-option-sub">
                                                        @item.Degree@if (!string.IsNullOrWhiteSpace(item.DepartmentName)){<text> &bull; @item.DepartmentName</text>}@if(!string.IsNullOrWhiteSpace(item.Room)){<text> &bull; Room @item.Room</text>}
                                                    </div>
                                                </button>
                                            }
                                            @if (VisibleDoctorsCount < filteredDoctorItems.Count)
                                            {
                                                <div class="appt-doctor-scroll-hint"
                                                     @onmousedown:preventDefault
                                                     @onclick="LoadMoreDoctorsFromJs">
                                                    @I18n.T("Showing") @VisibleDoctorsCount / @filteredDoctorItems.Count &bull; @I18n.T("Scroll for more...")
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            @if (!doctors.Any())
                                            {
                                                <div class="appt-doctor-empty">@I18n.T("Loading doctors...")</div>
                                            }
                                            else
                                            {
                                                <div class="appt-doctor-empty">
                                                    @I18n.T("No doctor found")
                                                    @if (selectedDepartmentId > 0)
                                                    {
                                                        <text> in this department </text>
                                                        <button type="button" class="btn btn-link btn-sm p-0 ms-1" style="font-size: 11px; vertical-align: baseline;" @onmousedown:preventDefault @onclick="ResetDeptFilter">(@I18n.T("Show All"))</button>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Appointment Schedule: Date & Time (Separated) -->
                        <div style="display: flex; gap: 8px; margin-bottom: 2px;">
                            <!-- Date -->
                            <div class="appt-field-group" style="flex: 1.3; min-width: 0;">
                                <div class="appt-date-header-row">
                                    <span class="appt-field-label">
                                        <span>@I18n.T("Appointment Date")<span class="req">*</span></span>
                                    </span>
                                    <div class="appt-date-chips">
                                        @{
                                            var isTodayOff = SelectedDoctor != null && IsDoctorOffDay(SelectedDoctor, DateTime.Today);
                                            var isTomorrowOff = SelectedDoctor != null && IsDoctorOffDay(SelectedDoctor, DateTime.Today.AddDays(1));
                                        }
                                        <button type="button" 
                                                class="appt-chip @(apptDatePart.Date == DateTime.Today ? "active" : "") @(isTodayOff ? "offday-chip" : "")" 
                                                @onclick="SetApptDateToday"
                                                title="@(isTodayOff ? $"{DoctorDisplayName(SelectedDoctor)} {I18n.T("is OFF Today")}" : I18n.T("Today"))">
                                            @I18n.T("Today")@(isTodayOff ? " (Off)" : "")
                                        </button>
                                        <button type="button" 
                                                class="appt-chip @(apptDatePart.Date == DateTime.Today.AddDays(1) ? "active" : "") @(isTomorrowOff ? "offday-chip" : "")" 
                                                @onclick="SetApptDateTomorrow"
                                                title="@(isTomorrowOff ? $"{DoctorDisplayName(SelectedDoctor)} {I18n.T("is OFF Tomorrow")}" : I18n.T("Tomorrow"))">
                                            @I18n.T("Tomorrow")@(isTomorrowOff ? " (Off)" : "")
                                        </button>
                                    </div>
                                </div>
                                <InputDate class="@(SelectedDoctor != null && IsDoctorOffDay(SelectedDoctor, apptDatePart) ? "classic-input input-offday-warn" : "classic-input")" 
                                           Type="InputDateType.Date" 
                                           @bind-Value="apptDatePart" 
                                           @bind-Value:after="OnApptDateChanged" />
                            </div>

                            <!-- Time -->
                            <div class="appt-field-group" style="flex: 1; min-width: 0;">
                                <span class="appt-field-label">
                                    <span>@I18n.T("Appointment Time")<span class="req">*</span></span>
                                </span>
                                <input type="time" class="classic-input appt-time-input" value="@apptTimePart" @onchange="OnApptTimeInputChanged" />
                            </div>
                        </div>

                        <!-- Available Consultation Schedule & Booking Slots for Selected Doctor -->
                        @if (SelectedDoctor != null && editor.DoctorID > 0)
                        {
                            var isOffDay = IsDoctorOffDay(SelectedDoctor, apptDatePart);
                            @if (isOffDay)
                            {
                                <div class="appt-doctor-offday-banner">
                                    <div class="appt-doc-offday-top">
                                        <span class="appt-doc-offday-badge">🚫 @I18n.T("DOCTOR'S WEEKLY OFF DAY")</span>
                                        <span class="appt-doc-offday-date">📅 @apptDatePart.ToString("dddd, dd MMM yyyy")</span>
                                    </div>
                                    <div class="appt-doc-offday-body">
                                        <div class="appt-doc-offday-title">
                                            <strong>@DoctorDisplayName(SelectedDoctor)</strong> @I18n.T("is not available for consultation on") <span class="highlight-day">@apptDatePart.ToString("dddd")</span>.
                                        </div>
                                        <div class="appt-doc-offday-meta">
                                            @I18n.T("Regular Off Day(s)"): <strong style="color: #b91c1c;">@GetDoctorOffDaysDisplay(SelectedDoctor)</strong> &bull; @I18n.T("Appointments cannot be booked on off days.")
                                        </div>
                                    </div>
                                    @{
                                        var nextWorking = GetNextAvailableDoctorDate(SelectedDoctor, apptDatePart);
                                    }
                                    @if (nextWorking.HasValue)
                                    {
                                        <div class="appt-doc-offday-switch-row">
                                            <span style="font-size:11px; font-weight:700; color:#475569;">@I18n.T("Suggested next working day"):</span>
                                            <button type="button" class="appt-switch-date-btn" @onclick="() => SwitchToAvailableDate(nextWorking.Value)">
                                                📅 @nextWorking.Value.ToString("ddd, dd MMM yyyy") &bull; @I18n.T("Switch Date") &rarr;
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="appt-doctor-schedule-box">
                                    <div class="appt-doc-sched-top">
                                        <div class="appt-doc-sched-title-wrap">
                                            <span class="appt-doc-sched-icon">⏰</span>
                                            <div>
                                                <div class="appt-doc-sched-time">
                                                    <strong>@I18n.T("Consultation Schedule"):</strong>
                                                    <span>@GetDoctorConsultationHours(SelectedDoctor)</span>
                                                </div>
                                                <div class="appt-doc-sched-meta">
                                                    @if (!string.IsNullOrWhiteSpace(CleanDoctorRoom(SelectedDoctor.Room)))
                                                    {
                                                        <span>🚪 Room @CleanDoctorRoom(SelectedDoctor.Room)</span>
                                                    }
                                                    @if (SelectedDoctor.Department.HasValue && departments.TryGetValue(SelectedDoctor.Department.Value, out var deptName))
                                                    {
                                                        <span>&bull; 🩺 @deptName</span>
                                                    }
                                                    <span>&bull; 📅 @apptDatePart.ToString("ddd, dd MMM yyyy")</span>
                                                    @if (!string.IsNullOrWhiteSpace(GetDoctorOffDaysDisplay(SelectedDoctor)))
                                                    {
                                                        <span>&bull; 🚫 Off: @GetDoctorOffDaysDisplay(SelectedDoctor)</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        <span class="appt-doc-sched-badge">
                                            ✓ @I18n.T("Click Slot to Set Time")
                                        </span>
                                    </div>

                                    <div class="appt-slot-chips-wrap">
                                        <span class="appt-slot-chips-label">@I18n.T("Available Slots (Click to set time)"):</span>
                                        <div class="appt-slot-chips">
                                            @foreach (var slot in GetDoctorAvailableSlots(SelectedDoctor, apptDatePart))
                                            {
                                                var isSelectedSlot = IsSlotSelected(slot.Time);
                                                <button type="button"
                                                        class="appt-slot-btn @(isSelectedSlot ? "active" : "")"
                                                        @onclick="() => SetAppointmentTimeSlot(slot.Time)"
                                                        title="@slot.Label">
                                                    <span class="slot-dot">●</span>
                                                    <span class="slot-time-text">@slot.Label</span>
                                                    @if (slot.BookedCount > 0)
                                                    {
                                                        <span class="slot-booked-tag">(@slot.BookedCount)</span>
                                                    }
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="appt-doctor-hint-box">
                                <span style="font-size: 20px;">🩺</span>
                                <div style="flex:1; min-width:0;">
                                    <strong>@I18n.T("Consultation Schedule & Available Slots")</strong>
                                    <div style="font-size: 11px; color: #64748b; margin-top: 1px;">@I18n.T("Select a consultant doctor to view chamber hours and click time slots.")</div>
                                    @if (doctors.Any())
                                    {
                                        <div class="appt-quick-doctors-wrap">
                                            <span class="appt-quick-doc-label">@I18n.T("Quick Pick"):</span>
                                            @foreach (var qDoc in doctors.Take(4))
                                            {
                                                <button type="button" class="appt-quick-doc-chip" @onclick="() => SelectDoctor(qDoc)" title="@DoctorDisplayName(qDoc)">
                                                    🩺 @DoctorDisplayName(qDoc)
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Right Column: Patient Intake & Demographics -->
                    <div class="appt-col-right">
                        <!-- Patient Intake Section -->
                        <div class="appt-field-group">
                            <div class="appt-patient-header-row">
                                <span class="appt-field-label">
                                    <span>@I18n.T("Patient Information")<span class="req">*</span></span>
                                </span>
                                <div class="appt-mode-toggle">
                                    <button type="button" class="appt-mode-btn @(isWalkInMode ? "active" : "")" @onclick="() => SetPatientMode(true)">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                            <circle cx="12" cy="7" r="4"></circle>
                                        </svg>
                                        <span>@I18n.T("Walk-in")</span>
                                    </button>
                                    <button type="button" class="appt-mode-btn @(!isWalkInMode ? "active" : "")" @onclick="() => SetPatientMode(false)">
                                        <SearchIcon />
                                        <span>@I18n.T("Registered")</span>
                                    </button>
                                </div>
                            </div>

                            @if (!isWalkInMode)
                            {
                                @if (!string.IsNullOrWhiteSpace(editor.PatientID) && !string.IsNullOrWhiteSpace(editor.Name))
                                {
                                    <div class="appt-patient-verified">
                                        <div class="appt-patient-verified-info">
                                            <strong>#@editor.PatientID</strong> &bull; @editor.Name
                                            @if (!string.IsNullOrWhiteSpace(SelectedPatientSex))
                                            {
                                                <text> &bull; </text>
                                                <span class="meta-tag sex-tag-@SelectedPatientSex.ToLowerInvariant()">
                                                    @(SelectedPatientSex == "Male" ? "♂ Male" : SelectedPatientSex == "Female" ? "♀ Female" : SelectedPatientSex)
                                                </span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(editor.Age)) { <text> &bull; @editor.Age</text> }
                                            @if (!string.IsNullOrWhiteSpace(editor.Weight)) { <text> &bull; ⚖️ @editor.Weight kg</text> }
                                            @if (!string.IsNullOrWhiteSpace(editor.ContactNo)) { <text> &bull; 📞 @editor.ContactNo</text> }
                                        </div>
                                        <button type="button" class="appt-clear-link" @onclick="ClearSelectedPatient" title="Search different patient">
                                            @I18n.T("Change")
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="appt-patient-search-field">
                                        <div class="appt-patient-search-combo">
                                            <input class="classic-input"
                                                   value="@patientSearchQuery"
                                                   @oninput="HandlePatientSearchInputAsync"
                                                   @onfocus="ShowPatientIdSuggestionsAsync"
                                                   @onblur="HidePatientSuggestionsAsync"
                                                   @onkeydown="HandlePatientSearchKeyDown"
                                                   autocomplete="off"
                                                   placeholder="@I18n.T("Search by Patient ID, Mobile or Name...")"
                                                   title="@I18n.T("Search patient")" />
                                            <button type="button" class="btn-find" @onclick="() => FindPatientAsync(patientSearchQuery)" title="@I18n.T("Search Patient")">
                                                <SearchIcon /> @I18n.T("Search")
                                            </button>
                                        </div>
                                        @if (showPatientIdSuggestions)
                                        {
                                            <div class="appt-patient-suggestions" id="appt-patient-suggestions-list">
                                                @foreach (var patient in patientIdSuggestions)
                                                {
                                                    <button type="button" class="appt-patient-option" @onmousedown:preventDefault @onclick="() => SelectPatient(patient)">
                                                        <span class="patient-id">@patient.PatientID</span>
                                                        <span class="patient-name">@patient.Name</span>
                                                        @if (!string.IsNullOrWhiteSpace(patient.Sex))
                                                        {
                                                            <span class="meta-tag sex-tag-@patient.Sex.ToLowerInvariant()">
                                                                @(patient.Sex == "Male" ? "♂ Male" : patient.Sex == "Female" ? "♀ Female" : patient.Sex)
                                                            </span>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(patient.Weight))
                                                        {
                                                            <span class="patient-weight-pill">⚖️ @patient.Weight kg</span>
                                                        }
                                                        <span class="patient-contact">@patient.Contact</span>
                                                    </button>
                                                }
                                                @if (hasMorePatientSuggestions)
                                                {
                                                    <div class="appt-doctor-scroll-hint" @onclick="LoadMorePatientsFromJs" @onmousedown:preventDefault>
                                                        @if (isLoadingMorePatients)
                                                        {
                                                            <span>@I18n.T("Loading more...")</span>
                                                        }
                                                        else
                                                        {
                                                            <span>@I18n.T("Showing") @patientIdSuggestions.Count &bull; @I18n.T("Scroll for more...")</span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>

                        <!-- Patient Name & Mobile No -->
                        <div style="display: flex; gap: 8px; margin-bottom: 2px;">
                            <div class="appt-field-group" style="flex: 1.4; min-width: 0;">
                                <span class="appt-field-label">
                                    <span>@I18n.T("Patient Name")<span class="req">*</span></span>
                                </span>
                                <InputText class="classic-input" @bind-Value="editor.Name" placeholder="@I18n.T("Full name of patient")" />
                            </div>

                            <div class="appt-field-group" style="flex: 1; min-width: 0;">
                                <span class="appt-field-label">@I18n.T("Mobile No")</span>
                                <InputText class="classic-input" @bind-Value="editor.ContactNo" placeholder="017xxxxxxxx" />
                            </div>
                        </div>

                        <!-- Sex -->
                        <div class="appt-field-group appt-field-sex">
                            <span class="appt-field-label">@I18n.T("Sex")</span>
                            <div class="sex-btn-group" role="radiogroup" aria-label="@I18n.T("Sex")">
                                @foreach (var sex in sexOptions)
                                {
                                    var isSelected = string.Equals(editor.Sex, sex.Key, StringComparison.OrdinalIgnoreCase);
                                    var sexClass = sex.Key.ToLowerInvariant();
                                    <button type="button"
                                            class="sex-btn sex-btn-@sexClass @(isSelected ? "is-selected" : "")"
                                            tabindex="@(isSelected ? 0 : -1)"
                                            @onclick="() => SelectSex(sex.Key)"
                                            title="@I18n.T(sex.Label)">
                                        <span class="sex-icon">
                                            @if (sex.Key == "Male")
                                            {
                                                <svg class="sex-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <circle cx="10" cy="14" r="5"></circle>
                                                    <line x1="19" y1="5" x2="13.6" y2="10.4"></line>
                                                    <polyline points="15 5 19 5 19 9"></polyline>
                                                </svg>
                                            }
                                            else if (sex.Key == "Female")
                                            {
                                                <svg class="sex-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <circle cx="12" cy="9" r="5"></circle>
                                                    <line x1="12" y1="14" x2="12" y2="21"></line>
                                                    <line x1="9" y1="18" x2="15" y2="18"></line>
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg class="sex-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <circle cx="12" cy="12" r="4"></circle>
                                                    <line x1="12" y1="4" x2="12" y2="8"></line>
                                                    <line x1="10" y1="5" x2="14" y2="5"></line>
                                                    <line x1="12" y1="16" x2="12" y2="20"></line>
                                                    <line x1="10" y1="19" x2="14" y2="19"></line>
                                                </svg>
                                            }
                                        </span>
                                        <span class="sex-text">@I18n.T(sex.Label)</span>
                                    </button>
                                }
                            </div>
                        </div>

                        <!-- Age & Weight (Compact & Proportioned below Sex) -->
                        <div class="appt-vitals-compact-stack">
                            <!-- Age -->
                            <div class="appt-field-group appt-field-age">
                                <span class="appt-field-label">@I18n.T("Age")</span>
                                <div class="appt-unit-input-box">
                                    <InputText class="classic-input appt-unit-input" @bind-Value="editor.Age" placeholder="e.g. 28" />
                                    <span class="appt-unit-addon">Yrs</span>
                                </div>
                            </div>

                            <!-- Weight -->
                            <div class="appt-field-group appt-field-weight">
                                <span class="appt-field-label">@I18n.T("Weight")</span>
                                <div class="appt-unit-input-box">
                                    <InputText class="classic-input appt-unit-input" @bind-Value="editor.Weight" placeholder="e.g. 65" />
                                    <span class="appt-unit-addon">kg</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="appt-form-footer">
                    @{
                        var isDateOffDay = SelectedDoctor != null && IsDoctorOffDay(SelectedDoctor, apptDatePart);
                    }
                    <div class="appt-footer-left-info">
                        @if (editor.ID > 0)
                        {
                            <button class="btn btn-ghost appt-btn" type="button" @onclick="DeleteSelectedAsync" style="color: #dc2626;" title="@I18n.T("Delete Appointment")">
                                @I18n.T("Delete")
                            </button>
                        }
                    </div>

                    <div class="appt-footer-right-actions">
                        <button class="btn btn-ghost appt-btn" type="button" @onclick="Reset" title="@I18n.T("Clear Form")">
                            @I18n.T("Clear")
                        </button>
                        <button class="btn btn-primary appt-btn appt-book-btn" type="submit" 
                                disabled="@(saving || isDateOffDay)" 
                                title="@(isDateOffDay ? $"{DoctorDisplayName(SelectedDoctor)} {I18n.T("is OFF on")} {apptDatePart:dddd}. {I18n.T("Cannot book appointment.")}" : I18n.T("Book Appointment (Ctrl+Enter)"))">
                            ✓ @(saving ? I18n.T("Booking...") : editor.ID == 0 ? I18n.T("Book Appointment") : I18n.T("Update Appointment"))
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>

    <!-- Actionable Daily Schedule Slide-Over Drawer -->
    <div class="appt-drawer-backdrop @(showScheduleDrawer ? "show" : "")" @onclick="CloseScheduleDrawer"></div>
    <aside class="appt-drawer-panel @(showScheduleDrawer ? "show" : "")" aria-label="@I18n.T("Daily Schedule & Queue")">
        <div class="appt-drawer-header">
            <div class="appt-drawer-title-wrap">
                <span style="font-size:16px;">📋</span>
                <h3 class="appt-drawer-title">
                    @I18n.T("Daily Schedule & Queue")
                </h3>
            </div>
            <div style="display:flex; align-items:center; gap:8px;">
                <div class="appt-date-filter-wrap" style="background:#ffffff; border:1px solid #cbd5e1; border-radius:6px; padding:2px 6px;">
                    <label style="font-size:11px; font-weight:700; color:#475569;">📅 @I18n.T("Date"):</label>
                    <InputDate class="appt-date-filter-input"
                               @bind-Value="filterDate"
                               @bind-Value:after="LoadAppointmentsAsync"
                               title="@I18n.T("Filter schedule by appointment date")" />
                </div>
                <button type="button" class="appt-drawer-close" @onclick="CloseScheduleDrawer" title="@I18n.T("Close Drawer (Esc)")" aria-label="@I18n.T("Close")">
                    ✕
                </button>
            </div>
        </div>

        <div class="appt-drawer-body">
            <!-- Doctor's Daily Schedule & Queue Card -->
            <div class="appt-queue-card" style="border:none; border-radius:0; box-shadow:none; height:100%;">
                <div class="appt-queue-top">
                    <div class="appt-queue-title-wrap">
                        <h2>@I18n.T("Daily Schedule")</h2>
                        <span class="appt-date-sub">(@filterDate.ToString("dd MMM yyyy"))</span>
                    </div>

                    <!-- Scope Switcher & Doctor Dropdown Filter -->
                    <div style="display:flex; flex-direction:column; gap:6px; width:100%; margin-top:4px;">
                        <div class="appt-scope-tabs">
                            <button type="button"
                                    class="appt-scope-tab @(!filterByCurrentDoctor ? "active" : "")"
                                    @onclick="() => SetDoctorScope(false)"
                                    title="@I18n.T("Show all doctors")">
                                👥 @I18n.T("All Doctors")
                                <span class="count-pill">@appointments.Count</span>
                            </button>
                            <button type="button"
                                    class="appt-scope-tab @(filterByCurrentDoctor ? "active" : "")"
                                    @onclick="() => SetDoctorScope(true)"
                                    title="@I18n.T("Filter by specific doctor")">
                                🩺 @(drawerDoctorId > 0 && doctorById.TryGetValue(drawerDoctorId, out var dItem) ? dItem.DisplayName : I18n.T("Doctor Wise"))
                                <span class="count-pill">@(drawerDoctorId > 0 ? appointments.Count(a => a.DoctorID == drawerDoctorId) : appointments.Count)</span>
                            </button>
                        </div>

                        @if (filterByCurrentDoctor)
                        {
                            <div class="appt-drawer-doc-select-wrap">
                                <select class="classic-input appt-select" value="@drawerDoctorId" @onchange="OnDrawerDoctorChanged" style="font-size:11.5px; height:29px; width:100%;">
                                    <option value="0">-- @I18n.T("All Doctors in List") --</option>
                                    @foreach (var doc in doctors)
                                    {
                                        <option value="@doc.ID">@DoctorDisplayName(doc) (@appointments.Count(a => a.DoctorID == doc.ID))</option>
                                    }
                                </select>
                            </div>
                        }
                    </div>
                </div>

                <!-- Status Filter Bar -->
                <div class="appt-queue-filter-strip">
                    <div class="appt-status-chips">
                        <button type="button" class="status-chip @(statusFilter == "All" ? "active" : "")" @onclick='() => SetStatusFilter("All")'>
                            @I18n.T("All") (@ScopedAppointments.Count())
                        </button>
                        <button type="button" class="status-chip booked @(statusFilter == "Booked" ? "active" : "")" @onclick='() => SetStatusFilter("Booked")'>
                            @I18n.T("Booked") (@ScopedAppointments.Count(x => x.Status == "Booked"))
                        </button>
                        <button type="button" class="status-chip checkedin @(statusFilter == "CheckedIn" ? "active" : "")" @onclick='() => SetStatusFilter("CheckedIn")'>
                            @I18n.T("Checked In") (@ScopedAppointments.Count(x => x.Status == "CheckedIn"))
                        </button>
                    </div>

                    <span style="font-size:11px; font-weight:700; color:#64748b;">
                        @FilteredAppointments.Count() @I18n.T("Listed")
                    </span>
                </div>

                <!-- Barcode & QR Scanner Bar -->
                <div class="appt-scanner-bar">
                    <div class="appt-scanner-input-wrap">
                        <span class="appt-scanner-icon"><SearchIcon /></span>
                        <input type="text"
                               class="classic-input appt-scanner-input"
                               placeholder="@I18n.T("Scan barcode/QR or search serial, patient, mobile...")"
                               @bind="apptScanQuery"
                               @bind:event="oninput"
                               @bind:after="ResetQueuePage"
                               @onkeydown="HandleApptScanKeyDown" />
                        @if (!string.IsNullOrWhiteSpace(apptScanQuery))
                        {
                            <button type="button" class="appt-scanner-clear" @onclick="ClearApptScan" title="Clear">✕</button>
                        }
                    </div>
                </div>

                <!-- Queue List with Internal Vertical Scroll -->
                <div class="appt-queue-list">
                    @if (!FilteredAppointments.Any())
                    {
                        <div class="appt-empty-state">
                            <div class="appt-empty-state-icon">📋</div>
                            <div class="appt-empty-state-title">@I18n.T("No appointments matching current filters")</div>
                            <div class="appt-empty-state-desc">
                                @if (filterByCurrentDoctor && editor.DoctorID > 0)
                                {
                                    @I18n.T("No appointments scheduled for this doctor on selected date.")
                                }
                                else
                                {
                                    @I18n.T("No appointments found for the selected date and status.")
                                }
                            </div>
                            @if (filterByCurrentDoctor && appointments.Any())
                            {
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => SetDoctorScope(false)" style="margin-top:8px;">
                                    👥 @I18n.T("View All Doctors Appointments") (@appointments.Count)
                                </button>
                            }
                        </div>
                    }
                    @foreach (var appt in VisibleAppointments)
                    {
                        <div class="appt-queue-item @(appt.Status == "CheckedIn" ? "checkedin-item" : "") @(editor.ID == appt.ID ? "active" : "")">
                            <div class="appt-serial-col">
                                <span class="appt-queue-serial">#@appt.ApptSLNO.ToString("00")</span>
                                <span class="appt-time-pill">@appt.ApptDate.ToString("hh:mm tt")</span>
                            </div>

                            <div class="appt-queue-info">
                                <div class="appt-name-row">
                                    <strong class="appt-queue-name">@appt.Name</strong>
                                    <span class="pill @(appt.Status == "CheckedIn" ? "pill-success" : "")" style="font-size:10px; font-weight:700;">
                                        @appt.Status
                                    </span>
                                </div>
                                <div class="appt-queue-meta">
                                    @if (ClinicalEncounterWorkflow.IsTempPatientId(appt.PatientID))
                                    {
                                        <span class="meta-tag temp-id-tag">🪪 Temp: @appt.PatientID</span>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(appt.PatientID))
                                    {
                                        <span class="meta-tag id-tag">ID: @appt.PatientID</span>
                                    }
                                    else
                                    {
                                        <span class="meta-tag temp-id-tag">🪪 Temp: @ClinicalEncounterWorkflow.FormatTempPatientId(appt.ID)</span>
                                    }
                                    @{
                                        var apptSex = !string.IsNullOrWhiteSpace(appt.Sex) ? appt.Sex : (!string.IsNullOrWhiteSpace(appt.PatientID) && patientSexMap.TryGetValue(appt.PatientID, out var sVal) ? sVal : null);
                                    }
                                    @if (!string.IsNullOrWhiteSpace(apptSex))
                                    {
                                        <span class="meta-sep">&bull;</span>
                                        <span class="meta-tag sex-tag-@apptSex.ToLowerInvariant()">
                                            @(apptSex == "Male" ? "♂ Male" : apptSex == "Female" ? "♀ Female" : apptSex)
                                        </span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(appt.Age))
                                    {
                                        <span class="meta-sep">&bull;</span>
                                        <span>@appt.Age</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(appt.Weight))
                                    {
                                        <span class="meta-sep">&bull;</span>
                                        <span>⚖️ @appt.Weight kg</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(appt.ContactNo))
                                    {
                                        <span class="meta-sep">&bull;</span>
                                        <span>@appt.ContactNo</span>
                                    }
                                    @if (!filterByCurrentDoctor)
                                    {
                                        <span class="meta-sep">&bull;</span>
                                        <span class="meta-doc">🩺 @DoctorName(appt.DoctorID)</span>
                                    }
                                </div>
                            </div>

                            <div class="appt-queue-actions">
                                @if (appt.Status == "Booked" && appt.ApptDate.Date == DateTime.Today)
                                {
                                    <button class="appt-action-checkin" @onclick="() => CheckInAsync(appt)" title="@I18n.T("Check in patient to queue")">
                                        ✓ @I18n.T("Check in")
                                    </button>
                                }
                                <button class="appt-tool-btn" @onclick="() => SelectAndCloseDrawer(appt)" title="@I18n.T("Edit (Select & Open in Form)")">
                                    ✎
                                </button>
                                <button class="appt-tool-btn danger" @onclick="() => DeleteAsync(appt)" title="@I18n.T("Delete")">
                                    &times;
                                </button>
                            </div>
                        </div>
                    }
                </div>
                @if (QueuePageCount > 1)
                {
                    <div class="appt-queue-pager">
                        <button type="button" @onclick="PreviousQueuePage" disabled="@(queuePage == 0)" aria-label="Previous appointments">&lsaquo;</button>
                        <span>@(queuePage + 1) / @QueuePageCount</span>
                        <button type="button" @onclick="NextQueuePage" disabled="@(queuePage >= QueuePageCount - 1)" aria-label="Next appointments">&rsaquo;</button>
                    </div>
                }
            </div>
        </div>

        <div class="appt-drawer-footer">
            <button type="button" class="btn btn-secondary appt-btn" @onclick="PrintScheduleAsync" title="@I18n.T("Print Filtered Schedule List")">
                🖨️ @I18n.T("Print Schedule")
            </button>
            <button type="button" class="btn btn-ghost appt-btn" @onclick="CloseScheduleDrawer">
                @I18n.T("Close") (Esc)
            </button>
        </div>
    </aside>
</div>

<div id="appointment-print" class="print-document">
    <div class="print-sheet">
        <PrintDocumentHeader Title="Doctor Appointment Slip"
                             DocNo="@($"#{editor.ID}")"
                             DocNoLabel="Appointment"
                             BarcodeCode="@($"APT-{editor.ID:00000}")"
                             QrPayload="@BarcodeQr.GenerateAppointmentQrPayload(editor.ID, editor.ApptSLNO, editor.Name ?? "", DoctorName(editor.DoctorID), editor.ApptDate)" />

        <div class="print-grid">
            <div><span>@I18n.T("Queue Serial #")</span><b style="font-size: 16px; color: #0284c7;">#@editor.ApptSLNO.ToString("00")</b></div>
            <div><span>@I18n.T("Appointment Date & Time")</span><b>@editor.ApptDate.ToString("dd MMM yyyy, hh:mm tt")</b></div>
            <div><span>@I18n.T("Patient Name")</span><b>@editor.Name</b></div>
            <div><span>@I18n.T("Patient ID")</span>@(string.IsNullOrWhiteSpace(editor.PatientID) ? I18n.T("Walk-in") : editor.PatientID)</div>
            <div><span>@I18n.T("Consultant Doctor")</span><b>@DoctorName(editor.DoctorID)</b></div>
            <div><span>@I18n.T("Age / Sex / Contact")</span>@editor.Age @(!string.IsNullOrWhiteSpace(SelectedPatientSex) ? $" / {SelectedPatientSex}" : "") @(!string.IsNullOrWhiteSpace(editor.Weight) ? $" / ⚖️ {editor.Weight} kg" : "") / @editor.ContactNo</div>
        </div>

        <PrintDocumentFooter SignTitle1="Patient / Attendant"
                             SignTitle3="Reception Desk"
                             PageNumberText="Page 1 of 1" />
    </div>
</div>

<div id="schedule-print" class="print-document">
    <div class="print-sheet">
        <PrintDocumentHeader Title="Daily Doctor Appointment Schedule"
                             Subtitle="@($"Schedule Date: {filterDate:dd MMM yyyy}{(filterByCurrentDoctor && drawerDoctorId > 0 ? $" • Doctor: {DoctorName(drawerDoctorId)}" : "")}")" />

        @{
            var doctorGroups = FilteredAppointments
                .GroupBy(a => a.DoctorID)
                .OrderBy(g => DoctorName(g.Key));
        }

        @if (!doctorGroups.Any())
        {
            <div style="text-align:center; padding:24px; color:#64748b; font-size:13px; font-weight:600;">
                @I18n.T("No appointments scheduled for this date / filter.")
            </div>
        }
        else
        {
            @foreach (var group in doctorGroups)
            {
                var doc = doctors.FirstOrDefault(d => d.ID == group.Key);
                var docRoom = doc != null ? CleanDoctorRoom(doc.Room) : string.Empty;
                var deptName = doc != null && doc.Department.HasValue && departments.TryGetValue(doc.Department.Value, out var dn) ? dn : string.Empty;

                <div class="print-doctor-schedule-block" style="margin-top: 14px; page-break-inside: avoid;">
                    <!-- Doctor Section Banner (Printed once per doctor, not repeated per row) -->
                    <div style="background: #f1f5f9; border-left: 4px solid #0284c7; padding: 6px 10px; display: flex; align-items: center; justify-content: space-between; border-radius: 3px; margin-bottom: 4px;">
                        <div>
                            <span style="font-size: 13px; font-weight: 800; color: #0f172a;">🩺 @DoctorName(group.Key)</span>
                            @if (!string.IsNullOrWhiteSpace(deptName))
                            {
                                <span style="font-size: 11px; color: #475569; margin-left: 6px;">&bull; @deptName</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(docRoom))
                            {
                                <span style="font-size: 11px; color: #0369a1; font-weight: 700; margin-left: 6px;">&bull; Room: @docRoom</span>
                            }
                        </div>
                        <span style="font-size: 11px; font-weight: 700; color: #0369a1; background: #e0f2fe; padding: 2px 8px; border-radius: 10px;">
                            @group.Count() @I18n.T("Patient(s)")
                        </span>
                    </div>

                    <!-- Patients under this doctor -->
                    <table class="data-table" style="width: 100%; margin-bottom: 8px;">
                        <thead>
                            <tr>
                                <th style="width: 52px; text-align: center;">@I18n.T("Queue #")</th>
                                <th style="width: 120px;">@I18n.T("Temp ID")</th>
                                <th>@I18n.T("Patient Name")</th>
                                <th style="width: 50px; text-align: center;">@I18n.T("Sex")</th>
                                <th style="width: 55px; text-align: center;">@I18n.T("Age")</th>
                                <th style="width: 65px; text-align: center;">@I18n.T("Weight")</th>
                                <th style="width: 95px;">@I18n.T("Phone No")</th>
                                <th style="width: 135px; text-align: center;">@I18n.T("Barcode")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in group.OrderBy(x => x.ApptSLNO))
                            {
                                var pid = !string.IsNullOrWhiteSpace(a.PatientID) ? a.PatientID : ClinicalEncounterWorkflow.FormatTempPatientId(a.ID);
                                var apptSex = !string.IsNullOrWhiteSpace(a.Sex) ? a.Sex : (!string.IsNullOrWhiteSpace(a.PatientID) && patientSexMap.TryGetValue(a.PatientID, out var s) ? s : "-");
                                <tr>
                                    <td style="text-align: center; vertical-align: middle;">
                                        <b style="font-size: 13px; color: #0284c7;">#@a.ApptSLNO.ToString("00")</b>
                                    </td>
                                    <td style="vertical-align: middle;">
                                        <span style="font-family: monospace; font-size: 11px; font-weight: 700; color: #0369a1;">@pid</span>
                                    </td>
                                    <td style="vertical-align: middle;">
                                        <b style="font-size: 12px; color: #0f172a;">@a.Name</b>
                                    </td>
                                    <td style="text-align: center; vertical-align: middle; font-size: 11px;">@apptSex</td>
                                    <td style="text-align: center; vertical-align: middle; font-size: 11px;">@a.Age</td>
                                    <td style="text-align: center; vertical-align: middle; font-size: 11px;">
                                        @(string.IsNullOrWhiteSpace(a.Weight) ? "-" : $"{a.Weight} kg")
                                    </td>
                                    <td style="vertical-align: middle; font-size: 11px;">@a.ContactNo</td>
                                    <td style="text-align: center; vertical-align: middle; padding: 2px 4px;">
                                        <div style="display: inline-block; max-width: 130px; overflow: hidden; line-height: 1;">
                                            @((MarkupString)BarcodeQr.GenerateBarcodeSvg(pid, barHeight: 24, includeText: false))
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }

        <PrintDocumentFooter SignTitle1="Duty Receptionist"
                             SignTitle3="Medical Officer In-Charge"
                             PageNumberText="Page 1 of 1" />
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "patientId")]
    public string? QueryPatientId { get; set; }

    private DoctorAppointment editor = NewAppointment();
    private List<DoctorsProfile> doctors = [];
    private List<DoctorAppointment> appointments = [];
    private Dictionary<int, string> departments = [];
    private string apptScanQuery = string.Empty;
    private DateTime filterDate = DateTime.Today;
    private string message = string.Empty;
    private string messageClass = "success";
    private string doctorSearchText = string.Empty;
    private bool showDoctorSuggestions;
    private List<Registration> patientIdSuggestions = [];
    private bool showPatientIdSuggestions;
    private const int PatientBatchSize = 15;
    private bool hasMorePatientSuggestions = true;
    private bool isLoadingMorePatients = false;
    private string patientSearchQuery = string.Empty;
    private bool isWalkInMode = true;
    private bool filterByCurrentDoctor = false;
    private int drawerDoctorId = 0;
    private string statusFilter = "All";
    private bool saving;
    private bool showScheduleDrawer;
    private int originalDoctorId;
    private DateTime originalDate;
    private const int QueuePageSize = 8;
    private int queuePage;

    private DoctorsProfile? SelectedDoctor => doctors.FirstOrDefault(x => x.ID == editor.DoctorID);
    private int DoctorTodayCount => appointments.Count(a => a.DoctorID == editor.DoctorID);
    private int NextAvailableSerial
    {
        get
        {
            if (editor.DoctorID <= 0) return 1;
            var max = appointments
                .Where(a => a.DoctorID == editor.DoctorID && a.ApptDate.Date == editor.ApptDate.Date)
                .Select(a => a.ApptSLNO)
                .DefaultIfEmpty(0)
                .Max();
            return max + 1;
        }
    }

    // Map of PatientID to Sex
    private Dictionary<string, string> patientSexMap = new();
    private static readonly (string Key, string Label, string Icon)[] sexOptions = [("Male", "Male", "♂"), ("Female", "Female", "♀"), ("Other", "Other", "⚥")];
    private string? selectedPatientSex;
    private string? SelectedPatientSex => !string.IsNullOrWhiteSpace(editor.Sex) ? editor.Sex : (selectedPatientSex
        ?? (!string.IsNullOrWhiteSpace(editor.PatientID) && patientSexMap.TryGetValue(editor.PatientID, out var s) ? s : null));

    private void SelectSex(string sex)
    {
        editor.Sex = sex;
        selectedPatientSex = sex;
    }

    private IEnumerable<DoctorAppointment> ScopedAppointments => filterByCurrentDoctor && drawerDoctorId > 0
        ? appointments.Where(a => a.DoctorID == drawerDoctorId)
        : appointments;

    private IEnumerable<DoctorAppointment> FilteredAppointments
    {
        get
        {
            var list = ScopedAppointments;
            if (statusFilter == "Booked") list = list.Where(a => a.Status == "Booked");
            else if (statusFilter == "CheckedIn") list = list.Where(a => a.Status == "CheckedIn");

            if (!string.IsNullOrWhiteSpace(apptScanQuery))
            {
                var q = apptScanQuery.Trim();
                list = list.Where(a => a.ID.ToString().Contains(q, StringComparison.OrdinalIgnoreCase)
                                       || a.ApptSLNO.ToString().Contains(q, StringComparison.OrdinalIgnoreCase)
                                       || (a.Name?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                                       || (a.PatientID?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                                       || (a.ContactNo?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
            }
            return list;
        }
    }

    private int QueuePageCount => Math.Max(1, (int)Math.Ceiling(FilteredAppointments.Count() / (double)QueuePageSize));
    private IEnumerable<DoctorAppointment> VisibleAppointments => FilteredAppointments
        .Skip(queuePage * QueuePageSize)
        .Take(QueuePageSize);

    private sealed record DoctorViewItem(
        DoctorsProfile Doctor,
        string DisplayName,
        string Degree,
        string DepartmentName,
        string Room,
        string SearchHaystack);

    private const int DoctorBatchSize = 12;
    private int doctorVisibleCount = DoctorBatchSize;
    private List<DoctorViewItem> doctorViewItems = [];
    private List<DoctorViewItem> filteredDoctorItems = [];
    private Dictionary<int, DoctorViewItem> doctorById = [];
    private DotNetObjectReference<Appointments>? dotNetRef;

    private IEnumerable<DoctorViewItem> VisibleDoctorItems => filteredDoctorItems.Take(doctorVisibleCount);
    private int VisibleDoctorsCount => Math.Min(doctorVisibleCount, filteredDoctorItems.Count);

    private void BuildDoctorCache()
    {
        var list = new List<DoctorViewItem>(doctors.Count);
        var map = new Dictionary<int, DoctorViewItem>(doctors.Count);
        foreach (var d in doctors)
        {
            var disp = DoctorDisplayName(d);
            var deg = CleanDoctorDegree(d);
            var deptName = d.Department.HasValue && departments.TryGetValue(d.Department.Value, out var dn) ? dn : string.Empty;
            var room = CleanDoctorRoom(d.Room);
            var haystack = $"D{d.ID} {d.ID} {disp} {deg} {deptName} {room} {d.Room}";
            var item = new DoctorViewItem(d, disp, deg, deptName, room, haystack);
            list.Add(item);
            map[d.ID] = item;
        }
        doctorViewItems = list;
        doctorById = map;
        UpdateFilteredDoctors();
    }

