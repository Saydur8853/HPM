        showScheduleDrawer = false;
    }

    private void HandlePageKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "F2" || (e.Key == "q" && e.CtrlKey))
        {
            ToggleScheduleDrawer();
        }
        else if (e.Key == "Escape" && showScheduleDrawer)
        {
            CloseScheduleDrawer();
        }
    }

    private async Task HandleFormKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && e.CtrlKey)
        {
            await SaveAsync();
        }
        else if (e.Key == "F2" || (e.Key == "q" && e.CtrlKey))
        {
            ToggleScheduleDrawer();
        }
        else if (e.Key == "Escape" && showScheduleDrawer)
        {
            CloseScheduleDrawer();
        }
    }

    private static string Age(DateTime? birth)
    {
        if (!birth.HasValue) return string.Empty;
        var b = birth.Value;
        var years = DateTime.Today.Year - b.Year;
        if (b.Date > DateTime.Today.AddYears(-years)) years--;
        return $"{Math.Max(0, years)}Y";
    }

