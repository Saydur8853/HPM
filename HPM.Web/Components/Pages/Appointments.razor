private async Task LoadAppointmentsAsync()
{
    await using var db = await DbFactory.CreateDbContextAsync();
    var dayStart = filterDate.Date;
    var dayEnd = dayStart.AddDays(1);
    appointments = await db.DoctorAppointments.AsNoTracking()
        .Where(x => x.ApptDate >= dayStart && x.ApptDate < dayEnd)
        .OrderBy(x => x.DoctorID)
        .ThenBy(x => x.ApptDate)
        .ThenBy(x => x.ApptSLNO)
        .ToListAsync();
    // Load patient sexes for appointments with PatientID
    var patientIds = appointments
        .Where(a => !string.IsNullOrWhiteSpace(a.PatientID))
        .Select(a => a.PatientID!)
        .Distinct()
        .ToList();
    if (patientIds.Any())
    {
        var patients = await db.Registrations.AsNoTracking()
            .Where(p => patientIds.Contains(p.PatientID))
            .Select(p => new { p.PatientID, p.Sex })
            .ToListAsync();
        patientSexMap = patients.ToDictionary(p => p.PatientID, p => p.Sex);
    }
    queuePage = 0;
}

