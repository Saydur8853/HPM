    public void LoadMoreDoctorsFromJs()
    {
        if (doctorVisibleCount < filteredDoctorItems.Count)
        {
            doctorVisibleCount = Math.Min(filteredDoctorItems.Count, doctorVisibleCount + DoctorBatchSize);
            StateHasChanged();
        }
