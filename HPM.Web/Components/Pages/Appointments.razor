    private static DoctorAppointment NewAppointment() => new() { ApptDate = DateTime.Now, TransDate = DateTime.Now, Status = "Booked" };
    private static readonly Regex MultiSpaceRegex = new(@"\s+", RegexOptions.Compiled);
    private static readonly Regex MultiDotRegex = new(@"\.{2,}", RegexOptions.Compiled);
    private static readonly Regex LeadingZRegex = new(@"^z{2,}[\s._-]*", RegexOptions.Compiled | RegexOptions.IgnoreCase);

    public static string CleanDoctorText(string? input)
    {
        if (string.IsNullOrWhiteSpace(input)) return string.Empty;
        var s = input.Trim();
        if (s.All(c => c == '.' || c == '-' || c == '_' || char.IsWhiteSpace(c)))
            return string.Empty;

        s = LeadingZRegex.Replace(s, string.Empty);
        s = MultiDotRegex.Replace(s, " ");
        s = s.TrimStart('.', ' ', '-', '_', '\t');
        s = s.TrimEnd(' ', '\t');
        return MultiSpaceRegex.Replace(s, " ").Trim();
    }

    private static string CleanDoctorTitle(DoctorsProfile doctor) => CleanDoctorText(doctor.Title);
    private static string CleanDoctorName(DoctorsProfile doctor) => CleanDoctorText(doctor.Name);
    private static string CleanDoctorDegree(DoctorsProfile doctor) => CleanDoctorText(doctor.Degree);
    private static string CleanDoctorRoom(string? room) => CleanDoctorText(room);

    private static string DoctorDisplayName(DoctorsProfile doctor)
    {
        var title = CleanDoctorTitle(doctor);
        var name = CleanDoctorName(doctor);
        if (string.IsNullOrWhiteSpace(title)) return name;
        if (string.IsNullOrWhiteSpace(name)) return title;
        if (name.StartsWith(title, StringComparison.OrdinalIgnoreCase))
            return name;
        return $"{title} {name}".Trim();
    }

    private string DoctorName(int id)
    {
        var doc = doctors.FirstOrDefault(x => x.ID == id);
        return doc is null ? "Doctor" : DoctorDisplayName(doc);
    }

    private static string DoctorLabel(DoctorsProfile doctor)
    {
        var disp = DoctorDisplayName(doctor);
        var deg = CleanDoctorDegree(doctor);
        return string.IsNullOrWhiteSpace(deg) ? disp : $"{disp} {deg}".Trim();
    }

