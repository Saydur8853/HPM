            PatientID = a.PatientID,
            Status = a.Status,
            EnteredBy = a.EnteredBy,
            TransDate = a.TransDate
        };
        originalDoctorId = a.DoctorID;
        originalDate = a.ApptDate;
        apptDatePart = a.ApptDate.Date;
        apptTimePart = a.ApptDate.ToString("HH:mm");
        if (doctorById.TryGetValue(a.DoctorID, out var dItem) && dItem.Doctor.Department.HasValue)
        {
            selectedDepartmentId = dItem.Doctor.Department.Value;
        }
        else
        {
            selectedDepartmentId = 0;
        }
        patientSearchQuery = ClinicalEncounterWorkflow.IsTempPatientId(a.PatientID) ? string.Empty : (a.PatientID ?? string.Empty);
        isWalkInMode = string.IsNullOrWhiteSpace(a.PatientID) || ClinicalEncounterWorkflow.IsTempPatientId(a.PatientID);
        selectedPatientSex = !string.IsNullOrWhiteSpace(a.PatientID) && patientSexMap.TryGetValue(a.PatientID, out var s) ? s : null;
        PatientSelection.Select(a.PatientID);
        SyncDoctorSearchText();
        showDoctorSuggestions = false;
        message = string.Empty;
