    private void HandleDoctorSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            showDoctorSuggestions = false;
            SyncDoctorSearchText();
        }
        else if (e.Key == "Tab")
        {
            showDoctorSuggestions = false;
        }
        else if (e.Key == "Enter")
        {
            var item = filteredDoctorItems.FirstOrDefault();
            if (item is not null) SelectDoctor(item.Doctor);
        }
    }

    private DateTime apptDatePart = DateTime.Today;
    private string apptTimePart = "17:00";

    private void SyncApptDateTime()
    {
        if (TimeSpan.TryParse(apptTimePart, out var ts))
        {
            editor.ApptDate = apptDatePart.Date.Add(ts);
        }
        else
        {
            editor.ApptDate = apptDatePart.Date.Add(TimeSpan.FromHours(17));
        }
    }

    public static HashSet<DayOfWeek> GetDoctorOffDays(DoctorsProfile? doctor)
    {
        var set = new HashSet<DayOfWeek>();
        if (doctor == null) return set;

        if (!string.IsNullOrWhiteSpace(doctor.OffDay))
        {
            var tokens = doctor.OffDay.Split([',', ';', '/', ' ', '|', '&', '+'], StringSplitOptions.RemoveEmptyEntries);
            foreach (var tok in tokens)
            {
                var cleaned = tok.Trim().ToLowerInvariant();
                if (cleaned.StartsWith("fri")) set.Add(DayOfWeek.Friday);
                else if (cleaned.StartsWith("sat")) set.Add(DayOfWeek.Saturday);
                else if (cleaned.StartsWith("sun")) set.Add(DayOfWeek.Sunday);
                else if (cleaned.StartsWith("mon")) set.Add(DayOfWeek.Monday);
                else if (cleaned.StartsWith("tue")) set.Add(DayOfWeek.Tuesday);
                else if (cleaned.StartsWith("wed")) set.Add(DayOfWeek.Wednesday);
                else if (cleaned.StartsWith("thu")) set.Add(DayOfWeek.Thursday);
            }
            if (set.Count > 0) return set;
        }

        if (!string.IsNullOrWhiteSpace(doctor.ConsultationTime))
        {
            var text = doctor.ConsultationTime.ToLowerInvariant();
            if (text.Contains("off") || text.Contains("except") || text.Contains("closed"))
            {
                if (text.Contains("fri")) set.Add(DayOfWeek.Friday);
                if (text.Contains("sat")) set.Add(DayOfWeek.Saturday);
                if (text.Contains("sun")) set.Add(DayOfWeek.Sunday);
                if (text.Contains("mon")) set.Add(DayOfWeek.Monday);
                if (text.Contains("tue")) set.Add(DayOfWeek.Tuesday);
                if (text.Contains("wed")) set.Add(DayOfWeek.Wednesday);
                if (text.Contains("thu")) set.Add(DayOfWeek.Thursday);
            }
            else if (text.Contains("sat") && text.Contains("thu"))
            {
                set.Add(DayOfWeek.Friday);
            }
            else if (text.Contains("sun") && text.Contains("thu"))
            {
                set.Add(DayOfWeek.Friday);
                set.Add(DayOfWeek.Saturday);
            }
        }

        // Default off day in Bangladesh clinic practice is Friday
        if (set.Count == 0 && doctor.ID > 0)
        {
            set.Add(DayOfWeek.Friday);
        }

        return set;
    }

    public static bool IsDoctorOffDay(DoctorsProfile? doctor, DateTime date)
    {
        if (doctor == null || doctor.ID <= 0) return false;
        var offDays = GetDoctorOffDays(doctor);
        return offDays.Contains(date.DayOfWeek);
    }

    public static string GetDoctorOffDaysDisplay(DoctorsProfile? doctor)
    {
        if (doctor == null) return string.Empty;
        var offDays = GetDoctorOffDays(doctor);
        if (offDays.Count == 0) return "None";
        return string.Join(", ", offDays.Select(d => d.ToString()));
    }

    public static DateTime? GetNextAvailableDoctorDate(DoctorsProfile? doctor, DateTime fromDate)
    {
        if (doctor == null) return null;
        var date = fromDate.Date.AddDays(1);
        for (int i = 0; i < 7; i++)
        {
            if (!IsDoctorOffDay(doctor, date))
            {
                return date;
            }
            date = date.AddDays(1);
        }
        return null;
    }

    private void SwitchToAvailableDate(DateTime date)
    {
        apptDatePart = date.Date;
        OnApptDateChanged();
    }

    private void OnApptDateChanged()
    {
        SyncApptDateTime();
        if (SelectedDoctor != null && IsDoctorOffDay(SelectedDoctor, apptDatePart))
        {
            message = $"🚫 {DoctorDisplayName(SelectedDoctor)} {I18n.T("is OFF on")} {apptDatePart:dddd} ({GetDoctorOffDaysDisplay(SelectedDoctor)}). {I18n.T("Appointments cannot be booked on an off day.")}";
            messageClass = "warning";
        }
        else if (message.Contains(I18n.T("is OFF on")))
        {
            message = string.Empty;
        }
    }

    private void OnApptTimeInputChanged(ChangeEventArgs e)
    {
        apptTimePart = e.Value?.ToString() ?? "00:00";
        SyncApptDateTime();
    }

    private bool IsSlotSelected(TimeSpan slotTime)
    {
        if (TimeSpan.TryParse(apptTimePart, out var curTime))
        {
            return curTime.Hours == slotTime.Hours && Math.Abs(curTime.Minutes - slotTime.Minutes) < 15;
        }
        return false;
    }

    private void SelectDoctor(DoctorsProfile doctor)
    {
        editor.DoctorID = doctor.ID;
        drawerDoctorId = doctor.ID;
        if (doctor.Department.HasValue && doctor.Department.Value > 0)
        {
            selectedDepartmentId = doctor.Department.Value;
        }
        doctorSearchText = $"D{doctor.ID} - {DoctorDisplayName(doctor)}";
        showDoctorSuggestions = false;
        filterByCurrentDoctor = true;
        queuePage = 0;

        if (IsDoctorOffDay(doctor, apptDatePart))
        {
            var nextWorking = GetNextAvailableDoctorDate(doctor, apptDatePart);
            if (nextWorking.HasValue)
            {
                var offName = apptDatePart.ToString("dddd");
                apptDatePart = nextWorking.Value;
                SyncApptDateTime();
                message = $"ℹ️ {DoctorDisplayName(doctor)} {I18n.T("is OFF on")} {offName}. {I18n.T("Date automatically moved to next working day")}: {apptDatePart:ddd, dd MMM yyyy}.";
                messageClass = "info";
            }
        }
        else if (message.Contains(I18n.T("is OFF on")))
        {
            message = string.Empty;
        }

        var slots = GetDoctorAvailableSlots(doctor, apptDatePart);
        if (slots.Any())
        {
            var nowTime = DateTime.Now.TimeOfDay;
            var upcoming = slots.FirstOrDefault(s => apptDatePart.Date > DateTime.Today || s.Time >= nowTime);
            var chosen = upcoming ?? slots.First();
            apptTimePart = chosen.Time.ToString(@"hh\:mm");
            SyncApptDateTime();
        }
    }

    public sealed record DoctorTimeSlot(TimeSpan Time, string Label, int BookedCount);

    public static string GetDoctorConsultationHours(DoctorsProfile? doctor)
    {
        if (doctor is null) return string.Empty;
        if (!string.IsNullOrWhiteSpace(doctor.ConsultationTime))
            return doctor.ConsultationTime.Trim();

        if (!string.IsNullOrWhiteSpace(doctor.Address))
        {
            var addr = doctor.Address.Trim();
            if (addr.Contains("AM", StringComparison.OrdinalIgnoreCase) || addr.Contains("PM", StringComparison.OrdinalIgnoreCase))
                return addr;
        }

        var att = doctor.Attachment?.Trim();
        return att switch
        {
            "Visiting" => "06:00 PM - 09:30 PM (Sat - Thu)",
            "Consultant" => "05:00 PM - 09:00 PM (Sat - Thu)",
            "Permanent" => "09:00 AM - 01:00 PM & 05:00 PM - 08:30 PM",
            "Residential" => "08:00 AM - 02:00 PM & 24/7 On-Call",
            _ => "05:00 PM - 09:00 PM (Sat - Thu)"
        };
    }

    private List<DoctorTimeSlot> GetDoctorAvailableSlots(DoctorsProfile doctor, DateTime date)
    {
        if (IsDoctorOffDay(doctor, date))
        {
            return [];
        }

        var hoursText = GetDoctorConsultationHours(doctor);
        var slotList = new List<TimeSpan>();

        if (hoursText.Contains("AM", StringComparison.OrdinalIgnoreCase))
        {
            slotList.Add(new TimeSpan(9, 30, 0));
            slotList.Add(new TimeSpan(10, 0, 0));
            slotList.Add(new TimeSpan(10, 30, 0));
            slotList.Add(new TimeSpan(11, 0, 0));
            slotList.Add(new TimeSpan(11, 30, 0));
            slotList.Add(new TimeSpan(12, 0, 0));
            slotList.Add(new TimeSpan(12, 30, 0));
        }

        if (hoursText.Contains("PM", StringComparison.OrdinalIgnoreCase) || slotList.Count == 0)
        {
            if (hoursText.Contains("06:00", StringComparison.OrdinalIgnoreCase) && !hoursText.Contains("05:00", StringComparison.OrdinalIgnoreCase))
            {
                slotList.Add(new TimeSpan(18, 0, 0));
                slotList.Add(new TimeSpan(18, 30, 0));
                slotList.Add(new TimeSpan(19, 0, 0));
                slotList.Add(new TimeSpan(19, 30, 0));
                slotList.Add(new TimeSpan(20, 0, 0));
                slotList.Add(new TimeSpan(20, 30, 0));
                slotList.Add(new TimeSpan(21, 0, 0));
            }
            else
            {
                slotList.Add(new TimeSpan(17, 0, 0));
                slotList.Add(new TimeSpan(17, 30, 0));
                slotList.Add(new TimeSpan(18, 0, 0));
                slotList.Add(new TimeSpan(18, 30, 0));
                slotList.Add(new TimeSpan(19, 0, 0));
                slotList.Add(new TimeSpan(19, 30, 0));
                slotList.Add(new TimeSpan(20, 0, 0));
                slotList.Add(new TimeSpan(20, 30, 0));
            }
        }

        var targetDate = date.Date;
        var result = new List<DoctorTimeSlot>(slotList.Count);
        foreach (var ts in slotList)
        {
            var dummyDt = DateTime.Today.Add(ts);
            var label = dummyDt.ToString("hh:mm tt");
            var booked = appointments.Count(a => a.DoctorID == doctor.ID
                && a.ApptDate.Date == targetDate
                && a.ApptDate.Hour == ts.Hours
                && Math.Abs(a.ApptDate.Minute - ts.Minutes) < 15);
            result.Add(new DoctorTimeSlot(ts, label, booked));
        }
        return result;
    }

    private void SetAppointmentTimeSlot(TimeSpan time)
    {
        if (SelectedDoctor != null && IsDoctorOffDay(SelectedDoctor, apptDatePart))
        {
            message = $"🚫 {DoctorDisplayName(SelectedDoctor)} {I18n.T("is OFF on")} {apptDatePart:dddd}. {I18n.T("Slots cannot be selected on an off day.")}";
            messageClass = "warning";
            return;
        }
        apptTimePart = time.ToString(@"hh\:mm");
        SyncApptDateTime();
    }

