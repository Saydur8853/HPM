@page "/pharmacy/stock-control"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.PharmacyOperator)]
@implements IDisposable
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@using System.Data
@using System.Security.Claims
@using HPM.Web.Components.Common

<PageTitle>@I18n.T("Transfer, Issue & Audit") | @Branding.HospitalName</PageTitle>

<div class="pharm-subnav-bar">
    <div>
        <h1 style="margin:0; font-size:20px; font-weight:800; color:#0f172a;">@I18n.T("Store Transfer, Ward Issue & Stock Audit")</h1>
    </div>

    <div class="pharm-tab-pills">
        <button type="button" class="pharm-tab-pill @(activeScreenTab == "movement" && adjustmentType == "Inter-Store Transfer" ? "active" : "")" @onclick='() => SwitchMode("Inter-Store Transfer")'>
            @I18n.T("Store Transfer")
        </button>
        <button type="button" class="pharm-tab-pill @(activeScreenTab == "movement" && adjustmentType == "Issue to Department" ? "active" : "")" @onclick='() => SwitchMode("Issue to Department")'>
            @I18n.T("Ward / Dept Issue")
        </button>
        <button type="button" class="pharm-tab-pill @(activeScreenTab == "movement" && (adjustmentType == "Count Correction" || adjustmentType.Contains("Disposal")) ? "active" : "")" @onclick='() => SwitchMode("Count Correction")'>
            @I18n.T("Count & Disposal")
        </button>
        <button type="button" class="pharm-tab-pill @(activeScreenTab == "audit" ? "active" : "")" @onclick='() => activeScreenTab = "audit"'>
            @I18n.T("Stock Audit") (@audit.Count)
        </button>
    </div>

    <div style="display:flex; gap:6px; align-items:center;">
        <NavLink class="btn btn-ghost btn-sm" href="/pharmacy/stock">&larr; @I18n.T("Stock & Expiry")</NavLink>
        <button class="btn btn-secondary btn-sm" @onclick="Reset">@I18n.T("New Entry")</button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @messageClass" style="margin-bottom:12px;">@message</div>
}

@if (activeScreenTab == "movement")
{
    <div class="module-layout">
        <div class="panel form-panel">
            <div class="panel-heading" style="padding:12px 18px;">
                <h2 style="font-size:15px; margin:0;">
                    @(savedAdjustment == null ? I18n.T(adjustmentType) : $"{I18n.T("Voucher")} #ADJ-{savedAdjustment.ID}")
                </h2>
                @if (savedAdjustment != null)
                {
                    <span class="pill pill-success">@I18n.T("POSTED")</span>
                }
            </div>

            <div class="form-grid">
                <label>
                    <span>@I18n.T("From Store") *</span>
                    <select @bind="storeId" @bind:after="SelectionContextChanged" disabled="@(savedAdjustment != null)">
                        @foreach (var x in stores.Where(x => x.IsActive))
                        {
                            <option value="@x.ID">@x.Name</option>
                        }
                    </select>
                </label>

                @if (adjustmentType == "Inter-Store Transfer")
                {
                    <label>
                        <span>@I18n.T("To Destination Store") *</span>
                        <select @bind="targetStoreId" disabled="@(savedAdjustment != null)">
                            <option value="0">@I18n.T("Select destination store...")</option>
                            @foreach (var x in stores.Where(x => x.IsActive && x.ID != storeId))
                            {
                                <option value="@x.ID">@x.Name</option>
                            }
                        </select>
                    </label>
                }
                else if (adjustmentType == "Issue to Department")
                {
                    <label>
                        <span>@I18n.T("To Ward / Department") *</span>
                        <select @bind="departmentId" @bind:after="DepartmentChanged" disabled="@(savedAdjustment != null)">
                            <option value="0">@I18n.T("Select ward / department...")</option>
                            @foreach (var d in departments)
                            {
                                <option value="@d.ID">@d.Name</option>
                            }
                        </select>
                    </label>
                }
                else
                {
                    <label>
                        <span>@I18n.T("Action Type") *</span>
                        <select @bind="adjustmentType" @bind:after="SelectionContextChanged" disabled="@(savedAdjustment != null)">
                            <option value="Count Correction">@I18n.T("Physical Count Correction")</option>
                            <option value="Damaged Disposal">@I18n.T("Damaged Disposal")</option>
                            <option value="Expired Disposal">@I18n.T("Expired Disposal")</option>
                        </select>
                    </label>
                }

                <label class="span-2">
                    <span>@I18n.T("Note / Reason") *</span>
                    <input type="text" @bind="reason" maxlength="500" placeholder="@I18n.T("Purpose or reference note...")" disabled="@(savedAdjustment != null)" />
                </label>
            </div>

            @if (savedAdjustment == null)
            {
                <div class="form-grid" style="grid-template-columns: 2fr 95px 95px auto; gap:8px; align-items:end;">
                    <div class="pos-typeahead-wrapper">
                        <span style="font-size:12px; font-weight:600; color:#334155; display:block; margin-bottom:4px;">@I18n.T("Search Medicine Batch") *</span>
                        <input type="text"
                               placeholder="@I18n.T("Type medicine or batch #...")"
                               @bind="batchSearchQuery"
                               @bind:event="oninput"
                               @onfocus="() => showBatchDropdown = true" />
                        @if (showBatchDropdown && FilteredAvailableStocks.Any())
                        {
                            <div class="pos-med-dropdown" style="z-index:130;">
                                @foreach (var b in FilteredAvailableStocks)
                                {
                                    <div class="pos-med-item" @onmousedown:preventDefault @onclick="() => SelectBatch(b)">
                                        <div>
                                            <div class="pos-med-name">@MedicineName(b.ServiceID)</div>
                                            <div class="pos-med-sub">Batch: <b>@(b.BatchNo ?? "—")</b> &bull; Exp: @(b.ExpireDate?.ToString("dd MMM yyyy") ?? "—")</div>
                                        </div>
                                        <span class="pos-stock-badge in-stock">@I18n.T("Qty"): @b.Balance.ToString("N0")</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <label>
                        <span>@I18n.T("Current")</span>
                        <input value="@selectedBalance.ToString("N0")" disabled />
                    </label>
                    <label>
                        <span>@LocalizedInputLabel *</span>
                        <InputNumber @bind-Value="enteredQuantity" />
                    </label>
                    <div>
                        <button class="btn btn-secondary" type="button" @onclick="AddLine">+ @I18n.T("Add")</button>
                    </div>
                </div>
            }

            <div class="data-table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@I18n.T("Medicine / Batch")</th>
                            <th class="num">@I18n.T("Before")</th>
                            <th class="num">@I18n.T("Change")</th>
                            <th class="num">@I18n.T("After")</th>
                            <th class="num">@I18n.T("Value")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (lines.Count == 0)
                        {
                            <tr><td colspan="6"><div class="empty-state small">@I18n.T("No batches added yet.")</div></td></tr>
                        }
                        @for (var i = 0; i < lines.Count; i++)
                        {
                            var index = i;
                            var x = lines[i];
                            <tr>
                                <td><b>@MedicineName(x.ServiceID)</b><br /><small class="text-muted">@(x.BatchNo ?? "—") &bull; @(x.ExpireDate?.ToString("dd MMM yyyy") ?? "—")</small></td>
                                <td class="num">@x.BeforeQuantity</td>
                                <td class="num"><b>@x.ChangeQuantity.ToString("+0.##;-0.##;0")</b></td>
                                <td class="num">@x.AfterQuantity</td>
                                <td class="num">@I18n.FormatCurrency(Math.Abs(x.ChangeQuantity * x.UnitCost))</td>
                                <td style="text-align:right;">
                                    @if (savedAdjustment == null)
                                    {
                                        <button class="icon-btn" type="button" @onclick="() => lines.RemoveAt(index)">✕</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="form-actions">
                @if (savedAdjustment == null)
                {
                    <button class="btn btn-primary" @onclick="() => PostAsync(false)" disabled="@isSaving">
                        @(isSaving ? I18n.T("Saving...") : I18n.T("Save"))
                    </button>
                    <button class="btn btn-secondary" @onclick="() => PostAsync(true)" disabled="@isSaving">
                        @I18n.T("Save & Print A4 Voucher")
                    </button>
                }
                else
                {
                    <button class="btn btn-primary" @onclick="PrintAdjustmentAsync">@I18n.T("Print A4 Voucher")</button>
                    <button class="btn btn-secondary" @onclick="Reset">@I18n.T("New Entry")</button>
                }
            </div>
        </div>

        <div class="panel">
            <div class="panel-heading" style="padding:12px 18px;">
                <h2 style="font-size:15px; margin:0;">@I18n.T("Recent Movements") (@history.Count)</h2>
            </div>
            <div class="data-table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@I18n.T("Store")</th>
                            <th>@I18n.T("Type")</th>
                            <th>@I18n.T("Date")</th>
                            <th class="num">@I18n.T("Items")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var x in history)
                        {
                            <tr>
                                <td><b>ADJ-@x.ID</b></td>
                                <td>@StoreName(x.StoreID)</td>
                                <td><span class="pill">@x.AdjustmentType</span></td>
                                <td>@x.TransDate.ToString("dd MMM yy")</td>
                                <td class="num">@x.Items.Count</td>
                                <td style="text-align:right;"><button class="icon-btn" @onclick="() => OpenAdjustment(x.ID)">@I18n.T("View / Print")</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div id="stock-audit-print" class="panel print-a4-sheet">
        <div class="panel-heading" style="padding:12px 18px;">
            <h2 style="font-size:15px; margin:0;">@I18n.T("Stock Audit & Reconciliation")</h2>
            <div style="display:flex; gap:8px;" class="no-print">
                <input style="max-width:240px;" @bind="search" @bind:event="oninput" placeholder="@I18n.T("Search medicine or store...")" />
                <button class="btn btn-secondary btn-sm" @onclick="PrintAuditAsync">@I18n.T("Print A4 Audit")</button>
            </div>
        </div>
        <div class="data-table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>@I18n.T("Medicine / Store")</th>
                        <th class="num">@I18n.T("Opening")</th>
                        <th class="num">@I18n.T("Bought")</th>
                        <th class="num">@I18n.T("Sold")</th>
                        <th class="num">@I18n.T("Sup. Ret")</th>
                        <th class="num">@I18n.T("Cust. Ret")</th>
                        <th class="num">@I18n.T("Adj.")</th>
                        <th class="num">@I18n.T("Expected")</th>
                        <th class="num">@I18n.T("Actual")</th>
                        <th class="num">@I18n.T("Diff")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (FilteredAudit.Count == 0)
                    {
                        <tr><td colspan="10"><div class="empty-state small">@I18n.T("No audit lines found.")</div></td></tr>
                    }
                    @foreach (var x in FilteredAudit)
                    {
                        <tr>
                            <td><b>@x.MedicineName</b><br /><small class="text-muted">@x.StoreName</small></td>
                            <td class="num">@x.Opening.ToString("N0")</td>
                            <td class="num">@x.Received.ToString("N0")</td>
                            <td class="num">@x.Sold.ToString("N0")</td>
                            <td class="num">@x.SupplierReturn.ToString("N0")</td>
                            <td class="num">@x.CustomerRestock.ToString("N0")</td>
                            <td class="num">@x.Adjustments.ToString("+0.##;-0.##;0")</td>
                            <td class="num">@x.Expected.ToString("N0")</td>
                            <td class="num"><b>@x.Actual.ToString("N0")</b></td>
                            <td class="num"><span class="pill @(x.Variance == 0 ? "pill-success" : "pill-danger")">@x.Variance.ToString("+0.##;-0.##;0")</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (savedAdjustment != null)
{
    <!-- Official A4 Transfer / Ward Issue / Adjustment Voucher -->
    <div id="stock-adjustment-print" class="print-sheet panel print-document print-a4-sheet pharm-print-only">
        <PrintDocumentHeader Title="@($"{I18n.T("Pharmacy")} — {savedAdjustment.AdjustmentType}")"
                             SubTitle="@I18n.T("Hospital Pharmacy Inventory")"
                             DocumentNo="@($"ADJ-{savedAdjustment.ID}")"
                             BarcodeCode="@($"ADJ-{savedAdjustment.ID}")" />

        <div class="print-grid">
            <div><span>@I18n.T("Source Store"):</span> <b>@StoreName(savedAdjustment.StoreID)</b></div>
            <div><span>@I18n.T("Date & Time"):</span> <b>@savedAdjustment.TransDate.ToString("dd MMM yyyy hh:mm tt")</b></div>
            <div style="grid-column: span 2;"><span>@I18n.T("Details / Reason"):</span> <b>@savedAdjustment.Reason</b></div>
        </div>

        <table class="data-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>@I18n.T("Medicine")</th>
                    <th>@I18n.T("Batch")</th>
                    <th>@I18n.T("Expiry")</th>
                    <th class="num">@I18n.T("Before")</th>
                    <th class="num">@I18n.T("Change")</th>
                    <th class="num">@I18n.T("After")</th>
                    <th class="num">@I18n.T("Value")</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < lines.Count; i++)
                {
                    var x = lines[i];
                    <tr>
                        <td>@(i + 1)</td>
                        <td><b>@MedicineName(x.ServiceID)</b></td>
                        <td>@(x.BatchNo ?? "—")</td>
                        <td>@(x.ExpireDate?.ToString("dd MMM yyyy") ?? "—")</td>
                        <td class="num">@x.BeforeQuantity</td>
                        <td class="num"><b>@x.ChangeQuantity.ToString("+0.##;-0.##;0")</b></td>
                        <td class="num">@x.AfterQuantity</td>
                        <td class="num">@I18n.FormatCurrency(Math.Abs(x.ChangeQuantity * x.UnitCost))</td>
                    </tr>
                }
            </tbody>
        </table>

        <PrintDocumentFooter Signatures='new string[] { I18n.T("Prepared By"), I18n.T("Received By"), I18n.T("Pharmacy In-Charge") }' />
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    private List<Service> medicines = [];
    private List<MedicineStore> stores = [];
    private List<MedicineStoreBalance> stocks = [];
    private List<MedicineStockAdjustment> history = [];
    private List<AdjustmentLine> lines = [];
    private List<AuditRow> audit = [];
    private List<IpdDepartment> departments = [];
    private Dictionary<int, decimal> stockUnitCosts = [];
    private MedicineStockAdjustment? savedAdjustment;

    private string activeScreenTab = "movement";
    private int storeId = 1, targetStoreId, departmentId, stockId;
    private string adjustmentType = "Inter-Store Transfer", reason = "Inter-Store Stock Transfer", search = "", message = "", messageClass = "success";
    private string batchSearchQuery = "";
    private bool showBatchDropdown;
    private decimal enteredQuantity = 1, selectedBalance;
    private bool isSaving;

    private IEnumerable<MedicineStoreBalance> FilteredAvailableStocks => stocks
        .Where(x => x.MedicineStoreID == storeId && (adjustmentType == "Count Correction" || x.Balance > 0))
        .Where(x => string.IsNullOrWhiteSpace(batchSearchQuery)
            || MedicineName(x.ServiceID).Contains(batchSearchQuery.Trim(), StringComparison.OrdinalIgnoreCase)
            || (x.BatchNo?.Contains(batchSearchQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false))
        .OrderBy(x => MedicineName(x.ServiceID))
        .ThenBy(x => x.ExpireDate)
        .Take(25);

    private string LocalizedInputLabel => adjustmentType switch
    {
        "Count Correction" => I18n.T("Actual Count"),
        "Inter-Store Transfer" => I18n.T("Transfer Qty"),
        "Issue to Department" => I18n.T("Issue Qty"),
        _ => I18n.T("Dispose Qty")
    };

    private decimal CalculatedChange => adjustmentType == "Count Correction" ? enteredQuantity - selectedBalance : -enteredQuantity;
    private List<AuditRow> FilteredAudit => audit.Where(x => string.IsNullOrWhiteSpace(search) || x.MedicineName.Contains(search, StringComparison.OrdinalIgnoreCase) || x.StoreName.Contains(search, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        await LoadAsync();
    }

    protected override void OnParametersSet()
    {
        if (string.Equals(ViewMode, "department-issue", StringComparison.OrdinalIgnoreCase))
            SwitchMode("Issue to Department");
        else if (string.Equals(ViewMode, "transfer", StringComparison.OrdinalIgnoreCase))
            SwitchMode("Inter-Store Transfer");
        else if (string.Equals(ViewMode, "audit", StringComparison.OrdinalIgnoreCase))
            activeScreenTab = "audit";
    }

    private void SwitchMode(string mode)
    {
        activeScreenTab = "movement";
        savedAdjustment = null;
        adjustmentType = mode;
        SelectionContextChanged();
        reason = mode == "Issue to Department" ? "Issued to Department / Ward"
            : mode == "Inter-Store Transfer" ? "Inter-Store Stock Transfer"
            : "";
    }

    private void DepartmentChanged()
    {
        var d = departments.FirstOrDefault(x => x.ID == departmentId);
        if (d != null) reason = $"Issued to: {d.Name}";
    }

    private void SelectBatch(MedicineStoreBalance b)
    {
        stockId = b.ID;
        selectedBalance = b.Balance;
        enteredQuantity = adjustmentType == "Count Correction" ? selectedBalance : 1;
        batchSearchQuery = $"{MedicineName(b.ServiceID)} ({b.BatchNo})";
        showBatchDropdown = false;
    }

    private void SelectionContextChanged()
    {
        stockId = 0;
        batchSearchQuery = "";
        selectedBalance = 0;
        enteredQuantity = 1;
        lines = [];
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => I18n.OnLanguageChanged -= HandleLanguageChanged;

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        medicines = await db.Services.AsNoTracking().Where(x => x.CategoryID == 3).OrderBy(x => x.Name).ToListAsync();
        stores = await db.MedicineStores.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
        if (stores.Count > 0 && !stores.Any(x => x.ID == storeId && x.IsActive))
            storeId = stores.FirstOrDefault(x => x.IsActive)?.ID ?? stores[0].ID;
        stocks = await db.MedicineStoreBalances.AsNoTracking().ToListAsync();
        departments = await db.IpdDepartments.AsNoTracking().OrderBy(x => x.Name).ToListAsync();

        var challanIds = stocks.Where(x => x.MedicineReceivingChallanSubID.HasValue).Select(x => x.MedicineReceivingChallanSubID!.Value).Distinct().ToArray();
        var receivingCosts = challanIds.Length == 0 ? [] : await db.MedicineReceivingChallanItems.AsNoTracking().Where(x => challanIds.Contains(x.ID)).Select(x => new { x.ID, x.BuyRate }).ToListAsync();
        var receivingCostMap = receivingCosts.ToDictionary(x => x.ID, x => x.BuyRate);
        stockUnitCosts = stocks.ToDictionary(x => x.ID, x => x.MedicineReceivingChallanSubID.HasValue && receivingCostMap.TryGetValue(x.MedicineReceivingChallanSubID.Value, out var cost) ? cost : medicines.FirstOrDefault(m => m.ID == x.ServiceID)?.BuyRate ?? 0);
        history = await db.MedicineStockAdjustments.AsNoTracking().Include(x => x.Items).OrderByDescending(x => x.ID).Take(100).ToListAsync();
        await LoadAuditAsync(db);
    }

    private void AddLine()
    {
        var stock = stocks.FirstOrDefault(x => x.ID == stockId);
        if (stock == null) { Fail("Select a medicine batch."); return; }
        if (lines.Any(x => x.StockBalanceID == stock.ID)) { Fail("This batch is already added."); return; }
        var change = CalculatedChange;
        if (change == 0) { Fail("Quantity change cannot be zero."); return; }
        if (stock.Balance + change < 0) { Fail("Quantity exceeds available batch balance."); return; }
        if (adjustmentType == "Expired Disposal" && stock.ExpireDate >= DateTime.Today) { Fail("Only an expired batch can use Expired Disposal."); return; }
        var cost = stockUnitCosts.TryGetValue(stock.ID, out var unitCost) ? unitCost : 0;
        lines.Add(new AdjustmentLine(stock.ID, stock.ServiceID, stock.BatchNo, stock.ExpireDate, stock.Balance, change, stock.Balance + change, cost));
        stockId = 0;
        batchSearchQuery = "";
        selectedBalance = 0;
        enteredQuantity = 1;
        message = "";
    }

    private async Task PostAsync(bool printAfterSave)
    {
        if (storeId <= 0 || lines.Count == 0 || string.IsNullOrWhiteSpace(reason))
        {
            Fail("Store, batch items and reason are required.");
            return;
        }
        if (adjustmentType == "Inter-Store Transfer" && (targetStoreId <= 0 || targetStoreId == storeId))
        {
            Fail("Select a valid destination store.");
            return;
        }

        isSaving = true;
        try
        {
            var uid = await CurrentUserIdAsync();
            var header = await ResilientTransaction.ExecuteAsync(DbFactory, async db =>
            {
                var finalReason = reason.Trim();
                if (adjustmentType == "Inter-Store Transfer")
                    finalReason += $" (To: {StoreName(targetStoreId)})";

                var adjustment = new MedicineStockAdjustment
                {
                    StoreID = storeId,
                    AdjustmentType = adjustmentType,
                    Reason = finalReason,
                    IsPosted = true,
                    EnteredBy = uid,
                    TransDate = DateTime.Now
                };
                db.MedicineStockAdjustments.Add(adjustment);
                await db.SaveChangesAsync();

                foreach (var line in lines)
                {
                    var stock = await db.MedicineStoreBalances.SingleAsync(x => x.ID == line.StockBalanceID);
                    if (stock.MedicineStoreID != storeId || stock.Balance != line.BeforeQuantity)
                        throw new InvalidOperationException($"Stock changed for {MedicineName(line.ServiceID)}; reload before saving.");
                    if (adjustmentType == "Expired Disposal" && stock.ExpireDate >= DateTime.Today)
                        throw new InvalidOperationException("Selected batch is not expired.");

                    stock.Balance = line.AfterQuantity;
                    db.MedicineStockAdjustmentItems.Add(new MedicineStockAdjustmentItem
                    {
                        AdjustmentID = adjustment.ID,
                        StockBalanceID = stock.ID,
                        ServiceID = line.ServiceID,
                        BatchNo = line.BatchNo,
                        ExpireDate = line.ExpireDate,
                        BeforeQuantity = line.BeforeQuantity,
                        ChangeQuantity = line.ChangeQuantity,
                        AfterQuantity = line.AfterQuantity,
                        UnitCost = line.UnitCost
                    });

                    if (adjustmentType == "Inter-Store Transfer" && targetStoreId > 0)
                    {
                        var transferQty = Math.Abs(line.ChangeQuantity);
                        var targetBalance = await db.MedicineStoreBalances.FirstOrDefaultAsync(x =>
                            x.MedicineStoreID == targetStoreId &&
                            x.ServiceID == line.ServiceID &&
                            x.BatchNo == line.BatchNo &&
                            x.ExpireDate == line.ExpireDate);

                        if (targetBalance != null) targetBalance.Balance += transferQty;
                        else db.MedicineStoreBalances.Add(new MedicineStoreBalance
                        {
                            MedicineStoreID = targetStoreId,
                            ServiceID = line.ServiceID,
                            BatchNo = line.BatchNo,
                            ExpireDate = line.ExpireDate,
                            Balance = transferQty,
                            MedicineReceivingChallanSubID = stock.MedicineReceivingChallanSubID
                        });
                    }
                }

                await db.SaveChangesAsync();
                return adjustment;
            }, IsolationLevel.Serializable);

            savedAdjustment = header;
            Success($"Voucher #ADJ-{header.ID} saved.");
            await LoadAsync();

            if (printAfterSave)
            {
                StateHasChanged();
                await Task.Yield();
                await PrintAdjustmentAsync();
            }
        }
        catch (Exception ex)
        {
            Fail($"Failed: {ex.Message}");
        }
        finally { isSaving = false; }
    }

    private async Task OpenAdjustment(long id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        savedAdjustment = await db.MedicineStockAdjustments.AsNoTracking().Include(x => x.Items).SingleAsync(x => x.ID == id);
        storeId = savedAdjustment.StoreID;
        adjustmentType = savedAdjustment.AdjustmentType;
        reason = savedAdjustment.Reason;
        lines = savedAdjustment.Items.Select(x => new AdjustmentLine(x.StockBalanceID, x.ServiceID, x.BatchNo, x.ExpireDate, x.BeforeQuantity, x.ChangeQuantity, x.AfterQuantity, x.UnitCost)).ToList();
        activeScreenTab = "movement";
    }

    private async Task LoadAuditAsync(HpmDbContext db)
    {
        var openings = await db.MedicineStockOpenings.AsNoTracking().ToListAsync();
        var purchaseHeaders = await db.MedicineReceivingChallans.AsNoTracking().ToListAsync();
        var purchaseItems = await db.MedicineReceivingChallanItems.AsNoTracking().ToListAsync();
        var saleHeaders = await db.PharmacyCashMemos.AsNoTracking().ToListAsync();
        var saleItems = await db.PharmacyCashMemoItems.AsNoTracking().ToListAsync();
        var supplierHeaders = await db.MedicineReturns.AsNoTracking().ToListAsync();
        var supplierItems = await db.MedicineReturnItems.AsNoTracking().ToListAsync();
        var customerHeaders = await db.PharmacySalesReturns.AsNoTracking().Where(x => x.IsPosted).ToListAsync();
        var customerItems = await db.PharmacySalesReturnItems.AsNoTracking().Where(x => x.IsRestocked).ToListAsync();
        var adjustmentHeaders = await db.MedicineStockAdjustments.AsNoTracking().Where(x => x.IsPosted).ToListAsync();
        var adjustmentItems = await db.MedicineStockAdjustmentItems.AsNoTracking().ToListAsync();
        var keys = stocks.Select(x => (x.MedicineStoreID, x.ServiceID)).Concat(openings.Select(x => (x.StoreID, x.ServiceID))).Distinct().ToList();
        audit = [];
        foreach (var key in keys)
        {
            var opening = openings.FirstOrDefault(x => x.StoreID == key.Item1 && x.ServiceID == key.Item2);
            var captured = opening?.CapturedAt ?? DateTime.MinValue;
            var purchaseIds = purchaseHeaders.Where(x => x.StoreID == key.Item1 && x.IsPosted && x.TransDate >= captured).Select(x => x.ID).ToHashSet();
            var received = purchaseItems.Where(x => x.ServiceID == key.Item2 && purchaseIds.Contains(x.ChallanNo)).Sum(x => x.Quantity);
            var saleIds = saleHeaders.Where(x => x.BufferStore == key.Item1 && x.TransDate >= captured).Select(x => x.ID).ToHashSet();
            var sold = saleItems.Where(x => x.ServiceID == key.Item2 && saleIds.Contains(x.BillNo)).Sum(x => x.Quantity ?? 0);
            var supplierIds = supplierHeaders.Where(x => x.StoreID == key.Item1 && x.IsPosted && x.TransDate >= captured).Select(x => x.ID).ToHashSet();
            var supplierReturn = supplierItems.Where(x => x.ServiceID == key.Item2 && supplierIds.Contains(x.MedicineReturnID)).Sum(x => x.Quantity);
            var customerIds = customerHeaders.Where(x => x.StoreID == key.Item1 && x.TransDate >= captured).Select(x => x.ID).ToHashSet();
            var customerRestock = customerItems.Where(x => x.ServiceID == key.Item2 && customerIds.Contains(x.SalesReturnID)).Sum(x => x.Quantity);
            var adjustmentIds = adjustmentHeaders.Where(x => x.StoreID == key.Item1 && x.TransDate >= captured).Select(x => x.ID).ToHashSet();
            var adjustments = adjustmentItems.Where(x => x.ServiceID == key.Item2 && adjustmentIds.Contains(x.AdjustmentID)).Sum(x => x.ChangeQuantity);
            var actual = stocks.Where(x => x.MedicineStoreID == key.Item1 && x.ServiceID == key.Item2).Sum(x => x.Balance);
            var expected = (opening?.OpeningBalance ?? 0) + received - sold - supplierReturn + customerRestock + adjustments;
            audit.Add(new AuditRow(MedicineName(key.Item2), StoreName(key.Item1), opening?.OpeningBalance ?? 0, received, sold, supplierReturn, customerRestock, adjustments, expected, actual, actual - expected, captured));
        }
        audit = audit.OrderBy(x => x.MedicineName).ThenBy(x => x.StoreName).ToList();
    }

    private async Task<int> CurrentUserIdAsync()
    {
        var u = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        return int.TryParse(u.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : 1;
    }

    private async Task PrintAdjustmentAsync() => await JS.InvokeVoidAsync("hpm.printElement", "stock-adjustment-print", $"ADJ-{savedAdjustment?.ID}");
    private async Task PrintAuditAsync() => await JS.InvokeVoidAsync("hpm.printElement", "stock-audit-print", "Stock Audit");

    private void Reset()
    {
        savedAdjustment = null;
        storeId = stores.FirstOrDefault(x => x.IsActive)?.ID ?? 1;
        stockId = 0;
        batchSearchQuery = "";
        lines = [];
        enteredQuantity = 1;
        selectedBalance = 0;
        message = "";
    }

    private string MedicineName(int id) => medicines.FirstOrDefault(x => x.ID == id)?.Name ?? "—";
    private string StoreName(int id) => stores.FirstOrDefault(x => x.ID == id)?.Name ?? "—";
    private void Success(string x) { messageClass = "success"; message = x; }
    private void Fail(string x) { messageClass = "danger"; message = x; }

    private sealed record AdjustmentLine(int StockBalanceID, int ServiceID, string? BatchNo, DateTime? ExpireDate, decimal BeforeQuantity, decimal ChangeQuantity, decimal AfterQuantity, decimal UnitCost);
    private sealed record AuditRow(string MedicineName, string StoreName, decimal Opening, decimal Received, decimal Sold, decimal SupplierReturn, decimal CustomerRestock, decimal Adjustments, decimal Expected, decimal Actual, decimal Variance, DateTime CapturedAt);
}
