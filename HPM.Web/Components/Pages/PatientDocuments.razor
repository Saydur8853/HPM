@page "/patient-documents"
@page "/patient-documents/{PatientId}"
@page "/patients/documents"
@page "/patients/documents/{PatientId}"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.Reception + "," + RoleNames.Cashier + "," + RoleNames.Doctor + "," + RoleNames.LabTechnician + "," + RoleNames.Nurse + "," + RoleNames.EmergencyOperator + "," + RoleNames.OTOperator)]
@rendermode InteractiveServer
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject IBarcodeQrService BarcodeQr
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable
@using HPM.Web.Data
@using HPM.Web.Data.Entities
@using HPM.Web.Localization
@using HPM.Web.Services
@using HPM.Web.Components.Common
@using Microsoft.EntityFrameworkCore

<PageTitle>@(selectedPatient != null ? $"{selectedPatient.Name} ({selectedPatient.PatientID})" : I18n.T("Patient 360° Documents Hub")) | @Branding.HospitalName</PageTitle>

<div class="page-heading">
    <div>
        <span class="eyebrow">@I18n.T("Patient 360° Records & Documents", "Patient 360° Records & Documents")</span>
        <h1>@I18n.T("Unified Patient Reports, Receipts & Slips Hub", "Unified Patient Reports, Receipts & Slips Hub")</h1>
        <p>@I18n.T("Centralized one-page repository of all diagnostic reports, money receipts, prescriptions, tickets and IPD bills for any patient.")</p>
    </div>
    <div style="display:flex; gap:8px; align-items:center;">
        @if (selectedPatient != null)
        {
            <button class="btn btn-secondary" @onclick="PrintPatientDossierAsync">
                🖨️ @I18n.T("Print Patient Dossier", "Print Patient Dossier")
            </button>
        }
        <button class="btn btn-ghost" @onclick="ResetSearch">
            🔍 @I18n.T("New Search", "New Search")
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @messageClass">@message</div>
}

<!-- Patient Global Search / Barcode Scan Bar -->
<div class="panel" style="margin-bottom: 20px;">
    <div class="panel-heading">
        <div>
            <h2>@I18n.T("Find Patient Record", "Find Patient Record")</h2>
            <p>@I18n.T("Search by Patient ID (e.g. P-10081), Invoice / Memo #, Mobile Number, or Barcode scan:")</p>
        </div>
    </div>
    <div style="padding: 18px 20px;">
        <div style="display:flex; gap:12px; align-items:center;">
            <div class="scanner-search-group" style="flex:1;">
                <span class="scanner-icon" title="Barcode & QR Scanner Active">📷</span>
                <input type="text"
                       class="scanner-input"
                       placeholder="@I18n.T("Scan Patient QR/Barcode, or type Patient ID (P-10081), Invoice #, Mobile, or Name...", "Scan Patient QR/Barcode, or type Patient ID (P-10081), Invoice #, Mobile, or Name...")"
                       @bind="searchQuery"
                       @bind:event="oninput"
                       @onkeydown="HandleSearchKeyDown" />
                @if (!string.IsNullOrWhiteSpace(searchQuery))
                {
                    <button type="button" class="btn btn-ghost" style="padding: 0 8px; font-size: 11px;" @onclick="() => searchQuery = string.Empty">✕</button>
                }
            </div>
            <button class="btn btn-primary" type="button" @onclick="SearchPatientAsync" disabled="@isLoading">
                @(isLoading ? I18n.T("Loading...", "Loading...") : I18n.T("Search Record ➔", "Search Record ➔"))
            </button>
        </div>

        @if (recentPatients.Count > 0 && selectedPatient == null)
        {
            <div style="margin-top: 14px; display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                <small style="color:#64748b; font-weight:700;">@I18n.T("Recent Patients:", "Recent Patients:"):</small>
                @foreach (var p in recentPatients.Take(6))
                {
                    <button type="button" class="fast-action-pill" @onclick="() => SelectPatientAsync(p.PatientID)">
                        👤 @p.Name (@p.PatientID)
                    </button>
                }
            </div>
        }
    </div>
</div>

@if (isLoading)
{
    <div class="panel" style="text-align:center; padding: 48px 20px;">
        <div class="portal-spinner"></div>
        <h3 style="font-weight:700; color:#0f766e;">@I18n.T("Loading Patient Records & Documents...", "Loading Patient Records & Documents...")</h3>
        <p style="color:#64748b; font-size:13px;">@I18n.T("Compiling diagnostic lab reports, money receipts, prescriptions and IPD history...")</p>
    </div>
}
else if (selectedPatient == null)
{
    <div class="empty-state" style="background:#ffffff; border-radius:14px; border:1px solid var(--line); padding:60px 20px;">
        <div style="font-size:48px; margin-bottom:12px;">📂</div>
        <h3 style="font-size:18px; font-weight:800; color:#0f172a; margin-bottom:6px;">@I18n.T("No Patient Selected", "No Patient Selected")</h3>
        <p style="max-width:500px; margin:0 auto 20px; font-size:13.5px; color:#64748b;">
            @I18n.T("Enter a Patient ID (e.g. P-10081), Invoice #, or Scan Barcode/QR to open their full document portfolio and receipts.")
        </p>
    </div>
}
else
{
    <!-- ================= 1. PATIENT 360° MASTER HEADER & FINANCIAL SUMMARY ================= -->
    <div class="patient-hub-profile-card">
        <div class="patient-hub-top-row">
            <div class="patient-hub-main-info">
                <div class="patient-hub-avatar @(selectedPatient.Sex.ToLowerInvariant() == "female" ? "female" : "")">
                    @(string.IsNullOrWhiteSpace(selectedPatient.Name) ? "PT" : selectedPatient.Name.Substring(0, Math.Min(2, selectedPatient.Name.Length)).ToUpperInvariant())
                </div>
                <div class="patient-hub-details">
                    <h2>@selectedPatient.Name</h2>
                    <div class="patient-hub-chips">
                        <span class="hub-chip primary">🆔 @selectedPatient.PatientID</span>
                        <span class="hub-chip">🎂 @FormatAge(selectedPatient.DateOfBirth) / @selectedPatient.Sex</span>
                        @if (!string.IsNullOrWhiteSpace(selectedPatient.BloodGroup))
                        {
                            <span class="hub-chip blood">🩸 @selectedPatient.BloodGroup</span>
                        }
                    </div>
                    <p class="patient-hub-meta-text">
                        <span>📞 <b>@(selectedPatient.Contact ?? "—")</b></span>
                        <span>🏠 <b>@(string.IsNullOrWhiteSpace(selectedPatient.PresentDistrict) ? "Present Address" : $"{selectedPatient.PresentVillage}, {selectedPatient.PresentDistrict}")</b></span>
                        <span>📅 <b>@I18n.T("Registered"): @selectedPatient.TransDate.ToString("dd MMM yyyy")</b></span>
                    </p>
                </div>
            </div>

            <div style="display:flex; flex-direction:column; align-items:flex-end; gap:8px;">
                <div style="background:#ffffff; padding:4px 8px; border:1px solid #e2e8f0; border-radius:8px;">
                    <BarcodeQrView Code="@($"PAT-{selectedPatient.PatientID}")"
                                   QrPayload="@BarcodeQr.GeneratePatientQrPayload(selectedPatient.ID, selectedPatient.PatientID, selectedPatient.Name, selectedPatient.Contact)"
                                   Layout="stacked"
                                   BarHeight="18"
                                   QrPixelsPerModule="2"
                                   Compact="true" />
                </div>
            </div>
        </div>

        <!-- Financial Summary Ledger Cards -->
        <div class="patient-hub-fin-grid">
            <div class="hub-fin-card accent-blue">
                <span>💳 @I18n.T("Total Billed Amount", "Total Billed Amount")</span>
                <strong>@I18n.FormatCurrency(totalGrossBilled)</strong>
                <small style="color:#64748b; font-size:11px;">@allDocs.Count @I18n.T("services & slips")</small>
            </div>
            <div class="hub-fin-card">
                <span>🎁 @I18n.T("Total Discount Given", "Total Discount Given")</span>
                <strong>@I18n.FormatCurrency(totalDiscount)</strong>
                <small style="color:#64748b; font-size:11px;">@I18n.T("Waiver / Concession")</small>
            </div>
            <div class="hub-fin-card accent-green">
                <span>💰 @I18n.T("Total Paid Amount", "Total Paid Amount")</span>
                <strong>@I18n.FormatCurrency(totalPaid)</strong>
                <small style="color:#15803d; font-size:11px;">@I18n.T("Collected via Cash/Card")</small>
            </div>
            <div class="hub-fin-card @(netDueBalance > 0 ? "accent-red" : "accent-green")">
                <span>⚠️ @I18n.T("Net Due Balance", "Net Due Balance")</span>
                <strong>@I18n.FormatCurrency(netDueBalance)</strong>
                <small style="font-size:11px; font-weight:700; color:@(netDueBalance > 0 ? "#dc2626" : "#15803d");">
                    @(netDueBalance > 0 ? I18n.T("Outstanding Balance", "Outstanding Balance") : I18n.T("All Clear / Fully Paid", "All Clear / Fully Paid"))
                </small>
            </div>
        </div>
    </div>

    <!-- Quick Clinical Actions Bar -->
    <div class="fast-actions-bar" style="margin-bottom: 24px;">
        <span class="prompt">⚡ @I18n.T("Quick Clinical Actions for") <strong>@selectedPatient.Name</strong>:</span>
        <div class="fast-actions-group">
            <a class="fast-action-pill" href="tickets?patientId=@selectedPatient.PatientID"><span>🎫</span> @I18n.T("New Ticket")</a>
            <a class="fast-action-pill" href="appointments?patientId=@selectedPatient.PatientID"><span>📅</span> @I18n.T("Appointment")</a>
            <a class="fast-action-pill" href="diagnostic/billing?patientId=@selectedPatient.PatientID"><span>🔬</span> @I18n.T("Diagnostic Bill")</a>
            <a class="fast-action-pill" href="emergency-services?patientId=@selectedPatient.PatientID"><span>⚡</span> @I18n.T("Emergency Memo")</a>
            <a class="fast-action-pill" href="ipd/admissions?patientId=@selectedPatient.PatientID"><span>🏥</span> @I18n.T("IPD Admission")</a>
            <a class="fast-action-pill" href="pharmacy/pos?patientId=@selectedPatient.PatientID"><span>💊</span> @I18n.T("Pharmacy Sale")</a>
        </div>
    </div>

    <!-- ================= 2. ALL DOCUMENTS & REPORTS NAVIGATION TABS ================= -->
    <div class="patient-docs-nav-tabs">
        <button type="button" class="patient-tab-btn @(activeTab == "All" ? "active" : "")" @onclick="@(() => activeTab = "All")">
            🌐 @I18n.T("All Records & Slips", "All Records & Slips")
            <span class="patient-tab-count">@allDocs.Count</span>
        </button>
        <button type="button" class="patient-tab-btn @(activeTab == "Diagnostic" ? "active" : "")" @onclick="@(() => activeTab = "Diagnostic")">
            🔬 @I18n.T("Diagnostic & Lab Reports", "Diagnostic & Lab Reports")
            <span class="patient-tab-count">@diagnosticMemos.Count</span>
        </button>
        <button type="button" class="patient-tab-btn @(activeTab == "Receipts" ? "active" : "")" @onclick="@(() => activeTab = "Receipts")">
            🧾 @I18n.T("Payment Receipts & Money Slips", "Payment Receipts & Money Slips")
            <span class="patient-tab-count">@receiptDocs.Count</span>
        </button>
        <button type="button" class="patient-tab-btn @(activeTab == "Tickets" ? "active" : "")" @onclick="@(() => activeTab = "Tickets")">
            🎫 @I18n.T("OPD Tickets & Appts", "OPD Tickets & Appts")
            <span class="patient-tab-count">@(opdTickets.Count + appointments.Count)</span>
        </button>
        <button type="button" class="patient-tab-btn @(activeTab == "IPD" ? "active" : "")" @onclick="@(() => activeTab = "IPD")">
            🏥 @I18n.T("IPD Admissions & Discharge", "IPD Admissions & Discharge")
            <span class="patient-tab-count">@admissions.Count</span>
        </button>
        <button type="button" class="patient-tab-btn @(activeTab == "Pharmacy" ? "active" : "")" @onclick="@(() => activeTab = "Pharmacy")">
            💊 @I18n.T("Prescriptions & Pharmacy", "Prescriptions & Pharmacy")
            <span class="patient-tab-count">@(prescriptions.Count + pharmacyMemos.Count)</span>
        </button>
        <button type="button" class="patient-tab-btn @(activeTab == "EmergencyOT" ? "active" : "")" @onclick="@(() => activeTab = "EmergencyOT")">
            ⚡ @I18n.T("Emergency & OT Surgery", "Emergency & OT Surgery")
            <span class="patient-tab-count">@(emergencyMemos.Count + otMemos.Count)</span>
        </button>
    </div>

    <!-- ================= 3. DOCUMENT LIST STREAM ================= -->
    <!-- ================= 3. UNIFIED 1-PAGE PATIENT PORTFOLIO & DOCUMENT STREAM ================= -->
    @if (activeTab == "All")
    {
        <!-- Comprehensive 1-Page Master Patient Dossier & All Reports -->
        <div class="patient-master-dossier" id="printable-patient-dossier">
            <!-- 1. Diagnostic Reports & Lab Findings (Inline Detailed View) -->
            <div class="dossier-card-block">
                <div class="dossier-card-header">
                    <div style="display:flex; align-items:center; gap:8px;">
                        <span class="dossier-header-icon">🔬</span>
                        <h3 style="font-size:15px; font-weight:800; color:#0f766e; margin:0;">
                            @I18n.T("Diagnostic Investigations & Lab Findings", "Diagnostic Investigations & Lab Findings")
                        </h3>
                    </div>
                    <span class="badge" style="background:#e0f2fe; color:#0369a1; font-weight:800;">@diagnosticMemos.Count @I18n.T("Reports")</span>
                </div>

                @if (diagnosticMemos.Count == 0)
                {
                    <div style="padding:16px; color:#64748b; font-size:12.5px;">@I18n.T("No diagnostic orders recorded for this patient.")</div>
                }
                else
                {
                    @foreach (var memo in diagnosticMemos)
                    {
                        var memoResults = labResults.Where(x => x.MemoID == memo.ID).ToList();
                        var netPayable = Math.Max(0, memo.Total - memo.Discount);
                        var due = Math.Max(0, netPayable - memo.Paid);
                        var isAuth = !string.IsNullOrWhiteSpace(memo.Remarks) && memo.Remarks.Contains("[AUTH_RELEASE]");
                        var isPub = memoResults.Count > 0 && memoResults.Any(x => !string.IsNullOrWhiteSpace(x.ResultValue));

                        <div class="dossier-report-sheet-item" style="border: 1px solid #e2e8f0; border-radius: 10px; padding: 16px; margin: 12px; background: #ffffff;">
                            <!-- Report Mini Header with Both Barcode & QR Code -->
                            <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:12px; flex-wrap:wrap; gap:10px;">
                                <div>
                                    <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
                                        <b style="font-size:15px; color:#0f766e;">Invoice #@memo.ID</b>
                                        <span class="doc-badge-pill @(isPub ? (due <= 0.01m ? "verified" : (isAuth ? "auth" : "due")) : "pending")">
                                            @(isPub ? (due <= 0.01m ? "VERIFIED" : (isAuth ? "AUTH RELEASE" : "DUE LOCKED")) : "IN PROGRESS")
                                        </span>
                                    </div>
                                    <small style="color:#64748b;">📅 @memo.TransDate.ToString("dd MMM yyyy — hh:mm tt") &bull; Ref. Doctor: <b>@DoctorName(memo.DoctorID)</b> &bull; Tube: <b>SMP-@memo.ID</b></small>
                                </div>
                                <div style="display:flex; align-items:center; gap:10px;">
                                    <BarcodeQrView Code="@($"LAB-{memo.ID}")"
                                                   QrPayload="@BarcodeQr.GenerateLabQrPayload(memo.ID, memo.PatientID ?? "", memo.PatientName, $"SMP-{memo.ID}", Navigation.BaseUri)"
                                                   Layout="side-by-side"
                                                   BarHeight="24"
                                                   QrPixelsPerModule="2"
                                                   IncludeBarcodeText="true" />
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => OpenDocumentPreview(allDocs.First(d => d.DocKey == memo.ID.ToString()))">
                                        🖨️ @I18n.T("Print A4 Report")
                                    </button>
                                </div>
                            </div>

                            @if (memoResults.Count > 0)
                            {
                                <table class="report-parameter-table" style="font-size:12px; margin-bottom:10px;">
                                    <thead>
                                        <tr>
                                            <th style="width:35%;">@I18n.T("Investigation Parameter")</th>
                                            <th class="text-center" style="width:20%;">@I18n.T("Observed Result")</th>
                                            <th class="text-center" style="width:15%;">@I18n.T("Unit")</th>
                                            <th style="width:20%;">@I18n.T("Reference Range")</th>
                                            <th class="text-center" style="width:10%;">@I18n.T("Status")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in memoResults)
                                        {
                                            var flagClass = (r.Flag ?? "Normal").ToLowerInvariant() switch
                                            {
                                                "high" => "flag-high",
                                                "low" => "flag-low",
                                                "critical" => "flag-critical",
                                                "positive" => "flag-high",
                                                _ => "flag-normal"
                                            };
                                            <tr>
                                                <td class="param-name"><b>@r.ParameterName</b></td>
                                                <td class="text-center"><span class="value-highlight @flagClass">@r.ResultValue</span></td>
                                                <td class="text-center">@(r.Unit ?? "—")</td>
                                                <td>@(r.ReferenceRange ?? "—")</td>
                                                <td class="text-center"><span class="flag-pill @flagClass">@(r.Flag ?? "Normal")</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div class="alert info" style="margin: 8px 0; font-size:12px; padding:8px 12px;">
                                    ⏳ Specimen registered and undergoing pathology analysis. Result verification pending.
                                </div>
                            }

                            <div style="display:flex; justify-content:space-between; align-items:center; background:#f8fafc; padding:8px 12px; border-radius:6px; font-size:12px; border:1px solid #f1f5f9;">
                                <div>Total: <b>@I18n.FormatCurrency(netPayable)</b> &bull; Paid: <b style="color:#15803d;">@I18n.FormatCurrency(memo.Paid)</b></div>
                                <div>Due: <b style="color:@(due > 0 ? "#dc2626" : "#15803d");">@(due > 0 ? I18n.FormatCurrency(due) : "CLEAR")</b></div>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- 2. Payment Receipts & Money Slips Ledger Table -->
            <div class="dossier-card-block" style="margin-top:16px;">
                <div class="dossier-card-header">
                    <div style="display:flex; align-items:center; gap:8px;">
                        <span class="dossier-header-icon">🧾</span>
                        <h3 style="font-size:15px; font-weight:800; color:#0369a1; margin:0;">
                            @I18n.T("Payment Receipts & Money Slips Ledger", "Payment Receipts & Money Slips Ledger")
                        </h3>
                    </div>
                    <span class="badge" style="background:#f0fdf4; color:#15803d; font-weight:800;">@receiptDocs.Count @I18n.T("Receipts")</span>
                </div>

                @if (receiptDocs.Count == 0)
                {
                    <div style="padding:16px; color:#64748b; font-size:12.5px;">@I18n.T("No payment receipts recorded for this patient.")</div>
                }
                else
                {
                    <div class="data-table-wrap">
                        <table class="data-table" style="font-size:12px;">
                            <thead>
                                <tr>
                                    <th>Receipt / Slip #</th>
                                    <th>Particulars</th>
                                    <th>Date</th>
                                    <th class="num">Billed Amount</th>
                                    <th class="num">Discount</th>
                                    <th class="num">Paid Amount</th>
                                    <th class="num">Due Balance</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in receiptDocs)
                                {
                                    <tr>
                                        <td><b>#@r.DocKey</b></td>
                                        <td>@r.Title</td>
                                        <td>@r.Date.ToString("dd MMM yyyy, hh:mm tt")</td>
                                        <td class="num">@I18n.FormatCurrency(r.GrossAmount)</td>
                                        <td class="num">@I18n.FormatCurrency(r.Discount)</td>
                                        <td class="num" style="color:#15803d; font-weight:700;">@I18n.FormatCurrency(r.PaidAmount)</td>
                                        <td class="num" style="color:@(r.DueAmount > 0 ? "#dc2626" : "#15803d"); font-weight:700;">@I18n.FormatCurrency(r.DueAmount)</td>
                                        <td><span class="doc-badge-pill @r.BadgeClass">@r.Status</span></td>
                                        <td>
                                            <button type="button" class="icon-btn" @onclick="() => OpenDocumentPreview(r)">👁️</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- 3. Prescriptions & Clinical Medication Charts -->
            @{
                var allRxDocs = allDocs.Where(x => x.DocType == "Prescription").ToList();
            }
            @if (allRxDocs.Count > 0)
            {
                <div class="dossier-card-block" style="margin-top:16px;">
                    <div class="dossier-card-header">
                        <div style="display:flex; align-items:center; gap:8px;">
                            <span class="dossier-header-icon">💊</span>
                            <h3 style="font-size:15px; font-weight:800; color:#b45309; margin:0;">
                                @I18n.T("Doctor Prescriptions & Clinical Medication Charts", "Doctor Prescriptions & Clinical Medication Charts")
                            </h3>
                        </div>
                        <span class="badge" style="background:#fef3c7; color:#92400e; font-weight:800;">@allRxDocs.Count @I18n.T("Prescriptions")</span>
                    </div>
                    <div style="padding:14px;">
                        @foreach (var doc in allRxDocs)
                        {
                            <div style="border-bottom:1px solid #f1f5f9; padding:12px 0; display:flex; justify-content:space-between; align-items:flex-start; gap:16px; flex-wrap:wrap;">
                                <div style="flex:1;">
                                    <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
                                        <strong style="font-size:14px; color:#0f172a;">@doc.Title</strong>
                                        <span class="doc-badge-pill verified">PRESCRIBED</span>
                                    </div>
                                    <p style="margin:0 0 6px 0; font-size:12px; color:#475569;">@doc.Subtitle &bull; 📅 @doc.Date.ToString("dd MMM yyyy, hh:mm tt")</p>

                                    @if (doc.RawEntity is IpdPrescriptionViewModel ipdRx)
                                    {
                                        <div style="display:flex; gap:6px; flex-wrap:wrap; margin-top:6px;">
                                            @foreach (var m in ipdRx.Medications.Take(8))
                                            {
                                                <span style="background:#f0fdfa; border:1px solid #ccfbf1; border-radius:6px; padding:2px 8px; font-size:11px; color:#0f766e; font-weight:600;">
                                                    💊 @m.MedicineName (Qty: @m.Quantity)
                                                </span>
                                            }
                                            @if (ipdRx.Medications.Count > 8)
                                            {
                                                <span style="background:#f1f5f9; border-radius:6px; padding:2px 6px; font-size:11px; color:#64748b;">
                                                    +@(ipdRx.Medications.Count - 8) more
                                                </span>
                                            }
                                        </div>
                                    }
                                    else if (doc.RawEntity is Prescription p)
                                    {
                                        <div style="display:flex; gap:6px; flex-wrap:wrap; margin-top:6px;">
                                            @if (p.Medicines != null && p.Medicines.Count > 0)
                                            {
                                                @foreach (var m in p.Medicines)
                                                {
                                                    <span style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:6px; padding:2px 8px; font-size:11px; color:#334155; font-weight:600;">
                                                        💊 @ServiceName(m.ServiceID) (Qty: @m.Quantity)
                                                    </span>
                                                }
                                            }
                                            else if (!string.IsNullOrWhiteSpace(p.Medicine))
                                            {
                                                <span style="font-size:11.5px; color:#334155;">💊 @p.Medicine</span>
                                            }
                                        </div>
                                    }
                                </div>
                                <div style="display:flex; gap:8px;">
                                    <button type="button" class="btn btn-primary" style="padding:6px 14px; font-size:12px; font-weight:700;" @onclick="() => OpenDocumentPreview(doc)">
                                        🖨️ @I18n.T("Print A4 Prescription", "Print A4 Prescription")
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- 4. OPD Tickets & IPD Admissions -->
            <div style="display:grid; grid-template-columns: repeat(2, 1fr); gap:16px; margin-top:16px;">
                <div class="dossier-card-block">
                    <div class="dossier-card-header">
                        <div style="display:flex; align-items:center; gap:8px;">
                            <span class="dossier-header-icon">🎫</span>
                            <h3 style="font-size:14px; font-weight:800; color:#0284c7; margin:0;">OPD Tickets</h3>
                        </div>
                        <span class="badge">@opdTickets.Count</span>
                    </div>
                    <div style="padding:12px;">
                        @if (opdTickets.Count == 0)
                        {
                            <small style="color:#94a3b8;">No OPD tickets found.</small>
                        }
                        else
                        {
                            @foreach (var t in opdTickets)
                            {
                                <div style="display:flex; justify-content:space-between; font-size:12px; padding:6px 0; border-bottom:1px solid #f1f5f9;">
                                    <span><b>Ticket #@t.ID</b> &bull; @DoctorName(t.DoctorID)</span>
                                    <b style="color:#059669;">@I18n.FormatCurrency(t.Total) (PAID)</b>
                                </div>
                            }
                        }
                    </div>
                </div>

                <div class="dossier-card-block">
                    <div class="dossier-card-header">
                        <div style="display:flex; align-items:center; gap:8px;">
                            <span class="dossier-header-icon">🏥</span>
                            <h3 style="font-size:14px; font-weight:800; color:#7e22ce; margin:0;">IPD Admissions</h3>
                        </div>
                        <span class="badge">@admissions.Count</span>
                    </div>
                    <div style="padding:12px;">
                        @if (admissions.Count == 0)
                        {
                            <small style="color:#94a3b8;">No inpatient admissions.</small>
                        }
                        else
                        {
                            @foreach (var adm in admissions)
                            {
                                <div style="font-size:12px; padding:6px 0; border-bottom:1px solid #f1f5f9;">
                                    <div><b>Admission Reg #@adm.RegNo</b> &bull; Date: @(adm.AdmissionDate?.ToString("dd MMM yyyy") ?? "—")</div>
                                    <small style="color:#64748b;">Bed: @(adm.BedCabinID.HasValue && adm.BedCabinID > 0 ? $"Bed #{adm.BedCabinID}" : "Assigned") &bull; Status: @(adm.ReleaseDate.HasValue ? "Discharged" : "Active Inpatient")</small>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Categorized Filtered Stream -->
        <div class="patient-docs-list">
            @if (FilteredDocs.Count == 0)
            {
                <div class="empty-state small" style="background:#ffffff; border-radius:12px; border:1px solid var(--line);">
                    @I18n.T("No records found in this category for this patient.")
                </div>
            }
            @foreach (var doc in FilteredDocs)
            {
                <div class="patient-doc-item">
                    <div class="doc-item-left">
                        <div class="doc-type-icon @doc.DocType.ToLowerInvariant()">
                            @GetDocIcon(doc.DocType)
                        </div>
                        <div class="doc-item-content">
                            <div class="doc-item-title">
                                <strong>@doc.Title</strong>
                                <span class="doc-badge-pill @doc.BadgeClass">@doc.Status</span>
                                @if (doc.IsAuthorizedRelease)
                                {
                                    <span class="doc-badge-pill auth">🛡️ @I18n.T("AUTH RELEASE")</span>
                                }
                            </div>
                            <div class="doc-item-sub">
                                <span>📄 @doc.Subtitle</span>
                                <span>📅 @doc.Date.ToString("dd MMM yyyy — hh:mm tt")</span>
                            </div>
                        </div>
                    </div>

                    <div class="doc-item-right">
                        @if (doc.GrossAmount > 0)
                        {
                            <div class="doc-item-financials">
                                <strong>@I18n.FormatCurrency(doc.GrossAmount - doc.Discount)</strong>
                                <small style="color:@(doc.DueAmount > 0 ? "#dc2626" : "#059669"); font-weight:700;">
                                    @(doc.DueAmount > 0 ? $"Due: {I18n.FormatCurrency(doc.DueAmount)}" : "PAID")
                                </small>
                            </div>
                        }

                        <div class="doc-action-btns">
                            <button type="button" class="btn btn-secondary" style="padding: 6px 12px; font-size: 12px;" @onclick="() => OpenDocumentPreview(doc)">
                                👁️ @I18n.T("View")
                            </button>
                            @if (doc.DocType == "Diagnostic")
                            {
                                <a class="btn btn-ghost" style="padding: 6px 10px; font-size: 12px; border:1px solid #cbd5e1;" href="@($"/portal/report/{doc.DocKey}")" target="_blank" title="Open Public Patient Verification QR Portal">
                                    🔗 @I18n.T("Portal")
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

<!-- ================= 4. DOCUMENT PREVIEW & INSTANT PRINT MODAL ================= -->
@if (activeModalDoc != null)
{
    <div class="modal-backdrop" @onclick="CloseDocumentPreview">
        <div class="doc-preview-modal" @onclick:stopPropagation="true">
            <div class="doc-preview-modal-header">
                <div>
                    <h3 style="font-size:16px; font-weight:800; margin:0; color:#0f172a;">@activeModalDoc.Title</h3>
                    <small style="color:#64748b;">@activeModalDoc.Subtitle &bull; @activeModalDoc.Date.ToString("dd MMM yyyy hh:mm tt")</small>
                </div>
                <button type="button" class="icon-btn" @onclick="CloseDocumentPreview">✕</button>
            </div>

            <div class="doc-preview-modal-body" id="doc-modal-printable-content">
