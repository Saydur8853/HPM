    {
        "Diagnostic" => "🔬",
        "Ticket" => "🎫",
        "IPD" => "🏥",
        "Pharmacy" => "💊",
        "Prescription" => "💊",
        "Emergency" => "⚡",
        "OT" => "🔪",
        "Receipt" => "🧾",
        _ => "📄"
    };

    private string FormatAge(DateTime dob)
    {
        var age = DateTime.Today.Year - dob.Year;
        if (dob.Date > DateTime.Today.AddYears(-age)) age--;
        return $"{Math.Max(1, age)} Y";
    }

    private string ServiceName(int id) => services.FirstOrDefault(x => x.ID == id)?.Name ?? $"Test #{id}";
    private string DoctorName(int? id) => doctors.FirstOrDefault(x => x.ID == id)?.Name ?? "Duty Doctor";
    private string? DoctorQualification(int? id) => doctors.FirstOrDefault(x => x.ID == id)?.Degree ?? "MBBS, Specialist Consultant";
    private string? DoctorDesignation(int? id) => doctors.FirstOrDefault(x => x.ID == id)?.Title ?? "Consultant";
    private string? DoctorDeptName(int? id)
    {
        var d = doctors.FirstOrDefault(x => x.ID == id);
        if (d?.Department != null) return DepartmentName(d.Department);
        return "Clinical Medicine";
    }
    private string DepartmentName(int? id) => departments.FirstOrDefault(x => x.ID == id)?.Name ?? "General OPD";
    private string BedName(int? id) => bedCabins.FirstOrDefault(x => x.ID == id)?.Name ?? (id.HasValue && id.Value > 0 ? $"Bed #{id}" : "Assigned Bed");

    private bool IsMedicationService(Service? s)
    {
        if (s == null) return false;
        if (s.TypeID != null || s.GenericID != null || s.SupplierID != null) return true;
        var name = s.Name?.ToLowerInvariant() ?? "";
        return name.Contains("inj") || name.Contains("inf") || name.Contains("tab") || name.Contains("cap") || name.Contains("syp") || name.Contains("drop") || name.Contains("mg") || name.Contains("ml") || name.Contains("saline") || name.Contains("napa") || name.Contains("maxpro") || name.Contains("ceftizone") || name.Contains("amibac") || name.Contains("levoxin") || name.Contains("solution") || name.Contains("cannula") || name.Contains("set");
    }

