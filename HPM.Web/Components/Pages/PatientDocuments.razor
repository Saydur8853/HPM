                            ChiefComplaints="@p.Complain"
                            AdvisedTests="@(SplitAdvisedTests(p.Investigation))"
                            SpecialAdvice="@p.Remark"
                            MedicationItems="@(p.Medicines?.Select(m => new PrescriptionA4PrintSheet.PrescriptionMedItem {
                                MedicineName = ServiceName(m.ServiceID),
                                Quantity = m.Quantity,
                                Dosage = m.Dose != null && m.Dose > 0 ? $"{m.Dose} Dose" : "1 + 0 + 1",
                                Duration = m.Days != null && m.Days > 0 ? $"{m.Days} Days" : "5 Days",
                                Instruction = "As directed"
                            }).ToList() ?? [])" />
                    }
                }
                else
                {
                    <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:24px; text-align:left;">
                        <h4 style="margin:0 0 10px 0; color:#0f172a;">@activeModalDoc.Title</h4>
                        <p style="font-size:13.5px; color:#475569; line-height:1.6;">@activeModalDoc.Subtitle</p>
                        <div style="margin-top:16px; display:flex; gap:20px;">
                            <div><span>Total Amount:</span> <b>@I18n.FormatCurrency(activeModalDoc.GrossAmount)</b></div>
                            <div><span>Paid:</span> <b style="color:#15803d;">@I18n.FormatCurrency(activeModalDoc.PaidAmount)</b></div>
                            <div><span>Due:</span> <b style="color:@(activeModalDoc.DueAmount > 0 ? "#dc2626" : "#15803d");">@I18n.FormatCurrency(activeModalDoc.DueAmount)</b></div>
                        </div>
                        <PrintDocumentFooter />
                    </div>
                }
            </div>

            <div class="doc-preview-modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseDocumentPreview">
                    @I18n.T("Close")
                </button>
                <div style="display:flex; gap:8px;">
                    <button type="button" class="btn btn-primary" @onclick="PrintModalDocumentAsync">
                        🖨️ @I18n.T("Print This Document", "Print This Document")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? PatientId { get; set; }
    [SupplyParameterFromQuery(Name = "patientId")] public string? QueryPatientId { get; set; }

    private Registration? selectedPatient;
    private List<Registration> recentPatients = [];
    private List<CashMemoDInvestigation> diagnosticMemos = [];
    private List<CashMemoDInvestigation> emergencyMemos = [];
    private List<OPDTicket> opdTickets = [];
    private List<DoctorAppointment> appointments = [];
    private List<PatientAdmission> admissions = [];
    private List<IpdMoneyReceipt> ipdReceipts = [];
    private List<IpdFinalBill> ipdFinalBills = [];
    private List<PatientTransaction> ipdTransactions = [];
    private List<Prescription> prescriptions = [];
    private List<PharmacyCashMemo> pharmacyMemos = [];
    private List<CashMemoOT> otMemos = [];
    private List<LabTestResult> labResults = [];
    private List<LabSampleCollection> labSamples = [];
    private List<Service> services = [];
    private List<DoctorsProfile> doctors = [];
    private List<Department> departments = [];
    private List<BedCabin> bedCabins = [];

    private List<UnifiedPatientDoc> allDocs = [];
    private List<UnifiedPatientDoc> receiptDocs = [];

    private string activeTab = "All";
    private string searchQuery = "";
    private bool isLoading = false;
    private string message = "";
    private string messageClass = "info";

    private decimal totalGrossBilled = 0;
    private decimal totalDiscount = 0;
    private decimal totalPaid = 0;
    private decimal netDueBalance = 0;

    private UnifiedPatientDoc? activeModalDoc;

    protected override async Task OnInitializedAsync()
    {
        await LoadRecentPatientsAsync();
        var target = PatientId ?? QueryPatientId;
        if (!string.IsNullOrWhiteSpace(target))
        {
            searchQuery = target;
            await SearchPatientAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var target = PatientId ?? QueryPatientId;
        if (!string.IsNullOrWhiteSpace(target) && (selectedPatient == null || selectedPatient.PatientID != target))
        {
            searchQuery = target;
            await SearchPatientAsync();
        }
    }

    private async Task LoadRecentPatientsAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            recentPatients = await db.Registrations.AsNoTracking()
                .OrderByDescending(x => x.TransDate)
                .Take(10)
                .ToListAsync();
            doctors = await db.Doctors.AsNoTracking().ToListAsync();
            services = await db.Services.AsNoTracking().ToListAsync();
            departments = await db.Departments.AsNoTracking().ToListAsync();
            bedCabins = await db.BedCabins.AsNoTracking().ToListAsync();
        }
        catch { }
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchPatientAsync();
        }
    }

    private async Task SelectPatientAsync(string patientId)
    {
        searchQuery = patientId;
        await SearchPatientAsync();
    }

    private async Task SearchPatientAsync()
    {
        if (string.IsNullOrWhiteSpace(searchQuery)) return;

        isLoading = true;
        message = "";
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var q = searchQuery.Trim();

            // Extract clean string from barcode scanner e.g. PAT-10081, LAB-9
            if (q.StartsWith("PAT-", StringComparison.OrdinalIgnoreCase)) q = q.Substring(4);
            if (q.StartsWith("LAB-", StringComparison.OrdinalIgnoreCase)) q = q.Substring(4);

            var pPrefixed = q.StartsWith("P-", StringComparison.OrdinalIgnoreCase) ? q : $"P-{q}";
            var pStripped = q.StartsWith("P-", StringComparison.OrdinalIgnoreCase) ? q.Substring(2) : q;

            // 1. Search in master Registrations
            selectedPatient = await db.Registrations.AsNoTracking()
                .FirstOrDefaultAsync(x => x.PatientID == q || x.PatientID == pPrefixed || x.PatientID == pStripped ||
                                          x.Contact == q || (x.Contact != null && x.Contact.EndsWith(q)) ||
                                          (q.Length >= 3 && x.Name.ToLower().Contains(q.ToLower())) ||
                                          x.ID.ToString() == q);

            // 2. If not found in registration, check if it's a diagnostic memo # or ticket
            if (selectedPatient == null && long.TryParse(pStripped, out var numericId))
            {
                var memo = await db.EmergencyMemos.AsNoTracking().FirstOrDefaultAsync(x => x.ID == numericId);
                if (memo != null)
                {
                    if (!string.IsNullOrWhiteSpace(memo.PatientID))
                    {
                        var mPid = memo.PatientID;
                        selectedPatient = await db.Registrations.AsNoTracking()
                            .FirstOrDefaultAsync(x => x.PatientID == mPid || x.PatientID == $"P-{mPid}");
                    }

                    if (selectedPatient == null)
                    {
                        // Create virtual patient card from memo demographics
                        selectedPatient = new Registration
                        {
                            ID = 0,
                            PatientID = memo.PatientID ?? $"MEMO-{memo.ID}",
                            Name = memo.PatientName,
                            Sex = memo.Sex ?? "Male",
                            Contact = memo.Contact,
                            TransDate = memo.TransDate
                        };
                    }
                }
            }

            if (selectedPatient == null)
            {
                message = I18n.IsBangla
                    ? $"'{searchQuery}' দিয়ে কোনো রোগীর ফাইল বা রেকর্ড পাওয়া যায়নি।"
                    : $"No patient record found matching '{searchQuery}'.";
                messageClass = "danger";
                isLoading = false;
                return;
            }

            // Load All Patient Documents Across Hospital
            await LoadAllPatientDocumentsAsync(selectedPatient, db);
        }
        catch (Exception ex)
        {
            message = $"Error loading records: {ex.Message}";
            messageClass = "danger";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadAllPatientDocumentsAsync(Registration pat, HpmDbContext db)
    {
        var pid = pat.PatientID;
        var pName = pat.Name;
        var contact = pat.Contact;

        // 1. Diagnostic Invoices & Lab Memos (ModuleID 2 or 11)
        diagnosticMemos = await db.EmergencyMemos.Include(x => x.Items).AsNoTracking()
            .Where(x => (x.ModuleID == 2 || x.ModuleID == 11) &&
                        ((pid != null && x.PatientID == pid) || x.PatientName == pName || (contact != null && x.Contact == contact)))
            .OrderByDescending(x => x.TransDate)
            .ToListAsync();

        var memoIds = diagnosticMemos.Select(x => x.ID).ToList();

        // 2. Lab Results & Sample status
        labResults = await db.LabTestResults.AsNoTracking().Where(x => memoIds.Contains(x.MemoID)).ToListAsync();
        labSamples = await db.LabSampleCollections.AsNoTracking().Where(x => memoIds.Contains(x.MemoID)).ToListAsync();

        // 3. Emergency Memos (ModuleID 1 or others)
        emergencyMemos = await db.EmergencyMemos.Include(x => x.Items).AsNoTracking()
            .Where(x => (x.ModuleID == 1 || (x.ModuleID != 2 && x.ModuleID != 11)) &&
                        ((pid != null && x.PatientID == pid) || x.PatientName == pName || (contact != null && x.Contact == contact)))
            .OrderByDescending(x => x.TransDate)
            .ToListAsync();

        // 4. OPD Consultation Tickets
        opdTickets = await db.OPDTickets.AsNoTracking()
            .Where(x => x.Name == pName)
            .OrderByDescending(x => x.TransDate)
            .ToListAsync();

        // 5. Appointments
        appointments = await db.DoctorAppointments.AsNoTracking()
            .Where(x => (pid != null && x.PatientID == pid) || x.Name == pName || (contact != null && x.ContactNo == contact))
            .OrderByDescending(x => x.ApptDate)
            .ToListAsync();

        // 6. IPD Inpatient Admissions
        admissions = await db.PatientAdmissions.AsNoTracking()
            .Where(x => pid != null && x.PatientID == pid)
            .OrderByDescending(x => x.AdmissionDate)
            .ToListAsync();

        var regNos = admissions.Select(x => x.RegNo).ToList();
        ipdReceipts = await db.IpdMoneyReceipts.AsNoTracking().Where(x => regNos.Contains(x.RegNo)).ToListAsync();
        ipdFinalBills = await db.IpdFinalBills.AsNoTracking().Where(x => regNos.Contains(x.RegNo)).ToListAsync();
        ipdTransactions = await db.PatientTransactions.AsNoTracking()
            .Where(x => regNos.Contains(x.RegNo))
            .OrderBy(x => x.TransDate)
            .ToListAsync();

        // 7. Pharmacy Prescriptions & Sales
        prescriptions = await db.Prescriptions.Include(x => x.Medicines).AsNoTracking()
            .Where(x => x.Name == pName)
            .OrderByDescending(x => x.VisitDate)
            .ToListAsync();

        pharmacyMemos = await db.PharmacyCashMemos.Include(x => x.Items).AsNoTracking()
            .Where(x => x.Name == pName || (contact != null && x.Contact == contact))
            .OrderByDescending(x => x.TransDate)
            .ToListAsync();

        // 8. OT Surgery Cash Memos
        otMemos = await db.OTCashMemos.Include(x => x.Items).AsNoTracking()
            .Where(x => (pid != null && x.PatientID == pid) || x.PatientName == pName || (contact != null && x.Contact == contact))
            .OrderByDescending(x => x.TransDate)
            .ToListAsync();

        // Compile Unified Document Stream
        CompileUnifiedDocuments();
    }

    private void CompileUnifiedDocuments()
    {
        allDocs.Clear();
        receiptDocs.Clear();
        totalGrossBilled = 0;
        totalDiscount = 0;
        totalPaid = 0;

        // 1. Diagnostic Documents
        foreach (var m in diagnosticMemos)
        {
            var net = Math.Max(0, m.Total - m.Discount);
            var due = Math.Max(0, net - m.Paid);
            var isAuth = !string.IsNullOrWhiteSpace(m.Remarks) && m.Remarks.Contains("[AUTH_RELEASE]");
            var mResults = labResults.Where(x => x.MemoID == m.ID).ToList();
            var isPub = mResults.Count > 0 && mResults.Any(x => !string.IsNullOrWhiteSpace(x.ResultValue));

            totalGrossBilled += m.Total;
            totalDiscount += m.Discount;
            totalPaid += m.Paid;

            var testNames = string.Join(", ", m.Items.Select(i => ServiceName(i.TestID)));
            if (string.IsNullOrWhiteSpace(testNames)) testNames = "Diagnostic Investigation";

            var doc = new UnifiedPatientDoc
            {
                DocKey = m.ID.ToString(),
                DocType = "Diagnostic",
                Title = $"Diagnostic Report #{m.ID} — {testNames}",
                Subtitle = $"Tests: {m.Items.Count} item(s) &bull; Ref Doctor: {DoctorName(m.DoctorID)}",
                Date = m.TransDate,
                GrossAmount = m.Total,
                Discount = m.Discount,
                PaidAmount = m.Paid,
                DueAmount = due,
                Status = isPub ? (due <= 0.01m ? "Report Verified" : (isAuth ? "Auth Released" : "Due Locked")) : "In Progress",
                BadgeClass = isPub ? (due <= 0.01m ? "verified" : (isAuth ? "auth" : "due")) : "pending",
                IsVerified = isPub,
                IsPublished = isPub,
                IsAuthorizedRelease = isAuth,
                RawEntity = m
            };
            allDocs.Add(doc);

            // Also add to Receipts list
            receiptDocs.Add(new UnifiedPatientDoc
            {
                DocKey = $"REC-DX-{m.ID}",
                DocType = "Receipt",
                Title = $"Diagnostic Money Receipt #{m.ID}",
                Subtitle = $"Test Invoice &bull; Paid: {I18n.FormatCurrency(m.Paid)} &bull; Due: {I18n.FormatCurrency(due)}",
                Date = m.TransDate,
                GrossAmount = m.Total,
                Discount = m.Discount,
                PaidAmount = m.Paid,
                DueAmount = due,
                Status = due <= 0.01m ? "PAID" : "DUE",
                BadgeClass = due <= 0.01m ? "paid" : "due",
                RawEntity = m
            });
        }

        // 2. OPD Tickets
        foreach (var t in opdTickets)
        {
            totalGrossBilled += t.Total;
            totalPaid += t.Total;

            var doc = new UnifiedPatientDoc
            {
                DocKey = t.ID.ToString(),
                DocType = "Ticket",
                Title = $"Consultation Ticket #{t.ID} — {DoctorName(t.DoctorID)}",
                Subtitle = $"Room: {t.Room ?? "OPD"} &bull; Dept: {DepartmentName(t.DeptID)}",
                Date = t.TransDate,
                GrossAmount = t.Total,
                Discount = 0,
                PaidAmount = t.Total,
                DueAmount = 0,
                Status = "Issued / Paid",
                BadgeClass = "paid",
                RawEntity = t
            };
            allDocs.Add(doc);
            receiptDocs.Add(doc);
        }

        // 3. Doctor Appointments
        foreach (var a in appointments)
        {
            allDocs.Add(new UnifiedPatientDoc
            {
                DocKey = $"APT-{a.ID}",
                DocType = "Ticket",
                Title = $"Doctor Appointment Serial #{a.ApptSLNO} — {DoctorName(a.DoctorID)}",
                Subtitle = $"Appointment Date: {a.ApptDate:dd MMM yyyy} &bull; Contact: {a.ContactNo}",
                Date = a.ApptDate,
                GrossAmount = 0,
                PaidAmount = 0,
                DueAmount = 0,
                Status = "Scheduled",
                BadgeClass = "pending",
                RawEntity = a
            });
        }

        // 4. IPD Inpatient Admissions & Bills
        foreach (var adm in admissions)
        {
            var finalBill = ipdFinalBills.FirstOrDefault(x => x.RegNo == adm.RegNo);
            var gross = finalBill?.GrossAmount ?? (adm.AdmissionFee ?? 0);
            var disc = finalBill?.DiscountAmount ?? 0;
            var paid = finalBill?.AppliedAdvanceAmount ?? (adm.AdmissionFee ?? 0);
            var due = finalBill?.BalanceDue ?? 0;

            totalGrossBilled += gross;
            totalDiscount += disc;
            totalPaid += paid;

            var doc = new UnifiedPatientDoc
            {
                DocKey = $"IPD-{adm.ID}",
                DocType = "IPD",
                Title = $"Inpatient Admission #{adm.ID} (Reg: {adm.RegNo})",
                Subtitle = $"Diagnosis: {adm.Diagnosis ?? "Clinical observation"} &bull; Bed: {BedName(adm.BedCabinID)} &bull; Discharged: {(adm.ReleaseDate.HasValue ? adm.ReleaseDate.Value.ToString("dd MMM yyyy") : "Admitted Active")}",
                Date = adm.AdmissionDate ?? adm.TransDate ?? DateTime.Now,
                GrossAmount = gross,
                Discount = disc,
                PaidAmount = paid,
                DueAmount = due,
                Status = adm.ReleaseDate.HasValue ? "Discharged" : "Admitted Active",
                BadgeClass = adm.ReleaseDate.HasValue ? "verified" : "paid",
                RawEntity = adm
            };
            allDocs.Add(doc);

            // Add IPD Money Receipts
            foreach (var r in ipdReceipts.Where(x => x.RegNo == adm.RegNo))
            {
                receiptDocs.Add(new UnifiedPatientDoc
                {
                    DocKey = $"IPD-REC-{r.ID}",
                    DocType = "Receipt",
                    Title = $"IPD Inpatient Receipt #{r.ID} ({r.Against})",
                    Subtitle = $"Reg #{adm.RegNo} &bull; Amount: {I18n.FormatCurrency(r.Amount)}",
                    Date = r.TransDate,
                    GrossAmount = r.Amount,
                    PaidAmount = r.Amount,
                    DueAmount = 0,
                    Status = "PAID",
                    BadgeClass = "paid",
                    RawEntity = r
                });
            }

            // Build IPD Prescription & Medication Chart for this admission
            var admTx = ipdTransactions.Where(x => x.RegNo == adm.RegNo).ToList();
            var admMeds = new List<PrescriptionA4PrintSheet.PrescriptionMedItem>();
            var admTests = new List<string>();

            foreach (var tx in admTx)
            {
                var s = services.FirstOrDefault(x => x.ID == tx.ServiceID);
                if (IsMedicationService(s))
                {
                    admMeds.Add(new PrescriptionA4PrintSheet.PrescriptionMedItem
                    {
                        MedicineName = s?.Name ?? $"Medicine #{tx.ServiceID}",
                        Quantity = tx.Quantity,
                        Dosage = "Daily IV / Routine Dose",
                        Duration = "Bed Stay",
                        Instruction = "Administered by Nursing Staff"
                    });
                }
                else if (s?.InvestigationModuleID != null || (s?.CategoryID != null && s.CategoryID == 2))
                {
                    if (s?.Name != null && !admTests.Contains(s.Name))
                    {
                        admTests.Add(s.Name);
                    }
                }
            }

            allDocs.Add(new UnifiedPatientDoc
            {
                DocKey = $"RX-IPD-{adm.RegNo}",
                DocType = "Prescription",
                Title = $"Inpatient Clinical Medication & Treatment Chart — {DoctorName(adm.Consultant)}",
                Subtitle = $"Reg #{adm.RegNo} &bull; Bed: {BedName(adm.BedCabinID)} &bull; {admMeds.Count} medication(s) prescribed",
                Date = adm.AdmissionDate ?? adm.TransDate ?? DateTime.Now,
                GrossAmount = 0,
                PaidAmount = 0,
                DueAmount = 0,
                Status = "Prescribed",
                BadgeClass = "verified",
                RawEntity = new IpdPrescriptionViewModel
                {
                    Admission = adm,
                    DoctorName = DoctorName(adm.Consultant),
                    BedName = BedName(adm.BedCabinID),
                    Medications = admMeds,
                    AdvisedTests = admTests
                }
            });
        }

        // 5. Prescriptions & Pharmacy Cash Memos
        foreach (var p in prescriptions)
        {
            var medCount = p.Medicines?.Count ?? 0;
            allDocs.Add(new UnifiedPatientDoc
            {
                DocKey = $"RX-{p.ID}",
                DocType = "Prescription",
                Title = $"Clinical Prescription #{p.ID} — {DoctorName(p.ReferredBy)}",
                Subtitle = $"{medCount} medicine(s) prescribed &bull; Diagnosis: {p.Diagnosis ?? "Consultation"}",
                Date = p.VisitDate ?? DateTime.Now,
                GrossAmount = 0,
                PaidAmount = 0,
                DueAmount = 0,
                Status = "Prescribed",
                BadgeClass = "verified",
                RawEntity = p
            });
        }

        foreach (var ph in pharmacyMemos)
        {
            var gross = ph.Total ?? 0;
            var disc = ph.Discount ?? 0;
            var net = Math.Max(0, gross - disc);
            var paid = (ph.IsCredit == true) ? 0 : net;
            var due = Math.Max(0, net - paid);
            totalGrossBilled += gross;
            totalDiscount += disc;
            totalPaid += paid;

            var doc = new UnifiedPatientDoc
            {
                DocKey = $"PH-MEMO-{ph.ID}",
                DocType = "Pharmacy",
                Title = $"Pharmacy Cash Memo #{ph.ID}",
                Subtitle = $"Medicines: {ph.Items.Count} item(s) &bull; Reg: {ph.RegNo ?? "Walk-in"}",
                Date = ph.TransDate,
                GrossAmount = gross,
                Discount = disc,
                PaidAmount = paid,
                DueAmount = due,
                Status = due <= 0.01m ? "PAID" : "DUE",
                BadgeClass = due <= 0.01m ? "paid" : "due",
                RawEntity = ph
            };
            allDocs.Add(doc);
            receiptDocs.Add(doc);
        }

        // 6. Emergency & OT Memos
        foreach (var em in emergencyMemos)
        {
            var net = Math.Max(0, em.Total - em.Discount);
            var due = Math.Max(0, net - em.Paid);
            totalGrossBilled += em.Total;
            totalDiscount += em.Discount;
            totalPaid += em.Paid;

            var doc = new UnifiedPatientDoc
            {
                DocKey = $"EM-{em.ID}",
                DocType = "Emergency",
                Title = $"Emergency Care Memo #{em.ID}",
                Subtitle = $"Procedures: {em.Items.Count} item(s) &bull; Doctor: {DoctorName(em.DoctorID)}",
                Date = em.TransDate,
                GrossAmount = em.Total,
                Discount = em.Discount,
                PaidAmount = em.Paid,
                DueAmount = due,
                Status = due <= 0.01m ? "PAID" : "DUE",
                BadgeClass = due <= 0.01m ? "paid" : "due",
                RawEntity = em
            };
            allDocs.Add(doc);
            receiptDocs.Add(doc);
        }

        foreach (var ot in otMemos)
        {
            var net = Math.Max(0, ot.Total - ot.Discount);
            var paid = net;
            var due = 0m;
            totalGrossBilled += ot.Total;
            totalDiscount += ot.Discount;
            totalPaid += paid;

            var doc = new UnifiedPatientDoc
            {
                DocKey = $"OT-{ot.ID}",
                DocType = "OT",
                Title = $"OT Surgery Cash Memo #{ot.ID}",
                Subtitle = $"Surgeon: {DoctorName(ot.DoctorID)} &bull; Items: {ot.Items.Count}",
                Date = ot.TransDate,
                GrossAmount = ot.Total,
                Discount = ot.Discount,
                PaidAmount = paid,
                DueAmount = due,
                Status = "PAID",
                BadgeClass = "paid",
                RawEntity = ot
            };
            allDocs.Add(doc);
            receiptDocs.Add(doc);
        }

        // Sort all by Date Descending
        allDocs = allDocs.OrderByDescending(x => x.Date).ToList();
        receiptDocs = receiptDocs.OrderByDescending(x => x.Date).ToList();
        netDueBalance = Math.Max(0, (totalGrossBilled - totalDiscount) - totalPaid);
    }

    private List<UnifiedPatientDoc> FilteredDocs => activeTab switch
    {
        "Diagnostic" => allDocs.Where(x => x.DocType == "Diagnostic").ToList(),
        "Receipts" => receiptDocs,
        "Tickets" => allDocs.Where(x => x.DocType == "Ticket").ToList(),
        "IPD" => allDocs.Where(x => x.DocType == "IPD" || (x.DocType == "Prescription" && x.DocKey.StartsWith("RX-IPD"))).ToList(),
        "Pharmacy" => allDocs.Where(x => x.DocType == "Pharmacy" || x.DocType == "Prescription").ToList(),
        "EmergencyOT" => allDocs.Where(x => x.DocType == "Emergency" || x.DocType == "OT").ToList(),
        _ => allDocs
    };

