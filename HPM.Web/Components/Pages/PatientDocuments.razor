                            RegNo="@ipdRx.Admission.RegNo"
                            BedName="@ipdRx.BedName"
                            Age="@(ipdRx.Admission.Age ?? FormatAge(selectedPatient?.DateOfBirth ?? DateTime.Today))"
                            Sex="@(selectedPatient?.Sex ?? "—")"
                            BloodGroup="@selectedPatient?.BloodGroup"
                            ContactNo="@selectedPatient?.Contact"
                            PrescriptionDate="@(ipdRx.Admission.AdmissionDate ?? ipdRx.Admission.TransDate)"
                            DoctorName="@ipdRx.DoctorName"
                            DoctorQualification="@DoctorQualification(ipdRx.Admission.Consultant)"
                            DoctorDesignation="@DoctorDesignation(ipdRx.Admission.Consultant)"
                            DepartmentName="@DepartmentName(ipdRx.Admission.Department)"
                            Diagnosis="@ipdRx.Admission.Diagnosis"
                            ChiefComplaints="@ipdRx.Admission.Comments"
                            AdvisedTests="@ipdRx.AdvisedTests"
                            MedicationItems="@ipdRx.Medications" />
                    }
                    else if (activeModalDoc.RawEntity is Prescription p)
                    {
                        <PrescriptionA4PrintSheet
                            Title="@I18n.T("PRESCRIPTION", "PRESCRIPTION")"
                            DocNo="@($"RX-{p.ID}")"
                            BarcodeCode="@($"RX-{p.ID}")"
                            PatientName="@selectedPatient?.Name"
                            PatientId="@selectedPatient?.PatientID"
                            Age="@FormatAge(selectedPatient?.DateOfBirth ?? DateTime.Today)"
                            Sex="@(selectedPatient?.Sex ?? "—")"
                            BloodGroup="@selectedPatient?.BloodGroup"
                            ContactNo="@selectedPatient?.Contact"
                            PrescriptionDate="@(p.VisitDate ?? DateTime.Now)"
