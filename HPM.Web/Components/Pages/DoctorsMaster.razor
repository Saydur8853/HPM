@page "/masters/doctors"
@attribute [Authorize(Roles = RoleNames.Administrator)]
@rendermode InteractiveServer
@implements IDisposable
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject IJSRuntime JS
@using System.Text
@using System.Text.RegularExpressions

<PageTitle>@I18n.T("Doctors Directory & Priority Setup") | @Branding.HospitalName</PageTitle>

<div class="doc-master-page doc-master-classic-fit">
    <!-- Top Action & Statistics Bar -->
    <div class="doc-master-header">
        <div class="doc-master-title-col">
            <a class="doc-back-link" href="masters">← @I18n.T("Master Setup")</a>
            <h1 class="doc-master-heading">
                <span>🩺 @I18n.T("Doctors Directory & Priority Setup")</span>
            </h1>
        </div>

        <div class="doc-header-stats">
            <div class="doc-stat-pill">
                <span class="stat-label">@I18n.T("Total"):</span>
                <span class="stat-value">@doctors.Count</span>
            </div>
            <div class="doc-stat-pill active-pill">
                <span class="stat-label">@I18n.T("Active"):</span>
                <span class="stat-value">@doctors.Count(x => x.IsActive)</span>
            </div>
            <div class="doc-stat-pill inactive-pill">
                <span class="stat-label">@I18n.T("Inactive"):</span>
                <span class="stat-value">@doctors.Count(x => !x.IsActive)</span>
            </div>
            <div class="doc-stat-pill priority-pill">
                <span class="stat-label">⭐ @I18n.T("Prioritized"):</span>
                <span class="stat-value">@doctors.Count(x => x.Priority.HasValue && x.Priority > 0)</span>
            </div>
            <button type="button" class="btn btn-secondary doc-btn" @onclick="Reset">
                + @I18n.T("New Doctor")
            </button>
            <button type="button" class="btn btn-secondary doc-btn doc-btn-excel" @onclick="ExportExcelAsync" title="@I18n.T("Download Doctors List as Excel (CSV)")">
                📊 @I18n.T("Excel")
            </button>
            <button type="button" class="btn btn-secondary doc-btn doc-btn-print" @onclick="PrintListAsync" title="@I18n.T("Print or Save as PDF")">
                🖨️ @I18n.T("Print / PDF")
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="doc-alert @messageClass">
            <span>@(messageClass == "success" ? "✓" : "⚠")</span>
            <span>@message</span>
            <button type="button" class="doc-alert-close" @onclick='() => message = string.Empty'>✕</button>
        </div>
    }

    <!-- Main Balanced Grid -->
    <div class="doc-master-grid">
        <!-- Left Column: Add / Edit Form -->
        <div class="doc-card doc-form-card">
            <div class="doc-card-header">
                <div>
                    <h2>@(editor.ID == 0 ? I18n.T("Add Consultant Doctor") : $"{I18n.T("Edit Doctor")} #{editor.ID}")</h2>
                </div>
                @if (editor.ID > 0)
                {
                    <span class="doc-status-badge @(editor.IsActive ? "active" : "inactive")">
                        @(editor.IsActive ? I18n.T("Active") : I18n.T("Inactive"))
                    </span>
                }
            </div>

            <EditForm Model="editor" OnSubmit="SaveAsync" class="doc-form-body">
                <div class="doc-form-fields">
                    <!-- Row 1: Title & Doctor Name -->
                    <div class="doc-row doc-row-title-name">
                        <div class="doc-field doc-title-field">
                            <label class="doc-label">@I18n.T("Title")</label>
                            <InputText class="classic-input" @bind-Value="editor.Title" placeholder="Dr." />
                        </div>
                        <div class="doc-field doc-name-field">
                            <label class="doc-label">
                                <span>@I18n.T("Doctor Name")</span>
                                <span class="req">*</span>
                            </label>
                            <InputText class="classic-input" @bind-Value="editor.Name" placeholder="@I18n.T("e.g. Md. Rafiqul Islam")" />
                        </div>
                    </div>

                    <!-- Row 2: Doctor Type / Attachment & Degree -->
                    <div class="doc-row">
                        <div class="doc-field" style="flex: 1; min-width: 0;">
                            <label class="doc-label">@I18n.T("Doctor Category / Type")</label>
                            <InputSelect class="classic-input" @bind-Value="editor.Attachment">
                                <option value="Permanent">@I18n.T("Permanent Doctor")</option>
                                <option value="Residential">@I18n.T("Residential Doctor")</option>
                                <option value="Contractual">@I18n.T("Contractual Doctor")</option>
                                <option value="Visiting">@I18n.T("Visiting / Guest Doctor")</option>
                                <option value="Consultant">@I18n.T("Consultant Doctor")</option>
                                <option value="Temporary">@I18n.T("Temporary Doctor")</option>
                            </InputSelect>
                        </div>
                        <div class="doc-field" style="flex: 1.1; min-width: 0;">
                            <label class="doc-label">@I18n.T("Qualifications / Degree")</label>
                            <InputText class="classic-input" @bind-Value="editor.Degree" placeholder="@I18n.T("e.g. MBBS, FCPS, MD")" />
                        </div>
                    </div>

                    <!-- Row 3: Department & Room -->
                    <div class="doc-row">
                        <div class="doc-field" style="flex: 1.3; min-width: 0;">
                            <label class="doc-label">@I18n.T("Department")</label>
                            <InputSelect class="classic-input" @bind-Value="editor.Department">
                                <option value="">-- @I18n.T("Select Department") --</option>
                                @foreach (var d in departments.Where(x => x.IsActive || x.ID == editor.Department))
                                {
                                    <option value="@d.ID">@d.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="doc-field" style="flex: 1; min-width: 0;">
                            <label class="doc-label">@I18n.T("Room / Chamber")</label>
                            <InputText class="classic-input" @bind-Value="editor.Room" placeholder="Room 204" />
                        </div>
                    </div>

                    <!-- Row 4: Contact & Email -->
                    <div class="doc-row">
                        <div class="doc-field" style="flex: 1; min-width: 0;">
                            <label class="doc-label">@I18n.T("Contact Mobile")</label>
                            <InputText class="classic-input" @bind-Value="editor.Contact" placeholder="017xxxxxxxx" />
                        </div>
                        <div class="doc-field" style="flex: 1; min-width: 0;">
                            <label class="doc-label">@I18n.T("Email")</label>
                            <InputText class="classic-input" @bind-Value="editor.Email" placeholder="doctor@delta.edu.bd" />
                        </div>
                    </div>

                    <!-- Row 5: Consultation Schedule, Weekly Off Day & Address -->
                    <div class="doc-row">
                        <div class="doc-field" style="flex: 1.1; min-width: 0;">
                            <label class="doc-label">⏰ @I18n.T("Consultation Hours")</label>
                            <InputText class="classic-input" @bind-Value="editor.ConsultationTime" placeholder="@I18n.T("e.g. 05:00 PM - 09:00 PM")" />
                        </div>
                        <div class="doc-field" style="flex: 0.95; min-width: 0;">
                            <label class="doc-label">🚫 @I18n.T("Weekly Off Day(s)")</label>
                            <InputText class="classic-input" @bind-Value="editor.OffDay" placeholder="@I18n.T("e.g. Friday or Friday, Saturday")" />
                        </div>
                        <div class="doc-field" style="flex: 1; min-width: 0;">
                            <label class="doc-label">@I18n.T("Chamber / Hospital Address")</label>
                            <InputText class="classic-input" @bind-Value="editor.Address" placeholder="@(!string.IsNullOrWhiteSpace(Branding.HospitalName) ? Branding.HospitalName : I18n.T("Chamber or hospital address"))" />
                        </div>
                    </div>

                    <!-- Row 6: Priority & Status Control Box -->
                    <div class="doc-priority-control-box">
                        <div class="doc-row" style="align-items: flex-start;">
                            <div class="doc-field" style="flex: 1; min-width: 0;">
                                <label class="doc-label" title="@I18n.T("Appointment Priority Serial")">
                                    ⭐ @I18n.T("Priority Serial")
                                </label>
                                <InputNumber class="classic-input doc-priority-input"
                                             @bind-Value="editor.Priority"
                                             placeholder="@I18n.T("e.g. 1, 2, 3...")"
                                             min="1" max="999" />
                                <span class="doc-help-text">
                                    @I18n.T("Appointment search sort order.")
                                </span>
                            </div>

                            <div class="doc-field" style="flex: 1; min-width: 0;">
                                <label class="doc-label">@I18n.T("Doctor Status")</label>
                                <div class="doc-status-toggle">
                                    <button type="button"
                                            class="doc-toggle-btn @(editor.IsActive ? "active" : "")"
                                            @onclick="() => editor.IsActive = true">
                                        ✓ @I18n.T("Active")
                                    </button>
                                    <button type="button"
                                            class="doc-toggle-btn @(!editor.IsActive ? "inactive" : "")"
                                            @onclick="() => editor.IsActive = false">
                                        ✕ @I18n.T("Inactive")
                                    </button>
                                </div>
                                <span class="doc-help-text">
                                    @(editor.IsActive ? I18n.T("Doctor appears in appointment dropdown.") : I18n.T("Doctor is hidden from appointment booking."))
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="doc-form-footer">
                    <button class="btn btn-primary doc-btn" type="submit" disabled="@saving">
                        💾 @(saving ? I18n.T("Saving...") : editor.ID == 0 ? I18n.T("Save Doctor") : I18n.T("Update Doctor"))
                    </button>
                    @if (editor.ID > 0)
                    {
                        <button class="btn btn-ghost doc-btn" type="button" @onclick="DeleteSelectedAsync" style="color:#dc2626;" title="@I18n.T("Delete Doctor")">
                            🗑️ @I18n.T("Delete")
                        </button>
                    }
                    <button class="btn btn-ghost doc-btn" type="button" @onclick="Reset" title="@I18n.T("Clear Form")">
                        @I18n.T("Clear")
                    </button>
                </div>
            </EditForm>
        </div>

        <!-- Right Column: Doctors Directory & List -->
        <div class="doc-card doc-list-card">
            <div class="doc-filter-header">
                <!-- Search & Filters -->
                <div class="doc-filter-row">
                    <div class="doc-search-wrap">
                        <span class="doc-search-icon"><SearchIcon /></span>
                        <input type="text"
                               class="classic-input doc-search-input"
                               placeholder="@I18n.T("Search doctor ID, name, category, department, room...")"
                               @bind="searchQuery"
                               @bind:event="oninput"
                               @bind:after="ResetPage" />
                        @if (!string.IsNullOrWhiteSpace(searchQuery))
                        {
                            <button type="button" class="doc-search-clear" @onclick='() => { searchQuery = string.Empty; ResetPage(); }'>✕</button>
                        }
                    </div>

                    <div class="doc-dept-filter-wrap">
                        <select class="classic-input doc-dept-select" @bind="selectedDeptFilter" @bind:after="ResetPage">
                            <option value="">-- @I18n.T("All Departments") --</option>
                            @foreach (var d in departments)
                            {
                                <option value="@d.ID">@d.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Scope Status Chips -->
                <div class="doc-status-chips-row">
                    <div class="doc-status-chips">
                        <button type="button"
                                class="doc-chip @(statusFilter == "All" ? "active" : "")"
                                @onclick='() => SetStatusFilter("All")'>
                            @I18n.T("All") (@doctors.Count)
                        </button>
                        <button type="button"
                                class="doc-chip active-chip @(statusFilter == "Active" ? "active" : "")"
                                @onclick='() => SetStatusFilter("Active")'>
                            ✓ @I18n.T("Active") (@doctors.Count(x => x.IsActive))
                        </button>
                        <button type="button"
                                class="doc-chip inactive-chip @(statusFilter == "Inactive" ? "active" : "")"
                                @onclick='() => SetStatusFilter("Inactive")'>
                            ✕ @I18n.T("Inactive") (@doctors.Count(x => !x.IsActive))
                        </button>
                        <button type="button"
                                class="doc-chip priority-chip @(statusFilter == "Prioritized" ? "active" : "")"
                                @onclick='() => SetStatusFilter("Prioritized")'>
                            ⭐ @I18n.T("Prioritized") (@doctors.Count(x => x.Priority.HasValue && x.Priority > 0))
                        </button>
                    </div>

                    <span class="doc-found-count">
                        @FilteredDoctors.Count() @I18n.T("found")
                    </span>
                </div>
            </div>

            <!-- Table of Doctors -->
            <div class="doc-table-wrap">
                <table class="doc-table">
                    <thead>
                        <tr>
                            <th style="width: 75px; text-align: center;">@I18n.T("Priority")</th>
                            <th>@I18n.T("Doctor Profile")</th>
                            <th style="width: 170px;">@I18n.T("Department & Room")</th>
                            <th style="width: 90px; text-align: center;">@I18n.T("Status")</th>
                            <th style="width: 65px; text-align: center;">@I18n.T("Action")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!PagedDoctors.Any())
                        {
                            <tr>
                                <td colspan="5" class="doc-empty-cell">
                                    <div class="doc-empty-box">
                                        <span>📋</span>
                                        <strong>@I18n.T("No doctors match your search or filter.")</strong>
                                        <p>@I18n.T("Try clearing your search query or switching status filters.")</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        @foreach (var doctor in PagedDoctors)
                        {
                            <tr class="@(editor.ID == doctor.ID ? "selected-row" : "") @(!doctor.IsActive ? "inactive-row" : "")">
                                <td style="text-align: center;">
                                    @if (doctor.Priority.HasValue && doctor.Priority.Value > 0)
                                    {
                                        <span class="doc-priority-badge" title="@I18n.T("Appointment display priority") #@doctor.Priority">
                                            ⭐ #@doctor.Priority
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="doc-priority-none">—</span>
                                    }
                                </td>
                                <td>
                                    <div class="doc-name-cell">
                                        <div class="doc-name-main">
                                            <strong>@DoctorDisplayName(doctor)</strong>
                                            <span class="doc-id-tag">ID: @doctor.ID</span>
                                            @if (!string.IsNullOrWhiteSpace(doctor.Attachment))
                                            {
                                                <span class="doc-type-badge @GetAttachmentClass(doctor.Attachment)">@DoctorTypeLabel(doctor.Attachment)</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(CleanDoctorDegree(doctor)))
                                        {
                                            <div class="doc-degree-text">@CleanDoctorDegree(doctor)</div>
                                        }
                                        @if (HasValidContact(doctor.Contact))
                                        {
                                            <div class="doc-contact-text">📞 @doctor.Contact!.Trim()</div>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="doc-dept-cell">
                                        @if (HasValidDepartment(doctor.Department))
                                        {
                                            <div class="doc-dept-name">@DepartmentName(doctor.Department)</div>
                                        }
                                        @if (HasValidRoom(doctor.Room))
                                        {
                                            <div class="doc-room-text">🚪 Room @CleanDoctorRoom(doctor.Room)</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(doctor.ConsultationTime))
                                        {
                                            <div class="doc-sched-pill" style="font-size:10px; font-weight:700; color:#0284c7; margin-top:2px;">⏰ @doctor.ConsultationTime</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(doctor.OffDay))
                                        {
                                            <div class="doc-offday-pill" style="font-size:10px; font-weight:700; color:#dc2626; margin-top:2px;">🚫 Off: @doctor.OffDay</div>
                                        }
                                        @if (!HasValidDepartment(doctor.Department) && !HasValidRoom(doctor.Room))
                                        {
                                            <span class="doc-text-muted">—</span>
                                        }
                                    </div>
                                </td>
                                <td style="text-align: center;">
                                    <button type="button"
                                            class="doc-status-btn @(doctor.IsActive ? "btn-active" : "btn-inactive")"
                                            @onclick="() => ToggleDoctorActiveAsync(doctor)"
                                            title="@(doctor.IsActive ? I18n.T("Click to mark Inactive") : I18n.T("Click to mark Active"))">
                                        @(doctor.IsActive ? I18n.T("Active") : I18n.T("Inactive"))
                                    </button>
                                </td>
                                <td style="text-align: center;">
                                    <button type="button" class="btn btn-secondary doc-edit-btn" @onclick="() => Select(doctor)" title="@I18n.T("Edit Doctor")">
                                        ✏️ @I18n.T("Edit")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Bar -->
            <div class="doc-table-footer">
                <div class="doc-pager-info">
                    @if (FilteredDoctors.Any())
                    {
                        <span>@I18n.T("Showing") @((currentPage * PageSize) + 1)-@(Math.Min((currentPage + 1) * PageSize, FilteredDoctors.Count())) @I18n.T("of") @FilteredDoctors.Count()</span>
                    }
                </div>

                <div class="doc-pager-controls">
                    <button type="button" class="doc-page-btn" @onclick="() => currentPage = 0" disabled="@(currentPage == 0)" title="@I18n.T("First Page")">«</button>
                    <button type="button" class="doc-page-btn" @onclick="() => currentPage = Math.Max(0, currentPage - 1)" disabled="@(currentPage == 0)" title="@I18n.T("Previous Page")">‹</button>
                    <span class="doc-page-indicator">@I18n.T("Page") @(currentPage + 1) @I18n.T("of") @PageCount</span>
                    <button type="button" class="doc-page-btn" @onclick="() => currentPage = Math.Min(PageCount - 1, currentPage + 1)" disabled="@(currentPage >= PageCount - 1)" title="@I18n.T("Next Page")">›</button>
                    <button type="button" class="doc-page-btn" @onclick="() => currentPage = Math.Max(0, PageCount - 1)" disabled="@(currentPage >= PageCount - 1)" title="@I18n.T("Last Page")">»</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private DoctorsProfile editor = new() { Title = "Dr.", Attachment = "Permanent", EnteredBy = 1, TransDate = DateTime.Now, IsActive = true };
    private List<DoctorsProfile> doctors = [];
    private List<Department> departments = [];
    private string searchQuery = string.Empty;
    private string statusFilter = "All";
    private int? selectedDeptFilter;
    private const int PageSize = 8;
    private int currentPage;
    private string message = string.Empty;
    private string messageClass = "success";
    private bool saving;

    private static readonly Regex MultiSpaceRegex = new(@"\s+", RegexOptions.Compiled);
    private static readonly Regex MultiDotRegex = new(@"\.{2,}", RegexOptions.Compiled);
    private static readonly Regex LeadingZRegex = new(@"^z{2,}[\s._-]*", RegexOptions.Compiled | RegexOptions.IgnoreCase);

    public static string CleanDoctorText(string? input)
    {
        if (string.IsNullOrWhiteSpace(input)) return string.Empty;
        var s = input.Trim();
        if (s.All(c => c == '.' || c == '-' || c == '_' || char.IsWhiteSpace(c)))
            return string.Empty;

        s = LeadingZRegex.Replace(s, string.Empty);
        s = MultiDotRegex.Replace(s, " ");
        s = s.TrimStart('.', ' ', '-', '_', '\t');
        s = s.TrimEnd(' ', '\t');
        return MultiSpaceRegex.Replace(s, " ").Trim();
    }

    private static string CleanDoctorDegree(DoctorsProfile doc) => CleanDoctorText(doc.Degree);
    private static string CleanDoctorRoom(string? room) => CleanDoctorText(room);

    public static bool HasValidContact(string? contact)
    {
        if (string.IsNullOrWhiteSpace(contact)) return false;
        var c = contact.Trim();
        return c != "0" && c != "." && c != ".." && c != "-" && c.Length > 2;
    }

    public static bool HasValidRoom(string? room)
    {
        if (string.IsNullOrWhiteSpace(room)) return false;
        var r = CleanDoctorRoom(room);
        return !string.IsNullOrWhiteSpace(r) && r != "0" && r != "." && r != ".." && r != "-";
    }

    private bool HasValidDepartment(int? deptId) => deptId.HasValue && deptId.Value > 0 && departments.Any(d => d.ID == deptId.Value);

    private static string DoctorDisplayName(DoctorsProfile doctor)
    {
        var title = CleanDoctorText(doctor.Title);
        var name = CleanDoctorText(doctor.Name);
        if (string.IsNullOrWhiteSpace(title)) return name;
        if (string.IsNullOrWhiteSpace(name)) return title;
        if (name.StartsWith(title, StringComparison.OrdinalIgnoreCase))
            return name;
        return $"{title} {name}".Trim();
    }

    private static string DoctorTypeLabel(string? attachment) => attachment switch
    {
        "Permanent" => "Permanent",
        "Residential" => "Residential",
        "Contractual" => "Contractual",
        "Visiting" => "Visiting",
        "Consultant" => "Consultant",
        "Temporary" => "Temporary",
        _ => attachment ?? string.Empty
    };

    private static string GetAttachmentClass(string? attachment) => attachment switch
    {
        "Permanent" => "badge-perm",
        "Residential" => "badge-res",
        "Contractual" => "badge-cont",
        _ => "badge-other"
    };

    private IEnumerable<DoctorsProfile> FilteredDoctors
    {
        get
        {
            var list = doctors.AsEnumerable();

            // Status filter
            if (statusFilter == "Active") list = list.Where(x => x.IsActive);
            else if (statusFilter == "Inactive") list = list.Where(x => !x.IsActive);
            else if (statusFilter == "Prioritized") list = list.Where(x => x.Priority.HasValue && x.Priority > 0);

            // Department filter
            if (selectedDeptFilter.HasValue && selectedDeptFilter.Value > 0)
                list = list.Where(x => x.Department == selectedDeptFilter.Value);

            // Search query
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var q = searchQuery.Trim();
                list = list.Where(d => d.ID.ToString().Contains(q, StringComparison.OrdinalIgnoreCase)
                                    || (d.Name != null && d.Name.Contains(q, StringComparison.OrdinalIgnoreCase))
                                    || (d.Title != null && d.Title.Contains(q, StringComparison.OrdinalIgnoreCase))
                                    || (d.Degree != null && d.Degree.Contains(q, StringComparison.OrdinalIgnoreCase))
                                    || (d.Attachment != null && d.Attachment.Contains(q, StringComparison.OrdinalIgnoreCase))
                                    || (d.Room != null && d.Room.Contains(q, StringComparison.OrdinalIgnoreCase))
                                    || (d.Department.HasValue && departments.Any(dept => dept.ID == d.Department && dept.Name.Contains(q, StringComparison.OrdinalIgnoreCase))));
            }

            // Order by Priority first, then Name
            return list.OrderBy(x => x.Priority.HasValue && x.Priority.Value > 0 ? 0 : 1)
                       .ThenBy(x => x.Priority)
                       .ThenBy(x => x.Name);
        }
    }

    private int PageCount => Math.Max(1, (int)Math.Ceiling(FilteredDoctors.Count() / (double)PageSize));
    private IEnumerable<DoctorsProfile> PagedDoctors => FilteredDoctors
        .Skip(currentPage * PageSize)
        .Take(PageSize);

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        await Branding.LoadAsync();
        if (string.IsNullOrWhiteSpace(editor.Address))
        {
            editor.Address = GetDefaultHospitalAddress();
        }
        await LoadAsync();
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => I18n.OnLanguageChanged -= HandleLanguageChanged;

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        doctors = await db.Doctors.AsNoTracking()
            .OrderBy(x => x.Priority.HasValue && x.Priority.Value > 0 ? 0 : 1)
            .ThenBy(x => x.Priority)
            .ThenBy(x => x.Name)
            .ToListAsync();
        departments = await db.Departments.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
    }

    private void ResetPage() => currentPage = 0;
    private void SetStatusFilter(string filter)
    {
        statusFilter = filter;
        ResetPage();
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(editor.Name))
        {
            messageClass = "danger";
            message = I18n.IsBangla ? "ডাক্তারের নাম আবশ্যক।" : "Doctor name is required.";
            return;
        }

        saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (editor.ID == 0)
            {
                editor.TransDate = DateTime.Now;
                editor.EnteredBy = 1;
                db.Doctors.Add(editor);
            }
            else
            {
                db.Doctors.Update(editor);
            }
            await db.SaveChangesAsync();
            messageClass = "success";
            message = I18n.IsBangla ? $"ডাক্তার {DoctorDisplayName(editor)} এর তথ্য সংরক্ষিত হয়েছে।" : $"Doctor {DoctorDisplayName(editor)} saved successfully.";
            ResetEditor();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            messageClass = "danger";
            message = $"Error: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ToggleDoctorActiveAsync(DoctorsProfile doc)
    {
        try
        {
            doc.IsActive = !doc.IsActive;
            await using var db = await DbFactory.CreateDbContextAsync();
            var entity = await db.Doctors.FindAsync(doc.ID);
            if (entity is not null)
            {
                entity.IsActive = doc.IsActive;
                await db.SaveChangesAsync();
                messageClass = "success";
                message = $"{DoctorDisplayName(doc)} is now {(doc.IsActive ? "Active" : "Inactive")}.";
            }
        }
        catch (Exception ex)
        {
            messageClass = "danger";
            message = $"Error updating status: {ex.Message}";
        }
    }

    private void Select(DoctorsProfile d)
    {
        var cleanAddr = CleanDoctorText(d.Address);
        editor = new DoctorsProfile
        {
            ID = d.ID,
            Name = d.Name,
            Title = d.Title,
            Degree = d.Degree,
            Attachment = d.Attachment,
            POSerial = d.POSerial,
            AreaCode = d.AreaCode,
            Balance = d.Balance,
            OpeningBalance = d.OpeningBalance,
            Contact = d.Contact,
            Email = d.Email,
            Room = d.Room,
            Department = d.Department,
            EnteredBy = d.EnteredBy,
            TransDate = d.TransDate,
            Address = !string.IsNullOrWhiteSpace(cleanAddr) ? d.Address : GetDefaultHospitalAddress(),
            ReferralCategoryID = d.ReferralCategoryID,
            IsActive = d.IsActive,
            Priority = d.Priority
        };
        message = string.Empty;
    }

    private async Task DeleteSelectedAsync()
    {
        if (!await JS.InvokeAsync<bool>("hpm.confirm", I18n.IsBangla ? $"ডাক্তার {editor.Name} মুছে ফেলতে চান?" : $"Delete doctor {editor.Name}?")) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var id = editor.ID;
        var inUse = await db.DoctorAppointments.AnyAsync(x => x.DoctorID == id)
                 || await db.OPDTickets.AnyAsync(x => x.DoctorID == id)
                 || await db.EmergencyMemos.AnyAsync(x => x.DoctorID == id)
                 || await db.OTCashMemos.AnyAsync(x => x.DoctorID == id)
                 || await db.OTCashMemoItems.AnyAsync(x => x.ServiceID == id)
                 || await db.PatientAdmissions.AnyAsync(x => x.Consultant == id || x.AdmittedBy == id || x.ReferredBy == id);

        if (inUse)
        {
            messageClass = "danger";
            message = I18n.IsBangla ? "এই ডাক্তারের রেফারেন্সে লেনদেনের রেকর্ড রয়েছে এবং মুছে ফেলা যাবে না।" : "This doctor has transactional records and cannot be deleted. You can mark them Inactive instead.";
            return;
        }

        var entity = await db.Doctors.FindAsync(id);
        if (entity is not null)
        {
            db.Remove(entity);
            await db.SaveChangesAsync();
        }
        messageClass = "success";
        message = I18n.IsBangla ? "ডাক্তার মুছে ফেলা হয়েছে।" : "Doctor deleted.";
        ResetEditor();
        await LoadAsync();
    }

    private void Reset()
    {
        ResetEditor();
        message = string.Empty;
    }

    private void ResetEditor() => editor = NewDoctor();
    private DoctorsProfile NewDoctor() => new()
    {
        Title = "Dr.",
        Attachment = "Permanent",
        Address = GetDefaultHospitalAddress(),
        EnteredBy = 1,
        TransDate = DateTime.Now,
        IsActive = true
    };

    private string GetDefaultHospitalAddress()
    {
        if (!string.IsNullOrWhiteSpace(Branding.HospitalName))
            return Branding.HospitalName;
        return "Delta Medical College & Hospital";
    }
    private string DepartmentName(int? id) => departments.FirstOrDefault(x => x.ID == id)?.Name ?? "—";
    private async Task ExportExcelAsync()
    {
        try
        {
            var list = FilteredDoctors.ToList();
            var sb = new StringBuilder();
            sb.AppendLine("Priority,Doctor ID,Title,Doctor Name,Category,Degree,Department,Room,Contact Mobile,Email,Chamber Address,Status");

            foreach (var doc in list)
            {
                var priorityStr = doc.Priority.HasValue && doc.Priority > 0 ? doc.Priority.Value.ToString() : "";
                var idStr = doc.ID.ToString();
                var titleStr = EscapeCsv(CleanDoctorText(doc.Title));
                var nameStr = EscapeCsv(CleanDoctorText(doc.Name));
                var catStr = EscapeCsv(DoctorTypeLabel(doc.Attachment));
                var degreeStr = EscapeCsv(CleanDoctorDegree(doc));
                var deptStr = EscapeCsv(DepartmentName(doc.Department));
                var roomStr = EscapeCsv(CleanDoctorRoom(doc.Room));
                var contactStr = EscapeCsv(HasValidContact(doc.Contact) ? doc.Contact!.Trim() : "");
                var emailStr = EscapeCsv(doc.Email?.Trim());
                var addressStr = EscapeCsv(doc.Address?.Trim());
                var statusStr = doc.IsActive ? "Active" : "Inactive";

                sb.AppendLine($"\"{priorityStr}\",\"{idStr}\",\"{titleStr}\",\"{nameStr}\",\"{catStr}\",\"{degreeStr}\",\"{deptStr}\",\"{roomStr}\",\"{contactStr}\",\"{emailStr}\",\"{addressStr}\",\"{statusStr}\"");
            }

            var preamble = Encoding.UTF8.GetPreamble();
            var dataBytes = Encoding.UTF8.GetBytes(sb.ToString());
            var fullBytes = new byte[preamble.Length + dataBytes.Length];
            Buffer.BlockCopy(preamble, 0, fullBytes, 0, preamble.Length);
            Buffer.BlockCopy(dataBytes, 0, fullBytes, preamble.Length, dataBytes.Length);

            var base64 = Convert.ToBase64String(fullBytes);
            var filename = $"Doctors_Directory_{DateTime.Now:yyyyMMdd_HHmm}.csv";
            await JS.InvokeVoidAsync("hpm.downloadFile", filename, "text/csv;charset=utf-8", base64);
        }
        catch (Exception ex)
        {
            messageClass = "danger";
            message = $"Excel export error: {ex.Message}";
        }
    }

    private static string EscapeCsv(string? val)
    {
        if (string.IsNullOrEmpty(val)) return string.Empty;
        return val.Replace("\"", "\"\"");
    }

    private async Task PrintListAsync()
    {
        try
        {
            var list = FilteredDoctors.Take(500).ToList();
            var sb = new StringBuilder();
            sb.Append("<table><thead><tr>");
            sb.Append("<th style='width:55px;' class='text-center'>Priority</th>");
            sb.Append("<th style='width:55px;' class='text-center'>ID</th>");
            sb.Append("<th>Doctor Name & Qualifications</th>");
            sb.Append("<th style='width:90px;'>Category</th>");
            sb.Append("<th style='width:140px;'>Department</th>");
            sb.Append("<th style='width:70px;'>Room</th>");
            sb.Append("<th style='width:95px;'>Contact</th>");
            sb.Append("<th style='width:60px;' class='text-center'>Status</th>");
            sb.Append("</tr></thead><tbody>");

            foreach (var doc in list)
            {
                var priorityStr = doc.Priority.HasValue && doc.Priority > 0 ? $"<span class='priority-star'>⭐ #{doc.Priority}</span>" : "—";
                var nameDisplay = System.Net.WebUtility.HtmlEncode(DoctorDisplayName(doc));
                var degree = CleanDoctorDegree(doc);
                var degreeDisplay = !string.IsNullOrWhiteSpace(degree) ? $"<div style='color:#64748b;font-size:7.5pt;'>{System.Net.WebUtility.HtmlEncode(degree)}</div>" : "";
                var catClass = GetAttachmentClass(doc.Attachment);
                var catDisplay = $"<span class='{catClass}'>{System.Net.WebUtility.HtmlEncode(DoctorTypeLabel(doc.Attachment))}</span>";
                var deptDisplay = System.Net.WebUtility.HtmlEncode(DepartmentName(doc.Department));
                var room = CleanDoctorRoom(doc.Room);
                var roomDisplay = !string.IsNullOrWhiteSpace(room) ? $"Room {System.Net.WebUtility.HtmlEncode(room)}" : "—";
                var contact = HasValidContact(doc.Contact) ? System.Net.WebUtility.HtmlEncode(doc.Contact!.Trim()) : "—";
                var statusClass = doc.IsActive ? "badge-active" : "badge-inactive";
                var statusText = doc.IsActive ? "Active" : "Inactive";

                sb.Append("<tr>");
                sb.Append($"<td class='text-center'>{priorityStr}</td>");
                sb.Append($"<td class='text-center'><strong>{doc.ID}</strong></td>");
                sb.Append($"<td><strong>{nameDisplay}</strong>{degreeDisplay}</td>");
                sb.Append($"<td>{catDisplay}</td>");
                sb.Append($"<td>{deptDisplay}</td>");
                sb.Append($"<td>{roomDisplay}</td>");
                sb.Append($"<td>{contact}</td>");
                sb.Append($"<td class='text-center'><span class='{statusClass}'>{statusText}</span></td>");
                sb.Append("</tr>");
            }

            sb.Append("</tbody></table>");

            var metaText = $"Total Doctors: {FilteredDoctors.Count()} | Scope: {statusFilter} | Filter: {(string.IsNullOrWhiteSpace(searchQuery) ? "All" : searchQuery)}";
            await JS.InvokeVoidAsync("hpm.printDoctorList", Branding.HospitalName, "Doctors Directory & Priority Schedule", metaText, sb.ToString());
        }
        catch (Exception ex)
        {
            messageClass = "danger";
            message = $"Print error: {ex.Message}";
        }
    }
