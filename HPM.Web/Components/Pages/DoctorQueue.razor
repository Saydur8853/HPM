@page "/clinical/doctor-queue"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.Doctor + "," + RoleNames.Nurse)]
@rendermode InteractiveServer
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable
@using System.Security.Claims

<PageTitle>@I18n.T("Doctor Queue") | @Branding.HospitalName</PageTitle>

<div class="page-heading">
    <div>
        <span class="eyebrow">@I18n.T("Clinical Care")</span>
        <h1>@I18n.T("Doctor Queue & Consultation")</h1>
        <p>@I18n.T("Checked-in patients, vitals, consultation notes and clinical handoff.")</p>
    </div>
    <button class="btn btn-secondary" @onclick="LoadAsync">↻ @I18n.T("Refresh")</button>
</div>

@if (!string.IsNullOrWhiteSpace(message)) { <div class="alert @messageClass">@message</div> }

<div class="panel" style="margin-bottom:16px;">
    <div class="form-grid three">
        <label><span>@I18n.T("Date")</span><InputDate @bind-Value="queueDate" @bind-Value:after="LoadAsync" /></label>
        <label class="span-2"><span>@I18n.T("Doctor")</span><select @bind="doctorId" @bind:after="LoadAsync" disabled="@isDoctor"><option value="0">@I18n.T("All doctors")</option>@foreach (var d in doctors) { <option value="@d.ID">@DoctorName(d.ID)</option> }</select></label>
    </div>
</div>

<div class="workspace-grid compact">
    <div class="panel list-panel">
        <div class="panel-heading"><div><h2>@I18n.T("Patient Queue")</h2><p>@queue.Count @I18n.T("visit(s)")</p></div></div>
        <div class="record-list">
            @if (queue.Count == 0) { <div class="empty-state">@I18n.T("No checked-in patient in this queue.")</div> }
            @foreach (var item in queue)
            {
                <button type="button" class="record-card static" style="width:100%;text-align:left;" @onclick="() => Select(item)">
                    <span class="ticket-no">#@item.QueueNo</span>
                    <span class="record-main"><strong>@item.PatientName</strong><small>@DoctorName(item.DoctorID) · @(item.PatientID ?? I18n.T("Walk-in")) · @item.CheckedInAt.ToString("hh:mm tt")</small></span>
                    <span class="pill">@item.Status</span>
                </button>
            }
        </div>
    </div>

    <div class="panel form-panel">
        @if (selected is null)
        {
            <div class="empty-state">@I18n.T("Select a patient from the queue.")</div>
        }
        else
        {
            <div class="panel-heading">
                <div><h2>@selected.PatientName</h2><p>@(selected.PatientID ?? I18n.T("Walk-in")) · @I18n.T("Queue") #@selected.QueueNo · @DoctorName(selected.DoctorID)</p></div>
                <span class="badge">@selected.Status</span>
            </div>

            <div class="form-section-title">@I18n.T("Triage & Vitals")</div>
            <div class="form-grid three">
                <label><span>BP</span><InputText @bind-Value="selected.BloodPressure" placeholder="120/80" /></label>
                <label><span>@I18n.T("Pulse")</span><InputText @bind-Value="selected.Pulse" placeholder="72/min" /></label>
                <label><span>@I18n.T("Temperature")</span><InputText @bind-Value="selected.Temperature" placeholder="98.4 F" /></label>
                <label><span>SpO₂</span><InputText @bind-Value="selected.OxygenSaturation" placeholder="98%" /></label>
                <label><span>@I18n.T("Height (cm)")</span><InputNumber @bind-Value="selected.HeightCm" /></label>
                <label><span>@I18n.T("Weight (kg)")</span><InputNumber @bind-Value="selected.WeightKg" /></label>
                <label class="span-3"><span>@I18n.T("Allergy / Critical Alert")</span><InputTextArea @bind-Value="selected.Allergies" /></label>
            </div>

            <div class="form-section-title">@I18n.T("Clinical Encounter")</div>
            <div class="form-grid">
                <label class="span-2"><span>@I18n.T("Chief Complaint")</span><InputTextArea @bind-Value="selected.ChiefComplaint" /></label>
                <label class="span-2"><span>@I18n.T("Clinical Notes / Findings")</span><InputTextArea @bind-Value="selected.ClinicalNotes" /></label>
                <label class="span-2"><span>@I18n.T("Diagnosis")</span><InputTextArea @bind-Value="selected.Diagnosis" disabled="@(!canClinicalDecision)" /></label>
                <label class="span-2"><span>@I18n.T("Advice / Follow-up")</span><InputTextArea @bind-Value="selected.Advice" disabled="@(!canClinicalDecision)" /></label>
            </div>

            <div class="form-actions">
                @if (canClinicalDecision && selected.Status == EncounterStatuses.Waiting)
                {
                    <button class="btn btn-primary" @onclick="StartAsync">@I18n.T("Start Consultation")</button>
                }
                @if (selected.Status is EncounterStatuses.Waiting or EncounterStatuses.InConsultation)
                {
                    <button class="btn btn-secondary" @onclick="SaveAsync">@I18n.T("Save Notes & Vitals")</button>
                    @if (canClinicalDecision)
                    {
                        <a class="btn btn-secondary" href="@($"pharmacy/prescriptions?encounterId={selected.ID}")">@I18n.T("Write Prescription")</a>
                        <a class="btn btn-secondary" href="@($"clinical/diagnostic-orders?encounterId={selected.ID}")">@I18n.T("Diagnostic Order")</a>
                        @if (!string.IsNullOrWhiteSpace(selected.PatientID))
                        {
                            <a class="btn btn-secondary" href="@($"ipd/admissions?patientId={selected.PatientID}")">@I18n.T("Admit to IPD")</a>
                        }
                    }
                }
                @if (canClinicalDecision && selected.Status == EncounterStatuses.InConsultation)
                {
                    <button class="btn btn-primary" @onclick="CompleteAsync">@I18n.T("Complete Visit")</button>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<DoctorsProfile> doctors = [];
    private List<PatientEncounter> queue = [];
    private PatientEncounter? selected;
    private DateTime queueDate = DateTime.Today;
    private int doctorId;
    private int? currentDoctorProfileId;
    private bool isDoctor;
    private bool canClinicalDecision;
    private string message = "", messageClass = "success";

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        var principal = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        isDoctor = principal.IsInRole(RoleNames.Doctor);
        if (int.TryParse(principal.FindFirstValue(AppUserClaimsPrincipalFactory.DoctorProfileIdClaim), out var mappedDoctorId)) currentDoctorProfileId = mappedDoctorId;
        canClinicalDecision = principal.IsInRole(RoleNames.Administrator) || (isDoctor && currentDoctorProfileId.HasValue);
        if (isDoctor && !currentDoctorProfileId.HasValue) Fail(I18n.T("This Doctor account is not linked to a Doctors Profile. Contact an administrator."));
        await using var db = await DbFactory.CreateDbContextAsync();
        doctors = await db.Doctors.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
        if (currentDoctorProfileId.HasValue) doctorId = currentDoctorProfileId.Value;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var query = db.PatientEncounters.AsNoTracking().Where(x => x.VisitDate == queueDate.Date);
        if (isDoctor && !currentDoctorProfileId.HasValue) { queue=[]; selected=null; return; }
        if (currentDoctorProfileId.HasValue) query = query.Where(x => x.DoctorID == currentDoctorProfileId.Value);
        else if (doctorId > 0) query = query.Where(x => x.DoctorID == doctorId);
        queue = await query.OrderBy(x => x.Status == EncounterStatuses.InConsultation ? 0 : x.Status == EncounterStatuses.Waiting ? 1 : 2)
            .ThenBy(x => x.QueueNo).ToListAsync();
        if (selected is not null) selected = queue.FirstOrDefault(x => x.ID == selected.ID);
    }

    private void Select(PatientEncounter item) => selected = Clone(item);

    private async Task StartAsync() => await PersistAsync(EncounterStatuses.InConsultation);
    private async Task CompleteAsync()
    {
        if (string.IsNullOrWhiteSpace(selected?.Diagnosis)) { Fail(I18n.IsBangla ? "ভিজিট সম্পন্ন করতে রোগ নির্ণয় লিখুন।" : "Diagnosis is required to complete the visit."); return; }
        await PersistAsync(EncounterStatuses.Completed);
    }
    private async Task SaveAsync() => await PersistAsync(null);

    private async Task PersistAsync(string? nextStatus)
    {
        if (selected is null) return;
        if (nextStatus is not null && !canClinicalDecision) { Fail(I18n.T("Only the assigned doctor can change consultation status.")); return; }
        await using var db = await DbFactory.CreateDbContextAsync();
        await using var tx = await db.Database.BeginTransactionAsync(System.Data.IsolationLevel.Serializable);
        try
        {
            var entity = await db.PatientEncounters.SingleAsync(x => x.ID == selected.ID);
            if (currentDoctorProfileId.HasValue && entity.DoctorID != currentDoctorProfileId.Value) throw new InvalidOperationException("This encounter belongs to another doctor.");
            if (nextStatus is not null && !ClinicalEncounterWorkflow.CanTransition(entity.Status, nextStatus))
                throw new InvalidOperationException($"Invalid encounter transition from {entity.Status} to {nextStatus}.");
            CopyClinical(selected, entity);
            var userId = await CurrentUserIdAsync();
            if (nextStatus == EncounterStatuses.InConsultation) { entity.Status = nextStatus; entity.StartedAt = DateTime.Now; entity.StartedBy = userId; }
            if (nextStatus == EncounterStatuses.Completed) { entity.Status = nextStatus; entity.CompletedAt = DateTime.Now; entity.CompletedBy = userId; }
            entity.UpdatedAt = DateTime.Now;
            if (entity.AppointmentID.HasValue)
            {
                var appointment = await db.DoctorAppointments.FindAsync(entity.AppointmentID.Value);
                if (appointment is not null) appointment.Status = nextStatus == EncounterStatuses.InConsultation ? "InConsultation" : nextStatus == EncounterStatuses.Completed ? "Completed" : appointment.Status;
            }
            await db.SaveChangesAsync();
            await tx.CommitAsync();
            Success(nextStatus is null ? I18n.T("Clinical notes saved.") : $"Visit status changed to {nextStatus}.");
            await LoadAsync();
            var refreshed = queue.FirstOrDefault(x => x.ID == entity.ID);
            selected = refreshed is null ? null : Clone(refreshed);
        }
        catch (Exception ex) { await tx.RollbackAsync(); Fail(ex.GetBaseException().Message); }
    }

    private async Task<int> CurrentUserIdAsync()
    {
        var principal = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        return int.TryParse(principal.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : 1;
    }

    private static void CopyClinical(PatientEncounter from, PatientEncounter to)
    {
        to.BloodPressure = from.BloodPressure?.Trim(); to.Pulse = from.Pulse?.Trim(); to.Temperature = from.Temperature?.Trim();
        to.OxygenSaturation = from.OxygenSaturation?.Trim(); to.HeightCm = from.HeightCm; to.WeightKg = from.WeightKg;
        to.Allergies = from.Allergies?.Trim(); to.ChiefComplaint = from.ChiefComplaint?.Trim(); to.ClinicalNotes = from.ClinicalNotes?.Trim();
        to.Diagnosis = from.Diagnosis?.Trim(); to.Advice = from.Advice?.Trim();
    }
    private static PatientEncounter Clone(PatientEncounter x) => new() { ID=x.ID, PatientID=x.PatientID, PatientName=x.PatientName, Age=x.Age, Sex=x.Sex, DoctorID=x.DoctorID, DepartmentID=x.DepartmentID, AppointmentID=x.AppointmentID, TicketID=x.TicketID, VisitType=x.VisitType, Status=x.Status, QueueNo=x.QueueNo, VisitDate=x.VisitDate, CheckedInAt=x.CheckedInAt, StartedAt=x.StartedAt, CompletedAt=x.CompletedAt, BloodPressure=x.BloodPressure, Pulse=x.Pulse, Temperature=x.Temperature, OxygenSaturation=x.OxygenSaturation, HeightCm=x.HeightCm, WeightKg=x.WeightKg, Allergies=x.Allergies, ChiefComplaint=x.ChiefComplaint, ClinicalNotes=x.ClinicalNotes, Diagnosis=x.Diagnosis, Advice=x.Advice, CreatedBy=x.CreatedBy, StartedBy=x.StartedBy, CompletedBy=x.CompletedBy, CreatedAt=x.CreatedAt, UpdatedAt=x.UpdatedAt };
    private string DoctorName(int id) { var d=doctors.FirstOrDefault(x=>x.ID==id); return d is null ? "Doctor" : $"{d.Title} {d.Name}".Trim(); }
    private void Success(string text) { messageClass="success"; message=text; }
    private void Fail(string text) { messageClass="danger"; message=text; }
    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => I18n.OnLanguageChanged -= HandleLanguageChanged;
}
