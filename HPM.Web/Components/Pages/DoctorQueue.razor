@page "/doctor/queue"
@page "/doctor/consultation"
@page "/clinical/doctor-queue"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.Doctor + "," + RoleNames.Nurse)]
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable
@using System.Security.Claims

<PageTitle>@I18n.T("Doctor Queue") | @Branding.HospitalName</PageTitle>

<DoctorWorkspaceHeader />

<div class="doctor-queue-classic-fit">
    <!-- Topbar -->
    <div class="doctor-queue-classic-topbar">
        <div class="diagnostic-title-block">
            <span class="diagnostic-title-eyebrow">@I18n.T("Clinical Care")</span>
            <h1 class="diagnostic-title-main">@I18n.T("Doctor Queue & Consultation")</h1>
            <span class="diagnostic-title-subtitle">@I18n.T("Checked-in patients, vitals, consultation notes and clinical handoff.")</span>
        </div>

        <div style="display: flex; align-items: center; gap: 8px;">
            <label style="display: flex; align-items: center; gap: 4px; margin: 0; font-size: 12px; font-weight: 600; color: #475569;">
                <span>@I18n.T("Date"):</span>
                <InputDate class="form-control form-control-sm" style="width: 125px; height: 28px; padding: 2px 6px;" @bind-Value="queueDate" @bind-Value:after="LoadAsync" />
            </label>
            <label style="display: flex; align-items: center; gap: 4px; margin: 0; font-size: 12px; font-weight: 600; color: #475569;">
                <span>@I18n.T("Doctor"):</span>
                <select class="form-select form-select-sm" style="max-width: 180px; height: 28px; padding: 2px 8px; font-size: 11.5px;" @bind="doctorId" @bind:after="LoadAsync" disabled="@isDoctor">
                    <option value="0">@I18n.T("All doctors")</option>
                    @foreach (var d in doctors)
                    {
                        <option value="@d.ID">D@(d.ID) - @DoctorName(d.ID)</option>
                    }
                </select>
            </label>
        </div>

        <div class="diagnostic-metrics-strip">
            <div class="diagnostic-metric-chip">
                <span class="metric-label">@I18n.T("Waiting")</span>
                <span class="metric-value text-amber" style="color: #d97706;">@queue.Count(x => x.Status == EncounterStatuses.Waiting)</span>
            </div>
            <div class="diagnostic-metric-chip">
                <span class="metric-label">@I18n.T("In Consultation")</span>
                <span class="metric-value" style="color: #0284c7;">@queue.Count(x => x.Status == EncounterStatuses.InConsultation)</span>
            </div>
            <div class="diagnostic-metric-chip">
                <span class="metric-label">@I18n.T("Total Visits")</span>
                <span class="metric-value">@queue.Count</span>
            </div>
        </div>

        <div class="diagnostic-topbar-actions">
            <button class="btn btn-primary btn-sm" @onclick="SelectNextWaitingAsync" disabled="@(!queue.Any(x => x.Status == EncounterStatuses.Waiting))">Next waiting</button>
            <button class="btn btn-secondary btn-sm" @onclick="LoadAsync">↻ @I18n.T("Refresh")</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @messageClass" style="margin: 0.25rem 0.75rem 0; padding: 0.35rem 0.75rem; font-size: 0.82rem;">@message</div>
    }

    <!-- 2-Panel Workspace Grid -->
    <div class="doctor-queue-classic-workspace">
        <!-- Left: Patient Queue Card -->
        <div class="worklist-card">
            <div class="worklist-header" style="padding: 6px 10px;">
                <div style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
                    <h2>@I18n.T("Patient Queue")</h2>
                    <span class="diagnostic-badge">@FilteredQueue.Count @I18n.T("visits")</span>
                </div>
            </div>

            <!-- Queue Search -->
            <div style="padding: 4px 8px; border-bottom: 1px solid #e2e8f0; background: #f8fafc; display:grid; grid-template-columns:1fr 112px; gap:5px;">
                <input type="text"
                       class="form-control form-control-sm"
                       placeholder="@I18n.T("Search patient, token, ID...")"
                       @bind="searchQuery"
                       @bind:event="oninput"
                       style="font-size: 11.5px; height: 26px;" />
                <select class="form-select form-select-sm" style="font-size:11px;height:26px;padding:2px 5px" @bind="statusFilter">
                    <option>Active</option><option>All</option><option value="Waiting">Waiting</option><option value="InConsultation">In consultation</option><option value="Completed">Completed</option><option value="NoShow">No show</option>
                </select>
            </div>

            <!-- Scrollable Queue List -->
            <div class="billing-queue-list">
                @if (FilteredQueue.Count == 0)
                {
                    <div class="empty-state small" style="padding: 24px 0; text-align: center; color: #94a3b8; font-size: 11.5px;">
                        @I18n.T("No checked-in patient in this queue.")
                    </div>
                }
                @foreach (var item in FilteredQueue)
                {
                    var isSelected = selected?.ID == item.ID;
                    var statusColor = item.Status == EncounterStatuses.InConsultation ? "#0284c7" : item.Status == EncounterStatuses.Waiting ? "#d97706" : "#15803d";
                    var statusBg = item.Status == EncounterStatuses.InConsultation ? "#e0f2fe" : item.Status == EncounterStatuses.Waiting ? "#fef3c7" : "#dcfce7";
                    <div class="billing-queue-item @(isSelected ? "active" : "")" @onclick="() => SelectAsync(item)">
                        <div class="billing-queue-serial" style="background: @statusBg; color: @statusColor;">
                            #@item.QueueNo
                        </div>
                        <div class="billing-queue-info">
                            <div class="billing-queue-name">
                                @item.PatientName
                            </div>
                            <div class="billing-queue-meta">
                                @(item.PatientID ?? I18n.T("Walk-in")) · @item.CheckedInAt.ToString("hh:mm tt")
                                @if (item.Priority != "Normal") { <span style="color:#b4233b;font-weight:800"> · @item.Priority</span> }
                            </div>
                        </div>
                        <div class="billing-queue-actions">
                            <span class="badge" style="font-size: 9.5px; padding: 2px 6px; background: @statusBg; color: @statusColor; border: 1px solid transparent;">
                                @item.Status
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Right: Consultation Form Card -->
        <div class="results-form-card">
            @if (selected is null)
            {
                <div class="empty-state" style="margin: auto; padding: 40px; text-align: center;">
                    <div style="font-size: 32px; margin-bottom: 8px;">🩺</div>
                    <h3 style="font-size: 15px; font-weight: 700; color: #334155;">@I18n.T("No Patient Selected")</h3>
                    <p style="font-size: 12px; color: #64748b;">@I18n.T("Select a patient from the queue to start consultation or review triage.")</p>
                </div>
            }
            else
            {
                <div class="results-card-header" style="padding: 6px 12px;">
                    <div>
                        <h2 style="font-size: 14px;">@selected.PatientName</h2>
                        <span style="font-size: 11px; color: #64748b;">
                            @(selected.PatientID ?? I18n.T("Walk-in")) · @I18n.T("Queue") #@selected.QueueNo · @DoctorName(selected.DoctorID)
                        </span>
                    </div>
                    <span class="badge @(selected.Status == EncounterStatuses.InConsultation ? "badge-info" : selected.Status == EncounterStatuses.Waiting ? "badge-warning" : "badge-success")">
                        @selected.Status
                    </span>
                </div>

                <div class="results-form-body" style="padding: 8px 12px; gap: 8px;">
                    <div class="clinical-context-strip">
                        <article><small>PREVIOUS VISITS</small><strong>@previousVisits.Count</strong><span>@(previousVisits.FirstOrDefault()?.Diagnosis ?? "No prior diagnosis")</span></article>
                        <article><small>LAST PRESCRIPTION</small><strong>@(recentPrescriptions.FirstOrDefault()?.VisitDate?.ToString("dd MMM yyyy") ?? "None")</strong><span>@ShortText(recentPrescriptions.FirstOrDefault()?.Medicine, 55)</span></article>
                        <article><small>LAB / IMAGING</small><strong>@(recentOrders.FirstOrDefault()?.Status ?? "No orders")</strong><span>@(recentOrders.FirstOrDefault()?.Description ?? "No recent investigation")</span></article>
                        @if (!string.IsNullOrWhiteSpace(selected.PatientID)) { <a href="@($"/doctor/patient-documents/{selected.PatientID}")" target="_blank">Open full patient record →</a> }
                    </div>

                    <!-- Triage & Vitals Strip -->
                    <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 6px 10px;">
                        <span style="font-size: 10.5px; font-weight: 800; text-transform: uppercase; color: #0284c7; letter-spacing: 0.5px; display: block; margin-bottom: 4px;">
                            @I18n.T("Triage & Vitals")
                        </span>
                        <div class="row g-2">
                            <div class="col-md-2 col-4">
                                <label class="form-label" style="font-size: 10.5px; font-weight: 600; margin-bottom: 1px;">BP</label>
                                <InputText class="form-control form-control-sm" @bind-Value="selected.BloodPressure" @bind-Value:after="MarkDirty" placeholder="120/80" style="font-size: 11.5px; height: 26px;" />
                            </div>
                            <div class="col-md-2 col-4">
                                <label class="form-label" style="font-size: 10.5px; font-weight: 600; margin-bottom: 1px;">@I18n.T("Pulse")</label>
                                <InputText class="form-control form-control-sm" @bind-Value="selected.Pulse" @bind-Value:after="MarkDirty" placeholder="72/min" style="font-size: 11.5px; height: 26px;" />
                            </div>
                            <div class="col-md-2 col-4">
                                <label class="form-label" style="font-size: 10.5px; font-weight: 600; margin-bottom: 1px;">@I18n.T("Temp")</label>
                                <InputText class="form-control form-control-sm" @bind-Value="selected.Temperature" @bind-Value:after="MarkDirty" placeholder="98.4 F" style="font-size: 11.5px; height: 26px;" />
                            </div>
                            <div class="col-md-2 col-4">
                                <label class="form-label" style="font-size: 10.5px; font-weight: 600; margin-bottom: 1px;">SpO₂</label>
                                <InputText class="form-control form-control-sm" @bind-Value="selected.OxygenSaturation" @bind-Value:after="MarkDirty" placeholder="98%" style="font-size: 11.5px; height: 26px;" />
                            </div>
                            <div class="col-md-2 col-4">
                                <label class="form-label" style="font-size: 10.5px; font-weight: 600; margin-bottom: 1px;">@I18n.T("Height (cm)")</label>
                                <InputNumber class="form-control form-control-sm" @bind-Value="selected.HeightCm" @bind-Value:after="MarkDirty" style="font-size: 11.5px; height: 26px;" />
                            </div>
                            <div class="col-md-2 col-4">
                                <label class="form-label" style="font-size: 10.5px; font-weight: 600; margin-bottom: 1px;">@I18n.T("Weight (kg)")</label>
                                <InputNumber class="form-control form-control-sm" @bind-Value="selected.WeightKg" @bind-Value:after="MarkDirty" style="font-size: 11.5px; height: 26px;" />
                            </div>
                            <div class="col-12">
                                <label class="form-label" style="font-size: 10.5px; font-weight: 600; margin-bottom: 1px; color: #dc2626;">@I18n.T("Allergy / Critical Alert")</label>
                                <InputText class="form-control form-control-sm" @bind-Value="selected.Allergies" @bind-Value:after="MarkDirty" placeholder="Penicillin, Peanuts..." style="font-size: 11.5px; height: 26px; border-color: #fca5a5;" />
                            </div>
                            <div class="col-md-3 col-6">
                                <label class="form-label" style="font-size:10.5px;font-weight:600;margin-bottom:1px">Clinical priority</label>
                                <select class="form-select form-select-sm" style="height:26px;font-size:11px;padding:2px 6px" @bind="selected.Priority" @bind:after="MarkDirty"><option>Normal</option><option>Urgent</option><option>Emergency</option></select>
                            </div>
                        </div>
                    </div>

                    <!-- Clinical Encounter Form -->
                    <div style="background: #ffffff; border: 1px solid #cbd5e1; border-radius: 6px; padding: 6px 10px; flex: 1 1 auto; display: flex; flex-direction: column; gap: 6px;">
                        <span style="font-size: 10.5px; font-weight: 800; text-transform: uppercase; color: #0f172a; letter-spacing: 0.5px;">
                            @I18n.T("Clinical Encounter")
                        </span>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label" style="font-size: 11px; font-weight: 600; margin-bottom: 1px;">@I18n.T("Chief Complaint")</label>
                                <InputTextArea class="form-control form-control-sm" rows="2" @bind-Value="selected.ChiefComplaint" @bind-Value:after="MarkDirty" style="font-size: 11.5px;" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" style="font-size: 11px; font-weight: 600; margin-bottom: 1px;">@I18n.T("Clinical Notes / Findings")</label>
                                <InputTextArea class="form-control form-control-sm" rows="2" @bind-Value="selected.ClinicalNotes" @bind-Value:after="MarkDirty" style="font-size: 11.5px;" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" style="font-size: 11px; font-weight: 600; margin-bottom: 1px;">@I18n.T("Diagnosis *")</label>
                                <InputTextArea class="form-control form-control-sm" rows="2" @bind-Value="selected.Diagnosis" @bind-Value:after="MarkDirty" disabled="@(!canClinicalDecision)" style="font-size: 11.5px;" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" style="font-size: 11px; font-weight: 600; margin-bottom: 1px;">@I18n.T("Advice / Follow-up")</label>
                                <InputTextArea class="form-control form-control-sm" rows="2" @bind-Value="selected.Advice" @bind-Value:after="MarkDirty" disabled="@(!canClinicalDecision)" style="font-size: 11.5px;" />
                            </div>
                        </div>
                        @if (canClinicalDecision)
                        {
                            <div class="followup-editor">
                                <label class="check"><InputCheckbox @bind-Value="selected.FollowUpRequired" @bind-Value:after="MarkDirty" /><span>Follow-up required</span></label>
                                @if (selected.FollowUpRequired)
                                {
                                    <label><span>Follow-up date</span><InputDate class="form-control form-control-sm" @bind-Value="selected.FollowUpDate" @bind-Value:after="MarkDirty" /></label>
                                    <label class="reason"><span>Reason / instruction</span><InputText class="form-control form-control-sm" @bind-Value="selected.FollowUpReason" @bind-Value:after="MarkDirty" placeholder="Review response, repeat test, wound check…" /></label>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Sticky Actions Footer -->
                <div class="results-form-footer" style="padding: 6px 12px;">
                    <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                        @if (canClinicalDecision && selected.Status == EncounterStatuses.Waiting)
                        {
                            <button class="btn btn-primary btn-sm" @onclick="StartAsync" disabled="@isSaving">
                                ▶ @I18n.T("Start Consultation")
                            </button>
                            <button class="btn btn-ghost btn-sm" @onclick="MarkNoShowAsync" disabled="@isSaving">Mark no-show</button>
                        }
                        @if (selected.Status is EncounterStatuses.Waiting or EncounterStatuses.InConsultation)
                        {
                            <button class="btn btn-secondary btn-sm" @onclick="SaveAsync" disabled="@isSaving">
                                💾 @I18n.T("Save Notes & Vitals")
                            </button>
                            @if (canClinicalDecision)
                            {
                                <a class="btn btn-ghost btn-sm" href="@($"doctor/prescriptions?encounterId={selected.ID}")" target="_blank">
                                    💊 @I18n.T("Prescription")
                                </a>
                                <a class="btn btn-ghost btn-sm" href="@($"clinical/diagnostic-orders?encounterId={selected.ID}")" target="_blank">
                                    🔬 @I18n.T("Lab Orders")
                                </a>
                                @if (!string.IsNullOrWhiteSpace(selected.PatientID))
                                {
                                    <a class="btn btn-ghost btn-sm" href="@($"ipd/admissions?patientId={selected.PatientID}")" target="_blank">
                                        🏥 @I18n.T("Admit IPD")
                                    </a>
                                }
                            }
                        }
                    </div>

                    <div>
                        <span class="autosave-state">@(hasUnsavedChanges ? "Unsaved changes" : lastSavedAt.HasValue ? $"Saved {lastSavedAt:hh:mm:ss tt}" : "")</span>
                        @if (canClinicalDecision && selected.Status == EncounterStatuses.InConsultation)
                        {
                            <button class="btn btn-success btn-sm" @onclick="CompleteAsync" disabled="@isSaving">
                                ✓ @I18n.T("Complete Visit")
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "encounterId")] public long? QueryEncounterId { get; set; }
    private List<DoctorsProfile> doctors = [];
    private List<PatientEncounter> queue = [];
    private List<PatientEncounter> previousVisits = [];
    private List<Prescription> recentPrescriptions = [];
    private List<ClinicalOrderSummary> recentOrders = [];
    private PatientEncounter? selected;
    private DateTime queueDate = DateTime.Today;
    private int doctorId;
    private int? currentDoctorProfileId;
    private bool isDoctor;
    private bool canClinicalDecision;
    private bool isSaving;
    private bool hasUnsavedChanges;
    private DateTime? lastSavedAt;
    private readonly CancellationTokenSource autoSaveCts = new();
    private string searchQuery = "";
    private string statusFilter = "Active";
    private string message = "", messageClass = "success";

    private List<PatientEncounter> FilteredQueue => queue.Where(x =>
                (statusFilter == "All" || (statusFilter == "Active" && (x.Status is EncounterStatuses.Waiting or EncounterStatuses.InConsultation)) || x.Status == statusFilter) &&
                (string.IsNullOrWhiteSpace(searchQuery) ||
                (x.PatientName?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.PatientID?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                x.QueueNo.ToString().Contains(searchQuery.Trim()))).ToList();

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        var principal = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        isDoctor = principal.IsInRole(RoleNames.Doctor);
        if (int.TryParse(principal.FindFirstValue(AppUserClaimsPrincipalFactory.DoctorProfileIdClaim), out var mappedDoctorId))
            currentDoctorProfileId = mappedDoctorId;
        canClinicalDecision = principal.IsInRole(RoleNames.Administrator) || (isDoctor && currentDoctorProfileId.HasValue);
        if (isDoctor && !currentDoctorProfileId.HasValue)
            Fail(I18n.T("This Doctor account is not linked to a Doctors Profile. Contact an administrator."));
        await using var db = await DbFactory.CreateDbContextAsync();
        doctors = await db.Doctors.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
        if (currentDoctorProfileId.HasValue) doctorId = currentDoctorProfileId.Value;
        await LoadAsync();
        if (QueryEncounterId is > 0)
        {
            var requested = queue.FirstOrDefault(x => x.ID == QueryEncounterId.Value);
            if (requested is not null) await SelectAsync(requested);
        }
        _ = RunAutoSaveAsync(autoSaveCts.Token);
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var query = db.PatientEncounters.AsNoTracking().Where(x => x.VisitDate == queueDate.Date);
        if (isDoctor && !currentDoctorProfileId.HasValue) { queue = []; selected = null; return; }
        if (currentDoctorProfileId.HasValue) query = query.Where(x => x.DoctorID == currentDoctorProfileId.Value);
        else if (doctorId > 0) query = query.Where(x => x.DoctorID == doctorId);
        queue = await query.OrderBy(x => x.Status == EncounterStatuses.InConsultation ? 0 : x.Status == EncounterStatuses.Waiting ? 1 : 2)
            .ThenBy(x => x.QueueNo).ToListAsync();
        if (selected is not null)
        {
            var refreshed = queue.FirstOrDefault(x => x.ID == selected.ID);
            selected = refreshed is null ? null : Clone(refreshed);
        }
    }

    private async Task SelectAsync(PatientEncounter item)
    {
        selected = Clone(item);
        hasUnsavedChanges = false;
        lastSavedAt = item.DraftSavedAt;
        await LoadPatientContextAsync(item);
    }

    private async Task SelectNextWaitingAsync()
    {
        var next = queue.Where(x => x.Status == EncounterStatuses.Waiting).OrderBy(x => x.Priority == "Emergency" ? 0 : x.Priority == "Urgent" ? 1 : 2).ThenBy(x => x.QueueNo).FirstOrDefault();
        if (next is not null) await SelectAsync(next);
    }

    private async Task LoadPatientContextAsync(PatientEncounter encounter)
    {
        previousVisits = [];
        recentPrescriptions = [];
        recentOrders = [];
        if (string.IsNullOrWhiteSpace(encounter.PatientID)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        previousVisits = await db.PatientEncounters.AsNoTracking()
            .Where(x => x.PatientID == encounter.PatientID && x.ID != encounter.ID)
            .OrderByDescending(x => x.VisitDate).Take(10).ToListAsync();
        recentPrescriptions = await db.Prescriptions.AsNoTracking()
            .Where(x => x.PatientID == encounter.PatientID)
            .OrderByDescending(x => x.VisitDate).ThenByDescending(x => x.ID).Take(5).ToListAsync();
        var orders = await db.DiagnosticOrders.AsNoTracking().Include(x => x.Items)
            .Where(x => x.PatientID == encounter.PatientID && x.Status != "Cancelled")
            .OrderByDescending(x => x.OrderedAt).Take(5).ToListAsync();
        var memoIds = orders.Where(x => x.BilledMemoID.HasValue).Select(x => x.BilledMemoID!.Value).ToArray();
        var samples = memoIds.Length == 0 ? [] : await db.LabSampleCollections.AsNoTracking().Where(x => memoIds.Contains(x.MemoID)).ToListAsync();
        recentOrders = orders.Select(x =>
        {
            var linkedSamples = x.BilledMemoID.HasValue ? samples.Where(s => s.MemoID == x.BilledMemoID.Value).ToList() : [];
            var status = x.Status == "Pending" ? "Awaiting billing" : linkedSamples.Count == 0 ? "Billed" : linkedSamples.All(s => s.Status == "Completed") ? "Result ready" : linkedSamples.Any(s => s.Status == "InProcess") ? "Processing" : linkedSamples.Any(s => s.Status == "Collected") ? "Sample collected" : "Awaiting sample";
            return new ClinicalOrderSummary(status, $"{x.Items.Count} investigation(s) · {x.OrderedAt:dd MMM}");
        }).ToList();
    }

    private async Task StartAsync() => await PersistAsync(EncounterStatuses.InConsultation);
    private async Task MarkNoShowAsync() => await PersistAsync(EncounterStatuses.NoShow);
    private async Task CompleteAsync()
    {
        if (string.IsNullOrWhiteSpace(selected?.Diagnosis))
        {
            Fail(I18n.IsBangla ? "ভিজিট সম্পন্ন করতে রোগ নির্ণয় লিখুন।" : "Diagnosis is required to complete the visit.");
            return;
        }
        if (selected.FollowUpRequired && !selected.FollowUpDate.HasValue)
        {
            Fail("Select a follow-up date before completing the visit.");
            return;
        }
        await PersistAsync(EncounterStatuses.Completed);
    }
    private async Task SaveAsync() => await PersistAsync(null);

    private async Task PersistAsync(string? nextStatus, bool autoSave = false)
    {
        if (selected is null || isSaving) return;
        if (nextStatus is not null && !canClinicalDecision)
        {
            Fail(I18n.T("Only the assigned doctor can change consultation status."));
            return;
        }

        isSaving = true;
        try
        {
            var selectedId = selected.ID;
            var curSelected = Clone(selected);
            var userId = await CurrentUserIdAsync();

            await using var strategyDb = await DbFactory.CreateDbContextAsync();
            var strategy = strategyDb.Database.CreateExecutionStrategy();
            PatientEncounter? updatedEntity = null;

            await strategy.ExecuteAsync(async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                await using var tx = await db.Database.BeginTransactionAsync(System.Data.IsolationLevel.Serializable);

                var entity = await db.PatientEncounters.SingleAsync(x => x.ID == selectedId);
                if (currentDoctorProfileId.HasValue && entity.DoctorID != currentDoctorProfileId.Value)
                    throw new InvalidOperationException("This encounter belongs to another doctor.");
                if (nextStatus is not null && !ClinicalEncounterWorkflow.CanTransition(entity.Status, nextStatus))
                    throw new InvalidOperationException($"Invalid encounter transition from {entity.Status} to {nextStatus}.");

                CopyClinical(curSelected, entity);
                if (nextStatus == EncounterStatuses.InConsultation) { entity.Status = nextStatus; entity.StartedAt = DateTime.Now; entity.StartedBy = userId; }
                if (nextStatus == EncounterStatuses.Completed) { entity.Status = nextStatus; entity.CompletedAt = DateTime.Now; entity.CompletedBy = userId; }
                if (nextStatus == EncounterStatuses.NoShow) entity.Status = nextStatus;
                entity.DraftSavedAt = DateTime.Now;
                entity.UpdatedAt = DateTime.Now;

                if (entity.AppointmentID.HasValue)
                {
                    var appointment = await db.DoctorAppointments.FindAsync(entity.AppointmentID.Value);
                    if (appointment is not null)
                        appointment.Status = nextStatus == EncounterStatuses.InConsultation ? "InConsultation" : nextStatus == EncounterStatuses.Completed ? "Completed" : appointment.Status;
                }

                await db.SaveChangesAsync();
                await tx.CommitAsync();
                updatedEntity = entity;
            });

            hasUnsavedChanges = false;
            lastSavedAt = DateTime.Now;
            if (!autoSave) Success(nextStatus is null ? I18n.T("Clinical notes saved.") : $"Visit status changed to {nextStatus}.");
            await LoadAsync();
            var refreshed = queue.FirstOrDefault(x => x.ID == selectedId);
            selected = refreshed is null ? null : Clone(refreshed);
        }
        catch (Exception ex)
        {
            Fail(ex.GetBaseException().Message);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void MarkDirty()
    {
        if (selected is null) return;
        if (selected.FollowUpRequired && !selected.FollowUpDate.HasValue) selected.FollowUpDate = DateTime.Today.AddDays(7);
        if (!selected.FollowUpRequired) { selected.FollowUpDate = null; selected.FollowUpReason = null; }
        hasUnsavedChanges = true;
    }

    private async Task RunAutoSaveAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(15), cancellationToken);
                if (hasUnsavedChanges && !isSaving && selected?.Status is EncounterStatuses.Waiting or EncounterStatuses.InConsultation)
                    await InvokeAsync(() => PersistAsync(null, true));
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task<int> CurrentUserIdAsync()
    {
        var principal = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        return int.TryParse(principal.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : 1;
    }

    private static void CopyClinical(PatientEncounter from, PatientEncounter to)
    {
        to.BloodPressure = from.BloodPressure?.Trim();
        to.Pulse = from.Pulse?.Trim();
        to.Temperature = from.Temperature?.Trim();
        to.OxygenSaturation = from.OxygenSaturation?.Trim();
        to.HeightCm = from.HeightCm;
        to.WeightKg = from.WeightKg;
        to.Allergies = from.Allergies?.Trim();
        to.ChiefComplaint = from.ChiefComplaint?.Trim();
        to.ClinicalNotes = from.ClinicalNotes?.Trim();
        to.Diagnosis = from.Diagnosis?.Trim();
        to.Advice = from.Advice?.Trim();
        to.Priority = from.Priority;
        to.FollowUpRequired = from.FollowUpRequired;
        to.FollowUpDate = from.FollowUpRequired ? from.FollowUpDate?.Date : null;
        to.FollowUpReason = from.FollowUpRequired ? from.FollowUpReason?.Trim() : null;
        if (!from.FollowUpRequired) to.FollowUpCompletedAt = null;
    }

    private static PatientEncounter Clone(PatientEncounter x) => new()
    {
        ID = x.ID,
        PatientID = x.PatientID,
        PatientName = x.PatientName,
        Age = x.Age,
        Sex = x.Sex,
        DoctorID = x.DoctorID,
        DepartmentID = x.DepartmentID,
        AppointmentID = x.AppointmentID,
        TicketID = x.TicketID,
        VisitType = x.VisitType,
        Status = x.Status,
        QueueNo = x.QueueNo,
        VisitDate = x.VisitDate,
        CheckedInAt = x.CheckedInAt,
        StartedAt = x.StartedAt,
        CompletedAt = x.CompletedAt,
        BloodPressure = x.BloodPressure,
        Pulse = x.Pulse,
        Temperature = x.Temperature,
        OxygenSaturation = x.OxygenSaturation,
        HeightCm = x.HeightCm,
        WeightKg = x.WeightKg,
        Allergies = x.Allergies,
        ChiefComplaint = x.ChiefComplaint,
        ClinicalNotes = x.ClinicalNotes,
        Diagnosis = x.Diagnosis,
        Advice = x.Advice,
        Priority = x.Priority,
        FollowUpRequired = x.FollowUpRequired,
        FollowUpDate = x.FollowUpDate,
        FollowUpReason = x.FollowUpReason,
        FollowUpCompletedAt = x.FollowUpCompletedAt,
        DraftSavedAt = x.DraftSavedAt,
        CreatedBy = x.CreatedBy,
        StartedBy = x.StartedBy,
        CompletedBy = x.CompletedBy,
        CreatedAt = x.CreatedAt,
        UpdatedAt = x.UpdatedAt
    };

    private string DoctorName(int id)
    {
        var d = doctors.FirstOrDefault(x => x.ID == id);
        return d is null ? "Doctor" : $"{d.Title} {d.Name}".Trim();
    }

    private void Success(string text) { messageClass = "success"; message = text; }
    private void Fail(string text) { messageClass = "danger"; message = text; }
    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);
    private static string ShortText(string? value, int length) => string.IsNullOrWhiteSpace(value) ? "No record" : value.Length <= length ? value : value[..length] + "…";
    public void Dispose() { autoSaveCts.Cancel(); autoSaveCts.Dispose(); I18n.OnLanguageChanged -= HandleLanguageChanged; }
    private sealed record ClinicalOrderSummary(string Status, string Description);
}
