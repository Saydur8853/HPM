@page "/pharmacy/pos"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.PharmacyOperator + "," + RoleNames.Cashier)]
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject IBarcodeQrService BarcodeQr
@inject UserWorkspacePreferences WorkspacePrefs
@implements IDisposable
@using System.Security.Claims
@using System.Data
@using HPM.Web.Components.Common

<PageTitle>@I18n.T("Medicine Sale (POS)") | @Branding.HospitalName</PageTitle>

<div class="pharmacy-classic-fit px-root">
    <!-- Topbar -->
    <div class="px-topbar">
        <div class="px-topbar-left">
            <h1 class="px-title">@I18n.T("Medicine Sale (POS)")</h1>
            <div class="px-seg">
                <button type="button" class="@(patientType == "1" ? "on" : "")" disabled="@(savedMemo != null)" @onclick='() => SetPatientType("1")'>@I18n.T("OPD / Walk-in")</button>
                <button type="button" class="@(patientType == "2" ? "on" : "")" disabled="@(savedMemo != null)" @onclick='() => SetPatientType("2")'>@I18n.T("IPD Patient")</button>
            </div>
        </div>

        <label class="px-store-chip @(savedMemo == null && lines.Count > 0 ? "locked" : "")"
               title="@(savedMemo == null && lines.Count > 0 ? I18n.T("Clear the cart to change store") : I18n.T("Your store stays selected until you sign out"))">
            <span class="px-store-label">🏪 @I18n.T("Store")</span>
            <select @bind="storeId" @bind:after="OnStoreChangedAsync" disabled="@(savedMemo != null || lines.Count > 0)">
                @foreach (var x in stores.Where(x => x.IsActive))
                {
                    <option value="@x.ID">@x.Name</option>
                }
            </select>
        </label>

        <div class="px-topbar-right">
            <div class="px-metric"><span>@I18n.T("Today's Bills")</span><b>@recent.Count</b></div>
            <div class="px-metric"><span>@I18n.T("Today's Total")</span><b class="ok">@I18n.FormatCurrency(recent.Sum(x => (x.Total ?? 0) - (x.Discount ?? 0)))</b></div>
            <NavLink class="px-btn ghost" href="/pharmacy/sales-returns">↩ @I18n.T("Customer Return")</NavLink>
            <button type="button" class="px-btn" @onclick="Reset">+ @I18n.T("New Sale")</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="px-alert @messageClass">
            <span>@message</span>
            <button type="button" @onclick='() => message = ""'>✕</button>
        </div>
    }

    <div class="pharmacy-classic-workspace">
        <!-- Left: Bill -->
        <section class="px-card">
            <header class="px-card-head">
                <div class="px-card-title">
                    <h2>@(savedMemo == null ? I18n.T("Current Bill") : $"{I18n.T("Bill")} #PH-{savedMemo.ID}")</h2>
                    <span class="px-badge @(savedMemo == null ? "new" : savedMemo.IsCredit == true ? "credit" : "paid")">
                        @(savedMemo != null ? (savedMemo.IsCredit == true ? I18n.T("ADDED TO BED BILL") : I18n.T("PAID")) : I18n.T("NEW"))
                    </span>
                </div>
                @if (savedMemo == null)
                {
                    <div class="px-scan">
                        <span class="px-scan-icon">⌁</span>
                        <input type="text"
                               @ref="scanInputRef"
                               placeholder="@I18n.T("Scan barcode / RX-ID / wristband  [F4]")"
                               @bind="posScanQuery"
                               @bind:event="oninput"
                               @onkeydown="HandlePosScanKeyDown"
                               autocomplete="off" />
                        @if (!string.IsNullOrWhiteSpace(posScanQuery))
                        {
                            <button type="button" class="px-x" @onclick="ClearPosScan">✕</button>
                        }
                    </div>
                }
            </header>

            <div class="px-card-body">
                <!-- Customer / patient -->
                @if (patientType == "1")
                {
                    <div class="px-panel px-grid-2">
                        <label class="px-field">
                            <span>@I18n.T("Customer Name") <i>*</i></span>
                            <input @bind="customerName" maxlength="50" disabled="@(savedMemo != null)" onfocus="this.select()" />
                        </label>
                        <label class="px-field">
                            <span>@I18n.T("Mobile (Optional)")</span>
                            <input @bind="contact" maxlength="20" inputmode="tel" placeholder="01XXXXXXXXX" disabled="@(savedMemo != null)" />
                        </label>
                    </div>
                }
                else
                {
                    <div class="px-panel px-grid-ipd">
                        <div class="px-field">
                            <span>@I18n.T("Admitted Patient") <i>*</i></span>
                            @if (savedMemo != null)
                            {
                                <input value="@($"{customerName} ({regNo})")" disabled />
                            }
                            else if (!string.IsNullOrWhiteSpace(regNo))
                            {
                                <div class="px-selected">
                                    <span class="px-bed">@(string.IsNullOrWhiteSpace(selectedBedName) ? "IPD" : selectedBedName)</span>
                                    <b>@customerName</b>
                                    <small>@regNo</small>
                                    <button type="button" @onclick="ClearIpdPatient">@I18n.T("Change")</button>
                                </div>
                            }
                            else
                            {
                                <div class="px-typeahead">
                                    <input type="text"
                                           placeholder="@I18n.T("Search bed / cabin, name, reg # or mobile...")"
                                           @bind="ipdSearchQuery"
                                           @bind:event="oninput"
                                           @bind:after="() => highlightedIpdIndex = 0"
                                           @onfocus="() => showIpdSuggestions = true"
                                           @onblur="() => showIpdSuggestions = false"
                                           @onkeydown="HandleIpdKeyDown"
                                           autocomplete="off" />
                                    @if (showIpdSuggestions)
                                    {
                                        var ipdList = FilteredInpatients;
                                        <div class="px-dropdown" id="px-ipd-dd">
                                            @if (ipdList.Count == 0)
                                            {
                                                <div class="px-dd-empty">@I18n.T("No admitted patient matches") “@ipdSearchQuery”</div>
                                            }
                                            @for (var i = 0; i < ipdList.Count; i++)
                                            {
                                                var adm = ipdList[i];
                                                <div class="px-dd-item @(i == highlightedIpdIndex ? "is-active" : "")" @onmousedown:preventDefault @onclick="() => SelectInpatient(adm)">
                                                    <div class="px-dd-main">
                                                        <div class="px-dd-name">@Hl(adm.PatientName, ipdTokens)</div>
                                                        <div class="px-dd-sub">@I18n.T("Reg"): <b>@Hl(adm.RegNo, ipdTokens)</b>@(string.IsNullOrWhiteSpace(adm.Contact) ? "" : " · ")@Hl(adm.Contact, ipdTokens)</div>
                                                    </div>
                                                    <span class="px-bed">@Hl(adm.BedName, ipdTokens)</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="px-field">
                            <span>@I18n.T("Billing Mode")</span>
                            <div class="px-seg full">
                                <button type="button" class="@(ipdPaymentMode == "credit" ? "on" : "")" disabled="@(savedMemo != null)" @onclick='() => ipdPaymentMode = "credit"'>@I18n.T("Add to Bed Bill")</button>
                                <button type="button" class="@(ipdPaymentMode == "cash" ? "on" : "")" disabled="@(savedMemo != null)" @onclick='() => ipdPaymentMode = "cash"'>@I18n.T("Cash Paid")</button>
                            </div>
                        </div>
                    </div>
                }

                @if (savedMemo == null)
                {
                    @if (loadedPrescriptionId.HasValue)
                    {
                        <div class="px-rx-strip">
                            <span>📄 <b>@I18n.T("Loaded Prescription"):</b> @prescriptionLabel</span>
                            <button type="button" @onclick="ClearLoadedPrescription">✕</button>
                        </div>
                    }

                    @if (rxShortages.Count > 0)
                    {
                        <div class="px-short-box">
                            <div class="px-short-head">
                                <span>⚠️ @I18n.T("Prescribed but not in stock") (@rxShortages.Count) — @I18n.T("pick a same-generic alternative")</span>
                                <button type="button" title="@I18n.T("Dismiss")" @onclick="() => rxShortages = []">✕</button>
                            </div>
                            @foreach (var sh in rxShortages.ToList())
                            {
                                var shortage = sh;
                                var shMed = medicineById.GetValueOrDefault(shortage.ServiceId);
                                var shGeneric = shMed?.GenericID is int sg && genericNames.TryGetValue(sg, out var sgn) ? sgn : "";
                                var alts = AlternativesFor(shortage.ServiceId);
                                var elsewhere = OtherStoreStock(shortage.ServiceId);
                                <div class="px-short-row">
                                    <div class="px-short-title">
                                        <b>@MedicineName(shortage.ServiceId)</b>
                                        @if (!string.IsNullOrWhiteSpace(shGeneric))
                                        {
                                            <small>(@shGeneric)</small>
                                        }
                                        <span class="px-stock out">@I18n.T("Need") @shortage.Needed.ToString("0.##")</span>
                                        @if (elsewhere.Count > 0)
                                        {
                                            <small>🏪 @I18n.T("Available at"): @string.Join(", ", elsewhere.Select(e => $"{e.Store} ({e.Qty:N0})"))</small>
                                        }
                                    </div>
                                    <div class="px-short-alts">
                                        @if (alts.Count == 0)
                                        {
                                            <span class="px-short-none">@I18n.T("No same-generic alternative in stock.")</span>
                                        }
                                        @foreach (var a in alts)
                                        {
                                            var alt = a;
                                            <button type="button" class="px-short-alt" @onclick="() => UseAlternative(shortage, alt)" title="@I18n.T("Add to bill in place of the prescribed medicine")">
                                                + @alt.Name
                                                <span>@I18n.T("Stock") @Available(alt.ID).ToString("N0") · @I18n.FormatCurrency(alt.SaleRate ?? 0)</span>
                                            </button>
                                        }
                                        <button type="button" class="px-link" @onclick="() => SearchForShortageAsync(shortage)">🔍 @I18n.T("Search others")</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!-- Medicine entry -->
                    <div class="px-entry">
                        <div class="px-field px-entry-search">
                            <span>
                                @I18n.T("Search Medicine") <i>*</i>
                                <em>@I18n.T("brand, generic, type or code — multiple words allowed")</em>
                            </span>
                            <div class="px-typeahead">
                                <div class="px-search-box @(selectedMedObj != null ? "picked" : "")">
                                    <span class="px-search-icon">🔍</span>
                                    <input type="text"
                                           @ref="medSearchInputRef"
                                           placeholder="@I18n.T("e.g. napa 500, paracetamol, omep cap...  [F2]")"
                                           @bind="medSearchQuery"
                                           @bind:event="oninput"
                                           @bind:after="OnMedSearchInput"
                                           @onkeydown="HandleMedSearchKeyDown"
                                           @onfocus="() => showMedSuggestions = true"
                                           @onblur="() => showMedSuggestions = false"
                                           autocomplete="off" />
                                    @if (!string.IsNullOrWhiteSpace(medSearchQuery))
                                    {
                                        <button type="button" class="px-x" @onclick="ClearMedSearch">✕</button>
                                    }
                                </div>

                                @if (showMedSuggestions && medTokens.Length > 0 && selectedMedObj == null)
                                {
                                    <div class="px-dropdown wide" id="px-med-dd">
                                        <div class="px-dd-head">
                                            <span>@medMatchCount @I18n.T("match(es)") @(medMatchCount > medResults.Count ? $"· {I18n.T("showing")} {medResults.Count}" : "")</span>
                                            <span class="px-dd-keys">↑↓ @I18n.T("move") · Enter @I18n.T("select") · Esc @I18n.T("close")</span>
                                        </div>
                                        @if (medResults.Count == 0)
                                        {
                                            <div class="px-dd-empty">
                                                @I18n.T("No medicine found for") “@medSearchQuery”
                                                @if (inStockOnly)
                                                {
                                                    <button type="button" class="px-link" @onmousedown:preventDefault @onclick="ToggleInStockOnly">@I18n.T("Show out-of-stock too")</button>
                                                }
                                            </div>
                                        }
                                        @for (var i = 0; i < medResults.Count; i++)
                                        {
                                            var hit = medResults[i];
                                            var idx = i;
                                            <div class="px-dd-item @(i == highlightedMedIndex ? "is-active" : "") @(hit.Stock > 0 ? "" : "dim")"
                                                 @onmousedown:preventDefault
                                                 @onmouseover="() => highlightedMedIndex = idx"
                                                 @onclick="() => SelectMedicineAsync(hit.Med)">
                                                <div class="px-dd-main">
                                                    <div class="px-dd-name">
                                                        @Hl(hit.Med.Name, medTokens)
                                                        @if (!string.IsNullOrWhiteSpace(hit.Type))
                                                        {
                                                            <span class="px-type">@Hl(hit.Type, medTokens)</span>
                                                        }
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(hit.Generic) || !string.IsNullOrWhiteSpace(hit.Med.Sku))
                                                    {
                                                        <div class="px-dd-sub">
                                                            @if (!string.IsNullOrWhiteSpace(hit.Generic))
                                                            {
                                                                <span>@Hl(hit.Generic, medTokens)</span>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(hit.Med.Sku))
                                                            {
                                                                <span class="px-code">#@Hl(hit.Med.Sku, medTokens)</span>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                                <div class="px-dd-side">
                                                    <b>@I18n.FormatCurrency(hit.Med.SaleRate ?? 0)</b>
                                                    <span class="px-stock @(hit.Stock > 0 ? (hit.Stock <= 10 ? "low" : "ok") : "out")">
                                                        @(hit.Stock > 0 ? $"{I18n.T("Stock")} {hit.Stock:N0}" : I18n.T("Out of stock"))
                                                    </span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        <label class="px-field px-entry-qty">
                            <span>@I18n.T("Qty") <i>*</i></span>
                            <input type="number" @ref="qtyInputRef" min="1" step="1" @bind="lineQuantity" @bind:event="oninput" @onkeydown="HandleQtyKeyDown" />
                        </label>
                        <label class="px-field px-entry-rate">
                            <span>@I18n.T("Unit Price")</span>
                            <input type="number" min="0" step="0.01" @bind="lineRate" @onkeydown="HandleQtyKeyDown" />
                        </label>
                        <div class="px-entry-actions">
                            <button type="button" class="px-btn primary" @onclick="AddLineAndRefocusAsync" disabled="@(selectedMedObj == null)">+ @I18n.T("Add")</button>
                        </div>

                        <div class="px-entry-foot">
                            <label class="px-check">
                                <input type="checkbox" checked="@inStockOnly" @onchange="ToggleInStockOnly" />
                                <span>@I18n.T("In-stock only")</span>
                            </label>
                            @if (selectedMedObj != null)
                            {
                                var selStock = Available(selectedMedObj.ID);
                                <span class="px-picked-info">
                                    <b>@selectedMedObj.Name</b>
                                    <span class="px-stock @(selStock > 0 ? (selStock <= 10 ? "low" : "ok") : "out")">@I18n.T("Available"): @selStock.ToString("N0")</span>
                                    @if (selectedMedObj.GenericID.HasValue && genericAlternatives.Count > 0)
                                    {
                                        <button type="button" class="px-link" @onclick="() => showGenericAlternatives = !showGenericAlternatives">
                                            @I18n.T("Same generic") (@genericAlternatives.Count)
                                        </button>
                                    }
                                </span>
                            }
                            else
                            {
                                <span class="px-hint"><kbd>F2</kbd> @I18n.T("search") <kbd>Enter</kbd> @I18n.T("add") <kbd>F9</kbd> @I18n.T("save & print")</span>
                            }
                        </div>
                    </div>

                    @if (showGenericAlternatives && genericAlternatives.Count > 0)
                    {
                        <div class="px-alt-box">
                            <div class="px-alt-head">
                                <span>💡 @I18n.T("Same generic in stock") — @(selectedMedObj?.GenericID.HasValue == true && genericNames.TryGetValue(selectedMedObj.GenericID.Value, out var gen) ? gen : "")</span>
                                <button type="button" @onclick="() => showGenericAlternatives = false">✕</button>
                            </div>
                            <div class="px-alt-list">
                                @foreach (var alt in genericAlternatives.Take(6))
                                {
                                    <button type="button" class="px-alt-item" @onclick="() => SelectMedicineAsync(alt)">
                                        <b>@alt.Name</b>
                                        <span>@I18n.T("Stock") @Available(alt.ID).ToString("N0") · @I18n.FormatCurrency(alt.SaleRate ?? 0)</span>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                }

                <!-- Cart -->
                <div class="px-cart">
                    <div class="px-cart-head">
                        <div>#</div>
                        <div>@I18n.T("Medicine")</div>
                        <div class="r">@I18n.T("Stock")</div>
                        <div class="c">@I18n.T("Qty")</div>
                        <div class="r">@I18n.T("Rate")</div>
                        <div class="r">@I18n.T("Amount")</div>
                        <div></div>
                    </div>
                    <div class="px-cart-rows">
                        @if (lines.Count == 0)
                        {
                            <div class="px-empty">
                                <div class="px-empty-icon">🛒</div>
                                <div>@I18n.T("Cart is empty")</div>
                                <small>@I18n.T("Search a medicine above, scan a barcode, or load a prescription from the right panel.")</small>
                            </div>
                        }
                        @for (var i = 0; i < lines.Count; i++)
                        {
                            var index = i;
                            var x = lines[i];
                            <div class="px-cart-row">
                                <div class="muted">@(i + 1)</div>
                                <div class="px-cart-name">
                                    <b>@MedicineName(x.ServiceID)</b>
                                    @if (!string.IsNullOrWhiteSpace(x.BatchNo))
                                    {
                                        <small>B: @x.BatchNo</small>
                                    }
                                    @if (x.PrescriptionMedicineID.HasValue)
                                    {
                                        <small class="rx">Rx</small>
                                    }
                                </div>
                                <div class="r muted">@(savedMemo == null ? Available(x.ServiceID).ToString("N0") : "—")</div>
                                <div class="c">
                                    @if (savedMemo == null)
                                    {
                                        <div class="px-stepper">
                                            <button type="button" @onclick="() => StepLineQty(index, -1)">−</button>
                                            <input type="number" min="1" value="@x.Quantity.ToString("0.##")" @onchange="e => SetLineQty(index, e.Value?.ToString())" />
                                            <button type="button" @onclick="() => StepLineQty(index, 1)">+</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <b>@x.Quantity.ToString("0.##")</b>
                                    }
                                </div>
                                <div class="r">@I18n.FormatCurrency(x.Rate)</div>
                                <div class="r strong">@I18n.FormatCurrency(x.Total)</div>
                                <div class="c">
                                    @if (savedMemo == null)
                                    {
                                        <button type="button" class="px-del" @onclick="() => RemoveLine(index)" title="@I18n.T("Remove")">✕</button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Payment + totals -->
                <div class="px-pay">
                    @if (CollectsPayment)
                    {
                        <div class="px-tender @(IsCashPayment ? "" : "noncash")">
                            <div class="px-field px-pay-method">
                                <span>@I18n.T("Payment Method")</span>
                                @if (addingPaymentMethod)
                                {
                                    <div class="px-inline-add">
                                        <input @ref="newMethodInputRef" @bind="newPaymentMethodName" @bind:event="oninput" maxlength="40"
                                               placeholder="@I18n.T("e.g. Card, bKash")" @onkeydown="HandleNewMethodKeyDown" />
                                        <button type="button" class="px-btn primary" title="@I18n.T("Save method")" @onclick="AddPaymentMethodAsync">✓</button>
                                        <button type="button" class="px-btn" title="@I18n.T("Cancel")" @onclick="CancelAddPaymentMethod">✕</button>
                                    </div>
                                }
                                else
                                {
                                    <select value="@paymentMethod" @onchange="OnPaymentMethodChangedAsync" disabled="@(savedMemo != null)">
                                        @foreach (var pm in paymentMethods)
                                        {
                                            <option value="@pm.Name">@PaymentIcon(pm.Name) @pm.Name</option>
                                        }
                                        @if (!paymentMethods.Any(x => x.Name == paymentMethod))
                                        {
                                            <option value="@paymentMethod">@paymentMethod</option>
                                        }
                                        @if (savedMemo == null)
                                        {
                                            <option value="@NewMethodOption">＋ @I18n.T("Add new method…")</option>
                                        }
                                    </select>
                                }
                            </div>

                            @if (IsCashPayment)
                            {
                                <label class="px-field px-cash-given">
                                    <span>@I18n.T("Cash Given")</span>
                                    <input type="number" min="0" step="1" @ref="tenderInputRef" @bind="tenderedAmount" @bind:event="oninput" placeholder="0" disabled="@(savedMemo != null)" />
                                </label>
                                @if (savedMemo == null)
                                {
                                    <div class="px-chips">
                                        <button type="button" @onclick="SetExactCash">@I18n.T("Exact")</button>
                                        @foreach (var note in new[] { 100, 200, 500, 1000 })
                                        {
                                            var n = note;
                                            <button type="button" @onclick="() => SetQuickCash(n)">@n</button>
                                        }
                                    </div>
                                }
                                <div class="px-change @(ChangeDue > 0 ? "has" : "")">
                                    <span>@I18n.T("Change")</span>
                                    <b>@I18n.FormatCurrency(ChangeDue)</b>
                                </div>
                            }
                            else
                            {
                                <div class="px-field px-paid-amount">
                                    <span>@I18n.T("Amount Received")</span>
                                    <div class="px-paid-value">@I18n.FormatCurrency(Net)</div>
                                </div>
                                <label class="px-field px-ref">
                                    <span>@I18n.T("Ref. / Note") <em>@I18n.T("optional")</em></span>
                                    <input type="text" @bind="paymentRef" maxlength="100" disabled="@(savedMemo != null)"
                                           placeholder="@I18n.T("Txn ID, card slip no., sender number...")" />
                                </label>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="px-tender info">
                            🛏️ @I18n.T("This bill will be added to the patient's IPD bed bill. No cash is collected now.")
                        </div>
                    }

                    <div class="px-totals">
                        <div><span>@I18n.T("Items")</span><b>@lines.Count (@lines.Sum(x => x.Quantity).ToString("0.##") @I18n.T("units"))</b></div>
                        <div><span>@I18n.T("Sub Total")</span><b>@I18n.FormatCurrency(Gross)</b></div>
                        <label>
                            <span>@I18n.T("Discount")</span>
                            <input type="number" min="0" step="1" @bind="discount" disabled="@(savedMemo != null)" />
                        </label>
                        <div class="grand">
                            <span>@(patientType == "2" && ipdPaymentMode == "credit" ? I18n.T("Bed Bill Total") : I18n.T("Net Payable"))</span>
                            <b>@I18n.FormatCurrency(Net)</b>
                        </div>
                    </div>
                </div>
            </div>

            <footer class="px-card-foot">
                <div class="px-print-fmt">
                    <span>@I18n.T("Print")</span>
                    <div class="px-seg">
                        <button type="button" class="@(isThermalPrint ? "on" : "")" @onclick="() => isThermalPrint = true">80mm</button>
