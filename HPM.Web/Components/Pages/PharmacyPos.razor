    private void CancelAddPaymentMethod()
    {
        addingPaymentMethod = false;
        newPaymentMethodName = "";
    }

    private async Task AddPaymentMethodAsync()
    {
        var name = (newPaymentMethodName ?? "").Trim();
        if (name.Length < 2 || name.Length > 40 || name == NewMethodOption)
        {
            ShowError(I18n.IsBangla ? "পেমেন্ট মেথড যোগ করা যায়নি" : "Cannot add payment method",
                I18n.IsBangla ? "নাম ২ থেকে ৪০ অক্ষরের মধ্যে হতে হবে।" : "Name must be 2 to 40 characters.");
            return;
        }
        var existing = paymentMethods.FirstOrDefault(x => string.Equals(x.Name, name, StringComparison.OrdinalIgnoreCase));
        if (existing == null)
        {
            try
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                var dbExisting = await db.PharmacyPaymentMethods.FirstOrDefaultAsync(x => x.Name == name);
                if (dbExisting == null)
                {
                    var nextOrder = (await db.PharmacyPaymentMethods.MaxAsync(x => (int?)x.SortOrder) ?? 0) + 1;
                    db.PharmacyPaymentMethods.Add(new PharmacyPaymentMethod { Name = name, IsActive = true, SortOrder = nextOrder });
                }
                else dbExisting.IsActive = true;
                await db.SaveChangesAsync();
                paymentMethods = await db.PharmacyPaymentMethods.AsNoTracking().Where(x => x.IsActive).OrderBy(x => x.SortOrder).ThenBy(x => x.Name).ToListAsync();
                existing = paymentMethods.FirstOrDefault(x => string.Equals(x.Name, name, StringComparison.OrdinalIgnoreCase));
            }
            catch (Exception ex)
            {
                ShowError(I18n.IsBangla ? "পেমেন্ট মেথড যোগ করা যায়নি" : "Cannot add payment method", RootMessage(ex));
                return;
            }
        }
        addingPaymentMethod = false;
        newPaymentMethodName = "";
        paymentMethod = existing?.Name ?? name;
        tenderedAmount = IsCashPayment ? null : Net;
        Success(I18n.IsBangla ? $"পেমেন্ট মেথড \"{paymentMethod}\" নির্বাচিত।" : $"Payment method \"{paymentMethod}\" added and selected.");
    }

