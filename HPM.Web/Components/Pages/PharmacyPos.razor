        }
    }

    // ---------- Store (kept per user until sign-out) ----------
    private int ResolveStoreId()
    {
        var active = stores.Where(x => x.IsActive).ToList();
        if (preferredStoreId.HasValue && active.Any(x => x.ID == preferredStoreId.Value)) return preferredStoreId.Value;
        return active.FirstOrDefault()?.ID ?? stores.FirstOrDefault()?.ID ?? 0;
    }

    private Task OnStoreChangedAsync()
    {
        preferredStoreId = storeId;
        WorkspacePrefs.SetInt(currentUserId, UserWorkspacePreferences.PharmacyStoreKey, storeId);
        RefreshMedResults();
        if (selectedMedObj != null) CheckGenericAlternatives(selectedMedObj);
        Success(I18n.IsBangla
            ? $"স্টোর নির্বাচন করা হয়েছে: {stores.FirstOrDefault(x => x.ID == storeId)?.Name}"
            : $"Store set to {stores.FirstOrDefault(x => x.ID == storeId)?.Name}. It stays selected until you sign out.");
        return Task.CompletedTask;
    }

