        return ex.Message;
    }

    /// <summary>
    /// Legacy data has item rows in Cash_Memo_Sub whose header bill never existed. If the Cash_Memo identity
    /// would hand out one of those bill numbers, move it past the highest used Bill_No (no rows are deleted).
    /// </summary>
    private async Task SkipCollidingBillNumbersAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        const string sql =
            "DECLARE @maxSub bigint = (SELECT MAX([Bill_No]) FROM [Cash_Memo_Sub]); " +
            "DECLARE @ident bigint = CONVERT(bigint, IDENT_CURRENT('Cash_Memo')); " +
            "IF @maxSub IS NOT NULL AND @maxSub >= @ident DBCC CHECKIDENT ('Cash_Memo', RESEED, @maxSub) WITH NO_INFOMSGS;";
        await db.Database.ExecuteSqlRawAsync(sql);
    }

    private sealed class BillNumberCollisionException(long billNo) : Exception($"Bill number {billNo} is already used by old item rows.");

    private async Task PostAsync(bool printAfterSave)
    {
        var problems = new List<string>();
        if (storeId <= 0) problems.Add(I18n.IsBangla ? "স্টোর নির্বাচন করুন।" : "Select a store.");
        if (string.IsNullOrWhiteSpace(customerName)) problems.Add(I18n.IsBangla ? "রোগী / ক্রেতার নাম লিখুন।" : "Enter the customer name.");
        if (lines.Count == 0) problems.Add(I18n.IsBangla ? "অন্তত একটি ঔষধ যোগ করুন।" : "Add at least one medicine.");
        if (discount < 0 || discount > Gross) problems.Add(I18n.IsBangla ? "ছাড়ের পরিমাণ সঠিক নয়।" : $"Discount must be between 0 and {I18n.FormatCurrency(Gross)}.");
        if (patientType == "2" && string.IsNullOrWhiteSpace(regNo)) problems.Add(I18n.IsBangla ? "ভর্তি রোগী (IPD) নির্বাচন করুন।" : "Select an admitted IPD patient.");
        if (problems.Count > 0)
        {
            dialog = new SaveDialog("error", I18n.IsBangla ? "বিল সংরক্ষণ করা যাচ্ছে না" : "Cannot save the bill", problems, printAfterSave);
            return;
        }

        if (CollectsPayment && IsCashPayment && Net > 0 && (tenderedAmount ?? 0) < Net)
        {
            var given = tenderedAmount ?? 0;
            var msg = given <= 0
                ? (I18n.IsBangla ? "Cash Given এর ঘরে টাকার পরিমাণ লেখা হয়নি।" : "Cash Given is empty. Enter the amount the customer paid.")
                : (I18n.IsBangla ? $"প্রদত্ত টাকা ({I18n.FormatCurrency(given)}) মোট বিলের ({I18n.FormatCurrency(Net)}) চেয়ে কম। কম আছে {I18n.FormatCurrency(Net - given)}।"
                                 : $"Cash given ({I18n.FormatCurrency(given)}) is less than the net payable ({I18n.FormatCurrency(Net)}). Short by {I18n.FormatCurrency(Net - given)}.");
            dialog = new SaveDialog("cash", I18n.IsBangla ? "নগদ টাকার পরিমাণ দিন" : "Cash amount required", [msg], printAfterSave);
            return;
        }

        if (CollectsPayment && !IsCashPayment) tenderedAmount = Net;
        await CommitSaleAsync(printAfterSave);
    }

    private async Task CommitSaleAsync(bool printAfterSave)
    {
        if (isSaving || savedMemo != null) return;
        isSaving = true;
        try
        {
            var curStoreId = storeId;
            var curCustomerName = customerName.Trim();
            var curContact = contact.Trim();
            var curPatientType = patientType;
            var curIsIpdCredit = curPatientType == "2" && ipdPaymentMode == "credit";
            var curRegNo = regNo.Trim();
            var curLines = lines.ToList();
            var curDiscount = discount;
            var curGross = Gross;
            var curNet = Net;
            var curLoadedPrescriptionId = loadedPrescriptionId;
            var curPaymentMethod = curIsIpdCredit ? null : (string.IsNullOrWhiteSpace(paymentMethod) ? PharmacyPaymentMethod.Cash : paymentMethod.Trim());
            var curIsNonCash = curPaymentMethod != null && !string.Equals(curPaymentMethod, PharmacyPaymentMethod.Cash, StringComparison.OrdinalIgnoreCase);
            var curPaymentRef = curIsNonCash && !string.IsNullOrWhiteSpace(paymentRef) ? paymentRef.Trim()[..Math.Min(100, paymentRef.Trim().Length)] : null;
            var uid = await CurrentUserIdAsync();
            var now = DateTime.Now;

            await using var strategyDb = await DbFactory.CreateDbContextAsync();
            var strategy = strategyDb.Database.CreateExecutionStrategy();
            PharmacyCashMemo? createdMemo = null;

            for (var attempt = 1; ; attempt++)
            {
            try
            {
            await strategy.ExecuteAsync(async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                await using var tx = await db.Database.BeginTransactionAsync(IsolationLevel.Serializable);

                PatientAdmission? admission = null;
                if (curPatientType == "2")
                {
                    admission = await db.PatientAdmissions.FirstOrDefaultAsync(x => x.RegNo == curRegNo && x.IsAdmitted == true);
                    if (admission == null) throw new InvalidOperationException("Active IPD admission was not found.");
                }

                var memo = new PharmacyCashMemo
                {
                    Name = curCustomerName,
                    Contact = curContact,
                    RegNo = curPatientType == "2" ? curRegNo : null,
                    PatientType = curPatientType,
                    Total = curGross,
                    Discount = curDiscount,
                    EnteredBy = uid,
                    TransDate = now,
                    IsPackage = admission?.IsPackage == true,
                    IsCredit = curIsIpdCredit,
                    BufferStore = curStoreId,
                    PaymentMethod = curPaymentMethod,
                    PaymentRef = curPaymentRef
                };
                db.PharmacyCashMemos.Add(memo);
                await db.SaveChangesAsync();
                // Old orphan item rows may already carry this bill number; never mix them into a new bill.
                if (await db.PharmacyCashMemoItems.AnyAsync(x => x.BillNo == memo.ID))
                    throw new BillNumberCollisionException(memo.ID);

                var sl = 1;
                foreach (var line in curLines)
                {
                    var med = await db.Services.FindAsync(line.ServiceID);
                    var batches = await db.MedicineStoreBalances
                        .Where(x => x.MedicineStoreID == curStoreId && x.ServiceID == line.ServiceID && x.Balance > 0 && (x.ExpireDate == null || x.ExpireDate >= DateTime.Today))
                        .OrderBy(x => x.ExpireDate).ThenBy(x => x.ID).ToListAsync();
                    var challanItemIds = batches.Where(x => x.MedicineReceivingChallanSubID.HasValue).Select(x => x.MedicineReceivingChallanSubID!.Value).Distinct().ToArray();
                    var batchCosts = challanItemIds.Length == 0 ? new Dictionary<long, decimal>() : await db.MedicineReceivingChallanItems
                        .Where(x => challanItemIds.Contains(x.ID)).ToDictionaryAsync(x => x.ID, x => x.BuyRate);
                    var soldItem = new PharmacyCashMemoItem { BillNo = memo.ID, ServiceID = line.ServiceID, SLNO = sl++, Rate = line.Rate, Quantity = line.Quantity };
                    var remaining = line.Quantity;
                    decimal totalCost = 0;
                    foreach (var batch in batches)
                    {
                        var take = Math.Min(batch.Balance, remaining);
                        if (take <= 0) continue;
                        var unitCost = batch.MedicineReceivingChallanSubID.HasValue && batchCosts.TryGetValue(batch.MedicineReceivingChallanSubID.Value, out var cost) ? cost : (med?.BuyRate ?? 0);
                        batch.Balance -= take;
                        remaining -= take;
                        totalCost += take * unitCost;
                        soldItem.BatchAllocations.Add(new PharmacySaleBatchAllocation { StockBalanceID = batch.ID, Quantity = take, BuyRate = unitCost, BatchNo = batch.BatchNo, ExpireDate = batch.ExpireDate });
                        if (remaining <= 0) break;
                    }
                    if (remaining > 0) throw new InvalidOperationException($"Insufficient stock for {med?.Name}.");
                    soldItem.BuyRate = line.Quantity <= 0 ? 0 : Math.Round(totalCost / line.Quantity, 2);

                    line.BatchNo = string.Join(", ", soldItem.BatchAllocations.Select(b => b.BatchNo).Where(b => !string.IsNullOrEmpty(b)));
                    line.ExpireDate = soldItem.BatchAllocations.OrderBy(b => b.ExpireDate).FirstOrDefault()?.ExpireDate;

                    db.PharmacyCashMemoItems.Add(soldItem);
                    if (admission != null && curIsIpdCredit)
                    {
                        var dept = await (from b in db.BedCabins join c in db.BedCategories on b.CategoryID equals c.ID where b.ID == admission.BedCabinID select c.IpdDepartmentID).FirstOrDefaultAsync();
                        if (admission.IsPackage == true) db.PatientPackageTransactions.Add(new PatientPackageTransaction { RegNo = admission.RegNo, ServiceID = line.ServiceID, ServiceRate = line.Rate, Quantity = line.Quantity, IpdDepartmentID = dept, EnteredBy = uid, TransDate = now });
                        else db.PatientTransactions.Add(new PatientTransaction { RegNo = admission.RegNo, ServiceID = line.ServiceID, ServiceRate = line.Rate, Quantity = line.Quantity, IpdDepartmentID = dept, EnteredBy = uid, TransDate = now });
                    }
                }

                var rxLines = curLines.Where(x => x.PrescriptionMedicineID.HasValue).ToList();
                if (rxLines.Count > 0)
                {
                    if (!curLoadedPrescriptionId.HasValue) throw new InvalidOperationException("Prescription link is missing.");
                    var dispense = new PrescriptionDispense { PrescriptionID = curLoadedPrescriptionId.Value, CashMemoID = memo.ID, EnteredBy = uid, TransDate = now };
                    foreach (var line in rxLines)
                    {
                        var prescribed = await db.PrescriptionMedicines.SingleAsync(x => x.ID == line.PrescriptionMedicineID);
                        var used = await db.PrescriptionDispenseItems.Where(x => x.PrescriptionMedicineID == line.PrescriptionMedicineID).SumAsync(x => (decimal?)x.Quantity) ?? 0;
                        if (line.Quantity > prescribed.Quantity - used) throw new InvalidOperationException($"Prescription quantity exceeded for {MedicineName(line.ServiceID)}.");
                        dispense.Items.Add(new PrescriptionDispenseItem { PrescriptionMedicineID = line.PrescriptionMedicineID!.Value, ServiceID = line.ServiceID, Quantity = line.Quantity });
                    }
                    db.PrescriptionDispenses.Add(dispense);
                }

                if (!curIsIpdCredit)
                {
                    db.CentralCashCollections.Add(new CentralCashCollection { Amount = curNet, ModuleFlag = 4, HeadID = 4, EnteredBy = uid, TransDate = now, TransDateCL = now, ReferenceID = memo.ID });
                }
                if (curNet > 0)
                {
                    AccountingPosting.AddPostedVoucher(
                        db,
                        !curIsIpdCredit ? "Receipt" : "Journal",
                        now,
                        curIsNonCash
                            ? $"Pharmacy sale to {memo.Name} via {curPaymentMethod}{(curPaymentRef == null ? "" : $" (Ref: {curPaymentRef})")}"
                            : $"Pharmacy sale to {memo.Name}",
                        $"PHARMACY-SALE:{memo.ID}",
                        uid,
                        (curIsIpdCredit ? AccountingPosting.PatientReceivable
                            : curIsNonCash ? await AccountingSetup.PaymentAccountIdAsync(db, curPaymentMethod) : AccountingPosting.Cash, curNet, 0),
                        (AccountingPosting.PharmacySales, 0, curNet));
                }

                await db.SaveChangesAsync();
                await tx.CommitAsync();
                createdMemo = memo;
            });
            break;
            }
            catch (BillNumberCollisionException) when (attempt < 3)
            {
                // Transaction rolled back; move the bill counter past the old rows and try again.
                await SkipCollidingBillNumbersAsync();
            }
            }

            savedMemo = createdMemo;
            Success(I18n.IsBangla ? $"বিল #PH-{createdMemo?.ID} সফলভাবে সম্পন্ন হয়েছে।" : $"Bill #PH-{createdMemo?.ID} saved.");
            await LoadAsync();

            if (printAfterSave)
            {
                StateHasChanged();
                await Task.Yield();
                await PrintAsync();
            }
        }
        catch (Exception ex)
        {
            ShowError(I18n.IsBangla ? "বিক্রয় সম্পন্ন করা যায়নি" : "Sale failed", I18n.IsBangla ? $"বিল সংরক্ষণ হয়নি: {RootMessage(ex)}" : $"The bill was not saved: {RootMessage(ex)}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task<int> CurrentUserIdAsync()
    {
        var u = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        return int.TryParse(u.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : 1;
    }

    private async Task HandlePosScanKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ProcessPosScanAsync();
    }

    private async Task ProcessPosScanAsync()
    {
        if (string.IsNullOrWhiteSpace(posScanQuery)) return;
        var raw = posScanQuery.Trim();

        if (raw.StartsWith("HPM:RX|", StringComparison.OrdinalIgnoreCase))
        {
            foreach (var p in raw.Split('|'))
            {
                if (p.StartsWith("ID:", StringComparison.OrdinalIgnoreCase) && long.TryParse(p[3..], out var rxId))
                {
                    prescriptionId = rxId;
                    await LoadPrescriptionAsync();
                    posScanQuery = "";
                    return;
                }
            }
        }
        else if (raw.StartsWith("RX-", StringComparison.OrdinalIgnoreCase) && long.TryParse(raw[3..], out var rxId))
        {
            prescriptionId = rxId;
            await LoadPrescriptionAsync();
            posScanQuery = "";
            return;
        }

        if (raw.StartsWith("HPM:WB|", StringComparison.OrdinalIgnoreCase) || raw.StartsWith("HPM:IPD|", StringComparison.OrdinalIgnoreCase))
        {
            string? scannedReg = null;
            foreach (var p in raw.Split('|'))
            {
                if (p.StartsWith("REG:", StringComparison.OrdinalIgnoreCase)) scannedReg = p[4..].Trim();
            }
            if (!string.IsNullOrWhiteSpace(scannedReg))
            {
                var admMatch = admittedPatients.FirstOrDefault(x => string.Equals(x.RegNo, scannedReg, StringComparison.OrdinalIgnoreCase));
                if (admMatch != null) SelectInpatient(admMatch);
                else { patientType = "2"; regNo = scannedReg; }
                posScanQuery = "";
                return;
            }
        }
        else if (raw.StartsWith("I", StringComparison.OrdinalIgnoreCase) && raw.Length >= 6 && char.IsDigit(raw[1]))
        {
            var admMatch = admittedPatients.FirstOrDefault(x => string.Equals(x.RegNo, raw, StringComparison.OrdinalIgnoreCase));
            if (admMatch != null) SelectInpatient(admMatch);
            else { patientType = "2"; regNo = raw; }
            posScanQuery = "";
            return;
        }

        var matchedMed = medicines.FirstOrDefault(x =>
            (x.Sku != null && x.Sku.Equals(raw, StringComparison.OrdinalIgnoreCase)) ||
            x.ID.ToString() == raw ||
            (x.Name?.Equals(raw, StringComparison.OrdinalIgnoreCase) ?? false));
        if (matchedMed != null)
        {
            await SelectMedicineAsync(matchedMed);
            lineQuantity = 1;
            AddLine();
            posScanQuery = "";
            return;
        }

        Fail($"No match found for: {raw}");
    }

    private void ClearPosScan() => posScanQuery = "";

