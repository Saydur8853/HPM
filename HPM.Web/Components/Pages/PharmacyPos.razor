@code {
    [SupplyParameterFromQuery(Name = "prescriptionId")]
    public long? QueryPrescriptionId { get; set; }

    [SupplyParameterFromQuery(Name = "patientType")]
    public string? QueryPatientType { get; set; }

    private ElementReference medSearchInputRef;
    private ElementReference qtyInputRef;
    private ElementReference scanInputRef;
    private DotNetObjectReference<PharmacyPos>? selfRef;

    private List<Service> medicines = [];
    private Dictionary<int, Service> medicineById = [];
    private List<MedIndexEntry> medIndex = [];
    private List<MedicineStore> stores = [];
    private Dictionary<(int StoreId, int ServiceId), decimal> stockMap = [];
    private List<PharmacyCashMemo> recent = [];
    private List<InpatientLookupItem> admittedPatients = [];
    private List<PendingRxItem> pendingPrescriptions = [];
    private List<SaleLine> lines = [];
    private List<RxShortage> rxShortages = [];
    private PharmacyCashMemo? savedMemo;

    private int currentUserId;
    private int? preferredStoreId;
    private string patientType = "1";
    private string ipdPaymentMode = "credit";
    private string rightQueueTab = "sales";
    private int storeId;
    private string customerName = WalkInName;
    private string contact = "";
    private string regNo = "";
    private string selectedBedName = "";
    private string ipdSearchQuery = "";
    private bool showIpdSuggestions;
    private int highlightedIpdIndex;

    private string posScanQuery = "";
    private string recentScanQuery = "";
    private string rxQueueSearch = "";
    private string medSearchQuery = "";
    private string[] medTokens = [];
    private List<MedHit> medResults = [];
    private int medMatchCount;
    private bool inStockOnly;
    private bool showMedSuggestions;
    private int highlightedMedIndex;
    private Service? selectedMedObj;
    private Dictionary<int, string> genericNames = [];
    private Dictionary<int, string> typeNames = [];
    private decimal? tenderedAmount;
    private ElementReference tenderInputRef;
    private ElementReference newMethodInputRef;
    private List<PharmacyPaymentMethod> paymentMethods = [];
    private string paymentMethod = PharmacyPaymentMethod.Cash;
    private string paymentRef = "";
    private bool addingPaymentMethod;
    private string newPaymentMethodName = "";
    private SaveDialog? dialog;
    private const string NewMethodOption = "__new__";
    private bool IsCashPayment => string.Equals(paymentMethod, PharmacyPaymentMethod.Cash, StringComparison.OrdinalIgnoreCase);
    private bool CollectsPayment => patientType == "1" || ipdPaymentMode == "cash";
    private decimal ChangeDue => Math.Max(0, (tenderedAmount ?? 0) - Net);
    private bool isThermalPrint = true;
    private bool showGenericAlternatives;
    private List<Service> genericAlternatives = [];
    private int lineMedicineId;
    private decimal lineQuantity = 1;
    private decimal lineRate;
    private decimal discount;
    private long? prescriptionId, loadedPrescriptionId;
    private string prescriptionLabel = "";
    private bool isSaving;
    private string message = "";
    private string messageClass = "success";
    private string currentUserName = "User";

    private const string WalkInName = "Walk-in Customer";

    private decimal Gross => lines.Sum(x => x.Total);
    private decimal Net => Math.Max(0, Gross - discount);

    private string[] ipdTokens => Tokenize(ipdSearchQuery);
    private string[] recentTokens => Tokenize(recentScanQuery);
    private string[] rxTokens => Tokenize(rxQueueSearch);

    // ---------- Search helpers ----------
    private static string[] Tokenize(string? q) => string.IsNullOrWhiteSpace(q)
        ? []
        : q.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Distinct(StringComparer.OrdinalIgnoreCase).ToArray();

    private static bool MatchesAll(string[] tokens, params string?[] fields)
    {
        if (tokens.Length == 0) return true;
        var hay = string.Join(' ', fields.Where(f => !string.IsNullOrWhiteSpace(f)));
        return tokens.All(t => hay.Contains(t, StringComparison.OrdinalIgnoreCase));
    }

    private static bool WordStartsWith(string text, string token)
    {
        var idx = 0;
        while ((idx = text.IndexOf(token, idx, StringComparison.OrdinalIgnoreCase)) >= 0)
        {
            if (idx == 0 || !char.IsLetterOrDigit(text[idx - 1])) return true;
            idx++;
        }
        return false;
    }

    /// <summary>Renders text with every search token highlighted.</summary>
    private static RenderFragment Hl(string? text, string[] tokens) => builder =>
    {
        if (string.IsNullOrEmpty(text)) return;
        if (tokens.Length == 0) { builder.AddContent(0, text); return; }
        var mask = new bool[text.Length];
        foreach (var t in tokens)
        {
            var i = 0;
            while ((i = text.IndexOf(t, i, StringComparison.OrdinalIgnoreCase)) >= 0)
            {
                for (var k = i; k < i + t.Length; k++) mask[k] = true;
                i += Math.Max(1, t.Length);
            }
        }
        var seq = 0;
        var start = 0;
        while (start < text.Length)
        {
            var hit = mask[start];
            var end = start;
            while (end < text.Length && mask[end] == hit) end++;
            var part = text[start..end];
            if (hit)
            {
                builder.OpenElement(seq++, "mark");
                builder.AddContent(seq++, part);
                builder.CloseElement();
            }
            else builder.AddContent(seq++, part);
            start = end;
        }
    };

    private static int ScoreMedicine(MedIndexEntry e, string q, string[] tokens)
    {
        if (!string.IsNullOrEmpty(e.Sku) && e.Sku.Equals(q, StringComparison.OrdinalIgnoreCase)) return 1000;
        if (e.Name.Equals(q, StringComparison.OrdinalIgnoreCase)) return 900;
        if (e.Name.StartsWith(q, StringComparison.OrdinalIgnoreCase)) return 800;
        if (e.Name.StartsWith(tokens[0], StringComparison.OrdinalIgnoreCase)) return 700;
        if (WordStartsWith(e.Name, tokens[0])) return 600;
        if (e.Name.Contains(q, StringComparison.OrdinalIgnoreCase)) return 500;
        if (e.Generic.StartsWith(q, StringComparison.OrdinalIgnoreCase)) return 400;
        if (tokens.All(t => e.Name.Contains(t, StringComparison.OrdinalIgnoreCase))) return 300;
        if (e.Generic.Contains(q, StringComparison.OrdinalIgnoreCase)) return 200;
        return 100;
    }

    private void RefreshMedResults()
    {
        highlightedMedIndex = 0;
        medTokens = Tokenize(medSearchQuery);
        if (medTokens.Length == 0)
        {
            medResults = [];
            medMatchCount = 0;
            return;
        }
        var q = medSearchQuery.Trim();
        var matches = new List<(MedIndexEntry Entry, int Score, decimal Stock)>();
        foreach (var e in medIndex)
        {
            if (!medTokens.All(t => e.Haystack.Contains(t, StringComparison.OrdinalIgnoreCase))) continue;
            var stock = Available(e.Med.ID);
            if (inStockOnly && stock <= 0) continue;
            matches.Add((e, ScoreMedicine(e, q, medTokens), stock));
        }
        medMatchCount = matches.Count;
        medResults = matches
            .OrderByDescending(x => x.Stock > 0)
            .ThenByDescending(x => x.Score)
            .ThenBy(x => x.Entry.Name, StringComparer.OrdinalIgnoreCase)
            .Take(40)
            .Select(x => new MedHit(x.Entry.Med, x.Entry.Generic, x.Entry.Type, x.Stock))
            .ToList();
    }

    private async Task OnMedSearchInput()
    {
        // Typing again after picking a medicine starts a fresh search.
        if (selectedMedObj != null && !string.Equals(medSearchQuery, selectedMedObj.Name, StringComparison.Ordinal))
        {
            selectedMedObj = null;
            lineMedicineId = 0;
            showGenericAlternatives = false;
        }
        showMedSuggestions = true;
        RefreshMedResults();
        await Task.CompletedTask;
    }

    private void ToggleInStockOnly()
    {
        inStockOnly = !inStockOnly;
        RefreshMedResults();
    }

    private List<InpatientLookupItem> FilteredInpatients
    {
        get
        {
            var tokens = ipdTokens;
            if (tokens.Length == 0) return admittedPatients.Take(20).ToList();
            return admittedPatients
                .Where(x => MatchesAll(tokens, x.PatientName, x.RegNo, x.BedName, x.Contact, x.PatientId))
                .OrderByDescending(x => x.BedName.StartsWith(tokens[0], StringComparison.OrdinalIgnoreCase) || x.RegNo.StartsWith(tokens[0], StringComparison.OrdinalIgnoreCase))
                .Take(20).ToList();
        }
    }

    private IEnumerable<PharmacyCashMemo> FilteredRecent
    {
        get
        {
            var tokens = recentTokens.Select(t => t.StartsWith("PH-", StringComparison.OrdinalIgnoreCase) ? t[3..] : t.TrimStart('#')).Where(t => t.Length > 0).ToArray();
            return tokens.Length == 0 ? recent : recent.Where(x => MatchesAll(tokens, x.ID.ToString(), x.Name, x.RegNo, x.Contact));
        }
    }

    private IEnumerable<PendingRxItem> FilteredPendingRx
    {
        get
        {
            var tokens = rxTokens.Select(t => t.StartsWith("RX-", StringComparison.OrdinalIgnoreCase) ? t[3..] : t).Where(t => t.Length > 0).ToArray();
            return tokens.Length == 0 ? pendingPrescriptions : pendingPrescriptions.Where(x => MatchesAll(tokens, x.ID.ToString(), x.PatientName, x.PatientId));
        }
    }

    // ---------- Lifecycle ----------
    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = int.TryParse(auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var uid) ? uid : 0;
        preferredStoreId = WorkspacePrefs.GetInt(currentUserId, UserWorkspacePreferences.PharmacyStoreKey);
        await using var db = await DbFactory.CreateDbContextAsync();
        var dbUser = currentUserId > 0 ? await db.Users.AsNoTracking().FirstOrDefaultAsync(x => x.Id == currentUserId) : null;
        currentUserName = dbUser?.GetEffectiveName() ?? HPM.Web.Security.AppUser.GetEffectiveName(auth.User, "User");
        await LoadAsync();
        storeId = ResolveStoreId();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        selfRef = DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("hpm.attachPageHotkeys", selfRef, new[] { "F2", "F4", "F9", "Escape" });
            if (savedMemo == null) await medSearchInputRef.FocusAsync();
        }
        catch { }
    }

    [JSInvokable]
    public async Task OnPageHotkey(string key)
    {
        switch (key)
        {
            case "F2":
                if (savedMemo == null) { try { await medSearchInputRef.FocusAsync(); } catch { } }
                break;
            case "F4":
                if (savedMemo == null) { try { await scanInputRef.FocusAsync(); } catch { } }
                break;
            case "F9":
                if (dialog == null && savedMemo == null && !isSaving && lines.Count > 0) await PostAsync(true);
                break;
            case "Escape":
                dialog = null;
                showMedSuggestions = false;
                showIpdSuggestions = false;
                break;
        }
        StateHasChanged();
    }

    protected override async Task OnParametersSetAsync()
    {
