    // ---------- Data ----------
    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        medicines = await db.Services.AsNoTracking().Where(x => x.CategoryID == 3).OrderBy(x => x.Name).ToListAsync();
        medicineById = medicines.ToDictionary(x => x.ID);
        genericNames = await db.GenericGroups.AsNoTracking().ToDictionaryAsync(x => x.ID, x => x.Name ?? "");
        typeNames = await db.MedicineTypes.AsNoTracking().ToDictionaryAsync(x => x.ID, x => x.Type ?? "");
        medIndex = medicines.Select(m =>
        {
            var generic = m.GenericID.HasValue && genericNames.TryGetValue(m.GenericID.Value, out var g) ? g : "";
            var type = m.TypeID.HasValue && typeNames.TryGetValue(m.TypeID.Value, out var t) ? t : "";
            var name = m.Name ?? "";
            return new MedIndexEntry(m, name, generic, type, m.Sku ?? "", $"{name} {generic} {type} {m.Sku}");
        }).ToList();

        stores = await db.MedicineStores.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
        paymentMethods = await db.PharmacyPaymentMethods.AsNoTracking().Where(x => x.IsActive).OrderBy(x => x.SortOrder).ThenBy(x => x.Name).ToListAsync();
        if (!paymentMethods.Any(x => x.Name == PharmacyPaymentMethod.Cash))
            paymentMethods.Insert(0, new PharmacyPaymentMethod { Name = PharmacyPaymentMethod.Cash, IsSystem = true });
        var today = DateTime.Today;
        var stocks = await db.MedicineStoreBalances.AsNoTracking()
            .Where(x => x.Balance > 0 && (x.ExpireDate == null || x.ExpireDate >= today))
            .Select(x => new { x.MedicineStoreID, x.ServiceID, x.Balance })
            .ToListAsync();
        stockMap = stocks.GroupBy(x => (x.MedicineStoreID, x.ServiceID)).ToDictionary(g => g.Key, g => g.Sum(y => y.Balance));
        recent = await db.PharmacyCashMemos.AsNoTracking().Where(x => x.TransDate >= today).OrderByDescending(x => x.ID).Take(200).ToListAsync();

        // Active IPD patients for quick bed / cabin / name search
        var activeAdms = await db.PatientAdmissions.AsNoTracking().Where(x => x.IsAdmitted == true).OrderByDescending(x => x.ID).Take(300).ToListAsync();
        var bedIds = activeAdms.Where(x => x.BedCabinID.HasValue).Select(x => x.BedCabinID!.Value).Distinct().ToList();
        var pids = activeAdms.Where(x => !string.IsNullOrWhiteSpace(x.PatientID)).Select(x => x.PatientID!).Distinct().ToList();
        var bedMap = bedIds.Count == 0 ? new Dictionary<int, string>() : await db.BedCabins.AsNoTracking().Where(x => bedIds.Contains(x.ID)).ToDictionaryAsync(x => x.ID, x => x.Name);
        var patMap = pids.Count == 0 ? new Dictionary<string, Registration>() : await db.Registrations.AsNoTracking().Where(x => pids.Contains(x.PatientID)).ToDictionaryAsync(x => x.PatientID, x => x);

        admittedPatients = activeAdms.Select(a =>
        {
            patMap.TryGetValue(a.PatientID ?? "", out var reg);
            var bName = a.BedCabinID.HasValue && bedMap.TryGetValue(a.BedCabinID.Value, out var bn) ? bn : "IPD";
            return new InpatientLookupItem(a.RegNo, reg?.Name ?? a.PatientID ?? a.RegNo, bName, reg?.Contact ?? "", a.PatientID ?? "");
        }).ToList();

        // Recent undispensed prescriptions & ward indents (last 7 days)
        var recentRx = await db.Prescriptions.AsNoTracking()
            .Include(x => x.Medicines)
            .Where(x => x.VisitDate >= today.AddDays(-7) && x.Medicines.Any())
            .OrderByDescending(x => x.ID)
            .Take(60)
            .ToListAsync();
        var allRxMedIds = recentRx.SelectMany(x => x.Medicines.Select(m => m.ID)).ToList();
        var dispensedMap = allRxMedIds.Count == 0
            ? new Dictionary<int, decimal>()
            : await db.PrescriptionDispenseItems.AsNoTracking()
                .Where(x => allRxMedIds.Contains(x.PrescriptionMedicineID))
                .GroupBy(x => x.PrescriptionMedicineID)
                .ToDictionaryAsync(g => g.Key, g => g.Sum(y => y.Quantity));

        pendingPrescriptions = recentRx
            .Where(rx => rx.Medicines.Any(m => m.Quantity - dispensedMap.GetValueOrDefault(m.ID, 0m) > 0))
            .Select(rx => new PendingRxItem(
                rx.ID,
                string.IsNullOrWhiteSpace(rx.Name) ? (rx.PatientID ?? $"RX-{rx.ID}") : rx.Name!,
                rx.Medicines.Count(m => m.Quantity - dispensedMap.GetValueOrDefault(m.ID, 0m) > 0),
                rx.VisitDate ?? today,
                string.Equals(rx.Type, "IPD-Indent", StringComparison.OrdinalIgnoreCase),
                rx.PatientID))
            .ToList();
    }

    private decimal Available(int id) => stockMap.GetValueOrDefault((storeId, id)) - lines.Where(x => x.ServiceID == id).Sum(x => x.Quantity);

    // ---------- Medicine entry ----------
    private async Task SelectMedicineAsync(Service m)
    {
        selectedMedObj = m;
        lineMedicineId = m.ID;
        lineRate = m.SaleRate ?? 0;
        lineQuantity = 1;
        medSearchQuery = m.Name ?? "";
        showMedSuggestions = false;
        highlightedMedIndex = 0;
        CheckGenericAlternatives(m);
        StateHasChanged();
        try { await qtyInputRef.FocusAsync(); } catch { }
    }

    private void CheckGenericAlternatives(Service m)
    {
        if (m.GenericID.HasValue && m.GenericID.Value > 0)
        {
            var avail = Available(m.ID);
            genericAlternatives = medicines
                .Where(x => x.ID != m.ID && x.GenericID == m.GenericID.Value && Available(x.ID) > 0)
                .OrderByDescending(x => Available(x.ID))
                .ToList();
            showGenericAlternatives = avail <= 0 && genericAlternatives.Count > 0;
        }
        else
        {
            genericAlternatives = [];
            showGenericAlternatives = false;
        }
    }

    private async Task HandleMedSearchKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown":
                showMedSuggestions = true;
                if (highlightedMedIndex < medResults.Count - 1) highlightedMedIndex++;
                await ScrollActiveAsync("#px-med-dd");
                break;
            case "ArrowUp":
                if (highlightedMedIndex > 0) highlightedMedIndex--;
                await ScrollActiveAsync("#px-med-dd");
                break;
            case "PageDown":
                highlightedMedIndex = Math.Min(medResults.Count - 1, highlightedMedIndex + 8);
                await ScrollActiveAsync("#px-med-dd");
                break;
            case "PageUp":
                highlightedMedIndex = Math.Max(0, highlightedMedIndex - 8);
                await ScrollActiveAsync("#px-med-dd");
                break;
            case "Enter":
                if (selectedMedObj != null)
                {
                    try { await qtyInputRef.FocusAsync(); } catch { }
                }
                else if (medResults.Count > 0 && highlightedMedIndex >= 0 && highlightedMedIndex < medResults.Count)
                {
                    await SelectMedicineAsync(medResults[highlightedMedIndex].Med);
                }
                break;
            case "Escape":
                if (showMedSuggestions) showMedSuggestions = false;
                else ClearMedSearch();
                break;
        }
    }

