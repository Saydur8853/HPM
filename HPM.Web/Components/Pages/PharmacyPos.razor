@page "/pharmacy/pos"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.PharmacyOperator + "," + RoleNames.Cashier)]
@rendermode InteractiveServer
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject IBarcodeQrService BarcodeQr
@implements IDisposable
@using System.Security.Claims
@using System.Data
@using HPM.Web.Components.Common

<PageTitle>@I18n.T("Pharmacy POS") | @Branding.HospitalName</PageTitle>

<div class="page-heading">
    <div>
        <span class="eyebrow">@I18n.T("Pharmacy & Dispensary")</span>
        <h1>@I18n.T("Pharmacy Point of Sale")</h1>
        <p>@I18n.T("Fast counter sales, barcode lookup, generic replacement and instant receipts.")</p>
    </div>
    <button class="btn btn-secondary" @onclick="Reset">@I18n.T("+ New Counter Sale")</button>
</div>

@if(!string.IsNullOrWhiteSpace(message)){<div class="alert @messageClass">@message</div>}

<div class="module-layout">
    <div class="panel form-panel">
        <div class="panel-heading">
            <div>
                <h2>@(savedMemo==null?I18n.T("New pharmacy sale", "New pharmacy sale"):$"{I18n.T("Pharmacy Cash Receipt")} #{savedMemo.ID}")</h2>
                <p>@I18n.T("Direct retail sale and medicine dispensing.", "Direct retail sale and medicine dispensing.")</p>
            </div>
            @if(savedMemo!=null){<span class="badge">@I18n.T("PAID")</span>}
        </div>

        @if(savedMemo == null)
        {
            <div class="scanner-search-group" style="margin: 0 1.25rem 0.75rem 1.25rem;">
                <span class="scanner-icon" title="Barcode / QR Scanner active">📷</span>
                <input type="text"
                       class="scanner-input"
                       placeholder="@I18n.T("Scan Medicine Barcode, Prescription QR (RX-XXXX), or IPD Wristband (I2600...)...", "Scan Medicine Barcode, Prescription QR (RX-XXXX), or IPD Wristband (I2600...)...")"
                       @bind="posScanQuery"
                       @bind:event="oninput"
                       @onkeydown="HandlePosScanKeyDown" />
                @if (!string.IsNullOrWhiteSpace(posScanQuery))
                {
                    <button type="button" class="btn btn-ghost" style="padding: 0 8px; font-size: 11px;" @onclick="ClearPosScan">✕</button>
                }
            </div>
        }

        <div class="form-grid">
            <label>
                <span>@I18n.T("Patient Category", "Patient type *")</span>
                <select @bind="patientType">
                    <option value="1">@I18n.T("Walk-in", "OPD / Walk-in")</option>
                    <option value="2">@I18n.T("Admitted Inpatients", "IPD Patient")</option>
                </select>
            </label>
            <label>
                <span>@I18n.T("Pharmacy & Stock", "Medicine store *")</span>
                <select @bind="storeId">
                    <option value="0">@I18n.T("Select")</option>
                    @foreach(var x in stores.Where(x=>x.IsActive)){
                        <option value="@x.ID">@x.Name</option>
                    }
                </select>
            </label>
            <label>
                <span>@I18n.T("Patient Name", "Patient / customer name *")</span>
                <input @bind="customerName" maxlength="50" />
            </label>
            <label>
                <span>@I18n.T("Contact Mobile", "Contact")</span>
                <input @bind="contact" maxlength="20" />
            </label>
            @if(patientType=="2"){
                <label class="span-2">
                    <span>@I18n.T("IPD Reg. Number", "IPD Reg No *")</span>
                    <input @bind="regNo" maxlength="10" />
                </label>
            }
        </div>
        @if(savedMemo==null)
        {
            <div class="form-section-title">@I18n.T("Pharmacy Prescriptions & Dispensing", "Load doctor prescription")</div>
            <div class="form-grid three">
                <label class="span-2">
                    <span>@I18n.T("Prescription No")</span>
                    <InputNumber @bind-Value="prescriptionId" />
                </label>
                <label>
                    <span>@I18n.T("Prescription", "Loaded prescription")</span>
                    <input value="@prescriptionLabel" disabled />
                </label>
            </div>
            <div class="form-actions">
                <a class="btn btn-secondary" href="pharmacy/prescriptions">@I18n.T("Prescription", "Create prescription")</a>
                <button class="btn btn-secondary" @onclick="LoadPrescriptionAsync">@I18n.T("Dispense Prescribed Items", "Load remaining medicines")</button>
            </div>
            <div class="form-section-title">@I18n.T("Item / Strength", "Add medicine")</div>
            <div class="form-grid three">
                <label class="span-2">
                    <span>@I18n.T("Medicine / Product Name", "Medicine *")</span>
                    <select @bind="lineMedicineId" @bind:after="MedicineChanged">
                        <option value="0">@I18n.T("Select")</option>
                        @foreach(var x in medicines){
                            <option value="@x.ID">@x.Name (@I18n.T("Stock"): @Available(x.ID).ToString("N2"))</option>
                        }
                    </select>
                </label>
                <label>
                    <span>@I18n.T("Quantity *")</span>
                    <InputNumber @bind-Value="lineQuantity" />
                </label>
                <label>
                    <span>@I18n.T("Rate", "Sale rate")</span>
                    <InputNumber @bind-Value="lineRate" />
                </label>
            </div>
            <div class="form-actions">
                <button class="btn btn-secondary" @onclick="AddLine">@I18n.T("Add to Cart", "+ Add to bill")</button>
            </div>
        }
        <div class="data-table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@I18n.T("Medicine / Product Name", "Medicine")</th>
                        <th class="num">@I18n.T("Stock", "Available")</th>
                        <th class="num">@I18n.T("Qty")</th>
                        <th class="num">@I18n.T("Rate")</th>
                        <th class="num">@I18n.T("Total")</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if(lines.Count==0){
                        <tr><td colspan="7"><div class="empty-state small">@I18n.T("No medicines added to cart yet.")</div></td></tr>
                    }
                    @for(var i=0;i<lines.Count;i++){
                        var index=i;
                        var x=lines[i];
                        <tr>
                            <td>@(i+1)</td>
                            <td>@MedicineName(x.ServiceID)</td>
                            <td class="num">@Available(x.ServiceID).ToString("N2")</td>
                            <td class="num">@x.Quantity</td>
                            <td class="num">@I18n.FormatCurrency(x.Rate)</td>
                            <td class="num"><b>@I18n.FormatCurrency(x.Total)</b></td>
                            <td>
                                @if(savedMemo==null){
                                    <button class="icon-btn" @onclick="()=>RemoveLine(index)">✕</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="form-grid three" style="padding-top:16px;">
            <label>
                <span>@I18n.T("Gross Total", "Gross")</span>
                <input value="@I18n.FormatCurrency(Gross)" disabled/>
            </label>
            <label>
                <span>@I18n.T("Discount")</span>
                <InputNumber @bind-Value="discount" />
            </label>
            <label>
                <span>@I18n.T("Net Payable", "Net payable")</span>
                <input value="@I18n.FormatCurrency(Net)" disabled/>
            </label>
        </div>
        <div class="form-actions">
            @if(savedMemo==null){
                <button class="btn btn-primary" @onclick="PostAsync" disabled="@isSaving">
                    @(isSaving?I18n.T("Saving…"):I18n.T("Complete Sale & Print Receipt", "Complete sale"))
                </button>
            }
            else{
                <button class="btn btn-secondary" @onclick="PrintAsync">@I18n.T("Print Invoice", "Print cash memo")</button>
            }
        </div>
    </div>
    <div class="panel">
        <div class="panel-heading">
            <div>
                <h2>@I18n.T("Pharmacy Sales", "Today's pharmacy sales")</h2>
                <p>@recent.Count @I18n.T("transaction(s)")</p>
            </div>
            <span class="pill">@I18n.FormatCurrency(recent.Sum(x=>(x.Total??0)-(x.Discount??0)))</span>
        </div>

        <div class="scanner-search-group" style="margin: 0 1.25rem 0.75rem 1.25rem;">
            <span class="scanner-icon" title="Barcode / QR Scanner active">📷</span>
            <input type="text"
                   class="scanner-input"
                   placeholder="@I18n.T("Scan / Search Memo # (PH-XXXX) or Customer...", "Scan / Search Memo # (PH-XXXX) or Customer...")"
                   @bind="recentScanQuery"
                   @bind:event="oninput" />
            @if (!string.IsNullOrWhiteSpace(recentScanQuery))
            {
                <button type="button" class="btn btn-ghost" style="padding: 0 8px; font-size: 11px;" @onclick="ClearRecentScan">✕</button>
            }
        </div>

        <div class="data-table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>@I18n.T("Bill No", "Memo")</th>
                        <th>@I18n.T("Patient Name", "Patient")</th>
                        <th>@I18n.T("Patient Category", "Type")</th>
                        <th>@I18n.T("Time")</th>
                        <th class="num">@I18n.T("Net Total", "Net")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!FilteredRecent.Any())
                    {
                        <tr><td colspan="5"><div class="empty-state small">@I18n.T("No matching sales records.")</div></td></tr>
                    }
                    @foreach(var x in FilteredRecent){
                        <tr>
                            <td><b>#@x.ID</b></td>
                            <td>@x.Name<br/><small>@x.RegNo</small></td>
                            <td>@(x.PatientType=="2"?"IPD":"OPD")</td>
                            <td>@x.TransDate.ToString("hh:mm tt")</td>
                            <td class="num">@I18n.FormatCurrency((x.Total??0)-(x.Discount??0))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if(savedMemo!=null){
    <div id="pharmacy-sale-print" class="print-sheet panel print-document">
        <PrintDocumentHeader Title="@I18n.T("Pharmacy Cash Receipt")"
                             SubTitle="@I18n.T("Pharmacy & Dispensary")"
                             DocumentNo="@($"PH-{savedMemo.ID}")"
                             BarcodeCode="@($"PH-{savedMemo.ID}")"
                             QrPayload="@BarcodeQr.GeneratePharmacyQrPayload(savedMemo.ID, savedMemo.Name, (savedMemo.Total ?? 0) - (savedMemo.Discount ?? 0))" />

        <div class="print-grid">
            <div><span>@I18n.T("Patient Name"):</span> <b>@savedMemo.Name</b></div>
            <div><span>@I18n.T("Contact Mobile"):</span> <b>@savedMemo.Contact</b></div>
            <div><span>@I18n.T("Patient Category"):</span> <b>@(savedMemo.PatientType=="2"?"IPD":"OPD")</b></div>
            <div><span>@I18n.T("IPD Reg. Number"):</span> <b>@savedMemo.RegNo</b></div>
        </div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>@I18n.T("Medicine / Product Name", "Medicine")</th>
                    <th class="num">@I18n.T("Qty")</th>
                    <th class="num">@I18n.T("Rate")</th>
                    <th class="num">@I18n.T("Total")</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var x in lines){
                    <tr>
                        <td>@MedicineName(x.ServiceID)</td>
                        <td class="num">@x.Quantity</td>
                        <td class="num">@I18n.FormatCurrency(x.Rate)</td>
                        <td class="num">@I18n.FormatCurrency(x.Total)</td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="print-total">
            <div><span>@I18n.T("Discount")</span><b>@I18n.FormatCurrency(savedMemo.Discount??0)</b></div>
            <div class="grand"><span>@I18n.T("Net Total")</span><b>@I18n.FormatCurrency((savedMemo.Total??0)-(savedMemo.Discount??0))</b></div>
        </div>
        <PrintDocumentFooter Signatures='new string[] { I18n.T("Patient / Attendant", "Customer"), I18n.T("Cashier", "Pharmacist") }' />
    </div>
}

@code{
    private List<Service> medicines=[];
    private List<MedicineStore> stores=[];
    private List<MedicineStoreBalance> stocks=[];
    private List<PharmacyCashMemo> recent=[];
    private List<SaleLine> lines=[];
    private PharmacyCashMemo? savedMemo;
    private string patientType="1";
    private int storeId=1;
    private string customerName="Walk-in Customer";
    private string contact="";
    private string regNo="";
    private string posScanQuery = "";
    private string recentScanQuery = "";
    private int lineMedicineId;
    private decimal lineQuantity=1;
    private decimal lineRate;
    private decimal discount;
    private long? prescriptionId,loadedPrescriptionId;
    private string prescriptionLabel="—";
    private bool isSaving;
    private string message="";
    private string messageClass="success";
    private decimal Gross=>lines.Sum(x=>x.Total);
    private decimal Net=>Math.Max(0,Gross-discount);

    private IEnumerable<PharmacyCashMemo> FilteredRecent => string.IsNullOrWhiteSpace(recentScanQuery)
        ? recent
        : recent.Where(x => x.ID.ToString().Contains(recentScanQuery.Trim(), StringComparison.OrdinalIgnoreCase)
                         || (x.Name?.Contains(recentScanQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)
                         || (x.RegNo?.Contains(recentScanQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)
                         || $"PH-{x.ID}".Contains(recentScanQuery.Trim(), StringComparison.OrdinalIgnoreCase));

    private void ClearRecentScan() => recentScanQuery = "";

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        await LoadAsync();
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadAsync()
    {
        await using var db=await DbFactory.CreateDbContextAsync();
        medicines=await db.Services.AsNoTracking().Where(x=>x.CategoryID==3).OrderBy(x=>x.Name).ToListAsync();
        stores=await db.MedicineStores.AsNoTracking().ToListAsync();
        stocks=await db.MedicineStoreBalances.AsNoTracking().Where(x=>x.Balance>0).ToListAsync();
        var today=DateTime.Today;
        recent=await db.PharmacyCashMemos.AsNoTracking().Where(x=>x.TransDate>=today).OrderByDescending(x=>x.ID).Take(100).ToListAsync();
    }

    private decimal Available(int id)=>stocks.Where(x=>x.ServiceID==id&&x.MedicineStoreID==storeId&&x.Balance>0&&x.ExpireDate>=DateTime.Today).Sum(x=>x.Balance)-lines.Where(x=>x.ServiceID==id).Sum(x=>x.Quantity);

    private void MedicineChanged()
    {
        var m=medicines.FirstOrDefault(x=>x.ID==lineMedicineId);
        lineRate=m?.SaleRate??0;
    }

    private void AddLine()
    {
        if(lineMedicineId<=0||lineQuantity<=0||lineRate<0){
            Fail(I18n.IsBangla ? "ঔষধ নির্বাচন করুন এবং সঠিক পরিমাণ/দর লিখুন।" : "Select medicine and enter valid quantity/rate.");
            return;
        }
        if(lineQuantity>Available(lineMedicineId)){
            Fail(I18n.IsBangla ? "উপলব্ধ স্টকের চেয়ে বেশি পরিমাণ দেওয়া যাবে না।" : "Requested quantity exceeds unexpired available stock.");
            return;
        }
        var existing=lines.FirstOrDefault(x=>x.ServiceID==lineMedicineId&&x.Rate==lineRate&&x.PrescriptionMedicineID==null);
        if(existing!=null) existing.Quantity+=lineQuantity;
        else lines.Add(new SaleLine{ServiceID=lineMedicineId,Quantity=lineQuantity,Rate=lineRate});
        lineMedicineId=0;
        lineQuantity=1;
        lineRate=0;
        message="";
    }

    private async Task LoadPrescriptionAsync()
    {
        if((prescriptionId??0)<=0){
            Fail(I18n.IsBangla ? "প্রেসক্রিপশন নম্বর লিখুন।" : "Enter a valid prescription number.");
            return;
        }
        await using var db=await DbFactory.CreateDbContextAsync();
        var rx=await db.Prescriptions.AsNoTracking().Include(x=>x.Medicines).FirstOrDefaultAsync(x=>x.ID==prescriptionId);
        if(rx==null){
            Fail(I18n.IsBangla ? "প্রেসক্রিপশন পাওয়া যায়নি।" : "Prescription was not found.");
            return;
        }
        var ids=rx.Medicines.Select(x=>x.ID).ToArray();
        var used=ids.Length==0?new Dictionary<int,decimal>():await db.PrescriptionDispenseItems.AsNoTracking().Where(x=>ids.Contains(x.PrescriptionMedicineID)).GroupBy(x=>x.PrescriptionMedicineID).ToDictionaryAsync(x=>x.Key,x=>x.Sum(y=>y.Quantity));
        lines=[];
        foreach(var item in rx.Medicines.OrderBy(x=>x.SLNO)){
            var remaining=item.Quantity-(used.TryGetValue(item.ID,out var value)?value:0);
            if(remaining<=0)continue;
            var take=Math.Min(remaining,Available(item.ServiceID));
            if(take>0)lines.Add(new SaleLine{ServiceID=item.ServiceID,Quantity=take,Rate=medicines.FirstOrDefault(x=>x.ID==item.ServiceID)?.SaleRate??0,PrescriptionMedicineID=item.ID});
        }
        loadedPrescriptionId=rx.ID;
        prescriptionLabel=$"#{rx.ID} · {rx.Name}";
        customerName=rx.Name??customerName;
        if(lines.Count==0) Fail(I18n.IsBangla ? "প্রেসক্রিপশনকৃত কোনো ঔষধের বিক্রয়যোগ্য স্টক নেই।" : "No undispensed prescription medicine has saleable stock.");
        else Success(I18n.IsBangla ? "প্রেসক্রিপশন থেকে ঔষধ লোড করা হয়েছে।" : "Prescription medicines loaded. Out-of-stock items were skipped; review quantities before sale.");
    }

    private void RemoveLine(int i)=>lines.RemoveAt(i);

    private async Task PostAsync()
    {
        if(storeId<=0||string.IsNullOrWhiteSpace(customerName)||lines.Count==0){
            Fail(I18n.IsBangla ? "স্টোর, গ্রাহকের নাম এবং অন্তত একটি ঔষধ নির্বাচন করুন।" : "Store, patient name and medicines are required.");
            return;
        }
        if(discount<0||discount>Gross){
            Fail(I18n.IsBangla ? "ছাড়ের পরিমাণ সঠিক নয়।" : "Invalid discount.");
            return;
        }
        if(patientType=="2"&&string.IsNullOrWhiteSpace(regNo)){
            Fail(I18n.IsBangla ? "আইপিডি রেজি নং আবশ্যক।" : "IPD Reg No is required.");
            return;
        }
        isSaving=true;
        await using var db=await DbFactory.CreateDbContextAsync();
        await using var tx=await db.Database.BeginTransactionAsync(IsolationLevel.Serializable);
        try
        {
            PatientAdmission? admission=null;
            if(patientType=="2")
            {
                admission=await db.PatientAdmissions.FirstOrDefaultAsync(x=>x.RegNo==regNo&&x.IsAdmitted==true);
                if(admission==null)throw new InvalidOperationException("Active IPD admission was not found.");
            }
            var uid=await CurrentUserIdAsync();
            var now=DateTime.Now;
            var memo=new PharmacyCashMemo{Name=customerName.Trim(),Contact=contact.Trim(),RegNo=patientType=="2"?regNo.Trim():null,PatientType=patientType,Total=Gross,Discount=discount,EnteredBy=uid,TransDate=now,IsPackage=admission?.IsPackage==true,IsCredit=false,BufferStore=storeId};
            db.PharmacyCashMemos.Add(memo);
            await db.SaveChangesAsync();
            var sl=1;
            foreach(var line in lines)
            {
                var med=await db.Services.FindAsync(line.ServiceID);
                var batches=await db.MedicineStoreBalances
                    .Where(x=>x.MedicineStoreID==storeId&&x.ServiceID==line.ServiceID&&x.Balance>0&&x.ExpireDate>=DateTime.Today)
                    .OrderBy(x=>x.ExpireDate).ThenBy(x=>x.ID).ToListAsync();
                var challanItemIds=batches.Where(x=>x.MedicineReceivingChallanSubID.HasValue).Select(x=>x.MedicineReceivingChallanSubID!.Value).Distinct().ToArray();
                var batchCosts=challanItemIds.Length==0?new Dictionary<long,decimal>():await db.MedicineReceivingChallanItems
                    .Where(x=>challanItemIds.Contains(x.ID)).ToDictionaryAsync(x=>x.ID,x=>x.BuyRate);
                var soldItem=new PharmacyCashMemoItem{BillNo=memo.ID,ServiceID=line.ServiceID,SLNO=sl++,Rate=line.Rate,Quantity=line.Quantity};
                var remaining=line.Quantity;
                decimal totalCost=0;
                foreach(var batch in batches)
                {
                    var take=Math.Min(batch.Balance,remaining);
                    if(take<=0)continue;
                    var unitCost=batch.MedicineReceivingChallanSubID.HasValue&&batchCosts.TryGetValue(batch.MedicineReceivingChallanSubID.Value,out var cost)?cost:(med?.BuyRate??0);
                    batch.Balance-=take;
                    remaining-=take;
                    totalCost+=take*unitCost;
                    soldItem.BatchAllocations.Add(new PharmacySaleBatchAllocation{StockBalanceID=batch.ID,Quantity=take,BuyRate=unitCost,BatchNo=batch.BatchNo,ExpireDate=batch.ExpireDate});
                    if(remaining<=0)break;
                }
                if(remaining>0)throw new InvalidOperationException($"Insufficient stock for {med?.Name}.");
                soldItem.BuyRate=line.Quantity<=0?0:Math.Round(totalCost/line.Quantity,2);
                db.PharmacyCashMemoItems.Add(soldItem);
                if(admission!=null)
                {
                    var dept=await (from b in db.BedCabins join c in db.BedCategories on b.CategoryID equals c.ID where b.ID==admission.BedCabinID select c.IpdDepartmentID).FirstOrDefaultAsync();
                    if(admission.IsPackage==true)db.PatientPackageTransactions.Add(new PatientPackageTransaction{RegNo=admission.RegNo,ServiceID=line.ServiceID,ServiceRate=line.Rate,Quantity=line.Quantity,IpdDepartmentID=dept,EnteredBy=uid,TransDate=now});
                    else db.PatientTransactions.Add(new PatientTransaction{RegNo=admission.RegNo,ServiceID=line.ServiceID,ServiceRate=line.Rate,Quantity=line.Quantity,IpdDepartmentID=dept,EnteredBy=uid,TransDate=now});
                }
            }
            var rxLines=lines.Where(x=>x.PrescriptionMedicineID.HasValue).ToList();
            if(rxLines.Count>0)
            {
                if(!loadedPrescriptionId.HasValue)throw new InvalidOperationException("Prescription link is missing.");
                var dispense=new PrescriptionDispense{PrescriptionID=loadedPrescriptionId.Value,CashMemoID=memo.ID,EnteredBy=uid,TransDate=now};
                foreach(var line in rxLines)
                {
                    var prescribed=await db.PrescriptionMedicines.SingleAsync(x=>x.ID==line.PrescriptionMedicineID);
                    var used=await db.PrescriptionDispenseItems.Where(x=>x.PrescriptionMedicineID==line.PrescriptionMedicineID).SumAsync(x=>(decimal?)x.Quantity)??0;
                    if(line.Quantity>prescribed.Quantity-used)throw new InvalidOperationException($"Prescription quantity exceeded for {MedicineName(line.ServiceID)}.");
                    dispense.Items.Add(new PrescriptionDispenseItem{PrescriptionMedicineID=line.PrescriptionMedicineID!.Value,ServiceID=line.ServiceID,Quantity=line.Quantity});
                }
                db.PrescriptionDispenses.Add(dispense);
            }
            if(patientType=="1")db.CentralCashCollections.Add(new CentralCashCollection{Amount=Net,ModuleFlag=4,HeadID=4,EnteredBy=uid,TransDate=now,TransDateCL=now,ReferenceID=memo.ID});
            if(Net>0)AccountingPosting.AddPostedVoucher(db,patientType=="1"?"Receipt":"Journal",now,$"Pharmacy sale to {memo.Name}",$"PHARMACY-SALE:{memo.ID}",uid,(patientType=="1"?AccountingPosting.Cash:AccountingPosting.PatientReceivable,Net,0),(AccountingPosting.PharmacySales,0,Net));
            await db.SaveChangesAsync();
            await tx.CommitAsync();
            savedMemo=memo;
            Success(I18n.IsBangla ? $"ফার্মাসি ক্যাশ মেমো #{memo.ID} সফলভাবে তৈরি ও সংরক্ষিত হয়েছে।" : $"Pharmacy cash memo #{memo.ID} completed with FEFO batch trace and posted to accounts.");
            await LoadAsync();
        }
        catch(Exception ex){
            await tx.RollbackAsync();
            Fail(I18n.IsBangla ? $"বিক্রয় সম্পন্ন করা যায়নি: {ex.Message}" : $"Sale failed: {ex.Message}");
        }
        finally{isSaving=false;}
    }

    private async Task<int> CurrentUserIdAsync()
    {
        var u=(await AuthStateProvider.GetAuthenticationStateAsync()).User;
        return int.TryParse(u.FindFirstValue(ClaimTypes.NameIdentifier),out var id)?id:1;
    }

    private async Task HandlePosScanKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ProcessPosScanAsync();
        }
    }

    private async Task ProcessPosScanAsync()
    {
        if (string.IsNullOrWhiteSpace(posScanQuery)) return;
        var raw = posScanQuery.Trim();

        // Case 1: Prescription QR / Barcode (HPM:RX|ID:123|... or RX-123)
        if (raw.StartsWith("HPM:RX|", StringComparison.OrdinalIgnoreCase))
        {
            var parts = raw.Split('|');
            foreach (var p in parts)
            {
                if (p.StartsWith("ID:", StringComparison.OrdinalIgnoreCase) && long.TryParse(p.Substring(3), out var rxId))
                {
                    prescriptionId = rxId;
                    await LoadPrescriptionAsync();
                    posScanQuery = "";
                    return;
                }
            }
        }
        else if (raw.StartsWith("RX-", StringComparison.OrdinalIgnoreCase) && long.TryParse(raw.Substring(3), out var rxId))
        {
            prescriptionId = rxId;
            await LoadPrescriptionAsync();
            posScanQuery = "";
            return;
        }

        // Case 2: Inpatient Wristband or IPD Admission Barcode (HPM:WB|ADM:...|REG:I26001|PAT:John... or HPM:IPD|... or I26...)
        if (raw.StartsWith("HPM:WB|", StringComparison.OrdinalIgnoreCase) || raw.StartsWith("HPM:IPD|", StringComparison.OrdinalIgnoreCase))
        {
            var parts = raw.Split('|');
            string? scannedReg = null;
            string? scannedName = null;
            foreach (var p in parts)
            {
                if (p.StartsWith("REG:", StringComparison.OrdinalIgnoreCase)) scannedReg = p.Substring(4).Trim();
                if (p.StartsWith("PAT:", StringComparison.OrdinalIgnoreCase)) scannedName = p.Substring(4).Trim();
            }

            if (!string.IsNullOrWhiteSpace(scannedReg))
            {
                patientType = "2";
                regNo = scannedReg;
                if (!string.IsNullOrWhiteSpace(scannedName)) customerName = scannedName;
                posScanQuery = "";
                Success(I18n.IsBangla ? $"আইপিডি রোগী {customerName} ({regNo}) লোড করা হয়েছে।" : $"IPD Patient {customerName} ({regNo}) selected from wristband.");
                return;
            }
        }
        else if (raw.StartsWith("I", StringComparison.OrdinalIgnoreCase) && raw.Length >= 6 && char.IsDigit(raw[1]))
        {
            patientType = "2";
            regNo = raw;
            await using var db = await DbFactory.CreateDbContextAsync();
            var adm = await db.PatientAdmissions.AsNoTracking().FirstOrDefaultAsync(x => x.RegNo == raw);
            if (adm != null)
            {
                var pat = await db.Registrations.AsNoTracking().FirstOrDefaultAsync(x => x.PatientID == adm.PatientID);
                if (pat != null) customerName = pat.Name;
            }
            posScanQuery = "";
            Success(I18n.IsBangla ? $"আইপিডি রেজি নং {regNo} লোড হয়েছে।" : $"IPD Reg #{regNo} loaded.");
            return;
        }

        // Case 3: Patient Registration Card (HPM:PAT|ID:123|REG:P001|NAME:John|TEL:017...)
        if (raw.StartsWith("HPM:PAT|", StringComparison.OrdinalIgnoreCase))
        {
            var parts = raw.Split('|');
            foreach (var p in parts)
            {
                if (p.StartsWith("NAME:", StringComparison.OrdinalIgnoreCase)) customerName = p.Substring(5).Trim();
                if (p.StartsWith("TEL:", StringComparison.OrdinalIgnoreCase)) contact = p.Substring(4).Trim();
            }
            posScanQuery = "";
            Success(I18n.IsBangla ? $"রোগীর তথ্য লোড হয়েছে: {customerName}" : $"Patient loaded: {customerName}");
            return;
        }

        // Case 4: Medicine Product / Box Barcode scan
        var matchedMed = medicines.FirstOrDefault(x => x.ID.ToString() == raw || (x.Name?.Equals(raw, StringComparison.OrdinalIgnoreCase) ?? false) || (x.Name?.StartsWith(raw, StringComparison.OrdinalIgnoreCase) ?? false));
        if (matchedMed != null)
        {
            lineMedicineId = matchedMed.ID;
            MedicineChanged();
            lineQuantity = 1;
            AddLine();
            posScanQuery = "";
            return;
        }

        Fail(I18n.IsBangla ? "স্ক্যান করা কোড বা ঔষধ পাওয়া যায়নি।" : $"No matching medicine, prescription or wristband for: {raw}");
    }

