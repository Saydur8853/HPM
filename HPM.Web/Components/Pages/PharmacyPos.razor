    private async Task AddLineAndRefocusAsync()
    {
        if (AddLine())
        {
            try { await medSearchInputRef.FocusAsync(); } catch { }
        }
    }

    private bool AddLine()
    {
        if (lineMedicineId <= 0 || lineQuantity <= 0 || lineRate < 0)
        {
            Fail(I18n.IsBangla ? "ঔষধ এবং সঠিক পরিমাণ লিখুন।" : "Select a medicine and enter a valid quantity.");
            return false;
        }
        if (lineQuantity > Available(lineMedicineId))
        {
            var avail = Math.Max(0, Available(lineMedicineId));
            Fail(I18n.IsBangla ? $"স্টকে পর্যাপ্ত ঔষধ নেই (আছে {avail:N0})।" : $"Only {avail:N0} in stock for {MedicineName(lineMedicineId)} at this store.");
            return false;
        }
        var existing = lines.FirstOrDefault(x => x.ServiceID == lineMedicineId && x.Rate == lineRate && x.PrescriptionMedicineID == null);
        if (existing != null) existing.Quantity += lineQuantity;
        else lines.Add(new SaleLine { ServiceID = lineMedicineId, Quantity = lineQuantity, Rate = lineRate });

        lineMedicineId = 0;
        lineQuantity = 1;
        lineRate = 0;
        ClearMedSearch();
        message = "";
        return true;
    }

    private void StepLineQty(int index, decimal delta)
    {
        if (index < 0 || index >= lines.Count) return;
        ApplyLineQty(index, lines[index].Quantity + delta);
    }

    private void SetLineQty(int index, string? raw)
    {
        if (index < 0 || index >= lines.Count) return;
        if (!decimal.TryParse(raw, out var qty)) qty = lines[index].Quantity;
        ApplyLineQty(index, qty);
    }

    private void ApplyLineQty(int index, decimal qty)
    {
        var line = lines[index];
        if (qty <= 0) { RemoveLine(index); return; }
        var max = Available(line.ServiceID) + line.Quantity;
        if (line.PrescriptionMedicineID.HasValue && qty > line.Quantity)
        {
            Fail(I18n.IsBangla ? "প্রেসক্রিপশনের পরিমাণের বেশি দেওয়া যাবে না।" : "Prescription lines cannot exceed the prescribed quantity. Add extra as a separate item.");
            return;
        }
        if (qty > max)
        {
            Fail(I18n.IsBangla ? $"স্টকে আছে মাত্র {max:N0}।" : $"Only {max:N0} in stock for {MedicineName(line.ServiceID)}.");
            qty = max;
        }
        else message = "";
        line.Quantity = qty;
    }

    private async Task LoadFromQueueAsync(long rxId)
    {
        if (savedMemo != null) Reset();
        prescriptionId = rxId;
        await LoadPrescriptionAsync();
    }

    private async Task LoadPrescriptionAsync()
    {
        if ((prescriptionId ?? 0) <= 0) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var rx = await db.Prescriptions.AsNoTracking().Include(x => x.Medicines).FirstOrDefaultAsync(x => x.ID == prescriptionId);
        if (rx == null)
        {
            Fail(I18n.IsBangla ? "প্রেসক্রিপশন পাওয়া যায়নি।" : "Prescription not found.");
            return;
        }
        var ids = rx.Medicines.Select(x => x.ID).ToArray();
        var used = ids.Length == 0 ? new Dictionary<int, decimal>() : await db.PrescriptionDispenseItems.AsNoTracking().Where(x => ids.Contains(x.PrescriptionMedicineID)).GroupBy(x => x.PrescriptionMedicineID).ToDictionaryAsync(x => x.Key, x => x.Sum(y => y.Quantity));
        lines = [];
        rxShortages = [];
        var shortItems = 0;
        foreach (var item in rx.Medicines.OrderBy(x => x.SLNO))
        {
            var remaining = item.Quantity - (used.TryGetValue(item.ID, out var value) ? value : 0);
            if (remaining <= 0) continue;
            var take = Math.Min(remaining, Math.Max(0, Available(item.ServiceID)));
            if (take > 0) lines.Add(new SaleLine { ServiceID = item.ServiceID, Quantity = take, Rate = medicineById.GetValueOrDefault(item.ServiceID)?.SaleRate ?? 0, PrescriptionMedicineID = item.ID });
            if (take < remaining)
            {
                shortItems++;
                rxShortages.Add(new RxShortage { PrescriptionMedicineId = item.ID, ServiceId = item.ServiceID, Needed = remaining - take });
            }
        }
        loadedPrescriptionId = rx.ID;
        prescriptionLabel = $"RX-{rx.ID} · {rx.Name}";
        customerName = rx.Name ?? customerName;

        if (string.Equals(rx.Type, "IPD-Indent", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(rx.PatientID))
        {
            var admMatch = admittedPatients.FirstOrDefault(a => string.Equals(a.PatientId, rx.PatientID, StringComparison.OrdinalIgnoreCase));
            if (admMatch != null) SelectInpatient(admMatch);
        }

        if (lines.Count == 0) Fail(I18n.IsBangla ? "প্রেসক্রিপশনের কোনো ঔষধ এই স্টোরে স্টকে নেই — নিচে বিকল্প ঔষধ দেখুন।" : "Prescribed items are out of stock at this store — see the alternatives below.");
        else if (shortItems > 0) Fail(I18n.IsBangla ? $"প্রেসক্রিপশন লোড হয়েছে, তবে {shortItems}টি ঔষধ পর্যাপ্ত স্টকে নেই — নিচে বিকল্প দেখুন।" : $"Prescription loaded, but {shortItems} item(s) are short or out of stock — see the alternatives below.");
        else Success(I18n.IsBangla ? "প্রেসক্রিপশন থেকে ঔষধ লোড হয়েছে।" : "Prescription items loaded into bill.");
    }

    // ---------- Prescription shortages & same-generic alternatives ----------
    private List<Service> AlternativesFor(int serviceId)
    {
        var med = medicineById.GetValueOrDefault(serviceId);
        if (med?.GenericID is not int genericId || genericId <= 0) return [];
        return medicines
            .Where(x => x.ID != serviceId && x.GenericID == genericId && Available(x.ID) > 0)
            .OrderByDescending(x => Available(x.ID))
            .Take(6)
            .ToList();
    }

    /// <summary>Other stores that hold the medicine, so the cashier knows where to switch / request from.</summary>
    private List<(string Store, decimal Qty)> OtherStoreStock(int serviceId) => stores
        .Where(s => s.IsActive && s.ID != storeId)
        .Select(s => (s.Name, stockMap.GetValueOrDefault((s.ID, serviceId))))
        .Where(x => x.Item2 > 0)
        .OrderByDescending(x => x.Item2)
        .Take(3)
        .ToList();

    private void UseAlternative(RxShortage shortage, Service alt)
    {
        var qty = Math.Min(shortage.Needed, Math.Max(0, Available(alt.ID)));
        if (qty <= 0)
        {
            Fail(I18n.IsBangla ? "এই বিকল্প ঔষধটিও স্টকে নেই।" : $"{alt.Name} is also out of stock.");
            return;
        }
        lines.Add(new SaleLine { ServiceID = alt.ID, Quantity = qty, Rate = alt.SaleRate ?? 0, PrescriptionMedicineID = shortage.PrescriptionMedicineId });
        shortage.Needed -= qty;
        if (shortage.Needed <= 0) rxShortages.Remove(shortage);
        Success(I18n.IsBangla
            ? $"{MedicineName(shortage.ServiceId)} এর বদলে {alt.Name} × {qty:0.##} যোগ করা হয়েছে।"
            : $"Added {alt.Name} × {qty:0.##} in place of {MedicineName(shortage.ServiceId)}.");
    }

    private async Task SearchForShortageAsync(RxShortage shortage)
    {
        var med = medicineById.GetValueOrDefault(shortage.ServiceId);
        var generic = med?.GenericID is int g && genericNames.TryGetValue(g, out var gn) ? gn : null;
        ClearMedSearch();
        medSearchQuery = string.IsNullOrWhiteSpace(generic) ? med?.Name ?? "" : generic;
        showMedSuggestions = true;
        RefreshMedResults();
        try { await medSearchInputRef.FocusAsync(); } catch { }
    }

