<section class="doctor-workspace-header">
    <header>
        <div>
            <span>CLINICAL WORKSPACE</span>
            <h1>@I18n.T("Doctor Desk")</h1>
            <p>@I18n.T("Queue, patient records, follow-ups and clinical orders in one workspace.")</p>
        </div>
        <div class="doctor-workspace-actions">
            <AuthorizeView Roles="Administrator,Doctor,Nurse">
                <a href="/doctor/queue" class="primary">@I18n.T("Open patient queue")</a>
            </AuthorizeView>
            <AuthorizeView Roles="Administrator,Doctor">
                <a href="/doctor/prescriptions">@I18n.T("New prescription")</a>
            </AuthorizeView>
        </div>
    </header>
    <DoctorWorkspaceNav />
</section>
