@code {
    private static readonly string[] bloodGroups = ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"];
    private Registration editor = NewPatient();
    private string idInput = string.Empty;
    private string message = string.Empty;
    private string messageClass = "success";
    private bool saving;
    private bool sameAddress = true;
    private bool showDependencyModal;
    private bool deletingDependency;
    private string? deletingDependencyKey;
    private string dependencyMessage = string.Empty;
    private bool dependencyMessageIsError;
    private List<PatientDependencyItem> patientDependencies = [];
    private PatientDependencyItem? pendingDependency;
    private bool confirmingProfileDeletion;
    private string actionDialogReason = string.Empty;
    private string actionDialogError = string.Empty;
    private DotNetObjectReference<Patients>? shortcutReference;

    private int ageYears;
    private int ageMonths;
    private int ageDays;
    private int ageHours;

    // Live suggestion lists
    private List<Registration> idSuggestions = new();
    private bool showIdSuggestions = false;
    private List<Registration> phoneSuggestions = new();
    private bool showPhoneSuggestions = false;
    private bool showCardPreview = false;

    private string FormattedAge
    {
        get
        {
            if (ageYears > 0) return $"{ageYears} Y";
            if (ageMonths > 0) return $"{ageMonths} M";
            if (ageDays > 0) return $"{ageDays} D";
            if (ageHours > 0) return $"{ageHours} H";
            return "0 Y";
        }
    }

    protected override Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        CalculateAgeFromDob(editor.DateOfBirth);
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        shortcutReference = DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("hpm.attachPatientShortcuts", shortcutReference);
        }
        catch
        {
            // Defensive guard against circuit interruption or JS loading delay
        }
    }

    [JSInvokable]
    public async Task HandlePatientShortcut(string action)
    {
        if (saving || deletingDependency) return;

        switch (action)
        {
            case "print":
                if (editor.ID > 0)
                {
                    showCardPreview = true;
                    await InvokeAsync(StateHasChanged);
                }
                else
                {
                    messageClass = "danger";
                    message = "Please select or register a patient first to print the card.";
                    await InvokeAsync(StateHasChanged);
                }
                break;

            case "save":
                if (editor.ID > 0)
                {
                    messageClass = "danger";
                    message = "This is an existing patient. Press Ctrl+U to update the profile.";
                    return;
                }
                await JS.InvokeVoidAsync("hpm.clickElementById", "btn-save-profile");
                break;

            case "update":
                if (editor.ID <= 0)
                {
                    messageClass = "danger";
                    message = "Search and load a patient before using Ctrl+U.";
                    return;
                }
                await JS.InvokeVoidAsync("hpm.clickElementById", "btn-save-profile");
                break;

            case "clear":
                if (showCardPreview)
                {
                    showCardPreview = false;
                    await InvokeAsync(StateHasChanged);
                    break;
                }
                CancelPatientAction();
                showDependencyModal = false;
                dependencyMessage = string.Empty;
                Reset();
                await InvokeAsync(StateHasChanged);
                await JS.InvokeVoidAsync("hpm.focusElementById", "input-patient-id");
                break;
        }
    }

    [JSInvokable]
    public async Task HandlePatientClickOutside(bool outsideId, bool outsidePhone)
    {
        bool changed = false;
        if (outsideId && showIdSuggestions)
        {
            showIdSuggestions = false;
            changed = true;
        }
        if (outsidePhone && showPhoneSuggestions)
        {
            showPhoneSuggestions = false;
            changed = true;
        }
        if (changed)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private void HandleLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnDobChangedAfter()
    {
        CalculateAgeFromDob(editor.DateOfBirth);
    }

    private void OnAgeChanged(string part, ChangeEventArgs e)
    {
        var value = int.TryParse(e.Value?.ToString(), out var parsed) ? parsed : 0;
        switch (part)
        {
            case "years":
                ageYears = Math.Clamp(value, 0, 150);
                break;
            case "months":
                ageMonths = Math.Clamp(value, 0, 11);
                break;
            case "days":
                ageDays = Math.Clamp(value, 0, 30);
                break;
            case "hours":
                ageHours = Math.Clamp(value, 0, 23);
                break;
        }

        editor.DateOfBirth = DateTime.Now
            .AddYears(-ageYears)
            .AddMonths(-ageMonths)
            .AddDays(-ageDays)
            .AddHours(-ageHours);
    }

    private void OnSameAddressCheckboxChanged(ChangeEventArgs e)
    {
        sameAddress = (bool)(e.Value ?? false);
        if (sameAddress)
        {
            editor.PermanentVillage = editor.PresentVillage;
            editor.PermanentPO = editor.PresentPO;
            editor.PermanentPS = editor.PresentPS;
            editor.PermanentDistrict = editor.PresentDistrict;
        }
    }

    private void OnPresentVillageInput(ChangeEventArgs e)
    {
        editor.PresentVillage = e.Value?.ToString();
        if (sameAddress) editor.PermanentVillage = editor.PresentVillage;
    }

    private void OnPresentPOInput(ChangeEventArgs e)
    {
        editor.PresentPO = e.Value?.ToString();
        if (sameAddress) editor.PermanentPO = editor.PresentPO;
    }

    private void OnPresentPSInput(ChangeEventArgs e)
    {
        editor.PresentPS = e.Value?.ToString();
        if (sameAddress) editor.PermanentPS = editor.PresentPS;
    }

    private void OnPresentDistrictInput(ChangeEventArgs e)
    {
        editor.PresentDistrict = e.Value?.ToString();
        if (sameAddress) editor.PermanentDistrict = editor.PresentDistrict;
    }

    private void CalculateAgeFromDob(DateTime dob)
    {
        var today = DateTime.Today;
        if (dob > today) dob = today;
        
        var years = today.Year - dob.Year;
        var months = today.Month - dob.Month;
        var days = today.Day - dob.Day;

        if (days < 0)
        {
            months--;
            days += DateTime.DaysInMonth(today.Year, (today.Month == 1 ? 12 : today.Month - 1));
        }
        if (months < 0)
        {
            years--;
            months += 12;
        }
        if (years < 0) years = 0;

        ageYears = years;
        ageMonths = months;
        ageDays = days;
        ageHours = 0;
    }

    private async Task OnIdInput(ChangeEventArgs e)
    {
        idInput = e.Value?.ToString() ?? string.Empty;
        await FilterIdSuggestionsAsync();
    }

    private async Task FilterIdSuggestionsAsync()
    {
        var term = (idInput ?? string.Empty).Trim();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (string.IsNullOrWhiteSpace(term) || term.Equals("AUTO", StringComparison.OrdinalIgnoreCase))
            {
                idSuggestions = await db.Registrations.AsNoTracking()
                    .OrderByDescending(x => x.ID)
                    .Take(6)
                    .ToListAsync();
            }
            else
            {
                // Fast indexed query using StartsWith
                idSuggestions = await db.Registrations.AsNoTracking()
                    .Where(x => x.PatientID.StartsWith(term))
                    .OrderByDescending(x => x.ID)
                    .Take(6)
                    .ToListAsync();

                if (idSuggestions.Count == 0 && term.Length >= 3)
                {
                    idSuggestions = await db.Registrations.AsNoTracking()
                        .Where(x => x.Name != null && x.Name.StartsWith(term))
                        .OrderByDescending(x => x.ID)
                        .Take(6)
                        .ToListAsync();
                }
            }
            showIdSuggestions = idSuggestions.Count > 0;
        }
        catch
        {
            idSuggestions.Clear();
            showIdSuggestions = false;
        }
    }

    private async Task OnPhoneInput(ChangeEventArgs e)
    {
        editor.Contact = e.Value?.ToString() ?? string.Empty;
        await FilterPhoneSuggestionsAsync();
    }

    private async Task FilterPhoneSuggestionsAsync()
    {
        var term = (editor.Contact ?? string.Empty).Trim();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (string.IsNullOrWhiteSpace(term))
            {
                phoneSuggestions = await db.Registrations.AsNoTracking()
                    .Where(x => x.Contact != null && x.Contact != "")
                    .OrderByDescending(x => x.ID)
                    .Take(6)
                    .ToListAsync();
            }
            else
            {
                // Fast indexed query using StartsWith
                phoneSuggestions = await db.Registrations.AsNoTracking()
                    .Where(x => x.Contact != null && x.Contact.StartsWith(term))
                    .OrderByDescending(x => x.ID)
                    .Take(6)
                    .ToListAsync();

                if (phoneSuggestions.Count == 0 && term.Length >= 4)
                {
                    phoneSuggestions = await db.Registrations.AsNoTracking()
                        .Where(x => x.Contact != null && x.Contact.EndsWith(term))
                        .OrderByDescending(x => x.ID)
                        .Take(6)
                        .ToListAsync();
                }
            }
            showPhoneSuggestions = phoneSuggestions.Count > 0;
        }
        catch
        {
            phoneSuggestions.Clear();
            showPhoneSuggestions = false;
        }
    }

    private void SelectSuggestion(Registration p)
    {
        showIdSuggestions = false;
        showPhoneSuggestions = false;
        Select(p);
        messageClass = "success";
        message = $"Loaded patient {p.PatientID} - {p.Name}";
    }

    private async Task HandleIdKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Tab")
        {
            showIdSuggestions = false;
            if (e.ShiftKey)
            {
                await JS.InvokeVoidAsync("hpm.focusElementById", "btn-save-profile");
            }
        }
        else if (e.Key == "Escape")
        {
            showIdSuggestions = false;
            idInput = string.Empty;
            if (editor.ID > 0) Reset();
            message = string.Empty;
        }
        else if (e.Key == "Enter")
        {
            showIdSuggestions = false;
            await SearchByIdAsync();
        }
    }

    private async Task HandlePhoneKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Tab")
        {
            showPhoneSuggestions = false;
        }
        else if (e.Key == "Escape")
        {
            showPhoneSuggestions = false;
            editor.Contact = string.Empty;
            if (editor.ID > 0) Reset();
            message = string.Empty;
        }
        else if (e.Key == "Enter")
        {
            showPhoneSuggestions = false;
            await SearchByPhoneAsync();
        }
    }

    private async Task HandleSaveButtonKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Tab" && !e.ShiftKey)
        {
            // Loop back to first input
            await JS.InvokeVoidAsync("hpm.focusElementById", "input-patient-id");
        }
    }

    private async Task SearchByIdAsync()
    {
        showIdSuggestions = false;
        if (string.IsNullOrWhiteSpace(idInput) || idInput.Trim().Equals("AUTO", StringComparison.OrdinalIgnoreCase))
        {
            Reset();
            return;
        }

        var term = idInput.Trim();
        if (term.StartsWith("HPM:PAT|", StringComparison.OrdinalIgnoreCase))
        {
            var match = System.Text.RegularExpressions.Regex.Match(term, @"REG:([^|]+)");
            if (match.Success) term = match.Groups[1].Value;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            
            // 1. Direct index lookup on PatientID
            var patient = await db.Registrations.AsNoTracking()
                .FirstOrDefaultAsync(x => x.PatientID == term);

            // 2. Direct lookup on numeric ID
            if (patient == null && long.TryParse(term, out var numId))
            {
                patient = await db.Registrations.AsNoTracking()
                    .FirstOrDefaultAsync(x => x.ID == numId);
            }

            // 3. Direct lookup on Contact Mobile
            if (patient == null)
            {
                patient = await db.Registrations.AsNoTracking()
                    .FirstOrDefaultAsync(x => x.Contact == term);
            }

            if (patient != null)
            {
                Select(patient);
                messageClass = "success";
                message = $"Loaded patient {patient.PatientID} - {patient.Name}";
            }
            else
            {
                messageClass = "danger";
                message = $"No patient record found for ID / mobile: '{term}'";
            }
        }
        catch (Exception ex)
        {
            messageClass = "danger";
            message = $"Search error: {ex.GetBaseException().Message}";
        }
    }

    private async Task SearchByPhoneAsync()
    {
        showPhoneSuggestions = false;
        if (string.IsNullOrWhiteSpace(editor.Contact)) return;
        var phone = editor.Contact.Trim();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var patient = await db.Registrations.AsNoTracking()
                .Where(x => x.Contact == phone)
                .OrderByDescending(x => x.ID)
                .FirstOrDefaultAsync();

            if (patient == null && phone.StartsWith("0") && phone.Length == 11)
            {
                var noZero = phone.Substring(1);
                patient = await db.Registrations.AsNoTracking()
                    .Where(x => x.Contact != null && x.Contact.EndsWith(noZero))
                    .OrderByDescending(x => x.ID)
                    .FirstOrDefaultAsync();
            }

            if (patient != null)
            {
                Select(patient);
                messageClass = "success";
                message = $"Loaded patient {patient.PatientID} - {patient.Name}";
            }
            else
            {
                messageClass = "danger";
                message = $"No patient found with mobile number '{phone}'";
            }
        }
        catch (Exception ex)
        {
            messageClass = "danger";
            message = $"Search error: {ex.GetBaseException().Message}";
        }
    }

    private void Select(Registration p)
    {
        PatientSelection.Select(p.PatientID);
        editor = new Registration
        {
            ID = p.ID,
            PatientID = p.PatientID,
            Name = p.Name,
            DateOfBirth = p.DateOfBirth,
            Sex = p.Sex,
            BloodGroup = p.BloodGroup,
            FatherName = p.FatherName,
            MotherName = p.MotherName,
            CareOf = p.CareOf,
            Contact = p.Contact,
            Email = p.Email,
            Occupation = p.Occupation,
            PresentVillage = p.PresentVillage,
            PresentPO = p.PresentPO,
            PresentPS = p.PresentPS,
            PresentDistrict = p.PresentDistrict,
            PermanentVillage = p.PermanentVillage,
            PermanentPO = p.PermanentPO,
            PermanentPS = p.PermanentPS,
            PermanentDistrict = p.PermanentDistrict,
            EnteredBy = p.EnteredBy,
            TransDate = p.TransDate
        };
        sameAddress = string.Equals(p.PresentVillage, p.PermanentVillage, StringComparison.OrdinalIgnoreCase)
            && string.Equals(p.PresentPO, p.PermanentPO, StringComparison.OrdinalIgnoreCase)
            && string.Equals(p.PresentPS, p.PermanentPS, StringComparison.OrdinalIgnoreCase)
            && string.Equals(p.PresentDistrict, p.PermanentDistrict, StringComparison.OrdinalIgnoreCase);
        idInput = p.PatientID;
        CalculateAgeFromDob(editor.DateOfBirth);
        if (sameAddress)
        {
            editor.PermanentVillage = editor.PresentVillage;
            editor.PermanentPO = editor.PresentPO;
            editor.PermanentPS = editor.PresentPS;
            editor.PermanentDistrict = editor.PresentDistrict;
        }
    }

    private async Task SaveAsync()
    {
        saving = true;
        message = string.Empty;
        try
        {
            if (sameAddress)
            {
                editor.PermanentVillage = editor.PresentVillage;
                editor.PermanentPO = editor.PresentPO;
                editor.PermanentPS = editor.PresentPS;
                editor.PermanentDistrict = editor.PresentDistrict;
            }

            if (editor.ID <= 0)
            {
                await CreatePatientAsync();
            }
            else
            {
                await UpdatePatientAsync();
            }

            messageClass = "success";
            message = $"Patient profile {editor.PatientID} saved successfully.";
        }
        catch (Exception ex)
        {
            messageClass = "danger";
            message = $"Could not save patient: {ex.GetBaseException().Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task CreatePatientAsync()
    {
        await using var strategyDb = await DbFactory.CreateDbContextAsync();
        var strategy = strategyDb.Database.CreateExecutionStrategy();
        Registration? created = null;

        await strategy.ExecuteAsync(async () =>
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await using var transaction = await db.Database.BeginTransactionAsync(System.Data.IsolationLevel.ReadCommitted);

            await SqlServerConcurrency.AcquireTransactionLockAsync(db, "HPM:PatientID");
            var next = (await db.Registrations.MaxAsync(x => (long?)x.ID) ?? 0) + 1;
            var generatedPatientId = $"{DateTime.Today.Year}{next:00000}";
            if (generatedPatientId.Length > 11)
                throw new InvalidOperationException("Patient number capacity has been reached for the current format.");

            var entity = new Registration
            {
                PatientID = generatedPatientId,
                Name = editor.Name?.Trim() ?? string.Empty,
                DateOfBirth = editor.DateOfBirth,
                Sex = editor.Sex,
                BloodGroup = editor.BloodGroup,
                FatherName = editor.FatherName,
                MotherName = editor.MotherName,
                CareOf = editor.CareOf,
                PresentVillage = editor.PresentVillage,
                PresentPO = editor.PresentPO,
                PresentPS = editor.PresentPS,
                PresentDistrict = editor.PresentDistrict,
                PermanentVillage = editor.PermanentVillage,
                PermanentPO = editor.PermanentPO,
                PermanentPS = editor.PermanentPS,
                PermanentDistrict = editor.PermanentDistrict,
                Contact = editor.Contact,
                Email = editor.Email,
                Occupation = editor.Occupation,
                EnteredBy = editor.EnteredBy <= 0 ? 1 : editor.EnteredBy,
                TransDate = DateTime.Now
            };

            db.Registrations.Add(entity);
            await db.SaveChangesAsync();
            await transaction.CommitAsync();
            created = entity;
        });

        if (created is null)
            throw new InvalidOperationException("Patient profile could not be created.");

        editor.ID = created.ID;
        editor.PatientID = created.PatientID;
        editor.TransDate = created.TransDate;
        idInput = created.PatientID;
        PatientSelection.Select(created.PatientID);
    }

    private async Task UpdatePatientAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Registrations.FindAsync(editor.ID);
        if (entity is null)
            throw new InvalidOperationException($"Patient record #{editor.ID} was not found to update.");

        entity.Name = editor.Name?.Trim() ?? string.Empty;
        entity.DateOfBirth = editor.DateOfBirth;
        entity.Sex = editor.Sex;
        entity.BloodGroup = editor.BloodGroup;
        entity.FatherName = editor.FatherName;
        entity.MotherName = editor.MotherName;
        entity.CareOf = editor.CareOf;
        entity.PresentVillage = editor.PresentVillage;
        entity.PresentPO = editor.PresentPO;
        entity.PresentPS = editor.PresentPS;
        entity.PresentDistrict = editor.PresentDistrict;
        entity.PermanentVillage = editor.PermanentVillage;
        entity.PermanentPO = editor.PermanentPO;
        entity.PermanentPS = editor.PermanentPS;
        entity.PermanentDistrict = editor.PermanentDistrict;
        entity.Contact = editor.Contact;
        entity.Email = editor.Email;
        entity.Occupation = editor.Occupation;

        await db.SaveChangesAsync();
        editor.PatientID = entity.PatientID;
        editor.TransDate = entity.TransDate;
        idInput = entity.PatientID;
        PatientSelection.Select(entity.PatientID);
    }

    private void Reset()
    {
        PatientSelection.Clear();
        editor = NewPatient();
        idInput = string.Empty;
        sameAddress = true;
        showIdSuggestions = false;
        showPhoneSuggestions = false;
        showCardPreview = false;
        CalculateAgeFromDob(editor.DateOfBirth);
        message = string.Empty;
    }

