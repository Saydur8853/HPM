    private string? webcamError;

    private async Task OpenWebcamModal()
    {
        webcamError = null;
        isWebcamReady = false;
        isCapturingWebcam = false;
        showWebcamModal = true;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        try
        {
            var res = await JS.InvokeAsync<WebcamResult>("hpm.startWebcam", "patient-webcam-preview");
            if (res != null && res.Success)
            {
                isWebcamReady = true;
            }
            else
            {
                webcamError = res?.Error ?? "Could not access camera.";
            }
        }
        catch (Exception ex)
        {
            webcamError = ex.Message;
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CaptureWebcamPhotoAsync()
    {
        if (isCapturingWebcam) return;
        isCapturingWebcam = true;
        webcamError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var res = await JS.InvokeAsync<WebcamCaptureResult>("hpm.captureWebcam", "patient-webcam-preview", 360);
            if (res != null && res.Success && !string.IsNullOrWhiteSpace(res.DataUrl))
            {
                editor.PhotoData = res.DataUrl;
                await CloseWebcamModal();
            }
            else
            {
                webcamError = res?.Error ?? "Failed to capture image.";
            }
        }
        catch (Exception ex)
        {
            webcamError = ex.Message;
        }
        finally
        {
            isCapturingWebcam = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CloseWebcamModal()
    {
        try
        {
            await JS.InvokeVoidAsync("hpm.stopWebcam", "patient-webcam-preview");
        }
        catch { }
        showWebcamModal = false;
        isWebcamReady = false;
        isCapturingWebcam = false;
        webcamError = null;
    }

    private async Task HandlePhotoUpload(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;
            var resizedImage = await file.RequestImageFileAsync("image/jpeg", 400, 400);
            using var stream = resizedImage.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var base64 = Convert.ToBase64String(ms.ToArray());
            editor.PhotoData = $"data:image/jpeg;base64,{base64}";
        }
        catch (Exception ex)
        {
            messageClass = "danger";
            message = $"Photo upload failed: {ex.Message}";
        }
    }

    private async Task TriggerPhotoUpload()
    {
        await JS.InvokeVoidAsync("hpm.clickElementById", "patient-file-upload-input");
    }

    private void RemovePhoto()
    {
        editor.PhotoData = null;
    }

    private string FormattedAge
    {
        get
        {
            if (ageYears.HasValue && ageYears.Value > 0) return $"{ageYears.Value} Y";
            if (ageMonths.HasValue && ageMonths.Value > 0) return $"{ageMonths.Value} M";
            if (ageDays.HasValue && ageDays.Value > 0) return $"{ageDays.Value} D";
            if (ageYears.HasValue) return $"{ageYears.Value} Y";
            return "0 Y";
        }
    }

    protected override Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        CalculateAgeFromDob(editor.DateOfBirth);
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            shortcutReference = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("hpm.attachPatientShortcuts", shortcutReference);
            }
            catch
            {
                // Defensive guard against circuit interruption or JS loading delay
            }
        }

        if (showIdSuggestions)
        {
            shortcutReference ??= DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("hpm.initPatientIdScroll", "patient-id-suggestions-list", shortcutReference, nameof(LoadMorePatientsFromJs));
            }
            catch
            {
            }
        }

        if (showPhoneSuggestions)
        {
            shortcutReference ??= DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("hpm.initPatientIdScroll", "patient-phone-suggestions-list", shortcutReference, nameof(LoadMorePhonesFromJs));
            }
            catch
            {
            }
        }
    }

    [JSInvokable]
    public async Task HandlePatientShortcut(string action)
    {
        if (saving || deletingDependency) return;

        switch (action)
        {
            case "print":
                if (editor.ID > 0)
                {
                    showCardPreview = true;
                    await InvokeAsync(StateHasChanged);
                }
                else
                {
                    messageClass = "danger";
                    message = "Please select or register a patient first to print the card.";
                    await InvokeAsync(StateHasChanged);
                }
                break;

            case "save":
                if (editor.ID > 0)
                {
                    messageClass = "danger";
                    message = "This is an existing patient. Press Ctrl+U to update the profile.";
                    return;
                }
                await JS.InvokeVoidAsync("hpm.clickElementById", "btn-save-profile");
                break;

            case "update":
                if (editor.ID <= 0)
                {
                    messageClass = "danger";
                    message = "Search and load a patient before using Ctrl+U.";
                    return;
                }
                await JS.InvokeVoidAsync("hpm.clickElementById", "btn-save-profile");
                break;

            case "clear":
                if (showCardPreview)
                {
                    showCardPreview = false;
                    await InvokeAsync(StateHasChanged);
                    break;
                }
                CancelPatientAction();
                showDependencyModal = false;
                dependencyMessage = string.Empty;
                Reset();
                await InvokeAsync(StateHasChanged);
                await JS.InvokeVoidAsync("hpm.focusElementById", "input-patient-id");
                break;
        }
    }

    [JSInvokable]
    public async Task HandlePatientClickOutside(bool outsideId, bool outsidePhone)
    {
        bool changed = false;
        if (outsideId && showIdSuggestions)
        {
            showIdSuggestions = false;
            changed = true;
        }
        if (outsidePhone && showPhoneSuggestions)
        {
            showPhoneSuggestions = false;
            changed = true;
        }
        if (changed)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private void HandleLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnDobChangedAfter()
    {
        CalculateAgeFromDob(editor.DateOfBirth);
    }

    private void OnAgeChanged(string part, ChangeEventArgs e)
    {
        var raw = e.Value?.ToString()?.Trim();
        int? value = int.TryParse(raw, out var parsed) ? parsed : null;
        switch (part)
        {
            case "years":
                ageYears = value.HasValue ? Math.Clamp(value.Value, 0, 150) : null;
                break;
            case "months":
                ageMonths = value.HasValue ? Math.Clamp(value.Value, 0, 11) : null;
                break;
            case "days":
                ageDays = value.HasValue ? Math.Clamp(value.Value, 0, 30) : null;
                break;
        }
    }

    private void OnSameAddressCheckboxChanged(ChangeEventArgs e)
    {
        sameAddress = (bool)(e.Value ?? false);
        if (sameAddress)
        {
            editor.PermanentVillage = editor.PresentVillage;
            editor.PermanentPO = editor.PresentPO;
            editor.PermanentPS = editor.PresentPS;
            editor.PermanentDistrict = editor.PresentDistrict;
        }
    }

    public static string ToTitleCase(string? str)
    {
        if (string.IsNullOrWhiteSpace(str)) return str ?? string.Empty;
        var chars = str.ToCharArray();
        bool newWord = true;
        for (int i = 0; i < chars.Length; i++)
        {
            if (char.IsWhiteSpace(chars[i]) || chars[i] == '-' || chars[i] == '.' || chars[i] == '/' || chars[i] == ',')
            {
                newWord = true;
            }
            else if (newWord && char.IsLetter(chars[i]))
            {
                chars[i] = char.ToUpper(chars[i]);
                newWord = false;
            }
        }
        return new string(chars);
    }

    private void OnPresentVillageInput(ChangeEventArgs e)
    {
        editor.PresentVillage = ToTitleCase(e.Value?.ToString());
        if (sameAddress) editor.PermanentVillage = editor.PresentVillage;
    }

    private void OnPresentPOInput(ChangeEventArgs e)
    {
        editor.PresentPO = ToTitleCase(e.Value?.ToString());
        if (sameAddress) editor.PermanentPO = editor.PresentPO;
    }

    private void OnPresentPSInput(ChangeEventArgs e)
    {
        editor.PresentPS = ToTitleCase(e.Value?.ToString());
        if (sameAddress) editor.PermanentPS = editor.PresentPS;
    }

    private void OnPresentDistrictInput(ChangeEventArgs e)
    {
        editor.PresentDistrict = ToTitleCase(e.Value?.ToString());
        if (sameAddress) editor.PermanentDistrict = editor.PresentDistrict;
    }

    private void OnPermanentVillageInput(ChangeEventArgs e)
    {
        editor.PermanentVillage = ToTitleCase(e.Value?.ToString());
    }

    private void OnPermanentPOInput(ChangeEventArgs e)
    {
        editor.PermanentPO = ToTitleCase(e.Value?.ToString());
    }

    private void OnPermanentPSInput(ChangeEventArgs e)
    {
        editor.PermanentPS = ToTitleCase(e.Value?.ToString());
    }

    private void OnPermanentDistrictInput(ChangeEventArgs e)
    {
        editor.PermanentDistrict = ToTitleCase(e.Value?.ToString());
    }

    private void CalculateAgeFromDob(DateTime? dob)
    {
        if (!dob.HasValue)
        {
            ageYears = null;
            ageMonths = null;
            ageDays = null;
            return;
        }
        var today = DateTime.Today;
        var d = dob.Value;
        if (d > today) d = today;
        
        var years = today.Year - d.Year;
        var months = today.Month - d.Month;
        var days = today.Day - d.Day;

        if (days < 0)
        {
            months--;
            days += DateTime.DaysInMonth(today.Year, (today.Month == 1 ? 12 : today.Month - 1));
        }
        if (months < 0)
        {
            years--;
            months += 12;
        }
        if (years < 0) years = 0;

        ageYears = years;
        ageMonths = months;
        ageDays = days;
    }

    private async Task OnIdInput(ChangeEventArgs e)
    {
        idInput = e.Value?.ToString() ?? string.Empty;
        await FilterIdSuggestionsAsync();
    }

    private static IQueryable<Registration> BuildPatientQuery(HpmDbContext db, string term)
    {
        IQueryable<Registration> q = db.Registrations.AsNoTracking();
        if (string.IsNullOrWhiteSpace(term) || term.Equals("AUTO", StringComparison.OrdinalIgnoreCase))
        {
            return q.OrderByDescending(x => x.ID);
        }
        return q.Where(x => x.PatientID.StartsWith(term)
                         || (x.Contact != null && x.Contact.StartsWith(term))
                         || (x.Name != null && x.Name.Contains(term)))
                .OrderByDescending(x => x.ID);
    }

    private async Task FilterIdSuggestionsAsync()
    {
        var term = (idInput ?? string.Empty).Trim();
        hasMorePatientIdSuggestions = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var q = BuildPatientQuery(db, term);
            idSuggestions = await q.Take(patientPageSize).ToListAsync();
            hasMorePatientIdSuggestions = idSuggestions.Count >= patientPageSize;
            showIdSuggestions = idSuggestions.Count > 0;
            try
            {
                await JS.InvokeVoidAsync("hpm.resetPatientIdScrollTop", "patient-id-suggestions-list");
            }
            catch { }
        }
        catch
        {
            idSuggestions.Clear();
            showIdSuggestions = false;
            hasMorePatientIdSuggestions = false;
        }
    }

    [JSInvokable]
    public async Task LoadMorePatientsFromJs()
    {
        if (isLoadingMorePatients || !hasMorePatientIdSuggestions || !showIdSuggestions) return;
        isLoadingMorePatients = true;
        await InvokeAsync(StateHasChanged);

        var term = (idInput ?? string.Empty).Trim();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var q = BuildPatientQuery(db, term);
            var nextBatch = await q.Skip(idSuggestions.Count).Take(patientPageSize).ToListAsync();
            if (nextBatch.Count > 0)
            {
                idSuggestions.AddRange(nextBatch);
                hasMorePatientIdSuggestions = nextBatch.Count >= patientPageSize;
            }
            else
            {
                hasMorePatientIdSuggestions = false;
            }
        }
        catch
        {
            hasMorePatientIdSuggestions = false;
        }
        finally
        {
            isLoadingMorePatients = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnPhoneInput(ChangeEventArgs e)
    {
        editor.Contact = e.Value?.ToString() ?? string.Empty;
        await FilterPhoneSuggestionsAsync();
    }

    private static IQueryable<Registration> BuildPhoneQuery(HpmDbContext db, string term)
    {
        IQueryable<Registration> q = db.Registrations.AsNoTracking().Where(x => x.Contact != null && x.Contact != "");
        if (string.IsNullOrWhiteSpace(term))
        {
            return q.OrderByDescending(x => x.ID);
        }
        return q.Where(x => x.Contact!.StartsWith(term) || x.Contact!.Contains(term))
                .OrderByDescending(x => x.ID);
    }

    private async Task FilterPhoneSuggestionsAsync()
    {
        var term = (editor.Contact ?? string.Empty).Trim();
        hasMorePhoneSuggestions = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var q = BuildPhoneQuery(db, term);
            phoneSuggestions = await q.Take(patientPageSize).ToListAsync();
            hasMorePhoneSuggestions = phoneSuggestions.Count >= patientPageSize;
            showPhoneSuggestions = phoneSuggestions.Count > 0;
            try
            {
                await JS.InvokeVoidAsync("hpm.resetPatientIdScrollTop", "patient-phone-suggestions-list");
            }
            catch { }
        }
        catch
        {
            phoneSuggestions.Clear();
            showPhoneSuggestions = false;
            hasMorePhoneSuggestions = false;
        }
    }

    [JSInvokable]
    public async Task LoadMorePhonesFromJs()
    {
        if (isLoadingMorePhones || !hasMorePhoneSuggestions || !showPhoneSuggestions) return;
        isLoadingMorePhones = true;
        await InvokeAsync(StateHasChanged);

        var term = (editor.Contact ?? string.Empty).Trim();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var q = BuildPhoneQuery(db, term);
            var nextBatch = await q.Skip(phoneSuggestions.Count).Take(patientPageSize).ToListAsync();
            if (nextBatch.Count > 0)
            {
                phoneSuggestions.AddRange(nextBatch);
                hasMorePhoneSuggestions = nextBatch.Count >= patientPageSize;
            }
            else
            {
                hasMorePhoneSuggestions = false;
            }
        }
        catch
        {
            hasMorePhoneSuggestions = false;
        }
        finally
        {
            isLoadingMorePhones = false;
            await InvokeAsync(StateHasChanged);
        }
    }

