    private async Task DeleteAsync()
    {
        if (editor.ID == 0) return;

        await LoadPatientDependenciesAsync();
        if (patientDependencies.Count > 0)
        {
            dependencyMessage = string.Empty;
            dependencyMessageIsError = false;
            showDependencyModal = true;
            return;
        }

        RequestPatientProfileDeletion();
    }

    private void RequestPatientProfileDeletion()
    {
        if (editor.ID == 0 || patientDependencies.Count > 0) return;
        pendingDependency = null;
        actionDialogReason = string.Empty;
        actionDialogError = string.Empty;
        confirmingProfileDeletion = true;
    }

    private async Task DeletePatientProfileConfirmedAsync()
    {
        if (editor.ID == 0) return;

        await LoadPatientDependenciesAsync();
        if (patientDependencies.Count > 0)
        {
            dependencyMessageIsError = true;
            dependencyMessage = "New dependent records were found. Delete every listed record before deleting the patient profile.";
            showDependencyModal = true;
            confirmingProfileDeletion = false;
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Registrations.FindAsync(editor.ID);
        if (entity is not null)
        {
            db.Registrations.Remove(entity);
            await db.SaveChangesAsync();
        }

        showDependencyModal = false;
        confirmingProfileDeletion = false;
        Reset();
        messageClass = "success";
        message = "Patient profile deleted.";
    }

    private async Task LoadPatientDependenciesAsync()
    {
        var patientId = editor.PatientID;
        await using var db = await DbFactory.CreateDbContextAsync();
        var items = new List<PatientDependencyItem>();

        var appointments = await db.DoctorAppointments.AsNoTracking().Where(x => x.PatientID == patientId).ToListAsync();
        items.AddRange(appointments.Select(x => new PatientDependencyItem("appointment", x.ID, "Doctor appointment", $"Appointment #{x.ID}", $"Status: {x.Status}; Serial: {x.ApptSLNO}", x.ApptDate, 70)));

        var tickets = await db.OPDTickets.AsNoTracking().Where(x => x.RegNo == patientId).ToListAsync();
        items.AddRange(tickets.Select(x => new PatientDependencyItem("ticket", x.ID, "OPD ticket", $"Ticket #{x.ID}", $"Amount: {x.Total:N2}; Doctor ID: {x.DoctorID}", x.TransDate, 70)));

        var encounters = await db.PatientEncounters.AsNoTracking().Where(x => x.PatientID == patientId).ToListAsync();
        items.AddRange(encounters.Select(x => new PatientDependencyItem("encounter", x.ID, "Clinical encounter", $"Encounter #{x.ID}", $"{x.VisitType}; Status: {x.Status}", x.CheckedInAt, 60)));

        var prescriptions = await db.Prescriptions.AsNoTracking().Where(x => x.PatientID == patientId).ToListAsync();
        items.AddRange(prescriptions.Select(x => new PatientDependencyItem("prescription", x.ID, "Prescription", $"Prescription #{x.ID}", $"Status: {x.Status}", x.SignedAt ?? x.VisitDate ?? DateTime.MinValue, 20)));

        var diagnosticOrders = await db.DiagnosticOrders.AsNoTracking().Where(x => x.PatientID == patientId).ToListAsync();
        items.AddRange(diagnosticOrders.Select(x => new PatientDependencyItem("diagnostic-order", x.ID, "Diagnostic order", $"Order #{x.ID}", $"Status: {x.Status}", x.OrderedAt, 10)));

        var emergencyMemos = await db.EmergencyMemos.AsNoTracking()
            .Where(x => x.PatientID == patientId || x.RegNo == patientId).ToListAsync();
        items.AddRange(emergencyMemos.Select(x => new PatientDependencyItem("emergency-memo", x.ID, "Cash memo / diagnostic bill", $"Memo #{x.ID}", $"Total: {x.Total:N2}; Paid: {x.Paid:N2}", x.TransDate, 30)));

        var otMemos = await db.OTCashMemos.AsNoTracking()
            .Where(x => x.PatientID == patientId || x.RegNo == patientId).ToListAsync();
        items.AddRange(otMemos.Select(x => new PatientDependencyItem("ot-memo", x.ID, "OT cash memo", $"Memo #{x.ID}", $"Total: {x.Total:N2}; Discount: {x.Discount:N2}", x.TransDate, 30)));

        var admissions = await db.PatientAdmissions.AsNoTracking().Where(x => x.PatientID == patientId).ToListAsync();
        foreach (var admission in admissions)
        {
            var regNo = admission.RegNo;

            var finalBills = await db.IpdFinalBills.AsNoTracking().Where(x => x.AdmissionID == admission.ID || x.RegNo == regNo).ToListAsync();
            items.AddRange(finalBills.Select(x => new PatientDependencyItem("ipd-final-bill", x.BillNo, "IPD final bill", $"Bill #{x.BillNo} / {regNo}", $"Net: {x.NetAmount:N2}; {x.SettlementStatus}", x.GeneratedAt, 10)));

            var dischargeOrders = await db.IpdMedicalDischargeOrders.AsNoTracking().Where(x => x.AdmissionID == admission.ID).ToListAsync();
            items.AddRange(dischargeOrders.Select(x => new PatientDependencyItem("ipd-discharge", x.ID, "IPD discharge order", $"Order #{x.ID} / {regNo}", $"Status: {x.Status}; Outcome: {x.Outcome}", x.OrderedAt, 20)));

            var receipts = await db.IpdMoneyReceipts.AsNoTracking().Where(x => x.RegNo == regNo).ToListAsync();
            items.AddRange(receipts.Select(x => new PatientDependencyItem("ipd-receipt", x.ID, "IPD money receipt", $"Receipt #{x.ID} / {regNo}", $"{x.Against}: {x.Amount:N2}", x.TransDate, 30)));

            var payments = await db.PatientPayments.AsNoTracking().Where(x => x.RegNo == regNo).ToListAsync();
            items.AddRange(payments.Select(x => new PatientDependencyItem("ipd-payment", x.ID, "IPD patient payment", $"Payment #{x.ID} / {regNo}", $"Amount: {x.Amount:N2}", x.TransDate, 30)));

            var services = await db.IpdPatientServiceItems.AsNoTracking().Where(x => x.RegNo == regNo).ToListAsync();
            items.AddRange(services.Select(x => new PatientDependencyItem("ipd-service", x.ID, "IPD service item", $"Service #{x.ID} / {regNo}", $"{x.ServiceName}: {x.Total:N2}", x.ServiceDate, 30)));

            var bedTransactions = await db.BedCabinTransactions.AsNoTracking().Where(x => x.RegNo == regNo).ToListAsync();
            items.AddRange(bedTransactions.Select(x => new PatientDependencyItem("ipd-bed-transaction", x.ID, "IPD bed transaction", $"Bed transaction #{x.ID} / {regNo}", $"Bed ID: {x.BedCabinID}; Rate: {x.Rate:N2}", x.StartDate, 30)));

            var bedTurnovers = await db.BedTurnovers.AsNoTracking().Where(x => x.AdmissionID == admission.ID || x.RegNo == regNo).ToListAsync();
            items.AddRange(bedTurnovers.Select(x => new PatientDependencyItem("ipd-bed-turnover", x.ID, "IPD bed turnover", $"Turnover #{x.ID} / {regNo}", $"Bed ID: {x.BedCabinID}; Status: {x.Status}", x.RequestedAt, 30)));

            var transactions = await db.PatientTransactions.AsNoTracking().Where(x => x.RegNo == regNo).ToListAsync();
            items.AddRange(transactions.Select(x => new PatientDependencyItem("ipd-transaction", x.ID, "IPD service transaction", $"Transaction #{x.ID} / {regNo}", $"Amount: {(x.ServiceRate * x.Quantity):N2}", x.TransDate, 30)));

            var packageTransactions = await db.PatientPackageTransactions.AsNoTracking().Where(x => x.RegNo == regNo).ToListAsync();
            items.AddRange(packageTransactions.Select(x => new PatientDependencyItem("ipd-package", x.ID, "IPD package transaction", $"Package transaction #{x.ID} / {regNo}", $"Amount: {(x.ServiceRate * x.Quantity):N2}", x.TransDate, 30)));

            var extensions = await db.AdmissionExtensions.AsNoTracking().Where(x => x.RegNo == regNo).ToListAsync();
            items.AddRange(extensions.Select(x => new PatientDependencyItem("ipd-extension", x.ID, "IPD admission extension", $"Extension #{x.ID} / {regNo}", $"Service: {x.ServiceCharge:N2}; Food: {x.Food:N2}", admission.AdmissionDate ?? DateTime.MinValue, 30)));

            items.Add(new PatientDependencyItem("admission", admission.ID, "IPD admission", $"Admission #{admission.ID} / {regNo}", admission.IsAdmitted == true ? "Currently admitted" : "Released", admission.AdmissionDate ?? admission.TransDate ?? DateTime.MinValue, 90));
        }

        patientDependencies = items.OrderBy(x => x.DeleteOrder).ThenByDescending(x => x.EventDate).ToList();
    }

    private void RequestDependencyDelete(PatientDependencyItem dependency)
    {
        if (deletingDependency) return;
        pendingDependency = dependency;
        confirmingProfileDeletion = false;
        actionDialogReason = string.Empty;
        actionDialogError = string.Empty;
    }

    private async Task ConfirmPatientActionAsync()
    {
        if (confirmingProfileDeletion)
        {
            deletingDependency = true;
            actionDialogError = string.Empty;
            try
            {
                await DeletePatientProfileConfirmedAsync();
            }
            catch (Exception ex)
            {
                actionDialogError = $"Could not delete patient profile: {ex.GetBaseException().Message}";
            }
            finally
            {
                deletingDependency = false;
            }
            return;
        }

        if (pendingDependency is not { } dependency) return;
        if (DependencyRequiresReason(dependency) && string.IsNullOrWhiteSpace(actionDialogReason)) return;
        await DeleteDependencyConfirmedAsync(dependency, actionDialogReason.Trim());
    }

    private async Task DeleteDependencyConfirmedAsync(PatientDependencyItem dependency, string reversalReason)
    {
        deletingDependency = true;
        deletingDependencyKey = dependency.Key;
        dependencyMessage = string.Empty;
        dependencyMessageIsError = false;
        actionDialogError = string.Empty;

        try
        {
            await using var strategyDb = await DbFactory.CreateDbContextAsync();
            var strategy = strategyDb.Database.CreateExecutionStrategy();
            await strategy.ExecuteAsync(async () =>
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                await using var transaction = await db.Database.BeginTransactionAsync();
                var currentUserId = await CurrentUserIdAsync();

                switch (dependency.Type)
                {
                    case "diagnostic-order": await RemoveAsync(db.DiagnosticOrders, dependency.ID); break;
                    case "prescription": await RemoveAsync(db.Prescriptions, dependency.ID); break;
                    case "emergency-memo": await DeleteEmergencyMemoDependencyAsync(db, dependency.ID, reversalReason, currentUserId); break;
                    case "ot-memo": await DeleteOtMemoDependencyAsync(db, dependency.ID, reversalReason, currentUserId); break;
                    case "encounter": await RemoveAsync(db.PatientEncounters, dependency.ID); break;
                    case "appointment": await RemoveAsync(db.DoctorAppointments, checked((int)dependency.ID)); break;
                    case "ticket": await DeleteTicketDependencyAsync(db, dependency.ID, reversalReason, currentUserId); break;
                    case "ipd-final-bill": await RemoveAsync(db.IpdFinalBills, dependency.ID); break;
                    case "ipd-discharge": await RemoveAsync(db.IpdMedicalDischargeOrders, dependency.ID); break;
                    case "ipd-receipt": await RemoveAsync(db.IpdMoneyReceipts, dependency.ID); break;
                    case "ipd-payment": await RemoveAsync(db.PatientPayments, dependency.ID); break;
                    case "ipd-service": await RemoveAsync(db.IpdPatientServiceItems, dependency.ID); break;
                    case "ipd-bed-transaction": await RemoveAsync(db.BedCabinTransactions, dependency.ID); break;
                    case "ipd-bed-turnover": await RemoveAsync(db.BedTurnovers, dependency.ID); break;
                    case "ipd-transaction": await RemoveAsync(db.PatientTransactions, dependency.ID); break;
                    case "ipd-package": await RemoveAsync(db.PatientPackageTransactions, dependency.ID); break;
                    case "ipd-extension": await RemoveAsync(db.AdmissionExtensions, dependency.ID); break;
                    case "admission": await DeleteAdmissionAsync(db, dependency.ID); break;
                    default: throw new InvalidOperationException("Unknown dependent record type.");
                }

                await db.SaveChangesAsync();
                await transaction.CommitAsync();
            });

            dependencyMessageIsError = false;
            dependencyMessage = $"{dependency.Label} deleted successfully.";
            pendingDependency = null;
            actionDialogReason = string.Empty;
            actionDialogError = string.Empty;
        }
        catch (Exception ex)
        {
            dependencyMessageIsError = true;
            dependencyMessage = $"Could not delete {dependency.Label}: {ex.GetBaseException().Message}";
            actionDialogError = dependencyMessage;
        }
        finally
        {
            deletingDependency = false;
            deletingDependencyKey = null;
            await LoadPatientDependenciesAsync();
        }
    }

    private static bool DependencyRequiresReason(PatientDependencyItem dependency)
        => dependency.Type is "ticket" or "emergency-memo" or "ot-memo";

    private void CancelPatientAction()
    {
        if (deletingDependency) return;
        pendingDependency = null;
        confirmingProfileDeletion = false;
        actionDialogReason = string.Empty;
        actionDialogError = string.Empty;
    }

    private static async Task RemoveAsync<TEntity, TKey>(DbSet<TEntity> set, TKey id) where TEntity : class
    {
        var entity = await set.FindAsync(id);
        if (entity is not null) set.Remove(entity);
    }

    private static async Task DeleteTicketDependencyAsync(HpmDbContext db, long ticketId, string reason, int userId)
    {
        var entity = await db.OPDTickets.FindAsync(ticketId);
        if (entity is null) return;

        if (await db.PatientEncounters.AnyAsync(x => x.TicketID == ticketId))
            throw new InvalidOperationException("Delete the listed clinical encounter first.");

        await OperationalAccounting.ReverseRevenueAsync(db, "OPD Ticket", $"OPD-TICKET:{entity.ID}", entity.ID,
            entity.Total, entity.TransDate, userId, reason, AccountingPosting.Cash, AccountingPosting.ModuleFlags.OpdTicket);
        db.OPDTickets.Remove(entity);
    }

    private static async Task DeleteEmergencyMemoDependencyAsync(HpmDbContext db, long memoId, string reason, int userId)
    {
        var entity = await db.EmergencyMemos.FindAsync(memoId);
        if (entity is null) return;

        if (await db.DiagnosticOrders.AnyAsync(x => x.BilledMemoID == memoId))
            throw new InvalidOperationException("Delete the listed diagnostic order first.");

        var isDiagnostic = entity.ModuleID == 2;
        var entityType = isDiagnostic ? "Diagnostic Memo" : "Emergency Memo";
        var reference = $"{(isDiagnostic ? "DIAGNOSTIC" : "EMERGENCY")}:{entity.ID}";
        var moduleFlag = isDiagnostic ? AccountingPosting.ModuleFlags.Diagnostic : AccountingPosting.ModuleFlags.Emergency;
        await OperationalAccounting.ReverseRevenueAsync(db, entityType, reference, entity.ID,
            Math.Max(0, entity.Total - entity.Discount), entity.TransDate, userId, reason, AccountingPosting.Cash, moduleFlag);

        var samples = await db.LabSampleCollections.Where(x => x.MemoID == memoId).ToListAsync();
        var results = await db.LabTestResults.Where(x => x.MemoID == memoId).ToListAsync();
        db.LabSampleCollections.RemoveRange(samples);
        db.LabTestResults.RemoveRange(results);
        db.EmergencyMemos.Remove(entity);
    }

    private static async Task DeleteOtMemoDependencyAsync(HpmDbContext db, long memoId, string reason, int userId)
    {
        var entity = await db.OTCashMemos.FindAsync(memoId);
        if (entity is null) return;

        var debitAccount = entity.PatientType == "1" ? AccountingPosting.Cash : AccountingPosting.PatientReceivable;
        await OperationalAccounting.ReverseRevenueAsync(db, "OT Memo", $"OT-MEMO:{entity.ID}", entity.ID,
            Math.Max(0, entity.Total - entity.Discount), entity.TransDate, userId, reason,
            debitAccount, entity.PatientType == "1" ? AccountingPosting.ModuleFlags.Ot : null);
        db.OTCashMemos.Remove(entity);
    }

    private static async Task DeleteAdmissionAsync(HpmDbContext db, long admissionId)
    {
        var admission = await db.PatientAdmissions.FindAsync(admissionId);
        if (admission is null) return;

        var hasChildren = await db.IpdFinalBills.AnyAsync(x => x.AdmissionID == admissionId || x.RegNo == admission.RegNo)
            || await db.IpdMedicalDischargeOrders.AnyAsync(x => x.AdmissionID == admissionId)
            || await db.IpdMoneyReceipts.AnyAsync(x => x.RegNo == admission.RegNo)
            || await db.PatientPayments.AnyAsync(x => x.RegNo == admission.RegNo)
            || await db.IpdPatientServiceItems.AnyAsync(x => x.RegNo == admission.RegNo)
            || await db.BedCabinTransactions.AnyAsync(x => x.RegNo == admission.RegNo)
            || await db.BedTurnovers.AnyAsync(x => x.AdmissionID == admissionId || x.RegNo == admission.RegNo)
            || await db.PatientTransactions.AnyAsync(x => x.RegNo == admission.RegNo)
            || await db.PatientPackageTransactions.AnyAsync(x => x.RegNo == admission.RegNo)
            || await db.AdmissionExtensions.AnyAsync(x => x.RegNo == admission.RegNo);

        if (hasChildren)
            throw new InvalidOperationException("Delete the listed IPD records for this admission first.");

        if (admission.BedCabinID is int bedId)
        {
            var bed = await db.BedCabins.FindAsync(bedId);
            var usedByAnotherAdmission = await db.PatientAdmissions.AnyAsync(x => x.ID != admissionId && x.BedCabinID == bedId && x.IsAdmitted == true);
            if (bed is not null && !usedByAnotherAdmission)
            {
                bed.IsAllocated = false;
                bed.Status = BedStatuses.Available;
            }
        }

        db.PatientAdmissions.Remove(admission);
    }

    private void CloseDependencyModal()
    {
        if (deletingDependency) return;
        showDependencyModal = false;
        dependencyMessage = string.Empty;
        dependencyMessageIsError = false;
    }

    private async Task<int> CurrentUserIdAsync()
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        return int.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : 1;
    }

    private static string Address(params string?[] parts) => string.Join(", ", parts.Where(x => !string.IsNullOrWhiteSpace(x)));

    public async ValueTask DisposeAsync()
    {
        I18n.OnLanguageChanged -= HandleLanguageChanged;
        if (shortcutReference != null)
        {
            try
            {
                await JS.InvokeVoidAsync("hpm.detachPatientShortcuts");
            }
            catch
            {
                // The circuit is already closed or statically rendered.
            }
            shortcutReference.Dispose();
            shortcutReference = null;
        }
    }

    private sealed record PatientDependencyItem(
        string Type,
        long ID,
        string Label,
        string Reference,
        string Description,
        DateTime EventDate,
        int DeleteOrder)
    {
        public string Key => $"{Type}:{ID}";
    }
