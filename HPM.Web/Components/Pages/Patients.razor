@page "/patients"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.Reception)]
@rendermode InteractiveServer
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject IBarcodeQrService BarcodeQr
@inject PatientSelectionState PatientSelection
@implements IAsyncDisposable
@using System.Security.Claims

<PageTitle>@I18n.T("Patient Registration") | @Branding.HospitalName</PageTitle>

<div class="patient-classic-fit">
    @if (editor.ID > 0)
    {
        <!-- Fast Clinical Action Bar for saved patient (tabindex -1 so Tab skips non-entry links) -->
        <div class="patient-screen-fast-flow">
            <span class="flow-title">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                </svg>
                @I18n.T("Next Action for") <strong>@editor.Name (@editor.PatientID)</strong>:
            </span>
            <div class="flow-actions">
                <a class="flow-pill flow-highlight" tabindex="-1" href="appointments?patientId=@editor.PatientID">&#128197; @I18n.T("Doctor Appointment")</a>
                <a class="flow-pill" tabindex="-1" href="diagnostic/billing?patientId=@editor.PatientID">&#129514; @I18n.T("Diagnostic Bill")</a>
                <a class="flow-pill" tabindex="-1" href="tickets?patientId=@editor.PatientID">&#127915; @I18n.T("OPD Ticket")</a>
                <a class="flow-pill" tabindex="-1" href="ipd/admissions?patientId=@editor.PatientID">&#128719; @I18n.T("IPD Admission")</a>
                <a class="flow-pill" tabindex="-1" href="emergency-services?patientId=@editor.PatientID">&#128680; @I18n.T("Emergency")</a>
                <a class="flow-pill" tabindex="-1" href="patient-documents?patientId=@editor.PatientID">&#128196; @I18n.T("All Reports")</a>
            </div>
        </div>
    }

    <div class="patient-classic-card">
        <EditForm @key="editor.ID" Model="editor" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <div class="patient-sketch-layout">
                <!-- 1. LEFT PANE: Identification, Demographics, Family Details -->
                <div class="sketch-left-pane">
                    <!-- 1: Patient ID Search Combo -->
                    <div class="sketch-row">
                        <span class="sketch-label highlight-search-label">@I18n.T("Patient ID")</span>
                        <div class="id-search-combo search-field-wrapper">
                            <input id="input-patient-id"
                                   class="classic-input id-input" 
                                   tabindex="1"
                                   value="@idInput" 
                                   @oninput="OnIdInput" 
                                   @onkeydown="HandleIdKeyDown" 
                                   @onfocus="FilterIdSuggestionsAsync"
                                   placeholder="@I18n.T("ID")"
                                   title="@I18n.T("Type Patient ID & press Enter to search (or ESC to clear)")" />
                            <button type="button" tabindex="-1" class="id-btn search-btn" @onclick="SearchByIdAsync" title="@I18n.T("Search by ID (Enter)")">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="11" cy="11" r="8"></circle>
                                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                </svg>
                            </button>
                            <!-- Live Suggestions Dropdown for Patient ID -->
                            @if (showIdSuggestions && idSuggestions.Count > 0)
                            {
                                <div class="suggestions-dropdown id-dropdown" id="patient-id-suggestions-list">
                                    <div class="suggestions-header">
                                        <span>@I18n.T("Recent / Matching Patients")</span>
                                        <span class="close-sugg" tabindex="-1" @onclick="() => showIdSuggestions = false" @onmousedown:preventDefault>✕</span>
                                    </div>
                                    @foreach (var p in idSuggestions)
                                    {
                                        <div class="suggestion-item" @onclick="() => SelectSuggestion(p)" @onmousedown:preventDefault>
                                            <div class="sugg-top">
                                                <strong class="sugg-id">@p.PatientID</strong>
                                                <span class="sugg-name">@p.Name</span>
                                            </div>
                                            <div class="sugg-sub">
                                                <span>📞 @p.Contact</span>
                                                <span>🕒 @p.TransDate.ToString("dd-MMM-yyyy hh:mm tt")</span>
                                            </div>
                                        </div>
                                    }
                                    @if (hasMorePatientIdSuggestions)
                                    {
                                        <div class="sugg-scroll-hint" @onclick="LoadMorePatientsFromJs" @onmousedown:preventDefault>
                                            @if (isLoadingMorePatients)
                                            {
                                                <span>@I18n.T("Loading more...")</span>
                                            }
                                            else
                                            {
                                                <span>@I18n.T("Showing") @idSuggestions.Count &bull; @I18n.T("Scroll for more...")</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- 2: Contact No Search Combo -->
                    <div class="sketch-row">
                        <span class="sketch-label highlight-search-label">@I18n.T("Contact No")<span class="req">*</span></span>
                        <div class="phone-search-combo search-field-wrapper">
                            <input id="input-contact-no"
                                   class="classic-input phone-input" 
                                   tabindex="2"
                                   value="@editor.Contact" 
                                   @oninput="OnPhoneInput" 
                                   @onkeydown="HandlePhoneKeyDown" 
                                   @onfocus="FilterPhoneSuggestionsAsync"
                                   placeholder="@I18n.T("Mobile No.")"
                                   title="@I18n.T("Enter mobile & press Enter to search (or ESC to clear)")" />
                            <button type="button" tabindex="-1" class="id-btn search-btn" @onclick="SearchByPhoneAsync" title="@I18n.T("Search by Phone (Enter)")">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="11" cy="11" r="8"></circle>
                                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                </svg>
                            </button>
                            <!-- Live Suggestions Dropdown for Contact No -->
                            @if (showPhoneSuggestions && phoneSuggestions.Count > 0)
                            {
                                <div class="suggestions-dropdown phone-dropdown" id="patient-phone-suggestions-list">
                                    <div class="suggestions-header">
                                        <span>@I18n.T("Recent / Matching Contacts")</span>
                                        <span class="close-sugg" tabindex="-1" @onclick="() => showPhoneSuggestions = false" @onmousedown:preventDefault>✕</span>
                                    </div>
                                    @foreach (var p in phoneSuggestions)
                                    {
                                        <div class="suggestion-item" @onclick="() => SelectSuggestion(p)" @onmousedown:preventDefault>
                                            <div class="sugg-top">
                                                <strong class="sugg-phone">📞 @p.Contact</strong>
                                                <span class="sugg-name">@p.Name</span>
                                            </div>
                                            <div class="sugg-sub">
                                                <span>ID: @p.PatientID</span>
                                                <span>🕒 @p.TransDate.ToString("dd-MMM-yyyy hh:mm tt")</span>
                                            </div>
                                        </div>
                                    }
                                    @if (hasMorePhoneSuggestions)
                                    {
                                        <div class="sugg-scroll-hint" @onclick="LoadMorePhonesFromJs" @onmousedown:preventDefault>
                                            @if (isLoadingMorePhones)
                                            {
                                                <span>@I18n.T("Loading more...")</span>
                                            }
                                            else
                                            {
                                                <span>@I18n.T("Showing") @phoneSuggestions.Count &bull; @I18n.T("Scroll for more...")</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- 3: Name -->
                    <div class="sketch-row">
                        <span class="sketch-label">@I18n.T("Name")<span class="req">*</span></span>
                        <InputText class="classic-input" tabindex="3" @bind-Value="editor.Name" placeholder="@I18n.T("Patient Full Name")" data-autocase="title" />
                    </div>

                    <!-- 4: Sex & Blood Group -->
                    <div class="sketch-row-dual">
                        <div class="sketch-subfield sex-subfield">
                            <span class="sketch-sublabel">@I18n.T("Sex")<span class="req">*</span></span>
                            <div class="sex-btn-group" role="radiogroup" aria-label="@I18n.T("Sex")">
                                @foreach (var sex in sexOptions)
                                {
                                    var isSelected = string.Equals(editor.Sex, sex.Key, StringComparison.OrdinalIgnoreCase);
                                    var sexClass = sex.Key.ToLowerInvariant();
                                    <button type="button"
                                            class="sex-btn sex-btn-@sexClass @(isSelected ? "is-selected" : "")"
                                            tabindex="@(isSelected || (string.IsNullOrEmpty(editor.Sex) && sex.Key == "Male") ? 4 : -1)"
                                            @onclick="() => SelectSex(sex.Key)"
                                            @onkeydown="e => HandleSexKeyDown(e, sex.Key)"
                                            title="@I18n.T(sex.Label)">
                                        <span class="sex-icon">
                                            @if (sex.Key == "Male")
                                            {
                                                <svg class="sex-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <circle cx="10" cy="14" r="5"></circle>
                                                    <line x1="19" y1="5" x2="13.6" y2="10.4"></line>
                                                    <polyline points="15 5 19 5 19 9"></polyline>
                                                </svg>
                                            }
                                            else if (sex.Key == "Female")
                                            {
                                                <svg class="sex-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <circle cx="12" cy="9" r="5"></circle>
                                                    <line x1="12" y1="14" x2="12" y2="21"></line>
                                                    <line x1="9" y1="18" x2="15" y2="18"></line>
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg class="sex-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <circle cx="12" cy="12" r="4"></circle>
                                                    <line x1="12" y1="4" x2="12" y2="8"></line>
                                                    <line x1="10" y1="5" x2="14" y2="5"></line>
                                                    <line x1="12" y1="16" x2="12" y2="20"></line>
                                                    <line x1="10" y1="19" x2="14" y2="19"></line>
                                                </svg>
                                            }
                                        </span>
                                        <span class="sex-text">@I18n.T(sex.Label)</span>
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="sketch-subfield blood-group-subfield">
                            <span class="sketch-sublabel">@I18n.T("Blood Group")</span>
                            <div class="blood-btn-group" role="radiogroup" aria-label="@I18n.T("Blood Group")">
                                @foreach (var bg in bloodGroups)
                                {
                                    var isSelected = string.Equals(editor.BloodGroup, bg, StringComparison.OrdinalIgnoreCase);
                                    var isWide = bg.Length > 2;
                                    <button type="button"
                                            class="blood-btn @(isWide ? "is-wide" : "") @(isSelected ? "is-selected" : "")"
                                            tabindex="@(isSelected || (string.IsNullOrEmpty(editor.BloodGroup) && bg == "A+") ? 5 : -1)"
                                            @onclick="() => SelectBloodGroup(bg)"
                                            @onkeydown="e => HandleBloodGroupKeyDown(e, bg)"
                                            title="@bg">
                                        @bg
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- 5: Age & DOB -->
                    <div class="sketch-row-dual">
                        <div class="sketch-subfield">
                            <span class="sketch-sublabel">@I18n.T("Age")<span class="req">*</span></span>
                            <div class="age-quad-group">
                                <div class="age-subfield">
                                    <input type="number" 
                                           class="classic-input age-box editable-age-box" 
                                           value="@(ageYears.HasValue ? ageYears.Value : "")" 
                                           placeholder="0" 
                                           min="0" max="150" 
                                           tabindex="6" 
                                           onclick="if (this.value === '0') this.value = ''; this.select();" 
                                           onfocus="this.placeholder = ''; if (this.value === '0') this.value = ''; this.select();" 
                                           onblur="this.placeholder = '0';" 
                                           @oninput='e => OnAgeChanged("years", e)' 
                                           title="@I18n.T("Years")" />
                                    <span class="age-unit">Y</span>
                                </div>
                                <div class="age-subfield">
                                    <input type="number" 
                                           class="classic-input age-box editable-age-box" 
                                           value="@(ageMonths.HasValue ? ageMonths.Value : "")" 
                                           placeholder="0" 
                                           min="0" max="11" 
                                           tabindex="7" 
                                           onclick="if (this.value === '0') this.value = ''; this.select();" 
                                           onfocus="this.placeholder = ''; if (this.value === '0') this.value = ''; this.select();" 
                                           onblur="this.placeholder = '0';" 
                                           @oninput='e => OnAgeChanged("months", e)' 
                                           title="@I18n.T("Months")" />
                                    <span class="age-unit">M</span>
                                </div>
                                <div class="age-subfield">
                                    <input type="number" 
                                           class="classic-input age-box editable-age-box" 
                                           value="@(ageDays.HasValue ? ageDays.Value : "")" 
                                           placeholder="0" 
                                           min="0" max="30" 
                                           tabindex="8" 
                                           onclick="if (this.value === '0') this.value = ''; this.select();" 
                                           onfocus="this.placeholder = ''; if (this.value === '0') this.value = ''; this.select();" 
                                           onblur="this.placeholder = '0';" 
                                           @oninput='e => OnAgeChanged("days", e)' 
                                           title="@I18n.T("Days")" />
                                    <span class="age-unit">D</span>
                                </div>
                            </div>
                        </div>
                        <div class="sketch-subfield">
                            <span class="sketch-sublabel">@I18n.T("DOB")</span>
                            <InputDate class="classic-input" tabindex="9" @bind-Value="editor.DateOfBirth" @bind-Value:after="OnDobChangedAfter" />
                        </div>
                    </div>

                    <!-- 6: Weight & Email -->
                    <div class="sketch-row-dual">
                        <div class="sketch-subfield">
                            <span class="sketch-sublabel">@I18n.T("Weight")</span>
                            <div class="weight-input-box">
                                <InputText class="classic-input weight-val" tabindex="11" @bind-Value="editor.Weight" placeholder="e.g. 65" />
                                <span class="weight-unit-pill">Kg</span>
                            </div>
                        </div>
                        <div class="sketch-subfield">
                            <span class="sketch-sublabel">@I18n.T("Email")</span>
                            <InputText class="classic-input" tabindex="12" @bind-Value="editor.Email" placeholder="patient@example.com" data-autocase="email" />
                        </div>
                    </div>

                    <!-- 7: Father's Name & Mother's Name -->
                    <div class="sketch-row-dual">
                        <div class="sketch-subfield">
                            <span class="sketch-sublabel">@I18n.T("Father's Name")</span>
                            <InputText class="classic-input" tabindex="13" @bind-Value="editor.FatherName" placeholder="@I18n.T("Father's Name")" data-autocase="title" />
                        </div>
                        <div class="sketch-subfield">
                            <span class="sketch-sublabel">@I18n.T("Mother's Name")</span>
                            <InputText class="classic-input" tabindex="14" @bind-Value="editor.MotherName" placeholder="@I18n.T("Mother's Name")" data-autocase="title" />
                        </div>
                    </div>

                    <!-- 8: Spouse Name & Occupation -->
                    <div class="sketch-row-dual">
                        <div class="sketch-subfield">
                            <span class="sketch-sublabel">@I18n.T("Spouse Name")</span>
                            <InputText class="classic-input" tabindex="15" @bind-Value="editor.CareOf" placeholder="@I18n.T("Spouse Name")" data-autocase="title" />
                        </div>
                        <div class="sketch-subfield">
                            <span class="sketch-sublabel">@I18n.T("Occupation")</span>
                            <InputText class="classic-input" tabindex="16" @bind-Value="editor.Occupation" placeholder="@I18n.T("Occupation")" data-autocase="title" />
                        </div>
                    </div>
                </div>

                <!-- 2. MIDDLE PANE: Present & Permanent Address -->
                <div class="sketch-address-pane">
                    <!-- Present Address Group -->
                    <div class="sketch-section-header">
                        <span class="section-title">@I18n.T("Present Address")</span>
                    </div>
                    <div class="sketch-address-fields">
                        <div class="address-single-row">
                            <span class="addr-label">@I18n.T("Village")</span>
                            <input class="classic-input" tabindex="17" value="@editor.PresentVillage" @oninput="OnPresentVillageInput" placeholder="@I18n.T("Village / Holding")" data-autocase="title" />
                        </div>
                        <div class="address-single-row">
                            <span class="addr-label">@I18n.T("Post Office")</span>
                            <input class="classic-input" tabindex="18" value="@editor.PresentPO" @oninput="OnPresentPOInput" placeholder="@I18n.T("Post Office")" data-autocase="title" />
                        </div>
                        <div class="address-single-row">
                            <span class="addr-label">@I18n.T("Police Station")</span>
                            <input class="classic-input" tabindex="19" value="@editor.PresentPS" @oninput="OnPresentPSInput" placeholder="@I18n.T("Police Station / Upazilla")" data-autocase="title" />
                        </div>
                        <div class="address-single-row">
                            <span class="addr-label">@I18n.T("District")</span>
                            <input class="classic-input" tabindex="20" value="@editor.PresentDistrict" @oninput="OnPresentDistrictInput" placeholder="@I18n.T("District")" data-autocase="title" />
                        </div>
                    </div>

                    <!-- Same As Checkbox -->
                    <div class="sketch-same-addr-row">
                        <input type="checkbox" id="chk-same-address" tabindex="21" checked="@sameAddress" @onchange="OnSameAddressCheckboxChanged" />
                        <label for="chk-same-address">@I18n.T("Same as Present Address")</label>
                    </div>

                    <!-- Permanent Address Group -->
                    <div class="sketch-section-header">
                        <span class="section-title">@I18n.T("Permanent Address")</span>
                    </div>
                    <div class="sketch-address-fields @(sameAddress ? "is-disabled" : "")">
                        <div class="address-single-row">
                            <span class="addr-label">@I18n.T("Village")</span>
                            <input class="classic-input" tabindex="@(sameAddress ? -1 : 22)" value="@editor.PermanentVillage" @oninput="OnPermanentVillageInput" readonly="@sameAddress" placeholder="@I18n.T("Village / Holding")" data-autocase="title" />
                        </div>
                        <div class="address-single-row">
                            <span class="addr-label">@I18n.T("Post Office")</span>
                            <input class="classic-input" tabindex="@(sameAddress ? -1 : 23)" value="@editor.PermanentPO" @oninput="OnPermanentPOInput" readonly="@sameAddress" placeholder="@I18n.T("Post Office")" data-autocase="title" />
                        </div>
                        <div class="address-single-row">
                            <span class="addr-label">@I18n.T("Police Station")</span>
                            <input class="classic-input" tabindex="@(sameAddress ? -1 : 24)" value="@editor.PermanentPS" @oninput="OnPermanentPSInput" readonly="@sameAddress" placeholder="@I18n.T("Police Station / Upazilla")" data-autocase="title" />
                        </div>
                        <div class="address-single-row">
                            <span class="addr-label">@I18n.T("District")</span>
                            <input class="classic-input" tabindex="@(sameAddress ? -1 : 25)" value="@editor.PermanentDistrict" @oninput="OnPermanentDistrictInput" readonly="@sameAddress" placeholder="@I18n.T("District")" data-autocase="title" />
                        </div>
                    </div>
                </div>

                <!-- 3. RIGHT PANE: Photo, Capture/Upload, Bar Code, QR Code -->
                <div class="sketch-media-pane">
                    <!-- Patient Photo Box -->
                    <div class="sketch-photo-wrap">
                        <div class="sketch-photo-frame">
                            @if (!string.IsNullOrWhiteSpace(editor.PhotoData))
                            {
                                <img src="@editor.PhotoData" alt="Patient Photo" class="sketch-photo-img" />
                            }
                            else
                            {
                                <div class="sketch-photo-placeholder">
                                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="12" cy="7" r="4"></circle>
                                    </svg>
                                    <span class="sketch-photo-hint">@I18n.T("PHOTO")</span>
                                </div>
                            }
                        </div>
                        <div class="sketch-photo-buttons">
                            <button type="button" class="btn-sketch-action" @onclick="OpenWebcamModal" title="@I18n.T("Capture photo using webcam or camera")" tabindex="-1">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                                    <circle cx="12" cy="13" r="4"></circle>
                                </svg>
                                <span>@I18n.T("Capture")</span>
                            </button>
                            <button type="button" class="btn-sketch-action" @onclick="TriggerPhotoUpload" title="@I18n.T("Upload photo from file")" tabindex="-1">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                    <polyline points="17 8 12 3 7 8"></polyline>
                                    <line x1="12" y1="3" x2="12" y2="15"></line>
                                </svg>
                                <span>@I18n.T("Upload")</span>
                            </button>
                            <InputFile id="patient-file-upload-input" OnChange="HandlePhotoUpload" accept="image/*" capture="user" style="display:none;" />
                            @if (!string.IsNullOrWhiteSpace(editor.PhotoData))
                            {
                                <button type="button" class="btn-sketch-action remove" @onclick="RemovePhoto" title="@I18n.T("Remove Photo")" tabindex="-1">✕</button>
                            }
                        </div>
                    </div>

                    <!-- Bar Code Box -->
                    <div class="sketch-code-wrap">
                        <span class="code-title">@I18n.T("Bar Code")</span>
                        <div class="code-box barcode-box">
                            @((MarkupString)BarcodeQr.GenerateBarcodeSvg(string.IsNullOrWhiteSpace(editor.PatientID) || editor.PatientID == "AUTO" ? "PATIENT-DEMO" : editor.PatientID, barHeight: 28, includeText: true))
                        </div>
                    </div>

                    <!-- QR Code Box -->
                    <div class="sketch-code-wrap">
                        <span class="code-title">@I18n.T("QR Code")</span>
                        <div class="code-box qrcode-box">
                            @((MarkupString)BarcodeQr.GenerateQrSvg(BarcodeQr.GeneratePatientQrPayload(editor.ID, string.IsNullOrWhiteSpace(editor.PatientID) || editor.PatientID == "AUTO" ? "NEW" : editor.PatientID, editor.Name ?? "New Patient", editor.Contact), pixelsPerModule: 3))
                        </div>
                    </div>
                </div>
            </div>

            <!-- 4. BOTTOM ACTION BAR: Save / Update | Delete | Clear -->
            <div class="sketch-footer-bar">
                <div class="sketch-footer-status">
                    @if (!string.IsNullOrWhiteSpace(message))
                    {
                        <div class="inline-status @messageClass">
                            @if (messageClass == "success")
                            {
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                            }
                            else
                            {
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                            }
                            <span class="status-msg-text">@message</span>
                            @if (editor.ID > 0)
                            {
                                <span class="status-reg-datetime">| Reg: <strong>@editor.TransDate.ToString("dd-MMM-yyyy hh:mm tt")</strong></span>
                            }
                        </div>
                    }
                </div>

                <div class="sketch-footer-buttons">
                    <!-- Dynamic Save / Update Button (Tab 26) -->
                    <button id="btn-save-profile" 
                            class="btn @(editor.ID > 0 ? "btn-update-action" : "btn-save-update")" 
                            type="submit" 
                            tabindex="26" 
                            @onkeydown="HandleSaveButtonKeyDown"
                            disabled="@saving">
                        @if (saving)
                        {
                            <svg class="spinner-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="2" x2="12" y2="6"></line>
                                <line x1="12" y1="18" x2="12" y2="22"></line>
                                <line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line>
                                <line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line>
                                <line x1="2" y1="12" x2="6" y2="12"></line>
                                <line x1="18" y1="12" x2="22" y2="12"></line>
                                <line x1="4.93" y1="19.07" x2="7.76" y2="16.24"></line>
                                <line x1="16.24" y1="7.76" x2="19.07" y2="4.93"></line>
                            </svg>
                            <span>@(editor.ID > 0 ? I18n.T("Updating...") : I18n.T("Saving..."))</span>
                        }
                        else if (editor.ID > 0)
                        {
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 20h9"></path>
                                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                            </svg>
                            <span>@I18n.T("Update")</span>
                        }
                        else
                        {
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                                <polyline points="17 21 17 13 7 13 7 21"></polyline>
                                <polyline points="7 3 7 8 15 8"></polyline>
                            </svg>
                            <span>@I18n.T("Save")</span>
                        }
                    </button>

                    <!-- Delete Button -->
                    <button class="btn btn-danger btn-delete-action" 
                            tabindex="-1" 
                            type="button" 
                            disabled="@(editor.ID <= 0)"
                            @onclick="DeleteAsync"
                            title="@(editor.ID > 0 ? I18n.T("Delete Patient Profile") : I18n.T("Select an existing patient to delete"))">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        </svg>
                        <span>@I18n.T("Delete")</span>
                    </button>

                    <!-- Clear Button -->
                    <button class="btn btn-secondary btn-clear-action" tabindex="-1" type="button" @onclick="Reset" title="@I18n.T("Clear Form / New Patient")">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path>
                            <path d="M21 3v5h-5"></path>
                            <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path>
                            <path d="M8 16H3v5"></path>
                        </svg>
                        <span>@I18n.T("Clear")</span>
                    </button>

                    @if (editor.ID > 0)
                    {
                        <button class="btn btn-outline-primary btn-print-card" tabindex="-1" type="button" @onclick="() => showCardPreview = true" title="@I18n.T("Print / Export Patient Card (Ctrl+P)")">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 6 2 18 2 18 9"></polyline>
                                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                                <rect x="6" y="14" width="12" height="8"></rect>
                            </svg>
                            <span>@I18n.T("Print Card")</span>
                        </button>

                        <button class="btn btn-outline-info btn-print-wristband" tabindex="-1" type="button" @onclick="() => showWristbandPreview = true" title="@I18n.T("Print Patient Wristband (Medical ID Band)")">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="7" width="20" height="10" rx="3"></rect>
                                <line x1="6" y1="7" x2="6" y2="17"></line>
                                <line x1="18" y1="7" x2="18" y2="17"></line>
                                <circle cx="12" cy="12" r="1.5"></circle>
                            </svg>
                            <span>@I18n.T("Print Wristband")</span>
                        </button>
                    }
                </div>
            </div>
        </EditForm>
    </div>
</div>

@if (showDependencyModal)
{
    <div class="modal-backdrop patient-dependency-backdrop" @onclick="CloseDependencyModal">
        <div class="patient-dependency-modal" role="dialog" aria-modal="true" aria-labelledby="dependency-modal-title" @onclick:stopPropagation>
            <div class="patient-dependency-header">
                <div>
                    <h3 id="dependency-modal-title">Patient-dependent records</h3>
                    <p><strong>@editor.PatientID</strong> — @editor.Name</p>
                </div>
                <button type="button" class="patient-dependency-close" @onclick="CloseDependencyModal" aria-label="Close">×</button>
            </div>

            <div class="patient-dependency-warning">
                Delete the records one by one. The patient profile can be deleted only after this list is empty.
            </div>

            @if (!string.IsNullOrWhiteSpace(dependencyMessage))
            {
                <div class="patient-dependency-message @(dependencyMessageIsError ? "error" : "success")">@dependencyMessage</div>
            }

            <div class="patient-dependency-list">
                @if (patientDependencies.Count == 0)
                {
                    <div class="patient-dependency-empty">No dependent records remain. You may now delete the patient profile.</div>
                }
                else
                {
                    @foreach (var dependency in patientDependencies)
                    {
                        <div class="patient-dependency-row">
                            <div class="patient-dependency-details">
                                <strong>@dependency.Label</strong>
                                <span>@dependency.Reference</span>
                                <small>@dependency.Description · @dependency.EventDate.ToString("dd-MMM-yyyy hh:mm tt")</small>
                            </div>
                            <button type="button" class="btn patient-dependency-delete" disabled="@deletingDependency" @onclick="() => RequestDependencyDelete(dependency)">
                                @(deletingDependency && deletingDependencyKey == dependency.Key ? "Deleting..." : "Delete")
                            </button>
                        </div>
                    }
                }
            </div>

            <div class="patient-dependency-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseDependencyModal">Close</button>
                <button type="button" class="btn btn-delete-profile-final" disabled="@(patientDependencies.Count > 0 || deletingDependency)" @onclick="RequestPatientProfileDeletion">
                    Delete Patient Profile
                </button>
            </div>
        </div>
    </div>
}

@if (pendingDependency is not null || confirmingProfileDeletion)
{
    <div class="patient-action-backdrop" @onclick="CancelPatientAction">
        <div class="patient-action-dialog" role="alertdialog" aria-modal="true" aria-labelledby="patient-action-title" @onclick:stopPropagation>
            <div class="patient-action-icon">!</div>
            <div class="patient-action-content">
                <h3 id="patient-action-title">@(confirmingProfileDeletion ? "Delete patient profile?" : "Delete dependent record?")</h3>

                @if (pendingDependency is not null)
                {
                    <p>This record will be permanently deleted and cannot be recovered.</p>
                    <div class="patient-action-record">
                        <strong>@pendingDependency.Label</strong>
                        <span>@pendingDependency.Reference</span>
                        <small>@pendingDependency.Description</small>
                    </div>

                    @if (DependencyRequiresReason(pendingDependency))
                    {
                        <label class="patient-action-reason-label" for="patient-delete-reason">Reversal reason <span>*</span></label>
                        <textarea id="patient-delete-reason" class="patient-action-reason" rows="3" maxlength="300"
                                  @bind="actionDialogReason" @bind:event="oninput"
                                  placeholder="Enter why this financial record is being deleted"></textarea>
                    }
                }
                else
                {
                    <p>This will permanently delete the patient profile. This action cannot be undone.</p>
                    <div class="patient-action-record">
                        <strong>@editor.Name</strong>
                        <span>Patient ID: @editor.PatientID</span>
                        <small>All dependent records have been cleared.</small>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(actionDialogError))
                {
                    <div class="patient-action-error">@actionDialogError</div>
                }

                <div class="patient-action-buttons">
                    <button type="button" class="btn btn-secondary" disabled="@deletingDependency" @onclick="CancelPatientAction">Cancel</button>
                    <button type="button" class="btn patient-action-confirm"
                            disabled="@(deletingDependency || (pendingDependency is not null && DependencyRequiresReason(pendingDependency) && string.IsNullOrWhiteSpace(actionDialogReason)))"
                            @onclick="ConfirmPatientActionAsync">
                        @(deletingDependency ? "Deleting..." : "Yes, Delete")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (editor.ID > 0)
{
    <!-- Printable Patient CR80 Card (85.60mm x 53.98mm, Corner Radius: 3.18mm) -->
    <div id="patient-print" class="print-document" style="display:none;">
        <div class="patient-id-card-wrapper">
            <div class="patient-cr80-card">
                <!-- Header: Hospital Name & Logo (11.5mm) -->
                <div class="card-header">
                    <div class="card-brand">
                        @if (!string.IsNullOrWhiteSpace(Branding.LogoData))
                        {
                            <img src="@Branding.LogoData" alt="Logo" class="card-logo" />
                        }
                        else
                        {
                            <div class="card-logo-fallback">🏥</div>
                        }
                        <div class="card-title-group">
                            <div class="card-hospital-name">@Branding.HospitalName</div>
                            <div class="card-doc-type">PATIENT IDENTIFICATION CARD</div>
                        </div>
                    </div>
                    <div class="card-header-badge">
                        <span class="badge-label">PID</span>
                        <span class="badge-value">@editor.PatientID</span>
                    </div>
                </div>

                <!-- Body: Patient Details, Photo & QR Code (28mm) -->
                <div class="card-body @(!string.IsNullOrWhiteSpace(editor.PhotoData) ? "has-photo" : "")">
                    @if (!string.IsNullOrWhiteSpace(editor.PhotoData))
                    {
                        <div class="card-photo-col">
                            <img src="@editor.PhotoData" alt="Photo" class="card-patient-photo" />
                        </div>
                    }
                    <div class="card-info-col">
                        <div class="card-patient-name" title="@editor.Name">@editor.Name</div>
                        
                        <div class="card-grid">
                            <div class="card-field">
                                <span class="field-lbl">Age:</span>
                                <span class="field-val"><strong>@FormattedAge</strong></span>
                            </div>
                            @if (editor.DateOfBirth.HasValue)
                            {
                                <div class="card-field">
                                    <span class="field-lbl">DOB:</span>
                                    <span class="field-val">@editor.DateOfBirth.Value.ToString("dd-MMM-yyyy")</span>
                                </div>
                            }
                            <div class="card-field">
                                <span class="field-lbl">Gender:</span>
                                <span class="field-val">@editor.Sex</span>
                            </div>
                            <div class="card-field">
                                <span class="field-lbl">Blood:</span>
                                <span class="field-val blood-highlight">🩸 @(string.IsNullOrWhiteSpace(editor.BloodGroup) ? "N/A" : editor.BloodGroup)</span>
                            </div>
                            <div class="card-field">
                                <span class="field-lbl">Weight:</span>
                                <span class="field-val">@(string.IsNullOrWhiteSpace(editor.Weight) ? "N/A" : $"{editor.Weight} kg")</span>
                            </div>
                            <div class="card-field">
                                <span class="field-lbl">Reg Date:</span>
                                <span class="field-val">@editor.TransDate.ToString("dd-MMM-yy")</span>
                            </div>
                            <div class="card-field">
                                <span class="field-lbl">Contact:</span>
                                <span class="field-val">📞 @(string.IsNullOrWhiteSpace(editor.Contact) ? "N/A" : editor.Contact)</span>
                            </div>
                        </div>
                    </div>

                    <div class="card-qr-col">
                        <div class="card-qr-box">
                            @((MarkupString)BarcodeQr.GenerateQrSvg(BarcodeQr.GeneratePatientQrPayload(editor.ID, editor.PatientID, editor.Name, editor.Contact), pixelsPerModule: 2))
                        </div>
                        <div class="card-qr-sub">SCAN QR</div>
                    </div>
                </div>

                <!-- Footer: 1D Barcode with Patient ID (13.5mm) -->
                <div class="card-footer">
                    <div class="card-barcode-wrap">
                        @((MarkupString)BarcodeQr.GenerateBarcodeSvg(editor.PatientID, barHeight: 18, includeText: true))
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="patient-thermal-print" class="print-document pos-receipt-80mm">
        <div style="width:76mm; padding:3mm 2mm; font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif; font-size:11px; line-height:1.3; color:#000; margin:0 auto;">
            <div style="text-align:center; border-bottom:1.5px dashed #000; padding-bottom:5px; margin-bottom:6px;">
                <div style="font-size:14px; font-weight:900; text-transform:uppercase;">@Branding.HospitalName</div>
                @if (!string.IsNullOrWhiteSpace(Branding.Address))
                {
                    <div style="font-size:9.5px;">@Branding.Address</div>
                }
                @if (!string.IsNullOrWhiteSpace(Branding.Phone))
                {
                    <div style="font-size:9.5px;">Hotline: @Branding.Phone</div>
                }
                <div style="display:inline-block; margin-top:4px; padding:2px 8px; border:1px solid #000; border-radius:3px; font-size:10px; font-weight:800;">
                    PATIENT REGISTRATION SLIP
                </div>
            </div>

            <div style="display:flex; justify-content:space-between; font-size:10px; margin-bottom:5px;">
                <span><strong>PID:</strong> @editor.PatientID</span>
                <span>@editor.TransDate.ToString("dd/MM/yy hh:mm tt")</span>
            </div>

            <div style="border-top:1px dashed #666; border-bottom:1px dashed #666; padding:5px 0; font-size:10.5px;">
                <div style="font-size:13px; font-weight:900; margin-bottom:3px;">@editor.Name</div>
                <div><strong>Age / Gender:</strong> @FormattedAge / @editor.Sex</div>
                @if (editor.DateOfBirth.HasValue)
                {
                    <div><strong>Date of Birth:</strong> @editor.DateOfBirth.Value.ToString("dd MMM yyyy")</div>
                }
                <div><strong>Blood Group:</strong> @(string.IsNullOrWhiteSpace(editor.BloodGroup) ? "N/A" : editor.BloodGroup)</div>
                <div><strong>Contact:</strong> @(string.IsNullOrWhiteSpace(editor.Contact) ? "N/A" : editor.Contact)</div>
                @if (!string.IsNullOrWhiteSpace(editor.FatherName))
                {
                    <div><strong>Father:</strong> @editor.FatherName</div>
                }
                @if (!string.IsNullOrWhiteSpace(editor.MotherName))
                {
                    <div><strong>Mother:</strong> @editor.MotherName</div>
                }
                @if (!string.IsNullOrWhiteSpace(editor.PresentVillage) || !string.IsNullOrWhiteSpace(editor.PresentDistrict))
                {
                    <div><strong>Address:</strong> @string.Join(", ", new[] { editor.PresentVillage, editor.PresentPO, editor.PresentPS, editor.PresentDistrict }.Where(x => !string.IsNullOrWhiteSpace(x)))</div>
                }
            </div>

            <div style="text-align:center; margin-top:7px; padding-top:5px; border-top:1px dashed #666;">
                <div style="display:flex; justify-content:center;">@((MarkupString)BarcodeQr.GenerateBarcodeSvg(editor.PatientID, barHeight:24, includeText:true))</div>
                <div style="font-size:9px; margin-top:3px;">Please keep this slip for future hospital visits.</div>
            </div>
        </div>
    </div>
}

