@page "/pharmacy/prescriptions"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.Doctor + "," + RoleNames.PharmacyOperator)]
@rendermode InteractiveServer
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject IJSRuntime JS
@inject IBarcodeQrService BarcodeQr
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@implements IDisposable
@using System.Security.Claims
@using HPM.Web.Components.Common

<PageTitle>@I18n.T("Doctor Prescription & Medication Orders") | @Branding.HospitalName</PageTitle>

<!-- Modern Clinical Heading -->
<div class="page-heading">
    <div>
        <span class="eyebrow">@(isIpdMode ? I18n.T("Inpatient Ward Medication Indent", "Inpatient Ward Medication Indent") : I18n.T("Clinical Consultation & Dispensary", "Clinical Consultation & Dispensary"))</span>
        <h1>@(isIpdMode ? I18n.T("IPD Ward Medication Indent", "IPD Ward Medication Indent") : I18n.T("Doctor Prescription", "Doctor Prescription"))</h1>
        <p>@(isIpdMode ? I18n.T("Requisition medications for admitted indoor patients with bed & ward tracking directly to dispensary.") : I18n.T("Smart medication order with auto-dosage calculator, instant generic search & pharmacy dispensing."))</p>
        <div style="display:inline-flex; background:#e2e8f0; border-radius:6px; padding:3px; gap:4px; margin-top:8px;">
            <button type="button" class="btn" style="padding:4px 12px; font-size:12px; font-weight:700; border-radius:4px; background:@(!isIpdMode ? "#0284c7" : "transparent"); color:@(!isIpdMode ? "#ffffff" : "#475569"); border:none; cursor:pointer;" @onclick="() => SetMode(false)">
                🩺 @I18n.T("OPD Prescription")
            </button>
            <button type="button" class="btn" style="padding:4px 12px; font-size:12px; font-weight:700; border-radius:4px; background:@(isIpdMode ? "#7c3aed" : "transparent"); color:@(isIpdMode ? "#ffffff" : "#475569"); border:none; cursor:pointer;" @onclick="() => SetMode(true)">
                🏥 @I18n.T("IPD Ward Indent")
            </button>
        </div>
    </div>
    <div style="display:flex; align-items:center; gap:8px;">
        @if (editor.ID > 0)
        {
            <button class="btn btn-primary" @onclick="PrintAsync" style="background:#0284c7; border-color:#0284c7;">
                🖨️ @(isIpdMode ? I18n.T("Print Indent") : I18n.T("Print Prescription"))
            </button>
        }
        <button class="btn btn-secondary" @onclick="Reset">
            + @(isIpdMode ? I18n.T("New Indent") : I18n.T("New Prescription"))
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @messageClass" style="margin-bottom:12px; display:flex; align-items:center; justify-content:space-between;">
        <span>@message</span>
        <button type="button" class="btn-clear" style="border:none; background:transparent; cursor:pointer;" @onclick="() => message = string.Empty">✕</button>
    </div>
}

<div class="rx-workspace-grid">
    <!-- LEFT COLUMN: Patient Info, Diagnosis, Medication Builder & Prescription Cart -->
    <div class="rx-left-workspace">
        
        <!-- CARD 1: Patient Details & Doctor Information -->
        <div class="rx-card">
            <div class="rx-card-header">
                <span class="rx-card-title">
                    👤 @(editor.ID == 0 ? I18n.T("Patient & Consultant Information") : $"{I18n.T("Prescription")} #RX-{editor.ID}")
                </span>
                @if (editor.ID > 0)
                {
                    <span class="badge badge-info" style="font-size:11.5px; font-weight:700;">
                        Visit #@editor.VisitNo • @(editor.VisitDate?.ToString("dd MMM yyyy") ?? visitDate.ToString("dd MMM yyyy"))
                    </span>
                }
            </div>

            <!-- Patient Search / Selection -->
            @if (isIpdMode)
            {
                @if (selectedInpatient != null)
                {
                    <div class="rx-patient-hero-badge" style="background:#f5f3ff; border:1px solid #ddd6fe; margin-bottom:12px;">
                        <div class="rx-patient-hero-info">
                            <strong style="font-size:14px; color:#7c3aed;">🛏️ @selectedInpatient.BedCabinName</strong>
                            <span style="font-weight:700; color:#0f172a;">@selectedInpatient.PatientName</span>
                            <span>• Reg: <b>@selectedInpatient.RegNo</b></span>
                            <span>• Ward: <b>@selectedInpatient.DepartmentName</b></span>
                            @if (!string.IsNullOrWhiteSpace(selectedInpatient.Age))
                            {
                                <span>• @selectedInpatient.Age</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(selectedInpatient.BloodGroup))
                            {
                                <span class="badge" style="background:#fee2e2; color:#991b1b; font-weight:800;">🩸 @selectedInpatient.BloodGroup</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(selectedInpatient.ConsultantName))
                            {
                                <span>• 🩺 @selectedInpatient.ConsultantName</span>
                            }
                        </div>
                        <button type="button" class="btn btn-secondary" style="padding:3px 10px; font-size:11px;" @onclick="ClearSelectedInpatient">
                            @I18n.T("Change")
                        </button>
                    </div>
                }
                else
                {
                    <div class="rx-search-wrapper" style="margin-bottom:12px;">
                        <div style="position:relative; width:100%;">
                            <span class="rx-search-icon">🏥</span>
                            <input type="text"
                                   class="rx-search-input"
                                   placeholder="@I18n.T("Select Admitted Patient (Bed/Cabin, Reg #, Name, Ward)...")"
                                   @bind="inpatientSearch"
                                   @bind:event="oninput"
                                   @onfocus="() => showInpatientDropdown = true" />
                            @if (!string.IsNullOrWhiteSpace(inpatientSearch))
                            {
                                <button type="button" class="rx-search-clear" @onclick="() => { inpatientSearch = string.Empty; showInpatientDropdown = false; }">✕</button>
                            }
                            @if (showInpatientDropdown && FilteredInpatients.Any())
                            {
                                <div class="rx-med-dropdown" style="z-index:120; max-height:280px; overflow-y:auto;">
                                    @foreach (var p in FilteredInpatients)
                                    {
                                        <div class="rx-med-item" @onmousedown:preventDefault @onclick="() => SelectInpatient(p)">
                                            <div>
                                                <strong style="color:#7c3aed; font-size:13px;">🛏️ @p.BedCabinName</strong>
                                                <span style="margin-left:8px; font-weight:700; color:#0f172a;">@p.PatientName</span>
                                                <span style="margin-left:6px; color:#64748b; font-size:11.5px;">(Reg: @p.RegNo)</span>
                                                <small style="display:block; color:#64748b; font-size:11px;">Ward: @p.DepartmentName • Consultant: @p.ConsultantName</small>
                                            </div>
                                            <div style="text-align:right;">
                                                <span class="badge" style="background:#f3e8ff; color:#7e22ce; font-weight:700; font-size:11px;">
                                                    Admitted
                                                </span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                @if (selectedPatient != null)
                {
                    <div class="rx-patient-hero-badge">
                        <div class="rx-patient-hero-info">
                            <strong style="font-size:14px; color:#0369a1;">#@selectedPatient.PatientID</strong>
                            <span style="font-weight:700; color:#0f172a;">@selectedPatient.Name</span>
                            <span>• @FormatPatientAge(selectedPatient.DateOfBirth)</span>
                            <span>• @selectedPatient.Sex</span>
                            @if (!string.IsNullOrWhiteSpace(selectedPatient.BloodGroup))
                            {
                                <span class="badge" style="background:#fee2e2; color:#991b1b; font-weight:800;">🩸 @selectedPatient.BloodGroup</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(selectedPatient.Weight))
                            {
                                <span class="patient-weight-pill">⚖️ @selectedPatient.Weight kg</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(selectedPatient.Contact))
                            {
                                <span>• 📞 @selectedPatient.Contact</span>
                            }
                        </div>
                        <button type="button" class="btn btn-secondary" style="padding:3px 10px; font-size:11px;" @onclick="ClearSelectedPatient">
                            @I18n.T("Change")
                        </button>
                    </div>
                }
                else
                {
                    <div class="rx-search-wrapper" style="margin-bottom:12px;">
                        <div style="display:flex; gap:8px;">
                            <div style="position:relative; flex:1;">
                                <span class="rx-search-icon"><SearchIcon /></span>
                                <input type="text"
                                       class="rx-search-input"
                                       placeholder="@I18n.T("Search Registered Patient (Patient ID, Mobile No, or Name)...")"
                                       @bind="patientSearchQuery"
                                       @bind:event="oninput"
                                       @onkeydown="HandlePatientSearchKeyDown"
                                       @onfocus="() => showPatientSuggestions = true" />
                                @if (!string.IsNullOrWhiteSpace(patientSearchQuery))
                                {
                                    <button type="button" class="rx-search-clear" @onclick="ClearPatientSearch">✕</button>
                                }
                                @if (showPatientSuggestions && PatientSuggestions.Any())
                                {
                                    <div class="rx-med-dropdown" style="z-index:110;">
                                        @foreach (var p in PatientSuggestions)
                                        {
                                            <div class="rx-med-item" @onmousedown:preventDefault @onclick="() => SelectPatient(p)">
                                                <div>
                                                    <strong style="color:#0369a1; font-size:12.5px;">#@p.PatientID</strong>
                                                    <span style="margin-left:8px; font-weight:700; color:#0f172a;">@p.Name</span>
                                                    <small style="margin-left:6px; color:#64748b;">(@p.Contact)</small>
                                                </div>
                                                <div style="display:flex; align-items:center; gap:6px;">
                                                    @if (!string.IsNullOrWhiteSpace(p.Weight))
                                                    {
                                                        <span class="patient-weight-pill">⚖️ @p.Weight kg</span>
                                                    }
                                                    <span style="font-size:11px; color:#64748b;">@p.Sex</span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            <button type="button" class="btn btn-secondary" style="height:38px; padding:0 14px;" @onclick="FindPatientDirectAsync">
                                @I18n.T("Find")
                            </button>
                        </div>
                    </div>
                }
            }

            <!-- Patient Basic Details & Doctor Grid -->
            <div class="form-grid" style="grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap:10px; margin-bottom:10px;">
                <label>
                    <span style="font-size:11px; font-weight:700; color:#475569;">@I18n.T("Patient Name *")</span>
                    <input class="classic-input" @bind="editor.Name" maxlength="100" placeholder="@I18n.T("Name")" />
                </label>
                <label style="max-width:110px;">
                    <span style="font-size:11px; font-weight:700; color:#475569;">@I18n.T("Age")</span>
                    <input class="classic-input" @bind="editor.Age" maxlength="20" placeholder="e.g. 35Y" />
                </label>
                <label style="max-width:100px;">
                    <span style="font-size:11px; font-weight:700; color:#475569;">@I18n.T("Sex")</span>
                    <select class="classic-input" @bind="editor.Sex">
                        <option value="">@I18n.T("Select")</option>
                        <option value="Male">@I18n.T("Male")</option>
                        <option value="Female">@I18n.T("Female")</option>
                        <option value="Other">@I18n.T("Other")</option>
                    </select>
                </label>
                <label style="max-width:95px;">
                    <span style="font-size:11px; font-weight:700; color:#475569;">⚖️ @I18n.T("Weight")</span>
                    <input class="classic-input" @bind="weightText" placeholder="e.g. 68 kg" />
                </label>
                <label style="max-width:90px;">
                    <span style="font-size:11px; font-weight:700; color:#475569;">🩸 @I18n.T("Blood")</span>
                    <input class="classic-input" @bind="editor.BloodGroup" maxlength="10" placeholder="e.g. B+" />
                </label>
                <label style="min-width:200px;">
                    <span style="font-size:11px; font-weight:700; color:#475569;">🩺 @I18n.T("Consultant Doctor *")</span>
                    <select class="classic-input" @bind="doctorId">
                        <option value="0">@I18n.T("Select Consultant Doctor")</option>
                        @foreach (var doc in doctors)
                        {
                            <option value="@doc.ID">@doc.Title @doc.Name</option>
                        }
                    </select>
                </label>
            </div>
        </div>

        <!-- CARD 2: Clinical Details (Diagnosis, Complaints, Advised Tests, Instructions) -->
        <div class="rx-card">
            <div class="rx-card-header" style="cursor:pointer;" @onclick="() => showClinicalSection = !showClinicalSection">
                <span class="rx-card-title">
                    📋 @I18n.T("Clinical Diagnosis & Advice")
                </span>
                <span style="font-size:12px; color:#0284c7; font-weight:700;">
                    @(showClinicalSection ? I18n.T("Hide Details ▲") : I18n.T("Show Details ▼"))
                </span>
            </div>

            <div style="display:@(showClinicalSection ? "block" : "none")">
                <div class="form-grid" style="grid-template-columns: 1fr 1fr; gap:10px; margin-bottom:10px;">
                    <label>
                        <span style="font-size:11px; font-weight:700; color:#475569;">@I18n.T("Primary Diagnosis")</span>
                        <input class="classic-input" @bind="editor.Diagnosis" placeholder="e.g. Dyslipidemia, Type 2 DM, Upper Respiratory Tract Infection" />
                    </label>
                    <label>
                        <span style="font-size:11px; font-weight:700; color:#475569;">@I18n.T("Chief Complaints / Symptoms")</span>
                        <input class="classic-input" @bind="editor.Complain" placeholder="e.g. Fever, persistent dry cough for 3 days, headache" />
                    </label>
                </div>
                <div class="form-grid" style="grid-template-columns: 1fr 1fr; gap:10px;">
                    <label>
                        <span style="font-size:11px; font-weight:700; color:#475569;">🧪 @I18n.T("Advised Lab Investigations")</span>
                        <textarea class="classic-input" rows="2" @bind="editor.Investigation" placeholder="e.g. 1. CBC with ESR&#10;2. Serum Creatinine&#10;3. Lipid Profile"></textarea>
                    </label>
                    <label>
                        <span style="font-size:11px; font-weight:700; color:#475569;">💡 @I18n.T("Special Advice & Follow-up")</span>
                        <textarea class="classic-input" rows="2" @bind="editor.Remark" placeholder="e.g. Drink plenty of warm water. Rest for 3 days. Review after 7 days with reports."></textarea>
                    </label>
                </div>
            </div>
        </div>

        <!-- CARD 3: Intelligent Medicine Search & Dosage Auto-Calculator Builder -->
        <div class="rx-card" style="border: 2px solid #0284c7; background: #ffffff;">
            <div class="rx-card-header">
                <span class="rx-card-title" style="color:#0369a1;">
                    💊 @I18n.T("Prescription Medication Builder")
                </span>
                <span style="font-size:11px; color:#64748b; font-weight:600;">
                    @I18n.T("Type to search medicine • Dosage timing & days auto-calculate total quantity")
                </span>
            </div>

            <!-- Medicine Search Combo Box with Dropdown Suggestions -->
            <div class="rx-med-builder-box">
                @if (selectedMedicine != null)
                {
                    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px;">
                        <div class="rx-selected-pill">
                            <span>💊 <b>@selectedMedicine.Name</b></span>
                            @if (!string.IsNullOrWhiteSpace(selectedMedicine.TypeName))
                            {
                                <span class="rx-type-pill">@selectedMedicine.TypeName</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(selectedMedicine.GenericName))
                            {
                                <span style="color:#0369a1; font-weight:600; font-size:11.5px;">(@selectedMedicine.GenericName)</span>
                            }
                            @if (selectedMedicine.SaleRate > 0)
                            {
                                <span style="color:#047857; font-weight:700; font-size:11px;">• ৳@selectedMedicine.SaleRate.ToString("F2")</span>
                            }
                            <button type="button" class="btn-clear" @onclick="ClearSelectedMedicine" title="@I18n.T("Remove selected medicine")">✕</button>
                        </div>
                        <span style="font-size:11px; color:#10b981; font-weight:700;">✓ @I18n.T("Medicine Selected")</span>
                    </div>
                }
                else
                {
                    <div class="rx-search-wrapper" style="margin-bottom:10px;">
                        <span class="rx-search-icon"><SearchIcon /></span>
                        <input type="text"
                               class="rx-search-input"
                               placeholder="@I18n.T("Type medicine name or generic (e.g. Napa, Seclo, Paracetamol, Cipro, Ace)...")"
                               @bind="medicineSearchQuery"
                               @bind:event="oninput"
                               @onkeydown="HandleMedicineSearchKeyDown"
                               @onfocus="() => showMedicineSuggestions = true"
                               autocomplete="off" />
                        @if (!string.IsNullOrWhiteSpace(medicineSearchQuery))
                        {
                            <button type="button" class="rx-search-clear" @onclick="ClearMedicineSearch">✕</button>
                        }

                        @if (showMedicineSuggestions && FilteredMedicines.Any())
                        {
                            <div class="rx-med-dropdown">
                                @for (int i = 0; i < FilteredMedicines.Count; i++)
                                {
                                    var med = FilteredMedicines[i];
                                    var isHl = i == highlightedMedIndex;
                                    <div class="rx-med-item @(isHl ? "highlighted" : "")"
                                         @onmousedown:preventDefault
                                         @onclick="() => SelectMedicine(med)">
                                        <div>
                                            <strong style="color:#0f172a; font-size:13px;">@med.Name</strong>
                                            @if (!string.IsNullOrWhiteSpace(med.TypeName))
                                            {
                                                <span class="rx-type-pill">@med.TypeName</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(med.GenericName))
                                            {
                                                <small style="display:block; color:#64748b; font-size:11px; margin-top:1px;">
                                                    @med.GenericName
                                                </small>
                                            }
                                        </div>
                                        <div style="text-align:right;">
                                            @if (med.SaleRate > 0)
                                            {
                                                <span style="font-weight:700; color:#0369a1; font-size:12px;">৳@med.SaleRate.ToString("F2")</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                <!-- Dosage Time / Timing Selector (Quick Chips + Custom Input) -->
                <div style="margin-bottom:10px;">
                    <div style="display:flex; align-items:center; justify-content:space-between;">
                        <span style="font-size:11.5px; font-weight:800; color:#0f172a;">
                            ⏰ @I18n.T("Dosage Timing / Frequency")
                        </span>
                        <span style="font-size:11px; color:#64748b;">
                            @I18n.T("Daily Units: ") <b>@ParseDailyUnits(dosagePattern)</b>/day
                        </span>
                    </div>

                    <!-- Dosage Preset Chips -->
                    <div class="rx-chip-group">
                        @foreach (var p in DosagePresets)
                        {
                            var isActive = string.Equals(dosagePattern, p.Pattern, StringComparison.OrdinalIgnoreCase);
                            <button type="button"
                                    class="rx-chip @(isActive ? "active" : "")"
                                    @onclick="() => SelectDosagePreset(p)">
                                @p.Label
                            </button>
                        }
                    </div>

                    <!-- Custom Dosage input row -->
                    <div style="display:flex; gap:8px; align-items:center;">
                        <div style="flex:1;">
                            <input class="classic-input"
                                   style="height:32px; font-size:12.5px; font-weight:700; color:#0369a1;"
                                   @bind="dosagePattern"
                                   @bind:event="oninput"
                                   @onkeyup="OnDosagePatternChanged"
                                   placeholder="@I18n.T("Custom dosage pattern (e.g. 1 + 0 + 1 or 2 + 0 + 2)")" />
                        </div>
                    </div>
                </div>

                <!-- Meal Relation / Instructions Selector -->
                <div style="margin-bottom:12px;">
                    <span style="font-size:11.5px; font-weight:800; color:#0f172a; display:block; margin-bottom:2px;">
                        🍽️ @I18n.T("Instructions & Meal Relation")
                    </span>
                    <div class="rx-chip-group" style="margin-bottom:0;">
                        @foreach (var ins in InstructionPresets)
                        {
                            var isActive = string.Equals(selectedInstruction, ins, StringComparison.OrdinalIgnoreCase);
                            <button type="button"
                                    class="rx-chip @(isActive ? "active" : "")"
                                    @onclick="() => SelectInstructionPreset(ins)">
                                @ins
                            </button>
                        }
                    </div>
                </div>

                <!-- Duration (Days) & Quantity Row with Dynamic Auto-Calculator -->
                <div style="display:grid; grid-template-columns: 1.2fr 1fr auto; gap:12px; align-items:flex-end;">
                    <!-- Duration Days -->
                    <div>
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
                            <span style="font-size:11px; font-weight:700; color:#475569;">📅 @I18n.T("Duration (Days)")</span>
                        </div>
                        <div style="display:flex; gap:4px; align-items:center;">
                            <button type="button" class="btn btn-secondary" style="height:34px; padding:0 10px; font-weight:800;" @onclick="DecreaseDays">-</button>
                            <input type="number"
                                   min="1"
                                   max="365"
                                   class="classic-input"
                                   style="height:34px; text-align:center; font-size:13.5px; font-weight:800; color:#0f172a;"
                                   @bind="days"
                                   @bind:event="oninput"
                                   @onkeyup="OnDaysChanged" />
                            <button type="button" class="btn btn-secondary" style="height:34px; padding:0 10px; font-weight:800;" @onclick="IncreaseDays">+</button>
                        </div>
                        <!-- Quick Duration Chips -->
                        <div style="display:flex; gap:4px; margin-top:4px; flex-wrap:wrap;">
                            @foreach (var d in DurationPresets)
                            {
                                <button type="button"
                                        class="rx-chip @(days == d.Days ? "active" : "")"
                                        style="padding:1px 6px; font-size:10.5px;"
                                        @onclick="() => SelectDurationPreset(d.Days)">
                                    @d.Label
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Calculated Quantity -->
                    <div>
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
                            <span style="font-size:11px; font-weight:700; color:#475569;">📦 @I18n.T("Total Quantity *")</span>
                            @if (isQuantityManual)
                            {
                                <button type="button"
                                        class="btn-clear"
                                        style="font-size:10px; color:#0284c7; font-weight:700; cursor:pointer;"
                                        @onclick="ResetQuantityToAuto">
                                    ↺ @I18n.T("Auto") (@autoCalculatedQty)
                                </button>
                            }
                        </div>
                        <input type="number"
                               min="1"
                               class="classic-input"
                               style="height:34px; font-size:14px; font-weight:800; color:#0369a1; text-align:center;"
                               @bind="quantity"
                               @bind:event="oninput"
                               @onchange="OnQuantityManuallyChanged" />
                        <div style="margin-top:4px;">
                            <span class="rx-calc-badge @(isQuantityManual ? "manual" : "")">
                                @if (isQuantityManual)
                                {
                                    <span>✏️ @I18n.T("Manual override") (@autoCalculatedQty @I18n.T("auto"))</span>
                                }
                                else
                                {
                                    <span>⚡ @ParseDailyUnits(dosagePattern)/day × @days days = <b>@quantity</b></span>
                                }
                            </span>
                        </div>
                    </div>

                    <!-- Add Button -->
                    <div>
                        <button type="button"
                                class="btn btn-primary"
                                style="height:38px; padding:0 18px; font-size:13px; font-weight:700; background:#0284c7; border-color:#0284c7; white-space:nowrap;"
                                @onclick="AddMedicine"
                                disabled="@(!canPrescribe || (medicineId <= 0 && selectedMedicine == null))">
                            + @I18n.T("Add Medication")
                        </button>
                    </div>
                </div>
