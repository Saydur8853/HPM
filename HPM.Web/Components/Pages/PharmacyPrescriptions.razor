        activeListTab = ipd ? "ipd" : "all";
        if (editor.ID == 0)
        {
            editor.Type = ipd ? "IPD-Indent" : "OPD";
        }
    }

    private void SelectInpatient(AdmittedPatientSummary inp)
    {
        selectedInpatient = inp;
        editor.PatientID = inp.PatientID;
        editor.Name = inp.PatientName;
        editor.Age = inp.Age;
        editor.Sex = inp.Sex;
        editor.BloodGroup = inp.BloodGroup;
        if (!string.IsNullOrWhiteSpace(inp.Diagnosis))
            editor.Diagnosis = inp.Diagnosis;
        if (inp.ConsultantId.HasValue && inp.ConsultantId.Value > 0)
        {
            doctorId = inp.ConsultantId.Value;
            editor.ReferredBy = inp.ConsultantId.Value;
        }
        inpatientSearch = "";
        showInpatientDropdown = false;
    }

    private void ClearSelectedInpatient()
    {
        selectedInpatient = null;
        inpatientSearch = "";
        showInpatientDropdown = false;
    }

    private void Reset()
    {
        editor = NewEditor();
        lines = [];
        visitDate = DateTime.Now;
        doctorId = currentDoctorProfileId ?? 0;
        selectedMedicine = null;
        selectedPatient = null;
        selectedInpatient = null;
        inpatientSearch = "";
        medicineId = 0;
        medicineSearchQuery = "";
        patientSearchQuery = "";
        weightText = "";
        dosagePattern = "1 + 0 + 1";
        selectedInstruction = "After meal (ভরা পেটে)";
        days = 7;
        quantity = 14;
        autoCalculatedQty = 14;
        isQuantityManual = false;
        message = "";
        if (isIpdMode) editor.Type = "IPD-Indent";
    }

    private static Prescription NewEditor() => new() { Sex = "" };
    private string MedicineName(int id) => rawMedicines.FirstOrDefault(x => x.ID == id)?.Name ?? "—";
    private string? MedicineGeneric(int id)
    {
        var med = rawMedicines.FirstOrDefault(x => x.ID == id);
        if (med?.GenericID.HasValue == true && genericNames.TryGetValue(med.GenericID.Value, out var g))
            return g;
        return null;
    }
    private string DoctorName(int? id) { var x = doctors.FirstOrDefault(x => x.ID == id); return x == null ? "—" : $"{x.Title} {x.Name}"; }
    private string DoctorQualification(int? id) { var x = doctors.FirstOrDefault(x => x.ID == id); return x?.Degree ?? "MBBS, Specialist Consultant"; }
    private string DoctorDesignation(int? id) { var x = doctors.FirstOrDefault(x => x.ID == id); return x?.Attachment ?? "Consultant Physician"; }
    private string DoctorDeptName(int? id) { return "Clinical Medicine"; }
    private void Success(string x) { messageClass = "success"; message = x; }
    private void Fail(string x) { messageClass = "danger"; message = x; }

