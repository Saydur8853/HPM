@code{
    [SupplyParameterFromQuery(Name = "encounterId")]
    public long? QueryEncounterId { get; set; }

    [SupplyParameterFromQuery(Name = "patientId")]
    public string? QueryPatientId { get; set; }

    [SupplyParameterFromQuery(Name = "view")]
    public string? ViewMode { get; set; }

    // Prescription models
    private Prescription editor = NewEditor();
    private List<PrescriptionMedicine> lines = [];
    private List<Service> rawMedicines = [];
    private List<MedicineSearchItem> medItems = [];
    private Dictionary<int, string> genericNames = [];
    private Dictionary<int, string> typeNames = [];
    private List<DoctorsProfile> doctors = [];
    private List<Prescription> recent = [];
    private List<Registration> registeredPatients = [];

    // IPD Ward Indent State
    private bool isIpdMode;
    private string activeListTab = "all";
    private List<AdmittedPatientSummary> admittedPatients = [];
    private AdmittedPatientSummary? selectedInpatient;
    private string inpatientSearch = "";
    private bool showInpatientDropdown;

    // State & Selection
    private DateTime visitDate = DateTime.Now;
    private int doctorId;
    private int medicineId;
    private MedicineSearchItem? selectedMedicine;
    private Registration? selectedPatient;
    private string medicineSearchQuery = "";
    private string patientSearchQuery = "";
    private string weightText = "";
    private bool showMedicineSuggestions;
    private bool showPatientSuggestions;
    private int highlightedMedIndex = 0;
    private bool showClinicalSection = true;

    // Intelligent Dosage Calculator State
    private string dosagePattern = "1 + 0 + 1";
    private string selectedInstruction = "After meal (ভরা পেটে)";
    private int days = 7;
    private int quantity = 14;
    private int autoCalculatedQty = 14;
    private bool isQuantityManual = false;
    private decimal? dose = 1;

    // Presets
    private readonly (string Label, string Pattern, decimal DailyUnits)[] DosagePresets = new[]
    {
        ("1 + 0 + 1", "1 + 0 + 1", 2m),
        ("1 + 1 + 1", "1 + 1 + 1", 3m),
        ("1 + 0 + 0", "1 + 0 + 0", 1m),
        ("0 + 0 + 1", "0 + 0 + 1", 1m),
        ("0 + 1 + 0", "0 + 1 + 0", 1m),
        ("2 + 0 + 2", "2 + 0 + 2", 4m),
        ("1 + 1 + 1 + 1", "1 + 1 + 1 + 1", 4m),
        ("½ + 0 + ½", "½ + 0 + ½", 1m),
        ("Once Daily", "1 time daily", 1m),
        ("PRN (প্রয়োজনে)", "As needed (PRN)", 1m)
    };

    private readonly (string Label, int Days)[] DurationPresets = new[]
    {
        ("3d", 3),
        ("5d", 5),
        ("7d", 7),
        ("10d", 10),
        ("14d", 14),
        ("1m (30d)", 30),
        ("2m (60d)", 60)
    };

    private readonly string[] InstructionPresets = new[]
    {
        "After meal (ভরা পেটে)",
        "Before meal (খালি পেটে)",
        "With meal (খাবারের সাথে)",
        "At bedtime (ঘুমানোর আগে)",
        "30 min before meal (খাবারের ৩০ মিনিট আগে)",
        "As directed (নিয়ম অনুযায়ী)"
    };

    // Filtered search results
    private List<MedicineSearchItem> FilteredMedicines
    {
        get
        {
            if (string.IsNullOrWhiteSpace(medicineSearchQuery)) return [];
            var q = medicineSearchQuery.Trim();
            return medItems.Where(m =>
                m.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                (m.GenericName?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (m.TypeName?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
            ).Take(15).ToList();
        }
    }

    private IEnumerable<Registration> PatientSuggestions
    {
        get
        {
            if (string.IsNullOrWhiteSpace(patientSearchQuery)) return Enumerable.Empty<Registration>();
            var q = patientSearchQuery.Trim();
            return registeredPatients.Where(p =>
                (p.PatientID?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.Name?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.Contact?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
            ).Take(6);
        }
    }

    private IEnumerable<AdmittedPatientSummary> FilteredInpatients
    {
        get
        {
            if (string.IsNullOrWhiteSpace(inpatientSearch)) return admittedPatients.Take(12);
            var q = inpatientSearch.Trim();
            return admittedPatients.Where(p =>
                p.PatientName.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                p.RegNo.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                (p.BedCabinName?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.DepartmentName?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.PatientID?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
            ).Take(12);
        }
    }

    private string rxScanQuery = "";
    private string message = "", messageClass = "success";
    private bool isSaving;
    private bool canPrescribe;
    private bool isAdministrator;
    private int? currentDoctorProfileId;

    private IEnumerable<Prescription> Filtered
    {
        get
        {
            var q = recent.AsEnumerable();
            if (activeListTab == "ipd")
                q = q.Where(x => string.Equals(x.Type, "IPD-Indent", StringComparison.OrdinalIgnoreCase));
            else if (activeListTab == "opd")
                q = q.Where(x => !string.Equals(x.Type, "IPD-Indent", StringComparison.OrdinalIgnoreCase));

            if (!string.IsNullOrWhiteSpace(rxScanQuery))
            {
                var s = rxScanQuery.Trim();
                q = q.Where(x => (x.Name?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                              || x.ID.ToString().Contains(s)
                              || (x.PatientID?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                              || $"RX-{x.ID}".Contains(s, StringComparison.OrdinalIgnoreCase));
            }
            return q.Take(100);
        }
    }

    // =========================================================================
    // Intelligent Dosage Calculator Logic
    // =========================================================================
    private decimal ParseDailyUnits(string? pattern)
    {
        if (string.IsNullOrWhiteSpace(pattern)) return 1m;
        var trimmed = pattern.Trim();

        // Check if matching any preset directly
        var matched = DosagePresets.FirstOrDefault(p => string.Equals(p.Pattern, trimmed, StringComparison.OrdinalIgnoreCase) || string.Equals(p.Label, trimmed, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrEmpty(matched.Pattern)) return matched.DailyUnits;

        // Split by '+', '-', or spaces
        var parts = trimmed.Split(new[] { '+', '-', ' ' }, StringSplitOptions.RemoveEmptyEntries);
        decimal sum = 0;
        bool foundAny = false;
        foreach (var p in parts)
        {
            var clean = p.Trim();
            if (clean == "½" || clean == "1/2")
            {
                sum += 0.5m;
                foundAny = true;
            }
            else if (decimal.TryParse(clean, out var val))
            {
                sum += val;
                foundAny = true;
            }
        }

        if (foundAny && sum > 0) return sum;
        if (decimal.TryParse(trimmed, out var num) && num > 0) return num;

        return 1m;
    }

    private void RecalculateQuantity()
    {
        var daily = ParseDailyUnits(dosagePattern);
        var d = Math.Max(1, days);
        autoCalculatedQty = (int)Math.Ceiling(daily * d);
        if (!isQuantityManual)
        {
            quantity = autoCalculatedQty;
        }
    }

    private void SelectDosagePreset((string Label, string Pattern, decimal DailyUnits) preset)
    {
        dosagePattern = preset.Pattern;
        RecalculateQuantity();
    }

    private void SelectDurationPreset(int d)
    {
        days = d;
        RecalculateQuantity();
    }

    private void SelectInstructionPreset(string ins)
    {
        selectedInstruction = ins;
    }

    private void IncreaseDays()
    {
        days = Math.Min(365, days + 1);
        RecalculateQuantity();
    }

    private void DecreaseDays()
    {
        days = Math.Max(1, days - 1);
        RecalculateQuantity();
    }

    private void OnDaysChanged()
    {
        days = Math.Max(1, days);
        RecalculateQuantity();
    }

    private void OnDosagePatternChanged()
    {
        RecalculateQuantity();
    }

    private void OnQuantityManuallyChanged()
    {
        isQuantityManual = true;
    }

    private void ResetQuantityToAuto()
    {
        isQuantityManual = false;
        quantity = autoCalculatedQty;
    }

    // =========================================================================
    // Medicine Auto-Suggest Dropdown Handlers
    // =========================================================================
    private void SelectMedicine(MedicineSearchItem item)
    {
        selectedMedicine = item;
        medicineId = item.ID;
        medicineSearchQuery = item.Name;
        showMedicineSuggestions = false;
        highlightedMedIndex = 0;
        RecalculateQuantity();
    }

    private void ClearSelectedMedicine()
    {
        selectedMedicine = null;
        medicineId = 0;
        medicineSearchQuery = "";
        showMedicineSuggestions = false;
        highlightedMedIndex = 0;
    }

    private void ClearMedicineSearch()
    {
        medicineSearchQuery = "";
        showMedicineSuggestions = false;
        highlightedMedIndex = 0;
    }

    private void HandleMedicineSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowDown")
        {
            showMedicineSuggestions = true;
            if (FilteredMedicines.Count > 0)
                highlightedMedIndex = (highlightedMedIndex + 1) % FilteredMedicines.Count;
        }
        else if (e.Key == "ArrowUp")
        {
            showMedicineSuggestions = true;
            if (FilteredMedicines.Count > 0)
                highlightedMedIndex = (highlightedMedIndex - 1 + FilteredMedicines.Count) % FilteredMedicines.Count;
        }
        else if (e.Key == "Enter")
        {
            if (showMedicineSuggestions && FilteredMedicines.Count > 0 && highlightedMedIndex >= 0 && highlightedMedIndex < FilteredMedicines.Count)
            {
                SelectMedicine(FilteredMedicines[highlightedMedIndex]);
            }
        }
        else if (e.Key == "Escape")
        {
            showMedicineSuggestions = false;
        }
        else
        {
            showMedicineSuggestions = true;
        }
    }

    // =========================================================================
    // Patient Search & Selection
    // =========================================================================
    private void SelectPatient(Registration p)
    {
        selectedPatient = p;
        editor.PatientID = p.PatientID;
        editor.Name = p.Name;
        editor.Age = FormatPatientAge(p.DateOfBirth);
        editor.Sex = p.Sex;
        editor.BloodGroup = p.BloodGroup;
        if (!string.IsNullOrWhiteSpace(p.Weight))
        {
            weightText = $"{p.Weight} kg";
            if (decimal.TryParse(p.Weight, out var w)) editor.Weight = w;
        }

        patientSearchQuery = "";
        showPatientSuggestions = false;
        _ = DetectAssignedDoctorAsync(p.PatientID);
    }

    private void ClearSelectedPatient()
    {
        selectedPatient = null;
        editor.PatientID = null;
        patientSearchQuery = "";
    }

    private void ClearPatientSearch()
    {
        patientSearchQuery = "";
        showPatientSuggestions = false;
    }

    private async Task HandlePatientSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await FindPatientDirectAsync();
        }
    }

    private async Task FindPatientDirectAsync()
    {
        if (string.IsNullOrWhiteSpace(patientSearchQuery)) return;
        showPatientSuggestions = false;
        editor.PatientID = patientSearchQuery.Trim();
        await FindPatientAsync();
    }

    private static string FormatPatientAge(DateTime? dob)
    {
        if (dob.HasValue && dob.Value.Year > 1900)
            return $"{Math.Max(1, DateTime.Today.Year - dob.Value.Year)}Y";
        return "35Y";
    }

