    private void ClearRxScan() => rxScanQuery = "";

    private async Task HandleRxScanKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ProcessRxScanAsync();
        }
    }

    private async Task ProcessRxScanAsync()
    {
        if (string.IsNullOrWhiteSpace(rxScanQuery)) return;
        var raw = rxScanQuery.Trim();

        long parsedId = 0;
        if (raw.StartsWith("HPM:RX|", StringComparison.OrdinalIgnoreCase))
        {
            var parts = raw.Split('|');
            foreach (var p in parts)
            {
                if (p.StartsWith("ID:", StringComparison.OrdinalIgnoreCase) && long.TryParse(p.Substring(3), out var rxId))
                {
                    parsedId = rxId;
                    break;
                }
            }
        }
        else if (raw.StartsWith("RX-", StringComparison.OrdinalIgnoreCase) && long.TryParse(raw.Substring(3), out var rxId))
        {
            parsedId = rxId;
        }
        else if (long.TryParse(raw, out var numId))
        {
            parsedId = numId;
        }

        if (parsedId > 0 && recent.Any(x => x.ID == parsedId))
        {
            await SelectAsync(parsedId);
            rxScanQuery = "";
            Success(I18n.IsBangla ? $"প্রেসক্রিপশন #{parsedId} লোড হয়েছে।" : $"Prescription #{parsedId} loaded.");
            return;
        }

        // If not a prescription number, search patient
        editor.PatientID = raw;
        await FindPatientAsync();
    }

    // =========================================================================
    // Initialization & Data Loading
    // =========================================================================
    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        var principal = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        isAdministrator = principal.IsInRole(RoleNames.Administrator);
        if (int.TryParse(principal.FindFirstValue(AppUserClaimsPrincipalFactory.DoctorProfileIdClaim), out var mappedDoctorId))
            currentDoctorProfileId = mappedDoctorId;
        canPrescribe = isAdministrator || principal.IsInRole(RoleNames.Doctor) || principal.IsInRole(RoleNames.PharmacyOperator) || principal.IsInRole(RoleNames.Reception) || currentDoctorProfileId.HasValue;
        if (currentDoctorProfileId.HasValue) doctorId = currentDoctorProfileId.Value;
        RecalculateQuantity();
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(ViewMode, "ipd-indent", StringComparison.OrdinalIgnoreCase))
        {
            SetMode(true);
        }
        if (QueryEncounterId is > 0 && editor.ID == 0 && editor.EncounterID != QueryEncounterId)
            await LoadEncounterAsync(QueryEncounterId.Value);
        else if (!string.IsNullOrWhiteSpace(QueryPatientId) && editor.ID == 0)
        {
            editor.PatientID = QueryPatientId.Trim();
            await FindPatientAsync();
        }
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        
        // 1. Load Generic Names & Medicine Types dictionaries
        genericNames = await db.GenericGroups.AsNoTracking().ToDictionaryAsync(x => x.ID, x => x.Name ?? "");
        typeNames = await db.MedicineTypes.AsNoTracking().ToDictionaryAsync(x => x.ID, x => x.Type ?? "");

        // 2. Load Services where CategoryID = 3 (Medicines)
        rawMedicines = await db.Services.AsNoTracking().Where(x => x.CategoryID == 3).OrderBy(x => x.Name).ToListAsync();
        medItems = rawMedicines.Select(m => new MedicineSearchItem
        {
            ID = m.ID,
            Name = m.Name ?? "Medicine",
            GenericName = m.GenericID.HasValue && genericNames.TryGetValue(m.GenericID.Value, out var g) ? g : null,
            TypeName = m.TypeID.HasValue && typeNames.TryGetValue(m.TypeID.Value, out var t) ? t : null,
            SaleRate = m.SaleRate ?? 0
        }).ToList();

        // 3. Load active doctors
        doctors = await db.Doctors.AsNoTracking().Where(x => x.IsActive == true).OrderBy(x => x.Name).ToListAsync();

        // 4. Load recent patients for search dropdown
        registeredPatients = await db.Registrations.AsNoTracking().OrderByDescending(x => x.ID).Take(150).ToListAsync();

        // 5. Load active admitted inpatients for IPD Indent
        var admissions = await db.PatientAdmissions.AsNoTracking().Where(x => x.IsAdmitted == true).OrderByDescending(x => x.ID).Take(100).ToListAsync();
        var bedIds = admissions.Where(x => x.BedCabinID.HasValue).Select(x => x.BedCabinID!.Value).Distinct().ToList();
        var deptIds = admissions.Where(x => x.Department.HasValue).Select(x => x.Department!.Value).Distinct().ToList();
        var pids = admissions.Where(x => !string.IsNullOrWhiteSpace(x.PatientID)).Select(x => x.PatientID!).Distinct().ToList();

        var bedMap = await db.BedCabins.AsNoTracking().Where(x => bedIds.Contains(x.ID)).ToDictionaryAsync(x => x.ID, x => x.Name);
        var deptMap = await db.IpdDepartments.AsNoTracking().Where(x => deptIds.Contains(x.ID)).ToDictionaryAsync(x => x.ID, x => x.Name);
        var patMap = await db.Registrations.AsNoTracking().Where(x => pids.Contains(x.PatientID)).ToDictionaryAsync(x => x.PatientID, x => x);

        admittedPatients = admissions.Select(a =>
        {
            var p = a.PatientID != null && patMap.TryGetValue(a.PatientID, out var reg) ? reg : null;
            var d = a.Consultant.HasValue ? doctors.FirstOrDefault(doc => doc.ID == a.Consultant.Value) : null;
            return new AdmittedPatientSummary
            {
                AdmissionID = a.ID,
                RegNo = a.RegNo,
                PatientID = a.PatientID,
                PatientName = p?.Name ?? $"Inpatient ({a.RegNo})",
                Age = a.Age ?? (p != null ? FormatPatientAge(p.DateOfBirth) : null),
                Sex = p?.Sex,
                BloodGroup = p?.BloodGroup,
                BedCabinName = a.BedCabinID.HasValue && bedMap.TryGetValue(a.BedCabinID.Value, out var bn) ? bn : "General",
                DepartmentName = a.Department.HasValue && deptMap.TryGetValue(a.Department.Value, out var dn) ? dn : "IPD Ward",
                ConsultantId = a.Consultant,
                ConsultantName = d != null ? $"{d.Title} {d.Name}".Trim() : null,
                Diagnosis = a.Diagnosis
            };
        }).ToList();

        // 6. Load recent prescriptions
        recent = await db.Prescriptions.AsNoTracking().Include(x => x.Medicines).OrderByDescending(x => x.ID).Take(150).ToListAsync();
    }

    private async Task DetectAssignedDoctorAsync(string? pid)
    {
        if (string.IsNullOrWhiteSpace(pid)) return;
        await using var db = await DbFactory.CreateDbContextAsync();

        var opdTicket = await db.OPDTickets.AsNoTracking().Where(x => x.RegNo == pid && x.DoctorID > 0).OrderByDescending(x => x.ID).FirstOrDefaultAsync();
        var appt = await db.DoctorAppointments.AsNoTracking().Where(x => x.PatientID == pid && x.DoctorID > 0).OrderByDescending(x => x.ID).FirstOrDefaultAsync();
        var encounter = await db.PatientEncounters.AsNoTracking().Where(x => x.PatientID == pid && x.DoctorID > 0).OrderByDescending(x => x.ID).FirstOrDefaultAsync();
        var admission = await db.PatientAdmissions.AsNoTracking().Where(x => x.PatientID == pid && x.Consultant > 0).OrderByDescending(x => x.ID).FirstOrDefaultAsync();
        var prevRx = await db.Prescriptions.AsNoTracking().Where(x => x.PatientID == pid && x.ReferredBy > 0).OrderByDescending(x => x.ID).FirstOrDefaultAsync();

        int assignedDoctorId = opdTicket?.DoctorID
            ?? appt?.DoctorID
            ?? encounter?.DoctorID
            ?? admission?.Consultant
            ?? prevRx?.ReferredBy
            ?? 0;

        if (assignedDoctorId > 0 && doctors.Any(d => d.ID == assignedDoctorId))
        {
            doctorId = assignedDoctorId;
            editor.ReferredBy = assignedDoctorId;
        }
        else if (doctorId == 0 && currentDoctorProfileId.HasValue && doctors.Any(d => d.ID == currentDoctorProfileId.Value))
        {
            doctorId = currentDoctorProfileId.Value;
            editor.ReferredBy = doctorId;
        }

        if (opdTicket != null)
        {
            editor.TicketID = opdTicket.ID;
            if (!string.IsNullOrWhiteSpace(opdTicket.Comments) && string.IsNullOrWhiteSpace(editor.Complain))
                editor.Complain = opdTicket.Comments;
        }

        if (encounter != null)
        {
            editor.EncounterID = encounter.ID;
            if (!string.IsNullOrWhiteSpace(encounter.Diagnosis) && string.IsNullOrWhiteSpace(editor.Diagnosis))
                editor.Diagnosis = encounter.Diagnosis;
            if (!string.IsNullOrWhiteSpace(encounter.ChiefComplaint) && string.IsNullOrWhiteSpace(editor.Complain))
                editor.Complain = encounter.ChiefComplaint;
        }
    }

    private async Task FindPatientAsync()
    {
        if (string.IsNullOrWhiteSpace(editor.PatientID)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var pid = editor.PatientID.Trim();
        var p = await db.Registrations.AsNoTracking().FirstOrDefaultAsync(x => x.PatientID == pid);
        if (p != null)
        {
            SelectPatient(p);
            Success(I18n.IsBangla ? $"রোগী '{p.Name}' (PID: {p.PatientID}) এর তথ্য লোড হয়েছে।" : $"Patient '{p.Name}' loaded.");
        }
        else
        {
            Fail(I18n.IsBangla ? $"পেশেন্ট আইডি '{pid}' পাওয়া যায়নি।" : $"Patient ID '{pid}' was not found.");
        }
    }

    private async Task LoadEncounterAsync(long encounterId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var encounter = await db.PatientEncounters.AsNoTracking().SingleOrDefaultAsync(x => x.ID == encounterId);
        if (encounter is null) { Fail(I18n.T("Clinical encounter was not found.")); return; }
        if (!isAdministrator && (!currentDoctorProfileId.HasValue || encounter.DoctorID != currentDoctorProfileId.Value)) { Fail(I18n.T("You can prescribe only for your own patient queue.")); return; }
        if (encounter.Status == EncounterStatuses.Completed) { Fail(I18n.T("This visit is already completed.")); return; }
        var patient = string.IsNullOrWhiteSpace(encounter.PatientID) ? null : await db.Registrations.AsNoTracking().SingleOrDefaultAsync(x => x.PatientID == encounter.PatientID);
        editor.EncounterID = encounter.ID;
        editor.PatientID = encounter.PatientID;
        editor.TicketID = encounter.TicketID;
        editor.Name = encounter.PatientName;
        editor.Age = encounter.Age;
        editor.Sex = encounter.Sex ?? patient?.Sex;
        editor.BloodGroup = patient?.BloodGroup;
        if (!string.IsNullOrWhiteSpace(patient?.Weight))
        {
            weightText = $"{patient.Weight} kg";
            if (decimal.TryParse(patient.Weight, out var w)) editor.Weight = w;
        }
        editor.Diagnosis = encounter.Diagnosis;
        editor.Complain = encounter.ChiefComplaint;
        doctorId = encounter.DoctorID;
        visitDate = encounter.VisitDate.Add(DateTime.Now.TimeOfDay);
        Success(I18n.T("Patient loaded from the doctor queue."));
    }

    // =========================================================================
    // Add Medicine to Cart
