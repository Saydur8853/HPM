@page "/legacy-module"
@attribute [Authorize]
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>@DisplayName - PrimeHPM</PageTitle>

<div class="page-heading">
    <div>
        <span class="eyebrow">@ModuleName</span>
        <h1>@DisplayName</h1>
        <p>This desktop module is listed in the original PrimeHPM menu but has not yet been migrated to the web application.</p>
    </div>
</div>

<section class="panel legacy-module-panel">
    <div class="legacy-module-icon">⌛</div>
    <h2>@DisplayName</h2>
    <p>The menu structure now matches the desktop application. This screen will become available when the corresponding workflow is migrated.</p>
    <a class="btn btn-primary" href="/">Return to Dashboard</a>
</section>

@code {
    [SupplyParameterFromQuery(Name = "module")] public string? Module { get; set; }
    [SupplyParameterFromQuery(Name = "name")] public string? Name { get; set; }
    private string ModuleName => string.IsNullOrWhiteSpace(Module) ? "PrimeHPM" : Module;
    private string DisplayName => string.IsNullOrWhiteSpace(Name) ? "Legacy Module" : Name;

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(Module, "Store", StringComparison.OrdinalIgnoreCase))
        {
            if (string.Equals(Name, "Challan", StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo("/store/challan", true);
                return;
            }
            if (string.Equals(Name, "Products", StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo("/store/products", true);
                return;
            }
        }

        if (string.Equals(Module, "Medical Services", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(Module, "Nurse's Desk", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(Module, "Certificates & Others", StringComparison.OrdinalIgnoreCase))
        {
            if (string.Equals(Name, "Operation List", StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo("/medical/operations", true);
                return;
            }
            if (string.Equals(Name, "OT Note", StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo("/medical/ot-notes", true);
                return;
            }
            if (string.Equals(Name, "Sticker/Forms", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(Name, "Stickers & Clinical Forms", StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo("/medical/nurse-desk", true);
                return;
            }
            if (string.Equals(Name, "Birth Certificate", StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo("/medical/certificates?type=birth", true);
                return;
            }
            if (string.Equals(Name, "Death Certificate", StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo("/medical/certificates?type=death", true);
                return;
            }
            if (string.Equals(Name, "Fitness Certificate", StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo("/medical/certificates?type=fitness", true);
                return;
            }
            if (string.Equals(Name, "Discharge Certificate", StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo("/ipd/medical-discharge-orders", true);
                return;
            }
            if (string.Equals(Name, "Indent Medicine", StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo("/doctor/prescriptions?view=ipd-indent", true);
                return;
            }
            if (string.Equals(Name, "IPD Investigation", StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo("/diagnostic/billing?patientType=IPD", true);
                return;
            }
        }

        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        if (!ModuleAccess.CanView(user, ModuleAccess.LegacyModuleRoles(Module)))
            Navigation.NavigateTo("/access-denied", true);
    }
}
