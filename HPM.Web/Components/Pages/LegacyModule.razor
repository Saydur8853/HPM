@page "/legacy-module"

<PageTitle>@DisplayName - PrimeHPM</PageTitle>

<div class="page-heading">
    <div>
        <span class="eyebrow">@ModuleName</span>
        <h1>@DisplayName</h1>
        <p>This desktop module is listed in the original PrimeHPM menu but has not yet been migrated to the web application.</p>
    </div>
</div>

<section class="panel legacy-module-panel">
    <div class="legacy-module-icon">⌛</div>
    <h2>@DisplayName</h2>
    <p>The menu structure now matches the desktop application. This screen will become available when the corresponding workflow is migrated.</p>
    <a class="btn btn-primary" href="/">Return to Dashboard</a>
</section>

@code {
    [SupplyParameterFromQuery(Name = "module")] public string? Module { get; set; }
    [SupplyParameterFromQuery(Name = "name")] public string? Name { get; set; }
    private string ModuleName => string.IsNullOrWhiteSpace(Module) ? "PrimeHPM" : Module;
    private string DisplayName => string.IsNullOrWhiteSpace(Name) ? "Legacy Module" : Name;
}
