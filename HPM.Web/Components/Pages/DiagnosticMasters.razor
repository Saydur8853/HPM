@page "/diagnostic/lab-setup"
@attribute [Authorize(Roles = RoleNames.Administrator)]
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IDisposable
@using HPM.Web.Data.Entities
@using HPM.Web.Components.Common

<PageTitle>@GetPageTitle() | @Branding.HospitalName</PageTitle>

<div class="diagnostic-classic-fit">
    <!-- Top Action, Section Switcher & Status Bar -->
    <div class="diagnostic-classic-topbar">
        <div class="tickets-top-left">
            <h1 class="tickets-page-title">
                <span>📋</span>
                <span>@GetSectionTitle()</span>
            </h1>
            <div class="diagnostic-mode-toggle" role="tablist" aria-label="Lab Setup Sections">
                <button type="button" class="mode-toggle-btn @(currentSection == "parameters" ? "active" : "")" @onclick='() => SwitchSection("parameters")' title="@I18n.T("Investigation Parameters & Reference Ranges")">
                    📋 @I18n.T("Report Parameters", "রিপোর্ট প্যারামিটার")
                </button>
                <button type="button" class="mode-toggle-btn @(currentSection == "consultant" ? "active" : "")" @onclick='() => SwitchSection("consultant")' title="@I18n.T("Reporting Consultants & Signatories")">
                    👨‍⚕️ @I18n.T("Reporting Consultants", "রিপোর্টিং কনসালটেন্ট")
                </button>
            </div>
            <span class="tickets-count-pill">
                @GetRecordCount() @I18n.T("Records")
            </span>
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <span class="tickets-inline-alert @messageClass" title="@message">
                    @(messageClass.Contains("danger") ? "⚠" : "✓") @message
                </span>
            }
        </div>

        <div class="tickets-top-actions">
            <button type="button" class="btn btn-secondary tickets-btn" @onclick="OpenReportPreview" title="@I18n.T("Preview Sample Diagnostic Report")">
                👁️ @I18n.T("Report Preview", "রিপোর্ট প্রিভিউ")
            </button>
            <button type="button" class="btn btn-secondary tickets-btn" @onclick="Reset" title="@I18n.T("New Entry")">
                + @I18n.T("New")
            </button>
            <NavLink href="/diagnostic/investigations" class="btn btn-ghost tickets-btn" title="@I18n.T("Investigations & Categories")">
                🧪 @I18n.T("Investigations")
            </NavLink>
            <NavLink href="" class="btn btn-ghost tickets-btn" title="@I18n.T("Dashboard")">
                ← @I18n.T("Dashboard", "ড্যাশবোর্ড")
            </NavLink>
        </div>
    </div>

    <!-- Main Balanced Workspace Grid: Left Form Card, Right Directory Card -->
    <div class="diagnostic-classic-workspace">
        <!-- Left Panel: Form Card -->
        <div class="diagnostic-form-card" style="flex: 1;">
            <div class="diagnostic-card-header">
                <h2>@GetFormCardTitle()</h2>
                <span class="diagnostic-badge">
                    @(IsEditing ? $"ID #{GetEditingId()}" : "NEW")
                </span>
            </div>

            <div class="diagnostic-form-body" style="overflow-y:auto; padding:14px 16px;">
                @if (currentSection == "consultant")
                {
                    <div style="display:flex; flex-direction:column; gap:10px;">
                        <label style="margin:0;">
                            <span style="font-size:11.5px; font-weight:700; color:#334155;">@I18n.T("Consultant / Signatory Name") *</span>
                            <input class="classic-input" @bind="consultantEditor.Name" placeholder="e.g. Dr. Mashud Parvez" style="height:32px; font-weight:600;" />
                        </label>
                        <label style="margin:0;">
                            <span style="font-size:11.5px; font-weight:700; color:#475569;">@I18n.T("Degree & Qualifications")</span>
                            <input class="classic-input" @bind="consultantEditor.Degree" placeholder="e.g. MBBS, MD (Pathology)" style="height:30px;" />
                        </label>
                        <label style="margin:0;">
                            <span style="font-size:11.5px; font-weight:700; color:#475569;">@I18n.T("Designation & Department")</span>
                            <input class="classic-input" @bind="consultantEditor.Others" placeholder="e.g. Associate Professor, Dept. of Pathology" style="height:30px;" />
                        </label>
                        <label style="margin:0;">
                            <span style="font-size:11.5px; font-weight:700; color:#475569;">@I18n.T("Hospital / Institution")</span>
                            <input class="classic-input" @bind="consultantEditor.Institution" placeholder="e.g. Dhaka Medical College & Hospital" style="height:30px;" />
                        </label>
                        <div style="display:flex; align-items:center; gap:8px; padding:6px 10px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px;">
                            <label style="display:inline-flex; align-items:center; gap:8px; cursor:pointer; font-size:12px; font-weight:600; color:#334155; margin:0;">
                                <input type="checkbox" @bind="consultantEditor.Is_Active" style="width:15px; height:15px;" />
                                <span>@I18n.T("Active Signatory for Lab & Imaging Reports")</span>
                            </label>
                        </div>

                        <div style="display:flex; gap:8px; justify-content:flex-end; margin-top:6px;">
                            <button class="btn btn-primary" type="button" @onclick="SaveConsultantAsync" style="padding:6px 16px;">
                                @(consultantEditor.ID == 0 ? "✓ " + I18n.T("Save Consultant") : "✓ " + I18n.T("Update Consultant"))
                            </button>
                            @if (consultantEditor.ID > 0)
                            {
                                <button class="btn btn-danger" type="button" @onclick="DeleteConsultantAsync" style="padding:6px 12px;">
                                    🗑️ @I18n.T("Delete")
                                </button>
                            }
                            <button class="btn btn-ghost" type="button" @onclick="Reset" style="padding:6px 12px;">
                                @I18n.T("Clear")
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div style="display:flex; flex-direction:column; gap:10px;">
                        <!-- Filter & Search Investigation -->
                        <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:10px 12px; display:flex; flex-direction:column; gap:8px;">
                            <div style="display:flex; justify-content:space-between; align-items:center;">
                                <span style="font-size:11.5px; font-weight:800; color:#0f172a;">@I18n.T("Select Investigation") *</span>
                                <span class="pill" style="font-size:10.5px;">@FilteredFormInvestigations.Count() @I18n.T("found")</span>
                            </div>
                            <div style="display:grid; grid-template-columns: 1fr 1.2fr; gap:6px;">
                                <select class="classic-input tickets-select" @bind="paramTypeFilter" style="height:28px; font-size:11.5px;">
                                    <option value="All">@I18n.T("All Types")</option>
                                    <option value="Pathology">@I18n.T("Pathology")</option>
                                    <option value="Imaging">@I18n.T("Imaging")</option>
                                    <option value="Procedure">@I18n.T("Special Investigations")</option>
                                </select>
                                <input type="search"
                                       class="classic-input"
                                       placeholder="@I18n.T("Search investigation...")"
                                       @bind="paramInvestigationSearch"
                                       @bind:event="oninput"
                                       style="height:28px; font-size:11.5px;" />
                            </div>
                            <select class="classic-input tickets-select" @bind="paramEditor.ServiceID" style="height:32px; font-weight:600;">
                                <option value="0">@I18n.T("-- Select Investigation --")</option>
                                @foreach (var s in FilteredFormInvestigations)
                                {
                                    <option value="@s.ID">@s.Name (@CategoryName(s.CategoryID))</option>
                                }
                            </select>
                        </div>

                        <label style="margin:0;">
                            <span style="font-size:11.5px; font-weight:700; color:#334155;">@I18n.T("Parameter Name") *</span>
                            <input class="classic-input" @bind="paramEditor.ParameterName" placeholder="e.g. Hemoglobin (Hb), SGPT/ALT, Serum Creatinine" style="height:30px; font-weight:600;" />
                        </label>
                        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:8px;">
                            <label style="margin:0;">
                                <span style="font-size:11.5px; font-weight:700; color:#475569;">@I18n.T("Unit")</span>
                                <input class="classic-input" @bind="paramEditor.Unit" placeholder="e.g. g/dL, mg/dL, U/L" style="height:30px;" />
                            </label>
                            <label style="margin:0;">
                                <span style="font-size:11.5px; font-weight:700; color:#475569;">@I18n.T("Display Order")</span>
                                <input type="number" class="classic-input" @bind="paramEditor.SortOrder" style="height:30px;" />
                            </label>
                        </div>
                        <label style="margin:0;">
                            <span style="font-size:11.5px; font-weight:700; color:#475569;">@I18n.T("Reference Normal Range")</span>
                            <input class="classic-input" @bind="paramEditor.ReferenceRange" placeholder="e.g. Male: 13.5-17.5, Female: 12.0-15.5" style="height:30px;" />
                        </label>

                        <div style="display:flex; gap:8px; justify-content:flex-end; margin-top:6px;">
                            <button class="btn btn-primary" type="button" @onclick="SaveParamAsync" style="padding:6px 16px;">
                                @(paramEditor.ID == 0 ? "✓ " + I18n.T("Save Parameter") : "✓ " + I18n.T("Update Parameter"))
                            </button>
                            @if (paramEditor.ID > 0)
                            {
                                <button class="btn btn-danger" type="button" @onclick="DeleteParamAsync" style="padding:6px 12px;">
                                    🗑️ @I18n.T("Delete")
                                </button>
                            }
                            <button class="btn btn-ghost" type="button" @onclick="Reset" style="padding:6px 12px;">
                                @I18n.T("Clear")
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Right Panel: Directory Card -->
        <div class="diagnostic-queue-card" style="flex: 1.45;">
            <div class="diagnostic-card-header" style="flex-wrap:wrap; gap:8px;">
                <h2>@GetQueueCardTitle()</h2>
                <div style="display:flex; flex-wrap:wrap; align-items:center; gap:8px;">
                    @if (currentSection == "parameters")
                    {
                        <select class="classic-input tickets-select" style="min-width:190px; max-width:240px; height:28px; font-size:11.5px;" @bind="selectedFilterServiceId" @bind:after="FilterParameters">
                            <option value="0">@I18n.T("All Investigations") (@labServices.Count)</option>
                            @foreach (var s in labServices)
                            {
                                <option value="@s.ID">@s.Name</option>
                            }
                        </select>
                    }
                    <input type="search"
                           class="classic-input"
                           placeholder="@I18n.T("Search records...")"
                           @bind="searchQuery"
                           @bind:event="oninput"
                           style="width:175px; height:28px; font-size:11.5px;" />
                    <span class="diagnostic-badge">@GetFilteredCount()</span>
                </div>
            </div>

            <div class="diagnostic-queue-body" style="overflow-y:auto; padding:6px 8px; max-height:calc(100vh - 165px);">
                @if (currentSection == "consultant")
                {
                    <table class="classic-table" style="font-size:11.5px; width:100%;">
                        <thead>
                            <tr>
                                <th style="width:45px;">#</th>
                                <th>@I18n.T("Consultant Name")</th>
                                <th>@I18n.T("Degree")</th>
                                <th>@I18n.T("Designation")</th>
                                <th style="width:75px; text-align:center;">@I18n.T("Status")</th>
                                <th style="width:65px; text-align:right;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!FilteredConsultants.Any())
                            {
                                <tr><td colspan="6" style="text-align:center; padding:24px; color:#94a3b8;">@I18n.T("No consultants found.")</td></tr>
                            }
                            @foreach (var c in FilteredConsultants)
                            {
                                <tr style="@(consultantEditor.ID == c.ID ? "background:#e0f2fe; font-weight:700;" : "")">
                                    <td><span class="pill" style="font-size:10px;">#@c.ID</span></td>
                                    <td>
                                        <div><b>@c.Name</b></div>
                                        @if (!string.IsNullOrWhiteSpace(c.Institution))
                                        {
                                            <small style="color:#64748b;">@c.Institution</small>
                                        }
                                    </td>
                                    <td><small>@(string.IsNullOrWhiteSpace(c.Degree) ? "—" : c.Degree)</small></td>
                                    <td><small>@(string.IsNullOrWhiteSpace(c.Others) ? "—" : c.Others)</small></td>
                                    <td style="text-align:center;">
                                        <span class="pill @(c.Is_Active ? "pill-success" : "")" style="font-size:10px; font-weight:700;">
                                            @(c.Is_Active ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td style="text-align:right;">
                                        <button class="btn btn-ghost" style="padding:2px 8px; font-size:11px;" @onclick="() => SelectConsultant(c)">
                                            ✏️ @I18n.T("Edit")
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <table class="classic-table" style="font-size:11.5px; width:100%;">
                        <thead>
                            <tr>
                                <th>@I18n.T("Investigation")</th>
                                <th>@I18n.T("Parameter")</th>
                                <th style="width:80px; text-align:center;">@I18n.T("Unit")</th>
                                <th>@I18n.T("Reference Normal Range")</th>
                                <th style="width:45px; text-align:center;">#</th>
                                <th style="width:65px; text-align:right;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!FilteredParams.Any())
                            {
                                <tr><td colspan="6" style="text-align:center; padding:24px; color:#94a3b8;">@I18n.T("No parameters found.")</td></tr>
                            }
                            @foreach (var p in FilteredParams)
                            {
                                <tr style="@(paramEditor.ID == p.ID ? "background:#e0f2fe; font-weight:700;" : "")">
                                    <td><b>@ServiceName(p.ServiceID)</b></td>
                                    <td>@p.ParameterName</td>
                                    <td style="text-align:center;"><span class="pill" style="font-size:10.5px;">@(string.IsNullOrWhiteSpace(p.Unit) ? "—" : p.Unit)</span></td>
                                    <td><small style="color:#475569;">@(string.IsNullOrWhiteSpace(p.ReferenceRange) ? "—" : p.ReferenceRange)</small></td>
                                    <td style="text-align:center;">@p.SortOrder</td>
                                    <td style="text-align:right;">
                                        <button class="btn btn-ghost" style="padding:2px 8px; font-size:11px;" @onclick="() => SelectParam(p)">
                                            ✏️ @I18n.T("Edit")
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

@if (showReportPreview)
{
    var previewService = labServices.FirstOrDefault(x => x.ID == previewServiceId);
    var previewCat = previewService?.CategoryID.HasValue == true && categoryMap.TryGetValue(previewService.CategoryID.Value, out var pc) ? pc : null;
    var previewType = previewService != null ? DiagnosticTestRouting.Resolve(previewService, previewCat) : "Pathology";
    var previewParams = parameters.Where(p => p.ServiceID == previewServiceId).OrderBy(p => p.SortOrder).ToList();
    var previewConsultant = consultants.FirstOrDefault(c => c.ID == previewConsultantId);

    <div class="modal-backdrop" style="z-index:1100; background:rgba(15,23,42,0.58); display:flex; align-items:center; justify-content:center; padding:16px;" @onclick="CloseReportPreview">
        <div style="background:#f1f5f9; border-radius:14px; width:min(860px, 96vw); max-height:92vh; display:flex; flex-direction:column; box-shadow:0 24px 60px rgba(15,23,42,0.35); overflow:hidden;" @onclick:stopPropagation="true">
            <!-- Modal Header -->
            <div style="background:#fff; padding:12px 18px; border-bottom:1px solid #e2e8f0; display:flex; align-items:center; justify-content:space-between; gap:12px;">
                <div style="display:flex; align-items:center; gap:8px;">
                    <span style="font-size:18px;">📄</span>
                    <div>
                        <div style="font-size:14px; font-weight:800; color:#0f172a;">@I18n.T("Sample Diagnostic Report Preview", "নমুনা ডায়াগনস্টিক রিপোর্ট প্রিভিউ")</div>
                        <div style="font-size:11px; color:#64748b;">@I18n.T("Live preview showing how Investigation, Parameters, and Consultant appear on the printed report")</div>
                    </div>
                </div>
                <button type="button" class="btn btn-ghost" style="padding:4px 10px; font-size:14px;" @onclick="CloseReportPreview">✕</button>
            </div>

            <!-- Interactive Preview Selectors -->
            <div style="background:#f8fafc; padding:10px 18px; border-bottom:1px solid #e2e8f0; display:grid; grid-template-columns: 1fr 1fr; gap:12px;">
                <label style="margin:0;">
                    <span style="font-size:11px; font-weight:700; color:#334155;">@I18n.T("Preview Investigation")</span>
                    <select class="classic-input tickets-select" @bind="previewServiceId" style="height:30px; font-size:12px; font-weight:600;">
                        @foreach (var s in labServices)
                        {
                            var cnt = parameters.Count(p => p.ServiceID == s.ID);
                            <option value="@s.ID">@s.Name (@CategoryName(s.CategoryID)) @(cnt > 0 ? $"— {cnt} params" : "")</option>
                        }
                    </select>
                </label>
                <label style="margin:0;">
                    <span style="font-size:11px; font-weight:700; color:#334155;">@I18n.T("Preview Reporting Consultant")</span>
                    <select class="classic-input tickets-select" @bind="previewConsultantId" style="height:30px; font-size:12px; font-weight:600;">
                        <option value="0">@I18n.T("-- No Consultant Selected --")</option>
                        @foreach (var c in consultants)
                        {
                            <option value="@c.ID">@c.Name @(string.IsNullOrWhiteSpace(c.Degree) ? "" : $"({c.Degree})")</option>
                        }
                    </select>
                </label>
            </div>

            <!-- Report Paper Body -->
            <div style="overflow-y:auto; padding:18px; flex:1;">
                <div style="background:#fff; border:1px solid #cbd5e1; border-radius:8px; padding:24px 28px; box-shadow:0 4px 16px rgba(15,23,42,0.06); color:#0f172a; font-family:inherit;">
                    <!-- Hospital Header -->
                    <div style="display:flex; justify-content:space-between; align-items:flex-start; border-bottom:2px solid #0284c7; padding-bottom:12px; margin-bottom:14px;">
                        <div>
                            <div style="font-size:18px; font-weight:800; color:#0c4a6e; letter-spacing:0.2px;">@Branding.HospitalName</div>
                            @if (!string.IsNullOrWhiteSpace(Branding.Address))
                            {
                                <div style="font-size:11.5px; color:#475569;">@Branding.Address</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Branding.Phone))
                            {
                                <div style="font-size:11.5px; color:#475569;">Phone: @Branding.Phone</div>
                            }
                        </div>
                        <div style="text-align:right;">
                            <div style="display:inline-block; background:#e0f2fe; color:#0369a1; font-size:11px; font-weight:800; padding:4px 10px; border-radius:6px; letter-spacing:0.5px;">
                                @(previewType == "Imaging" ? "IMAGING / RADIOLOGY REPORT" : previewType == "Procedure" ? "SPECIAL INVESTIGATION REPORT" : "PATHOLOGY / LAB REPORT")
                            </div>
                            <div style="font-size:10.5px; color:#64748b; margin-top:4px;">SAMPLE PREVIEW</div>
                        </div>
                    </div>

                    <!-- Sample Patient Info Box -->
                    <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:8px 14px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:6px; padding:10px 12px; font-size:11.5px; margin-bottom:16px;">
                        <div><span style="color:#64748b;">Patient Name:</span> <b>Md. Rahim Uddin</b></div>
                        <div><span style="color:#64748b;">Age / Sex:</span> <b>34 Y / Male</b></div>
                        <div><span style="color:#64748b;">Patient ID:</span> <b>PID-10482</b></div>
                        <div><span style="color:#64748b;">Memo / Bill No:</span> <b>INV-2026-0814</b></div>
                        <div><span style="color:#64748b;">Report Date:</span> <b>@DateTime.Now.ToString("dd MMM yyyy, hh:mm tt")</b></div>
                        <div><span style="color:#64748b;">Ref. By:</span> <b>Dr. Kamrul Hasan</b></div>
                    </div>

                    <!-- Investigation Title -->
                    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px;">
                        <div style="font-size:14px; font-weight:800; color:#0f172a;">
                            Investigation: @(previewService?.Name ?? "—")
                        </div>
                        <span class="pill" style="font-size:11px; background:#f1f5f9; color:#334155;">
                            @CategoryName(previewService?.CategoryID)
                        </span>
                    </div>

                    <!-- Parameters Table -->
                    <table style="width:100%; border-collapse:collapse; font-size:12px; margin-bottom:28px;">
                        <thead>
                            <tr style="background:#f1f5f9; border-top:1px solid #cbd5e1; border-bottom:1px solid #cbd5e1;">
                                <th style="text-align:left; padding:8px 10px; font-weight:700;">@I18n.T(previewType == "Imaging" ? "Section / Heading" : "Parameter Name")</th>
                                <th style="text-align:left; padding:8px 10px; font-weight:700;">@I18n.T(previewType == "Imaging" ? "Findings (Example)" : "Result (Example)")</th>
                                <th style="text-align:center; padding:8px 10px; font-weight:700; width:90px;">@I18n.T("Unit")</th>
                                <th style="text-align:left; padding:8px 10px; font-weight:700;">@I18n.T("Reference Normal Range")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (previewParams.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" style="padding:18px 10px; text-align:center; color:#64748b; border-bottom:1px solid #e2e8f0;">
                                        @I18n.T("No parameters configured for this investigation yet. Add parameters in the form to see them here.")
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var p in previewParams)
                                {
                                    <tr style="border-bottom:1px solid #e2e8f0;">
                                        <td style="padding:8px 10px; font-weight:600;">@p.ParameterName</td>
                                        <td style="padding:8px 10px; font-weight:700; color:#0369a1;">@SampleResultForPreview(p)</td>
                                        <td style="padding:8px 10px; text-align:center; color:#475569;">@(string.IsNullOrWhiteSpace(p.Unit) ? "—" : p.Unit)</td>
                                        <td style="padding:8px 10px; color:#475569;">@(string.IsNullOrWhiteSpace(p.ReferenceRange) ? "—" : p.ReferenceRange)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>

                    <!-- Signatures Footer -->
                    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-top:32px; padding-top:12px;">
                        <div style="text-align:left; min-width:180px;">
                            <div style="border-top:1px solid #94a3b8; width:160px; margin-bottom:5px;"></div>
                            <div style="font-size:11.5px; font-weight:700; color:#334155;">Medical Technologist</div>
                            <div style="font-size:10.5px; color:#64748b;">Prepared / Checked By</div>
                        </div>

                        <div style="text-align:right; min-width:220px;">
                            <div style="border-top:1px solid #94a3b8; width:210px; margin-left:auto; margin-bottom:5px;"></div>
                            @if (previewConsultant != null)
                            {
                                <div style="font-size:12.5px; font-weight:800; color:#0f172a;">@previewConsultant.Name</div>
                                @if (!string.IsNullOrWhiteSpace(previewConsultant.Degree))
                                {
                                    <div style="font-size:11px; font-weight:600; color:#334155;">@previewConsultant.Degree</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(previewConsultant.Others))
                                {
                                    <div style="font-size:10.5px; color:#475569;">@previewConsultant.Others</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(previewConsultant.Institution))
                                {
                                    <div style="font-size:10.5px; color:#64748b;">@previewConsultant.Institution</div>
                                }
                            }
                            else
                            {
                                <div style="font-size:11.5px; font-weight:700; color:#64748b;">Reporting Consultant</div>
                                <div style="font-size:10.5px; color:#94a3b8;">(Add or select consultant in Reporting Consultants tab)</div>
                            }
                        </div>
                    </div>

                    <div style="margin-top:18px; padding-top:8px; border-top:1px dashed #cbd5e1; font-size:10.5px; color:#64748b; text-align:center;">
                        @I18n.T("Sample preview only — actual patient reports are entered and printed from Diagnostic Results.")
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "section")]
    public string? QuerySection { get; set; }

    private string currentSection = "parameters";
    private string searchQuery = "";
    private int selectedFilterServiceId = 0;
    private string paramTypeFilter = "All";
    private string paramInvestigationSearch = "";
    private string message = "";
    private string messageClass = "success";
    private bool showReportPreview = false;
    private int previewServiceId = 0;
    private int previewConsultantId = 0;

    private LabConsultant consultantEditor = new() { Is_Active = true };
    private List<LabConsultant> consultants = [];

    private LabTestParameter paramEditor = new() { SortOrder = 1 };
    private List<LabTestParameter> parameters = [];
    private List<LabTestParameter> filteredParameters = [];
    private List<Service> labServices = [];
    private Dictionary<int, ServiceCategory> categoryMap = [];

    private IEnumerable<Service> FilteredFormInvestigations
    {
        get
        {
            IEnumerable<Service> result = labServices;
            if (paramTypeFilter != "All")
            {
                result = result.Where(s =>
                {
                    var cat = s.CategoryID.HasValue && categoryMap.TryGetValue(s.CategoryID.Value, out var c) ? c : null;
                    return DiagnosticTestRouting.Resolve(s, cat) == paramTypeFilter;
                });
            }
            if (!string.IsNullOrWhiteSpace(paramInvestigationSearch))
            {
                var term = paramInvestigationSearch.Trim();
                result = result.Where(s => (s.Name?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || CategoryName(s.CategoryID).Contains(term, StringComparison.OrdinalIgnoreCase)
                    || s.ID.ToString().Contains(term));
            }
            return result;
        }
    }

    private IEnumerable<LabConsultant> FilteredConsultants => string.IsNullOrWhiteSpace(searchQuery)
        ? consultants
        : consultants.Where(c => c.Name.Contains(searchQuery.Trim(), StringComparison.OrdinalIgnoreCase)
                              || (c.Degree?.Contains(searchQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)
                              || (c.Others?.Contains(searchQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)
                              || (c.Institution?.Contains(searchQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false));

    private IEnumerable<LabTestParameter> FilteredParams => filteredParameters.Where(p =>
        string.IsNullOrWhiteSpace(searchQuery)
        || p.ParameterName.Contains(searchQuery.Trim(), StringComparison.OrdinalIgnoreCase)
        || ServiceName(p.ServiceID).Contains(searchQuery.Trim(), StringComparison.OrdinalIgnoreCase)
        || (p.Unit?.Contains(searchQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)
        || (p.ReferenceRange?.Contains(searchQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false));

    private bool IsEditing => currentSection == "consultant" ? consultantEditor.ID > 0 : paramEditor.ID > 0;
    private int GetEditingId() => currentSection == "consultant" ? consultantEditor.ID : paramEditor.ID;
    private int GetRecordCount() => currentSection == "consultant" ? consultants.Count : parameters.Count;
    private int GetFilteredCount() => currentSection == "consultant" ? FilteredConsultants.Count() : FilteredParams.Count();

    private string GetPageTitle() => currentSection == "consultant"
        ? I18n.T("Reporting Consultants")
        : I18n.T("Lab Setup & Report Parameters");

    private string GetSectionTitle() => currentSection == "consultant"
        ? I18n.T("Reporting Consultants", "রিপোর্টিং কনসালটেন্ট")
        : I18n.T("Lab Setup & Report Parameters", "ল্যাব সেটআপ ও রিপোর্ট প্যারামিটার");

    private string GetFormCardTitle() => currentSection == "consultant"
        ? (consultantEditor.ID == 0 ? I18n.T("Add Consultant") : $"{I18n.T("Edit Consultant")} #{consultantEditor.ID}")
        : (paramEditor.ID == 0 ? I18n.T("Add Report Parameter") : $"{I18n.T("Edit Parameter")} #{paramEditor.ID}");

    private string GetQueueCardTitle() => currentSection == "consultant"
        ? I18n.T("Reporting Consultants Directory")
        : I18n.T("Report Parameters Directory");

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        ApplySectionFromQuery();
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        ApplySectionFromQuery();
    }

    private void ApplySectionFromQuery()
    {
        var target = (QuerySection ?? "").Trim().ToLowerInvariant();
        if (target is "consultant" or "parameters")
        {
            if (currentSection != target)
            {
                currentSection = target;
                Reset();
            }
        }
        else
        {
            currentSection = "parameters";
        }
    }

    private void SwitchSection(string sec)
    {
        if (currentSection == sec) return;
        currentSection = sec;
        Navigation.NavigateTo($"/diagnostic/lab-setup?section={sec}", replace: false);
        Reset();
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        consultants = await db.LabConsultants.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
        var allCats = await db.ServiceCategories.AsNoTracking().ToListAsync();
        var diagCats = allCats.Where(DiagnosticTestRouting.IsDiagnosticCategory).ToList();
        categoryMap = diagCats.ToDictionary(x => x.ID);
        var diagCatIds = categoryMap.Keys.ToHashSet();

        labServices = (await db.Services.AsNoTracking()
            .Where(s => s.CategoryID != null && diagCatIds.Contains(s.CategoryID.Value))
            .OrderBy(x => x.Name)
            .ToListAsync());

        parameters = await db.LabTestParameters.AsNoTracking().OrderBy(x => x.ServiceID).ThenBy(x => x.SortOrder).ToListAsync();
        FilterParameters();
    }

    private void FilterParameters()
    {
        filteredParameters = selectedFilterServiceId <= 0
            ? parameters
            : parameters.Where(x => x.ServiceID == selectedFilterServiceId).ToList();
    }

    private async Task SaveConsultantAsync()
    {
        if (string.IsNullOrWhiteSpace(consultantEditor.Name))
        {
            Fail(I18n.IsBangla ? "কনসালট্যান্টের নাম আবশ্যক।" : "Consultant name is required.");
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        if (consultantEditor.ID == 0)
        {
            db.LabConsultants.Add(consultantEditor);
        }
        else
        {
            var entity = await db.LabConsultants.FindAsync(consultantEditor.ID);
            if (entity == null) { Fail(I18n.T("Record not found.")); return; }
            db.Entry(entity).CurrentValues.SetValues(consultantEditor);
        }

        await db.SaveChangesAsync();
        Success(I18n.IsBangla ? "রিপোর্টিং কনসালট্যান্ট সংরক্ষিত হয়েছে।" : "Reporting consultant saved successfully.");
        Reset();
        await LoadAsync();
    }

    private void SelectConsultant(LabConsultant c)
    {
        consultantEditor = new LabConsultant
        {
            ID = c.ID,
            Name = c.Name,
            Degree = c.Degree,
            Others = c.Others,
            Institution = c.Institution,
            Is_Active = c.Is_Active
        };
        message = "";
    }

    private async Task DeleteConsultantAsync()
    {
        if (!await JS.InvokeAsync<bool>("hpm.confirm", I18n.T($"Delete consultant '{consultantEditor.Name}'?"))) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.LabConsultants.FindAsync(consultantEditor.ID);
        if (entity != null)
        {
            db.LabConsultants.Remove(entity);
            await db.SaveChangesAsync();
            Success(I18n.T("Consultant deleted."));
            Reset();
            await LoadAsync();
        }
    }

    private async Task SaveParamAsync()
    {
        if (paramEditor.ServiceID <= 0 || string.IsNullOrWhiteSpace(paramEditor.ParameterName))
        {
            Fail(I18n.IsBangla ? "ইনভেস্টিগেশন এবং প্যারামিটারের নাম আবশ্যক।" : "Investigation and parameter name are required.");
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        if (paramEditor.ID == 0)
        {
            db.LabTestParameters.Add(paramEditor);
        }
        else
        {
            var entity = await db.LabTestParameters.FindAsync(paramEditor.ID);
            if (entity == null) { Fail(I18n.T("Parameter not found.")); return; }
            db.Entry(entity).CurrentValues.SetValues(paramEditor);
        }

        await db.SaveChangesAsync();
        Success(I18n.IsBangla ? "রিপোর্ট প্যারামিটার সংরক্ষিত হয়েছে।" : "Report parameter saved successfully.");
        var curService = paramEditor.ServiceID;
        Reset();
        paramEditor.ServiceID = curService;
        await LoadAsync();
    }

    private void SelectParam(LabTestParameter p)
    {
        paramEditor = new LabTestParameter
        {
            ID = p.ID,
            ServiceID = p.ServiceID,
            ParameterName = p.ParameterName,
            Unit = p.Unit,
            ReferenceRange = p.ReferenceRange,
            SortOrder = p.SortOrder
        };
        message = "";
    }

    private async Task DeleteParamAsync()
    {
        if (!await JS.InvokeAsync<bool>("hpm.confirm", I18n.T($"Delete parameter '{paramEditor.ParameterName}'?"))) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.LabTestParameters.FindAsync(paramEditor.ID);
        if (entity != null)
        {
            db.LabTestParameters.Remove(entity);
            await db.SaveChangesAsync();
            Success(I18n.T("Parameter deleted."));
            Reset();
            await LoadAsync();
        }
    }

    private void Reset()
    {
        consultantEditor = new LabConsultant { Is_Active = true };
        paramEditor = new LabTestParameter { SortOrder = 1 };
        searchQuery = "";
        message = "";
    }

    private string ServiceName(int id) => labServices.FirstOrDefault(x => x.ID == id)?.Name ?? $"#{id}";
    private string CategoryName(int? id) => id.HasValue && categoryMap.TryGetValue(id.Value, out var c) ? c.Name : "—";
    private void Success(string text) { messageClass = "success"; message = text; }
    private void Fail(string text) { messageClass = "danger"; message = text; }

    private void OpenReportPreview()
    {
        if (paramEditor.ServiceID > 0)
            previewServiceId = paramEditor.ServiceID;
        else if (selectedFilterServiceId > 0)
            previewServiceId = selectedFilterServiceId;
        else
            previewServiceId = parameters.Select(p => p.ServiceID).FirstOrDefault(id => labServices.Any(s => s.ID == id));

        if (previewServiceId <= 0 && labServices.Count > 0)
            previewServiceId = labServices[0].ID;

        if (consultantEditor.ID > 0)
            previewConsultantId = consultantEditor.ID;
        else
            previewConsultantId = consultants.FirstOrDefault(c => c.Is_Active)?.ID
                ?? consultants.FirstOrDefault()?.ID
                ?? 0;

        showReportPreview = true;
    }

    private void CloseReportPreview() => showReportPreview = false;

    private static string SampleResultForPreview(LabTestParameter p)
    {
        var range = p.ReferenceRange?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(range)) return "Normal";

        var match = System.Text.RegularExpressions.Regex.Match(range, @"(\d+(?:\.\d+)?)\s*[-–]\s*(\d+(?:\.\d+)?)");
        if (match.Success
            && double.TryParse(match.Groups[1].Value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var min)
            && double.TryParse(match.Groups[2].Value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var max))
        {
            var mid = (min + max) / 2.0;
            return mid % 1 == 0 ? mid.ToString("0", System.Globalization.CultureInfo.InvariantCulture) : mid.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
        }

        if (range.StartsWith("<", StringComparison.Ordinal))
        {
            var numMatch = System.Text.RegularExpressions.Regex.Match(range, @"\d+(?:\.\d+)?");
            if (numMatch.Success && double.TryParse(numMatch.Value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var upper))
            {
                var sample = Math.Max(0.1, upper * 0.65);
                return sample % 1 == 0 ? sample.ToString("0", System.Globalization.CultureInfo.InvariantCulture) : sample.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
            }
        }

        return "Normal";
    }

    public void Dispose() => I18n.OnLanguageChanged -= HandleLanguageChanged;
}
