            BuyRate = x.BuyRate ?? 0,
            SaleRate = x.SaleRate ?? 0,
            ReOrderLevel = x.ReOrderLevel ?? 0,
            IsVATApp = x.IsVATApp ?? false,
            InvestigationModuleID = x.InvestigationModuleID
        };
        genericComboText = lookupGenerics.FirstOrDefault(g => g.ID == x.GenericID)?.Name ?? "";
        supplierComboText = lookupSuppliers.FirstOrDefault(s => s.ID == x.SupplierID)?.Name ?? "";
        showGenericCombo = false;
        showSupplierCombo = false;
        await ScrollToTopAsync();
    }

    private async Task DeleteMedicineByIdAsync(int id, string? name)
    {
        if (!await JS.InvokeAsync<bool>("hpm.confirm", $"Delete medicine '{name}'?")) return;
        isBusy = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var used = await db.MedicineStoreBalances.AnyAsync(x => x.ServiceID == id)
                || await db.PharmacyCashMemoItems.AnyAsync(x => x.ServiceID == id)
                || await db.MedicineReceivingChallanItems.AnyAsync(x => x.ServiceID == id)
                || await db.PrescriptionMedicines.AnyAsync(x => x.ServiceID == id)
                || await db.PurchaseRequisitionItems.AnyAsync(x => x.ServiceID == id)
                || await db.EmergencyMemoItems.AnyAsync(x => x.TestID == id)
                || await db.OTCashMemoItems.AnyAsync(x => x.ServiceID == id)
                || await db.IpdPatientServiceItems.AnyAsync(x => x.ServiceID == id);
            if (used)
            {
                Fail("Cannot delete: this medicine has stock, sales, purchase, or prescription records.");
                return;
            }
            var item = await db.Services.FirstOrDefaultAsync(x => x.ID == id && x.CategoryID == MedicineCategoryId);
            if (item != null)
            {
                db.Services.Remove(item);
                await db.SaveChangesAsync();
            }
            if (medicine.ID == id) ResetMedicine();
            Success($"Medicine '{name}' deleted.");
            await LoadTabCountsAndLookupsAsync();
            await LoadMedicinesPageAsync();
        }
        finally { isBusy = false; }
    }

