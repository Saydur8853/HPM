    // ===================== CRUD OPERATIONS =====================

    private async Task SaveMedicineAsync()
    {
        medicine.Name = medicine.Name?.Trim();
        var normalizedSku = string.IsNullOrWhiteSpace(medicine.Sku) ? null : medicine.Sku.Trim().ToUpperInvariant();

        if (string.IsNullOrWhiteSpace(medicine.Name) || medicine.TypeID is null or <= 0 || medicine.GenericID is null or <= 0 || medicine.SupplierID is null or <= 0)
        {
            Fail(I18n.IsBangla ? "ঔষধের নাম, ধরন, জেনেরিক এবং কোম্পানি আবশ্যক।" : "Medicine name, dosage type, generic and company are required.");
            return;
        }
        if ((medicine.BuyRate ?? 0) < 0 || (medicine.SaleRate ?? 0) < 0 || (medicine.ReOrderLevel ?? 0) < 0)
        {
            Fail(I18n.IsBangla ? "মূল্য বা অ্যালার্ট লেভেল ঋণাত্মক হতে পারে না।" : "Rates and alert level cannot be negative.");
            return;
        }

        isBusy = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (await db.Services.AnyAsync(x => x.CategoryID == MedicineCategoryId && x.Name == medicine.Name && x.ID != medicine.ID))
            {
                Fail(I18n.IsBangla ? "এই নামের ঔষধ ইতিমধ্যে আছে।" : "A medicine with this name already exists.");
                return;
            }
            if (!string.IsNullOrEmpty(normalizedSku) && await db.Services.AnyAsync(x => x.CategoryID == MedicineCategoryId && x.Sku == normalizedSku && x.ID != medicine.ID))
            {
                Fail($"SKU '{normalizedSku}' is already assigned to another medicine.");
                return;
            }

            if (medicine.ID == 0)
            {
                medicine.CategoryID = MedicineCategoryId;
                medicine.InvestigationModuleID = 0;
                medicine.Sku = normalizedSku;
                db.Services.Add(medicine);
                await db.SaveChangesAsync();

                if (string.IsNullOrEmpty(medicine.Sku))
                {
                    medicine.Sku = $"MED-{medicine.ID:D5}";
                    await db.SaveChangesAsync();
                }
                Success($"Medicine '{medicine.Name}' saved with SKU {medicine.Sku}.");
            }
            else
            {
                var current = await db.Services.FirstOrDefaultAsync(x => x.ID == medicine.ID && x.CategoryID == MedicineCategoryId);
                if (current == null) { Fail("Medicine was not found."); return; }
                current.Sku = normalizedSku ?? $"MED-{current.ID:D5}";
                current.Name = medicine.Name;
                current.TypeID = medicine.TypeID;
                current.GenericID = medicine.GenericID;
                current.SupplierID = medicine.SupplierID;
                current.BuyRate = medicine.BuyRate;
                current.SaleRate = medicine.SaleRate;
                current.ReOrderLevel = medicine.ReOrderLevel;
                current.IsVATApp = medicine.IsVATApp;
                await db.SaveChangesAsync();
                Success($"Medicine '{current.Name}' ({current.Sku}) updated.");
            }

            ResetMedicine();
            await LoadTabCountsAndLookupsAsync();
            await LoadMedicinesPageAsync();
        }
        finally { isBusy = false; }
    }

