    private async Task ExportFilteredAsync()
    {
        if (isExporting) return;
        isExporting = true;
        try
        {
            var inv = System.Globalization.CultureInfo.InvariantCulture;
            var rows = await LoadAllFilteredMedicinesAsync();
            static string Clean(string v) => v == "—" ? "" : v;

            var typeRows = lookupTypes.Where(x => !string.IsNullOrWhiteSpace(x.Type))
                .Select(x => (IReadOnlyList<string>)new[] { x.Type.Trim(), x.ID.ToString(inv) }).ToList();
            var genRows = lookupGenerics.Where(x => !string.IsNullOrWhiteSpace(x.Name))
                .Select(x => (IReadOnlyList<string>)new[] { x.Name.Trim(), x.ID.ToString(inv) }).ToList();
            var supRows = lookupSuppliers.Where(x => !string.IsNullOrWhiteSpace(x.Name))
                .Select(x => (IReadOnlyList<string>)new[] { x.Name.Trim(), x.ID.ToString(inv) }).ToList();

            // Column order matches the import template so the file can be edited and re-imported.
            var headers = new[] { "Name", "Type", "Generic", "Supplier", "BuyRate", "SaleRate", "ReOrderLevel", "VatApplicable", "SKU", "Stock" };
            var data = rows.Select(r => (IReadOnlyList<string>)new[]
            {
                r.Name ?? "",
                Clean(r.TypeName),
                Clean(r.GenericName),
                Clean(r.SupplierName),
                r.BuyRate.ToString(inv),
                r.SaleRate.ToString(inv),
                r.ReOrderLevel.ToString(inv),
                r.IsVat ? "Yes" : "No",
                string.IsNullOrWhiteSpace(r.Sku) ? $"MED-{r.ID:D5}" : r.Sku,
                r.LiveStock.ToString("0.##", inv)
            }).ToList();

            var validations = new List<HPM.Web.Services.XlsxWorkbookBuilder.DropdownValidation>
            {
                new(1, "MedicineTypes", typeRows.Count),
                new(2, "GenericGroups", genRows.Count),
                new(3, "PharmacySuppliers", supRows.Count)
            };
            var sheets = new List<HPM.Web.Services.XlsxWorkbookBuilder.SheetSpec>
            {
                new("Medicines", headers, data, validations),
                new("MedicineTypes", new[] { "TypeName", "ID" }, typeRows),
                new("GenericGroups", new[] { "GenericName", "ID" }, genRows),
                new("PharmacySuppliers", new[] { "SupplierName", "ID" }, supRows)
            };

            var xlsx = HPM.Web.Services.XlsxWorkbookBuilder.Build(sheets);
            var tag = HasActiveMedicineFilter ? "filtered" : "all";
            await JS.InvokeVoidAsync("hpm.downloadFile",
                $"medicines-{tag}-{DateTime.Now:yyyyMMdd-HHmm}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                Convert.ToBase64String(xlsx));
            Success(I18n.IsBangla ? $"{rows.Count}টি ঔষধ Excel-এ এক্সপোর্ট হয়েছে।" : $"{rows.Count} medicines exported to Excel.");
        }
        catch (Exception ex)
        {
            Fail((I18n.IsBangla ? "এক্সপোর্ট ব্যর্থ: " : "Export failed: ") + ex.Message);
        }
        finally { isExporting = false; }
    }

    private async Task PrintFilteredAsync()
    {
        if (isPrinting) return;
        if (medicineTotalFiltered > 1500 &&
            !await JS.InvokeAsync<bool>("hpm.confirm", I18n.IsBangla
                ? $"{medicineTotalFiltered}টি ঔষধ প্রিন্ট হবে, অনেক পেজ লাগবে। চালিয়ে যাবেন?"
                : $"{medicineTotalFiltered} medicines will be printed across many pages. Continue?"))
            return;

        isPrinting = true;
        try
        {
            printRows = (await LoadAllFilteredMedicinesAsync()).Select(ToDto).ToList();
            printedAt = DateTime.Now;
            StateHasChanged();
            await Task.Delay(80);
            await JS.InvokeVoidAsync("hpm.printElement", "pharmacy-catalogue-print", "Medicine Catalogue");
        }
        finally { isPrinting = false; }
    }

