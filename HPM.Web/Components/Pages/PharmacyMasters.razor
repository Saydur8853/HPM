@code {
    private const int MedicineCategoryId = 3;
    private const int PageSize = 50;

    [SupplyParameterFromQuery(Name = "section")]
    public string? QuerySection { get; set; }

    private string currentSection = "services";
    private int medicinePage = 1;

    private Service medicine = NewMedicine();
    private MedicineStore store = NewStore();
    private GenericGroup generic = new();
    private MedicineType medicineType = new();
    private SupplierPharmacy supplier = new();

    private List<Service> medicines = [];
    private List<MedicineStore> stores = [];
    private List<GenericGroup> genericGroups = [];
    private List<MedicineType> medicineTypes = [];
    private List<SupplierPharmacy> suppliers = [];
    private List<PharmacySalesReturn> recentReturns = [];
    private Dictionary<int, int> storeBalanceCounts = [];

    private string medicineSearch = "";
    private string storeSearch = "";
    private string genericSearch = "";
    private string typeSearch = "";
    private string supplierSearch = "";

    private string message = "";
    private string messageClass = "success";

    private List<Service> FilteredMedicines
    {
        get
        {
            var query = medicineSearch.Trim();
            return medicines.Where(x => string.IsNullOrWhiteSpace(query)
                || (x.Name?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false)
                || GenericName(x.GenericID).Contains(query, StringComparison.OrdinalIgnoreCase)
                || TypeName(x.TypeID).Contains(query, StringComparison.OrdinalIgnoreCase)
                || SupplierName(x.SupplierID).Contains(query, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    private int TotalMedicinePages => Math.Max(1, (int)Math.Ceiling(FilteredMedicines.Count / (double)PageSize));

    private List<Service> PagedMedicines => FilteredMedicines
        .Skip((medicinePage - 1) * PageSize)
        .Take(PageSize)
        .ToList();

    private void OnSearchMedicineChanged()
    {
        medicinePage = 1;
    }

    private List<MedicineStore> FilteredStores
    {
        get
        {
            var query = storeSearch.Trim();
            return stores.Where(x => string.IsNullOrWhiteSpace(query)
                || (x.Name?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();
        }
    }

    private List<GenericGroup> FilteredGenerics
    {
        get
        {
            var query = genericSearch.Trim();
            return genericGroups.Where(x => string.IsNullOrWhiteSpace(query)
                || (x.Name?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();
        }
    }

    private List<MedicineType> FilteredTypes
    {
        get
        {
            var query = typeSearch.Trim();
            return medicineTypes.Where(x => string.IsNullOrWhiteSpace(query)
                || (x.Type?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();
        }
    }

    private List<SupplierPharmacy> FilteredSuppliers
    {
        get
        {
            var query = supplierSearch.Trim();
            return suppliers.Where(x => string.IsNullOrWhiteSpace(query)
                || (x.Name?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false)
                || (x.Address?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false)
                || (x.Contact?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        ApplySectionFromQuery();
        await LoadAsync();
    }

    protected override void OnParametersSet()
    {
        ApplySectionFromQuery();
    }

    private void ApplySectionFromQuery()
    {
        var target = (QuerySection ?? "").Trim().ToLowerInvariant();
        if (target is "store" or "type" or "generic" or "supplier" or "customer" or "services" or "medicine" or "all")
        {
            currentSection = target;
        }
        else if (string.IsNullOrWhiteSpace(target))
        {
            currentSection = "services";
        }
    }

    private void SwitchSection(string sec)
    {
        currentSection = sec;
        Navigation.NavigateTo($"/pharmacy/masters?section={sec}", replace: true);
        message = "";
    }

    private string GetPageTitle() => currentSection switch
    {
        "store" => I18n.T("Medicine Stores Setup", "Medicine Stores Setup"),
        "type" => I18n.T("Dosage Types Setup", "Dosage Types Setup"),
        "generic" => I18n.T("Generic Molecules Setup", "Generic Molecules Setup"),
        "supplier" => I18n.T("Pharmacy Suppliers Setup", "Pharmacy Suppliers Setup"),
        "customer" => I18n.T("Customer Medicine & Sales", "Customer Medicine & Sales"),
        "all" => I18n.T("All Pharmacy Masters", "All Pharmacy Masters"),
        _ => I18n.T("Medicine Catalogue Setup", "Medicine Catalogue Setup")
    };

    private string GetSectionTitle() => currentSection switch
    {
        "store" => I18n.T("Dispensary & Store Masters", "Dispensary & Store Masters"),
        "type" => I18n.T("Dosage Types & Formulations", "Dosage Types & Formulations"),
        "generic" => I18n.T("Generic Drug Molecule Masters", "Generic Drug Molecule Masters"),
        "supplier" => I18n.T("Pharma Suppliers & Distributors", "Pharma Suppliers & Distributors"),
        "customer" => I18n.T("Customer Medicine & Sales Returns", "Customer Medicine & Sales Returns"),
        "all" => I18n.T("All Pharmacy Masters", "All Pharmacy Masters"),
        _ => I18n.T("Medicine Catalogue & Pricing", "Medicine Catalogue & Pricing")
    };

    private void ResetCurrent()
    {
        switch (currentSection)
        {
            case "store": ResetStore(); break;
            case "type": ResetType(); break;
            case "generic": ResetGeneric(); break;
            case "supplier": ResetSupplier(); break;
            default: ResetMedicine(); break;
        }
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => I18n.OnLanguageChanged -= HandleLanguageChanged;

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        genericGroups = await db.GenericGroups.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
        medicineTypes = await db.MedicineTypes.AsNoTracking().OrderBy(x => x.Type).ToListAsync();
        suppliers = await db.PharmacySuppliers.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
        stores = await db.MedicineStores.AsNoTracking().OrderBy(x => x.Name).ToListAsync();
        medicines = await db.Services.AsNoTracking().Where(x => x.CategoryID == MedicineCategoryId).OrderBy(x => x.Name).ToListAsync();

        storeBalanceCounts = await db.MedicineStoreBalances.AsNoTracking()
            .GroupBy(x => x.MedicineStoreID)
            .Select(g => new { StoreID = g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.StoreID, x => x.Count);

        recentReturns = await db.PharmacySalesReturns.AsNoTracking()
            .OrderByDescending(x => x.TransDate)
            .Take(15)
            .ToListAsync();
    }

    private async Task SaveMedicineAsync()
    {
        medicine.Name = medicine.Name?.Trim();
        if (string.IsNullOrWhiteSpace(medicine.Name) || medicine.TypeID is null or <= 0 || medicine.GenericID is null or <= 0 || medicine.SupplierID is null or <= 0)
        {
            Fail(I18n.IsBangla ? "ঔষধের নাম, ডোজ ফরম, জেনেরিক এবং সরবরাহকারী আবশ্যক।" : "Medicine name, dosage form, generic and supplier are required.");
            return;
        }
        if ((medicine.BuyRate ?? 0) < 0 || (medicine.SaleRate ?? 0) < 0 || (medicine.ReOrderLevel ?? 0) < 0)
        {
            Fail(I18n.IsBangla ? "মূল্য এবং রিঅর্ডার লেভেল ঋণাত্মক হতে পারে না।" : "Rates and re-order level cannot be negative.");
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.Services.AnyAsync(x => x.CategoryID == MedicineCategoryId && x.Name == medicine.Name && x.ID != medicine.ID))
        {
            Fail(I18n.IsBangla ? "এই নামের একটি ঔষধ ইতিমধ্যে বিদ্যমান।" : "A medicine with this name already exists.");
            return;
        }

        if (medicine.ID == 0)
        {
            medicine.CategoryID = MedicineCategoryId;
            medicine.InvestigationModuleID = 0;
            db.Services.Add(medicine);
        }
        else
        {
            var current = await db.Services.FirstOrDefaultAsync(x => x.ID == medicine.ID && x.CategoryID == MedicineCategoryId);
            if (current == null) { Fail(I18n.IsBangla ? "ঔষধ খুঁজে পাওয়া যায়নি।" : "Medicine was not found."); return; }
            current.Name = medicine.Name; current.TypeID = medicine.TypeID; current.GenericID = medicine.GenericID;
            current.SupplierID = medicine.SupplierID; current.BuyRate = medicine.BuyRate; current.SaleRate = medicine.SaleRate;
            current.ReOrderLevel = medicine.ReOrderLevel; current.IsVATApp = medicine.IsVATApp;
        }
        await db.SaveChangesAsync();
        Success(I18n.IsBangla ? "ঔষধ সফলভাবে সংরক্ষিত হয়েছে।" : "Medicine saved successfully.");
        ResetMedicine();
        await LoadAsync();
    }

    private async Task SaveStoreAsync()
    {
        store.Name = store.Name.Trim();
        if (string.IsNullOrWhiteSpace(store.Name))
        {
            Fail(I18n.IsBangla ? "স্টোরের নাম আবশ্যক।" : "Store name is required.");
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.MedicineStores.AnyAsync(x => x.Name == store.Name && x.ID != store.ID))
        {
            Fail(I18n.IsBangla ? "এই নামের একটি স্টোর ইতিমধ্যে বিদ্যমান।" : "A medicine store with this name already exists.");
            return;
        }

        if (store.ID == 0)
        {
            db.MedicineStores.Add(store);
        }
        else
        {
            var current = await db.MedicineStores.FindAsync(store.ID);
            if (current == null) return;
            current.Name = store.Name;
            current.IsActive = store.IsActive;
            current.IsBufferStore = store.IsBufferStore;
        }
        await db.SaveChangesAsync();
        Success(I18n.IsBangla ? "ফার্মেসি স্টোর সংরক্ষিত হয়েছে।" : "Medicine store saved successfully.");
        ResetStore();
        await LoadAsync();
    }

    private async Task SaveGenericAsync()
    {
        generic.Name = generic.Name?.Trim();
        if (string.IsNullOrWhiteSpace(generic.Name)) { Fail(I18n.IsBangla ? "জেনেরিক নাম আবশ্যক।" : "Generic name is required."); return; }
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.GenericGroups.AnyAsync(x => x.Name == generic.Name && x.ID != generic.ID)) { Fail(I18n.IsBangla ? "এই জেনেরিক নাম ইতিমধ্যে বিদ্যমান।" : "This generic name already exists."); return; }
        var userId = await CurrentUserIdAsync();
        if (generic.ID == 0) { generic.EnteredBy = userId; generic.TransDate = DateTime.Now; db.GenericGroups.Add(generic); }
        else { var current = await db.GenericGroups.FindAsync(generic.ID); if (current == null) return; current.Name = generic.Name; current.EnteredBy = userId; current.TransDate = DateTime.Now; }
        await db.SaveChangesAsync();
        Success(I18n.IsBangla ? "জেনেরিক নাম সংরক্ষিত হয়েছে।" : "Generic name saved.");
        ResetGeneric();
        await LoadAsync();
    }

    private async Task SaveTypeAsync()
    {
        medicineType.Type = medicineType.Type.Trim();
        if (string.IsNullOrWhiteSpace(medicineType.Type)) { Fail(I18n.IsBangla ? "ঔষধের ধরন আবশ্যক।" : "Medicine type is required."); return; }
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.MedicineTypes.AnyAsync(x => x.Type == medicineType.Type && x.ID != medicineType.ID)) { Fail(I18n.IsBangla ? "এই ধরনের ঔষধ ইতিমধ্যে বিদ্যমান।" : "This medicine type already exists."); return; }
        var userId = await CurrentUserIdAsync();
        if (medicineType.ID == 0) { medicineType.EnteredBy = userId; medicineType.TransDate = DateTime.Now; db.MedicineTypes.Add(medicineType); }
        else { var current = await db.MedicineTypes.FindAsync(medicineType.ID); if (current == null) return; current.Type = medicineType.Type; current.EnteredBy = userId; current.TransDate = DateTime.Now; }
        await db.SaveChangesAsync();
        Success(I18n.IsBangla ? "ঔষধের ধরন সংরক্ষিত হয়েছে।" : "Medicine type saved.");
        ResetType();
        await LoadAsync();
    }

    private async Task SaveSupplierAsync()
    {
        supplier.Name = supplier.Name?.Trim();
        if (string.IsNullOrWhiteSpace(supplier.Name)) { Fail(I18n.IsBangla ? "সরবরাহকারীর নাম আবশ্যক।" : "Supplier name is required."); return; }
        if ((supplier.Amount ?? 0) < 0) { Fail(I18n.IsBangla ? "প্রারম্ভিক পরিমাণ ঋণাত্মক হতে পারে না।" : "Opening amount cannot be negative."); return; }
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.PharmacySuppliers.AnyAsync(x => x.Name == supplier.Name && x.ID != supplier.ID)) { Fail(I18n.IsBangla ? "এই সরবরাহকারী ইতিমধ্যে বিদ্যমান।" : "This supplier already exists."); return; }
        supplier.TransDate = DateTime.Now;
        if (supplier.ID == 0) db.PharmacySuppliers.Add(supplier);
        else { var current = await db.PharmacySuppliers.FindAsync(supplier.ID); if (current == null) return; current.Name = supplier.Name; current.Address = supplier.Address?.Trim(); current.Contact = supplier.Contact?.Trim(); current.Amount = supplier.Amount; current.TransDate = supplier.TransDate; }
        await db.SaveChangesAsync();
        Success(I18n.IsBangla ? "সরবরাহকারী সংরক্ষিত হয়েছে।" : "Supplier saved.");
        ResetSupplier();
        await LoadAsync();
    }

    private async Task DeleteMedicineAsync()
    {
        if (!await JS.InvokeAsync<bool>("hpm.confirm", I18n.IsBangla ? $"ঔষধ {medicine.Name} মুছে ফেলতে চান?" : $"Delete medicine {medicine.Name}?")) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var used = await db.MedicineStoreBalances.AnyAsync(x => x.ServiceID == medicine.ID)
            || await db.EmergencyMemoItems.AnyAsync(x => x.TestID == medicine.ID)
            || await db.OTCashMemoItems.AnyAsync(x => x.ServiceID == medicine.ID)
            || await db.IpdPatientServiceItems.AnyAsync(x => x.ServiceID == medicine.ID);
        if (used) { Fail(I18n.IsBangla ? "ঔষধের স্টক বা লেনদেনের রেকর্ড রয়েছে এবং এটি মুছে ফেলা যাবে না।" : "Medicine has stock or transaction history and cannot be deleted."); return; }
        var item = await db.Services.FirstOrDefaultAsync(x => x.ID == medicine.ID && x.CategoryID == MedicineCategoryId);
        if (item != null) { db.Remove(item); await db.SaveChangesAsync(); }
        Success(I18n.IsBangla ? "ঔষধ মুছে ফেলা হয়েছে।" : "Medicine deleted.");
        ResetMedicine();
        await LoadAsync();
    }

    private async Task DeleteStoreAsync()
    {
        if (!await JS.InvokeAsync<bool>("hpm.confirm", I18n.IsBangla ? $"স্টোর {store.Name} মুছে ফেলতে চান?" : $"Delete medicine store {store.Name}?")) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var usedInBalances = await db.MedicineStoreBalances.AnyAsync(x => x.MedicineStoreID == store.ID);
        var usedInChallans = await db.MedicineReceivingChallans.AnyAsync(x => x.StoreID == store.ID);
        if (usedInBalances || usedInChallans)
        {
            Fail(I18n.IsBangla ? "স্টোরে বর্তমান স্টক ব্যালেন্স বা ক্রয়ের চালান রয়েছে, এটি মুছে ফেলা যাবে না।" : "Store has active stock balances or purchase challans and cannot be deleted.");
            return;
        }
        var item = await db.MedicineStores.FindAsync(store.ID);
        if (item != null) { db.Remove(item); await db.SaveChangesAsync(); }
        Success(I18n.IsBangla ? "স্টোর মুছে ফেলা হয়েছে।" : "Store deleted.");
        ResetStore();
        await LoadAsync();
    }

    private async Task DeleteGenericAsync()
    {
        if (!await JS.InvokeAsync<bool>("hpm.confirm", I18n.IsBangla ? $"জেনেরিক {generic.Name} মুছে ফেলতে চান?" : $"Delete generic {generic.Name}?")) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.Services.AnyAsync(x => x.GenericID == generic.ID)) { Fail(I18n.IsBangla ? "জেনেরিকটি ঔষধে ব্যবহৃত হচ্ছে এবং মুছে ফেলা যাবে না।" : "Generic is used by medicines and cannot be deleted."); return; }
        var item = await db.GenericGroups.FindAsync(generic.ID); if (item != null) { db.Remove(item); await db.SaveChangesAsync(); }
        Success(I18n.IsBangla ? "জেনেরিক মুছে ফেলা হয়েছে।" : "Generic deleted.");
        ResetGeneric();
        await LoadAsync();
    }

    private async Task DeleteTypeAsync()
    {
        if (!await JS.InvokeAsync<bool>("hpm.confirm", I18n.IsBangla ? $"ধরন {medicineType.Type} মুছে ফেলতে চান?" : $"Delete type {medicineType.Type}?")) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.Services.AnyAsync(x => x.TypeID == medicineType.ID)) { Fail(I18n.IsBangla ? "ধরনটি ঔষধে ব্যবহৃত হচ্ছে এবং মুছে ফেলা যাবে না।" : "Type is used by medicines and cannot be deleted."); return; }
        var item = await db.MedicineTypes.FindAsync(medicineType.ID); if (item != null) { db.Remove(item); await db.SaveChangesAsync(); }
        Success(I18n.IsBangla ? "ঔষধের ধরন মুছে ফেলা হয়েছে।" : "Medicine type deleted.");
        ResetType();
        await LoadAsync();
    }

    private async Task DeleteSupplierAsync()
    {
        if (!await JS.InvokeAsync<bool>("hpm.confirm", I18n.IsBangla ? $"সরবরাহকারী {supplier.Name} মুছে ফেলতে চান?" : $"Delete supplier {supplier.Name}?")) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.Services.AnyAsync(x => x.SupplierID == supplier.ID)) { Fail(I18n.IsBangla ? "সরবরাহকারীটি ঔষধে ব্যবহৃত হচ্ছে এবং মুছে ফেলা যাবে না।" : "Supplier is used by medicines and cannot be deleted."); return; }
        var item = await db.PharmacySuppliers.FindAsync(supplier.ID); if (item != null) { db.Remove(item); await db.SaveChangesAsync(); }
        Success(I18n.IsBangla ? "সরবরাহকারী মুছে ফেলা হয়েছে।" : "Supplier deleted.");
        ResetSupplier();
        await LoadAsync();
    }

    private void SelectMedicine(Service x) => medicine = new Service { ID = x.ID, Name = x.Name, CategoryID = x.CategoryID, TypeID = x.TypeID, GenericID = x.GenericID, SupplierID = x.SupplierID, BuyRate = x.BuyRate, SaleRate = x.SaleRate, ReOrderLevel = x.ReOrderLevel, IsVATApp = x.IsVATApp, InvestigationModuleID = x.InvestigationModuleID };
    private void SelectStore(MedicineStore x) => store = new MedicineStore { ID = x.ID, Name = x.Name, IsActive = x.IsActive, IsBufferStore = x.IsBufferStore };
    private void SelectGeneric(GenericGroup x) => generic = new GenericGroup { ID = x.ID, Name = x.Name, EnteredBy = x.EnteredBy, TransDate = x.TransDate };
    private void SelectType(MedicineType x) => medicineType = new MedicineType { ID = x.ID, Type = x.Type, EnteredBy = x.EnteredBy, TransDate = x.TransDate };
    private void SelectSupplier(SupplierPharmacy x) => supplier = new SupplierPharmacy { ID = x.ID, Name = x.Name, Address = x.Address, Contact = x.Contact, Amount = x.Amount, TransDate = x.TransDate };

    private void ResetMedicine() => medicine = NewMedicine();
    private void ResetStore() => store = NewStore();
    private void ResetGeneric() => generic = new();
    private void ResetType() => medicineType = new();
    private void ResetSupplier() => supplier = new();

    private static Service NewMedicine() => new() { CategoryID = MedicineCategoryId, BuyRate = 0, SaleRate = 0, ReOrderLevel = 0, IsVATApp = false, InvestigationModuleID = 0 };
    private static MedicineStore NewStore() => new() { IsActive = true, IsBufferStore = false };

    private string GenericName(int? id) => genericGroups.FirstOrDefault(x => x.ID == id)?.Name ?? "—";
    private string TypeName(int? id) => medicineTypes.FirstOrDefault(x => x.ID == id)?.Type ?? "—";
    private string SupplierName(int? id) => suppliers.FirstOrDefault(x => x.ID == id)?.Name ?? "—";
    private string StoreName(int id) => stores.FirstOrDefault(x => x.ID == id)?.Name ?? $"Store #{id}";

    private async Task<int> CurrentUserIdAsync()
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        return int.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : 1;
    }

    private void Success(string text) { messageClass = "success"; message = text; }
    private void Fail(string text) { messageClass = "danger"; message = text; }
}
