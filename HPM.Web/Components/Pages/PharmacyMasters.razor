@page "/pharmacy/masters"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.PharmacyOperator)]
@rendermode InteractiveServer
@implements IDisposable
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@using System.Security.Claims
@using HPM.Web.Data.Entities

<PageTitle>@GetPageTitle() | @Branding.HospitalName</PageTitle>

<div class="pharmacy-masters-page" style="padding-bottom: 40px;">
    <!-- Page Header -->
    <div class="page-heading" style="margin-bottom: 16px;">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:12px; width:100%;">
            <div>
                <span class="eyebrow">💊 @I18n.T("Pharmacy & Dispensary", "Pharmacy & Dispensary")</span>
                <h1 style="margin:2px 0 4px; font-size:24px; font-weight:700;">@GetSectionTitle()</h1>
                <p style="margin:0; color:#64748b; font-size:13px;">@I18n.T("Maintain medicines, stores, dosage types, generics and pharma suppliers.", "Maintain medicines, stores, dosage types, generics and pharma suppliers.")</p>
            </div>
            <div style="display:flex; gap:8px;">
                @if (currentSection != "customer")
                {
                    <button type="button" class="btn btn-secondary" @onclick="ResetCurrent">
                        + @I18n.T("New Entry", "New")
                    </button>
                }
                <NavLink href="masters" class="btn btn-ghost">
                    ⚙️ @I18n.T("All Masters", "All Masters")
                </NavLink>
            </div>
        </div>
    </div>

    <!-- Mode Toggle / Section Tabs -->
    <div style="display:flex; flex-wrap:wrap; gap:8px; margin-bottom:18px; padding-bottom:12px; border-bottom:1px solid #e2e8f0; align-items:center;">
        <button type="button" class="btn @(currentSection is "services" or "medicine" ? "btn-primary" : "btn-ghost")" style="font-size:13px; padding:6px 14px; border-radius:20px;" @onclick='() => SwitchSection("services")'>
            💊 @I18n.T("Medicines", "Medicines") <b>(@medicines.Count)</b>
        </button>
        <button type="button" class="btn @(currentSection == "store" ? "btn-primary" : "btn-ghost")" style="font-size:13px; padding:6px 14px; border-radius:20px;" @onclick='() => SwitchSection("store")'>
            🏪 @I18n.T("Stores", "Stores") <b>(@stores.Count)</b>
        </button>
        <button type="button" class="btn @(currentSection == "type" ? "btn-primary" : "btn-ghost")" style="font-size:13px; padding:6px 14px; border-radius:20px;" @onclick='() => SwitchSection("type")'>
            💊 @I18n.T("Dosage Types", "Dosage Types") <b>(@medicineTypes.Count)</b>
        </button>
        <button type="button" class="btn @(currentSection == "generic" ? "btn-primary" : "btn-ghost")" style="font-size:13px; padding:6px 14px; border-radius:20px;" @onclick='() => SwitchSection("generic")'>
            🧬 @I18n.T("Generics", "Generics") <b>(@genericGroups.Count)</b>
        </button>
        <button type="button" class="btn @(currentSection == "supplier" ? "btn-primary" : "btn-ghost")" style="font-size:13px; padding:6px 14px; border-radius:20px;" @onclick='() => SwitchSection("supplier")'>
            🚚 @I18n.T("Suppliers", "Suppliers") <b>(@suppliers.Count)</b>
        </button>
        <button type="button" class="btn @(currentSection == "customer" ? "btn-primary" : "btn-ghost")" style="font-size:13px; padding:6px 14px; border-radius:20px;" @onclick='() => SwitchSection("customer")'>
            🛒 @I18n.T("Customer Returns", "Customer Returns")
        </button>
        <button type="button" class="btn @(currentSection == "all" ? "btn-primary" : "btn-ghost")" style="font-size:13px; padding:6px 14px; border-radius:20px;" @onclick='() => SwitchSection("all")'>
            📑 @I18n.T("All Sections", "All Sections")
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @messageClass" style="margin-bottom:16px;">@message</div>
    }

    @* SECTION 1: MEDICINES & PRICING *@
    @if (currentSection is "services" or "medicine" or "all")
    {
        <div class="panel form-panel" style="margin-bottom:24px;">
            <div class="panel-heading">
                <div>
                    <h2>@(medicine.ID == 0 ? I18n.T("Add Medicine Product", "Add medicine product") : $"{I18n.T("Edit Medicine", "Edit medicine")} #{medicine.ID}")</h2>
                    <p>@I18n.T("Brand names, dosage strengths, pack sizes, purchase cost and counter selling price.", "Brand names, dosage strengths, pack sizes, purchase cost and counter selling price.")</p>
                </div>
                <button class="icon-btn" @onclick="ResetMedicine">@I18n.T("New", "New")</button>
            </div>
            <EditForm Model="medicine" OnSubmit="SaveMedicineAsync">
                <div class="form-grid three">
                    <label class="span-2">
                        <span>@I18n.T("Brand / Medicine Name *", "Brand / medicine name *")</span>
                        <InputText @bind-Value="medicine.Name" placeholder="@I18n.T("e.g. Napa Extra 500mg/65mg, Seclo 20mg", "e.g. Napa Extra 500mg/65mg, Seclo 20mg")" />
                    </label>
                    <label>
                        <span>@I18n.T("Dosage Form / Type *", "Dosage form / type *")</span>
                        <InputSelect @bind-Value="medicine.TypeID">
                            <option value="">@I18n.T("Select Type", "Select")</option>
                            @foreach (var item in medicineTypes)
                            {
                                <option value="@item.ID">@item.Type</option>
                            }
                        </InputSelect>
                    </label>
                    <label>
                        <span>@I18n.T("Generic Name *", "Generic name *")</span>
                        <InputSelect @bind-Value="medicine.GenericID">
                            <option value="">@I18n.T("Select Generic", "Select")</option>
                            @foreach (var item in genericGroups)
                            {
                                <option value="@item.ID">@item.Name</option>
                            }
                        </InputSelect>
                    </label>
                    <label>
                        <span>@I18n.T("Supplier / Manufacturer *", "Supplier / manufacturer *")</span>
                        <InputSelect @bind-Value="medicine.SupplierID">
                            <option value="">@I18n.T("Select Supplier", "Select")</option>
                            @foreach (var item in suppliers)
                            {
                                <option value="@item.ID">@item.Name</option>
                            }
                        </InputSelect>
                    </label>
                    <label>
                        <span>@I18n.T("Re-Order Threshold Level", "Re-order level")</span>
                        <InputNumber @bind-Value="medicine.ReOrderLevel" />
                    </label>
                    <label>
                        <span>@I18n.T("Purchase Rate", "Purchase rate") (@I18n.CurrencySymbol)</span>
                        <InputNumber @bind-Value="medicine.BuyRate" />
                    </label>
                    <label>
                        <span>@I18n.T("Selling Price Rate", "Sale rate") (@I18n.CurrencySymbol)</span>
                        <InputNumber @bind-Value="medicine.SaleRate" />
                    </label>
                    <label>
                        <span>@I18n.T("VAT Applicable?", "VAT applicable?")</span>
                        <InputSelect @bind-Value="medicine.IsVATApp">
                            <option value="">@I18n.T("Not set", "Not set")</option>
                            <option value="true">@I18n.T("Yes", "Yes")</option>
                            <option value="false">@I18n.T("No", "No")</option>
                        </InputSelect>
                    </label>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" type="submit">@(medicine.ID == 0 ? I18n.T("Save Medicine", "Save medicine") : I18n.T("Update Medicine", "Update medicine"))</button>
                    @if (medicine.ID > 0)
                    {
                        <button class="btn btn-ghost" type="button" @onclick="DeleteMedicineAsync">@I18n.T("Delete", "Delete")</button>
                    }
                </div>
            </EditForm>

            <div style="padding:0 20px 14px; display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
                <input style="flex:1; min-width:260px;" @bind="medicineSearch" @bind:event="oninput" @bind:after="OnSearchMedicineChanged" placeholder="@I18n.T("Search medicines by brand name, generic formula, type or supplier...", "Search medicines by brand, generic, type or supplier...")" />
                <span style="font-size:13px; color:#64748b; font-weight:600;">
                    @I18n.T("Showing", "Showing") @(FilteredMedicines.Count == 0 ? 0 : (medicinePage - 1) * PageSize + 1) - @Math.Min(medicinePage * PageSize, FilteredMedicines.Count) @I18n.T("of", "of") @FilteredMedicines.Count
                </span>
            </div>

            <div class="data-table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@I18n.T("Medicine", "Medicine")</th>
                            <th>@I18n.T("Generic / Type", "Generic / Type")</th>
                            <th>@I18n.T("Supplier", "Supplier")</th>
                            <th class="num">@I18n.T("Buy Rate", "Buy")</th>
                            <th class="num">@I18n.T("Sale Price", "Sale")</th>
                            <th class="num">@I18n.T("Re-Order", "Re-order")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (PagedMedicines.Count == 0)
                        {
                            <tr><td colspan="7"><div class="empty-state small">@I18n.T("No medicines match your search.", "No medicines found.")</div></td></tr>
                        }
                        @foreach (var item in PagedMedicines)
                        {
                            <tr>
                                <td><b>@item.Name</b><br /><small class="text-muted">@I18n.T("Item Code", "Service") #@item.ID</small></td>
                                <td>@GenericName(item.GenericID)<br /><small class="text-muted">@TypeName(item.TypeID)</small></td>
                                <td>@SupplierName(item.SupplierID)</td>
                                <td class="num">@I18n.FormatCurrency(item.BuyRate ?? 0)</td>
                                <td class="num"><b>@I18n.FormatCurrency(item.SaleRate ?? 0)</b></td>
                                <td class="num">@(item.ReOrderLevel ?? 0)</td>
                                <td><button class="icon-btn" @onclick="() => SelectMedicine(item)">@I18n.T("Edit", "Edit")</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Pagination Bar *@
            @if (TotalMedicinePages > 1)
            {
                <div style="display:flex; justify-content:space-between; align-items:center; padding:12px 20px; border-top:1px solid #e2e8f0; background:#f8fafc;">
                    <button class="btn btn-ghost" type="button" disabled="@(medicinePage <= 1)" @onclick="() => medicinePage--">
                        ← @I18n.T("Previous", "Previous")
                    </button>
                    <span style="font-size:13px; color:#475569; font-weight:600;">
                        @I18n.T("Page", "Page") @medicinePage @I18n.T("of", "of") @TotalMedicinePages
                    </span>
                    <button class="btn btn-ghost" type="button" disabled="@(medicinePage >= TotalMedicinePages)" @onclick="() => medicinePage++">
                        @I18n.T("Next", "Next") →
                    </button>
                </div>
            }
        </div>
    }

    @* SECTION 2: MEDICINE STORES & SUB-STORES *@
    @if (currentSection is "store" or "all")
    {
        <div class="panel form-panel" style="margin-bottom:24px;">
            <div class="panel-heading">
                <div>
                    <h2>@(store.ID == 0 ? I18n.T("Add Medicine Store", "Add Medicine Store") : $"{I18n.T("Edit Store", "Edit Store")} #{store.ID}")</h2>
                    <p>@I18n.T("Configure pharmacy dispensaries, inpatient ward sub-stores, emergency racks and central buffer storage.", "Configure pharmacy dispensaries, inpatient ward sub-stores, emergency racks and central buffer storage.")</p>
                </div>
                <button class="icon-btn" @onclick="ResetStore">@I18n.T("New", "New")</button>
            </div>
            <EditForm Model="store" OnSubmit="SaveStoreAsync">
                <div class="form-grid three">
                    <label class="span-2">
                        <span>@I18n.T("Store Name *", "Store Name *")</span>
                        <InputText @bind-Value="store.Name" placeholder="@I18n.T("e.g. Main Dispensary, IPD Ward Store, Emergency Rack, Buffer Warehouse", "e.g. Main Dispensary, IPD Ward Store, Emergency Rack, Buffer Warehouse")" maxlength="50" />
                    </label>
                    <div style="display:flex; flex-direction:column; gap:8px; justify-content:center;">
                        <label style="display:inline-flex; align-items:center; gap:8px; margin:0; cursor:pointer;">
                            <InputCheckbox @bind-Value="store.IsActive" />
                            <span><b>@I18n.T("Active Store", "Active Store")</b> (@I18n.T("Available for dispensing and transfers", "Available for dispensing and transfers"))</span>
                        </label>
                        <label style="display:inline-flex; align-items:center; gap:8px; margin:0; cursor:pointer;">
                            <InputCheckbox @bind-Value="store.IsBufferStore" />
                            <span><b>@I18n.T("Central / Buffer Store", "Central / Buffer Store")</b> (@I18n.T("Primary receiving warehouse", "Primary receiving warehouse"))</span>
                        </label>
                    </div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" type="submit">@(store.ID == 0 ? I18n.T("Save Store", "Save Store") : I18n.T("Update Store", "Update Store"))</button>
                    @if (store.ID > 0)
                    {
                        <button class="btn btn-ghost" type="button" @onclick="DeleteStoreAsync">@I18n.T("Delete", "Delete")</button>
                    }
                </div>
            </EditForm>
            <div style="padding:0 20px 14px;">
                <input @bind="storeSearch" @bind:event="oninput" placeholder="@I18n.T("Search stores by name...", "Search stores by name...")" />
            </div>
            <div class="data-table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@I18n.T("Store Name", "Store Name")</th>
                            <th>@I18n.T("Store Type", "Store Type")</th>
                            <th>@I18n.T("Active Status", "Active Status")</th>
                            <th class="num">@I18n.T("Stock Item Lines", "Stock Item Lines")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredStores.Count == 0)
                        {
                            <tr><td colspan="5"><div class="empty-state small">@I18n.T("No stores configured.", "No stores configured.")</div></td></tr>
                        }
                        @foreach (var item in FilteredStores)
                        {
                            <tr>
                                <td>
                                    <b>@item.Name</b><br />
                                    <small class="text-muted">@I18n.T("Store ID", "Store ID") #@item.ID</small>
                                </td>
                                <td>
                                    @if (item.IsBufferStore)
                                    {
                                        <span class="badge" style="background:#e0f2fe; color:#0369a1; font-weight:600; padding:4px 8px; border-radius:4px;">🏢 @I18n.T("Central Warehouse / Buffer", "Central Warehouse / Buffer")</span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background:#f1f5f9; color:#475569; font-weight:600; padding:4px 8px; border-radius:4px;">🏪 @I18n.T("Dispensary / Sub-Store", "Dispensary / Sub-Store")</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge" style="background:#dcfce7; color:#15803d; font-weight:600; padding:4px 8px; border-radius:4px;">🟢 @I18n.T("Active", "Active")</span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background:#fee2e2; color:#b91c1c; font-weight:600; padding:4px 8px; border-radius:4px;">🔴 @I18n.T("Inactive", "Inactive")</span>
                                    }
                                </td>
                                <td class="num">
                                    <b>@(storeBalanceCounts.GetValueOrDefault(item.ID, 0))</b> @I18n.T("Batches", "Batches")
                                </td>
                                <td>
                                    <button class="icon-btn" @onclick="() => SelectStore(item)">@I18n.T("Edit", "Edit")</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* SECTION 3 & 4: GENERICS & DOSAGE TYPES *@
    @if (currentSection is "generic" or "type" or "all")
    {
        <div class="master-layout" style="margin-bottom:24px;">
            @if (currentSection is "generic" or "all")
            {
                <div>
                    <div class="panel form-panel">
                        <div class="panel-heading">
                            <div>
                                <h2>@(generic.ID == 0 ? I18n.T("Add Generic Group", "Add generic") : $"{I18n.T("Edit Generic", "Edit generic")} #{generic.ID}")</h2>
                                <p>@I18n.T("Chemical molecules and therapeutic drug categories.", "Generic drug names and therapeutic categories.")</p>
                            </div>
                            <button class="icon-btn" @onclick="ResetGeneric">@I18n.T("New", "New")</button>
                        </div>
                        <EditForm Model="generic" OnSubmit="SaveGenericAsync">
                            <div class="form-grid">
                                <label class="span-2">
                                    <span>@I18n.T("Generic Chemical Name *", "Generic name *")</span>
                                    <InputText @bind-Value="generic.Name" placeholder="@I18n.T("e.g. Paracetamol, Omeprazole, Ciprofloxacin", "e.g. Paracetamol, Omeprazole, Ciprofloxacin")" />
                                </label>
                            </div>
                            <div class="form-actions">
                                <button class="btn btn-primary">@I18n.T("Save Generic", "Save generic")</button>
                                @if (generic.ID > 0)
                                {
                                    <button type="button" class="btn btn-ghost" @onclick="DeleteGenericAsync">@I18n.T("Delete", "Delete")</button>
                                }
                            </div>
                        </EditForm>
                        <div style="padding:0 20px 10px;">
                            <input @bind="genericSearch" @bind:event="oninput" placeholder="@I18n.T("Search generic names...", "Search generic names...")" />
                        </div>
                        <div class="data-table-wrap">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>@I18n.T("Generic Name", "Generic name")</th>
                                        <th class="num">@I18n.T("Medicines", "Medicines")</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (FilteredGenerics.Count == 0)
                                    {
                                        <tr><td colspan="3"><div class="empty-state small">@I18n.T("No generics found.", "No generics found.")</div></td></tr>
                                    }
                                    @foreach (var item in FilteredGenerics)
                                    {
                                        <tr>
                                            <td><b>@item.Name</b></td>
                                            <td class="num">@(medicines.Count(m => m.GenericID == item.ID))</td>
                                            <td><button class="icon-btn" @onclick="() => SelectGeneric(item)">@I18n.T("Edit", "Edit")</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            @if (currentSection is "type" or "all")
            {
                <div>
                    <div class="panel form-panel">
                        <div class="panel-heading">
                            <div>
                                <h2>@(medicineType.ID == 0 ? I18n.T("Add Dosage Form / Type", "Add dosage form") : $"{I18n.T("Edit Type", "Edit type")} #{medicineType.ID}")</h2>
                                <p>@I18n.T("Pharmaceutical forms: Tablet, Syrup, Capsule, Injection, Eye Drop, IV Infusion.", "Dosage forms (Tablet, Syrup, Injection, etc.).")</p>
                            </div>
                            <button class="icon-btn" @onclick="ResetType">@I18n.T("New", "New")</button>
                        </div>
                        <EditForm Model="medicineType" OnSubmit="SaveTypeAsync">
                            <div class="form-grid">
                                <label class="span-2">
                                    <span>@I18n.T("Type / Dosage Form *", "Type / dosage form *")</span>
                                    <InputText @bind-Value="medicineType.Type" placeholder="@I18n.T("Tablet, capsule, syrup, injection...", "Tablet, capsule, syrup...")" />
                                </label>
                            </div>
                            <div class="form-actions">
                                <button class="btn btn-primary">@I18n.T("Save Type", "Save type")</button>
                                @if (medicineType.ID > 0)
                                {
                                    <button type="button" class="btn btn-ghost" @onclick="DeleteTypeAsync">@I18n.T("Delete", "Delete")</button>
                                }
                            </div>
                        </EditForm>
                        <div style="padding:0 20px 10px;">
                            <input @bind="typeSearch" @bind:event="oninput" placeholder="@I18n.T("Search dosage types...", "Search dosage types...")" />
                        </div>
                        <div class="data-table-wrap">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>@I18n.T("Dosage Form", "Dosage form")</th>
                                        <th class="num">@I18n.T("Medicines", "Medicines")</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (FilteredTypes.Count == 0)
                                    {
                                        <tr><td colspan="3"><div class="empty-state small">@I18n.T("No dosage types found.", "No dosage types found.")</div></td></tr>
                                    }
                                    @foreach (var item in FilteredTypes)
                                    {
                                        <tr>
                                            <td><b>@item.Type</b></td>
                                            <td class="num">@(medicines.Count(m => m.TypeID == item.ID))</td>
                                            <td><button class="icon-btn" @onclick="() => SelectType(item)">@I18n.T("Edit", "Edit")</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @* SECTION 5: PHARMACEUTICAL SUPPLIERS *@
    @if (currentSection is "supplier" or "all")
    {
        <div class="panel form-panel" style="margin-bottom:24px;">
            <div class="panel-heading">
                <div>
                    <h2>@(supplier.ID == 0 ? I18n.T("Add Medicine Supplier", "Add supplier") : $"{I18n.T("Edit Supplier", "Edit supplier")} #{supplier.ID}")</h2>
                    <p>@I18n.T("Pharmaceutical manufacturers, registered distributors, contacts and initial opening balances.", "Add and manage registered medicine pharmaceutical suppliers.")</p>
                </div>
                <button class="icon-btn" @onclick="ResetSupplier">@I18n.T("New", "New")</button>
            </div>
            <EditForm Model="supplier" OnSubmit="SaveSupplierAsync">
                <div class="form-grid">
                    <label class="span-2">
                        <span>@I18n.T("Supplier / Manufacturer Name *", "Supplier / manufacturer name *")</span>
                        <InputText @bind-Value="supplier.Name" placeholder="@I18n.T("e.g. Square Pharmaceuticals PLC, Beximco, Incepta", "e.g. Square Pharmaceuticals PLC, Beximco, Incepta")" />
                    </label>
                    <label class="span-2">
                        <span>@I18n.T("Corporate / Depot Address", "Address")</span>
                        <InputTextArea @bind-Value="supplier.Address" rows="2" />
                    </label>
                    <label>
                        <span>@I18n.T("Representative Contact / Phone", "Contact")</span>
                        <InputText @bind-Value="supplier.Contact" placeholder="@I18n.T("e.g. 01700-000000", "e.g. 01700-000000")" />
                    </label>
                    <label>
                        <span>@I18n.T("Opening Balance Amount", "Opening amount") (@I18n.CurrencySymbol)</span>
                        <InputNumber @bind-Value="supplier.Amount" />
                    </label>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary">@I18n.T("Save Supplier", "Save supplier")</button>
                    @if (supplier.ID > 0)
                    {
                        <button type="button" class="btn btn-ghost" @onclick="DeleteSupplierAsync">@I18n.T("Delete", "Delete")</button>
                    }
                </div>
            </EditForm>
            <div style="padding:0 20px 14px;">
                <input @bind="supplierSearch" @bind:event="oninput" placeholder="@I18n.T("Search suppliers by name, address or contact...", "Search suppliers by name, address or contact...")" />
            </div>
            <div class="data-table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@I18n.T("Supplier / Manufacturer", "Supplier")</th>
                            <th>@I18n.T("Contact & Address", "Contact")</th>
