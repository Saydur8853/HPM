@page "/pharmacy/masters"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.PharmacyOperator)]
@implements IDisposable
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@using System.Security.Claims
@using HPM.Web.Data.Entities
@using HPM.Web.Components.Common

<PageTitle>@GetPageTitle() | @Branding.HospitalName</PageTitle>

<style>
    .pm-filter { padding: 12px 18px; background: #f8fafc; border-top: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0; display: flex; flex-direction: column; gap: 10px; }
    .pm-filter-row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .pm-search { position: relative; flex: 1 1 260px; min-width: 220px; display: flex; align-items: center; }
    .pm-search svg { position: absolute; left: 10px; color: #94a3b8; pointer-events: none; }
    .pm-search input { width: 100%; height: 36px; padding: 0 30px 0 32px; border: 1px solid #cbd5e1; border-radius: 8px; background: #fff; font-size: 13px; }
    .pm-search input:focus { border-color: #0284c7; box-shadow: 0 0 0 3px rgba(2,132,199,.12); outline: none; }
    .pm-search-clear { position: absolute; right: 8px; border: none; background: transparent; color: #94a3b8; cursor: pointer; font-size: 12px; }
    .pm-select { height: 36px; width: 150px; border: 1px solid #cbd5e1; border-radius: 8px; background: #fff; font-size: 12.5px; padding: 0 8px; }
    .pm-select-wide { width: 190px; }
    .pm-select-narrow { width: 105px; }
    .pm-seg { display: inline-flex; background: #fff; border: 1px solid #cbd5e1; border-radius: 9px; padding: 3px; gap: 2px; }
    .pm-seg button { border: none; background: transparent; padding: 5px 11px; border-radius: 6px; font-size: 12px; font-weight: 600; color: #475569; cursor: pointer; display: inline-flex; gap: 6px; align-items: center; }
    .pm-seg button span { font-size: 11px; font-weight: 700; background: #f1f5f9; color: #475569; padding: 1px 7px; border-radius: 10px; }
    .pm-seg button:hover { background: #f1f5f9; }
    .pm-seg button.active { background: #0f172a; color: #fff; }
    .pm-seg button.active span { background: rgba(255,255,255,.18); color: #fff; }
    .pm-seg button.seg-in.active { background: #047857; }
    .pm-seg button.seg-low.active { background: #b45309; }
    .pm-seg button.seg-out.active { background: #b91c1c; }
    .pm-clear { border: none; background: transparent; color: #0284c7; font-size: 12px; font-weight: 700; cursor: pointer; padding: 4px 6px; }
    .pm-actions { margin-left: auto; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .pm-count { font-size: 12px; color: #475569; white-space: nowrap; }
    .pm-filter-note { font-size: 11.5px; color: #0369a1; background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 6px; padding: 5px 10px; }
    @@media (max-width: 760px) {
        .pm-select, .pm-select-wide, .pm-select-narrow { flex: 1 1 140px; width: auto; }
        .pm-actions { margin-left: 0; width: 100%; justify-content: space-between; }
        .pm-seg { flex-wrap: wrap; }
    }
</style>

<div class="pharmacy-masters-page" style="padding-bottom: 32px;">
    <div class="pharm-subnav-bar">
        <div>
            <h1 style="margin:0; font-size:20px; font-weight:800; color:#0f172a;">@I18n.T("Medicine List & Setup")</h1>
        </div>

        <div class="pharm-tab-pills">
            <button type="button" class="pharm-tab-pill @(currentSection is "services" or "medicine" ? "active" : "")" @onclick='() => SwitchSectionAsync("services")'>
                @I18n.T("Medicines") <span>(@totalMedicinesTabCount)</span>
            </button>
            <button type="button" class="pharm-tab-pill @(currentSection == "generic" ? "active" : "")" @onclick='() => SwitchSectionAsync("generic")'>
                @I18n.T("Generics") <span>(@totalGenericsTabCount)</span>
            </button>
            <button type="button" class="pharm-tab-pill @(currentSection == "type" ? "active" : "")" @onclick='() => SwitchSectionAsync("type")'>
                @I18n.T("Types") <span>(@totalTypesTabCount)</span>
            </button>
            <button type="button" class="pharm-tab-pill @(currentSection == "supplier" ? "active" : "")" @onclick='() => SwitchSectionAsync("supplier")'>
                @I18n.T("Suppliers") <span>(@totalSuppliersTabCount)</span>
            </button>
            <button type="button" class="pharm-tab-pill @(currentSection == "store" ? "active" : "")" @onclick='() => SwitchSectionAsync("store")'>
                @I18n.T("Stores") <span>(@totalStoresTabCount)</span>
            </button>
        </div>

        <div style="display:flex; gap:6px; align-items:center; flex-wrap:wrap;">
            @if (currentSection is "services" or "medicine")
            {
                <BulkUploadWidget TypeKey="medicine" ShowExport="false" OnImported="ReloadAfterImportAsync" />
            }
            <NavLink href="/pharmacy/pos" class="btn btn-ghost btn-sm">
                @I18n.T("Go to POS") &rarr;
            </NavLink>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @messageClass" style="margin-bottom:12px; padding:8px 12px; font-size:13px; display:flex; justify-content:space-between; align-items:center;">
            <span>@message</span>
            <button type="button" style="border:none; background:transparent; cursor:pointer; font-size:12px;" @onclick='() => message = ""'>✕</button>
        </div>
    }

    @* ===================== 1. MEDICINES & SKU SETUP ===================== *@
    @if (currentSection is "services" or "medicine")
    {
        <div class="panel form-panel" style="margin-bottom:18px;">
            <div class="panel-heading" style="padding:12px 18px;">
                <div style="display:flex; align-items:center; gap:8px;">
                    <h2 style="font-size:15px; margin:0;">
                        @(medicine.ID == 0 ? I18n.T("Add New Medicine") : $"{I18n.T("Edit Medicine")} ({medicine.Sku ?? $"#{medicine.ID}"})")
                    </h2>
                    @if (medicine.ID > 0)
                    {
                        <span class="pill pill-warning" style="font-size:10px;">@I18n.T("EDIT MODE")</span>
                    }
                </div>
                @if (medicine.ID > 0)
                {
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="ResetMedicine">@I18n.T("Cancel Edit / New")</button>
                }
            </div>

            @if (!string.IsNullOrEmpty(quickAddKind))
            {
                <div style="margin:0 18px 12px; padding:10px 12px; background:#f0f9ff; border:1px solid #bae6fd; border-radius:8px; display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                    <strong style="font-size:12px; color:#0369a1;">
                        @(quickAddKind == "generic" ? I18n.T("New Generic:") : quickAddKind == "type" ? I18n.T("New Dosage Type:") : I18n.T("New Supplier:"))
                    </strong>
                    <input type="text" style="flex:1; min-width:180px; height:32px;" @bind="quickAddValue" placeholder="@I18n.T("Enter name...")" />
                    <button type="button" class="btn btn-primary btn-sm" @onclick="SaveQuickAddAsync">@I18n.T("Save & Select")</button>
                    <button type="button" class="btn btn-ghost btn-sm" @onclick='() => { quickAddKind = ""; quickAddValue = ""; }'>@I18n.T("Cancel")</button>
                </div>
            }

            <EditForm Model="medicine" OnSubmit="SaveMedicineAsync">
                <div class="form-grid" style="grid-template-columns: 1.1fr 2fr 1.1fr; gap:10px 12px; padding-top:4px;">
                    <label>
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <span>@I18n.T("SKU / Barcode")</span>
                            <button type="button" style="border:none; background:transparent; color:#0284c7; font-size:11px; font-weight:700; cursor:pointer; padding:0;" @onclick="GenerateAutoSku">@I18n.T("Auto Generate")</button>
                        </div>
                        <InputText @bind-Value="medicine.Sku" maxlength="50" placeholder="@I18n.T("Auto (e.g. MED-00101) or scan barcode")" />
                    </label>

                    <label>
                        <span>@I18n.T("Brand / Medicine Name") *</span>
                        <InputText @bind-Value="medicine.Name" maxlength="200" placeholder="@I18n.T("e.g. Napa Extra 500mg, Seclo 20mg")" />
                    </label>

                    <label>
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <span>@I18n.T("Dosage Type") *</span>
                            <button type="button" style="border:none; background:transparent; color:#0284c7; font-size:11px; font-weight:700; cursor:pointer; padding:0;" @onclick='() => OpenQuickAdd("type")'>+ @I18n.T("Add")</button>
                        </div>
                        <InputSelect @bind-Value="medicine.TypeID">
                            <option value="">@I18n.T("Select Type")</option>
                            @foreach (var item in lookupTypes)
                            {
                                <option value="@item.ID">@item.Type</option>
                            }
                        </InputSelect>
                    </label>
                </div>

                <div class="form-grid" style="grid-template-columns: 1.4fr 1.4fr 0.8fr 0.8fr 0.8fr 0.6fr; gap:10px 12px; padding-top:6px;">
                    @* Searchable Generic Combobox *@
                    <div class="pos-typeahead-wrapper">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
                            <span style="font-size:12px; font-weight:600; color:#334155;">@I18n.T("Generic Name") *</span>
                            <button type="button" style="border:none; background:transparent; color:#0284c7; font-size:11px; font-weight:700; cursor:pointer; padding:0;" @onclick='() => OpenQuickAdd("generic")'>+ @I18n.T("Add")</button>
                        </div>
                        <div style="position:relative;">
                            <input type="text"
                                   placeholder="@I18n.T("Search generic...")"
                                   @bind="genericComboText"
                                   @bind:event="oninput"
                                   @onfocus="() => showGenericCombo = true"
                                   autocomplete="off" />
                            @if (medicine.GenericID > 0 || !string.IsNullOrEmpty(genericComboText))
                            {
                                <button type="button" style="position:absolute; right:6px; top:50%; transform:translateY(-50%); border:none; background:transparent; color:#94a3b8; font-size:11px; cursor:pointer;" @onclick="ClearGenericSelection">✕</button>
                            }
                        </div>
                        @if (showGenericCombo)
                        {
                            <div class="pos-med-dropdown" style="z-index:140; max-height:200px;">
                                @foreach (var g in FilteredComboGenerics)
                                {
                                    <div class="pos-med-item" @onmousedown:preventDefault @onclick="() => PickGeneric(g)">
                                        <span class="pos-med-name">@g.Name</span>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(genericComboText) && !lookupGenerics.Any(x => string.Equals(x.Name, genericComboText.Trim(), StringComparison.OrdinalIgnoreCase)))
                                {
                                    <div class="pos-med-item" style="background:#f0f9ff; color:#0369a1; font-weight:700;" @onmousedown:preventDefault @onclick="CreateGenericInlineAsync">
                                        + @I18n.T("Create") "@genericComboText.Trim()"
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    @* Searchable Supplier Combobox *@
                    <div class="pos-typeahead-wrapper">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
                            <span style="font-size:12px; font-weight:600; color:#334155;">@I18n.T("Company / Supplier") *</span>
                            <button type="button" style="border:none; background:transparent; color:#0284c7; font-size:11px; font-weight:700; cursor:pointer; padding:0;" @onclick='() => OpenQuickAdd("supplier")'>+ @I18n.T("Add")</button>
                        </div>
                        <div style="position:relative;">
                            <input type="text"
                                   placeholder="@I18n.T("Search company...")"
                                   @bind="supplierComboText"
                                   @bind:event="oninput"
                                   @onfocus="() => showSupplierCombo = true"
                                   autocomplete="off" />
                            @if (medicine.SupplierID > 0 || !string.IsNullOrEmpty(supplierComboText))
                            {
                                <button type="button" style="position:absolute; right:6px; top:50%; transform:translateY(-50%); border:none; background:transparent; color:#94a3b8; font-size:11px; cursor:pointer;" @onclick="ClearSupplierSelection">✕</button>
                            }
                        </div>
                        @if (showSupplierCombo)
                        {
                            <div class="pos-med-dropdown" style="z-index:140; max-height:200px;">
                                @foreach (var s in FilteredComboSuppliers)
                                {
                                    <div class="pos-med-item" @onmousedown:preventDefault @onclick="() => PickSupplier(s)">
                                        <span class="pos-med-name">@s.Name</span>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(supplierComboText) && !lookupSuppliers.Any(x => string.Equals(x.Name, supplierComboText.Trim(), StringComparison.OrdinalIgnoreCase)))
                                {
                                    <div class="pos-med-item" style="background:#f0f9ff; color:#0369a1; font-weight:700;" @onmousedown:preventDefault @onclick="CreateSupplierInlineAsync">
                                        + @I18n.T("Create") "@supplierComboText.Trim()"
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <label>
                        <span>@I18n.T("Buy (TP)") (@I18n.CurrencySymbol)</span>
                        <InputNumber @bind-Value="medicine.BuyRate" />
                    </label>

                    <label>
                        <span>@I18n.T("Sale (MRP)") (@I18n.CurrencySymbol)</span>
                        <InputNumber @bind-Value="medicine.SaleRate" />
                    </label>

                    <label>
                        <span>@I18n.T("Low Alert Qty")</span>
                        <InputNumber @bind-Value="medicine.ReOrderLevel" />
                    </label>

                    <label>
                        <span>@I18n.T("VAT")</span>
                        <InputSelect @bind-Value="medicine.IsVATApp">
                            <option value="false">@I18n.T("No")</option>
                            <option value="true">@I18n.T("Yes")</option>
                        </InputSelect>
                    </label>
                </div>

                <div class="form-actions">
                    <button class="btn btn-primary" type="submit" disabled="@isBusy">
                        @(medicine.ID == 0 ? I18n.T("Save Medicine") : I18n.T("Update Medicine"))
                    </button>
                    @if (medicine.ID > 0)
                    {
                        <button class="btn btn-danger" type="button" disabled="@isBusy" @onclick="() => DeleteMedicineByIdAsync(medicine.ID, medicine.Name)">@I18n.T("Delete")</button>
                        <button class="btn btn-ghost" type="button" @onclick="ResetMedicine">@I18n.T("Reset")</button>
                    }
                </div>
            </EditForm>

            @* Server-Side Filter, Stock Segments, Export & Print (all follow the active filter) *@
            <div class="pm-filter">
                <div class="pm-filter-row">
                    <div class="pm-search">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.5" y2="16.5"></line></svg>
                        <input placeholder="@I18n.T("Search by SKU, brand name, generic or company...")"
                               @bind="medicineSearch"
                               @bind:event="oninput"
                               @bind:after="OnMedicineFilterChangedAsync" />
                        @if (!string.IsNullOrEmpty(medicineSearch))
                        {
                            <button type="button" class="pm-search-clear" @onclick="ClearSearchAsync" aria-label="Clear">✕</button>
                        }
                    </div>

                    <select class="pm-select" @bind="filterTypeId" @bind:after="OnMedicineFilterChangedAsync" title="@I18n.T("Dosage Type")">
                        <option value="0">@I18n.T("All Types")</option>
                        @foreach (var t in lookupTypes)
                        {
                            <option value="@t.ID">@t.Type</option>
                        }
                    </select>

                    <select class="pm-select pm-select-wide" @bind="filterSupplierId" @bind:after="OnMedicineFilterChangedAsync" title="@I18n.T("Company / Supplier")">
                        <option value="0">@I18n.T("All Suppliers")</option>
                        @foreach (var s in lookupSuppliers)
                        {
                            <option value="@s.ID">@s.Name</option>
                        }
                    </select>

                    <select class="pm-select" @bind="sortBy" @bind:after="OnMedicineFilterChangedAsync" title="@I18n.T("Sort")">
                        <option value="name">@I18n.T("Sort: Name A–Z")</option>
                        <option value="sku">@I18n.T("Sort: SKU")</option>
                        <option value="stock_asc">@I18n.T("Sort: Stock low → high")</option>
                        <option value="stock_desc">@I18n.T("Sort: Stock high → low")</option>
                        <option value="mrp_desc">@I18n.T("Sort: MRP high → low")</option>
                    </select>

                    <select class="pm-select pm-select-narrow" @bind="pageSize" @bind:after="OnPageSizeChangedAsync" title="Rows per page">
                        <option value="25">25 / page</option>
                        <option value="50">50 / page</option>
                        <option value="100">100 / page</option>
                    </select>
                </div>

                <div class="pm-filter-row pm-filter-row-2">
                    <div class="pm-seg" role="group" aria-label="Stock filter">
                        <button type="button" class="@(filterStock == "all" ? "active" : "")" @onclick='() => SetStockFilterAsync("all")'>@I18n.T("All") <span>@stockCountAll</span></button>
                        <button type="button" class="seg-in @(filterStock == "in" ? "active" : "")" @onclick='() => SetStockFilterAsync("in")'>@I18n.T("In Stock") <span>@stockCountIn</span></button>
                        <button type="button" class="seg-low @(filterStock == "low" ? "active" : "")" @onclick='() => SetStockFilterAsync("low")'>@I18n.T("Low Stock") <span>@stockCountLow</span></button>
                        <button type="button" class="seg-out @(filterStock == "out" ? "active" : "")" @onclick='() => SetStockFilterAsync("out")'>@I18n.T("Out of Stock") <span>@stockCountOut</span></button>
                    </div>

                    @if (HasActiveMedicineFilter)
                    {
                        <button type="button" class="pm-clear" @onclick="ClearMedicineFiltersAsync">@I18n.T("Clear filters")</button>
                    }

                    <div class="pm-actions">
                        <span class="pm-count">
                            @(medicineTotalFiltered == 0 ? "0" : $"{(medicinePage - 1) * pageSize + 1}–{Math.Min(medicinePage * pageSize, medicineTotalFiltered)}") @I18n.T("of") <b>@medicineTotalFiltered</b>
                        </span>
                        <button type="button" class="btn btn-secondary btn-sm" disabled="@(isExporting || medicineTotalFiltered == 0)" @onclick="ExportFilteredAsync"
                                title="@(HasActiveMedicineFilter ? I18n.T("Export the filtered medicines to Excel") : I18n.T("Export all medicines to Excel"))">
                            @(isExporting ? I18n.T("Exporting...") : $"{I18n.T("Export Excel")} ({medicineTotalFiltered})")
                        </button>
                        <button type="button" class="btn btn-secondary btn-sm" disabled="@(isPrinting || medicineTotalFiltered == 0)" @onclick="PrintFilteredAsync"
                                title="@(HasActiveMedicineFilter ? I18n.T("Print the filtered medicines on A4") : I18n.T("Print all medicines on A4"))">
                            @(isPrinting ? I18n.T("Preparing...") : $"{I18n.T("Print A4")} ({medicineTotalFiltered})")
                        </button>
                    </div>
                </div>

                @if (HasActiveMedicineFilter)
                {
                    <div class="pm-filter-note">@I18n.T("Export and Print will include only"): <b>@FilterSummary</b></div>
                }
            </div>

            <div class="data-table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th style="width:120px;">@I18n.T("SKU")</th>
                            <th>@I18n.T("Medicine")</th>
                            <th>@I18n.T("Generic / Type")</th>
                            <th>@I18n.T("Company")</th>
                            <th class="num">@I18n.T("Stock")</th>
                            <th class="num">@I18n.T("Buy (TP)")</th>
                            <th class="num">@I18n.T("Sale (MRP)")</th>
                            <th class="num">@I18n.T("Alert")</th>
                            <th style="text-align:right; width:125px;">@I18n.T("Actions")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (pagedMedicineRows.Count == 0)
                        {
                            <tr><td colspan="9"><div class="empty-state small">@I18n.T("No medicines match the current filter.")</div></td></tr>
                        }
                        @foreach (var row in pagedMedicineRows)
                        {
                            var isEditing = medicine.ID == row.ID;
                            <tr style="@(isEditing ? "background:#f0f9ff;" : "")">
                                <td>
                                    <span style="font-family:monospace; font-size:11.5px; font-weight:700; color:#0369a1; background:#f1f5f9; padding:2px 6px; border-radius:4px; border:1px solid #cbd5e1;">
                                        @(string.IsNullOrWhiteSpace(row.Sku) ? $"MED-{row.ID:D5}" : row.Sku)
                                    </span>
                                </td>
                                <td><b>@row.Name</b></td>
                                <td>@row.GenericName <small class="text-muted">(@row.TypeName)</small></td>
                                <td>@row.SupplierName</td>
                                <td class="num"><span style="font-weight:700; color:@(row.LiveStock > 0 ? "#047857" : "#94a3b8");">@row.LiveStock.ToString("N0")</span></td>
                                <td class="num">@I18n.FormatCurrency(row.BuyRate)</td>
                                <td class="num"><b>@I18n.FormatCurrency(row.SaleRate)</b></td>
                                <td class="num">@row.ReOrderLevel</td>
                                <td style="text-align:right; white-space:nowrap;">
                                    <button class="icon-btn" type="button" @onclick="() => EditMedicineRowAsync(row.ID)">@I18n.T("Edit")</button>
                                    <button class="icon-btn" type="button" style="color:#dc2626;" @onclick="() => DeleteMedicineByIdAsync(row.ID, row.Name)">@I18n.T("Delete")</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @RenderPaginationBar(medicinePage, TotalPages(medicineTotalFiltered), ChangeMedicinePageAsync)
        </div>
    }

    @* ===================== 2. GENERICS ===================== *@
    @if (currentSection == "generic")
    {
        <div class="panel form-panel">
            <div class="panel-heading" style="padding:12px 18px;">
                <h2 style="font-size:15px; margin:0;">@(generic.ID == 0 ? I18n.T("Add Generic Name") : $"{I18n.T("Edit Generic")} #{generic.ID}")</h2>
                @if (generic.ID > 0)
                {
                    <button class="btn btn-secondary btn-sm" @onclick="ResetGeneric">@I18n.T("Cancel Edit / New")</button>
                }
            </div>
            <EditForm Model="generic" OnSubmit="SaveGenericAsync">
                <div class="form-grid" style="grid-template-columns: minmax(220px, 1fr) auto; align-items:end;">
                    <label>
                        <span>@I18n.T("Generic Name") *</span>
                        <InputText @bind-Value="generic.Name" maxlength="200" placeholder="@I18n.T("e.g. Paracetamol, Omeprazole, Cefixime")" />
                    </label>
                    <div style="display:flex; gap:6px;">
                        <button class="btn btn-primary" type="submit" disabled="@isBusy">@(generic.ID == 0 ? I18n.T("Save") : I18n.T("Update"))</button>
                        @if (generic.ID > 0)
                        {
                            <button type="button" class="btn btn-danger" disabled="@isBusy" @onclick="() => DeleteGenericByIdAsync(generic.ID, generic.Name)">@I18n.T("Delete")</button>
                        }
                    </div>
                </div>
            </EditForm>
            <div style="padding:10px 18px; background:#f8fafc; border-top:1px solid #e2e8f0; border-bottom:1px solid #e2e8f0; display:flex; gap:10px; align-items:center;">
