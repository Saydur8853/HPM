        _ => LoadMedicinesPageAsync()
    };

    /// <summary>Server-side medicine query with search, type and supplier filters (stock filter applied separately).</summary>
    private IQueryable<MedQueryRow> BuildMedicineBaseQuery(HpmDbContext db)
    {
        var today = DateTime.Today;
        var q = from s in db.Services.AsNoTracking()
                where s.CategoryID == MedicineCategoryId
                join g in db.GenericGroups.AsNoTracking() on s.GenericID equals g.ID into gj
                from g in gj.DefaultIfEmpty()
                join t in db.MedicineTypes.AsNoTracking() on s.TypeID equals t.ID into tj
                from t in tj.DefaultIfEmpty()
                join sup in db.PharmacySuppliers.AsNoTracking() on s.SupplierID equals sup.ID into supj
                from sup in supj.DefaultIfEmpty()
                select new MedQueryRow
                {
                    ID = s.ID,
                    Sku = s.Sku,
                    Name = s.Name,
                    TypeID = s.TypeID,
                    GenericID = s.GenericID,
                    SupplierID = s.SupplierID,
                    BuyRate = s.BuyRate ?? 0m,
                    SaleRate = s.SaleRate ?? 0m,
                    ReOrderLevel = s.ReOrderLevel ?? 0,
                    IsVat = s.IsVATApp ?? false,
                    GenericName = g != null && g.Name != null ? g.Name : "—",
                    TypeName = t != null && t.Type != null ? t.Type : "—",
                    SupplierName = sup != null && sup.Name != null ? sup.Name : "—",
                    LiveStock = db.MedicineStoreBalances
                        .Where(b => b.ServiceID == s.ID && b.Balance > 0 && (b.ExpireDate == null || b.ExpireDate >= today))
                        .Sum(b => (decimal?)b.Balance) ?? 0m
                };

        var typeId = filterTypeId;
        var supplierId = filterSupplierId;
        if (typeId > 0) q = q.Where(x => x.TypeID == typeId);
        if (supplierId > 0) q = q.Where(x => x.SupplierID == supplierId);
        if (!string.IsNullOrWhiteSpace(medicineSearch))
        {
            var term = medicineSearch.Trim();
            q = q.Where(x =>
                (x.Sku != null && x.Sku.Contains(term)) ||
                (x.Name != null && x.Name.Contains(term)) ||
                x.GenericName.Contains(term) ||
                x.SupplierName.Contains(term));
        }
        return q;
    }

    private IQueryable<MedQueryRow> ApplyStockFilter(IQueryable<MedQueryRow> q) => filterStock switch
    {
        "in" => q.Where(x => x.LiveStock > 0),
        "low" => q.Where(x => x.LiveStock > 0 && x.LiveStock <= x.ReOrderLevel),
        "out" => q.Where(x => x.LiveStock <= 0),
        _ => q
    };

    private IQueryable<MedQueryRow> ApplySort(IQueryable<MedQueryRow> q) => sortBy switch
    {
        "sku" => q.OrderBy(x => x.Sku).ThenBy(x => x.ID),
        "stock_asc" => q.OrderBy(x => x.LiveStock).ThenBy(x => x.Name).ThenBy(x => x.ID),
        "stock_desc" => q.OrderByDescending(x => x.LiveStock).ThenBy(x => x.Name).ThenBy(x => x.ID),
        "mrp_desc" => q.OrderByDescending(x => x.SaleRate).ThenBy(x => x.Name).ThenBy(x => x.ID),
        _ => q.OrderBy(x => x.Name).ThenBy(x => x.ID)
    };

    private static MedicineRowDto ToDto(MedQueryRow x) => new(
        x.ID, x.Sku, x.Name ?? "—", x.GenericName, x.TypeName, x.SupplierName,
        x.BuyRate, x.SaleRate, x.ReOrderLevel, x.LiveStock);

    private async Task LoadMedicinesPageAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var baseQ = BuildMedicineBaseQuery(db);

        // Stock segment counts reflect search/type/supplier filters
        stockCountAll = await baseQ.CountAsync();
        stockCountIn = await baseQ.CountAsync(x => x.LiveStock > 0);
        stockCountLow = await baseQ.CountAsync(x => x.LiveStock > 0 && x.LiveStock <= x.ReOrderLevel);
        stockCountOut = stockCountAll - stockCountIn;

        var q = ApplyStockFilter(baseQ);
        medicineTotalFiltered = filterStock switch
        {
            "in" => stockCountIn,
            "low" => stockCountLow,
            "out" => stockCountOut,
            _ => stockCountAll
        };
        var maxPage = TotalPages(medicineTotalFiltered);
        if (medicinePage > maxPage) medicinePage = maxPage;
        if (medicinePage < 1) medicinePage = 1;

        var pageItems = await ApplySort(q)
            .Skip((medicinePage - 1) * pageSize)
            .Take(pageSize)
            .ToListAsync();

        pagedMedicineRows = pageItems.Select(ToDto).ToList();
    }

