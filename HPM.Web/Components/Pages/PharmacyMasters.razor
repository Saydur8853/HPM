        <thead>
            <tr>
                <th>#</th>
                <th>@I18n.T("SKU")</th>
                <th>@I18n.T("Medicine Name")</th>
                <th>@I18n.T("Generic")</th>
                <th>@I18n.T("Type")</th>
                <th>@I18n.T("Company")</th>
                <th class="num">@I18n.T("Stock")</th>
                <th class="num">@I18n.T("Buy (TP)")</th>
                <th class="num">@I18n.T("Sale (MRP)")</th>
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < printRows.Count; i++)
            {
                var m = printRows[i];
                <tr>
                    <td>@(i + 1)</td>
                    <td>@(string.IsNullOrWhiteSpace(m.Sku) ? $"MED-{m.ID:D5}" : m.Sku)</td>
                    <td><b>@m.Name</b></td>
                    <td>@m.GenericName</td>
                    <td>@m.TypeName</td>
                    <td>@m.SupplierName</td>
                    <td class="num">@m.LiveStock.ToString("N0")</td>
                    <td class="num">@I18n.FormatCurrency(m.BuyRate)</td>
                    <td class="num">@I18n.FormatCurrency(m.SaleRate)</td>
                </tr>
            }
        </tbody>
    </table>
    <PrintDocumentFooter Signatures='new string[] { I18n.T("Prepared By"), I18n.T("Pharmacy In-Charge") }' />
</div>

@code {
    private const int MedicineCategoryId = 3;

    [SupplyParameterFromQuery(Name = "section")]
    public string? QuerySection { get; set; }

    private string currentSection = "services";
    private int pageSize = 25;
    private bool isBusy;

    // Tab badge counts (lightweight SQL COUNT)
    private int totalMedicinesTabCount;
    private int totalGenericsTabCount;
    private int totalTypesTabCount;
    private int totalSuppliersTabCount;
    private int totalStoresTabCount;

    // Active form models
    private Service medicine = NewMedicine();
    private MedicineStore store = NewStore();
    private GenericGroup generic = new();
    private MedicineType medicineType = new();
    private SupplierPharmacy supplier = new();

    // Lightweight lookup lists for Medicine form dropdowns/typeaheads
    private List<GenericLookup> lookupGenerics = [];
    private List<MedicineType> lookupTypes = [];
    private List<SupplierLookup> lookupSuppliers = [];

    // Combobox states on Medicine form
    private string genericComboText = "";
    private bool showGenericCombo;
    private string supplierComboText = "";
    private bool showSupplierCombo;

    // Server-side paged rows & filters per tab
    private List<MedicineRowDto> pagedMedicineRows = [];
    private int medicinePage = 1;
    private int medicineTotalFiltered;
    private string medicineSearch = "";
    private int filterTypeId;
    private int filterSupplierId;
    private string filterStock = "all";
    private string sortBy = "name";
    private int stockCountAll;
    private int stockCountIn;
    private int stockCountLow;
    private int stockCountOut;
    private List<MedicineRowDto> printRows = [];
    private DateTime printedAt = DateTime.Now;
    private bool isExporting;
    private bool isPrinting;

    private bool HasActiveMedicineFilter =>
        !string.IsNullOrWhiteSpace(medicineSearch) || filterTypeId > 0 || filterSupplierId > 0 || filterStock != "all";

    private string FilterSummary
    {
        get
        {
            var parts = new List<string>();
            if (!string.IsNullOrWhiteSpace(medicineSearch)) parts.Add($"{I18n.T("Search")} \"{medicineSearch.Trim()}\"");
            if (filterTypeId > 0) parts.Add($"{I18n.T("Type")}: {lookupTypes.FirstOrDefault(x => x.ID == filterTypeId)?.Type}");
            if (filterSupplierId > 0) parts.Add($"{I18n.T("Supplier")}: {lookupSuppliers.FirstOrDefault(x => x.ID == filterSupplierId)?.Name}");
            if (filterStock != "all") parts.Add(filterStock switch
            {
                "in" => I18n.T("In Stock"),
                "low" => I18n.T("Low Stock"),
                _ => I18n.T("Out of Stock")
            });
            parts.Add($"{medicineTotalFiltered} {I18n.T("items")}");
            return string.Join(" · ", parts);
        }
    }

    private List<CountRowDto> pagedGenericRows = [];
    private int genericPage = 1;
    private int genericTotalFiltered;
    private string genericSearch = "";

    private List<CountRowDto> pagedTypeRows = [];
    private int typePage = 1;
    private int typeTotalFiltered;
    private string typeSearch = "";

    private List<SupplierRowDto> pagedSupplierRows = [];
    private int supplierPage = 1;
    private int supplierTotalFiltered;
    private string supplierSearch = "";

    private List<StoreRowDto> pagedStoreRows = [];
    private int storePage = 1;
    private int storeTotalFiltered;
    private string storeSearch = "";

    // Inline Quick-Add
    private string quickAddKind = "";
    private string quickAddValue = "";

    private string message = "";
    private string messageClass = "success";

    private IEnumerable<GenericLookup> FilteredComboGenerics => string.IsNullOrWhiteSpace(genericComboText)
        ? lookupGenerics.Take(25)
        : lookupGenerics.Where(x => x.Name.Contains(genericComboText.Trim(), StringComparison.OrdinalIgnoreCase)).Take(25);

    private IEnumerable<SupplierLookup> FilteredComboSuppliers => string.IsNullOrWhiteSpace(supplierComboText)
        ? lookupSuppliers.Take(25)
        : lookupSuppliers.Where(x => x.Name.Contains(supplierComboText.Trim(), StringComparison.OrdinalIgnoreCase)).Take(25);

    private int TotalPages(int totalCount) => Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));

    private RenderFragment RenderPaginationBar(int currentPage, int totalPages, Func<int, Task> onPageSelected) => __builder =>
    {
        if (totalPages <= 1) return;
        <div style="display:flex; justify-content:space-between; align-items:center; gap:8px; flex-wrap:wrap; padding:10px 18px; border-top:1px solid #e2e8f0; background:#f8fafc;">
            <button class="btn btn-ghost btn-sm" type="button" disabled="@(currentPage <= 1)" @onclick="() => onPageSelected(currentPage - 1)">
                &larr; @I18n.T("Prev")
            </button>
            <div style="display:flex; gap:4px; align-items:center; flex-wrap:wrap;">
                @{
                    var start = Math.Max(1, currentPage - 2);
                    var end = Math.Min(totalPages, start + 4);
                    start = Math.Max(1, end - 4);
                }
                @if (start > 1)
                {
                    <button type="button" class="btn btn-ghost btn-sm" style="min-width:30px; padding:2px 7px;" @onclick="() => onPageSelected(1)">1</button>
                    @if (start > 2)
                    {
                        <span style="color:#94a3b8; font-size:12px;">&hellip;</span>
                    }
                }
                @for (var p = start; p <= end; p++)
                {
                    var pageNum = p;
                    <button type="button"
                            class="btn @(pageNum == currentPage ? "btn-primary" : "btn-ghost") btn-sm"
                            style="min-width:30px; padding:2px 7px;"
                            @onclick="() => onPageSelected(pageNum)">
                        @pageNum
                    </button>
                }
                @if (end < totalPages)
                {
                    @if (end < totalPages - 1)
                    {
                        <span style="color:#94a3b8; font-size:12px;">&hellip;</span>
                    }
                    <button type="button" class="btn btn-ghost btn-sm" style="min-width:30px; padding:2px 7px;" @onclick="() => onPageSelected(totalPages)">@totalPages</button>
                }
            </div>
            <button class="btn btn-ghost btn-sm" type="button" disabled="@(currentPage >= totalPages)" @onclick="() => onPageSelected(currentPage + 1)">
                @I18n.T("Next") &rarr;
            </button>
        </div>
    };

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        ApplySectionFromQuery();
        await LoadInitialAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        var previous = currentSection;
        ApplySectionFromQuery();
        if (previous != currentSection)
        {
            await LoadActiveSectionAsync();
        }
    }

    private void ApplySectionFromQuery()
    {
        var target = (QuerySection ?? "").Trim().ToLowerInvariant();
        currentSection = target is "store" or "type" or "generic" or "supplier" or "services" or "medicine" ? target : "services";
    }

    private async Task SwitchSectionAsync(string sec)
    {
        currentSection = sec;
        quickAddKind = "";
        showGenericCombo = false;
        showSupplierCombo = false;
        message = "";
        Navigation.NavigateTo($"/pharmacy/masters?section={sec}", replace: true);
        await LoadActiveSectionAsync();
    }

    private string GetPageTitle() => currentSection switch
    {
        "store" => I18n.T("Pharmacy Stores"),
        "type" => I18n.T("Dosage Types"),
        "generic" => I18n.T("Generic Names"),
        "supplier" => I18n.T("Medicine Suppliers"),
        _ => I18n.T("Medicine List & Setup")
    };

    private async Task LoadInitialAsync()
    {
        await LoadTabCountsAndLookupsAsync();
        await LoadActiveSectionAsync();
    }

    private async Task ReloadAfterImportAsync()
    {
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            // Backfill SKU for any newly bulk-imported medicines missing SKU
            await db.Database.ExecuteSqlRawAsync(
                "UPDATE [Service] SET [SKU] = CONCAT('MED-', RIGHT('00000' + CAST([ID] AS varchar(10)), 5)) WHERE [Category_ID] = 3 AND ([SKU] IS NULL OR [SKU] = '')");
        }
        await LoadTabCountsAndLookupsAsync();
        await LoadActiveSectionAsync();
    }

    private async Task LoadTabCountsAndLookupsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        totalMedicinesTabCount = await db.Services.AsNoTracking().CountAsync(x => x.CategoryID == MedicineCategoryId);
        totalGenericsTabCount = await db.GenericGroups.AsNoTracking().CountAsync();
        totalTypesTabCount = await db.MedicineTypes.AsNoTracking().CountAsync();
