        <span><b>@I18n.T("Filter"):</b> @(HasActiveMedicineFilter ? FilterSummary : I18n.T("All medicines"))</span>
        <span><b>@I18n.T("Total"):</b> @printRows.Count &nbsp; <b>@I18n.T("Printed"):</b> @printedAt.ToString("dd MMM yyyy, hh:mm tt")</span>
