        lookupTypes = await db.MedicineTypes.AsNoTracking().OrderBy(x => x.Type).ToListAsync();
        lookupGenerics = await db.GenericGroups.AsNoTracking()
            .OrderBy(x => x.Name)
            .Select(x => new GenericLookup(x.ID, x.Name ?? ""))
            .ToListAsync();
        lookupSuppliers = await db.PharmacySuppliers.AsNoTracking()
            .OrderBy(x => x.Name)
            .Select(x => new SupplierLookup(x.ID, x.Name ?? ""))
            .ToListAsync();
    }

