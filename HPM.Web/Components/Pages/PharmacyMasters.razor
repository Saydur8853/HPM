<div id="pharmacy-catalogue-print" class="print-sheet panel print-document print-a4-sheet pharm-print-only">
    <PrintDocumentHeader Title="@I18n.T("Medicine Catalogue & SKU Price List")"
                         SubTitle="@I18n.T("Hospital Pharmacy")"
                         DocumentNo="@($"CAT-{DateTime.Now:yyyyMMdd}")" />
