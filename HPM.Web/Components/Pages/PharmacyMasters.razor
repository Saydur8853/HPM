    // SKU Generator
    private void GenerateAutoSku()
    {
        var typePrefix = lookupTypes.FirstOrDefault(x => x.ID == medicine.TypeID)?.Type;
        var pfx = !string.IsNullOrWhiteSpace(typePrefix) && typePrefix.Length >= 3
            ? new string(typePrefix.Where(char.IsLetterOrDigit).Take(3).ToArray()).ToUpperInvariant()
            : "MED";
        var brandPart = !string.IsNullOrWhiteSpace(medicine.Name)
            ? new string(medicine.Name.Where(char.IsLetterOrDigit).Take(4).ToArray()).ToUpperInvariant()
            : "";
        var suffix = medicine.ID > 0 ? medicine.ID.ToString("D4") : (totalMedicinesTabCount + 1).ToString("D4");
        medicine.Sku = string.IsNullOrEmpty(brandPart) ? $"{pfx}-{suffix}" : $"{pfx}-{brandPart}-{suffix}";
    }

