    // ---------- Load bill ----------
    private async Task OpenMemoAsync(long id)
    {
        ClearFind();
        showFindSuggestions = false;
        await using var db = await DbFactory.CreateDbContextAsync();
        var found = await db.PharmacyCashMemos.AsNoTracking().Include(x => x.Items).ThenInclude(x => x.BatchAllocations).FirstOrDefaultAsync(x => x.ID == id);
        if (found == null)
        {
            Fail(I18n.IsBangla ? $"বিল #PH-{id} পাওয়া যায়নি।" : $"Bill #PH-{id} was not found.");
            return;
        }
        memo = found;
        savedReturn = null;
        lines = [];
        reason = "";
        stocks = await db.MedicineStoreBalances.AsNoTracking().Where(x => x.MedicineStoreID == (memo.BufferStore ?? 0)).ToListAsync();
        var ids = memo.Items.Select(x => x.ID).ToArray();
        returnedByItem = ids.Length == 0 ? [] : await db.PharmacySalesReturnItems.AsNoTracking().Where(x => ids.Contains(x.CashMemoSubID)).GroupBy(x => x.CashMemoSubID).ToDictionaryAsync(x => x.Key, x => x.Sum(y => y.Quantity));
        var batchReturns = ids.Length == 0 ? [] : await db.PharmacySalesReturnItems.AsNoTracking().Where(x => ids.Contains(x.CashMemoSubID) && x.IsRestocked && x.StockBalanceID.HasValue).Select(x => new { x.CashMemoSubID, StockId = x.StockBalanceID!.Value, x.Quantity }).ToListAsync();
        returnedByBatch = batchReturns.GroupBy(x => (x.CashMemoSubID, x.StockId)).ToDictionary(x => x.Key, x => x.Sum(y => y.Quantity));
        priorRefund = await db.PharmacySalesReturns.Where(x => x.CashMemoID == memo.ID && x.IsPosted).SumAsync(x => (decimal?)x.RefundAmount) ?? 0;

        var stockIds = stocks.Select(s => s.ID).ToHashSet();
        drafts = memo.Items.OrderBy(x => x.SLNO).Select(item =>
        {
            var already = returnedByItem.GetValueOrDefault(item.ID);
            var max = Math.Max(0, (item.Quantity ?? 0) - already);
            var canRestock = item.BatchAllocations.Any(a => stockIds.Contains(a.StockBalanceID));
            var batchText = string.Join(", ", item.BatchAllocations.Select(a => a.BatchNo).Where(b => !string.IsNullOrWhiteSpace(b)).Distinct());
            return new ReturnDraft { Item = item, AlreadyReturned = already, Max = max, CanRestock = canRestock, Restock = canRestock, BatchText = batchText };
        }).ToList();

        if (drafts.All(d => d.Max <= 0)) Fail(I18n.IsBangla ? "এই বিলের সব ঔষধ ইতিমধ্যে ফেরত হয়েছে।" : "All items from this bill have already been returned.");
        else if (memo.TransDate < DateTime.Today.AddDays(-30)) Fail(I18n.IsBangla ? "সতর্কতা: বিলটি ৩০ দিনের বেশি পুরনো।" : "Note: this bill is more than 30 days old.");
        else message = "";
    }

    private void StepDraft(ReturnDraft d, decimal delta) => d.Qty = Math.Clamp(d.Qty + delta, 0, d.Max);

    private void SetDraft(ReturnDraft d, string? raw)
    {
        if (!decimal.TryParse(raw, out var qty)) qty = 0;
        if (qty > d.Max) Fail(I18n.IsBangla ? $"সর্বোচ্চ {d.Max:0.##} ফেরত দেওয়া যাবে।" : $"Only {d.Max:0.##} can be returned for {MedicineName(d.Item.ServiceID)}.");
        d.Qty = Math.Clamp(qty, 0, d.Max);
    }

    private void ReturnAll()
    {
        foreach (var d in drafts) d.Qty = d.Max;
    }

    private void ClearDrafts()
    {
        foreach (var d in drafts) d.Qty = 0;
    }

    private decimal BatchReturnable(long itemId, int stockId, IEnumerable<ReturnLine> pendingLines)
    {
        var allocated = memo?.Items.FirstOrDefault(x => x.ID == itemId)?.BatchAllocations.Where(x => x.StockBalanceID == stockId).Sum(x => x.Quantity) ?? 0;
        var prior = returnedByBatch.TryGetValue((itemId, stockId), out var qty) ? qty : 0;
        var pending = pendingLines.Where(x => x.CashMemoSubID == itemId && x.StockBalanceID == stockId).Sum(x => x.Quantity);
        return Math.Max(0, allocated - prior - pending);
    }

    /// <summary>Turns the per-item draft quantities into return lines, restocking into the original sale batches (earliest expiry first).</summary>
    private List<ReturnLine>? BuildLines()
    {
        var result = new List<ReturnLine>();
        var stockIds = stocks.Select(s => s.ID).ToHashSet();
        foreach (var d in drafts.Where(d => d.Qty > 0))
        {
            var item = d.Item;
            if (item.ServiceID == null) continue;
            if (d.Qty > d.Max)
            {
                Fail($"Return quantity exceeds remaining sold quantity for {MedicineName(item.ServiceID)}.");
                return null;
            }
            var rate = item.Rate ?? 0;
            if (!d.Restock || !d.CanRestock)
            {
                result.Add(new ReturnLine(item.ID, item.ServiceID.Value, 0, d.Qty, rate, item.BuyRate ?? 0));
                continue;
            }
            var remaining = d.Qty;
            foreach (var alloc in item.BatchAllocations.Where(a => stockIds.Contains(a.StockBalanceID)).OrderBy(a => a.ExpireDate ?? DateTime.MaxValue).ThenBy(a => a.StockBalanceID))
            {
                var take = Math.Min(remaining, BatchReturnable(item.ID, alloc.StockBalanceID, result));
                if (take <= 0) continue;
                result.Add(new ReturnLine(item.ID, item.ServiceID.Value, alloc.StockBalanceID, take, rate, alloc.BuyRate));
                remaining -= take;
                if (remaining <= 0) break;
            }
            if (remaining > 0)
            {
                Fail(I18n.IsBangla
                    ? $"{MedicineName(item.ServiceID)}: মূল ব্যাচে {remaining:0.##} টি রিস্টক করা যাবে না। 'Damaged' নির্বাচন করুন বা পরিমাণ কমান।"
                    : $"{MedicineName(item.ServiceID)}: {remaining:0.##} unit(s) cannot be restocked into the original batch. Mark it as Damaged or reduce the quantity.");
                return null;
            }
        }
        return result;
    }

    private async Task PostAsync(bool printAfterSave)
    {
        if (memo == null || savedReturn != null) return;
        if (ReturnItemCount == 0 || string.IsNullOrWhiteSpace(reason))
        {
            Fail(I18n.IsBangla ? "ফেরতের ঔষধ ও কারণ লিখুন।" : "Select items to return and enter a return reason.");
            return;
        }
        var built = BuildLines();
        if (built == null || built.Count == 0) return;
        lines = built;
        isSaving = true;
        try
        {
            var result = await ResilientTransaction.ExecuteAsync(DbFactory, async db =>
            {
                var source = await db.PharmacyCashMemos.Include(x => x.Items).ThenInclude(x => x.BatchAllocations).SingleAsync(x => x.ID == memo.ID);
                foreach (var group in lines.GroupBy(x => x.CashMemoSubID))
                {
                    var sold = source.Items.Single(x => x.ID == group.Key);
                    var already = await db.PharmacySalesReturnItems.Where(x => x.CashMemoSubID == sold.ID).SumAsync(x => (decimal?)x.Quantity) ?? 0;
                    if (group.Sum(x => x.Quantity) > (sold.Quantity ?? 0) - already)
                        throw new InvalidOperationException($"Return quantity exceeded for {MedicineName(sold.ServiceID)}.");
                }
                foreach (var group in lines.Where(x => x.StockBalanceID > 0).GroupBy(x => new { x.CashMemoSubID, x.StockBalanceID }))
                {
                    var sold = source.Items.Single(x => x.ID == group.Key.CashMemoSubID);
                    var allocated = sold.BatchAllocations.Where(x => x.StockBalanceID == group.Key.StockBalanceID).Sum(x => x.Quantity);
                    if (allocated <= 0) throw new InvalidOperationException("Restocking is allowed only to a batch used by the original sale.");
                    var already = await db.PharmacySalesReturnItems.Where(x => x.CashMemoSubID == sold.ID && x.StockBalanceID == group.Key.StockBalanceID && x.IsRestocked).SumAsync(x => (decimal?)x.Quantity) ?? 0;
                    if (group.Sum(x => x.Quantity) > allocated - already)
                        throw new InvalidOperationException("Return quantity exceeds the quantity sold from the selected batch.");
                }
                var priorReturns = await db.PharmacySalesReturns.Where(x => x.CashMemoID == source.ID && x.IsPosted).SumAsync(x => (decimal?)x.RefundAmount) ?? 0;
                var currentGross = lines.Sum(x => x.Gross);
                var gross = source.Items.Sum(x => (x.Rate ?? 0) * (x.Quantity ?? 0));
                var net = Math.Max(0, (source.Total ?? gross) - (source.Discount ?? 0));
                var refund = gross <= 0 ? 0 : Math.Min(net - priorReturns, Math.Round(net * currentGross / gross, 2));
                if (refund <= 0) throw new InvalidOperationException("No refundable amount remains.");
                var uid = await CurrentUserIdAsync();
                var now = DateTime.Now;
                var header = new PharmacySalesReturn { CashMemoID = source.ID, StoreID = source.BufferStore ?? 1, RefundAmount = refund, Reason = reason.Trim(), IsPosted = true, EnteredBy = uid, TransDate = now };
                db.PharmacySalesReturns.Add(header);
                await db.SaveChangesAsync();

                var isIpdBedCredit = source.PatientType == "2" && (source.IsCredit == true || !await db.CentralCashCollections.AnyAsync(c => c.ModuleFlag == 4 && c.ReferenceID == source.ID && c.Amount > 0));

                foreach (var line in lines)
                {
                    var sold = source.Items.Single(x => x.ID == line.CashMemoSubID);
                    var buyRate = sold.BuyRate ?? 0;
                    if (line.StockBalanceID > 0)
                    {
                        var allocation = sold.BatchAllocations.First(x => x.StockBalanceID == line.StockBalanceID);
                        buyRate = allocation.BuyRate;
                        var stock = await db.MedicineStoreBalances.SingleAsync(x => x.ID == line.StockBalanceID);
                        if (stock.MedicineStoreID != header.StoreID || stock.ServiceID != line.ServiceID) throw new InvalidOperationException("Invalid restock batch.");
                        stock.Balance += line.Quantity;
                    }
                    db.PharmacySalesReturnItems.Add(new PharmacySalesReturnItem { SalesReturnID = header.ID, CashMemoSubID = line.CashMemoSubID, ServiceID = line.ServiceID, StockBalanceID = line.StockBalanceID > 0 ? line.StockBalanceID : null, Quantity = line.Quantity, Rate = line.Rate, BuyRate = buyRate, IsRestocked = line.StockBalanceID > 0 });
                    if (isIpdBedCredit && !string.IsNullOrWhiteSpace(source.RegNo))
                    {
                        var admission = await db.PatientAdmissions.FirstOrDefaultAsync(x => x.RegNo == source.RegNo);
                        var dept = admission == null ? 1 : await (from b in db.BedCabins join c in db.BedCategories on b.CategoryID equals c.ID where b.ID == admission.BedCabinID select c.IpdDepartmentID).FirstOrDefaultAsync();
                        if (source.IsPackage) db.PatientPackageTransactions.Add(new PatientPackageTransaction { RegNo = source.RegNo, ServiceID = line.ServiceID, ServiceRate = line.Rate, Quantity = -line.Quantity, IpdDepartmentID = dept, EnteredBy = uid, TransDate = now });
                        else db.PatientTransactions.Add(new PatientTransaction { RegNo = source.RegNo, ServiceID = line.ServiceID, ServiceRate = line.Rate, Quantity = -line.Quantity, IpdDepartmentID = dept, EnteredBy = uid, TransDate = now });
                    }
                }
                var originalReference = $"PHARMACY-SALE:{source.ID}";
                if (!await db.AccountVouchers.AnyAsync(x => x.Reference == originalReference))
                {
                    var originalNet = Math.Max(0, (source.Total ?? gross) - (source.Discount ?? 0));
                    if (originalNet > 0) AccountingPosting.AddPostedVoucher(db, !isIpdBedCredit ? "Receipt" : "Journal", source.TransDate, $"Pharmacy sale to {source.Name}", originalReference, source.EnteredBy, (!isIpdBedCredit ? AccountingPosting.Cash : AccountingPosting.PatientReceivable, originalNet, 0), (AccountingPosting.PharmacySales, 0, originalNet));
                }
                if (!isIpdBedCredit)
                {
                    db.CentralCashCollections.Add(new CentralCashCollection { Amount = -refund, ModuleFlag = 4, HeadID = 4, EnteredBy = uid, TransDate = now, TransDateCL = now, ReferenceID = header.ID });
                }
                AccountingPosting.AddPostedVoucher(db, "Sales Return", now, $"Pharmacy sales return for memo #{source.ID}", $"PHARMACY-SALES-RETURN:{header.ID}", uid, (AccountingPosting.PharmacySales, refund, 0), (!isIpdBedCredit ? AccountingPosting.Cash : AccountingPosting.PatientReceivable, 0, refund));
                await db.SaveChangesAsync();
                return (Header: header, Refund: refund);
            }, IsolationLevel.Serializable);

            savedReturn = result.Header;
            priorRefund += result.Refund;
            Success(I18n.IsBangla ? $"ফেরত ভাউচার #RET-{result.Header.ID} সংরক্ষিত হয়েছে।" : $"Return voucher #RET-{result.Header.ID} saved. Refund {I18n.FormatCurrency(result.Refund)}.");
            await using var refreshDb = await DbFactory.CreateDbContextAsync();
            await LoadSideListsAsync(refreshDb);

            if (printAfterSave)
            {
                StateHasChanged();
                await Task.Yield();
                await PrintA4Async();
            }
        }
        catch (Exception ex)
        {
            lines = [];
            Fail($"Return failed: {ex.Message}");
        }
        finally { isSaving = false; }
    }

    private async Task OpenReturnAsync(long id)
    {
        ClearFind();
        await using var db = await DbFactory.CreateDbContextAsync();
        savedReturn = await db.PharmacySalesReturns.AsNoTracking().Include(x => x.Items).SingleAsync(x => x.ID == id);
        memo = await db.PharmacyCashMemos.AsNoTracking().Include(x => x.Items).ThenInclude(x => x.BatchAllocations).SingleAsync(x => x.ID == savedReturn.CashMemoID);
        reason = savedReturn.Reason;
        drafts = [];
        lines = savedReturn.Items.Select(x => new ReturnLine(x.CashMemoSubID, x.ServiceID, x.StockBalanceID ?? 0, x.Quantity, x.Rate, x.BuyRate)).ToList();
        priorRefund = await db.PharmacySalesReturns.Where(x => x.CashMemoID == memo.ID && x.ID < savedReturn.ID && x.IsPosted).SumAsync(x => (decimal?)x.RefundAmount) ?? 0;
        message = "";
    }

    private async Task<int> CurrentUserIdAsync()
    {
        var u = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        return int.TryParse(u.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : 1;
    }

    private async Task PrintA4Async() => await JS.InvokeVoidAsync("hpm.printElement", "sales-return-print", $"RET-{savedReturn?.ID}");
    private async Task PrintThermalAsync() => await JS.InvokeVoidAsync("hpm.printElement", "sales-return-thermal-print", $"RET-{savedReturn?.ID}");

    private void Reset()
    {
        memo = null;
        savedReturn = null;
        ClearFind();
        lines = [];
        drafts = [];
        returnedByItem = [];
        returnedByBatch = [];
        priorRefund = 0;
        reason = "";
        message = "";
        _ = FocusFindSoonAsync();
    }

    private async Task FocusFindSoonAsync()
    {
        await Task.Yield();
        try { await findInputRef.FocusAsync(); } catch { }
    }

    private string MedicineName(int? id) => id.HasValue && medicineNames.TryGetValue(id.Value, out var n) ? n : "—";
    private void Success(string x) { messageClass = "success"; message = x; }
    private void Fail(string x) { messageClass = "danger"; message = x; }

    public void Dispose()
    {
        I18n.OnLanguageChanged -= HandleLanguageChanged;
        findCts?.Cancel();
        findCts?.Dispose();
    }

    private sealed class ReturnDraft
    {
        public required PharmacyCashMemoItem Item { get; init; }
        public decimal AlreadyReturned { get; init; }
        public decimal Max { get; init; }
        public bool CanRestock { get; init; }
        public bool Restock { get; set; }
        public decimal Qty { get; set; }
        public string BatchText { get; init; } = "";
    }

    private sealed record ReturnLine(long CashMemoSubID, int ServiceID, int StockBalanceID, decimal Quantity, decimal Rate, decimal BuyRate) { public decimal Gross => Quantity * Rate; }
}
