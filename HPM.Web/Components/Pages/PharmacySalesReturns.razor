    private IEnumerable<PharmacySalesReturn> TodayReturns => recent.Where(x => x.TransDate.Date == DateTime.Today);
    private bool IsCreditMemo => memo?.IsCredit == true;
    private decimal OriginalGross => memo?.Items.Sum(x => (x.Rate ?? 0) * (x.Quantity ?? 0)) ?? 0;
    private decimal OriginalNet => Math.Max(0, (memo?.Total ?? OriginalGross) - (memo?.Discount ?? 0));
    private decimal ReturnGross => savedReturn != null ? lines.Sum(x => x.Gross) : drafts.Sum(d => d.Qty * (d.Item.Rate ?? 0));
    private int ReturnItemCount => savedReturn != null ? lines.Select(x => x.CashMemoSubID).Distinct().Count() : drafts.Count(d => d.Qty > 0);
    private decimal ReturnUnits => savedReturn != null ? lines.Sum(x => x.Quantity) : drafts.Sum(d => d.Qty);
    private decimal EstimatedRefund => OriginalGross <= 0 ? 0 : Math.Min(Math.Max(0, OriginalNet - priorRefund), Math.Round(OriginalNet * ReturnGross / OriginalGross, 2));
    private bool CanPost => !isSaving && memo != null && savedReturn == null && ReturnItemCount > 0 && !string.IsNullOrWhiteSpace(reason);

    // ---------- Search helpers ----------
    private string[] rightTokens => Tokenize(rightSearch).Select(StripPrefix).Where(t => t.Length > 0).ToArray();

    private static string StripPrefix(string t)
    {
        foreach (var p in new[] { "PH-", "RET-", "#" })
            if (t.StartsWith(p, StringComparison.OrdinalIgnoreCase)) return t[p.Length..];
        return t;
    }

    private static string[] Tokenize(string? q) => string.IsNullOrWhiteSpace(q)
        ? []
        : q.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Distinct(StringComparer.OrdinalIgnoreCase).ToArray();

    private static bool MatchesAll(string[] tokens, params string?[] fields)
    {
        if (tokens.Length == 0) return true;
        var hay = string.Join(' ', fields.Where(f => !string.IsNullOrWhiteSpace(f)));
        return tokens.All(t => hay.Contains(t, StringComparison.OrdinalIgnoreCase));
    }

    private static RenderFragment Hl(string? text, string[] tokens) => builder =>
    {
        if (string.IsNullOrEmpty(text)) return;
        if (tokens.Length == 0) { builder.AddContent(0, text); return; }
        var mask = new bool[text.Length];
        foreach (var t in tokens)
        {
            var i = 0;
            while ((i = text.IndexOf(t, i, StringComparison.OrdinalIgnoreCase)) >= 0)
            {
                for (var k = i; k < i + t.Length; k++) mask[k] = true;
                i += Math.Max(1, t.Length);
            }
        }
        var seq = 0;
        var start = 0;
        while (start < text.Length)
        {
            var hit = mask[start];
            var end = start;
            while (end < text.Length && mask[end] == hit) end++;
            if (hit)
            {
                builder.OpenElement(seq++, "mark");
                builder.AddContent(seq++, text[start..end]);
                builder.CloseElement();
            }
            else builder.AddContent(seq++, text[start..end]);
            start = end;
        }
    };

    private IEnumerable<PharmacyCashMemo> FilteredBills
    {
        get
        {
            var tokens = rightTokens;
            return tokens.Length == 0 ? recentBills : recentBills.Where(x => MatchesAll(tokens, x.ID.ToString(), x.Name, x.Contact, x.RegNo));
        }
    }

    private IEnumerable<PharmacySalesReturn> FilteredReturns
    {
        get
        {
            var tokens = rightTokens;
            return tokens.Length == 0 ? recent : recent.Where(x => MatchesAll(tokens, x.ID.ToString(), x.CashMemoID.ToString(), x.Reason, memoNames.GetValueOrDefault(x.CashMemoID)));
        }
    }

    /// <summary>Extracts a bill id from a QR payload (HPM:PHARM|MEMO:123), "PH-123", "#123" or "123".</summary>
    private static long ParseBillId(string raw)
    {
        raw = raw.Trim();
        if (raw.StartsWith("HPM:PHARM|", StringComparison.OrdinalIgnoreCase))
        {
            foreach (var p in raw.Split('|'))
                if (p.StartsWith("MEMO:", StringComparison.OrdinalIgnoreCase) && long.TryParse(p[5..], out var qrId)) return qrId;
            return 0;
        }
        var s = StripPrefix(raw);
        return long.TryParse(s, out var id) && id > 0 ? id : 0;
    }

