    private async Task LoadSideListsAsync(HpmDbContext db)
    {
        var since = DateTime.Today.AddDays(-7);
        recentBills = await db.PharmacyCashMemos.AsNoTracking().Where(x => x.TransDate >= since).OrderByDescending(x => x.ID).Take(300).ToListAsync();
        recent = await db.PharmacySalesReturns.AsNoTracking().OrderByDescending(x => x.ID).Take(150).ToListAsync();
        var memoIds = recent.Select(x => x.CashMemoID).Distinct().ToList();
        memoNames = recentBills.ToDictionary(x => x.ID, x => x.Name ?? "—");
        var missing = memoIds.Where(id => !memoNames.ContainsKey(id)).ToList();
        if (missing.Count > 0)
        {
            foreach (var m in await db.PharmacyCashMemos.AsNoTracking().Where(x => missing.Contains(x.ID)).Select(x => new { x.ID, x.Name }).ToListAsync())
                memoNames[m.ID] = m.Name ?? "—";
        }
        returnedMemoIds = memoIds.ToHashSet();
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    // ---------- Finder ----------
    private async Task OnFindInputAsync()
    {
        findCts?.Cancel();
        highlightedFindIndex = 0;
        showFindSuggestions = true;
        findTokens = Tokenize(findQuery).Select(StripPrefix).Where(t => t.Length > 0).ToArray();
        if (string.IsNullOrWhiteSpace(findQuery) || findQuery.StartsWith("HPM:", StringComparison.OrdinalIgnoreCase))
        {
            memoSuggestions = [];
            isSearching = false;
            return;
        }
        var cts = findCts = new CancellationTokenSource();
        isSearching = true;
        try
        {
            await Task.Delay(220, cts.Token);
            var results = await SearchMemosAsync(findQuery, cts.Token);
            if (cts.IsCancellationRequested) return;
            memoSuggestions = results;
        }
        catch (OperationCanceledException) { return; }
        finally
        {
            if (!cts.IsCancellationRequested) isSearching = false;
        }
    }

    private async Task<List<PharmacyCashMemo>> SearchMemosAsync(string raw, CancellationToken ct)
    {
        var tokens = Tokenize(raw).Select(StripPrefix).Where(t => t.Length > 0).ToArray();
        if (tokens.Length == 0) return [];
        var billId = tokens.Length == 1 ? ParseBillId(raw) : 0;
        await using var db = await DbFactory.CreateDbContextAsync();
        var query = db.PharmacyCashMemos.AsNoTracking();
        if (billId > 0)
        {
            var t = tokens[0];
            query = query.Where(x => x.ID == billId || (x.Contact != null && x.Contact.Contains(t)) || (x.RegNo != null && x.RegNo.Contains(t)));
        }
        else
        {
            foreach (var token in tokens)
            {
                var t = token;
                query = query.Where(x => (x.Name != null && x.Name.Contains(t)) || (x.Contact != null && x.Contact.Contains(t)) || (x.RegNo != null && x.RegNo.Contains(t)));
            }
        }
        var list = await query.OrderByDescending(x => x.ID).Take(20).ToListAsync(ct);
        return billId > 0 ? list.OrderByDescending(x => x.ID == billId).ToList() : list;
    }

    private async Task HandleFindKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown":
                showFindSuggestions = true;
                if (highlightedFindIndex < memoSuggestions.Count - 1) highlightedFindIndex++;
                await ScrollActiveAsync("#px-find-dd");
                break;
            case "ArrowUp":
                if (highlightedFindIndex > 0) highlightedFindIndex--;
                await ScrollActiveAsync("#px-find-dd");
                break;
            case "Escape":
                showFindSuggestions = false;
                break;
            case "Enter":
                var raw = findQuery.Trim();
                if (string.IsNullOrWhiteSpace(raw)) return;
                // Scanner input / explicit bill number opens directly (no need to wait for the dropdown).
                var id = Tokenize(raw).Length == 1 ? ParseBillId(raw) : 0;
                var highlighted = highlightedFindIndex >= 0 && highlightedFindIndex < memoSuggestions.Count ? memoSuggestions[highlightedFindIndex] : null;
                if (highlighted != null && (id == 0 || highlighted.ID == id)) await OpenMemoAsync(highlighted.ID);
                else if (id > 0) await OpenMemoAsync(id);
                else
                {
                    findCts?.Cancel();
                    memoSuggestions = await SearchMemosAsync(raw, CancellationToken.None);
                    isSearching = false;
                    if (memoSuggestions.Count == 1) await OpenMemoAsync(memoSuggestions[0].ID);
                    else showFindSuggestions = true;
                }
                break;
        }
    }

