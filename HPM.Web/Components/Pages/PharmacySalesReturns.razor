@page "/pharmacy/sales-returns"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.PharmacyOperator + "," + RoleNames.Cashier)]
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject IBarcodeQrService BarcodeQr
@implements IDisposable
@using System.Data
@using System.Security.Claims
@using HPM.Web.Components.Common

<PageTitle>@I18n.T("Customer Return") | @Branding.HospitalName</PageTitle>

<div class="pharmacy-classic-fit px-root">
    <!-- Topbar -->
    <div class="px-topbar">
        <div class="px-topbar-left">
            <h1 class="px-title">@I18n.T("Customer Medicine Return & Refund")</h1>
        </div>
        <div class="px-topbar-right">
            <div class="px-metric"><span>@I18n.T("Today's Returns")</span><b>@TodayReturns.Count()</b></div>
            <div class="px-metric"><span>@I18n.T("Today's Refund")</span><b class="bad">@I18n.FormatCurrency(TodayReturns.Sum(x => x.RefundAmount))</b></div>
            <NavLink class="px-btn ghost" href="/pharmacy/pos">← @I18n.T("Back to POS")</NavLink>
            <button type="button" class="px-btn" @onclick="Reset">+ @I18n.T("New Return")</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="px-alert @messageClass">
            <span>@message</span>
            <button type="button" @onclick='() => message = ""'>✕</button>
        </div>
    }

    <div class="pharmacy-classic-workspace">
        <!-- Left: return form -->
        <section class="px-card">
            <header class="px-card-head">
                <div class="px-card-title">
                    <h2>@(savedReturn != null ? $"{I18n.T("Return Voucher")} #RET-{savedReturn.ID}" : memo != null ? $"{I18n.T("Return against Bill")} #PH-{memo.ID}" : I18n.T("Find Original Bill"))</h2>
                    @if (savedReturn != null)
                    {
                        <span class="px-badge paid">@I18n.T("POSTED")</span>
                    }
                    else if (memo != null)
                    {
                        <span class="px-badge new">@I18n.T("DRAFT")</span>
                    }
                </div>
            </header>

            <div class="px-card-body">
                @if (savedReturn == null)
                {
                    <!-- Smart finder -->
                    <div class="px-field">
                        <span>
                            @I18n.T("Find Bill")
                            <em>@I18n.T("scan bill QR, or type Bill # (1025 / PH-1025), customer name, mobile or IPD reg")</em>
                        </span>
                        <div class="px-typeahead">
                            <div class="px-search-box">
                                <span class="px-search-icon">🔍</span>
                                <input type="text"
                                       @ref="findInputRef"
                                       placeholder="@I18n.T("Scan or type to search bills...")"
                                       @bind="findQuery"
                                       @bind:event="oninput"
                                       @bind:after="OnFindInputAsync"
                                       @onkeydown="HandleFindKeyDown"
                                       @onfocus="() => showFindSuggestions = true"
                                       @onblur="() => showFindSuggestions = false"
                                       autocomplete="off" />
                                @if (!string.IsNullOrWhiteSpace(findQuery))
                                {
                                    <button type="button" class="px-x" @onclick="ClearFind">✕</button>
                                }
                            </div>
                            @if (showFindSuggestions && !string.IsNullOrWhiteSpace(findQuery))
                            {
                                <div class="px-dropdown wide" id="px-find-dd">
                                    @if (isSearching && memoSuggestions.Count == 0)
                                    {
                                        <div class="px-loading">@I18n.T("Searching…")</div>
                                    }
                                    else if (memoSuggestions.Count == 0)
                                    {
                                        <div class="px-dd-empty">@I18n.T("No bill found for") “@findQuery”</div>
                                    }
                                    else
                                    {
                                        <div class="px-dd-head">
                                            <span>@memoSuggestions.Count @I18n.T("bill(s)")</span>
                                            <span class="px-dd-keys">↑↓ @I18n.T("move") · Enter @I18n.T("open")</span>
                                        </div>
                                    }
                                    @for (var i = 0; i < memoSuggestions.Count; i++)
                                    {
                                        var s = memoSuggestions[i];
                                        var idx = i;
                                        <div class="px-dd-item @(i == highlightedFindIndex ? "is-active" : "")"
                                             @onmousedown:preventDefault
                                             @onmouseover="() => highlightedFindIndex = idx"
                                             @onclick="() => OpenMemoAsync(s.ID)">
                                            <div class="px-dd-main">
                                                <div class="px-dd-name">
                                                    <span class="px-code" style="color:#0369a1;">#PH-@Hl(s.ID.ToString(), findTokens)</span>
                                                    @Hl(s.Name, findTokens)
                                                    @if (s.PatientType == "2")
                                                    {
                                                        <span class="px-tag @(s.IsCredit == true ? "violet" : "blue")">@(s.IsCredit == true ? "IPD Bill" : "IPD Cash")</span>
                                                    }
                                                </div>
                                                <div class="px-dd-sub">
                                                    <span>@s.TransDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                                                    @if (!string.IsNullOrWhiteSpace(s.Contact)) { <span>📞 @Hl(s.Contact, findTokens)</span> }
                                                    @if (!string.IsNullOrWhiteSpace(s.RegNo)) { <span>@I18n.T("Reg") @Hl(s.RegNo, findTokens)</span> }
                                                </div>
                                            </div>
                                            <div class="px-dd-side">
                                                <b>@I18n.FormatCurrency((s.Total ?? 0) - (s.Discount ?? 0))</b>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (memo == null)
                {
                    <div class="px-finder-empty">
                        <div class="icon">🧾</div>
                        <h3>@I18n.T("Find the original bill to start a return")</h3>
                        <ul>
                            <li>📷 @I18n.T("Scan the QR / barcode printed on the customer's receipt")</li>
                            <li>⌨️ @I18n.T("Type the bill number, customer name, mobile or IPD reg #")</li>
                            <li>👉 @I18n.T("Or pick a bill from the Recent Bills list on the right")</li>
                        </ul>
                    </div>
                }
                else
                {
                    <div class="px-bill-strip">
                        <div><span>@I18n.T("Original Bill")</span><b>#PH-@memo.ID</b></div>
                        <div><span>@I18n.T("Customer")</span><b title="@memo.Name">@memo.Name</b></div>
                        <div><span>@I18n.T("Date")</span><b>@memo.TransDate.ToString("dd MMM yyyy")</b></div>
                        <div><span>@I18n.T("Mode")</span><b>@(memo.PatientType == "2" ? (memo.IsCredit == true ? $"IPD Bed Bill ({memo.RegNo})" : $"IPD Cash ({memo.RegNo})") : "OPD Cash")</b></div>
                        <div><span>@I18n.T("Bill Net")</span><b>@I18n.FormatCurrency(OriginalNet)</b></div>
                        @if (priorRefund > 0)
                        {
                            <div><span>@I18n.T("Already Refunded")</span><b class="bad">@I18n.FormatCurrency(priorRefund)</b></div>
                        }
                    </div>

                    @if (savedReturn == null)
                    {
                        <div class="px-table-tools">
                            <h3>@I18n.T("Select items & quantity to return")</h3>
                            <div>
                                <button type="button" class="px-btn" @onclick="ReturnAll" disabled="@(!drafts.Any(d => d.Max > 0))">@I18n.T("Return All")</button>
                                <button type="button" class="px-btn" @onclick="ClearDrafts" disabled="@(!drafts.Any(d => d.Qty > 0))">@I18n.T("Clear")</button>
                            </div>
                        </div>

                        <div class="px-cart px-ret-table">
                            <div class="px-cart-head">
                                <div>#</div>
                                <div>@I18n.T("Medicine")</div>
                                <div class="r">@I18n.T("Sold")</div>
                                <div class="r">@I18n.T("Returned")</div>
                                <div class="r">@I18n.T("Rate")</div>
                                <div class="c">@I18n.T("Return Qty")</div>
                                <div class="c">@I18n.T("Restock")</div>
                                <div class="r">@I18n.T("Amount")</div>
                            </div>
                            <div class="px-cart-rows">
                                @for (var i = 0; i < drafts.Count; i++)
                                {
                                    var d = drafts[i];
                                    <div class="px-cart-row @(d.Max <= 0 ? "done" : d.Qty > 0 ? "picked" : "")">
                                        <div class="muted">@(i + 1)</div>
                                        <div class="px-cart-name">
                                            <b title="@MedicineName(d.Item.ServiceID)">@MedicineName(d.Item.ServiceID)</b>
                                            @if (!string.IsNullOrWhiteSpace(d.BatchText))
                                            {
                                                <small>B: @d.BatchText</small>
                                            }
                                        </div>
                                        <div class="r">@((d.Item.Quantity ?? 0).ToString("0.##"))</div>
                                        <div class="r muted">@(d.AlreadyReturned > 0 ? d.AlreadyReturned.ToString("0.##") : "—")</div>
                                        <div class="r">@I18n.FormatCurrency(d.Item.Rate ?? 0)</div>
                                        <div class="c">
                                            @if (d.Max > 0)
                                            {
                                                <div class="px-stepper">
                                                    <button type="button" @onclick="() => StepDraft(d, -1)" disabled="@(d.Qty <= 0)">−</button>
                                                    <input type="number" min="0" max="@d.Max" value="@d.Qty.ToString("0.##")" @onchange="e => SetDraft(d, e.Value?.ToString())" />
                                                    <button type="button" @onclick="() => StepDraft(d, 1)" disabled="@(d.Qty >= d.Max)">+</button>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="px-tag gray">@I18n.T("Fully returned")</span>
                                            }
                                        </div>
                                        <div class="c">
                                            @if (d.Max > 0)
                                            {
                                                @if (d.CanRestock)
                                                {
                                                    <label class="px-toggle" title="@(d.Restock ? I18n.T("Goes back to sellable stock") : I18n.T("Damaged / quarantine - not restocked"))">
                                                        <input type="checkbox" checked="@d.Restock" @onchange="e => d.Restock = e.Value is true" />
                                                        @(d.Restock ? I18n.T("Yes") : I18n.T("Damaged"))
                                                    </label>
                                                }
                                                else
                                                {
                                                    <span class="px-tag gray" title="@I18n.T("Original batch not found - will be recorded as damaged")">@I18n.T("No batch")</span>
                                                }
                                            }
                                        </div>
                                        <div class="r strong">@(d.Qty > 0 ? I18n.FormatCurrency(d.Qty * (d.Item.Rate ?? 0)) : "—")</div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="px-cart px-ret-table view">
                            <div class="px-cart-head">
                                <div>#</div>
                                <div>@I18n.T("Medicine")</div>
                                <div class="r">@I18n.T("Qty")</div>
                                <div class="r">@I18n.T("Rate")</div>
                                <div>@I18n.T("Stock Action")</div>
                                <div class="r">@I18n.T("Amount")</div>
                            </div>
                            <div class="px-cart-rows">
                                @for (var i = 0; i < lines.Count; i++)
                                {
                                    var x = lines[i];
                                    <div class="px-cart-row">
                                        <div class="muted">@(i + 1)</div>
                                        <div class="px-cart-name"><b>@MedicineName(x.ServiceID)</b></div>
                                        <div class="r">@x.Quantity.ToString("0.##")</div>
                                        <div class="r">@I18n.FormatCurrency(x.Rate)</div>
                                        <div><span class="px-tag @(x.StockBalanceID > 0 ? "green" : "gray")">@(x.StockBalanceID > 0 ? I18n.T("Restocked") : I18n.T("Damaged / Quarantine"))</span></div>
                                        <div class="r strong">@I18n.FormatCurrency(x.Gross)</div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="px-reason-row">
                        <div class="px-panel" style="display:flex; flex-direction:column; gap:6px;">
                            <div class="px-field">
                                <span>@I18n.T("Return Reason") <i>*</i></span>
                                <input type="text" @bind="reason" @bind:event="oninput" maxlength="500" placeholder="@I18n.T("Why is the customer returning?")" disabled="@(savedReturn != null)" />
                            </div>
                            @if (savedReturn == null)
                            {
                                <div class="px-reason-chips">
                                    @foreach (var r in QuickReasons)
                                    {
                                        var text = r.Value;
                                        <button type="button" class="@(reason == text ? "on" : "")" @onclick="() => reason = text">@I18n.T(r.Key)</button>
                                    }
                                </div>
                            }
                        </div>
                        <div class="px-totals">
                            <div><span>@I18n.T("Items")</span><b>@ReturnItemCount (@ReturnUnits.ToString("0.##") @I18n.T("units"))</b></div>
                            <div><span>@I18n.T("Return Value")</span><b>@I18n.FormatCurrency(ReturnGross)</b></div>
                            @if ((memo.Discount ?? 0) > 0)
                            {
                                <div><span>@I18n.T("Less bill discount share")</span><b>-@I18n.FormatCurrency(Math.Max(0, ReturnGross - (savedReturn?.RefundAmount ?? EstimatedRefund)))</b></div>
                            }
                            <div class="grand refund">
                                <span>@(IsCreditMemo ? I18n.T("Bed Bill Credit") : I18n.T("Cash Refund"))</span>
                                <b>@I18n.FormatCurrency(savedReturn?.RefundAmount ?? EstimatedRefund)</b>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (memo != null)
            {
                <footer class="px-card-foot">
                    <span class="px-print-fmt">
                        @if (savedReturn == null)
                        {
                            @(ReturnItemCount == 0 ? I18n.T("Set a return quantity on at least one item.") : string.IsNullOrWhiteSpace(reason) ? I18n.T("Enter a return reason to continue.") : I18n.T("Ready to post."))
                        }
                        else
                        {
                            @($"{I18n.T("Posted on")} {savedReturn.TransDate:dd MMM yyyy, hh:mm tt}")
                        }
                    </span>
                    <div class="px-foot-actions">
                        @if (savedReturn == null)
                        {
                            <button type="button" class="px-btn" @onclick="Reset">@I18n.T("Cancel")</button>
                            <button type="button" class="px-btn" @onclick="() => PostAsync(false)" disabled="@(!CanPost)">@I18n.T("Confirm Return")</button>
                            <button type="button" class="px-btn danger lg" @onclick="() => PostAsync(true)" disabled="@(!CanPost)">
                                @(isSaving ? I18n.T("Saving…") : $"{I18n.T("Confirm & Print")} · {I18n.FormatCurrency(EstimatedRefund)}")
                            </button>
                        }
                        else
                        {
                            <button type="button" class="px-btn" @onclick="PrintThermalAsync">🖨 @I18n.T("Print 80mm Slip")</button>
                            <button type="button" class="px-btn" @onclick="PrintA4Async">🖨 @I18n.T("Print A4 Voucher")</button>
                            <button type="button" class="px-btn primary lg" @onclick="Reset">+ @I18n.T("New Return")</button>
                        }
                    </div>
                </footer>
            }
        </section>

        <!-- Right: recent bills / returns -->
        <aside class="px-card">
            <header class="px-card-head stack">
                <div class="px-seg full">
                    <button type="button" class="@(rightTab == "bills" ? "on" : "")" @onclick='() => rightTab = "bills"'>@I18n.T("Recent Bills") <span class="px-count">@recentBills.Count</span></button>
                    <button type="button" class="@(rightTab == "returns" ? "on" : "")" @onclick='() => rightTab = "returns"'>@I18n.T("Returns") <span class="px-count warn">@recent.Count</span></button>
                </div>
                <div class="px-search-box sm">
                    <span class="px-search-icon">🔍</span>
                    <input type="text"
                           placeholder="@(rightTab == "bills" ? I18n.T("Bill #, name, mobile or reg...") : I18n.T("RET #, bill #, customer or reason..."))"
                           @bind="rightSearch" @bind:event="oninput" autocomplete="off" />
                    @if (!string.IsNullOrWhiteSpace(rightSearch))
                    {
                        <button type="button" class="px-x" @onclick='() => rightSearch = ""'>✕</button>
                    }
                </div>
            </header>

            <div class="px-queue">
                @if (rightTab == "bills")
                {
                    var bills = FilteredBills.ToList();
                    @if (bills.Count == 0)
                    {
                        <div class="px-empty sm">@(string.IsNullOrWhiteSpace(rightSearch) ? I18n.T("No bills in the last 7 days.") : I18n.T("No bill matches. Use the Find Bill box for older bills."))</div>
                    }
                    @foreach (var x in bills)
                    {
                        <button type="button" class="px-q-item @(memo?.ID == x.ID ? "active" : "")" @onclick="() => OpenMemoAsync(x.ID)">
                            <span class="px-q-id">#@Hl(x.ID.ToString(), rightTokens)</span>
                            <span class="px-q-info">
                                <span class="px-q-name">
                                    @Hl(x.Name, rightTokens)
                                    @if (x.PatientType == "2")
                                    {
                                        <span class="px-tag @(x.IsCredit == true ? "violet" : "blue")">@(x.IsCredit == true ? "IPD Bill" : "IPD Cash")</span>
                                    }
                                    @if (returnedMemoIds.Contains(x.ID))
                                    {
                                        <span class="px-tag gray">@I18n.T("returned")</span>
                                    }
                                </span>
                                <span class="px-q-meta">
                                    @x.TransDate.ToString("dd MMM, hh:mm tt")
                                    @if (!string.IsNullOrWhiteSpace(x.Contact)) { <text> · @Hl(x.Contact, rightTokens)</text> }
                                    @if (!string.IsNullOrWhiteSpace(x.RegNo)) { <text> · @Hl(x.RegNo, rightTokens)</text> }
                                </span>
                            </span>
                            <span class="px-q-amt">@I18n.FormatCurrency((x.Total ?? 0) - (x.Discount ?? 0))</span>
                        </button>
                    }
                }
                else
                {
                    var rets = FilteredReturns.ToList();
                    @if (rets.Count == 0)
                    {
                        <div class="px-empty sm">@(string.IsNullOrWhiteSpace(rightSearch) ? I18n.T("No return records yet.") : I18n.T("No return matches your search."))</div>
                    }
                    @foreach (var x in rets)
                    {
                        <button type="button" class="px-q-item @(savedReturn?.ID == x.ID ? "active" : "")" @onclick="() => OpenReturnAsync(x.ID)">
                            <span class="px-q-id">RET-@Hl(x.ID.ToString(), rightTokens)</span>
                            <span class="px-q-info">
                                <span class="px-q-name">@Hl(memoNames.GetValueOrDefault(x.CashMemoID, "—"), rightTokens)</span>
                                <span class="px-q-meta">#PH-@Hl(x.CashMemoID.ToString(), rightTokens) · @x.TransDate.ToString("dd MMM, hh:mm tt") · @Hl(x.Reason, rightTokens)</span>
                            </span>
                            <span class="px-q-amt bad">-@I18n.FormatCurrency(x.RefundAmount)</span>
                        </button>
                    }
                }
            </div>
        </aside>
    </div>
</div>

@if (savedReturn != null && memo != null)
{
    <!-- Official A4 Sales Return / Refund Voucher -->
    <div id="sales-return-print" class="print-sheet panel print-document print-a4-sheet pharm-print-only">
        <PrintDocumentHeader Title="@I18n.T("Pharmacy Sales Return & Refund Voucher")"
                             SubTitle="@I18n.T("Hospital Pharmacy")"
                             DocumentNo="@($"RET-{savedReturn.ID}")"
                             BarcodeCode="@($"RET-{savedReturn.ID}")"
                             QrPayload="@BarcodeQr.GeneratePharmacyQrPayload(savedReturn.ID, memo.Name, savedReturn.RefundAmount)" />

        <div class="print-grid">
            <div><span>@I18n.T("Original Bill No"):</span> <b>#PH-@memo.ID</b></div>
            <div><span>@I18n.T("Customer / Patient"):</span> <b>@memo.Name</b></div>
            <div><span>@I18n.T("Return Date"):</span> <b>@savedReturn.TransDate.ToString("dd MMM yyyy hh:mm tt")</b></div>
            <div><span>@I18n.T("Reason"):</span> <b>@savedReturn.Reason</b></div>
        </div>

        <table class="data-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>@I18n.T("Medicine")</th>
                    <th class="num">@I18n.T("Returned Qty")</th>
                    <th class="num">@I18n.T("Unit Rate")</th>
                    <th>@I18n.T("Stock Action")</th>
                    <th class="num">@I18n.T("Amount")</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < lines.Count; i++)
                {
                    var x = lines[i];
                    <tr>
                        <td>@(i + 1)</td>
                        <td><b>@MedicineName(x.ServiceID)</b></td>
                        <td class="num">@x.Quantity</td>
                        <td class="num">@I18n.FormatCurrency(x.Rate)</td>
                        <td>@(x.StockBalanceID > 0 ? I18n.T("Restocked") : I18n.T("Quarantined"))</td>
                        <td class="num">@I18n.FormatCurrency(x.Gross)</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="print-total">
            <div class="grand">
                <span>@(memo.IsCredit == true ? I18n.T("IPD Bed Bill Credit") : I18n.T("Total Cash Refund"))</span>
                <b>@I18n.FormatCurrency(savedReturn.RefundAmount)</b>
            </div>
        </div>

        <PrintDocumentFooter Signatures='new string[] { I18n.T("Customer Signature"), I18n.T("Pharmacist"), I18n.T("Cashier") }' />
    </div>

    <!-- 80mm Thermal Refund Slip -->
    <div id="sales-return-thermal-print" class="pos-receipt-80mm pharm-print-only">
        <div class="pos-thermal-header">
            <div class="pos-thermal-title">@Branding.HospitalName</div>
            <div style="font-size:10px; font-weight:700;">@I18n.T("PHARMACY RETURN SLIP")</div>
            <div class="pos-thermal-meta">
                <div><b>@($"VOUCHER: #RET-{savedReturn.ID}")</b> (Bill #PH-@memo.ID)</div>
                <div>@savedReturn.TransDate.ToString("dd/MM/yyyy hh:mm tt")</div>
                <div>@I18n.T("Customer"): @memo.Name</div>
            </div>
        </div>
        <table class="pos-thermal-table">
            <thead>
                <tr>
                    <th>@I18n.T("Medicine")</th>
                    <th style="text-align:right;">@I18n.T("Qty")</th>
                    <th style="text-align:right;">@I18n.T("Total")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in lines)
                {
                    <tr>
                        <td><b>@MedicineName(x.ServiceID)</b></td>
                        <td style="text-align:right;">@x.Quantity</td>
                        <td style="text-align:right;">@I18n.FormatCurrency(x.Gross)</td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="pos-thermal-summary">
            <div class="pos-thermal-row grand">
                <span>@I18n.T("Refund"):</span>
                <span>@I18n.FormatCurrency(savedReturn.RefundAmount)</span>
            </div>
        </div>
        <PrintDeveloperFooter Compact="true" />
    </div>
}

@code {
    private ElementReference findInputRef;

    private Dictionary<int, string> medicineNames = [];
    private List<MedicineStoreBalance> stocks = [];
    private List<PharmacySalesReturn> recent = [];
