                            </div>
                            <div class="patient-grid-item">
                                <span class="grid-label">@(isBangla ? "বয়স / লিঙ্গ" : "Age / Gender"):</span>
                                <strong class="grid-value">@memo.Age / @memo.Sex</strong>
                            </div>
                            <div class="patient-grid-item">
                                <span class="grid-label">@(isBangla ? "মোবাইল নম্বর" : "Contact No"):</span>
                                <strong class="grid-value">@(memo.Contact ?? "—")</strong>
                            </div>
                            <div class="patient-grid-item">
                                <span class="grid-label">@(isBangla ? "ইনভয়েস / বিল নং" : "Invoice / Memo #"):</span>
                                <strong class="grid-value">#@memo.ID</strong>
                            </div>
                            <div class="patient-grid-item">
                                <span class="grid-label">@(isBangla ? "নমুনা আইডি (Specimen ID)" : "Specimen / Tube ID"):</span>
                                <strong class="grid-value">SMP-@memo.ID</strong>
                            </div>
                            <div class="patient-grid-item span-2">
                                <span class="grid-label">@(isBangla ? "রেফারেল চিকিৎসক" : "Referred By Doctor"):</span>
                                <strong class="grid-value">@DoctorName(memo.DoctorID)</strong>
                            </div>
                            <div class="patient-grid-item">
                                <span class="grid-label">@(isBangla ? "নমুনা সংগ্রহের সময়" : "Sample Collected"):</span>
                                <strong class="grid-value">@(sampleCollectionDate?.ToString("dd MMM yyyy, hh:mm tt") ?? memo.TransDate.ToString("dd MMM yyyy"))</strong>
                            </div>
                            <div class="patient-grid-item">
                                <span class="grid-label">@(isBangla ? "রিপোর্ট প্রকাশের সময়" : "Report Released"):</span>
                                <strong class="grid-value">@(reportReleaseDate?.ToString("dd MMM yyyy, hh:mm tt") ?? DateTime.Now.ToString("dd MMM yyyy"))</strong>
                            </div>
                        </div>

                        <!-- Investigation Test Results -->
                        @foreach (var group in resultsByService)
                        {
                            var sName = ServiceName(group.Key);
                            <div class="report-investigation-block">
                                <div class="investigation-title-bar">
                                    <h3 class="investigation-name">🔬 @sName</h3>
                                    <span class="investigation-badge">@(isBangla ? "ভেরিফাইড টেস্ট" : "VERIFIED TEST")</span>
                                </div>

                                <table class="report-parameter-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 32%;">@(isBangla ? "টেস্ট প্যারামিটার" : "Investigation Parameter")</th>
                                            <th class="text-center" style="width: 20%;">@(isBangla ? "ফলাফল (Observed Result)" : "Observed Result")</th>
                                            <th class="text-center" style="width: 14%;">@(isBangla ? "একক (Unit)" : "Unit")</th>
                                            <th style="width: 22%;">@(isBangla ? "স্বাভাবিক রেফারেন্স মান" : "Reference Range")</th>
                                            <th class="text-center" style="width: 12%;">@(isBangla ? "স্ট্যাটাস" : "Status")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var res in group.Value)
                                        {
                                            var flagClass = (res.Flag ?? "Normal").ToLowerInvariant() switch
                                            {
                                                "high" => "flag-high",
                                                "low" => "flag-low",
                                                "critical" => "flag-critical",
                                                "positive" => "flag-high",
                                                _ => "flag-normal"
                                            };
                                            <tr>
                                                <td class="param-name"><b>@res.ParameterName</b></td>
                                                <td class="param-value text-center">
                                                    <span class="value-highlight @flagClass">@res.ResultValue</span>
                                                </td>
                                                <td class="param-unit text-center">@(res.Unit ?? "—")</td>
                                                <td class="param-range">@(res.ReferenceRange ?? "—")</td>
                                                <td class="param-flag text-center">
                                                    <span class="flag-pill @flagClass">
