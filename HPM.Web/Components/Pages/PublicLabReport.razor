                        <!-- Standardized Report Footer with Verbatim Legal Disclaimer Notice -->
                        <PrintDocumentFooter Signatures='new string[] { isBangla ? "মেডিকেল টেকনোলজিস্ট (ল্যাব)" : "Medical Technologist (Lab)", DoctorName(verifyingDoctorId) }' />
