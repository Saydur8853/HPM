        </div>
    </main>

    <footer class="portal-footer no-print">
        <p>&copy; @DateTime.Now.Year @Branding.HospitalName. All rights reserved. &bull; Universal Patient Diagnostic Portal</p>
    </footer>
</div>

@code {
    [Parameter] public long? Id { get; set; }
    [SupplyParameterFromQuery(Name = "inv")] public long? QueryInv { get; set; }

    public class MatchedReportItem
    {
        public long ID { get; set; }
        public string? PatientID { get; set; }
        public string PatientName { get; set; } = "";
        public string? Contact { get; set; }
        public string? Age { get; set; }
        public string? Sex { get; set; }
        public DateTime TransDate { get; set; }
        public decimal Total { get; set; }
        public decimal Discount { get; set; }
        public decimal Paid { get; set; }
        public decimal DueAmount => Math.Max(0, (Total - Discount) - Paid);
        public bool IsPaidInFull => DueAmount <= 0.01m;
        public bool IsAuthRelease { get; set; }
        public int? DoctorID { get; set; }
        public List<string> TestNames { get; set; } = [];
        public bool HasResults { get; set; }
        public bool IsVerified { get; set; }
        public bool CanView => IsPaidInFull || IsAuthRelease;
    }

    private CashMemoDInvestigation? memo;
    private List<MatchedReportItem> matchedReports = [];
    private List<CashMemoSubDInvestigation> orderItems = [];
    private List<LabSampleCollection> sampleCollections = [];
    private List<LabTestResult> allResults = [];
    private Dictionary<int, List<LabTestResult>> resultsByService = [];
    private List<DoctorsProfile> doctors = [];
    private List<Service> services = [];

    private bool isLoading = true;
    private bool isPublished = false;
    private bool hasSampleCollected = false;
    private DateTime? sampleCollectionDate;
    private DateTime? reportReleaseDate;
    private DateTime expectedDeliveryDate = DateTime.Now;
    private int? verifyingDoctorId;
    private string errorMessage = "";
    private string searchQuery = "";
    private bool isBangla = false;

    // Payment & Access Control
    private decimal grossTotal = 0;
    private decimal discount = 0;
    private decimal netPayable = 0;
    private decimal paidAmount = 0;
    private decimal dueAmount = 0;
    private bool isPaidInFull = false;
    private bool isAuthorizedRelease = false;
    private bool canViewReport = false;

    protected override async Task OnInitializedAsync()
    {
        var targetId = Id ?? QueryInv;
        if (targetId.HasValue && targetId.Value > 0)
        {
            await LoadReportAsync(targetId.Value);
        }
        else
        {
            isLoading = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var targetId = Id ?? QueryInv;
        if (targetId.HasValue && targetId.Value > 0 && (memo == null || memo.ID != targetId.Value))
        {
            await LoadReportAsync(targetId.Value);
        }
    }

    private void ToggleLanguage()
    {
        isBangla = !isBangla;
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchReportsAsync();
        }
    }

    private async Task SearchReportsAsync()
    {
        errorMessage = "";
        var q = searchQuery?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(q))
        {
            errorMessage = isBangla
                ? "অনুগ্রহ করে পেশেন্ট আইডি (PID), মোবাইল নম্বর বা বিল নম্বর লিখুন।"
                : "Please enter a valid Patient ID, Mobile Number, or Memo / Invoice No.";
            return;
        }

        isLoading = true;
        memo = null;
        matchedReports.Clear();

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            doctors = await db.Doctors.AsNoTracking().ToListAsync();
            services = await db.Services.AsNoTracking().ToListAsync();

            // Extract numeric or clean identifier if prefixed e.g. PAT-10084, LAB-1001, SMP-1001
            var cleanQ = q;
            if (cleanQ.StartsWith("LAB-", StringComparison.OrdinalIgnoreCase)) cleanQ = cleanQ.Substring(4);
            if (cleanQ.StartsWith("PAT-", StringComparison.OrdinalIgnoreCase)) cleanQ = cleanQ.Substring(4);
            if (cleanQ.StartsWith("SMP-", StringComparison.OrdinalIgnoreCase))
            {
                var parts = cleanQ.Substring(4).Split('-');
                if (parts.Length > 0) cleanQ = parts[0];
            }

            long.TryParse(cleanQ, out var parsedNum);

            // 1. Find matching patient in Registrations table if any
            var matchedPatients = await db.Registrations.AsNoTracking()
                .Where(p => p.PatientID == q || p.PatientID == cleanQ || p.Contact == q || p.Contact == cleanQ || (parsedNum > 0 && p.ID == parsedNum))
                .ToListAsync();

            var patientIds = matchedPatients.Select(p => p.PatientID).Where(p => !string.IsNullOrWhiteSpace(p)).ToList();
            var patientContacts = matchedPatients.Select(p => p.Contact).Where(c => !string.IsNullOrWhiteSpace(c)).ToList();

            // 2. Query EmergencyMemos for Diagnostic orders (ModuleID == 2 or 11)
            var query = db.EmergencyMemos.AsNoTracking()
                .Include(m => m.Items)
                .Where(m => m.ModuleID == 2 || m.ModuleID == 11);

            // Match criteria:
            // - Direct Memo ID match
            // - PatientID matches query or any matched patient's PatientID
            // - Contact matches query or any matched patient's Contact
            // - PatientName matches query
            var rawMemos = await query
                .Where(m => (parsedNum > 0 && m.ID == parsedNum) ||
                            (m.PatientID != null && (m.PatientID == q || m.PatientID == cleanQ || (patientIds.Count > 0 && patientIds.Contains(m.PatientID)))) ||
                            (m.Contact != null && (m.Contact == q || m.Contact == cleanQ || (patientContacts.Count > 0 && patientContacts.Contains(m.Contact)))) ||
                            (q.Length >= 3 && m.PatientName.ToLower().Contains(q.ToLower())))
                .OrderByDescending(m => m.TransDate)
                .ToListAsync();

            if (rawMemos.Count == 0)
            {
                errorMessage = isBangla
                    ? $"'{q}' দিয়ে কোনো ডায়াগনস্টিক রিপোর্ট বা মেমো পাওয়া যায়নি। অনুগ্রহ করে সঠিক তথ্য প্রদান করুন।"
                    : $"No diagnostic reports found matching '{q}'. Please verify your Patient ID, Mobile, or Memo #.";
                isLoading = false;
                return;
            }

            // Fetch test results for these memos to compute status
            var memoIds = rawMemos.Select(m => m.ID).ToList();
            var allResultsForMemos = await db.LabTestResults.AsNoTracking()
                .Where(r => memoIds.Contains(r.MemoID))
                .ToListAsync();

            matchedReports = rawMemos.Select(m =>
            {
                var mResults = allResultsForMemos.Where(r => r.MemoID == m.ID).ToList();
                var hasEntered = mResults.Any(r => !string.IsNullOrWhiteSpace(r.ResultValue));
                var isVer = mResults.Count > 0 && mResults.All(r => r.IsVerified);
                var isAuth = !string.IsNullOrWhiteSpace(m.Remarks) &&
                             (m.Remarks.Contains("[AUTH_RELEASE]", StringComparison.OrdinalIgnoreCase) ||
                              m.Remarks.Contains("Authorized Release", StringComparison.OrdinalIgnoreCase));

                return new MatchedReportItem
                {
                    ID = m.ID,
                    PatientID = m.PatientID,
                    PatientName = m.PatientName,
                    Contact = m.Contact,
                    Age = m.Age,
                    Sex = m.Sex,
                    TransDate = m.TransDate,
                    Total = m.Total,
                    Discount = m.Discount,
                    Paid = m.Paid,
                    IsAuthRelease = isAuth,
                    DoctorID = m.DoctorID,
                    TestNames = m.Items.Select(i => ServiceName(i.TestID)).ToList(),
                    HasResults = hasEntered,
                    IsVerified = isVer || (hasEntered && mResults.Any(r => r.IsVerified))
                };
            }).OrderByDescending(m => m.TransDate).ToList();

            if (matchedReports.Count == 1)
            {
                // Single report found: directly load
                await LoadReportAsync(matchedReports[0].ID);
            }
            else
            {
                // Multiple reports found: display list with latest 1st
                isLoading = false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = isBangla ? $"অনুসন্ধানে সমস্যা হয়েছে: {ex.Message}" : $"Search error: {ex.Message}";
            isLoading = false;
        }
    }

    private async Task SelectReport(long memoId)
    {
        await LoadReportAsync(memoId);
    }

    private void BackToReportsList()
    {
        memo = null;
        isLoading = false;
    }

    private async Task ReloadCurrentMemoAsync()
    {
        if (memo != null)
        {
            await LoadReportAsync(memo.ID);
        }
    }

    private void ResetSearch()
    {
        memo = null;
        matchedReports.Clear();
        orderItems.Clear();
        sampleCollections.Clear();
        allResults.Clear();
        resultsByService.Clear();
        errorMessage = "";
        searchQuery = "";
        isPublished = false;
        canViewReport = false;
        isPaidInFull = false;
        isAuthorizedRelease = false;
        dueAmount = 0;
        netPayable = 0;
        paidAmount = 0;
        isLoading = false;
    }

    private async Task LoadReportAsync(long memoId)
    {
        isLoading = true;
        errorMessage = "";
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            doctors = await db.Doctors.AsNoTracking().ToListAsync();
            services = await db.Services.AsNoTracking().ToListAsync();

            memo = await db.EmergencyMemos.AsNoTracking()
                .Include(x => x.Items)
                .FirstOrDefaultAsync(x => x.ID == memoId && (x.ModuleID == 2 || x.ModuleID == 11));

            if (memo == null)
            {
                errorMessage = isBangla
                    ? $"ইনভয়েস #{memoId} পাওয়া যায়নি। অনুগ্রহ করে সঠিক বিল নম্বর নিশ্চিত করুন।"
                    : $"Invoice #{memoId} was not found. Please check the number on your payment receipt.";
                isLoading = false;
                return;
            }

            // Calculate financial & due status
            grossTotal = memo.Total;
            discount = memo.Discount;
            netPayable = Math.Max(0, memo.Total - memo.Discount);
            paidAmount = memo.Paid;
            dueAmount = Math.Max(0, netPayable - memo.Paid);
            isPaidInFull = dueAmount <= 0.01m;
            isAuthorizedRelease = !string.IsNullOrWhiteSpace(memo.Remarks) &&
                                  (memo.Remarks.Contains("[AUTH_RELEASE]", StringComparison.OrdinalIgnoreCase) ||
                                   memo.Remarks.Contains("Authorized Release", StringComparison.OrdinalIgnoreCase));
            canViewReport = isPaidInFull || isAuthorizedRelease;

            orderItems = memo.Items.ToList();
            sampleCollections = await db.LabSampleCollections.AsNoTracking()
                .Where(x => x.MemoID == memoId)
                .ToListAsync();

            allResults = await db.LabTestResults.AsNoTracking()
                .Where(x => x.MemoID == memoId)
                .ToListAsync();

            // Check sample status
            hasSampleCollected = sampleCollections.Any(x => x.Status == "Collected" || x.Status == "InProcess" || x.Status == "Completed");
            sampleCollectionDate = sampleCollections.Where(x => x.CollectedAt.HasValue).Select(x => x.CollectedAt).FirstOrDefault() ?? memo.TransDate;

            // Group results by service
            resultsByService = allResults
                .Where(x => !string.IsNullOrWhiteSpace(x.ResultValue))
                .GroupBy(x => x.ServiceID)
                .ToDictionary(g => g.Key, g => g.ToList());

            // Estimated Delivery: standard 12 to 24 hours from billing
            expectedDeliveryDate = memo.TransDate.AddHours(24);

            // Determine if published: must have results and at least verified or results entered
            var hasEnteredResults = allResults.Count > 0 && allResults.Any(x => !string.IsNullOrWhiteSpace(x.ResultValue));
            var areResultsVerified = allResults.Count > 0 && allResults.All(x => x.IsVerified);

            isPublished = hasEnteredResults && (areResultsVerified || allResults.Any(x => x.IsVerified));

            if (isPublished)
            {
                reportReleaseDate = allResults.Where(x => x.ReportedAt.HasValue).Select(x => x.ReportedAt).Max() ?? DateTime.Now;
                verifyingDoctorId = allResults.Where(x => x.ReportedBy.HasValue).Select(x => x.ReportedBy).FirstOrDefault() ?? memo.DoctorID;
            }
        }
        catch (Exception ex)
        {
            errorMessage = isBangla
                ? $"তথ্য লোড করতে সমস্যা হয়েছে: {ex.Message}"
                : $"Failed to load report: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string ServiceName(int id) => services.FirstOrDefault(x => x.ID == id)?.Name ?? $"Test #{id}";

    private string DoctorName(int? id)
    {
        var d = doctors.FirstOrDefault(x => x.ID == id);
        return d == null ? (isBangla ? "কনসালটেন্ট প্যাথলজিস্ট" : "Consultant Pathologist") : $"{d.Title} {d.Name}";
    }

    private async Task PrintReportAsync()
    {
        if (memo != null)
        {
            await JS.InvokeVoidAsync("window.hpm.printElement", "printable-sheet", $"Diagnostic Report #{memo.ID}");
        }
        else
        {
            await JS.InvokeVoidAsync("window.print");
        }
    }
}
