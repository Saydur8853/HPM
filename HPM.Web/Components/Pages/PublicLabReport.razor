@page "/portal/report"
@page "/portal/report/{Id:long}"
@attribute [AllowAnonymous]
@layout Layout.LoginLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IBarcodeQrService BarcodeQr
@using HPM.Web.Data
@using HPM.Web.Data.Entities
@using HPM.Web.Localization
@using HPM.Web.Services
@using HPM.Web.Components.Common
@using Microsoft.EntityFrameworkCore

<PageTitle>@((isPublished && canViewReport && memo != null) ? $"Diagnostic Report #{memo.ID} - {memo.PatientName}" : "Patient Diagnostic Report Portal") | @Branding.HospitalName</PageTitle>

<div class="portal-wrapper">
    <header class="portal-header">
        <div class="portal-header-content">
            <div class="portal-brand">
                @if (!string.IsNullOrWhiteSpace(Branding.LogoData))
                {
                    <img src="@Branding.LogoData" alt="Logo" class="portal-logo-img" style="max-height: 48px; max-width: 55px; object-fit: contain; border-radius: 6px;" />
                }
                else
                {
                    <div class="portal-brand-logo">🏥</div>
                }
                <div>
                    <h1 class="portal-hospital-title">@Branding.HospitalName</h1>
                    <p class="portal-hospital-sub">@(string.IsNullOrWhiteSpace(Branding.Tagline) ? I18n.T("Official Diagnostic & Laboratory Patient Portal", "Official Diagnostic & Laboratory Patient Portal") : Branding.Tagline)</p>
                </div>
            </div>
            <div class="portal-header-actions">
                <button type="button" class="portal-lang-btn" @onclick="ToggleLanguage">
                    🌐 @(isBangla ? "English" : "বাংলা")
                </button>
            </div>
        </div>
    </header>

    <main class="portal-main">
        <div class="portal-card">
            @if (isLoading)
            {
                <div class="portal-loading">
                    <div class="portal-spinner"></div>
                    <h3>@(isBangla ? "রিপোর্ট তথ্য অনুসন্ধান করা হচ্ছে..." : "Loading diagnostic records...")</h3>
                    <p>@(isBangla ? "হাসপাতাল ডাটাবেজের সাথে সংযোগ স্থাপন করা হচ্ছে..." : "Connecting to official hospital laboratory system...")</p>
                </div>
            }
            else if (memo == null && matchedReports.Count == 0)
            {
                <!-- ================= 1. UNIVERSAL SEARCH BOX ================= -->
                <div class="portal-search-box">
                    <div class="portal-search-icon">🔍</div>
                    <h2>@(isBangla ? "রোগীর ডায়াগনস্টিক রিপোর্ট ও ফলাফল অনুসন্ধান" : "Universal Patient Diagnostic Report Search")</h2>
                    <p>
                        @(isBangla
                            ? "পেশেন্ট আইডি (PID), মোবাইল নম্বর বা মানি রিসিটের বিল নম্বর লিখে সকল রিপোর্ট অনুসন্ধান করুন:"
                            : "Enter Patient ID (e.g. P-10084), Registered Mobile Number, or Memo / Invoice No to view and download all reports:")
                    </p>

                    <div class="portal-search-form">
                        <input type="text"
                               class="portal-input"
                               placeholder="@(isBangla ? "পেশেন্ট আইডি (যেমন: P-10084), মোবাইল বা বিল নং" : "Enter Patient ID (P-10084), Mobile or Memo #")"
                               @bind="searchQuery"
                               @bind:event="oninput"
                               @onkeydown="HandleSearchKeyDown" />
                        <button type="button" class="portal-btn portal-btn-primary" @onclick="SearchReportsAsync">
                            @(isBangla ? "অনুসন্ধান করুন ➔" : "Search Reports ➔")
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="portal-alert portal-alert-danger">@errorMessage</div>
                    }

                    <div class="portal-help-note">
                        ℹ️ @(isBangla
                            ? "পেশেন্ট আইডি বা মোবাইল নম্বর দিয়ে সার্চ করলে রোগীর অতীত ও বর্তমানের সকল টেস্টের রিপোর্ট দেখতে পাবেন। সর্বশেষ রিপোর্টটি তালিকায় সবার প্রথমে প্রদর্শিত হবে।"
                            : "Searching by Patient ID or Mobile will list all historical and current investigations for this patient with the latest report shown first.")
                    </div>
                </div>
            }
            else if (memo == null && matchedReports.Count > 1)
            {
                <!-- ================= 2. MULTI-REPORT PATIENT PORTFOLIO LIST (LATEST 1ST) ================= -->
                <div class="portal-reports-list-container">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; flex-wrap:wrap; gap:10px;">
                        <div>
                            <span class="portal-status-badge portal-badge-success" style="font-size:11.5px; padding:4px 12px;">
                                📁 @(isBangla ? "রোগীর টেস্ট হিস্ট্রি ও রিপোর্ট তালিকা" : "PATIENT INVESTIGATION DOSSIER")
                            </span>
                        </div>
                        <button type="button" class="portal-btn portal-btn-secondary" style="padding:6px 14px; font-size:12px;" @onclick="ResetSearch">
                            🔍 @(isBangla ? "নতুন অনুসন্ধান" : "New Search")
                        </button>
                    </div>

                    <!-- Patient Summary Banner -->
                    @{
                        var primaryPatient = matchedReports.First();
                    }
                    <div class="patient-list-header-banner">
                        <div class="patient-banner-avatar">
                            @(string.IsNullOrWhiteSpace(primaryPatient.PatientName) ? "PT" : primaryPatient.PatientName.Substring(0, Math.Min(2, primaryPatient.PatientName.Length)).ToUpperInvariant())
                        </div>
                        <div class="patient-banner-info">
                            <h3>@primaryPatient.PatientName</h3>
                            <div class="patient-banner-meta">
                                <span class="patient-meta-pill">🆔 PID: @(primaryPatient.PatientID ?? (isBangla ? "বহির্বিভাগ" : "Walk-in"))</span>
                                @if (!string.IsNullOrWhiteSpace(primaryPatient.Contact))
                                {
                                    <span class="patient-meta-pill">📞 @primaryPatient.Contact</span>
                                }
                                <span class="patient-meta-pill">🎂 @primaryPatient.Age / @primaryPatient.Sex</span>
                                <span class="patient-meta-pill" style="background:#e0f2fe; border-color:#7dd3fc; color:#0369a1;">
                                    📊 @matchedReports.Count @(isBangla ? "টি টেস্ট ইনভয়েস পাওয়া গেছে" : "Diagnostic Orders Found")
                                </span>
                            </div>
                        </div>
                    </div>

                    <div style="margin-bottom:12px; font-size:13px; color:#475569; font-weight:600;">
                        @(isBangla ? "সকল রিপোর্ট কালানুক্রমিক সাজানো হয়েছে (সর্বশেষ রিপোর্ট উপরে):" : "All investigation reports sorted chronologically (newest on top):")
                    </div>

                    <!-- Chronological Reports List (Latest 1st) -->
                    <div class="portal-reports-grid">
                        @for (int i = 0; i < matchedReports.Count; i++)
                        {
                            var rep = matchedReports[i];
                            var isLatest = i == 0;
                            <div class="portal-report-card @(isLatest ? "latest-card" : "")">
                                <div class="report-card-top">
                                    <div style="display:flex; align-items:center; gap:8px;">
                                        <strong class="report-card-inv">Invoice #@rep.ID</strong>
                                        @if (isLatest)
                                        {
                                            <span class="report-badge-latest">🌟 @(isBangla ? "সর্বশেষ রিপোর্ট (LATEST)" : "LATEST REPORT")</span>
                                        }
                                    </div>
                                    <span class="report-card-date">
                                        📅 @rep.TransDate.ToString("dd MMM yyyy — hh:mm tt")
                                    </span>
                                </div>

                                <div class="report-card-body">
                                    @if (rep.TestNames.Count > 0)
                                    {
                                        <div class="report-tests-list">
                                            @foreach (var tName in rep.TestNames)
                                            {
                                                <span class="test-pill">🔬 @tName</span>
                                            }
                                        </div>
                                    }

                                    <div class="report-doctor-line">
                                        <span>👨‍⚕️ @(isBangla ? "রেফারেল ডাক্তার" : "Doctor"): <b>@DoctorName(rep.DoctorID)</b></span>
                                        <div>
                                            <span>@(isBangla ? "বিল" : "Bill"): <b>৳ @((rep.Total - rep.Discount).ToString("N2"))</b> &bull; </span>
                                            @if (rep.DueAmount > 0)
                                            {
                                                <span style="color:#dc2626; font-weight:700;">@(isBangla ? "বকেয়া" : "Due"): ৳ @rep.DueAmount.ToString("N2")</span>
                                            }
                                            else
                                            {
                                                <span style="color:#15803d; font-weight:700;">@(isBangla ? "পরিশোধিত (PAID)" : "PAID")</span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div style="display:flex; justify-content:space-between; align-items:center; padding-top:12px; border-top:1px solid #f1f5f9; flex-wrap:wrap; gap:8px;">
                                    <div>
                                        @if (rep.IsVerified && rep.CanView)
                                        {
                                            <span class="portal-status-badge portal-badge-success" style="font-size:11px; padding:4px 10px;">
                                                ✅ @(isBangla ? "ভেরিফাইড ও প্রস্তুত" : "VERIFIED & READY")
                                            </span>
                                        }
                                        else if (rep.IsVerified && !rep.CanView)
                                        {
                                            <span class="portal-status-badge portal-badge-due" style="font-size:11px; padding:4px 10px;">
                                                🔒 @(isBangla ? "বকেয়া পরিশোধ প্রয়োজন" : "PAYMENT DUE LOCKED")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="portal-status-badge portal-badge-pending" style="font-size:11px; padding:4px 10px;">
                                                ⏳ @(isBangla ? "ল্যাব প্রক্রিয়াকরণ চলছে" : "IN PROGRESS")
                                            </span>
                                        }
                                    </div>

                                    <div style="display:flex; gap:8px;">
                                        <button type="button" class="portal-btn portal-btn-primary" style="padding:6px 16px; font-size:12.5px;" @onclick="() => SelectReport(rep.ID)">
                                            👁️ @(isBangla ? "রিপোর্ট দেখুন ও প্রিন্ট করুন ➔" : "View & Print Official Report ➔")
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (memo != null && !isPublished)
            {
                <!-- ================= 3. STATE: RESULT NOT PUBLISHED YET ================= -->
                <div class="portal-pending-view">
                    @if (matchedReports.Count > 1)
                    {
                        <div style="margin-bottom:14px;">
                            <button type="button" class="portal-btn portal-btn-secondary" style="padding:4px 12px; font-size:11.5px;" @onclick="BackToReportsList">
                                ⬅ @(isBangla ? $"রোগীর সকল রিপোর্টে ফিরুন ({matchedReports.Count}টি রিপোর্ট)" : $"Back to All Reports ({matchedReports.Count} found)")
                            </button>
                        </div>
                    }

                    <div class="portal-status-badge portal-badge-pending">
                        <span class="status-pulse-dot"></span>
                        @(isBangla ? "প্রক্রিয়াধীন / রেজাল্ট প্রকাশের অপেক্ষায়" : "REPORT IN PROGRESS / PROCESSING")
                    </div>

                    <div class="portal-pending-hero">
                        <div class="portal-pending-icon-wrap">
                            <span class="portal-pending-icon">⏳</span>
                        </div>
                        <h2 class="portal-pending-title">
                            @(isBangla ? "আপনার পরীক্ষার রেজাল্ট এখনও প্রকাশিত হয়নি" : "The result didn't publish yet.")
                        </h2>
                        <p class="portal-pending-subtitle">
                            @(isBangla
                                ? $"ইনভয়েস #{memo.ID}-এর নমুনা ({memo.PatientName}) বর্তমানে ল্যাবরেটরিতে ক্লিনিক্যাল এনালাইসিস ও ডাক্তারের নিরীক্ষাধীন রয়েছে।"
                                : $"Sample for Invoice #{memo.ID} ({memo.PatientName}) is currently under clinical laboratory analysis and awaiting pathologist verification.")
                        </p>
                    </div>

                    <!-- Estimated Delivery Card -->
                    <div class="portal-countdown-card">
                        <div class="countdown-icon">📅</div>
                        <div class="countdown-content">
                            <span class="countdown-label">@(isBangla ? "সম্ভাব্য রিপোর্ট প্রকাশের সময় (Estimated Delivery):" : "Estimated Report Delivery Time:")</span>
                            <strong class="countdown-time">@expectedDeliveryDate.ToString("dd MMM yyyy — hh:mm tt")</strong>
                            <small class="countdown-note">
                                @(isBangla
                                    ? "সাধারণত টেস্ট সম্পন্ন হতে বিলিংয়ের সময় থেকে ১২ থেকে ২৪ ঘণ্টা সময় লাগে। অনুগ্রহ করে উল্লেখিত সময়ের পর পুনরায় রিফ্রেশ করুন।"
                                    : "Standard laboratory turnaround time is 12 to 24 hours from sample intake. Please check back after this time.")
                            </small>
                        </div>
                    </div>

                    <!-- Live Progress Timeline -->
                    <div class="portal-timeline-section">
                        <h4 class="timeline-title">@(isBangla ? "ল্যাবরেটরি প্রক্রিয়াকরণ ট্র্যাকার (Live Status)" : "Laboratory Processing Timeline")</h4>
                        <div class="portal-timeline">
                            <div class="timeline-step step-completed">
                                <div class="step-marker">✓</div>
                                <div class="step-details">
                                    <strong>@(isBangla ? "টেস্ট রেজিস্ট্রেশন ও বিলিং সম্পন্ন" : "Order Registered & Invoiced")</strong>
                                    <span>@memo.TransDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                                </div>
                            </div>
                            <div class="timeline-step @(hasSampleCollected ? "step-completed" : "step-active")">
                                <div class="step-marker">@(hasSampleCollected ? "✓" : "2")</div>
                                <div class="step-details">
                                    <strong>@(isBangla ? "নমুনা (Sample) সংগ্রহ ও ল্যাব গ্রহণ" : "Specimen Collected & Received at Lab")</strong>
                                    <span>@(hasSampleCollected ? (sampleCollectionDate?.ToString("dd MMM, hh:mm tt") ?? "Received in Lab") : (isBangla ? "নমুনা সংগ্রহের প্রক্রিয়া চলছে" : "Sample collection in progress"))</span>
                                </div>
                            </div>
                            <div class="timeline-step step-active">
                                <div class="step-marker"><span class="spinner-dot"></span></div>
                                <div class="step-details">
                                    <strong>@(isBangla ? "প্যাথলজি ল্যাব এনালাইসিস চলছে" : "Clinical Pathology Analysis in Progress")</strong>
                                    <span>@(isBangla ? "মেডিকেল টেকনোলজিস্ট দ্বারা পরীক্ষা সম্পন্ন হচ্ছে" : "Technicians are processing test parameters")</span>
                                </div>
                            </div>
                            <div class="timeline-step">
                                <div class="step-marker">4</div>
                                <div class="step-details">
                                    <strong>@(isBangla ? "ডাক্তার / কনসালটেন্ট প্যাথলজিস্ট সত্যায়ন" : "Consultant Review & Digital Verification")</strong>
                                    <span>@(isBangla ? "সত্যায়নের অপেক্ষায়" : "Awaiting specialist authorization")</span>
                                </div>
                            </div>
                            <div class="timeline-step">
                                <div class="step-marker">5</div>
                                <div class="step-details">
                                    <strong>@(isBangla ? "চূড়ান্ত রিপোর্ট প্রকাশ ও ডাউনলোড" : "Official Report Published")</strong>
                                    <span>@(isBangla ? "অনলাইন ও প্রিন্ট কপি সরবরাহ" : "Available for online view & download")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Actions & Helpdesk -->
                    <div class="portal-actions-row">
                        <button type="button" class="portal-btn portal-btn-primary" @onclick="ReloadCurrentMemoAsync">
                            🔄 @(isBangla ? "স্ট্যাটাস রিফ্রেশ করুন" : "Refresh Status")
                        </button>
                        @if (matchedReports.Count > 1)
                        {
                            <button type="button" class="portal-btn portal-btn-secondary" @onclick="BackToReportsList">
                                ⬅ @(isBangla ? "সকল রিপোর্ট তালিকা" : "All Reports List")
                            </button>
                        }
                        else
                        {
                            <button type="button" class="portal-btn portal-btn-secondary" @onclick="ResetSearch">
                                🔍 @(isBangla ? "অন্য ইনভয়েস খুঁজুন" : "Check Another Bill")
                            </button>
                        }
                    </div>

                    <div class="portal-support-card">
                        <div>
                            <strong>@(isBangla ? "জরুরি প্রয়োজনে ল্যাব হেল্পডেস্কে যোগাযোগ করুন:" : "Need urgent assistance? Contact Lab Helpdesk:")</strong>
                            <p>📞 @(isBangla ? "হটলাইন: 01700-000000 / এক্সটেনশন: 104" : "Hotline: 01700-000000 / Lab Ext: 104")</p>
                        </div>
                    </div>
                </div>
            }
            else if (memo != null && isPublished && !canViewReport)
            {
                <!-- ================= 4. STATE: RESULT READY BUT LOCKED DUE TO OUTSTANDING BALANCE ================= -->
                <div class="portal-due-view">
                    @if (matchedReports.Count > 1)
                    {
                        <div style="margin-bottom:14px;">
                            <button type="button" class="portal-btn portal-btn-secondary" style="padding:4px 12px; font-size:11.5px;" @onclick="BackToReportsList">
                                ⬅ @(isBangla ? $"রোগীর সকল রিপোর্টে ফিরুন ({matchedReports.Count}টি রিপোর্ট)" : $"Back to All Reports ({matchedReports.Count} found)")
                            </button>
                        </div>
                    }

                    <div class="portal-status-badge portal-badge-due">
                        🔒 @(isBangla ? "বকেয়া পরিশোধ প্রয়োজন / রিপোর্ট সুরক্ষিত" : "PAYMENT DUE — REPORT ACCESS LOCKED")
                    </div>

                    <div class="portal-due-hero">
                        <div class="portal-due-icon-wrap">
                            <span class="portal-due-icon">🔒</span>
                        </div>
                        <h2 class="portal-due-title">
                            @(isBangla ? "রিপোর্ট দেখতে অনুগ্রহ করে বকেয়া টাকা পরিশোধ করুন" : "Please Pay due amount to see the report.")
                        </h2>
                        <p class="portal-due-subtitle">
                            @(isBangla
                                ? $"আপনার ইনভয়েস #{memo.ID}-এর টেস্টের ফলাফল প্রস্তুত রয়েছে। তবে বিলের বকেয়া পরিশোধ না থাকায় পূর্ণাঙ্গ রিপোর্টটি সাময়িকভাবে লক রয়েছে।"
                                : $"Your laboratory test results for Invoice #{memo.ID} are verified and ready. However, the complete clinical report is locked pending clearance of the outstanding due amount.")
                        </p>
                    </div>

                    <!-- Outstanding Due Breakdown Card -->
                    <div class="portal-due-card">
                        <div class="portal-due-card-header">
                            <span>🧾 @(isBangla ? "বকেয়া পেমেন্ট বিবরণী" : "Payment Due Breakdown")</span>
                            <span>#@memo.ID</span>
                        </div>
                        <div class="portal-due-card-body">
                            <div class="portal-due-grid">
                                <div class="portal-due-item">
                                    <span>@(isBangla ? "রোগীর নাম" : "Patient Name"):</span>
                                    <strong>@memo.PatientName</strong>
                                </div>
                                <div class="portal-due-item">
                                    <span>@(isBangla ? "মোট বিল" : "Net Bill Amount"):</span>
                                    <strong>৳ @netPayable.ToString("N2")</strong>
                                </div>
                                <div class="portal-due-item">
