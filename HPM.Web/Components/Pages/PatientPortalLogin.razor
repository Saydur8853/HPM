@page "/patient/login"
@attribute [AllowAnonymous]
@layout Layout.LoginLayout
@inject NavigationManager Navigation

<PageTitle>Patient Sign In | @Branding.HospitalName</PageTitle>

<div class="patient-login-card">
    <div class="patient-login-brand">
        @if (!string.IsNullOrWhiteSpace(Branding.LogoData)) { <img src="@Branding.LogoData" alt="Hospital logo" /> }
        <div><small>PATIENT PORTAL</small><h1>@Branding.HospitalName</h1><p>Your appointments and medical documents in one place.</p></div>
    </div>
    @if (Error == "1") { <div class="patient-login-error" role="alert">Patient ID or registered phone number did not match. Please check your registration slip or contact reception.</div> }
    <form method="post" action="/patient/login-submit">
        <AntiforgeryToken />
        <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
        <label>Patient ID<input name="PatientID" required maxlength="11" autocomplete="username" placeholder="Your patient ID" autofocus /></label>
        <label>Registered phone number<input name="Phone" required maxlength="50" type="password" inputmode="tel" autocomplete="current-password" placeholder="Phone number on registration" /></label>
        <button type="submit">Sign in to my portal</button>
    </form>
    <p class="patient-login-help">Use the Patient ID on your registration slip and the phone number registered with the hospital. If your number has changed, ask reception to update it.</p>
    <a href="/login">Hospital staff sign in</a>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? RequestedReturnUrl { get; set; }
    private string ReturnUrl => !string.IsNullOrWhiteSpace(RequestedReturnUrl) && RequestedReturnUrl.StartsWith('/') && !RequestedReturnUrl.StartsWith("//") ? RequestedReturnUrl : "/patient";
}
