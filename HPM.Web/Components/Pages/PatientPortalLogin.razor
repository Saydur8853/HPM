@page "/patient/login"
@attribute [AllowAnonymous]
@layout Layout.LoginLayout
@inject NavigationManager Navigation

<PageTitle>Patient Sign In | @Branding.HospitalName</PageTitle>

<div class="login-split-layout">
    <div class="login-hero-pane">
        @if (!string.IsNullOrWhiteSpace(Branding.LogoData))
        {
            <img src="@Branding.LogoData" alt="Hospital Logo" class="login-hero-logo" />
        }
        else
        {
            <div class="login-hero-fallback">🏥</div>
        }
        <h1 class="login-hero-title">@Branding.HospitalName</h1>
        @if (!string.IsNullOrWhiteSpace(Branding.Tagline))
        {
            <p class="login-hero-motto">@Branding.Tagline</p>
        }
    </div>

    <div class="login-card login-swipe-right">
        <div class="login-mode-tabs" role="tablist" aria-label="Login mode">
            <a href="/login" class="login-mode-tab" role="tab" aria-selected="false">🏥 @I18n.T("Staff Login")</a>
            <span class="login-mode-tab active patient-active" role="tab" aria-selected="true">👤 @I18n.T("Patient Portal")</span>
        </div>

        @if (Error == "1")
        {
            <div class="login-alert danger" role="alert">⚠️ @I18n.T("Patient ID or registered phone number did not match.")</div>
        }

        <form method="post" action="/patient/login-submit" class="login-form-modern">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />

            <label class="login-field">
                <span>@I18n.T("Patient ID")</span>
                <input class="login-input" name="PatientID" required maxlength="11" autocomplete="username" placeholder="@I18n.T("Enter Patient ID")" autofocus />
            </label>

            <label class="login-field">
                <span>@I18n.T("Registered Phone Number")</span>
                <input class="login-input" name="Phone" required maxlength="50" type="password" inputmode="tel" autocomplete="current-password" placeholder="@I18n.T("Enter registered phone")" />
            </label>

            <button type="submit" class="login-submit-btn patient-submit">@I18n.T("Sign In to Portal")</button>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? RequestedReturnUrl { get; set; }
    private string ReturnUrl => !string.IsNullOrWhiteSpace(RequestedReturnUrl) && RequestedReturnUrl.StartsWith('/') && !RequestedReturnUrl.StartsWith("//") ? RequestedReturnUrl : "/patient";
}
