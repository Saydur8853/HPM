@page "/patient/login"
@attribute [AllowAnonymous]
@layout Layout.LoginLayout
@using HPM.Web.Components.Common

<PageTitle>Patient Sign In | @Branding.HospitalName</PageTitle>

<DualLoginPortal ActiveMode="patient"
                 PatientError="@Error"
                 PatientRetryAfter="@RetryAfter"
                 PatientReturnUrl="@RequestedReturnUrl"
                 PatientId="@QueryPatientId"
                 PatientPhone="@QueryPhone" />

@code {
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? RequestedReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "id")] public string? QueryPatientId { get; set; }
    [SupplyParameterFromQuery(Name = "phone")] public string? QueryPhone { get; set; }
    [SupplyParameterFromQuery(Name = "retryAfter")] public int? RetryAfter { get; set; }
}
