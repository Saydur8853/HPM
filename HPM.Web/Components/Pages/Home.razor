@page "/"
@attribute [Authorize]
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject NavigationManager Nav
@inject HospitalLicenseService Licenses
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<PageTitle>Dashboard | @Branding.HospitalName</PageTitle>

<div class="hd-header">
    <div>
        <h1>@L("ড্যাশবোর্ড", "Dashboard")</h1>
        <p>@DateTime.Now.ToString("dd MMMM yyyy, dddd")</p>
    </div>
    <button type="button" class="btn btn-sm btn-secondary" @onclick="LoadAsync" disabled="@loading">
        @(loading ? L("লোড হচ্ছে...", "Loading...") : L("রিফ্রেশ", "Refresh"))
    </button>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="hd-error">@error</div>
}

<div class="hd-kpi-grid">
    <div class="metric-card accent-blue"><span>@L("আজকের Patient", "Patients Today")</span><strong>@patientsToday</strong></div>
    <div class="metric-card accent-emerald"><span>@L("আজকের Collection", "Collection Today")</span><strong>@I18n.FormatCurrency(collectionToday)</strong></div>
    <div class="metric-card accent-red"><span>@L("আজকের বকেয়া", "Due Today")</span><strong>@I18n.FormatCurrency(dueToday)</strong></div>
    @if (showIpd)
    {
        <div class="metric-card accent-amber"><span>@L("ভর্তি আছেন", "Admitted")</span><strong>@admitted</strong></div>
        <div class="metric-card accent-violet"><span>@L("খালি Bed", "Free Beds")</span><strong>@freeBeds / @totalBeds</strong></div>
    }
    <div class="metric-card accent-red"><span>@L("Pending Report", "Pending Reports")</span><strong>@pendingReports</strong></div>
</div>

<section class="panel">
    <div class="hd-split">
        @foreach (var s in collectionSplit)
        {
            <div class="hd-split-item">
                <span>@s.Name</span>
                <strong>@I18n.FormatCurrency(s.Amount)</strong>
            </div>
        }
    </div>
</section>

@code {
    private bool loading;
    private string? error;
    private bool showIpd = true;
    private bool showPharmacy = true;

    private int patientsToday, admitted, freeBeds, totalBeds, pendingReports;
    private decimal collectionToday, dueToday;
    private List<NameAmount> collectionSplit = [];

    private const int DiagnosticModuleId = 2;
    private const int EmergencyModuleId = 11;

    private string L(string bn, string en) => I18n.IsBangla ? bn : en;

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        if ((await AuthStateProvider.GetAuthenticationStateAsync()).User.IsInRole(RoleNames.AppOwner))
        {
            Nav.NavigateTo("/app-owner", true);
            return;
        }

        var enabled = await Licenses.EnabledModulesAsync();
        showIpd = enabled.Contains(LicensedModules.Ipd);
        showPharmacy = enabled.Contains(LicensedModules.Pharmacy);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var today = DateTime.Today;
            var tomorrow = today.AddDays(1);

            // Today's rows only, few columns: the dashboard stays light.
            var opd = await db.OPDTickets.AsNoTracking()
                .Where(x => x.TransDate >= today && x.TransDate < tomorrow)
                .Select(x => new { x.ID, x.RegNo, x.Total })
                .ToListAsync();
            var memos = await db.EmergencyMemos.AsNoTracking()
                .Where(x => x.TransDate >= today && x.TransDate < tomorrow && (x.ModuleID == DiagnosticModuleId || x.ModuleID == EmergencyModuleId))
                .Select(x => new { x.ID, x.PatientID, x.ModuleID, x.Total, x.Discount, x.Paid })
                .ToListAsync();
            var ot = await db.OTCashMemos.AsNoTracking()
                .Where(x => x.TransDate >= today && x.TransDate < tomorrow)
                .SumAsync(x => (decimal?)(x.Total - x.Discount)) ?? 0;

            decimal pharmacyCash = 0, pharmacyCredit = 0;
            if (showPharmacy)
            {
                var pharmacy = await db.PharmacyCashMemos.AsNoTracking()
                    .Where(x => x.TransDate >= today && x.TransDate < tomorrow)
                    .Select(x => new { Net = (x.Total ?? 0) - (x.Discount ?? 0), x.IsCredit })
                    .ToListAsync();
                pharmacyCash = pharmacy.Where(x => x.IsCredit != true).Sum(x => x.Net);
                pharmacyCredit = pharmacy.Where(x => x.IsCredit == true).Sum(x => x.Net);
            }

            decimal ipdReceipts = 0, ipdDue = 0;
            var admittedToday = new List<string>();
            if (showIpd)
            {
                ipdReceipts = await db.IpdMoneyReceipts.AsNoTracking()
                    .Where(x => x.TransDate >= today && x.TransDate < tomorrow)
                    .SumAsync(x => (decimal?)x.Amount) ?? 0;
                ipdDue = await db.IpdFinalBills.AsNoTracking()
                    .Where(x => x.GeneratedAt >= today && x.GeneratedAt < tomorrow)
                    .SumAsync(x => (decimal?)x.BalanceDue) ?? 0;
                admittedToday = await db.PatientAdmissions.AsNoTracking()
                    .Where(x => x.AdmissionDate >= today && x.AdmissionDate < tomorrow)
                    .Select(x => x.PatientID ?? ("adm-" + x.RegNo))
                    .ToListAsync();
                admitted = await db.PatientAdmissions.AsNoTracking().CountAsync(x => x.IsAdmitted == true);
                totalBeds = await db.BedCabins.AsNoTracking().CountAsync();
                freeBeds = await db.BedCabins.AsNoTracking().CountAsync(x => !x.IsAllocated && x.Status == BedStatuses.Available);
            }

            pendingReports = await db.LabSampleCollections.AsNoTracking().CountAsync(x => x.Status != "Completed" && x.Status != "Cancelled");

            // Each patient counted once across OPD, diagnostic, emergency and admission.
            var keys = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var x in opd) keys.Add(string.IsNullOrWhiteSpace(x.RegNo) ? $"opd-{x.ID}" : x.RegNo.Trim());
            foreach (var x in memos) keys.Add(string.IsNullOrWhiteSpace(x.PatientID) ? $"memo-{x.ID}" : x.PatientID.Trim());
            foreach (var x in admittedToday) keys.Add(x.Trim());
            patientsToday = keys.Count;

            var opdAmount = opd.Sum(x => x.Total);
            var diagnostic = memos.Where(x => x.ModuleID == DiagnosticModuleId).Sum(x => x.Paid);
            var emergency = memos.Where(x => x.ModuleID == EmergencyModuleId).Sum(x => x.Paid) + ot;
            collectionToday = opdAmount + diagnostic + emergency + pharmacyCash + ipdReceipts;
            dueToday = memos.Sum(x => Math.Max(0, x.Total - x.Discount - x.Paid)) + pharmacyCredit + ipdDue;

            collectionSplit =
            [
                new(L("ওপিডি", "OPD"), opdAmount),
                new(L("ডায়াগনস্টিক", "Diagnostic"), diagnostic),
                .. showPharmacy ? new[] { new NameAmount(L("ফার্মেসি", "Pharmacy"), pharmacyCash) } : Array.Empty<NameAmount>(),
                .. showIpd ? new[] { new NameAmount(L("আইপিডি", "IPD"), ipdReceipts) } : Array.Empty<NameAmount>(),
                new(L("ইমার্জেন্সি ও ওটি", "Emergency & OT"), emergency)
            ];
        }
        catch (Exception ex)
        {
            error = L("ড্যাশবোর্ড ডেটা লোড করা যায়নি: ", "Could not load dashboard data: ") + ex.GetBaseException().Message;
        }
        finally
        {
            loading = false;
        }
    }

    private void HandleLanguageChanged() => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    public void Dispose() => I18n.OnLanguageChanged -= HandleLanguageChanged;

    private sealed record NameAmount(string Name, decimal Amount);
}
