@page "/"
@attribute [Authorize]
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject NavigationManager Nav
@inject HospitalLicenseService Licenses
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<PageTitle>Dashboard | @Branding.HospitalName</PageTitle>

<div class="hd-header">
    <div>
        <h1>@L("হাসপাতাল ড্যাশবোর্ড", "Hospital Dashboard")</h1>
        <p>📅 @DateTime.Now.ToString("dd MMMM yyyy, dddd")</p>
    </div>
    <button type="button" class="btn btn-sm btn-secondary" @onclick="LoadAsync" disabled="@loading">
        🔄 @(loading ? L("লোড হচ্ছে...", "Loading...") : L("রিফ্রেশ", "Refresh"))
    </button>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="hd-error">@error</div>
}

@* ───────── Patient overview ───────── *@
<div class="hd-kpi-grid">
    <div class="metric-card accent-blue"><span>@L("আজকের মোট Patient", "Today's Total Patients")</span><strong>@totalPatientsToday</strong><small>@L("OPD + Emergency + Diagnostic + ভর্তি", "OPD + Emergency + Diagnostic + Admission")</small></div>
    <div class="metric-card accent-emerald"><span>@L("নতুন Registration", "New Registrations")</span><strong>@newRegistrations</strong><small>@L("আজ", "Today")</small></div>
    <div class="metric-card accent-violet"><span>@L("OPD Patient", "OPD Patients")</span><strong>@opdPatients</strong><small>@L("আজকের OPD টিকিট", "Today's OPD tickets")</small></div>
    <div class="metric-card accent-red"><span>@L("Emergency Patient", "Emergency Patients")</span><strong>@emergencyPatients</strong><small>@L("আজ", "Today")</small></div>
    <div class="metric-card accent-amber"><span>@L("বর্তমানে ভর্তি Patient", "Currently Admitted")</span><strong>@currentlyAdmitted</strong><small>@L("IPD-তে আছেন", "In IPD now")</small></div>
    <div class="metric-card accent-blue"><span>@L("Available / Occupied Bed", "Available / Occupied Beds")</span><strong>@availableBeds / @occupiedBeds</strong><small>@L("মোট বেড", "Total beds"): @totalBeds</small></div>
    <div class="metric-card accent-emerald"><span>@L("আজকের Appointment", "Today's Appointments")</span><strong>@appointmentsToday</strong><small>@L("সকল ডাক্তার", "All doctors")</small></div>
    <div class="metric-card accent-red"><span>@L("Pending Diagnostic Report", "Pending Diagnostic Reports")</span><strong>@pendingDiagnosticReports</strong><small>@L("সম্পন্ন হয়নি", "Not yet completed")</small></div>
</div>

@* ───────── Financial overview ───────── *@
<section class="panel">
    <div class="panel-heading"><div><h2>@L("Financial Overview", "Financial Overview")</h2><p>@L("আজকের হিসাব", "Today's figures")</p></div></div>
    <div class="hd-body">
        <div class="hd-kpi-grid hd-kpi-tight">
            <div class="metric-card accent-emerald"><span>@L("আজকের Collection", "Today's Collection")</span><strong>@I18n.FormatCurrency(todayCollection)</strong><small>@L("Emergency ও OT সহ", "Incl. Emergency & OT")</small></div>
            <div class="metric-card accent-blue"><span>@L("OPD Collection", "OPD Collection")</span><strong>@I18n.FormatCurrency(opdCollection)</strong></div>
            <div class="metric-card accent-violet"><span>@L("Diagnostic Collection", "Diagnostic Collection")</span><strong>@I18n.FormatCurrency(diagnosticCollection)</strong></div>
            <div class="metric-card accent-amber"><span>@L("Pharmacy Sales", "Pharmacy Sales")</span><strong>@I18n.FormatCurrency(pharmacySalesAmount)</strong></div>
            <div class="metric-card accent-blue"><span>@L("IPD Collection", "IPD Collection")</span><strong>@I18n.FormatCurrency(ipdCollection)</strong></div>
            <div class="metric-card accent-red"><span>@L("Due Amount", "Due Amount")</span><strong>@I18n.FormatCurrency(dueAmount)</strong><small>@L("আজকের বিলের বকেয়া", "Unpaid from today's bills")</small></div>
            <div class="metric-card accent-red"><span>@L("Refund", "Refund")</span><strong>@I18n.FormatCurrency(refundAmount)</strong><small>@L("Diagnostic + Pharmacy", "Diagnostic + Pharmacy")</small></div>
        </div>

        <h3 class="hd-subtitle">@L("গত ৭ দিনের Collection", "Last 7 Days Collection")</h3>
        <div class="hd-vbars">
            @foreach (var d in last7Days)
            {
                <div class="hd-vbar-col" title="@d.Label: @I18n.FormatCurrency(d.Amount)">
                    <div class="hd-vbar-value">@ShortAmount(d.Amount)</div>
                    <div class="hd-vbar-track"><div class="hd-vbar-fill" style="height:@Pct(d.Amount, MaxDay)%"></div></div>
                    <div class="hd-vbar-label">@d.Label</div>
                </div>
            }
        </div>
    </div>
</section>

@* ───────── Patient flow ───────── *@
<section class="panel">
    <div class="panel-heading"><div><h2>@L("Patient Flow", "Patient Flow")</h2><p>@L("আজকের patient চলাচল", "Today's patient movement")</p></div></div>
    <div class="hd-body hd-grid-2">
        <div>
            <h3 class="hd-subtitle">@L("আজকের Patient Trend (ঘণ্টাভিত্তিক)", "Today's Patient Trend (hourly)")</h3>
            <div class="hd-vbars hd-vbars-sm">
                @foreach (var h in hourlyTrend)
                {
                    <div class="hd-vbar-col" title="@h.Label: @h.Count">
                        <div class="hd-vbar-value">@(h.Count > 0 ? h.Count.ToString() : "")</div>
                        <div class="hd-vbar-track"><div class="hd-vbar-fill" style="height:@Pct(h.Count, MaxHour)%"></div></div>
                        <div class="hd-vbar-label">@h.Label</div>
                    </div>
                }
            </div>
        </div>

        <div>
            <h3 class="hd-subtitle">@L("Waiting / Completed / Cancelled Appointment", "Waiting / Completed / Cancelled Appointments")</h3>
            <div class="hd-status-row">
                <div class="hd-status waiting"><strong>@apptWaiting</strong><span>@L("Waiting", "Waiting")</span></div>
                <div class="hd-status completed"><strong>@apptCompleted</strong><span>@L("Completed", "Completed")</span></div>
                <div class="hd-status cancelled"><strong>@apptCancelled</strong><span>@L("Cancelled", "Cancelled")</span></div>
            </div>
        </div>

        <div>
            <h3 class="hd-subtitle">@L("Department-wise Patient", "Department-wise Patients")</h3>
            @if (departmentCounts.Count == 0)
            {
                <p class="hd-empty">@L("আজ কোনো OPD patient নেই", "No OPD patients today")</p>
            }
            else
            {
                var maxDept = departmentCounts.Max(x => x.Count);
                @foreach (var d in departmentCounts)
                {
                    <div class="hd-hbar">
                        <span class="hd-hbar-name">@d.Name</span>
                        <div class="hd-hbar-track"><div class="hd-hbar-fill" style="width:@Pct(d.Count, maxDept)%"></div></div>
                        <span class="hd-hbar-num">@d.Count</span>
                    </div>
                }
            }
        </div>

        <div>
            <h3 class="hd-subtitle">@L("Doctor-wise Appointment ও Completed Consultation", "Doctor-wise Appointments & Completed Consultations")</h3>
            @if (doctorStats.Count == 0)
            {
                <p class="hd-empty">@L("আজ কোনো appointment নেই", "No appointments today")</p>
            }
            else
            {
                <table class="dash-table">
                    <thead><tr><th>@L("ডাক্তার", "Doctor")</th><th class="num">@L("Appointment", "Appointments")</th><th class="num">@L("Completed", "Completed")</th></tr></thead>
                    <tbody>
                        @foreach (var d in doctorStats)
                        {
                            <tr><td>@d.Name</td><td class="num">@d.Appointments</td><td class="num">@d.Completed</td></tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</section>

@* ───────── IPD & Bed status ───────── *@
@if (showIpd)
{
    <section class="panel">
        <div class="panel-heading"><div><h2>@L("IPD ও Bed Status", "IPD & Bed Status")</h2><p>@L("বর্তমান অবস্থা", "Current status")</p></div></div>
        <div class="hd-body">
            <div class="hd-kpi-grid hd-kpi-tight">
                <div class="metric-card accent-blue"><span>@L("মোট Bed", "Total Beds")</span><strong>@totalBeds</strong></div>
                <div class="metric-card accent-amber"><span>@L("Occupied Bed", "Occupied Beds")</span><strong>@occupiedBeds</strong></div>
                <div class="metric-card accent-emerald"><span>@L("Available Bed", "Available Beds")</span><strong>@availableBeds</strong></div>
                <div class="metric-card accent-violet"><span>@L("আজকের Admission", "Today's Admissions")</span><strong>@admissionsToday</strong></div>
                <div class="metric-card accent-blue"><span>@L("আজকের Discharge", "Today's Discharges")</span><strong>@dischargesToday</strong></div>
                <div class="metric-card accent-amber"><span>@L("Expected Discharge", "Expected Discharges")</span><strong>@expectedDischarges</strong><small>@L("Medical clearance দেওয়া", "Medical clearance issued")</small></div>
                <div class="metric-card accent-red"><span>@L("Critical Patient", "Critical Patients")</span><strong>@criticalPatients</strong><small>ICU / CCU / HDU</small></div>
            </div>

            <h3 class="hd-subtitle">@L("Ward / Cabin / ICU-wise Occupancy", "Ward / Cabin / ICU-wise Occupancy")</h3>
            @if (bedGroups.Count == 0)
            {
                <p class="hd-empty">@L("কোনো bed সেটআপ করা হয়নি", "No beds configured")</p>
            }
            else
            {
                @foreach (var g in bedGroups)
                {
                    <div class="hd-hbar">
                        <span class="hd-hbar-name">@g.Name</span>
                        <div class="hd-hbar-track"><div class="hd-hbar-fill occ" style="width:@Pct(g.Occupied, g.Total)%"></div></div>
                        <span class="hd-hbar-num">@g.Occupied / @g.Total</span>
                    </div>
                }
            }
        </div>
    </section>
}

@* ───────── Pharmacy & stock ───────── *@
@if (showPharmacy)
{
    <section class="panel">
        <div class="panel-heading"><div><h2>@L("Pharmacy ও Stock", "Pharmacy & Stock")</h2><p>@L("বিক্রি ও স্টক সতর্কতা", "Sales and stock alerts")</p></div></div>
        <div class="hd-body">
            <div class="hd-kpi-grid hd-kpi-tight">
                <div class="metric-card accent-emerald"><span>@L("আজকের Sales", "Today's Sales")</span><strong>@I18n.FormatCurrency(pharmacySalesAmount)</strong><small>@pharmacySalesCount @L("টি memo", "memos")</small></div>
                <div class="metric-card accent-amber"><span>@L("Low-stock Medicine", "Low-stock Medicines")</span><strong>@lowStockCount</strong><small>@L("Re-order level-এর নিচে", "At or below re-order level")</small></div>
                <div class="metric-card accent-red"><span>@L("Out-of-stock Medicine", "Out-of-stock Medicines")</span><strong>@outOfStockCount</strong></div>
                <div class="metric-card accent-violet"><span>@L("শিগগির Expire হবে", "Expiring Soon")</span><strong>@expiringSoonCount</strong><small>@L("৯০ দিনের মধ্যে (batch)", "Within 90 days (batches)")</small></div>
                <div class="metric-card accent-blue"><span>@L("Pending Purchase Order", "Pending Purchase Orders")</span><strong>@pendingPurchaseOrders</strong></div>
            </div>

            <div class="hd-grid-2">
                <div>
                    <h3 class="hd-subtitle">@L("Low-stock Medicine", "Low-stock Medicines")</h3>
                    @if (lowStockList.Count == 0)
                    {
                        <p class="hd-empty">@L("কোনো low-stock medicine নেই", "No low-stock medicines")</p>
                    }
                    else
                    {
                        <table class="dash-table">
                            <thead><tr><th>@L("Medicine", "Medicine")</th><th class="num">@L("Stock", "Stock")</th><th class="num">@L("Re-order", "Re-order")</th></tr></thead>
                            <tbody>
                                @foreach (var m in lowStockList)
                                {
                                    <tr><td>@m.Name</td><td class="num">@m.Balance.ToString("0.##")</td><td class="num">@m.ReOrderLevel</td></tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
                <div>
                    <h3 class="hd-subtitle">@L("শিগগির Expire হবে এমন Medicine", "Medicines Expiring Soon")</h3>
                    @if (expiringList.Count == 0)
                    {
                        <p class="hd-empty">@L("৯০ দিনের মধ্যে কোনো expiry নেই", "Nothing expires within 90 days")</p>
                    }
                    else
                    {
                        <table class="dash-table">
                            <thead><tr><th>@L("Medicine", "Medicine")</th><th>@L("Batch", "Batch")</th><th>@L("Expiry", "Expiry")</th><th class="num">@L("Qty", "Qty")</th></tr></thead>
                            <tbody>
                                @foreach (var e in expiringList)
                                {
                                    <tr><td>@e.Name</td><td>@(e.BatchNo ?? "—")</td><td>@e.ExpireDate.ToString("dd MMM yyyy")</td><td class="num">@e.Balance.ToString("0.##")</td></tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </section>
}

@code {
    private bool loading;
    private string? error;
    private bool showIpd = true;
    private bool showPharmacy = true;

    // Patient overview
    private int totalPatientsToday, newRegistrations, opdPatients, emergencyPatients, currentlyAdmitted;
    private int appointmentsToday, pendingDiagnosticReports;

    // Financial
    private decimal todayCollection, opdCollection, diagnosticCollection, pharmacySalesAmount, ipdCollection, dueAmount, refundAmount;
    private List<DayAmount> last7Days = [];

    // Patient flow
    private List<HourCount> hourlyTrend = [];
    private List<NameCount> departmentCounts = [];
    private List<DoctorStat> doctorStats = [];
    private int apptWaiting, apptCompleted, apptCancelled;

    // IPD
    private int totalBeds, occupiedBeds, availableBeds, admissionsToday, dischargesToday, expectedDischarges, criticalPatients;
    private List<BedGroup> bedGroups = [];

    // Pharmacy
    private int pharmacySalesCount, lowStockCount, outOfStockCount, expiringSoonCount, pendingPurchaseOrders;
    private List<StockItem> lowStockList = [];
    private List<ExpiryItem> expiringList = [];

    private const int MedicineCategoryId = 3;
    private const int DiagnosticModuleId = 2;
    private const int EmergencyModuleId = 11;

    private decimal MaxDay => last7Days.Count == 0 ? 0 : last7Days.Max(x => x.Amount);
    private int MaxHour => hourlyTrend.Count == 0 ? 0 : hourlyTrend.Max(x => x.Count);

    private string L(string bn, string en) => I18n.IsBangla ? bn : en;

    private static double Pct(decimal value, decimal max) => max <= 0 ? 0 : Math.Round((double)(value / max) * 100, 1);
    private static double Pct(int value, int max) => max <= 0 ? 0 : Math.Round(value * 100.0 / max, 1);

    private static string ShortAmount(decimal v) =>
        v >= 10_000_000 ? $"{v / 10_000_000:0.#}Cr" :
        v >= 100_000 ? $"{v / 100_000:0.#}L" :
        v >= 1_000 ? $"{v / 1_000:0.#}K" :
        v.ToString("0");

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        if ((await AuthStateProvider.GetAuthenticationStateAsync()).User.IsInRole(RoleNames.AppOwner))
        {
            Nav.NavigateTo("/app-owner", true);
            return;
        }

        var enabled = await Licenses.EnabledModulesAsync();
        showIpd = enabled.Contains(LicensedModules.Ipd);
        showPharmacy = enabled.Contains(LicensedModules.Pharmacy);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var today = DateTime.Today;
            var tomorrow = today.AddDays(1);
            var weekStart = today.AddDays(-6);

            // ── Raw data for the last 7 days (today is derived from it) ──
            var opdWeek = await db.OPDTickets.AsNoTracking()
                .Where(x => x.TransDate >= weekStart && x.TransDate < tomorrow)
                .Select(x => new { x.ID, x.TransDate, x.RegNo, x.DeptID, x.Total })
                .ToListAsync();
            var memoWeek = await db.EmergencyMemos.AsNoTracking()
                .Where(x => x.TransDate >= weekStart && x.TransDate < tomorrow && (x.ModuleID == DiagnosticModuleId || x.ModuleID == EmergencyModuleId))
                .Select(x => new { x.ID, x.TransDate, x.PatientID, x.ModuleID, x.Total, x.Discount, x.Paid })
                .ToListAsync();
            var pharmacyWeek = await db.PharmacyCashMemos.AsNoTracking()
                .Where(x => x.TransDate >= weekStart && x.TransDate < tomorrow)
                .Select(x => new { x.TransDate, Net = (x.Total ?? 0) - (x.Discount ?? 0), x.IsCredit })
                .ToListAsync();
            var ipdReceiptWeek = await db.IpdMoneyReceipts.AsNoTracking()
                .Where(x => x.TransDate >= weekStart && x.TransDate < tomorrow)
                .Select(x => new { x.TransDate, x.Amount })
                .ToListAsync();
            var otWeek = await db.OTCashMemos.AsNoTracking()
                .Where(x => x.TransDate >= weekStart && x.TransDate < tomorrow)
                .Select(x => new { x.TransDate, Net = x.Total - x.Discount })
                .ToListAsync();

            var opdToday = opdWeek.Where(x => x.TransDate >= today).ToList();
            var diagToday = memoWeek.Where(x => x.TransDate >= today && x.ModuleID == DiagnosticModuleId).ToList();
            var emergencyToday = memoWeek.Where(x => x.TransDate >= today && x.ModuleID == EmergencyModuleId).ToList();
            var pharmacyToday = pharmacyWeek.Where(x => x.TransDate >= today).ToList();

            var admissionsTodayList = await db.PatientAdmissions.AsNoTracking()
                .Where(x => x.AdmissionDate >= today && x.AdmissionDate < tomorrow)
                .Select(x => new { x.ID, x.PatientID, x.RegNo, x.AdmissionDate })
                .ToListAsync();

            // ── Patient overview ──
            opdPatients = opdToday.Count;
            emergencyPatients = emergencyToday.Count;
            newRegistrations = await db.Registrations.AsNoTracking().CountAsync(x => x.TransDate >= today && x.TransDate < tomorrow);
            currentlyAdmitted = await db.PatientAdmissions.AsNoTracking().CountAsync(x => x.IsAdmitted == true);
            appointmentsToday = await db.DoctorAppointments.AsNoTracking().CountAsync(x => x.ApptDate >= today && x.ApptDate < tomorrow);
            pendingDiagnosticReports = await db.LabSampleCollections.AsNoTracking().CountAsync(x => x.Status != "Completed" && x.Status != "Cancelled");

            // Count each patient once across OPD, emergency, diagnostic and admission.
            var patientKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var x in opdToday) patientKeys.Add(string.IsNullOrWhiteSpace(x.RegNo) ? $"opd-{x.ID}" : x.RegNo.Trim());
            foreach (var x in diagToday.Concat(emergencyToday)) patientKeys.Add(string.IsNullOrWhiteSpace(x.PatientID) ? $"memo-{x.ID}" : x.PatientID.Trim());
            foreach (var x in admissionsTodayList) patientKeys.Add(string.IsNullOrWhiteSpace(x.PatientID) ? $"adm-{x.RegNo}" : x.PatientID.Trim());
            totalPatientsToday = patientKeys.Count;

            // ── Financial (today) ──
            opdCollection = opdToday.Sum(x => x.Total);
            diagnosticCollection = diagToday.Sum(x => x.Paid);
            pharmacySalesAmount = pharmacyToday.Sum(x => x.Net);
            pharmacySalesCount = pharmacyToday.Count;
            ipdCollection = ipdReceiptWeek.Where(x => x.TransDate >= today).Sum(x => x.Amount);
            var emergencyCollection = emergencyToday.Sum(x => x.Paid);
            var otCollection = otWeek.Where(x => x.TransDate >= today).Sum(x => x.Net);
            todayCollection = opdCollection + diagnosticCollection + pharmacySalesAmount + ipdCollection + emergencyCollection + otCollection;

            var ipdDue = await db.IpdFinalBills.AsNoTracking()
                .Where(x => x.GeneratedAt >= today && x.GeneratedAt < tomorrow)
                .SumAsync(x => (decimal?)x.BalanceDue) ?? 0;
            dueAmount = diagToday.Concat(emergencyToday).Sum(x => Math.Max(0, x.Total - x.Discount - x.Paid))
                        + pharmacyToday.Where(x => x.IsCredit == true).Sum(x => x.Net)
                        + ipdDue;

            var diagRefund = await db.DiagnosticCashMemoReturns.AsNoTracking()
                .Where(x => x.TransDate >= today && x.TransDate < tomorrow && x.Status != "Cancelled")
                .SumAsync(x => (decimal?)x.RefundAmount) ?? 0;
            var pharmacyRefund = await db.PharmacySalesReturns.AsNoTracking()
                .Where(x => x.TransDate >= today && x.TransDate < tomorrow && x.IsPosted)
                .SumAsync(x => (decimal?)x.RefundAmount) ?? 0;
            refundAmount = diagRefund + pharmacyRefund;

            last7Days = Enumerable.Range(0, 7).Select(i =>
            {
                var day = weekStart.AddDays(i);
                var amount = opdWeek.Where(x => x.TransDate.Date == day).Sum(x => x.Total)
                             + memoWeek.Where(x => x.TransDate.Date == day).Sum(x => x.Paid)
                             + pharmacyWeek.Where(x => x.TransDate.Date == day).Sum(x => x.Net)
                             + ipdReceiptWeek.Where(x => x.TransDate.Date == day).Sum(x => x.Amount)
                             + otWeek.Where(x => x.TransDate.Date == day).Sum(x => x.Net);
                return new DayAmount(day == today ? L("আজ", "Today") : day.ToString("dd MMM"), amount);
            }).ToList();

            // ── Patient flow ──
            var hours = opdToday.Select(x => x.TransDate.Hour)
                .Concat(diagToday.Select(x => x.TransDate.Hour))
                .Concat(emergencyToday.Select(x => x.TransDate.Hour))
                .Concat(admissionsTodayList.Where(x => x.AdmissionDate.HasValue).Select(x => x.AdmissionDate!.Value.Hour))
                .ToList();
            var firstHour = Math.Min(8, hours.DefaultIfEmpty(8).Min());
            var lastHour = Math.Max(Math.Max(20, DateTime.Now.Hour), hours.DefaultIfEmpty(20).Max());
            hourlyTrend = Enumerable.Range(firstHour, lastHour - firstHour + 1)
                .Select(h => new HourCount(new DateTime(1, 1, 1, h, 0, 0).ToString("h tt"), hours.Count(x => x == h)))
                .ToList();

            var departments = await db.Departments.AsNoTracking().ToDictionaryAsync(x => x.ID, x => x.Name);
            departmentCounts = opdToday.GroupBy(x => x.DeptID)
                .Select(g => new NameCount(departments.TryGetValue(g.Key, out var n) ? n : $"#{g.Key}", g.Count()))
                .OrderByDescending(x => x.Count)
                .Take(10)
                .ToList();

            var apptToday = await db.DoctorAppointments.AsNoTracking()
                .Where(x => x.ApptDate >= today && x.ApptDate < tomorrow)
                .Select(x => new { x.DoctorID, x.Status })
                .ToListAsync();
            var encountersToday = await db.PatientEncounters.AsNoTracking()
                .Where(x => x.VisitDate >= today && x.VisitDate < tomorrow)
                .Select(x => new { x.DoctorID, x.Status })
                .ToListAsync();

            apptWaiting = encountersToday.Count(x => x.Status is EncounterStatuses.Waiting or EncounterStatuses.InConsultation)
                          + apptToday.Count(x => x.Status == "Booked");
            apptCompleted = encountersToday.Count(x => x.Status == EncounterStatuses.Completed);
            apptCancelled = encountersToday.Count(x => x.Status is EncounterStatuses.Cancelled or EncounterStatuses.NoShow)
                            + apptToday.Count(x => x.Status == "Cancelled");

            var doctorIds = apptToday.Select(x => x.DoctorID).Concat(encountersToday.Select(x => x.DoctorID)).Distinct().ToList();
            var doctors = await db.Doctors.AsNoTracking()
                .Where(x => doctorIds.Contains(x.ID))
                .Select(x => new { x.ID, x.Title, x.Name })
                .ToDictionaryAsync(x => x.ID);
            doctorStats = doctorIds
                .Select(id => new DoctorStat(
                    doctors.TryGetValue(id, out var d) ? DoctorNameFormatter.FormatFullName(d.Title, d.Name) : $"#{id}",
                    apptToday.Count(x => x.DoctorID == id),
                    encountersToday.Count(x => x.DoctorID == id && x.Status == EncounterStatuses.Completed)))
                .OrderByDescending(x => x.Appointments + x.Completed)
                .Take(10)
                .ToList();

            // ── IPD & beds ──
            var beds = await db.BedCabins.AsNoTracking().Select(x => new { x.ID, x.CategoryID, x.IsAllocated, x.Status }).ToListAsync();
            var bedCategories = await db.BedCategories.AsNoTracking().ToDictionaryAsync(x => x.ID, x => x.Name);
            bool IsOccupied(bool allocated, string status) => allocated || status == BedStatuses.Occupied;
            totalBeds = beds.Count;
            occupiedBeds = beds.Count(x => IsOccupied(x.IsAllocated, x.Status));
            availableBeds = beds.Count(x => !x.IsAllocated && x.Status == BedStatuses.Available);
            bedGroups = beds.GroupBy(x => x.CategoryID)
                .Select(g => new BedGroup(bedCategories.TryGetValue(g.Key, out var n) ? n : $"#{g.Key}", g.Count(), g.Count(x => IsOccupied(x.IsAllocated, x.Status))))
                .OrderBy(x => x.Name)
                .ToList();

            admissionsToday = admissionsTodayList.Count;
            dischargesToday = await db.PatientAdmissions.AsNoTracking().CountAsync(x => x.ReleaseDate >= today && x.ReleaseDate < tomorrow);
            expectedDischarges = await db.IpdMedicalDischargeOrders.AsNoTracking()
                .CountAsync(o => o.Status == "Ready" && db.PatientAdmissions.Any(a => a.ID == o.AdmissionID && a.IsAdmitted == true));

            var admitted = await db.PatientAdmissions.AsNoTracking()
                .Where(x => x.IsAdmitted == true)
                .Select(x => new { x.BedCabinID, x.PatientCategory })
                .ToListAsync();
            var criticalCategoryIds = bedCategories.Where(x => IsCriticalCare(x.Value)).Select(x => x.Key).ToHashSet();
            var criticalBedIds = beds.Where(x => criticalCategoryIds.Contains(x.CategoryID)).Select(x => x.ID).ToHashSet();
            criticalPatients = admitted.Count(x => IsCriticalCare(x.PatientCategory) || (x.BedCabinID.HasValue && criticalBedIds.Contains(x.BedCabinID.Value)));

            // ── Pharmacy & stock ──
            var medicines = await db.Services.AsNoTracking()
                .Where(x => x.CategoryID == MedicineCategoryId)
                .Select(x => new { x.ID, x.Name, x.ReOrderLevel })
                .ToListAsync();
            var balances = await db.MedicineStoreBalances.AsNoTracking()
                .GroupBy(x => x.ServiceID)
                .Select(g => new { ServiceID = g.Key, Balance = g.Sum(x => x.Balance) })
                .ToDictionaryAsync(x => x.ServiceID, x => x.Balance);

            var stock = medicines.Select(m => new StockItem(m.Name ?? "—", balances.TryGetValue(m.ID, out var b) ? b : 0, m.ReOrderLevel ?? 0)).ToList();
            var lowStock = stock.Where(x => x.Balance > 0 && x.ReOrderLevel > 0 && x.Balance <= x.ReOrderLevel).OrderBy(x => x.Balance).ToList();
            lowStockCount = lowStock.Count;
            lowStockList = lowStock.Take(8).ToList();
            outOfStockCount = stock.Count(x => x.Balance <= 0);

            var expiryLimit = today.AddDays(90);
            var expiring = await db.MedicineStoreBalances.AsNoTracking()
                .Where(x => x.Balance > 0 && x.ExpireDate >= today && x.ExpireDate <= expiryLimit)
                .OrderBy(x => x.ExpireDate)
                .Select(x => new { x.ServiceID, x.BatchNo, x.ExpireDate, x.Balance })
                .ToListAsync();
            var medicineNames = medicines.ToDictionary(x => x.ID, x => x.Name ?? "—");
            expiringSoonCount = expiring.Count;
            expiringList = expiring.Take(8)
                .Select(x => new ExpiryItem(medicineNames.TryGetValue(x.ServiceID, out var n) ? n : $"#{x.ServiceID}", x.BatchNo, x.ExpireDate!.Value, x.Balance))
                .ToList();

            pendingPurchaseOrders = await db.PurchaseRequisitions.AsNoTracking().CountAsync(x => x.Status == "Pending");
        }
        catch (Exception ex)
        {
            error = L("ড্যাশবোর্ড ডেটা লোড করা যায়নি: ", "Could not load dashboard data: ") + ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private static bool IsCriticalCare(string? name) =>
        !string.IsNullOrWhiteSpace(name) &&
        (name.Contains("ICU", StringComparison.OrdinalIgnoreCase) ||
         name.Contains("CCU", StringComparison.OrdinalIgnoreCase) ||
         name.Contains("HDU", StringComparison.OrdinalIgnoreCase));

    private void HandleLanguageChanged() => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    public void Dispose() => I18n.OnLanguageChanged -= HandleLanguageChanged;

    private sealed record DayAmount(string Label, decimal Amount);
    private sealed record HourCount(string Label, int Count);
    private sealed record NameCount(string Name, int Count);
    private sealed record DoctorStat(string Name, int Appointments, int Completed);
    private sealed record BedGroup(string Name, int Total, int Occupied);
    private sealed record StockItem(string Name, decimal Balance, int ReOrderLevel);
    private sealed record ExpiryItem(string Name, string? BatchNo, DateTime ExpireDate, decimal Balance);
}
