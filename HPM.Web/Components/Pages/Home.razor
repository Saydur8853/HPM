@page "/"
@attribute [Authorize]
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject NavigationManager Nav
@inject HospitalLicenseService Licenses
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable
@using HPM.Web.Data
@using HPM.Web.Data.Entities
@using Microsoft.EntityFrameworkCore
@using System.Globalization

<PageTitle>@I18n.T("Hospital Overview & Diagnostic Intelligence") | @Branding.HospitalName</PageTitle>

@if (!canShowDashboard)
{
    <section class="panel" style="padding:28px;margin:20px 0"><h1>Hospital workspace</h1><p>Your licensed modules are available in the navigation menu.</p><p>Need another module? Please contact your App Owner.</p></section>
}
else
{

<!-- Top Dashboard Header & Controls -->
<div class="dash-header-wrap">
    <div>
        <h1 style="font-size: 24px; font-weight: 800; color: var(--ink); margin: 0; letter-spacing: -0.5px; display: flex; align-items: center; gap: 10px;">
            <span>@Greeting</span>
            <span style="font-size: 13px; font-weight: 600; color: #64748b; background: #f1f5f9; padding: 3px 10px; border-radius: 20px; letter-spacing: 0;">
                📅 @DateTime.Now.ToString("dd MMMM yyyy, dddd")
            </span>
        </h1>
        <p style="margin: 4px 0 0; font-size: 13px; color: var(--muted, #64748b);">
            @(I18n.IsBangla ? "হাসপাতাল ওভারভিউ, ডায়াগনস্টিক রোগ অনুপাত, প্যাথোলজি ও রেডিওলজি অ্যানালিটিক্স" : "Executive clinical overview, pathology & imaging disease ratio statistics, and longitudinal trends")
        </p>
    </div>

    <!-- Date Range & Preset Filter Bar -->
    <div class="dash-filter-bar">
        <div class="dash-preset-pills">
            <button type="button" class="dash-pill-btn @(datePreset == "today" ? "active" : "")" @onclick='() => ChangeDatePreset("today")'>
                @(I18n.IsBangla ? "আজ" : "Today")
            </button>
            <button type="button" class="dash-pill-btn @(datePreset == "yesterday" ? "active" : "")" @onclick='() => ChangeDatePreset("yesterday")'>
                @(I18n.IsBangla ? "গতকাল" : "Yesterday")
            </button>
            <button type="button" class="dash-pill-btn @(datePreset == "7d" ? "active" : "")" @onclick='() => ChangeDatePreset("7d")'>
                @(I18n.IsBangla ? "৭ দিন" : "7 Days")
            </button>
            <button type="button" class="dash-pill-btn @(datePreset == "month" ? "active" : "")" @onclick='() => ChangeDatePreset("month")'>
                @(I18n.IsBangla ? "চলতি মাস" : "This Month")
            </button>
            <button type="button" class="dash-pill-btn @(datePreset == "30d" ? "active" : "")" @onclick='() => ChangeDatePreset("30d")'>
                @(I18n.IsBangla ? "৩০ দিন" : "30 Days")
            </button>
            <button type="button" class="dash-pill-btn @(datePreset == "custom" ? "active" : "")" @onclick='() => ChangeDatePreset("custom")'>
                @(I18n.IsBangla ? "কাস্টম" : "Custom")
            </button>
        </div>

        @if (datePreset == "custom")
        {
            <div class="dash-custom-dates">
                <span>From:</span>
                <input type="date" @bind="customStartDate" />
                <span>To:</span>
                <input type="date" @bind="customEndDate" />
                <button type="button" class="btn btn-sm btn-primary" style="padding: 4px 10px; font-size: 11px;" @onclick="ApplyCustomDates">
                    Apply
                </button>
            </div>
        }

        <button type="button" class="btn btn-sm btn-secondary" style="display: inline-flex; align-items: center; gap: 5px; font-weight: 700; font-size: 12px; padding: 5px 12px;" @onclick="RefreshAsync" disabled="@loadingData">
            <span style="@(loadingData ? "animation: spin 1s linear infinite;" : "")">🔄</span>
            @(loadingData ? (I18n.IsBangla ? "লোড হচ্ছে..." : "Loading...") : (I18n.IsBangla ? "রিফ্রেশ" : "Refresh"))
        </button>
    </div>
</div>

<!-- Primary Performance Metrics (6 Clean KPI Cards) -->
<div class="dash-kpi-grid-6">
    <!-- Card 1: Diagnostic Investigations -->
    <div class="metric-card accent-blue">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <span>@(I18n.IsBangla ? "মোট ডায়াগনস্টিক পরীক্ষা" : "Total Diagnostic Tests")</span>
            <span style="font-size: 18px;">🔬</span>
        </div>
        <strong>@totalDiagnosticTests</strong>
        <small>@pathologyTestsCount @(I18n.IsBangla ? "প্যাথোলজি" : "Pathology") &bull; @imagingTestsCount @(I18n.IsBangla ? "ইমেজিং" : "Imaging")</small>
    </div>

    <!-- Card 2: Pathology Abnormal Ratio -->
    <div class="metric-card accent-red">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <span>@(I18n.IsBangla ? "প্যাথোলজি অস্বাভাবিক অনুপাত" : "Pathology Abnormal Ratio")</span>
            <span style="font-size: 18px;">🩸</span>
        </div>
        <strong>@(overallPathologyAbnormalRatio.ToString("0.0"))%</strong>
        <small>@pathologyAbnormalCount @(I18n.IsBangla ? "রোগীর অস্বাভাবিক ফলাফল ফ্ল্যাগড" : "Abnormal results flagged")</small>
    </div>

    <!-- Card 3: Imaging Clinical Findings Ratio -->
    <div class="metric-card accent-violet">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <span>@(I18n.IsBangla ? "ইমেজিং ক্লিনিক্যাল ফাইন্ডিংস" : "Imaging Clinical Findings")</span>
            <span style="font-size: 18px;">🩻</span>
        </div>
        <strong>@(overallImagingAbnormalRatio.ToString("0.0"))%</strong>
        <small>@imagingAbnormalCount @(I18n.IsBangla ? "স্টাডিতে ফাইন্ডিংস শনাক্ত" : "Studies with findings")</small>
    </div>

    <!-- Card 4: Diagnostic & Total Collections -->
    <div class="metric-card accent-emerald">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <span>@(I18n.IsBangla ? "মোট হসপিটাল কালেকশন" : "Total Collections")</span>
            <span style="font-size: 18px;">💰</span>
        </div>
        <strong>@(I18n.FormatCurrency(totalCollection))</strong>
        <small>@(I18n.IsBangla ? "ডায়াগনস্টিক:" : "Diagnostic:") @(I18n.FormatCurrency(diagnosticRevenue))</small>
    </div>

    <!-- Card 5: Inpatients & Bed Occupancy -->
    <div class="metric-card accent-amber">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <span>@(I18n.IsBangla ? "ভর্তি রোগী ও বেড অকুপেন্সি" : "Inpatients & Bed Occupancy")</span>
            <span style="font-size: 18px;">🛏️</span>
        </div>
        <strong>@(occupiedBeds > 0 && totalBeds > 0 ? $"{(double)occupiedBeds / totalBeds * 100:0.0}%" : "0.0%")</strong>
        <small>@occupiedBeds / @totalBeds @(I18n.IsBangla ? "বেড অকুপাইড" : "Beds Occupied") &bull; @activeAdmissionCount @(I18n.IsBangla ? "ভর্তি" : "Admitted")</small>
    </div>

    <!-- Card 6: Report Turnaround & Completion -->
    <div class="metric-card accent-blue">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <span>@(I18n.IsBangla ? "টার্ন-অ্যারাউন্ড ও ডেলিভারি" : "Turnaround & Completion")</span>
            <span style="font-size: 18px;">⚡</span>
        </div>
        <strong>@(turnaroundCompletionRate.ToString("0.0"))%</strong>
        <small>@completedReportsCount @(I18n.IsBangla ? "সম্পন্ন রিপোর্ট" : "Reports Completed") &bull; @pendingReportsCount @(I18n.IsBangla ? "চলমান" : "In Queue")</small>
    </div>
</div>

<!-- Navigation Tabs for Deep-Dive Disease Analytics -->
<div class="dash-tabs-nav">
    <button type="button" class="dash-tab-item @(activeTab == "pathology" ? "active" : "")" @onclick='() => activeTab = "pathology"'>
        <span>🔬</span>
        <span>@(I18n.IsBangla ? "প্যাথোলজি রোগ অনুপাত" : "Pathology Disease Ratio")</span>
        <span class="dash-tab-badge">@pathologyPrevalenceList.Count @(I18n.IsBangla ? "রোগ" : "Panels")</span>
    </button>
    <button type="button" class="dash-tab-item @(activeTab == "imaging" ? "active" : "")" @onclick='() => activeTab = "imaging"'>
        <span>🩻</span>
        <span>@(I18n.IsBangla ? "ইমেজিং ও রেডিওলজি ফাইন্ডিংস" : "Imaging Clinical Findings")</span>
        <span class="dash-tab-badge">@imagingPrevalenceList.Count @(I18n.IsBangla ? "স্টাডি" : "Panels")</span>
    </button>
    <button type="button" class="dash-tab-item @(activeTab == "timeline" ? "active" : "")" @onclick='() => activeTab = "timeline"'>
        <span>📅</span>
        <span>@(I18n.IsBangla ? "তারিখভিত্তিক রোগের প্রবণতা" : "Date-Wise Disease Trend")</span>
        <span class="dash-tab-badge">@dailySummaries.Count @(I18n.IsBangla ? "দিন" : "Days")</span>
    </button>
    <button type="button" class="dash-tab-item @(activeTab == "modality" ? "active" : "")" @onclick='() => activeTab = "modality"'>
        <span>📊</span>
        <span>@(I18n.IsBangla ? "মডালিটি ও ডিপার্টমেন্ট ওভারভিউ" : "Modality & Turnaround")</span>
    </button>
    <button type="button" class="dash-tab-item @(activeTab == "alerts" ? "active" : "")" @onclick='() => activeTab = "alerts"'>
        <span>🚨</span>
        <span>@(I18n.IsBangla ? "সাম্প্রতিক ক্রিটিক্যাল অ্যালার্ট" : "Recent Critical Alerts")</span>
        @if (criticalAlerts.Count > 0)
        {
            <span class="dash-tab-badge" style="background: #fee2e2; color: #dc2626;">@criticalAlerts.Count</span>
        }
    </button>
</div>

<!-- TAB 1: PATHOLOGY DISEASE RATIO -->
@if (activeTab == "pathology")
{
    <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 12px 18px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
        <div style="display: flex; align-items: center; gap: 10px;">
            <span style="font-size: 20px;">🩸</span>
            <div>
                <strong style="font-size: 13.5px; color: #0f172a;">
                    @(I18n.IsBangla ? "হেমাটোলজি, বায়োকেমিস্ট্রি, ইউরিন ও সেরোলজি ভিত্তিক রোগ অনুপাত" : "Disease Ratio & Prevalence derived from Hematology, Biochemistry, Urine & Serology")
                </strong>
                <div style="font-size: 11.5px; color: #64748b;">
                    @(I18n.IsBangla
                        ? $"বিশ্লেষণ সময়কাল: {startDate:dd MMM yyyy} থেকে {endDate.AddDays(-1):dd MMM yyyy} | মোট প্যাথোলজি টেস্ট: {pathologyTestsCount}"
                        : $"Analysis Period: {startDate:dd MMM yyyy} to {endDate.AddDays(-1):dd MMM yyyy} | Total Pathology Tests Evaluated: {pathologyTestsCount}")
                </div>
            </div>
        </div>
        <div style="display: flex; gap: 8px;">
            <span class="pill pill-danger" style="font-size: 11px;">Critical Alerts: @criticalAlerts.Count(x => x.Modality == "Pathology")</span>
            <span class="pill pill-warning" style="font-size: 11px;">Abnormal Flags: @pathologyAbnormalCount</span>
        </div>
    </div>

    <div class="disease-cards-grid">
        @foreach (var item in pathologyPrevalenceList)
        {
            <div class="disease-card">
                <div class="disease-card-header">
                    <div>
                        <div class="disease-card-title">
                            <span>@item.Icon</span>
                            <span>@(I18n.IsBangla ? item.DiseaseNameBn : item.DiseaseName)</span>
                        </div>
                        <div style="font-size: 11px; color: #94a3b8; margin-top: 2px;">
                            @item.TestType
                        </div>
                    </div>
                    <span class="pill @(item.Severity == "critical" ? "pill-danger" : item.Severity == "warning" ? "pill-warning" : "pill-success")" style="font-size: 10.5px;">
                        @(item.Severity == "critical" ? "High Alert" : item.Severity == "warning" ? "Moderate" : "Routine")
                    </span>
                </div>

                <div class="disease-ratio-big" style="color: @(item.Severity == "critical" ? "#dc2626" : item.Severity == "warning" ? "#d97706" : "#0284c7");">
                    <span>@item.Ratio.ToString("0.0")%</span>
                    <span style="font-size: 12px; font-weight: 600; color: #64748b;">
                        @(I18n.IsBangla ? "পজিটিভ অনুপাত" : "Positive Ratio")
                    </span>
                </div>

                <div class="disease-ratio-sub">
                    <b>@item.PositiveCount</b> @(I18n.IsBangla ? "রোগীর ক্ষেত্রে শনাক্ত" : "cases detected") &bull; @item.EvaluatedCount @(I18n.IsBangla ? "পরীক্ষা সম্পন্ন" : "tests evaluated")
                </div>

                <!-- Proportional Bar Fill -->
                <div class="disease-progress-track">
                    <div class="disease-progress-fill @(item.Severity == "critical" ? "fill-critical" : item.Severity == "warning" ? "fill-warning" : "fill-info")" style="width: @Math.Min(100, Math.Max(4, item.Ratio))%;"></div>
                </div>

                <!-- Sub-breakdown tags -->
                <div class="disease-breakdown-tags">
                    @foreach (var sub in item.SubBreakdown)
                    {
                        <div class="disease-tag">
                            <b>@sub.Key:</b> @sub.Value
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

<!-- TAB 2: IMAGING & RADIOLOGY CLINICAL FINDINGS -->
@if (activeTab == "imaging")
{
    <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 12px 18px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
        <div style="display: flex; align-items: center; gap: 10px;">
            <span style="font-size: 20px;">🩻</span>
            <div>
                <strong style="font-size: 13.5px; color: #0f172a;">
                    @(I18n.IsBangla ? "চেস্ট এক্স-রে, আল্ট্রাসনোগ্রাফি, সিটি স্ক্যান ও অর্থোপেডিক ফাইন্ডিংস অনুপাত" : "Chest X-Ray, Ultrasonography, CT & Orthopedic Imaging Findings Ratio")
                </strong>
                <div style="font-size: 11.5px; color: #64748b;">
                    @(I18n.IsBangla
                        ? $"বিশ্লেষণ সময়কাল: {startDate:dd MMM yyyy} থেকে {endDate.AddDays(-1):dd MMM yyyy} | মোট ইমেজিং স্টাডি: {imagingTestsCount}"
                        : $"Analysis Period: {startDate:dd MMM yyyy} to {endDate.AddDays(-1):dd MMM yyyy} | Total Imaging Studies: {imagingTestsCount}")
                </div>
            </div>
        </div>
        <div style="display: flex; gap: 8px;">
            <a href="diagnostic/imaging-results" class="btn btn-sm btn-secondary" style="font-size: 11.5px; font-weight: 700;">
                🖨 @(I18n.IsBangla ? "ইমেজিং রিপোর্ট ও প্রিন্ট" : "Imaging Reports & Print")
            </a>
        </div>
    </div>

    <div class="disease-cards-grid">
        @foreach (var item in imagingPrevalenceList)
        {
            <div class="disease-card">
                <div class="disease-card-header">
                    <div>
                        <div class="disease-card-title">
                            <span>@item.Icon</span>
                            <span>@(I18n.IsBangla ? item.DiseaseNameBn : item.DiseaseName)</span>
                        </div>
                        <div style="font-size: 11px; color: #94a3b8; margin-top: 2px;">
                            @item.TestType
                        </div>
                    </div>
                    <span class="pill @(item.Severity == "critical" ? "pill-danger" : item.Severity == "warning" ? "pill-warning" : item.Severity == "success" ? "pill-success" : "pill-info")" style="font-size: 10.5px;">
                        @(item.Severity == "critical" ? "Acute Finding" : item.Severity == "warning" ? "Clinical Finding" : item.Severity == "success" ? "Normal" : "Screening")
                    </span>
                </div>

                <div class="disease-ratio-big" style="color: @(item.Severity == "critical" ? "#dc2626" : item.Severity == "warning" ? "#7c3aed" : item.Severity == "success" ? "#059669" : "#0284c7");">
                    <span>@item.Ratio.ToString("0.0")%</span>
                    <span style="font-size: 12px; font-weight: 600; color: #64748b;">
                        @(I18n.IsBangla ? "ফাইন্ডিংস অনুপাত" : "Findings Ratio")
                    </span>
                </div>

                <div class="disease-ratio-sub">
                    <b>@item.PositiveCount</b> @(I18n.IsBangla ? "স্টাডিতে ইতিবাচক ফাইন্ডিংস" : "studies with positive findings") &bull; @item.EvaluatedCount @(I18n.IsBangla ? "মোট স্টাডি" : "total studies")
                </div>

                <div class="disease-progress-track">
                    <div class="disease-progress-fill @(item.Severity == "critical" ? "fill-critical" : item.Severity == "warning" ? "fill-warning" : item.Severity == "success" ? "fill-success" : "fill-info")" style="width: @Math.Min(100, Math.Max(4, item.Ratio))%;"></div>
                </div>

                <div class="disease-breakdown-tags">
                    @foreach (var sub in item.SubBreakdown)
                    {
                        <div class="disease-tag">
                            <b>@sub.Key:</b> @sub.Value
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

<!-- TAB 3: DATE-WISE LONGITUDINAL DISEASE TREND -->
@if (activeTab == "timeline")
{
    <div class="dash-timeline-table-card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 10px;">
            <div>
                <h3 style="font-size: 16px; font-weight: 800; color: var(--ink); margin: 0;">
                    📅 @(I18n.IsBangla ? "তারিখভিত্তিক রোগের অনুপাত ও ডায়াগনস্টিক পরীক্ষার হিসেব" : "Date-Wise Longitudinal Disease Ratio & Investigation Flow")
                </h3>
                <div style="font-size: 12px; color: #64748b; margin-top: 2px;">
                    @(I18n.IsBangla
                        ? "প্রতিদিনের টেস্ট ভলিউম, প্যাথোলজি অস্বাভাবিকতার হার, ইমেজিং ফাইন্ডিংস এবং প্রধান শনাক্তকৃত রোগসমূহ"
                        : "Daily investigation volume, pathology abnormal ratio, imaging positive findings, and top clinical conditions")
                </div>
            </div>
            <div style="display: flex; gap: 8px;">
                <span class="pill" style="background:#e0f2fe; color:#0369a1; font-weight:700;">@dailySummaries.Count Days Recorded</span>
            </div>
        </div>

        <div style="overflow-x: auto;">
            <table class="dash-table">
                <thead>
                    <tr>
                        <th>@(I18n.IsBangla ? "তারিখ" : "Date")</th>
                        <th style="text-align: center;">@(I18n.IsBangla ? "মোট টেস্ট" : "Total Tests")</th>
                        <th>@(I18n.IsBangla ? "প্যাথোলজি অস্বাভাবিক অনুপাত" : "Pathology Abnormal Ratio")</th>
                        <th>@(I18n.IsBangla ? "ইমেজিং ফাইন্ডিংস অনুপাত" : "Imaging Findings Ratio")</th>
                        <th>@(I18n.IsBangla ? "ঐ দিনের প্রধান শনাক্তকৃত রোগ/ফাইন্ডিংস" : "Top Detected Conditions That Day")</th>
                        <th style="text-align: right;">@(I18n.IsBangla ? "বিলিং কালেকশন" : "Daily Collection")</th>
                        <th style="text-align: center;">@(I18n.IsBangla ? "অ্যাকশন" : "Action")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (dailySummaries.Count == 0)
                    {
                        <tr>
                            <td colspan="7" style="text-align: center; padding: 30px; color: #94a3b8;">
                                @(I18n.IsBangla ? "নির্বাচিত তারিখ পরিসরে কোনো ডায়াগনস্টিক রেকর্ড নেই।" : "No diagnostic records found in selected date range.")
                            </td>
                        </tr>
                    }
                    @foreach (var day in dailySummaries)
                    {
                        <tr>
                            <td>
                                <strong style="font-size: 13px; color: #0f172a;">@day.Date.ToString("dd MMM yyyy")</strong>
                                <div style="font-size: 11px; color: #64748b;">@day.Date.ToString("dddd")</div>
                            </td>
                            <td style="text-align: center;">
                                <strong style="font-size: 14px; color: #0284c7;">@day.TotalTests</strong>
                                <div style="font-size: 10.5px; color: #64748b;">@day.PathologyCount Path &bull; @day.ImagingCount Img</div>
                            </td>
                            <td>
                                <div class="mini-ratio-bar">
                                    <div class="mini-bar-track">
                                        <div class="mini-bar-fill fill-critical" style="width: @Math.Min(100, day.PathologyAbnormalRatio)%;"></div>
                                    </div>
                                    <strong style="font-size: 12px; color: @(day.PathologyAbnormalRatio > 40 ? "#dc2626" : "#475569");">
                                        @day.PathologyAbnormalRatio.ToString("0.0")%
                                    </strong>
                                </div>
                                <div style="font-size: 10.5px; color: #94a3b8;">@day.PathologyAbnormalCount / @day.PathologyCount abnormal</div>
                            </td>
                            <td>
                                <div class="mini-ratio-bar">
                                    <div class="mini-bar-track">
                                        <div class="mini-bar-fill fill-warning" style="width: @Math.Min(100, day.ImagingAbnormalRatio)%;"></div>
                                    </div>
                                    <strong style="font-size: 12px; color: #7c3aed;">
                                        @day.ImagingAbnormalRatio.ToString("0.0")%
                                    </strong>
                                </div>
                                <div style="font-size: 10.5px; color: #94a3b8;">@day.ImagingAbnormalCount / @day.ImagingCount findings</div>
                            </td>
                            <td>
                                <div style="display: flex; flex-wrap: wrap; gap: 4px;">
                                    @foreach (var cond in day.TopConditions.Take(3))
                                    {
                                        <span class="disease-tag" style="font-size: 10px; padding: 2px 6px;">
                                            @cond
                                        </span>
                                    }
                                    @if (day.TopConditions.Count > 3)
                                    {
                                        <span style="font-size: 10px; color: #64748b;">+@(day.TopConditions.Count - 3) more</span>
                                    }
                                </div>
                            </td>
                            <td style="text-align: right;">
                                <strong style="font-size: 13px; color: #059669;">@(I18n.FormatCurrency(day.Revenue))</strong>
                            </td>
                            <td style="text-align: center;">
                                <a href="diagnostic/results" class="btn btn-sm btn-secondary" style="font-size: 11px; padding: 3px 8px;">
                                    View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

