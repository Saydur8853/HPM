@page "/pharmacy/stock"
@attribute [Authorize(Roles = RoleNames.Administrator + "," + RoleNames.PharmacyOperator)]
@implements IDisposable
@inject IDbContextFactory<HpmDbContext> DbFactory
@inject IJSRuntime JS
@using HPM.Web.Components.Common

<PageTitle>@I18n.T("Stock & Expiry") | @Branding.HospitalName</PageTitle>

<div class="pharm-subnav-bar">
    <div>
        <h1 style="margin:0; font-size:20px; font-weight:800; color:#0f172a;">@I18n.T("Stock & Expiry")</h1>
    </div>

    <div class="pharm-tab-pills">
        <button type="button" class="pharm-tab-pill @(viewTab == "summary" ? "active" : "")" @onclick='() => viewTab = "summary"'>
            @I18n.T("Medicine Summary") (@rows.Count)
        </button>
        <button type="button" class="pharm-tab-pill @(viewTab == "batches" ? "active" : "")" @onclick='() => viewTab = "batches"'>
            @I18n.T("Batch & Expiry List") (@batches.Count(x => x.Balance > 0))
        </button>
    </div>

    <div style="display:flex; gap:6px; align-items:center; flex-wrap:wrap;">
        <NavLink class="btn btn-ghost btn-sm" href="/pharmacy/stock-control">@I18n.T("Transfer / Ward Issue")</NavLink>
        <NavLink class="btn btn-ghost btn-sm" href="/pharmacy/requisition">@I18n.T("Purchase Requisition")</NavLink>
        <button class="btn btn-secondary btn-sm" @onclick="PrintStockReportAsync">@I18n.T("Print A4 Report")</button>
    </div>
</div>

<div class="metric-grid" style="margin-bottom:16px;">
    <div class="metric-card accent-blue"><span>@I18n.T("Medicines")</span><strong>@rows.Count</strong></div>
    <div class="metric-card accent-red"><span>@I18n.T("Low / Out of Stock")</span><strong>@rows.Count(x => x.IsLow)</strong></div>
    <div class="metric-card accent-amber"><span>@I18n.T("Expiring in 90 Days")</span><strong>@batches.Count(x => x.Balance > 0 && x.ExpireDate <= DateTime.Today.AddDays(90) && x.ExpireDate >= DateTime.Today)</strong></div>
    <div class="metric-card accent-violet"><span>@I18n.T("Stock Value (TP)")</span><strong>@I18n.FormatCurrency(rows.Sum(x => x.StockValue))</strong></div>
</div>

<div class="panel">
    <div style="padding:12px 18px; display:flex; justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap; border-bottom:1px solid #e2e8f0;">
        <div class="pharm-tab-pills">
            <button type="button" class="pharm-tab-pill @(stockFilter == "all" ? "active" : "")" @onclick='() => stockFilter = "all"'>
                @I18n.T("All") (@rows.Count)
            </button>
            <button type="button" class="pharm-tab-pill @(stockFilter == "low" ? "active" : "")" @onclick='() => stockFilter = "low"'>
                @I18n.T("Low Stock") (@rows.Count(x => x.IsLow))
            </button>
            <button type="button" class="pharm-tab-pill @(stockFilter == "expiring" ? "active" : "")" @onclick='() => stockFilter = "expiring"'>
                @I18n.T("Expiring Soon") (@rows.Count(x => x.NearestExpiry.HasValue && x.NearestExpiry.Value <= DateTime.Today.AddDays(90) && x.NearestExpiry.Value >= DateTime.Today))
            </button>
            <button type="button" class="pharm-tab-pill @(stockFilter == "expired" ? "active" : "")" @onclick='() => stockFilter = "expired"'>
                @I18n.T("Expired") (@rows.Count(x => x.NearestExpiry.HasValue && x.NearestExpiry.Value < DateTime.Today))
            </button>
        </div>

        <div style="display:flex; gap:8px; align-items:center; flex:1; max-width:380px;">
            <select style="width:145px;" @bind="selectedStoreFilter">
                <option value="0">@I18n.T("All Stores")</option>
                @foreach (var s in stores)
                {
                    <option value="@s.ID">@s.Name</option>
                }
            </select>
            <input type="text"
                   style="flex:1;"
                   placeholder="@I18n.T("Search medicine or batch...")"
                   @bind="search"
                   @bind:event="oninput" />
        </div>
    </div>

    @if (viewTab == "summary")
    {
        <div class="data-table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>@I18n.T("Medicine")</th>
                        <th>@I18n.T("Store")</th>
                        <th class="num">@I18n.T("Available Qty")</th>
                        <th class="num">@I18n.T("Alert Level")</th>
                        <th>@I18n.T("Nearest Expiry")</th>
                        <th>@I18n.T("Status")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (FilteredRows.Count == 0)
                    {
                        <tr><td colspan="6"><div class="empty-state small">@I18n.T("No stock records match the selected filter.")</div></td></tr>
                    }
                    @foreach (var x in FilteredRows)
                    {
                        <tr>
                            <td><b>@x.MedicineName</b>@if (!string.IsNullOrWhiteSpace(x.BatchSummary)) { <br /><small class="text-muted">@x.BatchSummary</small> }</td>
                            <td>@x.StoreName</td>
                            <td class="num"><b>@x.Balance.ToString("N0")</b></td>
                            <td class="num">@x.ReOrderLevel</td>
                            <td>@(x.NearestExpiry?.ToString("dd MMM yyyy") ?? "—")</td>
                            <td><span class="pill @(x.IsLow ? "pill-danger" : "pill-success")">@(x.IsLow ? I18n.T("LOW STOCK") : I18n.T("AVAILABLE"))</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="data-table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>@I18n.T("Medicine")</th>
                        <th>@I18n.T("Store")</th>
                        <th>@I18n.T("Batch")</th>
                        <th>@I18n.T("Expiry Date")</th>
                        <th class="num">@I18n.T("Balance")</th>
                        <th>@I18n.T("Status")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (FilteredBatches.Count == 0)
                    {
                        <tr><td colspan="6"><div class="empty-state small">@I18n.T("No batch records match.")</div></td></tr>
                    }
                    @foreach (var x in FilteredBatches)
                    {
                        <tr>
                            <td><b>@MedicineName(x.ServiceID)</b></td>
                            <td>@StoreName(x.MedicineStoreID)</td>
                            <td>@(x.BatchNo ?? "—")</td>
                            <td>@(x.ExpireDate?.ToString("dd MMM yyyy") ?? "—")</td>
                            <td class="num"><b>@x.Balance.ToString("N0")</b></td>
                            <td><span class="pill @(BatchStatusClass(x))">@BatchStatusText(x)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Official Printable A4 Stock & Expiry Report -->
<div id="pharmacy-stock-print" class="print-sheet panel print-document print-a4-sheet pharm-print-only">
    <PrintDocumentHeader Title="@I18n.T("Pharmacy Stock & Expiry Report")"
                         SubTitle="@($"{I18n.T("Filter")}: {stockFilter.ToUpperInvariant()}")"
                         DocumentNo="@($"STK-{DateTime.Now:yyyyMMdd}")" />
    <table class="data-table">
        <thead>
            <tr>
                <th>#</th>
                <th>@I18n.T("Medicine")</th>
                <th>@I18n.T("Store")</th>
                <th>@I18n.T("Batches")</th>
                <th>@I18n.T("Nearest Expiry")</th>
                <th class="num">@I18n.T("Stock Qty")</th>
                <th class="num">@I18n.T("Value (TP)")</th>
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < FilteredRows.Count; i++)
            {
                var r = FilteredRows[i];
                <tr>
                    <td>@(i + 1)</td>
                    <td><b>@r.MedicineName</b></td>
                    <td>@r.StoreName</td>
                    <td>@(string.IsNullOrWhiteSpace(r.BatchSummary) ? "—" : r.BatchSummary)</td>
                    <td>@(r.NearestExpiry?.ToString("dd MMM yyyy") ?? "—")</td>
                    <td class="num"><b>@r.Balance.ToString("N0")</b></td>
                    <td class="num">@I18n.FormatCurrency(r.StockValue)</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="print-total">
        <div class="grand">
            <span>@I18n.T("Total Stock Value")</span>
            <b>@I18n.FormatCurrency(FilteredRows.Sum(x => x.StockValue))</b>
        </div>
    </div>
    <PrintDocumentFooter Signatures='new string[] { I18n.T("Prepared By"), I18n.T("Pharmacy In-Charge") }' />
</div>

@code {
    private List<Service> medicines = [];
    private List<MedicineStore> stores = [];
    private List<MedicineStoreBalance> batches = [];
    private List<StockRow> rows = [];
    private string search = "";
    private string stockFilter = "all";
    private string viewTab = "summary";
    private int selectedStoreFilter;

    private List<StockRow> FilteredRows
    {
        get
        {
            var list = rows.AsEnumerable();
            if (selectedStoreFilter > 0) list = list.Where(x => x.StoreID == selectedStoreFilter);
            if (stockFilter == "low") list = list.Where(x => x.IsLow);
            else if (stockFilter == "expiring") list = list.Where(x => x.NearestExpiry.HasValue && x.NearestExpiry.Value <= DateTime.Today.AddDays(90) && x.NearestExpiry.Value >= DateTime.Today);
            else if (stockFilter == "expired") list = list.Where(x => x.NearestExpiry.HasValue && x.NearestExpiry.Value < DateTime.Today);

            if (!string.IsNullOrWhiteSpace(search))
            {
                var q = search.Trim();
                list = list.Where(x => x.MedicineName.Contains(q, StringComparison.OrdinalIgnoreCase)
                                    || x.StoreName.Contains(q, StringComparison.OrdinalIgnoreCase)
                                    || x.BatchSummary.Contains(q, StringComparison.OrdinalIgnoreCase));
            }
            return list.ToList();
        }
    }

    private List<MedicineStoreBalance> FilteredBatches => batches
        .Where(x => x.Balance > 0
            && (selectedStoreFilter == 0 || x.MedicineStoreID == selectedStoreFilter)
            && (stockFilter != "expiring" || (x.ExpireDate <= DateTime.Today.AddDays(90) && x.ExpireDate >= DateTime.Today))
            && (stockFilter != "expired" || x.ExpireDate < DateTime.Today)
            && (string.IsNullOrWhiteSpace(search)
                || MedicineName(x.ServiceID).Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)
                || StoreName(x.MedicineStoreID).Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)
                || (x.BatchNo?.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)))
        .OrderBy(x => x.ExpireDate)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
        await LoadAsync();
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => I18n.OnLanguageChanged -= HandleLanguageChanged;

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        medicines = await db.Services.AsNoTracking().Where(x => x.CategoryID == 3).ToListAsync();
        stores = await db.MedicineStores.AsNoTracking().ToListAsync();
        batches = await db.MedicineStoreBalances.AsNoTracking().ToListAsync();
        rows = batches.GroupBy(x => new { x.ServiceID, x.MedicineStoreID }).Select(g =>
        {
            var m = medicines.FirstOrDefault(x => x.ID == g.Key.ServiceID);
            var bal = g.Sum(x => x.Balance);
            return new StockRow(
                g.Key.MedicineStoreID,
                m?.Name ?? "—",
                StoreName(g.Key.MedicineStoreID),
                bal,
                m?.ReOrderLevel ?? 0,
                g.Where(x => x.Balance > 0).Min(x => x.ExpireDate),
                string.Join(", ", g.Where(x => x.Balance > 0 && !string.IsNullOrWhiteSpace(x.BatchNo)).Select(x => x.BatchNo).Distinct()),
                (m?.BuyRate ?? 0) * bal);
        }).OrderBy(x => x.MedicineName).ToList();
    }

    private async Task PrintStockReportAsync() => await JS.InvokeVoidAsync("hpm.printElement", "pharmacy-stock-print", "Pharmacy Stock Report");

    private string MedicineName(int id) => medicines.FirstOrDefault(x => x.ID == id)?.Name ?? "—";
    private string StoreName(int id) => stores.FirstOrDefault(x => x.ID == id)?.Name ?? "—";
    private static string BatchStatus(MedicineStoreBalance x) => x.Balance <= 0 ? "OUT" : x.ExpireDate < DateTime.Today ? "EXPIRED" : x.ExpireDate <= DateTime.Today.AddDays(90) ? "EXPIRING" : "OK";
    private string BatchStatusText(MedicineStoreBalance x) => BatchStatus(x) switch
    {
        "OUT" => I18n.T("OUT"),
        "EXPIRED" => I18n.T("EXPIRED"),
        "EXPIRING" => I18n.T("EXPIRING"),
        _ => I18n.T("OK")
    };
    private static string BatchStatusClass(MedicineStoreBalance x) => BatchStatus(x) is "OUT" or "EXPIRED" ? "pill-danger" : BatchStatus(x) == "EXPIRING" ? "pill-warning" : "pill-success";

    private sealed record StockRow(int StoreID, string MedicineName, string StoreName, decimal Balance, int ReOrderLevel, DateTime? NearestExpiry, string BatchSummary, decimal StockValue)
    {
        public bool IsLow => Balance <= ReOrderLevel;
    }
}
