<img src="/images/pathologist-icon.jpg"
     alt="Pathologist"
     class="@CssClass"
     style="width:@(Size > 0 ? $"{Size}px" : "20px"); height:@(Size > 0 ? $"{Size}px" : "20px"); object-fit:contain; mix-blend-mode:multiply; display:inline-block; vertical-align:middle;" />

@code {
    [Parameter]
    public string CssClass { get; set; } = "pathologist-icon";

    [Parameter]
    public int Size { get; set; } = 22;
}
