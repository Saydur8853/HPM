@using HPM.Web.Components.Common

<div class="print-brand-header">
    <div class="print-brand-main">
        <div class="print-brand-logo-wrap">
            @if (!string.IsNullOrWhiteSpace(Branding.LogoData))
            {
                <img src="@Branding.LogoData" alt="Logo" class="print-brand-img" />
            }
            else
            {
                <div class="print-brand-badge-fallback">🏥</div>
            }
        </div>
        <div class="print-brand-info">
            <h1 class="print-hospital-name">@Branding.HospitalName</h1>
            <p class="print-hospital-tagline">@(string.IsNullOrWhiteSpace(Subtitle) ? (string.IsNullOrWhiteSpace(Branding.Tagline) ? "Hospital & Patient Management System" : Branding.Tagline) : Subtitle)</p>
            <div class="print-hospital-contact">
                <div class="print-contact-address">📍 @Branding.Address@(string.IsNullOrWhiteSpace(Branding.CityDistrict) ? "" : $", {Branding.CityDistrict}")</div>
                <div class="print-contact-other">
                    @if (!string.IsNullOrWhiteSpace(Branding.Hotline) || !string.IsNullOrWhiteSpace(Branding.Phone))
                    {
                        <span>📞 Hotline: @(string.IsNullOrWhiteSpace(Branding.Hotline) ? Branding.Phone : Branding.Hotline)</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Branding.Email))
                    {
                        if (!string.IsNullOrWhiteSpace(Branding.Hotline) || !string.IsNullOrWhiteSpace(Branding.Phone))
                        {
                            <span> &bull; </span>
                        }
                        <span>✉️ @Branding.Email</span>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(EffectiveDocNo) || !string.IsNullOrWhiteSpace(BarcodeCode) || !string.IsNullOrWhiteSpace(QrPayload) || RightContent != null)
    {
        <div class="print-brand-meta">
            @if (!string.IsNullOrWhiteSpace(EffectiveDocNo))
            {
                <div class="print-doc-pill">
                    <span class="print-doc-pill-label">@(DocNoLabel ?? "ID / No"):</span>
                    <strong class="print-doc-pill-value">@EffectiveDocNo</strong>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(BarcodeCode) || !string.IsNullOrWhiteSpace(QrPayload))
            {
                <BarcodeQrView Code="@BarcodeCode"
                               QrPayload="@QrPayload"
                               Layout="side-by-side"
                               BarHeight="28"
                               QrPixelsPerModule="2"
                               IncludeBarcodeText="true" />
            }
            @RightContent
        </div>
    }
</div>

@if (!string.IsNullOrWhiteSpace(Title))
{
    <div class="print-document-title-bar">
        <h2>@Title</h2>
    </div>
}

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? DocNo { get; set; }
    [Parameter] public string? DocumentNo { get; set; }
    [Parameter] public string? DocNoLabel { get; set; }
    [Parameter] public string? BarcodeCode { get; set; }
    [Parameter] public string? QrPayload { get; set; }
    [Parameter] public RenderFragment? RightContent { get; set; }

    private string? EffectiveDocNo => !string.IsNullOrWhiteSpace(DocNo) ? DocNo : DocumentNo;
}
