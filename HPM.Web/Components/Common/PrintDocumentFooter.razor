<div class="print-document-footer">
    @if (!HideSignatures)
    {
        <div class="print-signatures-row">
            @if (CustomSignatures != null)
            {
                @CustomSignatures
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(SignTitle1))
                {
                    <div class="print-signature-col">
                        <div class="print-signature-line"></div>
                        <span class="print-signature-title">@I18n.T(SignTitle1)</span>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(SignTitle2))
                {
                    <div class="print-signature-col">
                        <div class="print-signature-line"></div>
                        <span class="print-signature-title">@I18n.T(SignTitle2)</span>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(SignTitle3))
                {
                    <div class="print-signature-col" style="@(string.IsNullOrWhiteSpace(SignTitle1) && string.IsNullOrWhiteSpace(SignTitle2) ? "margin-left: auto;" : "")">
                        <div class="print-signature-line"></div>
                        <span class="print-signature-title">@I18n.T(SignTitle3)</span>
                    </div>
                }
            }
        </div>
    }

    @if (!HideLegalNotice)
    {
        <div class="print-legal-notice-strip">
            <p class="print-disclaimer-text">@I18n.T("It is an auto generated report. Please contact report delivery desk to collect the signed copy.", "It is an auto generated report. Please contact report delivery desk to collect the signed copy.")</p>
            <div class="print-meta-bottom-row">
                <span class="print-generated-time">@I18n.T("Printed on"): @DateTime.Now.ToString("dd MMM yyyy hh:mm tt")</span>
                <span class="print-page-number">@PageNumberText</span>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string? SignTitle1 { get; set; }
    [Parameter] public string? SignTitle2 { get; set; }
    [Parameter] public string? SignTitle3 { get; set; } = "Authorized Officer";
    [Parameter] public bool HideSignatures { get; set; } = false;
    [Parameter] public bool HideLegalNotice { get; set; } = false;
    [Parameter] public RenderFragment? CustomSignatures { get; set; }
    [Parameter] public string PageNumberText { get; set; } = "Page 1 of 1";

    [Parameter] public IEnumerable<string>? Signatures { get; set; }

    protected override void OnParametersSet()
    {
        if (Signatures != null)
        {
            var list = Signatures.ToList();
            if (list.Count == 1)
            {
                SignTitle1 = null;
                SignTitle2 = null;
                SignTitle3 = list[0];
            }
            else if (list.Count == 2)
            {
                SignTitle1 = list[0];
                SignTitle2 = null;
                SignTitle3 = list[1];
            }
            else if (list.Count >= 3)
            {
                SignTitle1 = list[0];
                SignTitle2 = list[1];
                SignTitle3 = list[2];
            }
        }
    }
}
