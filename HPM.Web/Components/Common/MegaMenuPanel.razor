@* Shared mega-menu dropdown (Pharmacy-style): header, colour-coded sections of icon links, optional footer shortcut. *@

<div class="@PositionClass pharm-menu-dropdown @(AlignEnd ? "align-end" : "") @(Compact ? "compact" : "")" style="--pm-cols:@ColumnCount" role="menu">
    <div class="pharm-menu-head">
        <span class="pharm-menu-head-icon">@Icon</span>
        <div class="pharm-menu-head-text">
            <strong>@I18n.T(Title)</strong>
            @if (!Compact && !string.IsNullOrWhiteSpace(Subtitle))
            {
                <small>@I18n.T(Subtitle)</small>
            }
        </div>
        <button type="button" class="pharm-menu-close" @onclick="OnClose" title="@I18n.T("Close")">✕</button>
    </div>

    <div class="pharm-menu-grid">
        @for (var i = 0; i < VisibleSections.Count; i++)
        {
            var sec = VisibleSections[i];
            <div class="pharm-menu-col @AccentClass(sec, i)">
                @if (!string.IsNullOrWhiteSpace(sec.Title))
                {
                    <div class="pharm-menu-col-title">
                        <span class="pharm-menu-col-icon">@sec.Icon</span>
                        <span>@I18n.T(sec.Title)</span>
                    </div>
                }
                <div class="pharm-menu-col-links">
                    @foreach (var link in sec.Links)
                    {
                        <NavLink class="@("pharm-menu-link" + (link.Disabled ? " menu-disabled" : ""))" href="@link.Href" Match="NavLinkMatch.All" @onclick="OnClose"
                                 tabindex="@(link.Disabled ? "-1" : null)" aria-disabled="@(link.Disabled ? "true" : null)">
                            <span class="pharm-menu-link-icon">@link.Icon</span>
                            <span class="pharm-menu-link-text">
                                <strong>@I18n.T(link.Label)</strong>
                                @if (!Compact && !string.IsNullOrWhiteSpace(link.Subtitle))
                                {
                                    <small title="@I18n.T(link.Subtitle)">@I18n.T(link.Subtitle)</small>
                                }
                            </span>
                            @if (!string.IsNullOrWhiteSpace(link.Badge))
                            {
                                <span class="pharm-menu-badge">@link.Badge</span>
                            }
                            <span class="pharm-menu-arrow">&rsaquo;</span>
                        </NavLink>
                    }
                </div>
            </div>
        }
    </div>

    @if (Footer != null)
    {
        <div class="pharm-menu-footer">
            <NavLink class="@("pharm-menu-setup-link" + (Footer.Disabled ? " menu-disabled" : ""))" href="@Footer.Href" Match="NavLinkMatch.Prefix" @onclick="OnClose"
                     tabindex="@(Footer.Disabled ? "-1" : null)" aria-disabled="@(Footer.Disabled ? "true" : null)">
                <span class="pharm-menu-link-icon">@Footer.Icon</span>
                <span class="pharm-menu-link-text">
                    <strong>@I18n.T(Footer.Label)</strong>
                    @if (!string.IsNullOrWhiteSpace(Footer.Subtitle))
                    {
                        <small>@I18n.T(Footer.Subtitle)</small>
                    }
                </span>
                <span class="pharm-menu-setup-badge">@I18n.T("Open") &rsaquo;</span>
            </NavLink>
        </div>
    }
</div>

@code {
    /// <summary>Positioning class of the host menu, e.g. "header-backoffice-dropdown" or "legacy-menu-dropdown".</summary>
    [Parameter] public string PositionClass { get; set; } = "header-backoffice-dropdown";
    [Parameter] public string Icon { get; set; } = "📁";
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<MegaMenuSection> Sections { get; set; } = [];
    [Parameter] public MegaMenuLink? Footer { get; set; }
    [Parameter] public bool AlignEnd { get; set; }
    /// <summary>Titles only (no descriptions), narrower columns.</summary>
    [Parameter] public bool Compact { get; set; }
    [Parameter] public int MaxColumns { get; set; } = 3;
    [Parameter] public EventCallback OnClose { get; set; }

    private List<MegaMenuSection> VisibleSections => Sections.Where(s => s.Links.Count > 0).ToList();
    private int ColumnCount => Math.Clamp(VisibleSections.Count, 1, Math.Max(1, MaxColumns));

    private static string AccentClass(MegaMenuSection s, int index) => !string.IsNullOrWhiteSpace(s.Accent) ? $"acc-{s.Accent}" : (index % 5) switch
    {
        0 => "acc-blue",
        1 => "acc-teal",
        2 => "acc-indigo",
        3 => "acc-amber",
        _ => "acc-rose"
    };
}
