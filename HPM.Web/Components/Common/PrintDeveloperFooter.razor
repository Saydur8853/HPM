@implements IDisposable

<div class="print-dev-brand-footer @(Compact ? "compact-thermal" : "")">
    <span class="print-dev-brand-left">
        <span>Developed by</span>
        @if (!string.IsNullOrWhiteSpace(Branding.DeveloperLogoData))
        {
            <img src="@Branding.DeveloperLogoData" alt="@Branding.DeveloperCompanyName" class="print-dev-brand-logo" />
        }
        else
        {
            <span class="print-dev-brand-badge">AP</span>
        }
        <strong>@Branding.DeveloperCompanyName</strong>
    </span>
    @if (!string.IsNullOrWhiteSpace(Branding.GetDeveloperContactText()))
    {
        <span class="print-dev-brand-sep">|</span>
        <span class="print-dev-brand-contact">Contact: @Branding.GetDeveloperContactText()</span>
    }
</div>

@code {
    [Parameter] public bool Compact { get; set; }

    protected override void OnInitialized()
    {
        Branding.OnSettingsChanged += HandleSettingsChanged;
    }

    private void HandleSettingsChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Branding.OnSettingsChanged -= HandleSettingsChanged;
    }
}
