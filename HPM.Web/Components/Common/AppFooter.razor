@implements IDisposable

<footer id="hpm-global-dev-footer"
        class="app-global-footer"
        role="contentinfo"
        data-dev-company="@Branding.DeveloperCompanyName"
        data-dev-contact="@Branding.GetDeveloperContactText()"
        data-dev-email="@Branding.DeveloperEmail"
        data-dev-phone="@Branding.DeveloperPhone"
        data-dev-logo="@Branding.DeveloperLogoData">
    <div class="app-global-footer-inner">
        <div class="app-footer-brand">
            @if (!string.IsNullOrWhiteSpace(Branding.DeveloperLogoData))
            {
                <img src="@Branding.DeveloperLogoData" alt="@Branding.DeveloperCompanyName" class="app-footer-logo" />
            }
            else
            {
                <span class="app-footer-logo-badge" aria-hidden="true">AP</span>
            }
            <span class="app-footer-dev-text">
                Developed by <strong>@Branding.DeveloperCompanyName</strong>
            </span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Branding.GetDeveloperContactText()))
        {
            <span class="app-footer-sep" aria-hidden="true">·</span>
            <span class="app-footer-contact">Contact: <strong>@Branding.GetDeveloperContactText()</strong></span>
        }

        @if (!string.IsNullOrWhiteSpace(Branding.DeveloperCopyright))
        {
            <span class="app-footer-sep" aria-hidden="true">·</span>
            <span class="app-footer-copy">@Branding.DeveloperCopyright</span>
        }
    </div>
</footer>

@code {
    protected override void OnInitialized()
    {
        Branding.OnSettingsChanged += HandleSettingsChanged;
    }

    private void HandleSettingsChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Branding.OnSettingsChanged -= HandleSettingsChanged;
    }
}
