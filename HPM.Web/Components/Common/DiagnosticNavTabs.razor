@inject NavigationManager Nav
@using HPM.Web.Security

<div class="diagnostic-flow-tabs" role="navigation" aria-label="@I18n.T("Diagnostics & Lab Workflow")">
    <NavLink href="diagnostic/billing" class="flow-tab" Match="NavLinkMatch.Prefix" title="@I18n.T("Patient Investigation Cash Memo & Receipts")">
        <span class="flow-tab-icon">🧾</span>
        <span class="flow-tab-label">@I18n.T("Billing")</span>
        <span class="flow-tab-pill">OPD/IPD</span>
    </NavLink>
    <NavLink href="diagnostic/sample-collection" class="flow-tab" Match="NavLinkMatch.Prefix" title="@I18n.T("Pathology specimen collection and tube barcode")">
        <span class="flow-tab-icon">🩸</span>
        <span class="flow-tab-label">@I18n.T("Collection")</span>
    </NavLink>
    <NavLink href="diagnostic/pathology-results" class="flow-tab" Match="NavLinkMatch.Prefix" title="@I18n.T("Pathology Findings, Normal Ranges & Report Delivery")">
        <span class="flow-tab-icon">📋</span>
        <span class="flow-tab-label">@I18n.T("Pathology Results")</span>
    </NavLink>
    <NavLink href="diagnostic/imaging-worklist" class="flow-tab" Match="NavLinkMatch.Prefix" title="@I18n.T("Imaging and radiology study queue")">
        <span class="flow-tab-icon"><RadiologyIcon /></span>
        <span class="flow-tab-label">@I18n.T("Imaging")</span>
    </NavLink>
    <NavLink href="diagnostic/imaging-results" class="flow-tab" Match="NavLinkMatch.Prefix" title="@I18n.T("Radiology findings and report entry")">
        <span class="flow-tab-icon">📝</span>
        <span class="flow-tab-label">@I18n.T("Imaging Results")</span>
    </NavLink>
    <NavLink href="diagnostic/special-worklist" class="flow-tab" Match="NavLinkMatch.Prefix" title="@I18n.T("ECG, Echo, EEG, ETT & special procedure queue")">
        <span class="flow-tab-icon">〰️</span>
        <span class="flow-tab-label">@I18n.T("Special")</span>
    </NavLink>
    <NavLink href="diagnostic/special-results" class="flow-tab" Match="NavLinkMatch.Prefix" title="@I18n.T("Special investigation findings and report")">
        <span class="flow-tab-icon">📄</span>
        <span class="flow-tab-label">@I18n.T("Special Results")</span>
    </NavLink>
    <NavLink href="diagnostic/cash-memo-return" class="flow-tab" Match="NavLinkMatch.Prefix" title="@I18n.T("Investigation Return & Cash/Ledger Refund")">
        <span class="flow-tab-icon">↩️</span>
        <span class="flow-tab-label">@I18n.T("Returns & Refund")</span>
    </NavLink>
</div>
