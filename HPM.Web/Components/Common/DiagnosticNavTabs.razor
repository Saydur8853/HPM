@inject NavigationManager Nav
@using HPM.Web.Security

<div class="diagnostic-flow-tabs" role="navigation" aria-label="@I18n.T("Diagnostics & Lab Workflow")">
    <NavLink href="diagnostic/billing" class="flow-tab" Match="NavLinkMatch.Prefix" title="@I18n.T("Patient Investigation Cash Memo & Receipts")">
        <span class="flow-tab-icon">🧾</span>
        <span class="flow-tab-label">@I18n.T("Billing")</span>
        <span class="flow-tab-pill">OPD/IPD</span>
    </NavLink>
    <NavLink href="diagnostic/worklist" class="flow-tab" Match="NavLinkMatch.Prefix" title="@I18n.T("Specimen Collection, Tube Barcode & Lab Worklist")">
        <span class="flow-tab-icon">🧪</span>
        <span class="flow-tab-label">@I18n.T("Worklist & Samples")</span>
    </NavLink>
    <NavLink href="diagnostic/results" class="flow-tab" Match="NavLinkMatch.Prefix" title="@I18n.T("Test Findings, Normal Ranges & Report Delivery")">
        <span class="flow-tab-icon">📋</span>
        <span class="flow-tab-label">@I18n.T("Results & Reports")</span>
    </NavLink>
    <NavLink href="diagnostic/cash-memo-return" class="flow-tab" Match="NavLinkMatch.Prefix" title="@I18n.T("Investigation Return & Cash/Ledger Refund")">
        <span class="flow-tab-icon">↩️</span>
        <span class="flow-tab-label">@I18n.T("Returns & Refund")</span>
    </NavLink>
    <AuthorizeView Roles="@RoleNames.Administrator">
        <NavLink href="diagnostic/masters" class="flow-tab" Match="NavLinkMatch.Prefix" title="@I18n.T("Lab Parameters, Reference Ranges & Setup")">
            <span class="flow-tab-icon">⚙️</span>
            <span class="flow-tab-label">@I18n.T("Masters")</span>
        </NavLink>
    </AuthorizeView>
</div>
