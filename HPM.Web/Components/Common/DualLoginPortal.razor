@using HPM.Web.Security
@inject IDbContextFactory<HpmDbContext> DbFactory

<div class="login-dual-layout">
    <div class="login-ambient-orbs" aria-hidden="true">
        <span class="login-orb login-orb-1"></span>
        <span class="login-orb login-orb-2"></span>
        <span class="login-orb login-orb-3"></span>
        <span class="login-ambient-grid"></span>
    </div>

    <div class="login-hero-top">
        <div class="login-hero-logo-ring">
            @if (!string.IsNullOrWhiteSpace(Branding.LogoData))
            {
                <img src="@Branding.LogoData" alt="Hospital Logo" class="login-hero-logo" />
            }
            else
            {
                <div class="login-hero-fallback">
                    <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 6v12M6 12h12" />
                        <rect x="3" y="3" width="18" height="18" rx="4" />
                    </svg>
                </div>
            }
        </div>
        <div class="login-hero-copy">
            <span class="login-hero-eyebrow">
                <span class="login-live-dot" aria-hidden="true"></span>
                @I18n.T("Secure care access", "নিরাপদ সেবা প্রবেশ")
            </span>
            <h1 class="login-hero-title">@Branding.HospitalName</h1>
            @if (!string.IsNullOrWhiteSpace(Branding.Tagline))
            {
                <p class="login-hero-motto">@Branding.Tagline</p>
            }
        </div>
        <div class="login-trust-pill" aria-label="Secure encrypted access">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                <path d="m9 12 2 2 4-4" />
            </svg>
            <span>@I18n.T("Protected portal", "সুরক্ষিত পোর্টাল")</span>
        </div>
    </div>

    <div class="login-dual-grid">
        <section class="login-card login-glass-card login-card-staff @(ActiveMode == "staff" ? "is-focused" : "") @(IsStaffRateLimited ? "is-rate-limited" : "")" aria-label="Staff Login">
            <span class="login-card-accent" aria-hidden="true"></span>
            <div class="login-card-head staff">
                <div class="login-card-icon staff">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                </div>
                <div class="login-card-head-text">
                    <span class="login-role-chip staff">@I18n.T("Hospital & Staff", "হাসপাতাল ও স্টাফ")</span>
                    <h2>@I18n.T("Staff Sign In", "স্টাফ সাইন ইন")</h2>
                </div>
            </div>

            @if (StaffError == "1")
            {
                <div class="login-alert danger">⚠️ @I18n.T("Invalid username or password.")</div>
            }
            @if (Setup == 1)
            {
                <div class="login-alert success">✅ @I18n.T("Setup completed! Please sign in with your administrator account.")</div>
            }

            <form method="post" action="/account/login" class="login-form-modern" aria-hidden="@IsStaffRateLimited">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@SafeStaffReturnUrl" />
                <div class="login-honeypot" aria-hidden="true">
                    <label for="login-company-website">Company website</label>
                    <input id="login-company-website" name="CompanyWebsite" type="text" tabindex="-1" autocomplete="off" />
                </div>

                <label class="login-field">
                    <span>@I18n.T("Username")</span>
                    <div class="login-input-wrap">
                        <span class="login-input-icon" aria-hidden="true">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                <circle cx="12" cy="7" r="4" />
                            </svg>
                        </span>
                        <input class="login-input has-leading" name="UserName" autocomplete="username" placeholder="@I18n.T("Enter username")" required autofocus="@(ActiveMode == "staff")" disabled="@IsStaffRateLimited" />
                    </div>
                </label>

                <label class="login-field">
                    <span>@I18n.T("Password")</span>
                    <div class="login-password-wrap">
                        <span class="login-input-icon" aria-hidden="true">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                            </svg>
                        </span>
                        <input id="login-password" class="login-input has-leading has-toggle" name="Password" type="password" autocomplete="current-password" placeholder="@I18n.T("Enter password")" required disabled="@IsStaffRateLimited" />
                        <button type="button" class="login-eye-btn" onclick="togglePasswordVisibility('login-password', 'eye-icon', 'eye-off-icon')" aria-label="Toggle password visibility" disabled="@IsStaffRateLimited">
                            <svg id="eye-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <svg id="eye-off-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        </button>
                    </div>
                </label>

                <button class="login-submit-btn" type="submit" disabled="@IsStaffRateLimited">
                    <span>@I18n.T("Sign In")</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                </button>
            </form>
            @if (IsStaffRateLimited)
            {
                <RateLimitOverlay Seconds="@SafeStaffRetryAfter" CardSelector=".login-card-staff" />
            }
        </section>

        <section class="login-card login-glass-card login-card-patient @(ActiveMode == "patient" ? "is-focused" : "") @(IsPatientRateLimited ? "is-rate-limited" : "")" aria-label="Patient Portal">
            <span class="login-card-accent" aria-hidden="true"></span>
            <div class="login-card-head patient">
                <div class="login-card-icon patient">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                    </svg>
                </div>
                <div class="login-card-head-text">
                    <span class="login-role-chip patient">@I18n.T("For Patients", "রোগীদের জন্য")</span>
                    <h2>@I18n.T("Patient Portal", "রোগী পোর্টাল")</h2>
                </div>
            </div>

            @if (PatientError == "1")
            {
                <div class="login-alert danger" role="alert">⚠️ @I18n.T("Patient ID or registered phone number did not match.")</div>
            }

            <form method="post" action="/patient/login-submit" class="login-form-modern" autocomplete="off" aria-hidden="@IsPatientRateLimited">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@SafePatientReturnUrl" />
                <div class="login-honeypot" aria-hidden="true">
                    <label for="patient-company-website">Company website</label>
                    <input id="patient-company-website" name="CompanyWebsite" type="text" tabindex="-1" autocomplete="off" />
                </div>

                <label class="login-field">
                    <span>@I18n.T("Patient ID")</span>
                    <div class="login-input-wrap">
                        <span class="login-input-icon" aria-hidden="true">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="4" width="18" height="16" rx="2" />
                                <line x1="7" y1="9" x2="17" y2="9" />
                                <line x1="7" y1="13" x2="13" y2="13" />
                            </svg>
                        </span>
                        <input class="login-input has-leading" name="PatientID" value="@(PatientId?.Trim())" required maxlength="11" autocomplete="off" placeholder="@I18n.T("Enter Patient ID")" autofocus="@(ActiveMode == "patient" && string.IsNullOrWhiteSpace(PatientId))" disabled="@IsPatientRateLimited" />
                    </div>
                </label>

                <label class="login-field">
                    <span>@I18n.T("Registered Phone Number")</span>
                    <div class="login-password-wrap">
                        <span class="login-input-icon" aria-hidden="true">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                            </svg>
                        </span>
                        <span class="login-phone-prefix" aria-hidden="true">+88</span>
                        <input id="patient-phone-input" class="login-input has-leading-prefix has-toggle" name="Phone" value="@(PatientPhone?.Trim().StartsWith("+88") == true ? PatientPhone.Trim()[3..] : PatientPhone?.Trim())" required maxlength="50" type="password" inputmode="tel" autocomplete="new-password" placeholder="01XXXXXXXXX" disabled="@IsPatientRateLimited" />
                        <button type="button" class="login-eye-btn" onclick="togglePasswordVisibility('patient-phone-input', 'p-eye-icon', 'p-eye-off-icon')" aria-label="Toggle phone visibility" disabled="@IsPatientRateLimited">
                            <svg id="p-eye-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <svg id="p-eye-off-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        </button>
                    </div>
                </label>

                <button type="submit" class="login-submit-btn patient-submit" disabled="@IsPatientRateLimited">
                    <span>@I18n.T("Open Patient Portal", "পোর্টাল খুলুন")</span>
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h4l3-8 4 16 3-8h4" /></svg>
                </button>
            </form>
            @if (IsPatientRateLimited)
            {
                <RateLimitOverlay Seconds="@SafePatientRetryAfter" CardSelector=".login-card-patient" />
            }
        </section>
    </div>

    <section class="login-emergency-hub" aria-label="Emergency contacts and blood availability">
        <div class="login-emergency-head">
            <div>
                <span class="login-emergency-kicker">@I18n.T("Emergency Information")</span>
                <h2>@I18n.T("Quick help & live blood availability")</h2>
            </div>
            <div class="login-blood-header-actions">
                @if (!string.IsNullOrWhiteSpace(Branding.BloodBankPhone))
                {
                    <a class="login-blood-call-pill" href="tel:@Branding.BloodBankPhone" title="@I18n.T("Call Blood Bank")">
                        <svg width="13" height="15" viewBox="0 0 24 28" fill="none" aria-hidden="true">
                            <path d="M12 1.8C12 1.8 4 11.4 4 17.5C4 22.1 7.6 25.8 12 25.8C16.4 25.8 20 22.1 20 17.5C20 11.4 12 1.8 12 1.8Z" fill="#dc2626"/>
                            <path d="M8.8 17.6C8.8 19.5 9.9 21 11.4 21.6" stroke="#fecaca" stroke-width="1.8" stroke-linecap="round"/>
                        </svg>
                        <span>@I18n.T("Blood Bank"): <strong>@Branding.BloodBankPhone</strong></span>
                    </a>
                }
                <span class="login-live-status"><i></i>@I18n.T("Live Blood Bank Stock")</span>
            </div>
        </div>

        <div class="login-emergency-content">
            <div class="login-emergency-contacts">
                @if (!string.IsNullOrWhiteSpace(Branding.AmbulancePhone))
                {
                    <a class="login-emergency-contact ambulance" href="tel:@Branding.AmbulancePhone">
                        <span class="login-emergency-icon" aria-hidden="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M10 17h4V7H3a1 1 0 0 0-1 1v9h2"/>
                                <path d="M14 9h4.2a1 1 0 0 1 .85.48l2.6 4.16a1 1 0 0 1 .15.53V17h-2"/>
                                <circle cx="7" cy="17.5" r="2"/>
                                <circle cx="17.5" cy="17.5" r="2"/>
                                <path d="M7.5 10v4M5.5 12h4"/>
                                <path d="M9 5h2M10 3.5V5"/>
                            </svg>
                        </span>
                        <span><small>@Branding.AmbulanceTitle</small><strong>@Branding.AmbulancePhone</strong></span>
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(Branding.FireServicePhone))
                {
                    <a class="login-emergency-contact fire" href="tel:@Branding.FireServicePhone">
                        <span class="login-emergency-icon" aria-hidden="true">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none">
                                <circle cx="12" cy="12" r="11" fill="#ef4444"/>
                                <path d="M12.6 5.2c1.1 2.1 4.2 4.3 4.2 7.8 0 2.8-2.1 5-4.8 5s-4.8-2.2-4.8-5c0-1.6.7-3.1 1.7-4.3-.1 1 .2 1.8.8 2.3.1-2.1 1.4-4 2.9-5.8Z" fill="#ffffff"/>
                                <path d="M12.2 12.2c.7 1 1.8 2 1.8 3.3 0 1.2-.9 2.1-2 2.1s-2-.9-2-2.1c0-.8.3-1.5.8-2 .1.5.4.9.8 1.1.1-.9.3-1.7.6-2.4Z" fill="#ef4444"/>
                            </svg>
                        </span>
                        <span><small>@I18n.T("Fire Service")</small><strong>@Branding.FireServicePhone</strong></span>
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(Branding.EmergencyHotline))
                {
                    <a class="login-emergency-contact hotline" href="tel:@Branding.EmergencyHotline">
                        <span class="login-emergency-icon" aria-hidden="true">
                            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/>
                                <path d="M15 3.5a5.5 5.5 0 0 1 5.5 5.5"/>
                                <path d="M15 7a2 2 0 0 1 2 2"/>
                            </svg>
                        </span>
                        <span><small>@I18n.T("Emergency Hotline")</small><strong>@Branding.EmergencyHotline</strong></span>
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(Branding.PoliceStationPhone))
                {
                    <a class="login-emergency-contact police" href="tel:@Branding.PoliceStationPhone">
                        <span class="login-emergency-icon" aria-hidden="true">
                            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 2.5 4.5 5.6v5.7c0 4.9 3.2 9.4 7.5 10.7 4.3-1.3 7.5-5.8 7.5-10.7V5.6L12 2.5Z" fill="currentColor" fill-opacity="0.1"/>
                                <path d="m12 8.2 1.1 2.2 2.4.35-1.75 1.7.4 2.4-2.15-1.15-2.15 1.15.4-2.4-1.75-1.7 2.4-.35L12 8.2Z"/>
                            </svg>
                        </span>
                        <span><small>@(string.IsNullOrWhiteSpace(Branding.PoliceStationName) ? I18n.T("Police Station") : Branding.PoliceStationName)</small><strong>@Branding.PoliceStationPhone</strong></span>
                    </a>
                }
            </div>

            <div class="login-blood-stock">
                @foreach (var group in BloodGroups)
                {
                    var count = bloodStock.GetValueOrDefault(group);
                    <div class="login-blood-unit @(count > 0 ? "available" : "empty")">
                        <strong class="login-blood-group">
                            <svg class="login-blood-drop" width="11" height="13" viewBox="0 0 24 28" aria-hidden="true">
                                <path d="M12 1.8C12 1.8 4 11.4 4 17.5C4 22.1 7.6 25.8 12 25.8C16.4 25.8 20 22.1 20 17.5C20 11.4 12 1.8 12 1.8Z" fill="#dc2626"/>
                                <path d="M8.8 17.6C8.8 19.5 9.9 21 11.4 21.6" fill="none" stroke="#fecaca" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                            @group
                        </strong>
                        @if (count > 0)
                        {
                            <span><b>@count.ToString("00")</b> @I18n.T(count == 1 ? "Bag Available" : "Bags Available")</span>
                        }
                        else
                        {
                            <span class="not-available">@I18n.T("Not available")</span>
                        }
                    </div>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Branding.HospitalBranchesInfo))
        {
            <div class="login-branch-list">
                <strong>@I18n.T("Hospital Branches")</strong>
                <div>
                    @foreach (var branch in BranchLines)
                    {
                        <span>@branch</span>
                    }
                </div>
            </div>
        }
    </section>

    <div class="login-security-note">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>
        <span>@I18n.T("Use only your assigned credentials. Your session is securely monitored.", "শুধু আপনার নির্ধারিত পরিচয়পত্র ব্যবহার করুন।")</span>
    </div>
</div>

<script>
    function togglePasswordVisibility(inputId, eyeId, eyeOffId) {
        var input = document.getElementById(inputId);
        var eye = document.getElementById(eyeId);
        var eyeOff = document.getElementById(eyeOffId);
        if (!input || !eye || !eyeOff) return;
        if (input.type === 'password') {
            input.type = 'text';
            eye.style.display = 'none';
            eyeOff.style.display = 'block';
        } else {
            input.type = 'password';
            eye.style.display = 'block';
            eyeOff.style.display = 'none';
        }
    }

    function startLoginRateLimitCountdowns() {
        document.querySelectorAll('[data-rate-limit-countdown]:not([data-countdown-started])').forEach(function (counter) {
            counter.dataset.countdownStarted = 'true';
            var remaining = Math.max(1, parseInt(counter.dataset.rateLimitCountdown || '1', 10));
            var selector = counter.dataset.cardSelector;
            var overlay = counter.closest('.login-rate-limit-overlay');

            function render() {
                var minutes = Math.floor(remaining / 60);
                var seconds = remaining % 60;
                counter.textContent = String(minutes).padStart(2, '0') + ':' + String(seconds).padStart(2, '0');
            }

            render();
            var timer = window.setInterval(function () {
                remaining -= 1;
                render();
                if (remaining <= 0) {
                    window.clearInterval(timer);
                    var card = selector ? document.querySelector(selector) : null;
                    if (card) {
                        card.classList.remove('is-rate-limited');
                        card.querySelectorAll('input, button').forEach(function (control) { control.disabled = false; });
                        card.querySelector('form')?.removeAttribute('aria-hidden');
                    }
                    if (overlay) {
                        overlay.classList.add('is-finished');
                        window.setTimeout(function () { overlay.remove(); }, 220);
                    }
                }
            }, 1000);
        });
    }

    window.setTimeout(startLoginRateLimitCountdowns, 0);
</script>

@code {
    [Parameter] public string ActiveMode { get; set; } = "staff";
    [Parameter] public string? StaffError { get; set; }
    [Parameter] public int? Setup { get; set; }
    [Parameter] public string? StaffReturnUrl { get; set; }
    [Parameter] public int? StaffRetryAfter { get; set; }

    [Parameter] public string? PatientError { get; set; }
    [Parameter] public string? PatientReturnUrl { get; set; }
    [Parameter] public string? PatientId { get; set; }
    [Parameter] public string? PatientPhone { get; set; }
    [Parameter] public int? PatientRetryAfter { get; set; }

    private bool IsStaffRateLimited => StaffError == "rate-limit" && StaffRetryAfter > 0;
    private bool IsPatientRateLimited => PatientError == "rate-limit" && PatientRetryAfter > 0;
    private int SafeStaffRetryAfter => Math.Clamp(StaffRetryAfter ?? 60, 1, 3600);
    private int SafePatientRetryAfter => Math.Clamp(PatientRetryAfter ?? 300, 1, 3600);
    private static readonly string[] BloodGroups = ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"];
    private Dictionary<string, int> bloodStock = new(StringComparer.OrdinalIgnoreCase);
    private IEnumerable<string> BranchLines => (Branding.HospitalBranchesInfo ?? "")
        .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private string SafeStaffReturnUrl => string.IsNullOrWhiteSpace(StaffReturnUrl) || !StaffReturnUrl.StartsWith('/') || StaffReturnUrl.StartsWith("//") ? "/" : StaffReturnUrl;
    private string SafePatientReturnUrl => string.IsNullOrWhiteSpace(PatientReturnUrl) || !PatientReturnUrl.StartsWith('/') || PatientReturnUrl.StartsWith("//") ? "/patient" : PatientReturnUrl;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var now = DateTime.Now;
            bloodStock = await db.BloodComponents.AsNoTracking()
                .Where(x => x.Status == "Available" && x.ExpiresAt > now)
                .GroupBy(x => x.BloodGroup)
                .Select(x => new { BloodGroup = x.Key, Count = x.Count() })
                .ToDictionaryAsync(x => x.BloodGroup, x => x.Count, StringComparer.OrdinalIgnoreCase);
        }
        catch
        {
            bloodStock = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        }
    }
}
