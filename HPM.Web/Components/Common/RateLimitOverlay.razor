<div class="login-rate-limit-overlay" role="alert" aria-live="assertive">
    <div class="login-rate-limit-icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 2" />
        </svg>
    </div>
    <strong>@I18n.T("Too many login attempts", "অতিরিক্ত লগইন চেষ্টা করা হয়েছে")</strong>
    <p>@I18n.T("For your security, this form is temporarily locked. Please try again when the timer ends.", "নিরাপত্তার জন্য ফর্মটি সাময়িকভাবে বন্ধ আছে। সময় শেষ হলে আবার চেষ্টা করুন।")</p>
    <div class="login-rate-limit-time">
        <span>@I18n.T("Try again in", "আবার চেষ্টা করুন")</span>
        <output data-rate-limit-countdown="@Seconds" data-card-selector="@CardSelector">@InitialTime</output>
    </div>
</div>

@code {
    [Parameter] public int Seconds { get; set; }
    [Parameter] public string CardSelector { get; set; } = string.Empty;

    private string InitialTime => $"{Math.Max(0, Seconds) / 60:00}:{Math.Max(0, Seconds) % 60:00}";
}
