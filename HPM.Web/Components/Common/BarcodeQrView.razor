@namespace HPM.Web.Components.Common

<div class="barcode-qr-container @Layout @(Compact ? "compact" : "")">
    @if (ShowBarcode && !string.IsNullOrWhiteSpace(Code))
    {
        <div class="barcode-wrapper" title="@Code">
            @((MarkupString)BarcodeQr.GenerateBarcodeSvg(Code, BarHeight, IncludeBarcodeText))
        </div>
    }

    @if (ShowQr && !string.IsNullOrWhiteSpace(EffectiveQrPayload))
    {
        <div class="qr-wrapper" title="@EffectiveQrPayload">
            @((MarkupString)BarcodeQr.GenerateQrSvg(EffectiveQrPayload, QrPixelsPerModule))
        </div>
    }
</div>

@code {
    [Parameter] public string Code { get; set; } = string.Empty;
    [Parameter] public string? QrPayload { get; set; }
    [Parameter] public bool ShowBarcode { get; set; } = true;
    [Parameter] public bool ShowQr { get; set; } = true;
    [Parameter] public string Layout { get; set; } = "side-by-side"; // "side-by-side", "stacked", "barcode-only", "qr-only"
    [Parameter] public int BarHeight { get; set; } = 36;
    [Parameter] public int QrPixelsPerModule { get; set; } = 3;
    [Parameter] public bool IncludeBarcodeText { get; set; } = true;
    [Parameter] public bool Compact { get; set; } = false;

    private string EffectiveQrPayload => string.IsNullOrWhiteSpace(QrPayload) ? Code : QrPayload;
}
