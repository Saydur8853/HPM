@inject HospitalLicenseService Licenses
@inject AuthenticationStateProvider AuthenticationStateProvider
@using HPM.Web.Security

@if (checking)
{
    <div style="padding:30px">Checking module access...</div>
}
else if (allowed)
{
    <AuthorizeRouteView RouteData="RouteData" DefaultLayout="typeof(Layout.MainLayout)">
        <NotAuthorized><LoginRedirect /></NotAuthorized>
    </AuthorizeRouteView>
}
else
{
    <LayoutView Layout="typeof(Layout.MainLayout)">
        <div role="alertdialog" aria-modal="true" aria-labelledby="license-title" style="position:fixed;inset:0;z-index:9999;background:#0f172a99;display:grid;place-items:center;padding:20px">
            <div style="background:white;max-width:470px;width:100%;padding:28px;border-radius:14px;box-shadow:0 20px 60px #0003">
                <h1 id="license-title" style="color:#b91c1c">Module access denied</h1>
                <p>This module is not included in your hospital's current package, or your account is not authorized to open it.</p>
                <a class="btn btn-primary" href="/">Return to dashboard</a>
            </div>
        </div>
    </LayoutView>
}

@code {
    [Parameter, EditorRequired] public RouteData RouteData { get; set; } = default!;
    private bool checking = true, allowed;
    private Type? checkedPage;

    protected override async Task OnParametersSetAsync()
    {
        if (checkedPage == RouteData.PageType) return;
        checking = true;
        checkedPage = RouteData.PageType;
        var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        try { allowed = await Licenses.CanOpenAsync(principal, RouteData.PageType); }
        catch { allowed = false; }
        checking = false;
    }
}
