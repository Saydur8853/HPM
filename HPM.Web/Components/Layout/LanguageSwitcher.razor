@inject HPM.Web.Localization.I18nService I18n
@inject IJSRuntime JS
@implements IDisposable

<div class="lang-switcher-container" title="Switch Language / ভাষা পরিবর্তন">
    <button type="button" 
            class="lang-btn @(I18n.IsEnglish ? "active" : "")" 
            @onclick="@(() => ChangeLanguage(HPM.Web.Localization.I18nService.EnglishCode))">
        <span class="lang-flag">🇬🇧</span>
        <span class="lang-text">EN</span>
    </button>
    <span class="lang-divider"></span>
    <button type="button" 
            class="lang-btn @(I18n.IsBangla ? "active" : "")" 
            @onclick="@(() => ChangeLanguage(HPM.Web.Localization.I18nService.BanglaCode))">
        <span class="lang-flag">🇧🇩</span>
        <span class="lang-text">বাংলা</span>
    </button>
</div>

@code {
    protected override void OnInitialized()
    {
        I18n.OnLanguageChanged += HandleLanguageChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await I18n.InitializeAsync(JS);
            StateHasChanged();
        }
    }

    private async Task ChangeLanguage(string code)
    {
        await I18n.SetLanguageAsync(code, JS);
    }

    private void HandleLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        I18n.OnLanguageChanged -= HandleLanguageChanged;
    }
}
