@inherits LayoutComponentBase
@inject NavigationManager Nav
@implements IDisposable

<div class="app-shell">
    <!-- Mobile Sidebar Backdrop Overlay -->
    @if (isMobileNavOpen)
    {
        <div class="sidebar-backdrop" @onclick="CloseMobileNav"></div>
    }

    @* The former sidebar is intentionally retired; desktop-compatible navigation is rendered below the topbar.
    <aside class="sidebar @(isMobileNavOpen ? "mobile-open" : "")">
        <div class="sidebar-header">
            <a class="brand" href="/" @onclick="CloseMobileNav">
                @if (!string.IsNullOrWhiteSpace(Branding.LogoData))
                {
                    <img src="@Branding.LogoData" alt="Logo" class="brand-logo-img" />
                }
                else
                {
                    <span class="brand-mark">H+</span>
                }
                <span>
                    <strong>@Branding.HospitalName</strong>
                    <small>@(string.IsNullOrWhiteSpace(Branding.Tagline) ? I18n.T("Hospital Management System") : Branding.Tagline)</small>
                </span>
            </a>
            <button class="mobile-close-btn" @onclick="CloseMobileNav" title="@I18n.T("Close Menu")">✕</button>
        </div>

        <NavMenu />

        <div class="sidebar-footer">
            <div class="status-indicator">
                <span class="status-dot"></span>
                <span>@I18n.T("System Operational")</span>
            </div>
            <small style="color: #64748b; font-weight: 700;">v2.6</small>
        </div>
    </aside>
    *@

    <main class="main-content">
        <header class="topbar">
            <div class="topbar-left">
                <button type="button" class="mobile-nav-toggle" @onclick="ToggleMobileNav" title="Toggle Navigation Menu">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>
                <a class="brand topbar-brand" href="/" @onclick="CloseMobileNav">
                    @if (!string.IsNullOrWhiteSpace(Branding.LogoData))
                    {
                        <img src="@Branding.LogoData" alt="Logo" class="brand-logo-img" />
                    }
                    else
                    {
                        <span class="brand-mark">H+</span>
                    }
                    <span>
                        <strong>@Branding.HospitalName</strong>
                        <small>@(string.IsNullOrWhiteSpace(Branding.Tagline) ? I18n.T("Hospital Management System") : Branding.Tagline)</small>
                    </span>
                </a>
                <div class="breadcrumb-module">
                    <small>@I18n.T(activeSection)</small>
                    <strong>@I18n.T(activeTitle)</strong>
                </div>
            </div>
            <div class="topbar-actions">

                <div class="live-clock-chip">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <span>@DateTime.Today.ToString("ddd, dd MMM yyyy")</span>
                </div>
                <AuthorizeView Roles="@RoleNames.Administrator">
                    <Authorized>
                        <div class="header-settings-wrapper">
                            <button type="button" class="header-settings-button @(isSettingsMenuOpen ? "open" : string.Empty)"
                                    @onclick="ToggleSettingsMenu" aria-expanded="@isSettingsMenuOpen" title="@I18n.T("Settings")">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <circle cx="12" cy="12" r="3"></circle>
                                    <path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6 1.7 1.7 0 0 0-.4 1.1V21a2 2 0 1 1-4 0v-.09A1.7 1.7 0 0 0 8.6 19.4a1.7 1.7 0 0 0-1.88.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.6-1 1.7 1.7 0 0 0-1.1-.4H3a2 2 0 1 1 0-4h.09A1.7 1.7 0 0 0 4.6 8.6a1.7 1.7 0 0 0-.34-1.88l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-.6 1.7 1.7 0 0 0 .4-1.1V3a2 2 0 1 1 4 0v.09A1.7 1.7 0 0 0 15.4 4.6a1.7 1.7 0 0 0 1.88-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.7 1.7 0 0 0 19.4 9c.12.37.34.7.63.96.3.26.68.4 1.07.4H21a2 2 0 1 1 0 4h-.09c-.4 0-.78.14-1.07.4-.3.26-.52.59-.64.96z"></path>
                                </svg>
                                <span class="header-settings-label">@I18n.T("Settings")</span>
                            </button>

                            @if (isSettingsMenuOpen)
                            {
                                <div class="header-settings-backdrop" @onclick="CloseSettingsMenu"></div>
                                <div class="header-settings-dropdown">
                                    <div class="header-settings-heading">
                                        <span class="header-settings-heading-icon">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6 1.7 1.7 0 0 0-.4 1.1V21a2 2 0 1 1-4 0v-.09A1.7 1.7 0 0 0 8.6 19.4a1.7 1.7 0 0 0-1.88.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.6-1 1.7 1.7 0 0 0-1.1-.4H3a2 2 0 1 1 0-4h.09A1.7 1.7 0 0 0 4.6 8.6a1.7 1.7 0 0 0-.34-1.88l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-.6 1.7 1.7 0 0 0 .4-1.1V3a2 2 0 1 1 4 0v.09A1.7 1.7 0 0 0 15.4 4.6a1.7 1.7 0 0 0 1.88-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.7 1.7 0 0 0 19.4 9"></path></svg>
                                        </span>
                                        <div><strong>@I18n.T("Settings")</strong><small>System configuration</small></div>
                                    </div>
                                    <div class="header-settings-grid">
                                        @foreach (var item in HeaderSettings)
                                        {
                                            <NavLink class="header-settings-item" href="@item.Href" Match="NavLinkMatch.All" @onclick="CloseSettingsMenu">@item.Label</NavLink>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView>
                    <Authorized Context="auth">
                        <div class="user-profile-dropdown-wrapper">
                            <button type="button" class="user-profile-pill" @onclick="ToggleUserMenu" aria-expanded="@isUserMenuOpen" title="@auth.User.Identity?.Name">
                                <span class="user-avatar-badge">@(GetUserInitial(auth.User.Identity?.Name))</span>
                                <div class="user-details">
                                    <strong>@auth.User.Identity?.Name</strong>
                                    <small>@(GetUserRole(auth.User))</small>
                                </div>
                                <svg class="user-dropdown-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <polyline points="6 9 12 15 18 9"></polyline>
                                </svg>
                            </button>

                            @if (isUserMenuOpen)
                            {
                                <div class="user-dropdown-backdrop" @onclick="CloseUserMenu"></div>
                                <div class="user-dropdown-menu">
                                    <div class="user-dropdown-header">
                                        <strong>@auth.User.Identity?.Name</strong>
                                        <small>@(GetUserRole(auth.User))</small>
                                    </div>
                                    <a class="user-dropdown-item" href="/account/change-password" @onclick="CloseUserMenu">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                        </svg>
                                        <span>@I18n.T("Change Password")</span>
                                    </a>
                                    <div class="user-dropdown-divider"></div>
                                    <div class="user-dropdown-lang-section">
                                        <div class="user-dropdown-section-label">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="10"></circle>
                                                <line x1="2" y1="12" x2="22" y2="12"></line>
                                                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                                            </svg>
                                            <span>@I18n.T("Language")</span>
                                        </div>
                                        <LanguageSwitcher />
                                    </div>
                                </div>
                            }
                        </div>

                        <form method="post" action="/account/logout" style="margin: 0;">
                            <AntiforgeryToken />
                            <button class="logout-button" type="submit" title="@I18n.T("Sign out")">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                    <polyline points="16 17 21 12 16 7"></polyline>
                                    <line x1="21" y1="12" x2="9" y2="12"></line>
                                </svg>
                                <span>@I18n.T("Sign out")</span>
                            </button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <LanguageSwitcher />
                        <a href="/login" class="btn btn-primary btn-sm">@I18n.T("Sign in") &rarr;</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>
        <div class="desktop-menu-host @(isMobileNavOpen ? "mobile-open" : string.Empty)">
            <div class="mobile-menu-heading">
                <strong>Menu</strong>
                <button type="button" class="mobile-close-btn" @onclick="CloseMobileNav" title="@I18n.T("Close Menu")">✕</button>
            </div>
            <NavMenu />
        </div>
                <section class="page-content">@Body</section>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">×</a>
</div>

@code {
    private string activeSection = "Clinical Operations";
    private string activeTitle = "Command Center";
    private bool isMobileNavOpen = false;
    private bool isUserMenuOpen = false;
    private bool isSettingsMenuOpen = false;

    private void ToggleUserMenu() { isSettingsMenuOpen = false; isUserMenuOpen = !isUserMenuOpen; }
    private void CloseUserMenu() => isUserMenuOpen = false;
    private void ToggleSettingsMenu() { isUserMenuOpen = false; isSettingsMenuOpen = !isSettingsMenuOpen; }
    private void CloseSettingsMenu() => isSettingsMenuOpen = false;

    protected override async Task OnInitializedAsync()
    {
        await Branding.LoadAsync();
        if (!Branding.IsSetupComplete)
        {
            Nav.NavigateTo("/setup", true);
            return;
        }
        Nav.LocationChanged += OnLocationChanged;
        I18n.OnLanguageChanged += HandleLanguageChanged;
        Branding.OnSettingsChanged += HandleSettingsChanged;
        UpdateBreadcrumb(Nav.Uri);
    }

    private void HandleSettingsChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        isMobileNavOpen = false;
        isUserMenuOpen = false;
        isSettingsMenuOpen = false;
        UpdateBreadcrumb(e.Location);
        StateHasChanged();
    }

    private void ToggleMobileNav()
    {
        isMobileNavOpen = !isMobileNavOpen;
    }

    private void CloseMobileNav()
    {
        isMobileNavOpen = false;
    }

    private void UpdateBreadcrumb(string url)
    {
        var path = new Uri(url).AbsolutePath.ToLowerInvariant().Trim('/');

        if (string.IsNullOrEmpty(path))
        {
            activeSection = "Clinical Operations";
            activeTitle = "Hospital Command Center";
        }
        else if (path.StartsWith("patients"))
        {
            activeSection = "OPD & Emergency";
            activeTitle = "Patient Registration";
        }
        else if (path.StartsWith("appointments"))
        {
            activeSection = "OPD & Emergency";
            activeTitle = "Doctor Appointments";
        }
        else if (path.StartsWith("tickets"))
        {
            activeSection = "OPD & Emergency";
            activeTitle = "Consultation Tickets";
        }
        else if (path.StartsWith("emergency-services"))
        {
            activeSection = "OPD & Emergency";
            activeTitle = "Emergency Services & Billing";
        }
        else if (path.StartsWith("ot-cash-memos"))
        {
            activeSection = "OPD & Emergency";
            activeTitle = "OT Cash Memos";
        }
        else if (path.StartsWith("ipd/bed-occupancy"))
        {
            activeSection = "IPD & Inpatient Care";
            activeTitle = "Bed Occupancy Board";
        }
        else if (path.StartsWith("ipd/admissions"))
        {
            activeSection = "IPD & Inpatient Care";
            activeTitle = "Patient Admission";
        }
        else if (path.StartsWith("ipd/advance-receipts"))
        {
            activeSection = "IPD & Inpatient Care";
            activeTitle = "Advance Money Receipts";
        }
        else if (path.StartsWith("ipd/patient-services"))
        {
            activeSection = "IPD & Inpatient Care";
            activeTitle = "Daily Patient Services";
        }
        else if (path.StartsWith("ipd/discharge-billing"))
        {
            activeSection = "IPD & Inpatient Care";
            activeTitle = "Discharge & Final Settlement";
        }
        else if (path.StartsWith("diagnostic/billing"))
        {
            activeSection = "Diagnostic & Laboratory";
            activeTitle = "Diagnostic Billing & Tokens";
        }
        else if (path.StartsWith("diagnostic/worklist"))
        {
            activeSection = "Diagnostic & Laboratory";
            activeTitle = "Specimen & Lab Worklist";
        }
        else if (path.StartsWith("diagnostic/results"))
        {
            activeSection = "Diagnostic & Laboratory";
            activeTitle = "Test Results & Reports";
        }
        else if (path.StartsWith("diagnostic/masters"))
        {
            activeSection = "Diagnostic & Laboratory";
            activeTitle = "Lab Parameter Masters";
        }
        else if (path.StartsWith("pharmacy/pos"))
        {
            activeSection = "Pharmacy & Dispensary";
            activeTitle = "Pharmacy POS Sales";
        }
        else if (path.StartsWith("pharmacy/stock-control"))
        {
            activeSection = "Pharmacy & Dispensary";
            activeTitle = "Stock Control & Audit";
        }
        else if (path.StartsWith("pharmacy/stock"))
        {
            activeSection = "Pharmacy & Dispensary";
            activeTitle = "Stock & Batch Expiry";
        }
        else if (path.StartsWith("pharmacy/purchases"))
        {
            activeSection = "Pharmacy & Dispensary";
            activeTitle = "Purchase & Stock Inward";
        }
        else if (path.StartsWith("pharmacy/returns-payments"))
        {
            activeSection = "Pharmacy & Dispensary";
            activeTitle = "Returns & Supplier Payments";
        }
        else if (path.StartsWith("pharmacy/sales-returns"))
        {
            activeSection = "Pharmacy & Dispensary";
            activeTitle = "Customer Sales Returns";
        }
        else if (path.StartsWith("pharmacy/prescriptions"))
        {
            activeSection = "Pharmacy & Dispensary";
            activeTitle = "Doctor Prescriptions";
        }
        else if (path.StartsWith("pharmacy/masters"))
        {
            activeSection = "Pharmacy & Dispensary";
            activeTitle = "Medicine & Supplier Masters";
        }
        else if (path.StartsWith("accounts"))
        {
            activeSection = "Finance & Accounts";
            activeTitle = "Chart of Accounts & Ledgers";
        }
        else if (path.StartsWith("reports"))
        {
            activeSection = "Operational Reports";
            activeTitle = "Reports & Analytics";
        }
        else if (path.StartsWith("masters/ipd"))
        {
            activeSection = "Administration Masters";
            activeTitle = "IPD & Bed Setup";
        }
        else if (path.StartsWith("masters"))
        {
            activeSection = "Administration Masters";
            activeTitle = "Clinical Master Setup";
        }
                else if (path.Contains("hospital-settings"))
        {
            activeSection = "Settings";
            activeTitle = "Hospital Profile & Branding";
        }
        else if (path.StartsWith("admin/users"))
        {
            activeSection = "Security & Administration";
            activeTitle = "Users & Role Permissions";
        }
        else if (path.StartsWith("admin/audit"))
        {
            activeSection = "Security & Audit";
            activeTitle = "System Audit Logs";
        }
        else if (path.StartsWith("account/change-password"))
        {
            activeSection = "User Profile";
            activeTitle = "Change Password";
        }
        else
        {
            activeSection = Branding.HospitalName;
            activeTitle = "Hospital Workspace";
        }
    }

    private static string GetUserInitial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        return name.Trim()[0].ToString().ToUpperInvariant();
    }

    private static readonly IReadOnlyList<HeaderSettingItem> HeaderSettings =
    [
        new("Hospital Profile & Branding", "/admin/hospital-settings"),
        new("Add User", "/admin/users"),
        new("Area Info", "/masters/clinical?section=area"),
        new("Bed & Cabin", "/masters/ipd"),
        new("Doctor Commission", "/masters/doctors?section=commission"),
        new("Doctor Profiles", "/masters/doctors"),
        new("Generic", "/pharmacy/masters?section=generic"),
        new("Lab Consultant", "/diagnostic/masters?section=consultant"),
        new("Medicine Store", "/pharmacy/masters?section=store"),
        new("Medicine Type", "/pharmacy/masters?section=type"),
        new("Package Configure", "/diagnostic/masters?section=package"),
        new("Pathology Head", "/diagnostic/masters?section=pathology-head"),
        new("Promotion Officer", "/masters/clinical?section=promotion-officer"),
        new("Services", "/masters/services"),
        new("Services (Medicine)", "/pharmacy/masters?section=services"),
        new("Supplier Medicine", "/pharmacy/masters?section=supplier"),
        new("Templates (Lab & Imaging)", "/diagnostic/masters?section=templates"),
        new("Customer Medicine", "/pharmacy/masters?section=customer")
    ];

    private static string GetUserRole(System.Security.Claims.ClaimsPrincipal user)
    {
        if (user.IsInRole("Administrator")) return "Admin";
        if (user.IsInRole("Reception")) return "Reception";
        if (user.IsInRole("Cashier")) return "Cashier";
        if (user.IsInRole("Doctor")) return "Doctor";
        if (user.IsInRole("IPDOperator")) return "IPD Desk";
        if (user.IsInRole("PharmacyOperator")) return "Pharmacy";
        if (user.IsInRole("EmergencyOperator")) return "Emergency";
        if (user.IsInRole("OTOperator")) return "OT Desk";
        return "Staff";
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        I18n.OnLanguageChanged -= HandleLanguageChanged;
        Branding.OnSettingsChanged -= HandleSettingsChanged;
    }

    private sealed record HeaderSettingItem(string Label, string Href);
}
