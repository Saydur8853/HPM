    private static bool CanViewGroup(System.Security.Claims.ClaimsPrincipal user, BackOfficeGroup group) =>
        ModuleAccess.CanView(user, group.Roles) && group.Items.Any(item => ModuleAccess.CanView(user, item.Roles));
    private static string LegacyHref(string module, string name) => $"/legacy-module?module={Uri.EscapeDataString(module)}&name={Uri.EscapeDataString(name)}";

    private static string GetUserRole(System.Security.Claims.ClaimsPrincipal user)
    {
        if (user.IsInRole(RoleNames.Administrator)) return "Admin";
        if (user.IsInRole(RoleNames.Reception)) return "Reception";
        if (user.IsInRole(RoleNames.Cashier)) return "Cashier";
        if (user.IsInRole(RoleNames.Doctor)) return "Doctor";
        if (user.IsInRole(RoleNames.IPDOperator)) return "IPD Desk";
        if (user.IsInRole(RoleNames.PharmacyOperator)) return "Pharmacy";
        if (user.IsInRole(RoleNames.EmergencyOperator)) return "Emergency";
        if (user.IsInRole(RoleNames.OTOperator)) return "OT Desk";
        if (user.IsInRole(RoleNames.LabTechnician)) return "Lab Technician";
        if (user.IsInRole(RoleNames.Nurse)) return "Nurse";
        if (user.IsInRole(RoleNames.Authorizer)) return "Authorizer";
        return "Staff";
    }

