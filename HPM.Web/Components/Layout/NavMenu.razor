@inject NavigationManager Nav
@implements IDisposable

<AuthorizeView Context="auth">
    <Authorized>
        <nav class="legacy-menu-bar" aria-label="PrimeHPM navigation menu">
            @if (openMenu != null)
            {
                <div class="legacy-menu-backdrop" @onclick="CloseMenus"></div>
            }
            @foreach (var group in MenuGroups.Where(group => CanViewGroup(auth.User, group)))
            {
                var isGroupActive = IsGroupActive(group);
                var isOpen = openMenu == group.Key;
                <div class="legacy-menu-root @(isOpen ? "open" : string.Empty) @(isGroupActive ? "active" : string.Empty)">
                    @if (!string.IsNullOrWhiteSpace(group.Href))
                    {
                        <NavLink class="legacy-menu-root-button"
                                 style="text-decoration: none;"
                                 href="@group.Href"
                                 Match="NavLinkMatch.All"
                                 ActiveClass="is-active"
                                 @onclick="CloseMenus">
                            <span class="legacy-menu-root-label">@group.Label</span>
                        </NavLink>
                    }
                    else
                    {
                        <button type="button"
                                class="legacy-menu-root-button @(isOpen ? "is-open" : string.Empty) @(isGroupActive ? "is-active" : string.Empty)"
                                aria-expanded="@isOpen"
                                @onclick="() => ToggleMenu(group.Key)">
                            <span class="legacy-menu-root-label">@group.Label</span>
                            <svg class="menu-root-caret" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </button>
                        @if (isOpen)
                        {
                            <div class="legacy-menu-dropdown @(group.Key == "diagnostics-lab" ? "mega-diagnostic-dropdown" : "")">
                                @foreach (var item in group.Items.Where(item => CanViewItem(auth.User, item)))
                                {
                                    @if (item.IsSeparator)
                                    {
                                        <div class="legacy-menu-separator" role="separator"></div>
                                    }
                                    else if (item.IsHeader)
                                    {
                                        <div class="legacy-menu-section-header">
                                            @if (!string.IsNullOrWhiteSpace(item.Icon))
                                            {
                                                <span class="legacy-menu-header-icon">
                                                    @if (item.Icon == "radiology")
                                                    {
                                                        <RadiologyIcon />
                                                    }
                                                    else
                                                    {
                                                        @item.Icon
                                                    }
                                                </span>
                                            }
                                            <span>@I18n.T(item.Label)</span>
                                        </div>
                                    }
                                    else if (item.Children.Count > 0)
                                    {
                                        var isSubOpen = openSubmenu == item.Key;
                                        <div class="legacy-menu-nested @(isSubOpen ? "open" : string.Empty)">
                                            <button type="button" class="legacy-menu-entry legacy-menu-parent @(isSubOpen ? "active" : string.Empty)" @onclick="() => ToggleSubmenu(item.Key)">
                                                <span>@item.Label</span>
                                                <svg class="legacy-menu-subarrow" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                    <polyline points="9 18 15 12 9 6"></polyline>
                                                </svg>
                                            </button>
                                            @if (isSubOpen)
                                            {
                                                <div class="legacy-menu-submenu">
                                                    @foreach (var child in item.Children.Where(child => CanViewItem(auth.User, child)))
                                                    {
                                                        <NavLink class="legacy-menu-entry" href="@child.Href" Match="NavLinkMatch.All" @onclick="CloseMenus">@child.Label</NavLink>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                    else if (item.IsLogout)
                                    {
                                        <form method="post" action="/account/logout" class="legacy-menu-form">
                                            <AntiforgeryToken />
                                            <button type="submit" class="legacy-menu-entry">@item.Label</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <NavLink class="@(string.IsNullOrWhiteSpace(item.Description) ? "legacy-menu-entry" : "legacy-menu-entry with-desc")" href="@item.Href" Match="NavLinkMatch.All" @onclick="CloseMenus">
                                            <div class="legacy-menu-entry-main">
                                                @if (!string.IsNullOrWhiteSpace(item.Icon))
                                                {
                                                    <span class="legacy-menu-entry-icon">
                                                        @if (item.Icon == "radiology")
                                                        {
                                                            <RadiologyIcon />
                                                        }
                                                        else
                                                        {
                                                            @item.Icon
                                                        }
                                                    </span>
                                                }
                                                <div class="legacy-menu-entry-text">
                                                    <span class="legacy-menu-entry-label">@I18n.T(item.Label)</span>
                                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                                    {
                                                        <span class="legacy-menu-entry-sub">@I18n.T(item.Description)</span>
                                                    }
                                                </div>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(item.Badge))
                                            {
                                                <span class="legacy-menu-entry-badge">@item.Badge</span>
                                            }
                                        </NavLink>
                                    }
                                }
                            </div>
                        }
                    }
                </div>
            }
        </nav>
    </Authorized>
</AuthorizeView>

@code {
    private string? openMenu;
    private string? openSubmenu;

    private static readonly IReadOnlyList<MenuGroup> MenuGroups =
    [
        Link("patient-registration", "Patient Registration", "/patients", ModuleAccess.PatientRegistration),
        Link("doctor-appointment", "Doctor Appointment", "/appointments", ModuleAccess.Appointments),

        Group("opd", "OPD & Emergency", ModuleAccess.OpdGroup,
            Item("OPD Ticket", "/tickets", ModuleAccess.OpdTickets),
            Item("OPD & Emergency Service", "/emergency-services", ModuleAccess.EmergencyServices),
            Item("OT Cash Memo", "/ot-cash-memos", ModuleAccess.OtCashMemos)),

        Group("ipd", "IPD Services", ModuleAccess.IpdGroup,
            Item("Patient Admission", "/ipd/admissions", ModuleAccess.IpdAdmissions),
            Item("Bed Occupancy & Transfer", "/ipd/bed-occupancy", ModuleAccess.IpdOccupancy),
            Item("Services & Charges", "/ipd/patient-services", ModuleAccess.IpdPatientServices),
            Item("Payments & Receipts", "/ipd/advance-receipts", ModuleAccess.IpdMoneyReceipts),
            Item("Medical Clearance", "/ipd/medical-discharge-orders", ModuleAccess.IpdMedicalDischarge),
            Item("Final Billing & Discharge", "/ipd/discharge-billing", ModuleAccess.IpdBilling)),

        Group("diagnostics-lab", "Diagnostics & Lab", ModuleAccess.DiagnosticGroup,
            Header("Billing & Cashier", "💳"),
            Item("Investigation Billing", "/diagnostic/billing", ModuleAccess.DiagnosticBilling, "🧾", "OPD/IPD", "Patient diagnostic cash memo, token receipt & barcode"),
            Item("Cash Memo Return & Refund", "/diagnostic/cash-memo-return", ModuleAccess.DiagnosticBilling, "↩️", "Refund", "Cancel test items & refund cash or adjust IPD ledger"),
            Separator(),
            Header("Pathology & Laboratory", "🔬"),
            Item("Sample Collection", "/diagnostic/sample-collection", ModuleAccess.DiagnosticWorklist, "🩸", "Collect", "Specimen type, tube barcode and collection tracking"),
            Item("Lab Result Entry", "/diagnostic/results", ModuleAccess.DiagnosticResults, "📋", "Results", "Parameter findings, normal ranges and pathology report"),
            Separator(),
            Header("Imaging & Radiology", "radiology"),
            Item("Imaging Worklist", "/diagnostic/imaging-worklist", ModuleAccess.DiagnosticResults, "radiology", "Studies", "X-Ray, USG, CT, MRI and procedure queue"),
            Item("Imaging Report Entry", "/diagnostic/imaging-results", ModuleAccess.DiagnosticResults, "📝", "Reports", "Radiology findings, impression, verification and print")),

        Group("reports", "Reports", ModuleAccess.Reports,
            Item("Financial Reports", "/reports?type=financial", ModuleAccess.Reports),
            Item("MIS Reports", "/reports?type=mis", ModuleAccess.Reports)),

        Group("medical", "Medical Services", ModuleAccess.MedicalGroup,
            Legacy("Operation List", "Medical Services", ModuleAccess.OtCashMemos),
            Legacy("OT Note", "Medical Services", ModuleAccess.OtCashMemos),
            Parent("nurse-desk", "Nurse's Desk",
                Legacy("Sticker/Forms", "Nurse's Desk", ModuleAccess.DoctorQueue),
                Item("Indent Medicine", "/doctor/prescriptions?view=ipd-indent", ModuleAccess.PharmacyPrescriptions),
                Item("IPD Investigation", "/diagnostic/billing?patientType=IPD", ModuleAccess.DiagnosticBilling)),
            Parent("certificates", "Certificates & Others",
                Legacy("Birth Certificate", "Certificates & Others", ModuleAccess.DoctorQueue),
                Legacy("Death Certificate", "Certificates & Others", ModuleAccess.DoctorQueue),
                Legacy("Fitness Certificate", "Certificates & Others", ModuleAccess.DoctorQueue),
                Legacy("Discharge Certificate", "Certificates & Others", ModuleAccess.DoctorQueue)))
    ];

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;
    private void ToggleMenu(string key) { openMenu = openMenu == key ? null : key; openSubmenu = null; }
    private void ToggleSubmenu(string key) => openSubmenu = openSubmenu == key ? null : key;
    private void CloseMenus() { openMenu = null; openSubmenu = null; }

    private bool IsGroupActive(MenuGroup group)
    {
        var currentRelative = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimStart('/');
        if (!string.IsNullOrWhiteSpace(group.Href))
        {
            var groupRelative = "/" + group.Href.Split('?')[0].TrimStart('/');
            return string.Equals(groupRelative, currentRelative, StringComparison.OrdinalIgnoreCase);
        }

        return group.Items.Any(item => IsItemActive(item, currentRelative));
    }

    private bool IsItemActive(MenuItem item, string currentRelative)
    {
        if (!string.IsNullOrWhiteSpace(item.Href))
        {
            var itemRelative = "/" + item.Href.Split('?')[0].TrimStart('/');
            if (string.Equals(itemRelative, currentRelative, StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }

        if (item.Children.Count > 0)
        {
            return item.Children.Any(c => IsItemActive(c, currentRelative));
        }

        return false;
    }
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) { CloseMenus(); InvokeAsync(StateHasChanged); }
    private static bool CanViewGroup(System.Security.Claims.ClaimsPrincipal user, MenuGroup group) =>
        ModuleAccess.CanView(user, group.Roles) && (group.Items.Count == 0 || group.Items.Any(item => CanViewItem(user, item)));
    private static bool CanViewItem(System.Security.Claims.ClaimsPrincipal user, MenuItem item) =>
        item.IsSeparator || item.IsHeader || (ModuleAccess.CanView(user, item.Roles) && (item.Children.Count == 0 || item.Children.Any(child => CanViewItem(user, child))));
    private static MenuGroup Group(string key, string label, params MenuItem[] items) => new(key, label, string.Empty, [], items);
    private static MenuGroup Group(string key, string label, string[] roles, params MenuItem[] items) => new(key, label, string.Empty, roles, items);
    private static MenuGroup Link(string key, string label, string href, string[] roles) => new(key, label, href, roles, []);
    private static MenuItem Header(string label, string? icon = null) => new(Key(label), label, string.Empty, [], [], false, false, true, icon, null, null);
    private static MenuItem Item(string label, string href, string[] roles, string? icon = null, string? badge = null, string? desc = null) => new(Key(label), label, href, roles, [], false, false, false, icon, badge, desc);
    private static MenuItem Logout(string label) => new(Key(label), label, string.Empty, [], [], false, true);
    private static MenuItem Separator() => new(Guid.NewGuid().ToString("N"), string.Empty, string.Empty, [], [], true, false);
    private static MenuItem Parent(string key, string label, params MenuItem[] children) => new(key, label, string.Empty, [], children, false, false);
    private static MenuItem Legacy(string label, string module, string[] roles) => Item(label, $"/legacy-module?module={Uri.EscapeDataString(module)}&name={Uri.EscapeDataString(label)}", roles);
    private static string Key(string value) => value.ToLowerInvariant().Replace(" ", "-").Replace("&", "and").Replace("'", string.Empty);
    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
    private sealed record MenuGroup(string Key, string Label, string Href, IReadOnlyList<string> Roles, IReadOnlyList<MenuItem> Items);
    private sealed record MenuItem(string Key, string Label, string Href, IReadOnlyList<string> Roles, IReadOnlyList<MenuItem> Children, bool IsSeparator, bool IsLogout, bool IsHeader = false, string? Icon = null, string? Badge = null, string? Description = null);
}
