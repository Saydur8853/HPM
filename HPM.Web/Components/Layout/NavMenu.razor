@inject NavigationManager Nav
@implements IDisposable

<AuthorizeView Context="auth">
    <Authorized>
        <nav class="legacy-menu-bar" aria-label="PrimeHPM navigation menu">
            @if (openMenu != null)
            {
                <div class="legacy-menu-backdrop" @onclick="CloseMenus"></div>
            }
            @foreach (var group in MenuGroups.Where(group => CanView(auth.User, group.Roles)))
            {
                var isGroupActive = IsGroupActive(group);
                var isOpen = openMenu == group.Key;
                <div class="legacy-menu-root @(isOpen ? "open" : string.Empty) @(isGroupActive ? "active" : string.Empty)">
                    @if (!string.IsNullOrWhiteSpace(group.Href))
                    {
                        <NavLink class="legacy-menu-root-button"
                                 style="text-decoration: none;"
                                 href="@group.Href"
                                 Match="NavLinkMatch.All"
                                 ActiveClass="is-active"
                                 @onclick="CloseMenus">
                            <span class="legacy-menu-root-label">@group.Label</span>
                        </NavLink>
                    }
                    else
                    {
                        <button type="button"
                                class="legacy-menu-root-button @(isOpen ? "is-open" : string.Empty) @(isGroupActive ? "is-active" : string.Empty)"
                                aria-expanded="@isOpen"
                                @onclick="() => ToggleMenu(group.Key)">
                            <span class="legacy-menu-root-label">@group.Label</span>
                            <svg class="menu-root-caret" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </button>
                        @if (isOpen)
                        {
                            <div class="legacy-menu-dropdown">
                                @foreach (var item in group.Items.Where(item => CanView(auth.User, item.Roles)))
                                {
                                    @if (item.IsSeparator)
                                    {
                                        <div class="legacy-menu-separator" role="separator"></div>
                                    }
                                    else if (item.Children.Count > 0)
                                    {
                                        var isSubOpen = openSubmenu == item.Key;
                                        <div class="legacy-menu-nested @(isSubOpen ? "open" : string.Empty)">
                                            <button type="button" class="legacy-menu-entry legacy-menu-parent @(isSubOpen ? "active" : string.Empty)" @onclick="() => ToggleSubmenu(item.Key)">
                                                <span>@item.Label</span>
                                                <svg class="legacy-menu-subarrow" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                    <polyline points="9 18 15 12 9 6"></polyline>
                                                </svg>
                                            </button>
                                            @if (isSubOpen)
                                            {
                                                <div class="legacy-menu-submenu">
                                                    @foreach (var child in item.Children.Where(child => CanView(auth.User, child.Roles)))
                                                    {
                                                        <NavLink class="legacy-menu-entry" href="@child.Href" Match="NavLinkMatch.All" @onclick="CloseMenus">@child.Label</NavLink>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                    else if (item.IsLogout)
                                    {
                                        <form method="post" action="/account/logout" class="legacy-menu-form">
                                            <AntiforgeryToken />
                                            <button type="submit" class="legacy-menu-entry">@item.Label</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <NavLink class="legacy-menu-entry" href="@item.Href" Match="NavLinkMatch.All" @onclick="CloseMenus">@item.Label</NavLink>
                                    }
                                }
                            </div>
                        }
                    }
                </div>
            }
        </nav>
    </Authorized>
</AuthorizeView>

@code {
    private string? openMenu;
    private string? openSubmenu;

    private static readonly string[] Admin = [RoleNames.Administrator];
    private static readonly string[] Opd = [RoleNames.Administrator, RoleNames.Reception, RoleNames.Cashier, RoleNames.EmergencyOperator, RoleNames.OTOperator, RoleNames.Doctor, RoleNames.Nurse];
    private static readonly string[] Diagnostic = [RoleNames.Administrator, RoleNames.Reception, RoleNames.Cashier, RoleNames.LabTechnician, RoleNames.Doctor];
    private static readonly string[] Ipd = [RoleNames.Administrator, RoleNames.Reception, RoleNames.IPDOperator, RoleNames.Doctor, RoleNames.Cashier, RoleNames.Nurse];
    private static readonly string[] Pharmacy = [RoleNames.Administrator, RoleNames.PharmacyOperator, RoleNames.Cashier, RoleNames.Doctor, RoleNames.Nurse];
    private static readonly string[] Finance = [RoleNames.Administrator, RoleNames.Reception, RoleNames.Cashier];

    private static readonly IReadOnlyList<MenuGroup> MenuGroups =
    [
        Link("patient-registration", "Patient Registration", "/patients", Opd),
        Link("doctor-appointment", "Doctor Appointment", "/appointments", Opd),

        Group("opd", "OPD & Emergency", Opd,
            Item("OPD Ticket", "/tickets"), Item("OPD & Emergency Service", "/emergency-services"),
            Item("OT Cash Memo", "/ot-cash-memos")),

        Group("ipd", "IPD Services", Ipd,
            Item("Patient Admission", "/ipd/admissions"),
            Item("Money Receipt", "/ipd/advance-receipts"), Item("Patient Service", "/ipd/patient-services"),
            Legacy("Patient Transfer", "IPD Services"), Item("Billing System", "/ipd/discharge-billing"),
            Item("Patient Discharge", "/ipd/medical-discharge-orders"), Item("Billing System General", "/ipd/discharge-billing?mode=general")),

        Group("investigation", "Investigation", Diagnostic,
            Item("OPD Cash Memo", "/diagnostic/billing?patientType=OPD"),
            Item("IPD Cash Memo", "/diagnostic/billing?patientType=IPD"), Item("Cash Memo Return", "/diagnostic/cash-memo-return")),

        Group("pathology-imaging", "Pathology & Imaging", Diagnostic,
            Item("Lab Worklist", "/diagnostic/worklist"),
            Item("Results & Report", "/diagnostic/results"),
            Item("Diagnostic Masters", "/diagnostic/masters")),

        Group("reports", "Reports", Finance, Item("Financial Reports", "/reports?type=financial"), Item("MIS Reports", "/reports?type=mis")),

        Group("medical", "Medical Services", Opd,
            Legacy("Operation List", "Medical Services"), Legacy("OT Note", "Medical Services"),
            Item("Treatment Followup", "/clinical/doctor-queue"),
            Parent("nurse-desk", "Nurse's Desk", Legacy("Sticker/Forms", "Nurse's Desk"),
                Item("Indent Medicine", "/pharmacy/prescriptions?view=ipd-indent"), Item("IPD Investigation", "/diagnostic/billing?patientType=IPD")),
            Item("Doctor Prescription", "/pharmacy/prescriptions"),
            Parent("certificates", "Certificates & Others", Legacy("Birth Certificate", "Certificates & Others"),
                Legacy("Death Certificate", "Certificates & Others"), Legacy("Fitness Certificate", "Certificates & Others"),
                Legacy("Discharge Certificate", "Certificates & Others")))
    ];

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;
    private void ToggleMenu(string key) { openMenu = openMenu == key ? null : key; openSubmenu = null; }
    private void ToggleSubmenu(string key) => openSubmenu = openSubmenu == key ? null : key;
        private void CloseMenus() { openMenu = null; openSubmenu = null; }

    private bool IsGroupActive(MenuGroup group)
    {
        var currentRelative = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimStart('/');
        if (!string.IsNullOrWhiteSpace(group.Href))
        {
            var groupRelative = "/" + group.Href.Split('?')[0].TrimStart('/');
            return string.Equals(groupRelative, currentRelative, StringComparison.OrdinalIgnoreCase);
        }

        return group.Items.Any(item => IsItemActive(item, currentRelative));
    }

    private bool IsItemActive(MenuItem item, string currentRelative)
    {
        if (!string.IsNullOrWhiteSpace(item.Href))
        {
            var itemRelative = "/" + item.Href.Split('?')[0].TrimStart('/');
            if (string.Equals(itemRelative, currentRelative, StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }

        if (item.Children.Count > 0)
        {
            return item.Children.Any(c => IsItemActive(c, currentRelative));
        }

        return false;
    }
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) { CloseMenus(); InvokeAsync(StateHasChanged); }
    private static bool CanView(System.Security.Claims.ClaimsPrincipal user, IReadOnlyList<string> roles) => roles.Count == 0 || roles.Any(user.IsInRole);
    private static MenuGroup Group(string key, string label, params MenuItem[] items) => new(key, label, string.Empty, [], items);
    private static MenuGroup Group(string key, string label, string[] roles, params MenuItem[] items) => new(key, label, string.Empty, roles, items);
    private static MenuGroup Link(string key, string label, string href, string[] roles) => new(key, label, href, roles, []);
    private static MenuItem Item(string label, string href) => new(Key(label), label, href, [], [], false, false);
    private static MenuItem Logout(string label) => new(Key(label), label, string.Empty, [], [], false, true);
    private static MenuItem Separator() => new(Guid.NewGuid().ToString("N"), string.Empty, string.Empty, [], [], true, false);
    private static MenuItem Parent(string key, string label, params MenuItem[] children) => new(key, label, string.Empty, [], children, false, false);
    private static MenuItem ReportItem(string label) => Item(label, $"/diagnostic/results?report={Uri.EscapeDataString(label)}");
    private static MenuItem ImagingItem(string label) => Item(label, $"/diagnostic/results?modality={Uri.EscapeDataString(label)}");
    private static MenuItem Legacy(string label, string module) => Item(label, $"/legacy-module?module={Uri.EscapeDataString(module)}&name={Uri.EscapeDataString(label)}");
    private static string Key(string value) => value.ToLowerInvariant().Replace(" ", "-").Replace("&", "and").Replace("'", string.Empty);
    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
    private sealed record MenuGroup(string Key, string Label, string Href, IReadOnlyList<string> Roles, IReadOnlyList<MenuItem> Items);
    private sealed record MenuItem(string Key, string Label, string Href, IReadOnlyList<string> Roles, IReadOnlyList<MenuItem> Children, bool IsSeparator, bool IsLogout);
}
